# Dockerfile.mcp
# Production container for Astro Components Kit MCP Server on Coolify.
FROM node:22-alpine AS runner

WORKDIR /app

# Install curl for healthchecks
RUN apk add --no-cache curl

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies for MCP runtime (includes tsx runner)
RUN npm ci --include=dev

# Production environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

# Copy TypeScript configuration and source files
COPY tsconfig.json ./
COPY src/ ./src/

# Expose HTTP port
EXPOSE 3000

# Health check directive for Coolify monitoring
HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://127.0.0.1:3000/health || exit 1

# Start the MCP SSE server
CMD ["node_modules/.bin/tsx", "src/mcp/index.ts"]

