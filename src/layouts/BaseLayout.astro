---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import GitHubStarPrompt from '../components/layout/GitHubStarPrompt.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Astro Components Kit — A premium open-source Astro component library with 200+ beautiful, accessible, copy-paste ready UI components. Zero dependencies.',
  image = '/og-image.png',
} = Astro.props;

const siteUrl = 'https://astrocomponents.dev';
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Astro Components Kit" />
    <meta name="keywords" content="astro, components, ui library, open source, ui components, astro components, web development, frontend, design system" />

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={`${title} — Astro Components Kit`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Astro Components Kit" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={`${title} — Astro Components Kit`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data -->
    <script type="application/ld+json" define:vars={{ title, description }}>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Astro Components Kit",
        "description": description,
        "url": "https://astrocomponents.dev",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://astrocomponents.dev/docs/{search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <title>{title} — Astro Components Kit</title>
  </head>
  <body>
    <slot />
    <GitHubStarPrompt />
  </body>
</html>
