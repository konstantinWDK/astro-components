---
// src/layouts/DocsLayout.astro
import BaseLayout from './BaseLayout.astro';
import SisterSiteLink from '../components/layout/SisterSiteLink.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import LanguagePicker from '../components/layout/LanguagePicker.astro';
import DocsFooter from '../components/layout/DocsFooter.astro';
import { categories, components } from '../data/registry/index';
import { getLocalizedCategory } from '../i18n/catalog';
import type { Locale } from '../config/site';
import { getLangFromUrl, useTranslations, getLocalizedPath, cleanPath } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
}

const detectedLang = getLangFromUrl(Astro.url);
const { title, description, lang = detectedLang } = Astro.props;
const currentPath = Astro.url.pathname;
const normalizedPath = cleanPath(currentPath).replace(/\/$/, '') || '/';
const t = useTranslations(lang);

// Categories shown in the "Components" hover menu (sections have their own catalog).
const menuCategories = categories
  .filter((c) => c.id !== 'sections')
  .map((c) => ({
    id: c.id,
    icon: c.icon,
    name: getLocalizedCategory(c, lang).name,
    count: components.filter((comp) => comp.category === c.id).length,
  }))
  .filter((c) => c.count > 0);
const componentsActive = normalizedPath.startsWith('/docs') || normalizedPath.startsWith('/components');
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="docs-shell">
    <!-- Top Header -->
    <header class="docs-header">
      <div class="docs-header__inner">
        <a href={getLocalizedPath('/', lang)} class="docs-header__brand">
          <img src="/logo-animated.svg" alt="Astro Kit Components" class="brand-logo" />
        </a>
        <button class="site-menu-toggle" id="site-menu-toggle" aria-label={t('a11y.menu')}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
        </button>
        <nav class="docs-header__nav" id="site-nav">
          <a href={getLocalizedPath('/', lang)} class:list={{ active: normalizedPath === '/' }}>{t('nav.home')}</a>
          <a href={getLocalizedPath('/install', lang)} class:list={{ active: normalizedPath.startsWith('/install') }}>{t('nav.install')}</a>
          <a href={getLocalizedPath('/mcp', lang)} class:list={{ active: normalizedPath.startsWith('/mcp') }}>{t('nav.mcp')}</a>
          <div class="nav-menu" data-nav-menu>
            <a href={getLocalizedPath('/components', lang)} class:list={['nav-menu__link', { active: componentsActive }]}>{t('nav.components')}</a>
            <button type="button" class="nav-menu__toggle" aria-expanded="false" aria-controls="components-menu" aria-label={`${t('nav.components')}: ${t('sidebar.viewAll')}`}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="nav-menu__panel" id="components-menu">
              <ul class="nav-menu__grid" role="list">
                {menuCategories.map((c) => (
                  <li>
                    <a class="nav-menu__item" href={getLocalizedPath(`/components/${c.id}`, lang)}>
                      <span class="nav-menu__icon" aria-hidden="true" set:html={c.icon}></span>
                      <span class="nav-menu__name">{c.name}</span>
                      <span class="nav-menu__count">{c.count}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a class="nav-menu__all" href={getLocalizedPath('/components', lang)}>{t('sidebar.viewAll')} →</a>
            </div>
          </div>
          <a href={getLocalizedPath('/sections', lang)} class:list={{ active: normalizedPath.startsWith('/sections') }}>{t('nav.sections')}</a>
          <a href={getLocalizedPath('/templates', lang)} class:list={{ active: normalizedPath.startsWith('/templates') }}>{t('nav.templates')}</a>
          <a href={getLocalizedPath('/notes', lang)} class:list={{ active: normalizedPath.startsWith('/notes') }}>{t('nav.notes')}</a>
          <LanguagePicker />
          <SisterSiteLink />
          <a href="https://github.com/konstantinWDK/astro-components" target="_blank" rel="noopener" class="gh-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="GitHub">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <div class="docs-body">
      <!-- Sidebar -->
      <Sidebar categories={categories} currentPath={currentPath} lang={lang} />

      <!-- Main content -->
      <main class="docs-main">
        <div class="docs-content">
          <slot />
        </div>
        <DocsFooter lang={lang} />
      </main>

      <!-- Right Sidebar: On this page (scrollspy) -->
      <aside class="toc" id="toc" aria-label={t('sidebar.onThisPage')}>
        <span class="toc__title">{t('sidebar.onThisPage')}</span>
        <nav class="toc__nav" id="toc-nav"></nav>
      </aside>
    </div>
  </div>
  <script is:inline>
    // Components menu: hover/focus open it with CSS; the button toggles it for touch and keyboard
    document.querySelectorAll('[data-nav-menu]').forEach((menu) => {
      const btn = menu.querySelector('.nav-menu__toggle');
      if (!btn) return;
      const set = (open) => { menu.classList.toggle('is-open', open); btn.setAttribute('aria-expanded', String(open)); };
      btn.addEventListener('click', () => set(!menu.classList.contains('is-open')));
      menu.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn.focus(); } });
      document.addEventListener('click', (e) => { if (!menu.contains(e.target)) set(false); });
    });
    // Mobile menu toggle
    const siteToggle = document.getElementById('site-menu-toggle');
    const siteNav = document.getElementById('site-nav');
    if (siteToggle && siteNav) {
      siteToggle.addEventListener('click', () => {
        siteNav.classList.toggle('is-open');
      });
    }

    // Scrollspy + smooth scroll for TOC
    const tocNav = document.getElementById('toc-nav');
    // Skip headings that belong to rendered previews/miniatures (inert or hidden from AT).
    const headings = Array.from(document.querySelectorAll('.docs-content h2[id], .doc-section h2[id], .doc-section[id] h2'))
      .filter((h) => !h.closest('[inert], [aria-hidden="true"], .preview-demo, .section-preview-full'));

    if (tocNav && headings.length === 0) {
      document.getElementById('toc')?.setAttribute('hidden', '');
    }

    if (tocNav && headings.length > 0) {
      headings.forEach((h2, i) => {
        if (!h2.id) h2.id = 'section-' + (i + 1);

        const link = document.createElement('a');
        link.href = '#' + h2.id;
        link.className = 'toc__link';
        link.setAttribute('data-target', h2.id);
        link.textContent = h2.textContent;
        tocNav.appendChild(link);

        link.addEventListener('click', (e) => {
          e.preventDefault();
          h2.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      const tocLinks = tocNav.querySelectorAll('.toc__link');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(l => l.classList.remove('toc__link--active'));
            const activeLink = tocNav.querySelector(`.toc__link[data-target="${entry.target.id}"]`);
            if (activeLink) activeLink.classList.add('toc__link--active');
          }
        });
      }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });

      headings.forEach(h => observer.observe(h));
    }
  </script>
</BaseLayout>

<style>
  .docs-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
  }

  /* Header */
  .docs-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgba(8, 11, 20, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--c-border);
  }

  .docs-header__inner {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 var(--sp-6);
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }

  .docs-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 75px;
    width: auto;
  }

  .docs-header__nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-left: auto;
  }

  .docs-header__nav a {
    padding: 0.4rem 0.8rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--c-text-2);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition: color 0.2s, background 0.2s;
  }

  .docs-header__nav a:hover {
    color: var(--c-text-1);
    background: rgba(255,255,255,0.06);
  }

  .docs-header__nav a.active {
    color: #facc15;
    background: rgba(234, 179, 8, 0.12);
    border: 1px solid rgba(234, 179, 8, 0.3);
    font-weight: 700;
  }


  /* Components hover menu */
  .nav-menu {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-menu__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-left: -6px;
    padding: 0;
    border: 0;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--c-text-3, var(--c-text-2));
    cursor: pointer;
    transition: transform 0.2s, color 0.2s;
  }

  .nav-menu__toggle:hover,
  .nav-menu__toggle:focus-visible {
    color: var(--c-text-1);
  }

  .nav-menu__toggle:focus-visible {
    outline: 2px solid var(--c-primary-light, #818cf8);
    outline-offset: 1px;
  }

  .nav-menu.is-open .nav-menu__toggle,
  .nav-menu:hover .nav-menu__toggle {
    transform: rotate(180deg);
  }

  .nav-menu__panel {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 60;
    width: min(560px, 92vw);
    margin-top: 6px;
    padding: var(--sp-3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg, 16px);
    background: rgba(10, 13, 24, 0.97);
    backdrop-filter: blur(20px);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.15s, transform 0.15s, visibility 0s 0.15s;
  }

  /* Invisible bridge so the pointer can travel from the link to the panel */
  .nav-menu__panel::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto 0;
    height: 12px;
  }

  .nav-menu:hover .nav-menu__panel,
  .nav-menu:focus-within .nav-menu__panel,
  .nav-menu.is-open .nav-menu__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.15s, transform 0.15s;
  }

  .nav-menu__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: min(60vh, 420px);
    overflow-y: auto;
  }

  .docs-header__nav .nav-menu__item {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 40px;
    padding: 0.4rem 0.6rem;
    border: 0;
    text-align: left;
  }

  .nav-menu__icon {
    display: inline-flex;
    flex: none;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    color: var(--c-primary-light, #818cf8);
  }

  .nav-menu__icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  .nav-menu__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-menu__count {
    padding: 0 0.45rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--c-text-3, var(--c-text-2));
    font-size: 0.72rem;
    font-weight: 600;
  }

  .docs-header__nav .nav-menu__all {
    display: block;
    margin-top: var(--sp-2);
    padding: 0.6rem;
    border-top: 1px solid var(--c-border);
    border-radius: 0 0 var(--r-sm) var(--r-sm);
    color: #facc15;
    font-weight: 700;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-menu__panel,
    .nav-menu__toggle {
      transition: none;
    }
  }

  .gh-link {
    display: flex !important;
    align-items: center;
    gap: 0.4rem;
  }

  /* Body / Sidebar layout */
  .docs-body {
    display: flex;
    flex: 1;
    width: 100%;
    max-width: 100%;
    margin: 0;
    position: relative;
  }

  .docs-main {
    flex: 1;
    min-width: 0;
    padding: var(--sp-6) clamp(var(--sp-4), 1.8vw, var(--sp-6));
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .docs-content {
    width: 100%;
    max-width: 100%;
  }

  .docs-content h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: var(--sp-4);
    color: var(--c-text-1);
  }

  .docs-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: var(--sp-8);
    margin-bottom: var(--sp-4);
    color: var(--c-text-1);
  }

  .docs-content p {
    margin-bottom: var(--sp-4);
    line-height: 1.7;
    color: var(--c-text-2);
  }

  .docs-content ul,
  .docs-content ol {
    padding-left: 1.5rem;
    margin-bottom: var(--sp-4);
    list-style-position: outside;
  }

  .docs-content ul:last-child,
  .docs-content ol:last-child {
    margin-bottom: 0;
  }

  .docs-content ul {
    list-style: disc;
  }

  .docs-content ol {
    list-style: decimal;
  }

  .docs-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: var(--c-text-2);
    padding-left: 0.25rem;
  }

  .docs-content li:last-child {
    margin-bottom: 0;
  }

  .docs-content li > ul,
  .docs-content li > ol {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .docs-content ul ul {
    list-style-type: circle;
  }

  .docs-content ul ul ul {
    list-style-type: square;
  }

  .site-menu-toggle { display: none; }

  /* Right sidebar: TOC / scrollspy */
  :global(.toc) {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    overflow-y: auto;
    padding: var(--sp-6) var(--sp-4) var(--sp-6) var(--sp-3);
    border-left: 1px solid var(--c-border);
  }
  :global(.toc[hidden]) { display: none; }
  :global(.toc__title) {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-text-3);
    margin-bottom: var(--sp-3);
    padding-left: var(--sp-3);
  }
  :global(.toc__nav) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 2px solid rgba(255,255,255,0.06);
    margin-left: var(--sp-1);
    padding-left: 0;
  }
  :global(.toc__link) {
    display: block;
    padding: 0.35rem var(--sp-3);
    font-size: 0.78rem;
    color: var(--c-text-3);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -2px;
    transition: all 0.15s ease;
    line-height: 1.4;
  }
  :global(.toc__link:hover) {
    color: var(--c-text-1);
  }
  :global(.toc__link--active) {
    color: var(--c-primary-light);
    border-left-color: var(--c-primary-light);
    font-weight: 600;
  }

  @media (max-width: 1200px) {
    :global(.toc) { display: none; }
  }

  @media (max-width: 768px) {
    .docs-body { max-width: 100%; }
    .docs-main { padding: var(--sp-6) var(--sp-4); max-width: 100%; }

    .site-menu-toggle {
       display: flex; align-items: center; justify-content: center;
       background: transparent; border: none; color: var(--c-text-1); cursor: pointer;
       margin-left: auto;
    }
    .docs-header__nav {
       display: none;
       position: absolute; top: var(--header-h); left: 0; width: 100%;
       background: rgba(8, 11, 20, 0.98); backdrop-filter: blur(20px);
       border-bottom: 1px solid var(--c-border);
       flex-direction: column; padding: var(--sp-6); gap: var(--sp-4);
       align-items: stretch;
    }
    .docs-header__nav.is-open { display: flex; }
    .docs-header__nav a { text-align: center; padding: 0.8rem; font-size: 1.1rem; }
    .nav-menu { flex-wrap: wrap; justify-content: center; }
    .nav-menu__link { flex: 1; }
    .nav-menu__toggle { width: 44px; height: 44px; margin-left: 0; }
    .nav-menu__panel {
      position: static; width: 100%; margin-top: var(--sp-2);
      display: none; opacity: 1; visibility: visible; transform: none; box-shadow: none;
    }
    .nav-menu__panel::before { display: none; }
    .nav-menu:hover .nav-menu__panel, .nav-menu:focus-within .nav-menu__panel { display: none; }
    .nav-menu.is-open .nav-menu__panel { display: block; }
    .nav-menu__grid { grid-template-columns: 1fr; max-height: 50vh; }
    .docs-header__nav .nav-menu__item { text-align: left; font-size: 1rem; padding: 0.7rem; }
  }
</style>
