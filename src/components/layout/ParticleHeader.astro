---
// src/components/layout/ParticleHeader.astro
// Canvas-based particle system with mouse interaction and constellation lines.
// Zero dependencies — uses vanilla Canvas 2D API.

interface Props {
  brandHref?: string;
  navLinks?: Array<{ label: string; href: string; target?: string; rel?: string }>;
  particleCount?: number;
}

const {
  brandHref = '/',
  navLinks = [
    { label: 'Components', href: '/docs/glass-button' },
    { label: 'GitHub', href: 'https://github.com/konstantinWDK/astro-components', target: '_blank', rel: 'noopener' },
  ],
  particleCount = 100,
} = Astro.props;
---

<!-- Particle canvas rendered behind all content -->
<canvas class="particle-canvas" aria-hidden="true"></canvas>

<!-- Sticky header bar with frosted glass effect -->
<header class="site-header">
  <div class="container site-header__inner">
    <a href={brandHref} class="site-header__brand">
      <span class="brand-icon" aria-hidden="true">⬡</span>
      <span class="brand-name">Astro Components</span>
    </a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          target={link.target ?? undefined}
          rel={link.rel ?? undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // ─── Configuration ───────────────────────────────────────────────
  const CONFIG = {
    particleCount: 100,
    minRadius: 2,
    maxRadius: 8,
    mouseRadius: 200,
    mouseForce: 0.5,
    connectionDistance: 100,
    baseSpeed: 0.3,
    colors: [
      { r: 99, g: 102, b: 241 },   // indigo   #6366f1
      { r: 192, g: 132, b: 252 },  // purple   #c084fc
      { r: 6, g: 182, b: 212 },    // cyan     #06b6d4
      { r: 255, g: 255, b: 255 },  // white
    ],
    connectionOpacity: 0.12,
    driftOscillationAmplitude: 0.15,
    returnSpringFactor: 0.005,
    damping: 0.98,
  };

  // ─── Particle class ──────────────────────────────────────────────
  interface Particle {
    x: number;
    y: number;
    originX: number;
    originY: number;
    vx: number;
    vy: number;
    radius: number;
    color: { r: number; g: number; b: number };
    opacity: number;
    phase: number;       // sine-wave phase offset
    speed: number;       // per-particle drift speed
    angle: number;       // drift direction angle
  }

  // ─── State ───────────────────────────────────────────────────────
  const canvas = document.querySelector('.particle-canvas') as HTMLCanvasElement;
  if (!canvas) throw new Error('ParticleHeader: canvas element not found');

  const ctx = canvas.getContext('2d')!;
  if (!ctx) throw new Error('ParticleHeader: could not get 2D context');

  let particles: Particle[] = [];
  let mouseX = -9999;
  let mouseY = -9999;
  let animFrameId: number | null = null;
  let isVisible = true;
  let dpr = Math.min(window.devicePixelRatio || 1, 2);

  // ─── Resize handling ────────────────────────────────────────────
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    canvas.style.width = `${window.innerWidth}px`;
    canvas.style.height = `${window.innerHeight}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  // ─── Particle initialization ─────────────────────────────────────
  function createParticle(): Particle {
    const x = Math.random() * window.innerWidth;
    const y = Math.random() * window.innerHeight;
    const colorIdx = Math.floor(Math.random() * CONFIG.colors.length);
    return {
      x,
      y,
      originX: x,
      originY: y,
      vx: 0,
      vy: 0,
      radius: CONFIG.minRadius + Math.random() * (CONFIG.maxRadius - CONFIG.minRadius),
      color: CONFIG.colors[colorIdx],
      opacity: 0.2 + Math.random() * 0.6,
      phase: Math.random() * Math.PI * 2,
      speed: CONFIG.baseSpeed * (0.5 + Math.random() * 0.5),
      angle: Math.random() * Math.PI * 2,
    };
  }

  function initParticles() {
    particles = [];
    for (let i = 0; i < CONFIG.particleCount; i++) {
      particles.push(createParticle());
    }
  }

  // ─── Drawing helpers ─────────────────────────────────────────────
  function drawParticle(p: Particle) {
    const { x, y, radius, color, opacity } = p;

    // Soft radial gradient for glow effect
    const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius * 2.5);
    gradient.addColorStop(0, `rgba(${color.r},${color.g},${color.b},${opacity})`);
    gradient.addColorStop(0.4, `rgba(${color.r},${color.g},${color.b},${opacity * 0.4})`);
    gradient.addColorStop(1, `rgba(${color.r},${color.g},${color.b},0)`);

    ctx.beginPath();
    ctx.arc(x, y, radius * 2.5, 0, Math.PI * 2);
    ctx.fillStyle = gradient;
    ctx.fill();

    // Solid core
    ctx.beginPath();
    ctx.arc(x, y, radius * 0.5, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(${color.r},${color.g},${color.b},${opacity * 0.9})`;
    ctx.fill();
  }

  function drawConnection(a: Particle, b: Particle, distance: number) {
    const opacity = CONFIG.connectionOpacity * (1 - distance / CONFIG.connectionDistance);
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    ctx.strokeStyle = `rgba(99,102,241,${opacity})`;
    ctx.lineWidth = 0.5;
    ctx.stroke();
  }

  // ─── Update loop ─────────────────────────────────────────────────
  function update() {
    const width = window.innerWidth;
    const height = window.innerHeight;

    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];

      // Sine-wave drift
      p.phase += 0.005 * p.speed;
      p.x += Math.cos(p.angle) * p.speed + Math.sin(p.phase) * CONFIG.driftOscillationAmplitude;
      p.y += Math.sin(p.angle) * p.speed + Math.cos(p.phase) * CONFIG.driftOscillationAmplitude;

      // Mouse repulsion
      const dx = p.x - mouseX;
      const dy = p.y - mouseY;
      const distSq = dx * dx + dy * dy;
      const mouseRadiusSq = CONFIG.mouseRadius * CONFIG.mouseRadius;

      if (distSq < mouseRadiusSq) {
        const dist = Math.sqrt(distSq);
        const force = CONFIG.mouseForce * (1 - dist / CONFIG.mouseRadius);
        const angle = Math.atan2(dy, dx);
        p.vx += Math.cos(angle) * force;
        p.vy += Math.sin(angle) * force;
      }

      // Spring back to origin (gentle pull)
      const homeDx = p.originX - p.x;
      const homeDy = p.originY - p.y;
      p.vx += homeDx * CONFIG.returnSpringFactor;
      p.vy += homeDy * CONFIG.returnSpringFactor;

      // Apply velocity with damping
      p.vx *= CONFIG.damping;
      p.vy *= CONFIG.damping;
      p.x += p.vx;
      p.y += p.vy;

      // Wrap around edges
      if (p.x < -50) { p.x = width + 50; p.originX = p.x; }
      if (p.x > width + 50) { p.x = -50; p.originX = p.x; }
      if (p.y < -50) { p.y = height + 50; p.originY = p.y; }
      if (p.y > height + 50) { p.y = -50; p.originY = p.y; }

      // Update origin slowly so spring doesn't fight wrapping
      p.originX += (p.x - p.originX) * 0.001;
      p.originY += (p.y - p.originY) * 0.001;
    }
  }

  function draw() {
    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

    // Draw connections first (behind particles)
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < CONFIG.connectionDistance) {
          drawConnection(particles[i], particles[j], dist);
        }
      }
    }

    // Draw particles
    for (const p of particles) {
      drawParticle(p);
    }
  }

  function loop() {
    if (!isVisible) return;
    update();
    draw();
    animFrameId = requestAnimationFrame(loop);
  }

  // ─── Event listeners ─────────────────────────────────────────────
  function onMouseMove(e: MouseEvent) {
    mouseX = e.clientX;
    mouseY = e.clientY;
  }

  function onMouseLeave() {
    mouseX = -9999;
    mouseY = -9999;
  }

  function onVisibilityChange() {
    isVisible = !document.hidden;
    if (isVisible) {
      loop();
    } else if (animFrameId) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }
  }

  function onResize() {
    resize();
    // Reinitialize particles on significant resize to fill new area
    initParticles();
  }

  // ─── Lifecycle ───────────────────────────────────────────────────
  window.addEventListener('mousemove', onMouseMove, { passive: true });
  window.addEventListener('mouseleave', onMouseLeave, { passive: true });
  document.addEventListener('visibilitychange', onVisibilityChange);
  window.addEventListener('resize', onResize);

  resize();
  initParticles();
  loop();

  // Cleanup on page navigation (Astro view transitions)
  document.addEventListener('astro:before-swap', () => {
    if (animFrameId) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }
    window.removeEventListener('mousemove', onMouseMove);
    window.removeEventListener('mouseleave', onMouseLeave);
    document.removeEventListener('visibilitychange', onVisibilityChange);
    window.removeEventListener('resize', onResize);
  });
</script>

<style>
  /* Canvas covers full viewport, behind everything */
  .particle-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    /* Ensure smooth rendering */
    image-rendering: auto;
  }

  /* Site header — frosted glass sticky bar */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    /* Gradient from semi-transparent to more transparent so particles show through */
    background: linear-gradient(
      180deg,
      rgba(8, 11, 20, 0.75) 0%,
      rgba(8, 11, 20, 0.55) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--c-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-8);
    height: 100%;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-icon {
    font-size: 1.4rem;
    filter: drop-shadow(0 0 8px var(--c-primary));
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--c-primary-light), var(--c-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-left: auto;
  }

  .site-header__nav a {
    padding: 0.4rem 0.8rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--c-text-2);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition: color 0.2s, background 0.2s;
  }

  .site-header__nav a:hover {
    color: var(--c-text-1);
    background: rgba(255, 255, 255, 0.06);
  }

  /* Reduced motion: disable particle animation movement */
  @media (prefers-reduced-motion: reduce) {
    .particle-canvas {
      display: none;
    }
  }
</style>
