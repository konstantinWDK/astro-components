---
// src/components/layout/DocsFooter.astro
import type { Locale } from '../../config/site';
import { useTranslations, getLocalizedPath } from '../../i18n/translations';

interface Props {
  lang?: Locale;
  className?: string;
}

const { lang = 'en', className = '' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class:list={['docs-footer', className]} role="contentinfo">
  <div class="docs-footer__inner">
    <div class="docs-footer__brand">
      <a href={getLocalizedPath('/', lang)} class="docs-footer__logo">
        <img src="/logo-animated.svg" alt="Astro Components Kit" class="docs-footer__logo-img" />
      </a>
      <p class="docs-footer__tagline">{t('footer.tagline')}</p>
      <div class="docs-footer__badge-row">
        <span class="docs-footer__pill">Astro 5.x</span>
        <span class="docs-footer__pill">0 Dependencies</span>
        <span class="docs-footer__pill">MIT License</span>
      </div>
    </div>

    <div class="docs-footer__cols">
      <div class="docs-footer__col">
        <span class="docs-footer__heading">{t('footer.navTitle')}</span>
        <ul class="docs-footer__links">
          <li><a href={getLocalizedPath('/', lang)}>{t('nav.home')}</a></li>
          <li><a href={getLocalizedPath('/install', lang)}>{t('nav.install')}</a></li>
          <li><a href={getLocalizedPath('/install', lang)}>{t('nav.components')}</a></li>
          <li><a href={getLocalizedPath('/sections', lang)}>{t('nav.sections')}</a></li>
          <li><a href={getLocalizedPath('/templates', lang)}>{t('nav.templates')}</a></li>
          <li><a href={getLocalizedPath('/mcp', lang)}>{t('nav.mcp')}</a></li>
          <li><a href={getLocalizedPath('/notes', lang)}>{t('nav.notes')}</a></li>
        </ul>
      </div>

      <div class="docs-footer__col">
        <span class="docs-footer__heading">{t('footer.communityTitle')}</span>
        <ul class="docs-footer__links">
          <li>
            <a href="https://github.com/konstantinWDK/astro-components" target="_blank" rel="noopener noreferrer" class="docs-footer__link-gh">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/konstantinWDK/astro-components" target="_blank" rel="noopener noreferrer" class="docs-footer__link-star">
              <span>★</span>
              <span>{t('footer.starOnGh')}</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/konstantinWDK/astro-components/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">
              {t('footer.license')}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="docs-footer__bottom">
    <p class="docs-footer__copy">{t('footer.builtWith')} · {currentYear}</p>
    <p class="docs-footer__meta">Zero runtime dependencies • Pure Astro + Vanilla CSS</p>
  </div>
</footer>

<style>
  .docs-footer {
    width: 100%;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--c-border);
    color: var(--c-text-3);
    font-size: 0.85rem;
  }

  .docs-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-8);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    flex-wrap: wrap;
  }

  .docs-footer__brand {
    max-width: 320px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .docs-footer__logo {
    display: inline-block;
    width: fit-content;
  }

  .docs-footer__logo-img {
    height: 38px;
    width: auto;
    display: block;
  }

  .docs-footer__tagline {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--c-text-2);
  }

  .docs-footer__badge-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  .docs-footer__pill {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--c-border);
    color: var(--c-text-3);
  }

  .docs-footer__cols {
    display: flex;
    gap: var(--sp-8);
    flex-wrap: wrap;
  }

  .docs-footer__col {
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .docs-footer__heading {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-text-1);
  }

  .docs-footer__links {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .docs-footer__links li {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .docs-footer__links a {
    color: var(--c-text-3);
    text-decoration: none;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .docs-footer__links a:hover {
    color: var(--c-text-1);
  }

  .docs-footer__link-gh:hover {
    color: #ffffff;
  }

  .docs-footer__link-star {
    color: #facc15 !important;
  }

  .docs-footer__link-star span:first-child {
    font-size: 0.95rem;
  }

  .docs-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-6);
    flex-wrap: wrap;
    gap: var(--sp-3);
    font-size: 0.78rem;
    color: var(--c-text-3);
  }

  .docs-footer__copy {
    margin: 0;
  }

  .docs-footer__meta {
    margin: 0;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    opacity: 0.75;
  }

  @media (max-width: 680px) {
    .docs-footer__inner {
      flex-direction: column;
      gap: var(--sp-6);
    }
    .docs-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }
</style>

