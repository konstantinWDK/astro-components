---
/**
 * StarGoalBanner — Slim, dismissible announcement bar above the site header:
 * "1 GitHub star = 1 new component", with the live star count.
 *
 * The star count is loaded only in the browser (GitHub API, cached for an hour in
 * sessionStorage). Keeping it out of the static HTML avoids hitting the API's rate limit
 * once per page at build time and keeps pages byte-stable between deploys (IndexNow).
 * Dismissing hides it for 14 days (localStorage); an inline script hides it before
 * paint for returning visitors, so there is no flash.
 *
 * @param {'en'|'es'|'ru'} lang - UI language.
 * @param {string} repo - GitHub "owner/name".
 */
interface Props {
  lang?: 'en' | 'es' | 'ru';
  repo?: string;
}

const { lang = 'en', repo = 'konstantinWDK/astro-components' } = Astro.props;
const repoUrl = `https://github.com/${repo}`;

const copy = {
  en: {
    lead: '1 GitHub star = 1 new component.',
    count: (n: string) => `We’re at ${n} — help us unlock the next one.`,
    labels: { one: 'star', other: 'stars' },
    cta: 'Star the repo',
    close: 'Dismiss announcement',
  },
  es: {
    lead: '1 estrella en GitHub = 1 componente nuevo.',
    count: (n: string) => `Llevamos ${n}: ayúdanos a desbloquear el siguiente.`,
    labels: { one: 'estrella', other: 'estrellas' },
    cta: 'Dar una estrella',
    close: 'Cerrar aviso',
  },
  ru: {
    lead: '1 звезда на GitHub = 1 новый компонент.',
    count: (n: string) => `Уже ${n} — помогите открыть следующий.`,
    labels: { one: 'звезда', few: 'звёзды', many: 'звёзд', other: 'звезды' },
    cta: 'Поставить звезду',
    close: 'Закрыть объявление',
  },
}[lang];

const labels = copy.labels as Record<string, string>;
const [countBefore, countAfter] = copy.count('__N__').split('__N__');
---

<div class="star-goal" id="starGoalBanner" role="region" aria-label={copy.lead}>
  <!-- Shared gradient for aura stars -->
  <svg width="0" height="0" class="star-goal__defs" aria-hidden="true">
    <defs>
      <linearGradient id="starGoalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffffff"/>
        <stop offset="35%" stop-color="#fef3c7"/>
        <stop offset="70%" stop-color="#fbbf24"/>
        <stop offset="100%" stop-color="#d4a017"/>
      </linearGradient>
    </defs>
  </svg>
  <div class="star-goal__inner">
    <svg class="star-goal__icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
    </svg>
    <p class="star-goal__text">
      <strong>{copy.lead}</strong>
      <span class="star-goal__count" data-count-wrap hidden>
        {countBefore}<b data-stars>0</b>&nbsp;<span data-label data-labels={JSON.stringify(labels)}>{labels.other}</span>{countAfter}
      </span>
    </p>
    <div class="star-goal__cta-wrap">
      <div class="star-goal__aura-field" id="starGoalAura" aria-hidden="true"></div>
      <a class="star-goal__cta" id="starGoalCta" href={repoUrl} target="_blank" rel="noopener noreferrer">
        <span class="star-goal__cta-ripple" aria-hidden="true"></span>
        <svg class="star-goal__gh-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z" />
        </svg>
        <span>{copy.cta}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <button type="button" class="star-goal__close" id="starGoalClose" aria-label={copy.close}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </div>
</div>

<script is:inline>
  // Hide before paint for visitors who dismissed it recently.
  (function () {
    try {
      var until = Number(localStorage.getItem('ack_star_goal_dismissed_until') || 0);
      if (until > Date.now()) document.getElementById('starGoalBanner').hidden = true;
    } catch (e) {}
  })();
</script>

<script is:inline define:vars={{ repo }}>
  (function () {
    var banner = document.getElementById('starGoalBanner');
    if (!banner || banner.hidden) return;

    var close = document.getElementById('starGoalClose');
    var auraField = document.getElementById('starGoalAura');
    var ctaBtn = document.getElementById('starGoalCta');
    var auraTimer = null;
    var pulseTimeout = null;

    if (close) {
      close.addEventListener('click', function () {
        banner.hidden = true;
        if (auraTimer) clearTimeout(auraTimer);
        try {
          localStorage.setItem('ack_star_goal_dismissed_until', String(Date.now() + 14 * 24 * 60 * 60 * 1000));
        } catch (e) {}
      });
    }

    // Refresh the star count (cached for an hour per tab session).
    var wrap = banner.querySelector('[data-count-wrap]');
    var out = banner.querySelector('[data-stars]');
    var label = banner.querySelector('[data-label]');
    var htmlLang = document.documentElement.lang || 'en';

    function updateLabel(num) {
      if (!label) return;
      try {
        var forms = JSON.parse(label.getAttribute('data-labels') || '{}');
        label.textContent = forms[new Intl.PluralRules(htmlLang).select(num)] || forms.other || label.textContent;
      } catch (e) {}
    }

    /* Aura particles creation & inward flight */
    function createStarParticle() {
      var el = document.createElement('span');
      el.className = 'star-goal__star';
      el.innerHTML =
        '<span class="star-goal__star-halo"></span>' +
        '<svg class="star-goal__star-svg" viewBox="-8 -8 16 16" width="16" height="16" aria-hidden="true">' +
          '<path d="M0 -7.5 C0.5 -2 2 -0.5 7.5 0 C2 0.5 0.5 2 0 7.5 C-0.5 2 -2 0.5 -7.5 0 C-2 -0.5 -0.5 -2 0 -7.5 Z" fill="url(#starGoalGrad)"/>' +
          '<circle cx="0" cy="0" r="1.7" fill="#ffffff"/>' +
        '</svg>';
      return el;
    }

    function pulseCta() {
      if (!ctaBtn) return;
      ctaBtn.classList.remove('is-pulsing');
      void ctaBtn.offsetWidth; // re-trigger animation
      ctaBtn.classList.add('is-pulsing');
      if (pulseTimeout) clearTimeout(pulseTimeout);
      pulseTimeout = setTimeout(function () {
        ctaBtn.classList.remove('is-pulsing');
      }, 450);
    }

    function spawnAuraStar() {
      if (!auraField || !ctaBtn || document.hidden || banner.hidden) return;
      var prefersReduced = false;
      try {
        prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch (e) {}
      if (prefersReduced) return;

      var isMobile = window.innerWidth <= 760;
      // Distance from button center: starts outside button in the web space
      var dist = isMobile ? (45 + Math.random() * 25) : (70 + Math.random() * 50);
      var angle = Math.random() * Math.PI * 2;

      var startX = Math.cos(angle) * dist;
      var startY = Math.sin(angle) * dist;

      // Curving gravitational arc towards center
      var curveMag = (Math.random() - 0.5) * (isMobile ? 25 : 45);
      var midX = startX * 0.5 - Math.sin(angle) * curveMag;
      var midY = startY * 0.5 + Math.cos(angle) * curveMag;

      var rotStart = (Math.random() - 0.5) * 120;
      var rotEnd = rotStart + (curveMag >= 0 ? 180 : -180);

      var starEl = createStarParticle();
      auraField.appendChild(starEl);

      var duration = 1050 + Math.random() * 300;

      if (typeof starEl.animate === 'function') {
        var anim = starEl.animate([
          {
            transform: 'translate(' + startX + 'px, ' + startY + 'px) scale(0.2) rotate(' + rotStart + 'deg)',
            opacity: 0,
          },
          {
            transform: 'translate(' + midX + 'px, ' + midY + 'px) scale(1.15) rotate(' + (rotStart + 90) + 'deg)',
            opacity: 1,
            offset: 0.35,
          },
          {
            transform: 'translate(' + (startX * 0.15) + 'px, ' + (startY * 0.15) + 'px) scale(0.9) rotate(' + (rotStart + 140) + 'deg)',
            opacity: 0.95,
            offset: 0.8,
          },
          {
            transform: 'translate(0px, 0px) scale(0.1) rotate(' + rotEnd + 'deg)',
            opacity: 0,
            offset: 1,
          }
        ], {
          duration: duration,
          easing: 'cubic-bezier(0.25, 0.1, 0.25, 1)',
          fill: 'forwards',
        });

        anim.onfinish = function () {
          starEl.remove();
          pulseCta();
        };
      } else {
        starEl.remove();
        pulseCta();
      }
    }

    function scheduleNextStar(delay) {
      if (auraTimer) clearTimeout(auraTimer);
      var wait = typeof delay === 'number' ? delay : (5000 + Math.random() * 3200); // 5s to 8.2s
      auraTimer = setTimeout(function () {
        if (!document.hidden && !banner.hidden) {
          spawnAuraStar();
          // 25% chance of a dual star arriving shortly after
          if (Math.random() < 0.25) {
            setTimeout(function () {
              if (!document.hidden && !banner.hidden) spawnAuraStar();
            }, 320);
          }
        }
        scheduleNextStar();
      }, wait);
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        if (auraTimer) clearTimeout(auraTimer);
      } else {
        scheduleNextStar(2000);
      }
    });

    // Count-up counter progression
    var hasRendered = false;
    function render(n) {
      if (typeof n !== 'number' || !wrap || !out || hasRendered) return;
      hasRendered = true;
      wrap.hidden = false;

      var prefersReduced = false;
      try {
        prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch (e) {}

      if (prefersReduced) {
        out.textContent = n.toLocaleString(htmlLang);
        updateLabel(n);
        return;
      }

      var duration = 1400; // ms
      var start = performance.now();
      var startVal = 0;

      function step(now) {
        var progress = Math.min((now - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = Math.round(startVal + (n - startVal) * eased);
        out.textContent = current.toLocaleString(htmlLang);
        updateLabel(current);

        if (progress < 1) {
          window.requestAnimationFrame(step);
        } else {
          out.textContent = n.toLocaleString(htmlLang);
          updateLabel(n);

          // Celebratory first particle arrival as counter resolves
          setTimeout(function () {
            spawnAuraStar();
          }, 200);
          scheduleNextStar(4500);
        }
      }
      window.requestAnimationFrame(step);
    }

    var CACHE = 'ack_star_goal_count';
    try {
      var cached = JSON.parse(sessionStorage.getItem(CACHE) || 'null');
      if (cached && Date.now() - cached.t < 60 * 60 * 1000) return render(cached.n);
    } catch (e) {}
    fetch('https://api.github.com/repos/' + repo, { headers: { Accept: 'application/vnd.github+json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || typeof d.stargazers_count !== 'number') return;
        render(d.stargazers_count);
        try { sessionStorage.setItem(CACHE, JSON.stringify({ n: d.stargazers_count, t: Date.now() })); } catch (e) {}
      })
      .catch(function () {});
  })();
</script>

<style>
  .star-goal {
    position: relative;
    z-index: 60;
    background:
      radial-gradient(ellipse 40% 140% at 50% 0%, rgba(212, 160, 23, 0.18), transparent 70%),
      linear-gradient(90deg, #0b0a07, #14100a 50%, #0b0a07);
    border-bottom: 1px solid rgba(212, 160, 23, 0.25);
    color: var(--c-text-2, #c4c4c4);
  }
  .star-goal[hidden] { display: none; }
  .star-goal__defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .star-goal__inner {
    max-width: 1400px;
    margin: 0 auto;
    min-height: 44px;
    padding: 0.35rem 3rem 0.35rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    position: relative;
  }
  .star-goal__icon {
    flex-shrink: 0;
    color: #fbbf24;
    filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.7));
    animation: star-goal-twinkle 2.8s ease-in-out infinite;
  }
  .star-goal__text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    min-width: 0;
  }
  .star-goal__text strong { color: var(--c-text-1, #fff); font-weight: 700; }
  .star-goal__count b {
    color: #fbbf24;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .star-goal__count[hidden] { display: none; }

  /* CTA container & aura field */
  .star-goal__cta-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .star-goal__aura-field {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 10;
    overflow: visible;
  }

  .star-goal__star {
    position: absolute;
    top: 0;
    left: 0;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    margin-top: -8px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .star-goal__star-halo {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(254, 243, 199, 0.95) 0%, rgba(251, 191, 36, 0.55) 40%, rgba(212, 160, 23, 0) 72%);
    filter: blur(2px);
    pointer-events: none;
  }

  .star-goal__star-svg {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.95)) drop-shadow(0 0 8px rgba(212, 160, 23, 0.6));
  }

  /* Star CTA button */
  .star-goal__cta {
    --cta-hover-y: 0px;
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 32px;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #fbbf24, #d4a017);
    color: #0a0a0a;
    font-size: 0.75rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 14px -4px rgba(212, 160, 23, 0.6);
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    overflow: hidden;
  }

  .star-goal__cta:hover {
    --cta-hover-y: -1px;
    transform: translateY(-1px);
    color: #0a0a0a;
    box-shadow: 0 6px 18px -4px rgba(212, 160, 23, 0.8);
  }

  .star-goal__cta:focus-visible, .star-goal__close:focus-visible {
    outline: 2px solid #fbbf24;
    outline-offset: 2px;
  }

  /* Internal absorb ripple flash when particle enters */
  .star-goal__cta-ripple {
    position: absolute;
    inset: -40%;
    border-radius: 999px;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.95) 0%, rgba(254, 243, 199, 0.65) 30%, rgba(251, 191, 36, 0.25) 55%, transparent 70%);
    opacity: 0;
    pointer-events: none;
    transform: scale(0.3);
  }

  .star-goal__cta.is-pulsing {
    animation: cta-pulse 0.45s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }

  .star-goal__cta.is-pulsing .star-goal__cta-ripple {
    animation: cta-ripple-burst 0.45s ease-out forwards;
  }

  @keyframes cta-pulse {
    0% {
      transform: translateY(var(--cta-hover-y, 0px)) scale(1);
      box-shadow: 0 4px 14px -4px rgba(212, 160, 23, 0.6);
      filter: brightness(1);
    }
    35% {
      transform: translateY(var(--cta-hover-y, 0px)) scale(1.055);
      box-shadow:
        0 0 0 1.5px rgba(254, 243, 199, 0.9),
        0 0 16px 4px rgba(251, 191, 36, 0.85),
        0 0 28px 8px rgba(212, 160, 23, 0.5);
      filter: brightness(1.2);
    }
    100% {
      transform: translateY(var(--cta-hover-y, 0px)) scale(1);
      box-shadow: 0 4px 14px -4px rgba(212, 160, 23, 0.6);
      filter: brightness(1);
    }
  }

  @keyframes cta-ripple-burst {
    0% {
      opacity: 0.95;
      transform: scale(0.3);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.1);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  .star-goal__close {
    position: absolute;
    right: 0.25rem;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--c-text-3, #8a8a8a);
    cursor: pointer;
    border-radius: 999px;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .star-goal__close:hover { color: var(--c-text-1, #fff); background: rgba(255, 255, 255, 0.06); }

  @keyframes star-goal-twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.65; transform: scale(0.85); }
  }

  @media (max-width: 760px) {
    .star-goal__inner { justify-content: flex-start; gap: 0.5rem; padding-right: 2.75rem; }
    .star-goal__count { display: none; }
    .star-goal__text { font-size: 0.75rem; }
    .star-goal__cta { padding: 0.2rem 0.65rem; font-size: 0.6875rem; }
    .star-goal__cta .star-goal__gh-icon { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .star-goal__icon { animation: none; }
    .star-goal__cta.is-pulsing { animation: none; }
    .star-goal__cta-ripple { display: none; }
    .star-goal__aura-field { display: none; }
  }
</style>
