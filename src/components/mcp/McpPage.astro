<script is:inline>
  // Mobile nav toggle
  const siteToggle = document.getElementById('site-menu-toggle');
  const siteNav = document.getElementById('site-nav');
  if (siteToggle && siteNav) {
    siteToggle.addEventListener('click', () => {
      siteNav.classList.toggle('is-open');
    });
  }

  // Tab switching logic
  const tabs = document.querySelectorAll('.mcp-tab');
  const panes = document.querySelectorAll('.mcp-pane');
  const toast = document.getElementById('mcp-toast');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.target;
      tabs.forEach((t) => {
        t.classList.remove('mcp-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      panes.forEach((p) => p.classList.remove('mcp-pane--active'));

      tab.classList.add('mcp-tab--active');
      tab.setAttribute('aria-selected', 'true');
      const activePane = document.getElementById(`pane-${target}`);
      if (activePane) activePane.classList.add('mcp-pane--active');
    });
  });

  // Copy buttons
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        if (toast) {
          toast.classList.add('mcp-toast--visible');
          setTimeout(() => toast.classList.remove('mcp-toast--visible'), 2200);
        }
        const span = btn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1800);
        }
      } catch (e) {
        console.error('Clipboard copy error:', e);
      }
    });
  });
</script>

