---
// src/components/mcp/McpPage.astro
// Dedicated MCP server landing page for Astro Components Kit.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SisterSiteLink from '../layout/SisterSiteLink.astro';
import LanguagePicker from '../layout/LanguagePicker.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/translations';
import { components } from '../../data/registry/index';
import { templates } from '../../data/registry/templates';
import type { Locale } from '../../config/site';
import pkg from '../../../package.json';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const totalComponents = components.length;
const totalCharts = components.filter((c) => c.category === 'charts').length;
const totalTemplates = templates.length;

const content = {
  en: {
    badge: 'Official MCP Server · Astro 5.x',
    title: 'Supercharge your AI with Astro Components Kit',
    subtitle: 'Connect Cursor, Claude, Codex, Lovable, or any MCP client directly to 400+ production components, SVG charts, and 8 multi-page templates. Let your AI build Astro sites at warp speed.',
    endpointLabel: 'Remote SSE Endpoint',
    fastInstallTitle: '1-Click Editor & Agent Setup',
    fastInstallDesc: 'Choose your AI editor to get the automated CLI installation command or direct JSON config.',
    tabCursor: 'Cursor',
    tabClaude: 'Claude',
    tabCodex: 'Codex',
    tabLovable: 'Lovable',
    tabMcp: 'Universal MCP',
    cliTabTitle: 'Automated CLI Setup',
    manualTabTitle: 'Direct Configuration File',
    copiedNotice: 'Copied to clipboard!',
    promptsTitle: 'Prompt your AI with these examples',
    promptsDesc: 'Once connected, your AI has direct access to the entire component catalog, props, and source code.',
    toolsTitle: '8 Built-in MCP Tools',
    toolsDesc: 'Everything your AI assistant needs to find, inspect, and write production-grade Astro code.',
    statsComponents: 'Components',
    statsTemplates: 'Full Templates',
    statsCharts: 'SVG Charts',
    statsVersion: 'MCP Version',
    statsDeps: 'Runtime Deps',
    btnDocs: 'Browse Components',
    btnTemplates: 'View Templates',
    btnGitHub: 'View on GitHub',
  },
  es: {
    badge: 'Servidor MCP Oficial · Astro 5.x',
    title: 'Potencia tu IA con Astro Components Kit',
    subtitle: 'Conecta Cursor, Claude, Codex, Lovable o cualquier cliente MCP directamente a más de 400 componentes de producción, gráficos SVG y 8 plantillas completas. Deja que tu IA construya webs Astro a toda velocidad.',
    endpointLabel: 'Endpoint SSE Remoto',
    fastInstallTitle: 'Configuración en 1 Clic para tu Editor o Agente',
    fastInstallDesc: 'Elige tu herramienta de IA para obtener el comando de instalación automática por CLI o el JSON directo.',
    tabCursor: 'Cursor',
    tabClaude: 'Claude',
    tabCodex: 'Codex',
    tabLovable: 'Lovable',
    tabMcp: 'MCP Universal',
    cliTabTitle: 'Instalación Automática por CLI',
    manualTabTitle: 'Archivo de Configuración Directo',
    copiedNotice: '¡Copiado al portapapeles!',
    promptsTitle: 'Prueba estos prompts en tu IA',
    promptsDesc: 'Una vez conectado, tu asistente tendrá acceso inmediato al catálogo completo, interfaces TypeScript y código fuente.',
    toolsTitle: '8 Herramientas MCP Integradas',
    toolsDesc: 'Todo lo que tu asistente de IA necesita para descubrir, inspeccionar y generar código Astro listo para producción.',
    statsComponents: 'Componentes',
    statsTemplates: 'Plantillas',
    statsCharts: 'Gráficos SVG',
    statsVersion: 'Versión MCP',
    statsDeps: 'Dependencias',
    btnDocs: 'Ver Componentes',
    btnTemplates: 'Ver Plantillas',
    btnGitHub: 'Ver en GitHub',
  },
  ru: {
    badge: 'Официальный MCP-сервер · Astro 5.x',
    title: 'Ускорьте разработку с ИИ и Astro Components Kit',
    subtitle: 'Подключите Cursor, Claude, Codex, Lovable или любой MCP-клиент напрямую к 400+ готовым компонентам, SVG-графикам и 8 шаблонам. Пусть ваш ИИ создаёт сайты на Astro за секунды.',
    endpointLabel: 'Удалённый SSE Endpoint',
    fastInstallTitle: 'Настройка редактора в 1 клик',
    fastInstallDesc: 'Выберите ваш инструмент для автоматической установки через CLI или ручной настройки JSON.',
    tabCursor: 'Cursor',
    tabClaude: 'Claude',
    tabCodex: 'Codex',
    tabLovable: 'Lovable',
    tabMcp: 'Универсальный MCP',
    cliTabTitle: 'Автоматическая установка через CLI',
    manualTabTitle: 'Прямой файл конфигурации',
    copiedNotice: 'Скопировано в буфер обмена!',
    promptsTitle: 'Попробуйте эти промпты с вашим ИИ',
    promptsDesc: 'После подключения ваш ИИ получит прямой доступ к каталогу, TypeScript-интерфейсам и исходному коду компонентов.',
    toolsTitle: '8 встроенных MCP-инструментов',
    toolsDesc: 'Всё необходимое вашему ИИ для поиска, анализа и генерации чистого Astro-кода.',
    statsComponents: 'Компонентов',
    statsTemplates: 'Шаблонов',
    statsCharts: 'SVG-графиков',
    statsVersion: 'Версия MCP',
    statsDeps: 'Зависимостей',
    btnDocs: 'Все компоненты',
    btnTemplates: 'Все шаблоны',
    btnGitHub: 'Код на GitHub',
  },
}[lang];

const clients = [
  {
    id: 'cursor',
    name: content.tabCursor,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m4 4 16 8-8 2-2 8z"/></svg>`,
    cliCommand: 'npx astro-component-kit mcp install cursor',
    filePath: '.cursor/mcp.json',
    jsonConfig: `{\n  "mcpServers": {\n    "astro-components": {\n      "url": "https://mcp.astrocomponents.dev/sse"\n    }\n  }\n}`,
  },
  {
    id: 'claude',
    name: content.tabClaude,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>`,
    cliCommand: 'npx astro-component-kit mcp install claude',
    extraCommand: 'claude mcp add astro-components https://mcp.astrocomponents.dev/sse',
    extraLabel: 'Claude Code CLI',
    filePath: 'claude_desktop_config.json',
    jsonConfig: `{\n  "mcpServers": {\n    "astro-components": {\n      "url": "https://mcp.astrocomponents.dev/sse"\n    }\n  }\n}`,
  },
  {
    id: 'codex',
    name: content.tabCodex,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    cliCommand: 'npx astro-component-kit mcp install codex',
    filePath: '.codex/mcp.json',
    jsonConfig: `{\n  "mcpServers": {\n    "astro-components": {\n      "url": "https://mcp.astrocomponents.dev/sse"\n    }\n  }\n}`,
  },
  {
    id: 'lovable',
    name: content.tabLovable,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
    cliCommand: 'npx astro-component-kit mcp install lovable',
    extraCommand: 'https://mcp.astrocomponents.dev/sse',
    extraLabel: 'Lovable Settings URL',
    filePath: '.lovable/mcp.json',
    jsonConfig: `{\n  "mcpServers": {\n    "astro-components": {\n      "url": "https://mcp.astrocomponents.dev/sse"\n    }\n  }\n}`,
  },
  {
    id: 'mcp',
    name: content.tabMcp,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>`,
    cliCommand: 'npx astro-component-kit mcp install mcp',
    filePath: 'mcp.json',
    jsonConfig: `{\n  "mcpServers": {\n    "astro-components": {\n      "url": "https://mcp.astrocomponents.dev/sse"\n    }\n  }\n}`,
  },
];

const samplePrompts = [
  {
    tag: 'E-commerce',
    text: lang === 'es' ? 'Añádeme un ProductBuyBox con selector de variantes y el carrito persistente CartDrawer de astro-components' : lang === 'ru' ? 'Добавь ProductBuyBox с выбором вариантов и сохраняемую корзину CartDrawer из astro-components' : 'Add a ProductBuyBox with variant selector and persistent CartDrawer from astro-components',
  },
  {
    tag: 'Developer Portfolio',
    text: lang === 'es' ? 'Usa DevHero y DevProjectsShowcase en 3D del template portfolio para armar mi web personal' : lang === 'ru' ? 'Используй 3D-секции DevHero и DevProjectsShowcase из шаблона portfolio для личного сайта' : 'Use the 3D DevHero and DevProjectsShowcase sections from the portfolio template for my personal site',
  },
  {
    tag: 'Healthcare SaaS',
    text: lang === 'es' ? 'Integra el MedBookingWizard y la sala de telemedicina MedVideoVisit del template saas-clinic' : lang === 'ru' ? 'Интегрируй мастер записи MedBookingWizard и телемедицину MedVideoVisit из шаблона saas-clinic' : 'Integrate the MedBookingWizard and MedVideoVisit telehealth room from the saas-clinic template',
  },
  {
    tag: 'Cyberpunk & Web3',
    text: lang === 'es' ? 'Construye una landing futurista con CyberHero, CyberNodeMap y el formulario CyberTerminalForm' : lang === 'ru' ? 'Создай футуристичный лендинг с CyberHero, картой нод CyberNodeMap и формой CyberTerminalForm' : 'Build a futuristic landing with CyberHero, CyberNodeMap, and CyberTerminalForm',
  },
  {
    tag: 'Charts & KPIs',
    text: lang === 'es' ? 'Inserta un KpiStatTile de ingresos con porcentaje de cambio y un gráfico LineChart en SVG sin dependencias' : lang === 'ru' ? 'Вставь KPI-виджет дохода KpiStatTile с процентом изменения и SVG-график LineChart' : 'Insert a revenue KpiStatTile with delta percentage and a zero-dependency SVG LineChart',
  },
  {
    tag: 'Design & Themes',
    text: lang === 'es' ? 'Configura el selector de tema claro y oscuro con los tokens adaptativos ink-rgb de global.css' : lang === 'ru' ? 'Настрой переключатель светлой и тёмной темы с адаптивными токенами ink-rgb из global.css' : 'Setup dark/light theme switching with adaptive ink-rgb tokens from global.css',
  },
];

const toolsList = [
  { name: 'search_components', desc: lang === 'es' ? 'Búsqueda por palabras clave, categoría o tags entre los 400+ bloques' : lang === 'ru' ? 'Поиск компонентов по ключевым словам, категориям и тегам среди 400+ блоков' : 'Search components by keyword, category, or tag across 400+ building blocks' },
  { name: 'get_component', desc: lang === 'es' ? 'Obtiene Props, variantes, import syntax y guía de accesibilidad' : lang === 'ru' ? 'Получение TypeScript props, вариантов, синтаксиса импорта и доступности' : 'Inspect TypeScript props, usage examples, and accessibility requirements' },
  { name: 'get_component_code', desc: lang === 'es' ? 'Código fuente .astro completo listo para pegar en el proyecto' : lang === 'ru' ? 'Полный исходный код .astro, готовый для вставки в проект' : 'Retrieve complete raw .astro source code ready for your project' },
  { name: 'list_categories', desc: lang === 'es' ? 'Explora las 13 categorías disponibles con el conteo de componentes' : lang === 'ru' ? 'Список всех 13 категорий с описаниями и количеством компонентов' : 'List all 13 categories with descriptions and item counts' },
  { name: 'list_templates', desc: lang === 'es' ? 'Resumen de las 8 plantillas multipágina completas en producción' : lang === 'ru' ? 'Обзор всех 8 готовых многостраничных шаблонов в продакшене' : 'Overview of all 8 complete multi-page production templates' },
  { name: 'get_template', desc: lang === 'es' ? 'Código, arquitectura y páginas de plantillas e-commerce, SaaS, agencia, portfolio y cyberpunk' : lang === 'ru' ? 'Архитектура, страницы и код шаблонов: e-commerce, SaaS, агентство, портфолио, киберпанк' : 'Full template architecture, pages, store configs, and routing files for e-commerce, SaaS, agency, portfolio, and cyberpunk' },
  { name: 'get_design_tokens', desc: lang === 'es' ? 'Tokens CSS, variables de modo claro/oscuro y paleta unificada' : lang === 'ru' ? 'CSS дизайн-токены, переменные светлой/тёмной темы и глобальные стили' : 'CSS design tokens, light/dark mode variables, and global.css guide' },
  { name: 'get_library_info', desc: lang === 'es' ? 'Información general de la versión, totales y guía de inicio rápido' : lang === 'ru' ? 'Общая информация о версии, количестве компонентов и быстрый старт' : 'Library version, totals overview, and quickstart commands' },
];
---

<BaseLayout
  title={lang === 'es' ? 'Astro Components Kit — Servidor MCP Oficial para Cursor y Claude' : lang === 'ru' ? 'Astro Components Kit — Официальный MCP сервер для Cursor и Claude' : 'Astro Components Kit — Official MCP Server for AI Development'}
  description={content.subtitle}
>
  <div class="mcp-page">
    <!-- Top Header matching project layout & animated logo -->
    <header class="docs-header">
      <div class="docs-header__inner">
        <a href={getLocalizedPath('/', lang)} class="docs-header__brand">
          <img src="/logo-animated.svg" alt="Astro Kit Components" class="brand-logo" />
        </a>
        <button class="site-menu-toggle" id="site-menu-toggle" aria-label={t('a11y.menu')}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
        </button>
        <nav class="docs-header__nav" id="site-nav">
          <a href={getLocalizedPath('/', lang)}>{t('nav.home')}</a>
          <a href={getLocalizedPath('/install', lang)}>{t('nav.install')}</a>
          <a href={getLocalizedPath('/mcp', lang)} class="active">{t('nav.mcp')}</a>
          <a href={getLocalizedPath('/install', lang)}>{t('nav.components')}</a>
          <a href={getLocalizedPath('/sections', lang)}>{t('nav.sections')}</a>
          <a href={getLocalizedPath('/templates', lang)}>{t('nav.templates')}</a>
          <a href={getLocalizedPath('/notes', lang)}>{t('nav.notes')}</a>
          <LanguagePicker currentLang={lang} />
          <SisterSiteLink />
          <a href="https://github.com/konstantinWDK/astro-components" target="_blank" rel="noopener" class="gh-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="GitHub">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="mcp-hero">
      <div class="mcp-hero__badge">
        <span class="mcp-hero__pulse"></span>
        <span>{content.badge}</span>
        <span class="mcp-hero__version-chip">v{pkg.version}</span>
      </div>
      <h1 class="mcp-hero__title">{content.title}</h1>
      <p class="mcp-hero__subtitle">{content.subtitle}</p>

      <!-- Key Metrics Row -->
      <div class="mcp-stats">
        <div class="mcp-stat">
          <div class="mcp-stat__value">{totalComponents}+</div>
          <div class="mcp-stat__label">{content.statsComponents}</div>
        </div>
        <div class="mcp-stat">
          <div class="mcp-stat__value">{totalCharts}</div>
          <div class="mcp-stat__label">{content.statsCharts}</div>
        </div>
        <div class="mcp-stat">
          <div class="mcp-stat__value">{totalTemplates}</div>
          <div class="mcp-stat__label">{content.statsTemplates}</div>
        </div>
        <div class="mcp-stat mcp-stat--highlight">
          <div class="mcp-stat__value">v{pkg.version}</div>
          <div class="mcp-stat__label">{content.statsVersion}</div>
        </div>
        <div class="mcp-stat">
          <div class="mcp-stat__value">0</div>
          <div class="mcp-stat__label">{content.statsDeps}</div>
        </div>
      </div>

      <!-- Main SSE Endpoint Card -->
      <div class="mcp-endpoint-card">
        <div class="mcp-endpoint-card__header">
          <div class="mcp-endpoint-card__label">{content.endpointLabel}</div>
          <div class="mcp-endpoint-card__meta">
            <span class="mcp-meta-pill">astro-component-kit@v{pkg.version}</span>
            <span class="mcp-meta-pill mcp-meta-pill--live">MCP 2024-11-05</span>
          </div>
        </div>
        <div class="mcp-endpoint-card__row">
          <code id="mcp-endpoint">https://mcp.astrocomponents.dev/sse</code>
          <button class="mcp-copy-btn" data-copy="https://mcp.astrocomponents.dev/sse" aria-label="Copy endpoint">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Interactive Editor Setup -->
    <section class="mcp-setup">
      <div class="mcp-section-head">
        <h2>{content.fastInstallTitle}</h2>
        <p>{content.fastInstallDesc}</p>
      </div>

      <div class="mcp-tabs-wrapper">
        <!-- Client Selector Tabs -->
        <div class="mcp-tabs" role="tablist">
          {clients.map((c, i) => (
            <button
              class={`mcp-tab ${i === 0 ? 'mcp-tab--active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-target={c.id}
            >
              <span class="mcp-tab__icon" set:html={c.icon} />
              <span>{c.name}</span>
            </button>
          ))}
        </div>

        <!-- Tab Content Panes -->
        {clients.map((c, i) => (
          <div class={`mcp-pane ${i === 0 ? 'mcp-pane--active' : ''}`} id={`pane-${c.id}`} role="tabpanel">
            <!-- CLI Method -->
            <div class="mcp-method">
              <div class="mcp-method__head">
                <span class="mcp-method__step">1</span>
                <div>
                  <h3>{content.cliTabTitle}</h3>
                  <p class="mcp-method__hint">Runs automatically and configures your project file.</p>
                </div>
              </div>
              <div class="mcp-code-box">
                <code>{c.cliCommand}</code>
                <button class="mcp-copy-btn" data-copy={c.cliCommand}>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <span>Copy</span>
                </button>
              </div>
              {c.extraCommand && (
                <div style="margin-top: 0.75rem;">
                  <p class="mcp-method__hint" style="margin-bottom: 0.35rem;">Or for <strong>{c.extraLabel}</strong>:</p>
                  <div class="mcp-code-box">
                    <code>{c.extraCommand}</code>
                    <button class="mcp-copy-btn" data-copy={c.extraCommand}>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      <span>Copy</span>
                    </button>
                  </div>
                </div>
              )}
            </div>

            <!-- Manual Method -->
            <div class="mcp-method">
              <div class="mcp-method__head">
                <span class="mcp-method__step">2</span>
                <div>
                  <h3>{content.manualTabTitle}</h3>
                  <p class="mcp-method__hint">Or paste this directly into <code>{c.filePath}</code></p>
                </div>
              </div>
              <div class="mcp-code-box mcp-code-box--multiline">
                <pre><code>{c.jsonConfig}</code></pre>
                <button class="mcp-copy-btn" data-copy={c.jsonConfig}>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <span>Copy JSON</span>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Example Prompts -->
    <section class="mcp-prompts">
      <div class="mcp-section-head">
        <h2>{content.promptsTitle}</h2>
        <p>{content.promptsDesc}</p>
      </div>

      <div class="mcp-prompts-grid">
        {samplePrompts.map((p) => (
          <article class="mcp-prompt-card" data-prompt={p.text}>
            <div class="mcp-prompt-card__tag">{p.tag}</div>
            <p class="mcp-prompt-card__text">“{p.text}”</p>
            <button class="mcp-prompt-card__btn" data-copy={p.text}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy Prompt</span>
            </button>
          </article>
        ))}
      </div>
    </section>

    <!-- Tools Catalog -->
    <section class="mcp-tools">
      <div class="mcp-section-head">
        <h2>{content.toolsTitle}</h2>
        <p>{content.toolsDesc}</p>
      </div>

      <div class="mcp-tools-grid">
        {toolsList.map((t) => (
