---
/**
 * WhyBento — "Build faster with free Astro components" advantages grid for the home page.
 * Replaces the old expanding accordion: every card is always fully visible (no empty
 * collapsed rails), laid out as a responsive bento grid with localized copy.
 *
 * @param {'en'|'es'|'ru'} lang - Page locale.
 */
import { getLocalizedPath } from '../../i18n/translations';
import { components } from '../../data/registry/index';

interface Props {
  lang?: 'en' | 'es' | 'ru';
}

const { lang = 'en' } = Astro.props;

const componentCount = components.filter((c) => c.category !== 'sections').length;
const sectionCount = components.filter((c) => c.category === 'sections').length;

type Stat = [string, string];
interface Item {
  icon: string;
  tag: string;
  title: string;
  text: string;
  stats: Stat[];
  link: string;
  linkLabel: string;
  wide?: boolean;
}

const icons = {
  bolt: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  feather: '<path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><path d="M16 8 2 22M17.5 15H9"/>',
  access: '<circle cx="12" cy="4.5" r="2"/><path d="M5 8.5 12 10l7-1.5M12 10v4m0 0-3 7m3-7 3 7"/>',
  palette: '<circle cx="13.5" cy="6.5" r="1"/><circle cx="17.5" cy="10.5" r="1"/><circle cx="8.5" cy="7.5" r="1"/><circle cx="6.5" cy="12.5" r="1"/><path d="M12 2a10 10 0 0 0 0 20c1 0 1.7-.8 1.7-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.8-1.7 1.7-1.7h2A5.6 5.6 0 0 0 22 11c0-5-4.5-9-10-9z"/>',
  sliders: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  chart: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
};

const content: Record<'en' | 'es' | 'ru', Item[]> = {
  en: [
    { icon: icons.bolt, tag: 'Ship in minutes', title: 'Lightning-fast development', text: 'Copy-paste any component straight into your Astro project. No build config, no node_modules bloat — ship client and landing pages in minutes, not weeks.', stats: [['10×', 'Ship speed'], ['0 min', 'Setup'], ['Astro 5', 'Ready']], link: '/docs/glass-button', linkLabel: 'Browse components', wide: true },
    { icon: icons.feather, tag: 'Zero bloat', title: 'Zero runtime dependencies', text: 'Pure Astro + scoped vanilla CSS. Even the charts render to SVG at build time.', stats: [['0 kB', 'Runtime JS'], ['100', 'Lighthouse']], link: '/install', linkLabel: 'Install guide' },
    { icon: icons.access, tag: 'WCAG 2.2 AA', title: 'Accessible by default', text: 'Keyboard navigation, visible focus rings, ARIA where it matters and 4.5:1 contrast.', stats: [['≥4.5:1', 'Contrast'], ['44px', 'Targets']], link: '/docs/animated-input', linkLabel: 'See an example' },
    { icon: icons.palette, tag: 'Curated styles', title: 'Next-gen aesthetics', text: 'Glass, neon, neumorphic and dark-gold themes with fluid micro-interactions.', stats: [['6+', 'Styles'], ['60fps', 'Motion']], link: '/docs/glass-card', linkLabel: 'View cards' },
    { icon: icons.sliders, tag: 'CSS tokens', title: 'Total customization', text: 'Typed props, slots and CSS custom properties — re-theme everything from one file.', stats: [['100%', 'Tokenized'], ['Strict', 'TypeScript']], link: '/docs/floating-tab-bar', linkLabel: 'Explore props' },
    { icon: icons.chart, tag: 'MIT · Free forever', title: 'A library that keeps growing', text: 'Production components, SVG charts and full page sections across 11 categories, maintained in the open and updated every week.', stats: [[`${componentCount}`, 'Components'], [`${sectionCount}`, 'Sections'], ['MIT', 'License']], link: '/sections', linkLabel: 'Browse sections', wide: true },
  ],
  es: [
    { icon: icons.bolt, tag: 'Lanza en minutos', title: 'Desarrollo ultrarrápido', text: 'Copia y pega cualquier componente en tu proyecto Astro. Sin configurar builds ni inflar node_modules: publica landings y webs de clientes en minutos, no semanas.', stats: [['10×', 'Más rápido'], ['0 min', 'Configuración'], ['Astro 5', 'Compatible']], link: '/docs/glass-button', linkLabel: 'Ver componentes', wide: true },
    { icon: icons.feather, tag: 'Cero peso', title: 'Sin dependencias en runtime', text: 'Astro puro y CSS con ámbito. Incluso los gráficos se renderizan como SVG al compilar.', stats: [['0 kB', 'JS en runtime'], ['100', 'Lighthouse']], link: '/install', linkLabel: 'Guía de instalación' },
    { icon: icons.access, tag: 'WCAG 2.2 AA', title: 'Accesible por defecto', text: 'Navegación por teclado, anillos de foco visibles, ARIA donde importa y contraste 4.5:1.', stats: [['≥4.5:1', 'Contraste'], ['44px', 'Objetivos táctiles']], link: '/docs/animated-input', linkLabel: 'Ver un ejemplo' },
    { icon: icons.palette, tag: 'Estilos curados', title: 'Estética de nueva generación', text: 'Glassmorphism, neón, neumorfismo y dorado oscuro con microinteracciones fluidas.', stats: [['6+', 'Estilos'], ['60fps', 'Animación']], link: '/docs/glass-card', linkLabel: 'Ver tarjetas' },
    { icon: icons.sliders, tag: 'Tokens CSS', title: 'Personalización total', text: 'Props tipadas, slots y variables CSS: cambia el tema de todo desde un solo archivo.', stats: [['100%', 'Tokenizado'], ['Estricto', 'TypeScript']], link: '/docs/floating-tab-bar', linkLabel: 'Explorar props' },
    { icon: icons.chart, tag: 'MIT · Gratis siempre', title: 'Una librería que no deja de crecer', text: 'Componentes de producción, gráficos SVG y secciones de página completas en 11 categorías, mantenidos en abierto y actualizados cada semana.', stats: [[`${componentCount}`, 'Componentes'], [`${sectionCount}`, 'Secciones'], ['MIT', 'Licencia']], link: '/sections', linkLabel: 'Ver secciones', wide: true },
  ],
  ru: [
    { icon: icons.bolt, tag: 'Запуск за минуты', title: 'Молниеносная разработка', text: 'Копируйте любой компонент прямо в проект Astro. Без настройки сборки и раздутых node_modules — лендинги и клиентские сайты за минуты, а не недели.', stats: [['10×', 'Быстрее'], ['0 мин', 'Настройка'], ['Astro 5', 'Готово']], link: '/docs/glass-button', linkLabel: 'Смотреть компоненты', wide: true },
    { icon: icons.feather, tag: 'Ничего лишнего', title: 'Без runtime-зависимостей', text: 'Чистый Astro и изолированный CSS. Даже графики рендерятся в SVG при сборке.', stats: [['0 kB', 'JS в runtime'], ['100', 'Lighthouse']], link: '/install', linkLabel: 'Установка' },
    { icon: icons.access, tag: 'WCAG 2.2 AA', title: 'Доступность по умолчанию', text: 'Навигация с клавиатуры, видимый фокус, ARIA там, где нужно, и контраст 4.5:1.', stats: [['≥4.5:1', 'Контраст'], ['44px', 'Цели касания']], link: '/docs/animated-input', linkLabel: 'Пример' },
    { icon: icons.palette, tag: 'Отборные стили', title: 'Эстетика нового поколения', text: 'Стекло, неон, неоморфизм и тёмное золото с плавными микровзаимодействиями.', stats: [['6+', 'Стилей'], ['60fps', 'Анимация']], link: '/docs/glass-card', linkLabel: 'Карточки' },
    { icon: icons.sliders, tag: 'CSS-токены', title: 'Полная кастомизация', text: 'Типизированные props, слоты и CSS-переменные — меняйте тему всего из одного файла.', stats: [['100%', 'Токены'], ['Strict', 'TypeScript']], link: '/docs/floating-tab-bar', linkLabel: 'Props' },
    { icon: icons.chart, tag: 'MIT · Бесплатно', title: 'Библиотека, которая растёт', text: 'Готовые компоненты, SVG-графики и полные секции страниц в 11 категориях — открытая разработка и обновления каждую неделю.', stats: [[`${componentCount}`, 'Компоненты'], [`${sectionCount}`, 'Секции'], ['MIT', 'Лицензия']], link: '/sections', linkLabel: 'Смотреть секции', wide: true },
  ],
};

const items = content[lang];
---

<ul class="why-bento">
  {items.map((it, i) => (
    <li class:list={['why-bento__card', { 'why-bento__card--wide': it.wide }]} style={`--i:${i}`}>
      <div class="why-bento__glow" aria-hidden="true"></div>
      <div class="why-bento__top">
        <span class="why-bento__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={it.icon}></svg>
        </span>
        <span class="why-bento__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      </div>
      <span class="why-bento__tag">{it.tag}</span>
      <h3 class="why-bento__title">{it.title}</h3>
      <p class="why-bento__text">{it.text}</p>
      <dl class="why-bento__stats">
        {it.stats.map(([v, l]) => (
          <div class="why-bento__stat">
            <dt>{l}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      {it.wide && i === 0 && (
        <pre class="why-bento__visual why-bento__code" aria-hidden="true"><code><span class="k">import</span> {'{'} <span class="t">HeroWaitlist</span> {'}'} <span class="k">from</span>
  <span class="s">'astro-component-kit'</span>;

&lt;<span class="t">HeroWaitlist</span> <span class="a">count</span>={'{'}<span class="n">4280</span>{'}'} /&gt;</code></pre>
      )}
      {it.wide && i !== 0 && (
        <div class="why-bento__visual why-bento__bars" aria-hidden="true">
          {[22, 30, 34, 41, 47, 55, 63, 72, 84, 100].map((h, b) => <span style={`--h:${h}%; --d:${b * 60}ms`}></span>)}
        </div>
      )}
      <a class="why-bento__link" href={getLocalizedPath(it.link, lang)}>
        {it.linkLabel}<span class="why-bento__sr"> — {it.title}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .why-bento {
    list-style: none;
    margin: var(--sp-8, 2rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-4, 1rem);
  }
  .why-bento__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem;
    border-radius: var(--r-lg, 20px);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012));
    border: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.3s ease, transform 0.3s ease;
    animation: why-bento-in 0.6s ease both;
    animation-delay: calc(var(--i) * 70ms);
  }
  .why-bento__card--wide { grid-column: span 2; }
  .why-bento__card:hover,
  .why-bento__card:focus-within {
    border-color: rgba(212, 160, 23, 0.35);
    transform: translateY(-3px);
  }
  @keyframes why-bento-in {
    from { opacity: 0; transform: translateY(12px); }
  }
  .why-bento__glow {
    position: absolute;
    inset: auto -30% -60% auto;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 160, 23, 0.16), transparent 65%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
  }
  .why-bento__card--wide .why-bento__glow { opacity: 0.6; }
  .why-bento__card:hover .why-bento__glow { opacity: 1; }
  .why-bento__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; }
  .why-bento__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(212, 160, 23, 0.1);
    border: 1px solid rgba(212, 160, 23, 0.25);
    color: var(--c-primary-light, #d4a017);
  }
  .why-bento__num {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--c-text-3, #737373);
  }
  .why-bento__tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-primary-light, #d4a017);
  }
  .why-bento__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--c-text-1, #fff);
  }
  .why-bento__card--wide .why-bento__title { font-size: 1.4rem; }
  .why-bento__text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--c-text-2, #a3a3a3);
  }
  .why-bento__card--wide .why-bento__text { max-width: 52ch; }
  .why-bento__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: auto 0 0;
    padding-top: 0.9rem;
  }
  .why-bento__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.1rem;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .why-bento__stat dt { font-size: 0.6875rem; color: var(--c-text-3, #8a8a8a); }
  .why-bento__stat dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 750;
    color: var(--c-text-1, #fff);
    font-variant-numeric: tabular-nums;
  }
  .why-bento__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    align-self: flex-start;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-text-1, #fff);
    text-decoration: none;
  }
  .why-bento__link svg { color: var(--c-primary-light, #d4a017); transition: transform 0.2s ease; }
  .why-bento__link:hover { color: var(--c-primary-light, #d4a017); }
  .why-bento__link:hover svg { transform: translateX(3px); }
  .why-bento__link:focus-visible { outline: 2px solid var(--c-primary-light, #d4a017); outline-offset: 2px; border-radius: 4px; }
  .why-bento__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 1024px) {
    .why-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .why-bento { grid-template-columns: 1fr; }
    .why-bento__card--wide { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .why-bento__card { animation: none; transition: none; }
  }

  /* Decorative visual on the wide cards (desktop only) */
  .why-bento__visual {
    position: absolute;
    right: 1.6rem;
    top: 50%;
    transform: translateY(-50%);
    width: 38%;
    margin: 0;
  }
  .why-bento__card--wide .why-bento__text,
  .why-bento__card--wide .why-bento__title { max-width: 56%; }
  .why-bento__code {
    padding: 1rem 1.1rem;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.07);
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--c-text-2, #c4c4c4);
    white-space: pre;
    overflow: hidden;
  }
  .why-bento__code .k { color: #c792ea; }
  .why-bento__code .t { color: #82aaff; }
  .why-bento__code .s { color: #c3e88d; }
  .why-bento__code .a { color: #ffcb6b; }
  .why-bento__code .n { color: #f78c6c; }
  .why-bento__bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 120px;
  }
  .why-bento__bars span {
    flex: 1;
    height: var(--h);
    border-radius: 4px 4px 0 0;
    background: linear-gradient(to top, rgba(212, 160, 23, 0.15), rgba(212, 160, 23, 0.75));
    transform-origin: bottom;
    animation: why-bar-grow 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
    animation-delay: var(--d);
  }
  .why-bento__bars span:last-child { background: linear-gradient(to top, rgba(212, 160, 23, 0.3), var(--c-primary-light, #d4a017)); }
  @keyframes why-bar-grow { from { transform: scaleY(0); } }
  @media (max-width: 1180px) {
    .why-bento__visual { display: none; }
    .why-bento__card--wide .why-bento__text,
    .why-bento__card--wide .why-bento__title { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) { .why-bento__bars span { animation: none; } }
</style>
