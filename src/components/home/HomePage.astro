---
// src/components/home/HomePage.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import SisterSiteLink from '../layout/SisterSiteLink.astro';
import LanguagePicker from '../layout/LanguagePicker.astro';
import { categories, components } from '../../data/registry/index';
import { useTranslations, getLocalizedPath } from '../../i18n/translations';
import { getLocalizedCategory } from '../../i18n/catalog';

// Hero demo components (floating cards)
import NotificationCard from '../lib/cards/NotificationCard.astro';
import MusicPlayerMini from '../lib/cards/MusicPlayerMini.astro';
import SegmentedControl from '../lib/forms/SegmentedControl.astro';
import GlassSlider from '../lib/forms/GlassSlider.astro';
import SparklineChart from '../lib/charts/SparklineChart.astro';
import RadialBarChart from '../lib/charts/RadialBarChart.astro';
import Galaxy3D from '../lib/Galaxy3D.astro';
import TemplatesPromo from './TemplatesPromo.astro';
import pkg from '../../../package.json';

// Carousel & Showcase demo components
import ShimmerButton from '../lib/buttons/ShimmerButton.astro';
import CyberpunkButton from '../lib/buttons/CyberpunkButton.astro';
import LiquidButton from '../lib/buttons/LiquidButton.astro';
import RetroArcadeButton from '../lib/buttons/RetroArcadeButton.astro';
import GlowButton from '../lib/buttons/GlowButton.astro';

import SearchReveal from '../lib/forms/SearchReveal.astro';
import StepperInput from '../lib/forms/StepperInput.astro';

import FloatingTabBar from '../lib/navigation/FloatingTabBar.astro';




// Section components for the new Full-Width Sections Carousel
import StatsDashboardSection from '../lib/sections/StatsDashboardSection.astro';
import PricingToggleCards from '../lib/sections/PricingToggleCards.astro';
import HeroDashboardPreview from '../lib/sections/HeroDashboardPreview.astro';
import FeatureTabsShowcase from '../lib/sections/FeatureTabsShowcase.astro';
import TestimonialCarousel from '../lib/sections/TestimonialCarousel.astro';
import IntegrationsGrid from '../lib/sections/IntegrationsGrid.astro';
import WhyBento from './WhyBento.astro';

// Interaction lab
import InteractiveTiltCard from '../lib/cards/InteractiveTiltCard.astro';
import HackerDecodeText from '../lib/typography/HackerDecodeText.astro';
import RippleButton from '../lib/buttons/RippleButton.astro';
import MagneticButton from '../lib/buttons/MagneticButton.astro';
import NeonBorderButton from '../lib/buttons/NeonBorderButton.astro';
import PasswordStrengthInput from '../lib/forms/PasswordStrengthInput.astro';
import GlassInlineToggleGroup from '../lib/forms/GlassInlineToggleGroup.astro';

// New SVG charts & statistics for the component carousel
import KpiStatTile from '../lib/charts/KpiStatTile.astro';
import GaugeChart from '../lib/charts/GaugeChart.astro';
import ActivityRings from '../lib/charts/ActivityRings.astro';
import MeterGauge from '../lib/charts/MeterGauge.astro';
import WaffleChart from '../lib/charts/WaffleChart.astro';
import BulletChart from '../lib/charts/BulletChart.astro';
import PieChart from '../lib/charts/PieChart.astro';
import FunnelChart from '../lib/charts/FunnelChart.astro';

interface Props {
  lang?: 'en' | 'es' | 'ru';
}


const { lang = 'en' } = Astro.props;

// "Why developers choose…" block (also SEO copy), localized.
const advantages = {
  en: {
    eyebrow: 'Advantages',
    title: 'Why developers choose Astro Components Kit',
    items: [
      ['Performance-first architecture', 'Every Astro component ships with zero client-side JavaScript by default. Your pages load instantly because components render to static HTML at build time. No hydration, no waterfalls, no layout shift.'],
      ['Copy-paste workflow', 'No package manager overhead. Just copy the component source into your project, import it, and use it. Every component is self-contained with its own styles and markup.'],
      ['SEO-friendly out of the box', 'Since components render server-side, search engines can crawl and index your content immediately. No waiting for JavaScript bundles to load. Semantic HTML structure built into every component.'],
      ['Design system ready', 'CSS custom properties, consistent spacing scale, typography system, and color palette — everything is pre-configured. Customize once, apply everywhere.'],
      ['Open source & MIT licensed', 'Free for personal and commercial use. Contribute components, report bugs, or fork the entire library. Built by developers, for developers.'],
    ],
  },
  es: {
    eyebrow: 'Ventajas',
    title: 'Por qué los desarrolladores eligen Astro Components Kit',
    items: [
      ['Arquitectura pensada para el rendimiento', 'Cada componente Astro se entrega sin JavaScript en el cliente por defecto. Tus páginas cargan al instante porque los componentes se renderizan como HTML estático en el build. Sin hidratación, sin cascadas de peticiones y sin saltos de layout.'],
      ['Flujo de copiar y pegar', 'Sin sobrecarga de gestores de paquetes. Copia el código del componente en tu proyecto, impórtalo y úsalo. Cada componente es autónomo, con sus propios estilos y marcado.'],
      ['SEO de serie', 'Como los componentes se renderizan en el servidor, los buscadores pueden rastrear e indexar tu contenido de inmediato, sin esperar a que cargue JavaScript. HTML semántico en cada componente.'],
      ['Listo para tu sistema de diseño', 'Variables CSS, escala de espaciado coherente, sistema tipográfico y paleta de color: todo viene configurado. Personalízalo una vez y aplícalo en todas partes.'],
      ['Código abierto y licencia MIT', 'Gratis para uso personal y comercial. Aporta componentes, reporta errores o haz un fork de toda la librería. Hecho por desarrolladores, para desarrolladores.'],
    ],
  },
  ru: {
    eyebrow: 'Преимущества',
    title: 'Почему разработчики выбирают Astro Components Kit',
    items: [
      ['Архитектура с упором на скорость', 'Каждый компонент Astro по умолчанию работает без клиентского JavaScript. Страницы загружаются мгновенно, потому что компоненты рендерятся в статический HTML при сборке. Без гидрации, каскадов запросов и сдвигов макета.'],
      ['Копируй и вставляй', 'Без лишних пакетных менеджеров. Скопируйте исходный код компонента в проект, импортируйте и используйте. Каждый компонент самодостаточен — со своими стилями и разметкой.'],
      ['SEO из коробки', 'Компоненты рендерятся на сервере, поэтому поисковики сразу сканируют и индексируют контент — без ожидания загрузки JavaScript. Семантический HTML в каждом компоненте.'],
      ['Готово для дизайн-системы', 'CSS-переменные, единая шкала отступов, типографика и цветовая палитра — всё уже настроено. Настройте один раз и применяйте везде.'],
      ['Открытый код и лицензия MIT', 'Бесплатно для личного и коммерческого использования. Предлагайте компоненты, сообщайте об ошибках или форкните всю библиотеку. Создано разработчиками для разработчиков.'],
    ],
  },
}[lang];

const marqueeItems = {
  en: ['ASTRO', 'ZERO JS', '320+ COMPONENTS', 'TEMPLATES', 'OPEN SOURCE', 'MIT LICENSE', 'ACCESSIBLE', 'PERFORMANT'],
  es: ['ASTRO', 'CERO JS', '+320 COMPONENTES', 'PLANTILLAS', 'CÓDIGO ABIERTO', 'LICENCIA MIT', 'ACCESIBLE', 'RÁPIDO'],
  ru: ['ASTRO', 'НОЛЬ JS', '320+ КОМПОНЕНТОВ', 'ШАБЛОНЫ', 'ОТКРЫТЫЙ КОД', 'ЛИЦЕНЗИЯ MIT', 'ДОСТУПНО', 'БЫСТРО'],
}[lang];

const ui = {
  en: { menu: 'Toggle site menu', copyInstall: 'Copy install command', copy: 'Copy command', prev: 'Previous section', next: 'Next section', marquee: 'Highlights', explore: 'Explore all components', license: 'MIT License' },
  es: { menu: 'Abrir o cerrar el menú', copyInstall: 'Copiar comando de instalación', copy: 'Copiar comando', prev: 'Sección anterior', next: 'Sección siguiente', marquee: 'Destacados', explore: 'Explorar todos los componentes', license: 'Licencia MIT' },
  ru: { menu: 'Открыть или закрыть меню', copyInstall: 'Скопировать команду установки', copy: 'Скопировать команду', prev: 'Предыдущая секция', next: 'Следующая секция', marquee: 'Главное', explore: 'Все компоненты', license: 'Лицензия MIT' },
}[lang];
const t = useTranslations(lang);

// Charts & statistics shown in the second component carousel row.
const chartSlides = [
  { C: KpiStatTile, slug: 'kpi-stat-tile', label: 'KPI Stat Tile', width: 300, props: { label: 'Monthly revenue', value: '$84.2k', change: 12.4 } },
  { C: GaugeChart, slug: 'gauge-chart', label: 'Gauge Chart', width: 320, props: { variant: 'ghost', size: 'sm', title: 'Sales goal', subtitle: 'November' } },
  { C: ActivityRings, slug: 'activity-rings', label: 'Activity Rings', width: 440, props: { variant: 'ghost', size: 'sm' } },
  { C: FunnelChart, slug: 'funnel-chart', label: 'Funnel Chart', width: 440, props: { variant: 'ghost', size: 'sm', stages: [{ label: 'Visited', value: 48200 }, { label: 'Trial', value: 6400 }, { label: 'Paid', value: 1240 }] } },
  { C: MeterGauge, slug: 'meter-gauge', label: 'Meter Gauge', width: 320, props: { variant: 'ghost', size: 'sm' } },
  { C: WaffleChart, slug: 'waffle-chart', label: 'Waffle Chart', width: 440, props: { variant: 'ghost', size: 'sm' } },
  { C: BulletChart, slug: 'bullet-chart', label: 'Bullet Chart', width: 400, props: { variant: 'ghost', size: 'sm', metrics: [{ label: 'Revenue ($k)', value: 270, target: 250, ranges: [150, 225, 300] }, { label: 'NPS', value: 44, target: 50, ranges: [30, 50, 70] }] } },
  { C: PieChart, slug: 'pie-chart', label: 'Pie Chart', width: 480, props: { variant: 'ghost', size: 'sm' } },
];

// Full sections shown in the sections spotlight carousel.
const sectionSlides = [
  { C: StatsDashboardSection, slug: 'stats-dashboard-section', cat: { en: 'Stats & Metrics', es: 'Métricas', ru: 'Метрики' }, name: 'Stats Dashboard Section', summary: { en: 'KPI tiles, stacked area and ranked bar charts in one analytics block.', es: 'Tarjetas KPI, áreas apiladas y ranking en barras en un solo bloque.', ru: 'KPI-плитки, накопительные области и рейтинг в одном блоке.' } },
  { C: PricingToggleCards, slug: 'pricing-toggle-cards', cat: { en: 'Pricing & Plans', es: 'Precios', ru: 'Тарифы' }, name: 'Pricing Toggle Cards', summary: { en: 'Three tiers with an accessible monthly/yearly switch and featured plan.', es: 'Tres planes con interruptor mensual/anual accesible y plan destacado.', ru: 'Три тарифа с переключателем месяц/год и выделенным планом.' } },
  { C: HeroDashboardPreview, slug: 'hero-dashboard-preview', cat: { en: 'Hero', es: 'Hero', ru: 'Hero' }, name: 'Hero Dashboard Preview', summary: { en: 'SaaS hero with a live dashboard mockup built from SVG charts.', es: 'Hero SaaS con maqueta de dashboard hecha con gráficos SVG.', ru: 'SaaS-hero с макетом дашборда из SVG-графиков.' } },
  { C: FeatureTabsShowcase, slug: 'feature-tabs-showcase', cat: { en: 'Features', es: 'Características', ru: 'Возможности' }, name: 'Feature Tabs Showcase', summary: { en: 'WAI-ARIA tabs with arrow-key navigation and stat panels.', es: 'Pestañas WAI-ARIA con navegación por flechas y paneles de métricas.', ru: 'Вкладки WAI-ARIA с навигацией стрелками и панелями цифр.' } },
  { C: TestimonialCarousel, slug: 'testimonial-carousel', cat: { en: 'Testimonials', es: 'Testimonios', ru: 'Отзывы' }, name: 'Testimonial Carousel', summary: { en: 'Scroll-snap reviews with ratings, prev/next controls and no autoplay.', es: 'Opiniones con scroll-snap, estrellas y controles, sin autoplay.', ru: 'Отзывы со scroll-snap, рейтингом и кнопками, без автопрокрутки.' } },
  { C: IntegrationsGrid, slug: 'integrations-grid', cat: { en: 'Features', es: 'Características', ru: 'Возможности' }, name: 'Integrations Grid', summary: { en: 'Integrations directory with category filters and status badges.', es: 'Directorio de integraciones con filtros y estados de disponibilidad.', ru: 'Каталог интеграций с фильтрами и статусами.' } },
];
const viewLabel = lang === 'es' ? 'Ver' : lang === 'ru' ? 'Открыть' : 'View';
const exploreLabel = lang === 'es' ? 'Ver código de la plantilla' : lang === 'ru' ? 'Открыть код шаблона' : 'Explore Template Code';
---

<BaseLayout
  title={lang === 'es' ? 'Astro Components Kit — 320+ Componentes UI y Plantillas Gratis para Astro' : lang === 'ru' ? 'Astro Components Kit — 320+ Бесплатных UI Компонентов и Шаблонов для Astro' : 'Astro Components Kit — 320+ Free UI Components & Templates for Astro'}
  description={lang === 'es' ? 'Librería UI 100% gratuita y de código abierto para Astro. Más de 320 componentes accesibles, gráficos SVG y plantillas completas de producción sin dependencias.' : lang === 'ru' ? 'Бесплатная библиотека UI компонентов и шаблонов для Astro с открытым исходным кодом. Более 320 компонентов, SVG-графиков и готовых шаблонов без зависимостей.' : 'Free open-source Astro component library. 320+ free, accessible, copy-paste ready UI components, zero-dep SVG charts, and complete multi-page templates. Zero dependencies.'}
>
  <!-- Three.js background -->
  <div class="particle-wrap" aria-hidden="true">
    <canvas id="bg-3d-canvas"></canvas>
  </div>

  <!-- Brutalist accent lines -->
  <div class="brutal-line brutal-line--1" aria-hidden="true"></div>
  <div class="brutal-line brutal-line--2" aria-hidden="true"></div>
  <div class="brutal-block brutal-block--1" aria-hidden="true"></div>

  <!-- Sticky header -->
  <header class="docs-header">
    <div class="docs-header__inner">
      <a href={getLocalizedPath('/', lang)} class="docs-header__brand">
        <img src="/logo-animated.svg" alt="Astro Kit Components" class="brand-logo" />
      </a>
      <button class="site-menu-toggle" id="site-menu-toggle" aria-label={ui.menu}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
      </button>
      <nav class="docs-header__nav" id="site-nav">
        <a href={getLocalizedPath('/', lang)} class:list={{ active: true }}>{t('nav.home')}</a>
        <a href={getLocalizedPath('/install', lang)}>{t('nav.install')}</a>
        <a href={getLocalizedPath('/mcp', lang)}>{t('nav.mcp')}</a>
        <a href={getLocalizedPath('/docs/glass-button', lang)}>{t('nav.components')}</a>
        <a href={getLocalizedPath('/sections', lang)}>{t('nav.sections')}</a>
        <a href={getLocalizedPath('/templates', lang)}>{t('nav.templates')}</a>
        <a href={getLocalizedPath('/notes', lang)}>{t('nav.notes')}</a>
        <LanguagePicker currentLang={lang} />
        <SisterSiteLink />
        <a href="https://github.com/konstantinWDK/astro-components" target="_blank" rel="noopener" class="gh-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="GitHub">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ==================== HERO ==================== -->
    <section class="hero">
      <div class="hero__scene">
        <!-- Galaxy 3D background -->
        <div class="hero__galaxy-bg" aria-hidden="true">
          <Galaxy3D />
        </div>

        <!-- Orbit paths the floating cards travel along -->
        <div class="hero__orbits" aria-hidden="true"><span></span><span></span></div>

        <!-- Floating component cards: 3 per side on orbits at different depths (near / mid / far) -->
        <a href={getLocalizedPath('/docs/sparkline-chart', lang)} class="showcase-card showcase-card--1 is-near" aria-label="Sparkline Chart">
          <div class="showcase-card__body">
            <span class="showcase-card__stars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <div class="showcase-card__inner showcase-card__inner--kpi" inert>
            <span class="hero-kpi__label">{lang === 'es' ? 'Ingresos mensuales' : lang === 'ru' ? 'Выручка за месяц' : 'Monthly revenue'}</span>
            <span class="hero-kpi__row"><strong class="hero-kpi__value">$48.2k</strong><span class="hero-kpi__delta">+24%</span></span>
            <SparklineChart data={[18, 22, 19, 26, 24, 31, 28, 35, 33, 41, 39, 48]} size="lg" variant="area" label="Monthly revenue" />
          </div>
          </div>
        </a>
        <a href={getLocalizedPath('/docs/notification-card', lang)} class="showcase-card showcase-card--2 is-far" aria-label="Notification Card">
          <div class="showcase-card__body">
            <span class="showcase-card__stars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <div class="showcase-card__inner showcase-card__inner--flush" inert><NotificationCard type="success" title={lang === 'es' ? 'Despliegue completado' : lang === 'ru' ? 'Деплой завершён' : 'Deploy succeeded'} message={lang === 'es' ? '1.029 páginas generadas en 18s' : lang === 'ru' ? '1029 страниц собрано за 18 с' : '1,029 pages built in 18s'} /></div>
          </div>
        </a>
        <a href={getLocalizedPath('/docs/segmented-control', lang)} class="showcase-card showcase-card--3 is-mid" aria-label="Segmented Control">
          <div class="showcase-card__body">
            <span class="showcase-card__stars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <div class="showcase-card__inner" inert><SegmentedControl name="hero-range" idPrefix="hero-seg" options={[{ label: '7D', value: '7d' }, { label: '30D', value: '30d', checked: true }, { label: '90D', value: '90d' }, { label: '1Y', value: '1y' }]} /></div>
          </div>
        </a>
        <a href={getLocalizedPath('/docs/radial-bar-chart', lang)} class="showcase-card showcase-card--4 is-mid" aria-label="Radial Bar Chart">
          <div class="showcase-card__body">
            <span class="showcase-card__stars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <div class="showcase-card__inner showcase-card__inner--chart" inert><RadialBarChart size="sm" variant="ghost" title={lang === 'es' ? 'Adopción' : lang === 'ru' ? 'Внедрение' : 'Adoption'} subtitle="" items={[{ label: 'Charts', value: 82 }, { label: 'Sections', value: 64 }, { label: 'Forms', value: 47 }]} /></div>
          </div>
        </a>
        <a href={getLocalizedPath('/docs/music-player-mini', lang)} class="showcase-card showcase-card--5 is-far" aria-label="Music Player Mini">
          <div class="showcase-card__body">
            <span class="showcase-card__stars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <div class="showcase-card__inner showcase-card__inner--flush" inert><MusicPlayerMini title="Midnight Build" artist="Astro Kit · Lo-fi" progress={62} /></div>
          </div>
        </a>
        <a href={getLocalizedPath('/docs/glass-slider', lang)} class="showcase-card showcase-card--6 is-near" aria-label="Glass Slider">
          <div class="showcase-card__body">
            <span class="showcase-card__stars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <div class="showcase-card__inner showcase-card__inner--slider" inert><GlassSlider id="hero-slider" label={lang === 'es' ? 'Desenfoque' : lang === 'ru' ? 'Размытие' : 'Blur intensity'} value={68} /></div>
          </div>
        </a>

        <!-- Center: Title overlay -->
        <div class="hero__content">
          <div class="hero__title-wrap">
          <h1 class="hero__title">
            <span class="hero__title-row">
              <span class="hero__title-main" data-title-line="1">
                <span class="hero__l">A</span><span class="hero__l">S</span><span class="hero__l">T</span><span class="hero__l">R</span><span class="hero__l">O</span>&nbsp;<span class="hero__l">K</span><span class="hero__l">I</span><span class="hero__l">T</span>
              </span>
            </span>
            <span class="hero__title-row">
              <span class="hero__title-main" data-title-line="2">
                <span class="hero__l">C</span><span class="hero__l">O</span><span class="hero__l">M</span><span class="hero__l">P</span><span class="hero__l">O</span><span class="hero__l">N</span><span class="hero__l">E</span><span class="hero__l">N</span><span class="hero__l">T</span><span class="hero__l">S</span>
              </span>
            </span>
          </h1>
          <a
            class="hero-version"
            href="https://www.npmjs.com/package/astro-component-kit"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${lang === 'es' ? 'Versión actual' : lang === 'ru' ? 'Текущая версия' : 'Current version'} v${pkg.version} — npm`}
          >
            <span class="hero-version__bubble">
              <span class="hero-version__dot" aria-hidden="true"></span>
              v{pkg.version}
            </span>
          </a>
          </div>

          <p class="hero__subtitle">
            {lang === 'es' ? 'Componentes UI gratuitos y de código abierto para Astro. Cero dependencias. Copia, pega y publica.' : lang === 'ru' ? 'Бесплатные open-source UI компоненты для Astro. Без зависимостей. Копируй, вставляй и публикуй.' : 'Free open-source UI components for Astro. Zero dependencies. Copy, paste, ship.'}
          </p>

          <div class="hero__install-wrap">
            <div class="hero__install">
              <svg class="hero__install-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <code class="hero__install-code">$ npm install astro-component-kit</code>
              <button class="hero__copy-btn" id="heroCopyBtn" aria-label={ui.copyInstall} type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
          </div>

          <div class="hero__actions">
            <a href={getLocalizedPath('/docs/glass-button', lang)} class="hero__cta-btn">
              {lang === 'es' ? 'Explorar todos los componentes' : lang === 'ru' ? 'Все компоненты' : 'Browse All Components'}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Background glow -->
