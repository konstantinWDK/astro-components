---
// src/components/home/TemplatesPromo.astro
// Home section that announces the complete multi-page templates.
import TemplateFrame from '../docs/TemplateFrame.astro';
import { templates } from '../../data/registry/templates';
import { getLocalizedPath } from '../../i18n/translations';
import type { Locale } from '../../config/site';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const tpl = templates[0];
const componentCount = tpl.newComponents.length + tpl.reusedComponents.length;

const copy = {
  en: {
    eyebrow: 'New · Complete templates',
    title: 'Not just components.',
    highlight: 'Whole sites, ready to ship.',
    text: 'Templates assemble library components into complete, multi-page sites. Preview every page live, then import the whole thing with one line — or take only the pieces you need.',
    pagesLabel: 'pages',
    componentsLabel: 'components',
    themesLabel: 'Light & dark',
    pages: ['Store home', 'Category', 'Product page', 'Checkout'],
    included: `${templates.length} templates · E-commerce Store, E-commerce 2 Editorial`,
    cta: 'Explore templates',
    demo: 'Open live demo',
    soon: 'Coming next: SaaS landing · Dashboard · Blog',
  },
  es: {
    eyebrow: 'Nuevo · Plantillas completas',
    title: 'No solo componentes.',
    highlight: 'Sitios enteros, listos para publicar.',
    text: 'Las plantillas combinan componentes de la librería en sitios completos de varias páginas. Mira cada página en vivo e impórtala entera con una línea, o quédate solo con las piezas que necesites.',
    pagesLabel: 'páginas',
    componentsLabel: 'componentes',
    themesLabel: 'Claro y oscuro',
    pages: ['Home de tienda', 'Categoría', 'Ficha de producto', 'Checkout'],
    included: `${templates.length} plantillas · Tienda e-commerce, E-commerce 2 Editorial`,
    cta: 'Ver plantillas',
    demo: 'Abrir demo en vivo',
    soon: 'Próximamente: landing SaaS · Dashboard · Blog',
  },
  ru: {
    eyebrow: 'Новое · Готовые шаблоны',
    title: 'Не только компоненты.',
    highlight: 'Целые сайты, готовые к запуску.',
    text: 'Шаблоны собирают компоненты библиотеки в полноценные многостраничные сайты. Посмотрите каждую страницу вживую и подключите весь шаблон одной строкой — или возьмите только нужные части.',
    pagesLabel: 'страниц',
    componentsLabel: 'компонентов',
    themesLabel: 'Светлая и тёмная',
    pages: ['Главная магазина', 'Категория', 'Карточка товара', 'Оформление заказа'],
    included: `Шаблонов: ${templates.length} · интернет-магазин, E-commerce 2 Editorial`,
    cta: 'Смотреть шаблоны',
    demo: 'Открыть демо',
    soon: 'Скоро: SaaS-лендинг · Дашборд · Блог',
  },
}[lang];

const pageIcons = [
  '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  '<path d="M6 7h12l-1 13H7z"/><path d="M9 7V6a3 3 0 0 1 6 0v1"/>',
  '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>',
];
---

<section class="section tpl-promo" id="templates" aria-labelledby="tpl-promo-title">
  <div class="container">
    <div class="tpl-promo__panel">
      <div class="tpl-promo__glow" aria-hidden="true"></div>

      <div class="tpl-promo__copy">
        <span class="tpl-promo__eyebrow"><span class="tpl-promo__pulse" aria-hidden="true"></span>{copy.eyebrow}</span>
        <h2 class="tpl-promo__title" id="tpl-promo-title">{copy.title} <em>{copy.highlight}</em></h2>
        <p class="tpl-promo__text">{copy.text}</p>

        <p class="tpl-promo__included">{copy.included}</p>
        <ul class="tpl-promo__pages">
          {tpl.pages.map((p, i) => (
            <li>
              <a href={`${tpl.previewBase}${p.path}`} target="_blank" rel="noopener">
                <span class="tpl-promo__page-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={pageIcons[i]} /></svg>
                </span>
                {copy.pages[i]}
              </a>
            </li>
          ))}
        </ul>

        <dl class="tpl-promo__stats">
          <div><dt>{copy.pagesLabel}</dt><dd>{tpl.pages.length}</dd></div>
          <div><dt>{copy.componentsLabel}</dt><dd>{componentCount}</dd></div>
          <div><dt>{copy.themesLabel}</dt><dd aria-hidden="true">◐</dd></div>
        </dl>

        <div class="tpl-promo__ctas">
          <a class="tpl-promo__btn tpl-promo__btn--primary" href={getLocalizedPath('/templates', lang)}>
            {copy.cta}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="tpl-promo__btn" href={tpl.previewBase} target="_blank" rel="noopener">
            {copy.demo}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </div>
        <p class="tpl-promo__soon">{copy.soon}</p>
      </div>

      <div class="tpl-promo__stage" aria-hidden="true">
        <div class="tpl-promo__win tpl-promo__win--main">
          <TemplateFrame src={tpl.previewBase} title="Store home" height={1000} />
        </div>
        <div class="tpl-promo__win tpl-promo__win--product">
          <TemplateFrame src={`${tpl.previewBase}product/aurora-headphones/`} title="Product page" width={1280} height={1000} />
        </div>
        <div class="tpl-promo__win tpl-promo__win--checkout">
          <TemplateFrame src={`${tpl.previewBase}checkout/`} title="Checkout" width={1280} height={1100} />
        </div>
        <span class="tpl-promo__chip tpl-promo__chip--cart">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Added to cart
        </span>
        <span class="tpl-promo__chip tpl-promo__chip--code">&lt;StoreHomePage /&gt;</span>
      </div>
    </div>
  </div>
</section>

<style>
  .tpl-promo { padding: 3rem 0 5rem; }
  .tpl-promo__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding: clamp(1.75rem, 4vw, 3.5rem);
    border-radius: var(--r-xl);
    border: 1px solid rgba(212, 160, 23, 0.18);
    background:
      radial-gradient(circle at 0% 0%, rgba(212, 160, 23, 0.12), transparent 40%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.008));
    overflow: hidden;
    isolation: isolate;
  }
  .tpl-promo__glow {
    position: absolute;
    right: -10%;
    top: -30%;
    width: 60%;
    height: 160%;
    background: radial-gradient(closest-side, rgba(212, 160, 23, 0.14), transparent 70%);
    z-index: -1;
    pointer-events: none;
  }

  .tpl-promo__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--r-full);
    border: 1px solid rgba(212, 160, 23, 0.35);
    background: rgba(212, 160, 23, 0.1);
    color: #facc15;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tpl-promo__pulse { width: 7px; height: 7px; border-radius: 50%; background: #facc15; box-shadow: 0 0 0 0 rgba(250, 204, 21, 0.6); animation: tp-pulse 2s ease-out infinite; }
  @keyframes tp-pulse { 70% { box-shadow: 0 0 0 8px rgba(250, 204, 21, 0); } 100% { box-shadow: 0 0 0 0 rgba(250, 204, 21, 0); } }

  .tpl-promo__title {
    margin: 1.1rem 0 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--c-text-1);
  }
  .tpl-promo__title em {
    display: block;
    font-style: normal;
    background: linear-gradient(100deg, var(--c-accent), var(--c-primary-light) 55%, var(--c-primary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tpl-promo__text { margin: 1.1rem 0 0; max-width: 34rem; font-size: 1rem; line-height: 1.7; color: var(--c-text-2); }

  .tpl-promo__included { margin: 1.75rem 0 0.75rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-3); }
  .tpl-promo__pages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .tpl-promo__pages a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0 0.85rem;
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    background: rgba(255, 255, 255, 0.02);
    color: var(--c-text-1);
    font-size: 0.88rem;
    font-weight: 600;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }
  .tpl-promo__pages a:hover { border-color: rgba(212, 160, 23, 0.4); background: rgba(212, 160, 23, 0.06); color: var(--c-text-1); transform: translateY(-1px); }
  .tpl-promo__page-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: rgba(212, 160, 23, 0.12); color: var(--c-primary-light); flex-shrink: 0; }

  .tpl-promo__stats { display: flex; flex-wrap: wrap; gap: 2rem; margin: 1.75rem 0 0; }
  .tpl-promo__stats div { display: flex; flex-direction: column-reverse; }
  .tpl-promo__stats dt { font-size: 0.78rem; color: var(--c-text-3); }
  .tpl-promo__stats dd { margin: 0; font-size: 1.5rem; font-weight: 900; letter-spacing: -0.02em; color: var(--c-text-1); line-height: 1.2; }

  .tpl-promo__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .tpl-promo__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 50px;
    padding: 0 1.4rem;
    border-radius: var(--r-full);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--c-text-1);
    font-weight: 700;
    font-size: 0.92rem;
    transition: background 0.2s ease, transform 0.2s ease, filter 0.2s ease;
  }
  .tpl-promo__btn:hover { background: rgba(255, 255, 255, 0.05); color: var(--c-text-1); }
  .tpl-promo__btn--primary { border-color: transparent; background: var(--c-primary-light); color: var(--c-bg); }
  .tpl-promo__btn--primary:hover { background: var(--c-primary-light); color: var(--c-bg); filter: brightness(1.08); transform: translateY(-2px); }
  .tpl-promo__btn:focus-visible, .tpl-promo__pages a:focus-visible { outline: 2px solid var(--c-primary-light); outline-offset: 3px; }
  .tpl-promo__soon { margin: 1rem 0 0; font-size: 0.8rem; color: var(--c-text-3); }

  /* Stage: three live windows */
  .tpl-promo__stage { position: relative; aspect-ratio: 1 / 0.86; min-width: 0; }
  .tpl-promo__win {
    position: absolute;
    border-radius: var(--r-md);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.06);
    overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tpl-promo__win--main { top: 0; left: 0; width: 82%; z-index: 1; }
  .tpl-promo__win--product { right: 0; top: 34%; width: 46%; z-index: 2; transform: rotate(2deg); }
  .tpl-promo__win--checkout { left: 8%; bottom: 0; width: 40%; z-index: 3; transform: rotate(-2.5deg); }
  .tpl-promo__panel:hover .tpl-promo__win--main { transform: translateY(-4px); }
  .tpl-promo__panel:hover .tpl-promo__win--product { transform: rotate(0deg) translateY(-8px); }
  .tpl-promo__panel:hover .tpl-promo__win--checkout { transform: rotate(0deg) translateY(-6px); }

  .tpl-promo__chip {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--r-full);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(10px);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--c-text-1);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.8);
    animation: tp-float 6s ease-in-out infinite;
  }
  .tpl-promo__chip--cart { right: 6%; top: 22%; }
  .tpl-promo__chip--cart svg { color: #34d399; }
  .tpl-promo__chip--code { right: 4%; bottom: 6%; font-family: var(--font-mono); color: #facc15; animation-delay: -3s; }
  @keyframes tp-float { 50% { transform: translateY(-6px); } }

  @media (max-width: 1024px) {
    .tpl-promo__panel { grid-template-columns: 1fr; }
    .tpl-promo__stage { max-width: 640px; width: 100%; margin: 0 auto; }
  }
  @media (max-width: 560px) {
    .tpl-promo__pages { grid-template-columns: 1fr; }
    .tpl-promo__chip--code { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tpl-promo__pulse, .tpl-promo__chip { animation: none; }
    .tpl-promo__win { transition: none; }
  }
</style>
