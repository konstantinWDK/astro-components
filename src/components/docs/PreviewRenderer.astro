---
// src/components/docs/PreviewRenderer.astro
// Renders a live preview for each component based on its slug.

import GlassButton from '../lib/buttons/GlassButton.astro';
import GlowButton from '../lib/buttons/GlowButton.astro';
import GlassCard from '../lib/cards/GlassCard.astro';
import AnimatedInput from '../lib/forms/AnimatedInput.astro';
import Badge from '../lib/feedback/Badge.astro';
import GlassNavbar from '../lib/navigation/GlassNavbar.astro';
import NeumorphicSwitch from '../lib/forms/NeumorphicSwitch.astro';
import { getComponentBySlug } from '../../data/registry/index';

const allComponents = import.meta.glob('../lib/**/*.astro', { eager: true });

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const componentMeta = getComponentBySlug(slug);
const isButton = componentMeta?.category === 'buttons';

// Dynamic lookup fallback
const pascalSlug = slug.split('-').map(part => part.charAt(0).toUpperCase() + part.slice(1)).join('');
let DynamicComponent = null;

// Use Object.keys for a safer loop
const componentPaths = Object.keys(allComponents);
const componentPath = componentPaths.find(path => path.endsWith(`/${pascalSlug}.astro`));

if (componentPath) {
  DynamicComponent = (allComponents[componentPath] as any).default;
}

// Check if we have a hardcoded preview
const hasHardcoded = ['glass-button', 'glow-button', 'glass-card', 'animated-input', 'badge', 'glass-navbar', 'neumorphic-switch', 'rating-pill', 'typewriter-text', 'otp-input', 'simple-file-input', 'neumorphic-card', 'pricing-card', 'glass-alert', 'glass-progress', 'toast-notif', 'overlay-modal', 'side-drawer-right', 'bottom-sheet-mobile', 'popover-menu-glass', 'command-dialog', 'lightbox-overlay', 'cookie-banner-glass', 'loading-overlay-full', 'backdrop-blur-mask', 'help-bubble-overlay', 'search-overlay-fullscreen', 'age-verification-overlay', 'context-menu-overlay', 'mobile-nav-overlay', 'floating-tray-actions', 'toast-stack-overlay', 'exit-intent-overlay', 'tooltip-action-tray', 'feature-hero', 'glass-section-header', 'section-divider-text', 'sidebar-layout-wrapper', 'centered-container', 'footer-centered-minimal', 'sticky-sidebar-wrapper'].includes(slug);

type PreviewExample = {
  label?: string;
  props?: Record<string, any>;
};

const buttonPreviewExamples: Record<string, PreviewExample[]> = {
  'neumorphic-button': [
    { label: 'Soft UI' },
    { label: 'Canvas', props: { color: '#dbe4f0', size: 'sm' } },
    { label: 'Pressed', props: { color: '#e2e8f0', size: 'lg' } },
  ],
  'cyberpunk-button': [
    { label: 'Engage' },
    { label: 'Alert', props: { variant: 'yellow' } },
    { label: 'Access', props: { variant: 'green' } },
  ],
  'pulse-button': [
    { label: 'Buy Now' },
    { label: 'Notify Me', props: { variant: 'ghost' } },
    { label: 'Stand By', props: { disabled: true } },
  ],
  'shiny-button': [
    { label: 'Upgrade' },
    { label: 'Compare', props: { variant: 'secondary' } },
    { label: 'Preview', props: { variant: 'ghost' } },
  ],
  'retro-arcade-button': [
    { label: 'Start' },
    { label: 'Insert Coin', props: { variant: 'secondary', size: 'sm' } },
    { label: 'Paused', props: { variant: 'ghost' } },
  ],
  '3d-push-button': [
    { label: 'Push' },
    { label: 'Confirm', props: { variant: 'secondary' } },
    { label: 'Large', props: { size: 'lg' } },
  ],
  'loading-button': [
    { label: 'Submit' },
    { label: 'Saving', props: { isLoading: true } },
    { label: 'Outline', props: { variant: 'ghost' } },
  ],
  'shimmer-button': [
    { label: 'Join Waitlist' },
    { label: 'Secondary', props: { variant: 'secondary' } },
    { label: 'Ghost', props: { variant: 'ghost' } },
  ],
  'magnetic-button': [
    { label: 'Explore' },
    { label: 'Hover Me', props: { variant: 'primary', strength: 0.3 } },
  ],
  'double-border-button': [
    { label: 'Contact Us' },
    { label: 'Secondary', props: { variant: 'secondary' } },
    { label: 'Ghost', props: { variant: 'ghost' } },
  ],
  'liquid-button': [
    { label: 'Hover Me' },
    { label: 'Secondary', props: { variant: 'secondary' } },
    { label: 'Ghost', props: { variant: 'ghost' } },
  ],
  'retro-shadow-button': [
    { label: 'Click Me' },
    { label: 'Info', props: { variant: 'secondary' } },
    { label: 'Paper', props: { variant: 'ghost' } },
  ],
  'minimal-pill-button': [
    { label: 'Login' },
    { label: 'Primary', props: { variant: 'primary' } },
    { label: 'Ghost', props: { variant: 'ghost' } },
  ],
  'border-draw-button': [
    { label: 'Start Project' },
    { label: 'Preview', props: { color: '#8b5cf6' } },
    { label: 'Large', props: { size: 'lg' } },
  ],
  'ghost-outline-button': [
    { label: 'Sign Up' },
    { label: 'Launch', props: { primaryColor: '#10b981', secondaryColor: '#06b6d4' } },
    { label: 'Upgrade', props: { size: 'lg' } },
  ],
  'tilt-glow-button': [
    { label: 'Enter Metaverse' },
    { label: 'Tilt Me', props: { primaryColor: '#ec4899', secondaryColor: '#8b5cf6' } },
  ],
  'animated-icon-button': [
    { label: 'Next Step' },
    { label: 'Back', props: { iconPos: 'left', variant: 'secondary' } },
    { label: 'Ghost CTA', props: { variant: 'ghost' } },
  ],
};

const defaultButtonPreviewExamples: PreviewExample[] = [
  { label: 'Primary' },
  { label: 'Secondary', props: { variant: 'secondary' } },
  { label: 'Ghost', props: { variant: 'ghost' } },
];

const dynamicButtonExamples = isButton
  ? (buttonPreviewExamples[slug] ?? defaultButtonPreviewExamples)
  : [];

const useSpaciousButtonStage = ['glow-button', 'pulse-button', 'magnetic-button', 'tilt-glow-button', 'double-border-button'].includes(slug);
const fallbackLabel = componentMeta?.name ?? pascalSlug;
---

<div class="preview-renderer">
  {slug === 'glass-button' && (
    <div class="preview-demo preview-demo--row preview-demo--wrap">
      <GlassButton variant="primary">Primary</GlassButton>
      <GlassButton variant="secondary">Secondary</GlassButton>
      <GlassButton variant="ghost">Ghost</GlassButton>
      <GlassButton variant="primary" size="sm">Small</GlassButton>
      <GlassButton variant="primary" size="lg">Large</GlassButton>
      <GlassButton disabled>Disabled</GlassButton>
    </div>
  )}

  {slug === 'glow-button' && (
    <div class="preview-demo preview-demo--row preview-demo--wrap">
      <GlowButton>Launch</GlowButton>
      <GlowButton color="#ec4899">Pink Glow</GlowButton>
      <GlowButton color="#10b981">Go Green</GlowButton>
      <GlowButton color="#f59e0b">Amber</GlowButton>
    </div>
  )}

  {slug === 'glass-card' && (
    <div class="preview-demo preview-demo--row preview-demo--wrap">
      <GlassCard title="Analytics" subtitle="Last 30 days" padding="md">
        <p class="preview-text-muted">
          Hover over this card to see the lift effect.
        </p>
        <p class="preview-stat-value">
          24,891
        </p>
      </GlassCard>
      <GlassCard title="Status" padding="md">
        <p class="preview-text-success">✓ All systems operational</p>
      </GlassCard>
      <GlassCard hoverable={false} padding="sm">
        <p class="preview-text-muted preview-text-sm">Non-hoverable card with small padding.</p>
      </GlassCard>
    </div>
  )}

  {slug === 'animated-input' && (
    <div class="preview-demo preview-demo--col preview-demo--narrow">
      <AnimatedInput id="prev-email" name="email" label="Email Address" type="email" />
      <AnimatedInput id="prev-user"  name="username" label="Username" />
      <AnimatedInput id="prev-pass"  name="password" label="Password" type="password" />
    </div>
  )}

  {slug === 'badge' && (
    <div class="preview-demo preview-demo--row preview-demo--wrap">
      <Badge>Default</Badge>
      <Badge variant="success">Active</Badge>
      <Badge variant="warning">Pending</Badge>
      <Badge variant="danger">Error</Badge>
      <Badge variant="info">New</Badge>
      <Badge variant="success" dot>Online</Badge>
      <Badge variant="danger" dot pulse>Live</Badge>
    </div>
  )}

  {slug === 'glass-navbar' && (
    <div class="preview-demo preview-demo--col preview-demo--full-width">
      <GlassNavbar brand="MyProject" brandHref="#">
        <div slot="links">
          <a href="#">Home</a>
          <a href="#">Components</a>
          <a href="#">Blog</a>
        </div>
        <div slot="actions">
          <GlassButton variant="ghost" size="sm">GitHub</GlassButton>
          <GlassButton size="sm">Get Started</GlassButton>
        </div>
      </GlassNavbar>
    </div>
  )}

  {slug === 'neumorphic-switch' && (
    <div class="preview-demo preview-demo--col">
      <NeumorphicSwitch />
    </div>
  )}

  {slug === 'rating-pill' && (
    <div class="preview-demo preview-demo--row preview-demo--wrap">
      <span class="preview-label">Rating: 4.5</span>
    </div>
  )}

  {slug === 'typewriter-text' && (
    <div class="preview-demo preview-demo--row preview-demo--wrap">
      <span class="preview-label">Hello, World!</span>
    </div>
  )}

  {slug === 'otp-input' && (
    <div class="preview-demo preview-demo--col preview-demo--narrow">
      <div class="otp-preview-fake">
        <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" />
        <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" />
        <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" />
        <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" />
        <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" />
        <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" />
      </div>
      <p class="otp-preview-label">Enter your verification code</p>
    </div>
  )}

  {slug === 'simple-file-input' && (
    <div class="preview-demo preview-demo--col preview-demo--narrow">
      <div class="file-input-preview">
        <label class="file-input-label">
          <span class="file-input-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </span>
          <div class="file-input-text">
            <span class="file-input-title">Upload file</span>
            <span class="file-input-hint">Click to select a file</span>
          </div>
        </label>
      </div>
    </div>
  )}

  {slug === 'neumorphic-card' && (
    <div class="preview-demo preview-demo--col">
      <div class="neu-card-preview">
        <div class="neu-card-header">
          <div class="neu-avatar"></div>
          <div class="neu-card-info">
            <span class="neu-card-name">John Doe</span>
            <span class="neu-card-role">Designer</span>
          </div>
        </div>
        <p class="neu-card-text">Neumorphic design creates a soft, extruded appearance that mimics physical objects.</p>
        <div class="neu-card-stats">
          <div class="neu-stat">
            <span class="neu-stat-value">128</span>
            <span class="neu-stat-label">Projects</span>
          </div>
          <div class="neu-stat">
            <span class="neu-stat-value">4.2k</span>
            <span class="neu-stat-label">Followers</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {slug === 'pricing-card' && (
    <div class="preview-demo preview-demo--row preview-demo--wrap">
      <div class="pricing-preview pricing-preview--standard">
        <span class="pricing-plan">Standard</span>
        <div class="pricing-price"><span>$</span>9</div>
        <ul class="pricing-features">
          <li>✓ 10 Projects</li>
          <li>✓ Email Support</li>
          <li>✓ 1GB Storage</li>
        </ul>
        <button class="pricing-btn">Choose Plan</button>
      </div>
      <div class="pricing-preview pricing-preview--featured">
        <div class="pricing-badge">Popular</div>
        <span class="pricing-plan">Pro</span>
        <div class="pricing-price"><span>$</span>29</div>
        <ul class="pricing-features">
          <li>✓ Unlimited Projects</li>
          <li>✓ 24/7 Support</li>
          <li>✓ 50GB Storage</li>
        </ul>
        <button class="pricing-btn pricing-btn--featured">Choose Plan</button>
      </div>
    </div>
  )}

  {slug === 'glass-alert' && (
    <div class="preview-demo preview-demo--col">
      <div class="alert-preview alert-preview--info">
        <div class="alert-preview-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        </div>
        <div class="alert-preview-content">
          <div class="alert-preview-title">Information</div>
          <div class="alert-preview-body">This is a helpful informational alert for the user.</div>
        </div>
      </div>
      <div class="alert-preview alert-preview--success">
        <div class="alert-preview-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="alert-preview-content">
          <div class="alert-preview-title">Success</div>
          <div class="alert-preview-body">Your changes have been saved successfully.</div>
        </div>
      </div>
      <div class="alert-preview alert-preview--warning">
        <div class="alert-preview-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div class="alert-preview-content">
          <div class="alert-preview-title">Warning</div>
          <div class="alert-preview-body">Please review your settings before continuing.</div>
        </div>
      </div>
    </div>
  )}

  {slug === 'glass-progress' && (
    <div class="preview-demo preview-demo--col">
      <div class="progress-preview">
        <div class="progress-preview-header">
          <span class="progress-preview-label">Uploading files...</span>
          <span class="progress-preview-value">75%</span>
        </div>
        <div class="progress-preview-bar">
          <div class="progress-preview-fill" style="width: 75%"></div>
        </div>
      </div>
      <div class="progress-preview progress-preview--complete">
        <div class="progress-preview-header">
          <span class="progress-preview-label">Storage used</span>
          <span class="progress-preview-value">45%</span>
        </div>
        <div class="progress-preview-bar">
          <div class="progress-preview-fill" style="width: 45%"></div>
        </div>
      </div>
    </div>
  )}

  {slug === 'toast-notif' && (
    <div class="preview-demo preview-demo--col">
      <div class="toast-preview toast-preview--success">
        <div class="toast-preview-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="toast-preview-content">
          <div class="toast-preview-title">Success</div>
          <div class="toast-preview-body">Settings saved successfully!</div>
        </div>
      </div>
      <div class="toast-preview toast-preview--error">
        <div class="toast-preview-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <div class="toast-preview-content">
          <div class="toast-preview-title">Error</div>
          <div class="toast-preview-body">Failed to upload file. Please try again.</div>
        </div>
      </div>
    </div>
  )}

  {slug === 'overlay-modal' && (
    <div class="preview-demo preview-demo--col">
      <div class="overlay-preview">
        <div class="overlay-preview-bg"></div>
        <div class="overlay-preview-modal">
          <div class="overlay-preview-close">×</div>
          <h4 class="overlay-preview-title">Confirm Action</h4>
          <p class="overlay-preview-text">Are you sure you want to proceed with this sensitive operation?</p>
          <div class="overlay-preview-actions">
            <button class="overlay-btn overlay-btn--cancel">Cancel</button>
            <button class="overlay-btn overlay-btn--confirm">Continue</button>
          </div>
        </div>
      </div>
    </div>
  )}

  {slug === 'side-drawer-right' && (
    <div class="preview-demo preview-demo--col">
      <div class="drawer-preview">
        <div class="drawer-preview-bg"></div>
        <div class="drawer-preview-panel">
          <div class="drawer-preview-header">
            <h4 class="drawer-preview-title">Filters</h4>
            <span class="drawer-preview-close">×</span>
          </div>
          <div class="drawer-preview-body">
            <div class="drawer-preview-item">Category</div>
            <div class="drawer-preview-item">Price Range</div>
            <div class="drawer-preview-item">Rating</div>
          </div>
        </div>
      </div>
    </div>
  )}

  {slug === 'bottom-sheet-mobile' && (
    <div class="preview-demo preview-demo--col">
      <div class="sheet-preview">
        <div class="sheet-preview-bg"></div>
        <div class="sheet-preview-content">
          <div class="sheet-handle"></div>
          <h4 class="sheet-preview-title">Select Option</h4>
          <div class="sheet-item">Archive</div>
          <div class="sheet-item">Delete</div>
          <div class="sheet-item">Share</div>
        </div>
      </div>
    </div>
  )}

  {slug === 'popover-menu-glass' && (
    <div class="preview-demo preview-demo--col">
      <div class="popover-preview">
        <div class="popover-item">Edit Account</div>
        <div class="popover-item">Billing</div>
        <div class="popover-divider"></div>
        <div class="popover-item popover-item--danger">Logout</div>
      </div>
    </div>
  )}

  {slug === 'command-dialog' && (
    <div class="preview-demo preview-demo--col">
      <div class="cmd-preview">
        <div class="cmd-preview-bg"></div>
        <div class="cmd-preview-box">
          <div class="cmd-preview-input">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Search commands...</span>
            <kbd class="cmd-kbd">Esc</kbd>
          </div>
          <div class="cmd-preview-results">
            <div class="cmd-preview-res">
              <span>Recent: Dashboard</span>
              <kbd>↵</kbd>
            </div>
            <div class="cmd-preview-res cmd-preview-res--active">
              <span>Docs: Navigation</span>
              <kbd>↵</kbd>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  {slug === 'lightbox-overlay' && (
    <div class="preview-demo preview-demo--col">
      <div class="lightbox-preview">
        <div class="lightbox-preview-bg"></div>
        <div class="lightbox-preview-img"></div>
        <div class="lightbox-preview-caption">Nature Landscape / 2024</div>
      </div>
    </div>
  )}

  {slug === 'cookie-banner-glass' && (
    <div class="preview-demo preview-demo--col">
      <div class="cookie-preview">
        <div class="cookie-preview-text">We use cookies to improve your experience. <a href="#">Learn more</a></div>
        <div class="cookie-preview-actions">
          <button class="cookie-btn cookie-btn--options">Options</button>
          <button class="cookie-btn cookie-btn--accept">Accept All</button>
        </div>
      </div>
    </div>
  )}

  {slug === 'loading-overlay-full' && (
    <div class="preview-demo preview-demo--col">
      <div class="loading-preview">
        <div class="loading-preview-bg"></div>
        <div class="loading-preview-spinner"></div>
      </div>
    </div>
  )}

  {slug === 'backdrop-blur-mask' && (
    <div class="preview-demo preview-demo--col">
      <div class="blur-preview">
        <div class="blur-preview-bg"></div>
        <div class="blur-preview-label">Backdrop Blur</div>
      </div>
    </div>
  )}

  {slug === 'help-bubble-overlay' && (
    <div class="preview-demo preview-demo--col">
      <div class="help-bubble-preview">
        <div class="help-bubble-tip">We are online!</div>
        <div class="help-bubble-icon">💬</div>
      </div>
    </div>
  )}

  {slug === 'search-overlay-fullscreen' && (
    <div class="preview-demo preview-demo--col">
      <div class="search-preview">
        <div class="search-preview-bg"></div>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-preview-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span class="search-preview-placeholder">Start searching...</span>
        <div class="search-preview-hints">Search for <span>components</span>, <span>guides</span>, or <span>authors</span></div>
      </div>
    </div>
  )}

  {slug === 'age-verification-overlay' && (
    <div class="preview-demo preview-demo--col">
      <div class="age-preview">
        <div class="age-preview-bg"></div>
        <div class="age-preview-card">
          <h4 class="age-preview-title">Age Verification</h4>
          <p class="age-preview-text">Please confirm you are 18 or older to view this site.</p>
          <div class="age-preview-actions">
            <button class="age-btn age-btn--exit">Exit</button>
            <button class="age-btn age-btn--confirm">I am 18+</button>
          </div>
        </div>
      </div>
    </div>
  )}

  {slug === 'context-menu-overlay' && (
    <div class="preview-demo preview-demo--col">
      <div class="ctx-preview">
        <div class="ctx-group">
          <div class="ctx-item">Copy Link</div>
          <div class="ctx-item">Duplicate</div>
        </div>
        <div class="ctx-divider"></div>
        <div class="ctx-item ctx-item--danger">Delete Item</div>
      </div>
    </div>
  )}

  {slug === 'mobile-nav-overlay' && (
    <div class="preview-demo preview-demo--col">
      <div class="mob-nav-preview">
        <div class="mob-nav-bg"></div>
        <div class="mob-nav-content">
          <div class="mob-nav-close">×</div>
          <div class="mob-nav-links">
            <a href="#">Home</a>
            <a href="#">Features</a>
            <a href="#">Pricing</a>
            <a href="#">Team</a>
          </div>
        </div>
      </div>
