---
// src/components/docs/DocSlugPage.astro
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from './CodeBlock.astro';
import PreviewRenderer from './PreviewRenderer.astro';
import ComponentUsage from './ComponentUsage.astro';
import { components, getComponentBySlug, categories } from '../../data/registry/index';
import type { Locale } from '../../config/site';
import { useTranslations, getLocalizedPath } from '../../i18n/translations';
import { getLocalizedCategory, getLocalizedComponent, getComponentSeoMeta } from '../../i18n/catalog';

interface Props {
  slug: string;
  lang?: Locale;
}

const { slug, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const rawComp = getComponentBySlug(slug);

if (!rawComp) {
  return Astro.redirect(getLocalizedPath('/', lang));
}

const comp = getLocalizedComponent(rawComp, lang);
const seo = getComponentSeoMeta(rawComp, lang);
const rawCategory = categories.find((c) => c.id === comp.category);
const category = rawCategory ? getLocalizedCategory(rawCategory, lang) : null;

// Prev/next within the same category, plus the sibling list for "more in this category".
const siblings = components.filter((c) => c.category === rawComp.category);
const currentIndex = siblings.findIndex((c) => c.slug === slug);
const prevComp = currentIndex > 0 ? siblings[currentIndex - 1] : null;
const nextComp = currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : null;
const moreInCategory = siblings
  .filter((c) => c.slug !== slug)
  .map((c) => ({ c, score: c.tags.filter((tag) => rawComp.tags.includes(tag)).length }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 8)
  .map((x) => getLocalizedComponent(x.c as any, lang));
const nav = {
  en: { jump: 'On this page', preview: 'Preview', usage: 'Usage', context: 'In context', code: 'Source code', info: 'Info', more: 'More in', all: 'View all', of: 'of' },
  es: { jump: 'En esta página', preview: 'Vista previa', usage: 'Uso', context: 'En contexto', code: 'Código fuente', info: 'Info', more: 'Más en', all: 'Ver todos', of: 'de' },
  ru: { jump: 'На этой странице', preview: 'Превью', usage: 'Использование', context: 'В контексте', code: 'Исходный код', info: 'Инфо', more: 'Ещё в', all: 'Все', of: 'из' },
}[lang];
const jump = [
  ['section-preview', nav.preview],
  ['section-usage', nav.usage],
  ['section-context', nav.context],
  ['section-code', nav.code],
  ['section-info', nav.info],
];

// Ensure usage has imports
let displayUsage = rawComp.usage;
if (!displayUsage.includes('import')) {
  const componentName = rawComp.name.replace(/\s/g, '');
  displayUsage = `---
import { ${componentName} } from 'astro-component-kit';
---

${displayUsage}`;
}

const depText = comp.category === 'charts' 
  ? 'apexcharts (peer)' 
  : (comp.category === 'sections' && comp.slug === 'galaxy-3d' ? 'three.js (peer)' : t('doc.depsNone'));
---

<DocsLayout title={seo.title} description={seo.description} lang={lang}>
  <div class="doc-page anim-fade-in">
    <!-- Prev/Next navigation at top -->
    <nav class="doc-nav" aria-label={t('nav.components')}>
      {prevComp ? (
        <a href={getLocalizedPath(`/docs/${prevComp.slug}`, lang)} class="doc-nav-link doc-nav-link--prev">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>{prevComp.name}</span>
        </a>
      ) : <span></span>}
      {nextComp ? (
        <a href={getLocalizedPath(`/docs/${nextComp.slug}`, lang)} class="doc-nav-link doc-nav-link--next">
          <span>{nextComp.name}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      ) : <span></span>}
    </nav>

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label={t('a11y.breadcrumb')}>
      <a href={getLocalizedPath('/', lang)}>{t('nav.home')}</a>
      <span class="breadcrumb__sep">›</span>
      {category && comp.category !== 'sections'
        ? <a href={getLocalizedPath(`/components/${comp.category}`, lang)}>{category.name}</a>
        : <span>{category?.name}</span>}
      <span class="breadcrumb__sep">›</span>
      <span class="breadcrumb__current">{comp.name}</span>
    </nav>

    <!-- Component header -->
    <header class="doc-header">
      <div class="doc-header__meta">
        <span class="doc-category-badge">{category?.name}</span>
        {comp.tags.map((tag) => (
          <span class="doc-tag">{tag}</span>
        ))}
      </div>
      <h1 class="doc-title">{comp.name}</h1>
      <p class="doc-description">{comp.description}</p>
    </header>

    <nav class="doc-jump" aria-label={nav.jump}>
      {jump.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>

    <!-- 1. Live Preview -->
    <section class="doc-section anim-slide-up" id="section-preview">
      <h2 class="doc-section__title visually-hidden">{t('doc.livePreview')}</h2>
      <div class="preview-container">
        <PreviewRenderer slug={slug} />
      </div>
    </section>

    <!-- 2. Usage Section -->
    <section class="doc-section anim-slide-up" id="section-usage" style="animation-delay: 0.1s">
      <div class="usage-header">
        <h2 class="doc-section__title" style="margin-bottom: 0; border-bottom: none;">{t('doc.usage')}</h2>
        <p class="doc-section__subtitle">{t('doc.usageDesc')}</p>
      </div>

      <div class="usage-code-wrapper" data-nosnippet>
        <CodeBlock code={displayUsage} lang="astro" id={`usage-${slug}`} />
      </div>
    </section>

    <ComponentUsage slug={slug} lang={lang} />

    <!-- 3. Manual Installation -->
    <section class="doc-section anim-slide-up" id="section-code" style="animation-delay: 0.2s">
      <h2 class="doc-section__title">{t('doc.manualInstall')}</h2>
      <div class="manual-box">
        <p>{t('doc.manualInstallDesc')} <code>src/components/lib/{rawComp.name.replace(/\s/g, '')}.astro</code>:</p>
      </div>
      <div data-nosnippet style="margin-top: var(--sp-4)">
        <CodeBlock code={rawComp.code} lang="astro" id={`code-${slug}`} />
      </div>
    </section>

    <!-- Properties section -->
    <section class="doc-section" id="section-info">
      <h2 class="doc-section__title">{t('doc.quickInfo')}</h2>
      <dl class="props-list">
        <div class="props-row">
          <dt>{t('doc.category')}</dt>
          <dd>{category?.name}</dd>
        </div>
        <div class="props-row">
          <dt>{t('doc.filename')}</dt>
          <dd><code>{rawComp.name.replace(/\s/g, '')}.astro</code></dd>
        </div>
        <div class="props-row">
          <dt>{t('doc.dependencies')}</dt>
          <dd>{depText}</dd>
        </div>
        <div class="props-row">
          <dt>{t('doc.tags')}</dt>
          <dd class="tags-row">
            {comp.tags.map((tag) => <span class="doc-tag">{tag}</span>)}
          </dd>
        </div>
      </dl>
    </section>

    <!-- More in this category -->
    {moreInCategory.length > 0 && (
      <nav class="doc-more" aria-labelledby="doc-more-title">
        <div class="doc-more__head">
          <h2 class="doc-more__title" id="doc-more-title">{nav.more} {category?.name}</h2>
          <a class="doc-more__all" href={getLocalizedPath(`/components/${comp.category}`, lang)}>{nav.all} ({siblings.length}) →</a>
        </div>
        <ul class="doc-more__list">
          {moreInCategory.map((m) => (
            <li>
              <a href={getLocalizedPath(`/docs/${m.slug}`, lang)}>
                <span class="doc-more__name">{m.name}</span>
                <span class="doc-more__desc">{m.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</DocsLayout>

<script is:inline>
  const copyBtns = document.querySelectorAll('.copy-btn');
  copyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('copied');
        }, 2000);
      }
    });
  });
</script>

<style>
  .doc-page {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .doc-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--c-border);
  }
  .doc-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--c-text-3);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-sm);
    transition: color 0.15s, background 0.15s;
  }
  .doc-nav-link:hover {
    color: var(--c-primary-light);
    background: rgba(255,255,255,0.04);
  }
  .doc-nav-link svg {
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.15s;
  }
  .doc-nav-link:hover svg { opacity: 1; }

  .breadcrumb {
    display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap;
    font-size: 0.8rem; color: var(--c-text-3); margin-bottom: var(--sp-6);
  }
  .breadcrumb a { color: var(--c-text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--c-text-1); }
  .breadcrumb__sep { color: var(--c-text-3); opacity: 0.5; }
  .breadcrumb__current { color: var(--c-text-2); font-weight: 500; }

  .doc-header { margin-bottom: var(--sp-8); }
  .doc-header__meta { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; margin-bottom: var(--sp-4); }

  .doc-category-badge {
    padding: 0.25rem 0.65rem; border-radius: var(--r-full);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    background: rgba(234, 179, 8, 0.12); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .doc-tag {
    padding: 0.2rem 0.5rem; border-radius: var(--r-full);
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    background: rgba(255,255,255,0.04); color: var(--c-text-3); border: 1px solid var(--c-border);
  }

  .doc-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 900; color: var(--c-text-1);
    letter-spacing: -0.03em; margin-bottom: var(--sp-3);
  }
  .doc-description { font-size: 1.05rem; color: var(--c-text-2); line-height: 1.7; max-width: 100%; }

  .preview-container {
    padding: clamp(var(--sp-4), 2vw, var(--sp-8));
    background: rgba(255, 255, 255, 0.02);
    background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
    width: 100%;
    box-shadow: 0 4px 24px -6px rgba(0, 0, 0, 0.3);
    position: relative;
    isolation: isolate;
  }

  .anim-slide-up {
    opacity: 0; transform: translateY(10px);
    animation: slide-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes slide-up { to { opacity: 1; transform: translateY(0); } }

  .doc-section { margin-top: var(--sp-8); }
  .doc-section__title {
    font-size: 1.1rem; font-weight: 700; color: var(--c-text-1);
    margin-bottom: var(--sp-4); padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--c-border);
  }
  .doc-section__subtitle {
    font-size: 0.9rem; color: var(--c-text-3); margin-bottom: var(--sp-4);
  }

  .usage-header {
    display: flex; flex-direction: column; gap: var(--sp-2);
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--c-border);
  }
  .usage-code-wrapper { margin-top: var(--sp-4); }

  .manual-box { display: flex; flex-direction: column; gap: var(--sp-2); }
  .manual-box p { font-size: 0.95rem; color: var(--c-text-2); line-height: 1.6; margin: 0; }
  .manual-box code { color: #facc15; background: rgba(255,255,255,0.05); padding: 0.1rem 0.3rem; border-radius: 4px; overflow-wrap: anywhere; }

  .props-list { display: flex; flex-direction: column; gap: 0; }
  .props-row {
    display: grid; grid-template-columns: 150px 1fr;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--c-border); font-size: 0.875rem;
  }
  .props-row dt { color: var(--c-text-3); font-weight: 500; }
  .props-row dd { color: var(--c-text-1); }
  .props-row dd code {
    background: rgba(255,255,255,0.06); padding: 0.1rem 0.4rem;
    border-radius: 4px; font-size: 0.82em; color: #facc15;
  }
  .tags-row { display: flex; gap: var(--sp-2); flex-wrap: wrap; }

  .doc-jump { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin: calc(var(--sp-2) * -1) 0 var(--sp-6); }
  .doc-jump a {
    display: inline-flex; align-items: center; min-height: 36px; padding: 0 var(--sp-3);
    border: 1px solid var(--c-border); border-radius: var(--r-full); color: var(--c-text-2);
    font-size: 0.8rem; text-decoration: none; transition: border-color 0.2s ease, color 0.2s ease;
  }
  .doc-jump a:hover { border-color: var(--c-primary-light); color: var(--c-primary-light); }
  .doc-jump a:focus-visible, .doc-more a:focus-visible { outline: 2px solid var(--c-primary-light); outline-offset: 2px; }
  .doc-section { scroll-margin-top: 90px; }

  .doc-more { margin-top: var(--sp-10, 3rem); padding-top: var(--sp-6); border-top: 1px solid var(--c-border); }
  .doc-more__head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-2); margin-bottom: var(--sp-4); }
  .doc-more__title { margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--c-text-1); }
  .doc-more__all { font-size: 0.85rem; color: var(--c-primary-light); text-decoration: none; }
  .doc-more__all:hover { text-decoration: underline; }
  .doc-more__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--sp-3); }
  .doc-more__list a {
    display: flex; flex-direction: column; gap: 0.25rem; height: 100%; padding: var(--sp-3) var(--sp-4);
    background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--r-md);
    text-decoration: none; transition: border-color 0.2s ease, background 0.2s ease;
  }
  .doc-more__list a:hover { border-color: var(--c-primary-light); background: var(--c-primary-glow); }
  .doc-more__name { color: var(--c-text-1); font-weight: 600; font-size: 0.9rem; }
  .doc-more__desc { color: var(--c-text-3); font-size: 0.78rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
