---
// src/components/docs/SectionSlugPage.astro
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from './CodeBlock.astro';
import { sections, getSectionBySlug, getSectionCategoryById } from '../../data/registry/sections';
import { categories } from '../../data/registry/index';
import { templates } from '../../data/registry/templates';
import type { Locale } from '../../config/site';
import { useTranslations, getLocalizedPath } from '../../i18n/translations';
import { getLocalizedCategory, getLocalizedSectionCategory, getLocalizedComponent, getComponentSeoMeta } from '../../i18n/catalog';

// Import all section components
import HeroGradient from '../lib/sections/HeroGradient.astro';
import HeroSplit from '../lib/sections/HeroSplit.astro';
import HeroGlass from '../lib/sections/HeroGlass.astro';
import FeatureBentoGrid from '../lib/sections/FeatureBentoGrid.astro';
import FeatureTimelineFlow from '../lib/sections/FeatureTimelineFlow.astro';
import PricingComparisonMatrix from '../lib/sections/PricingComparisonMatrix.astro';
import PricingTierCards from '../lib/sections/PricingTierCards.astro';
import TestimonialWallGlass from '../lib/sections/TestimonialWallGlass.astro';
import CtaGlowBanner from '../lib/sections/CtaGlowBanner.astro';
import CtaAppDownload from '../lib/sections/CtaAppDownload.astro';
import FaqAccordionSection from '../lib/sections/FaqAccordionSection.astro';
import StatsMetricShowcase from '../lib/sections/StatsMetricShowcase.astro';
import TeamGridSection from '../lib/sections/TeamGridSection.astro';
import ContactGlassForm from '../lib/sections/ContactGlassForm.astro';
import TestimonialGridSection from '../lib/sections/TestimonialGridSection.astro';
import LogoCloudSection from '../lib/sections/LogoCloudSection.astro';
import HeroShowcaseSplit from '../lib/sections/HeroShowcaseSplit.astro';

interface Props {
  slug: string;
  lang?: Locale;
}

const { slug, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const rawSection = getSectionBySlug(slug);

if (!rawSection) {
  return Astro.redirect(getLocalizedPath('/sections', lang));
}

const section = getLocalizedComponent(rawSection as any, lang);
const seo = getComponentSeoMeta(rawSection as any, lang);
const rawCategory = categories.find((c) => c.id === section.category);
const category = rawCategory ? getLocalizedCategory(rawCategory, lang) : null;

const rawSectionCat = getSectionCategoryById(section.sectionCategory || '');
const sectionCategory = rawSectionCat ? getLocalizedSectionCategory(rawSectionCat, lang) : null;

const componentMap: Record<string, any> = {
  'hero-gradient': HeroGradient,
  'hero-split': HeroSplit,
  'hero-glass': HeroGlass,
  'feature-bento-grid': FeatureBentoGrid,
  'feature-timeline-flow': FeatureTimelineFlow,
  'pricing-comparison-matrix': PricingComparisonMatrix,
  'pricing-tier-cards': PricingTierCards,
  'testimonial-wall-glass': TestimonialWallGlass,
  'cta-glow-banner': CtaGlowBanner,
  'cta-app-download': CtaAppDownload,
  'faq-accordion-section': FaqAccordionSection,
  'stats-metric-showcase': StatsMetricShowcase,
  'team-grid-section': TeamGridSection,
  'contact-glass-form': ContactGlassForm,
  'testimonial-grid-section': TestimonialGridSection,
  'logo-cloud-section': LogoCloudSection,
  'hero-showcase-split': HeroShowcaseSplit,
};

// Fallback: resolve any other section by its PascalCase file name.
const sectionModules = import.meta.glob('../lib/sections/*.astro', { eager: true }) as Record<string, { default: any }>;
const pascalName = rawSection.slug.split('-').map((p) => p.charAt(0).toUpperCase() + p.slice(1)).join('');
const Component = componentMap[rawSection.slug] || sectionModules[`../lib/sections/${pascalName}.astro`]?.default || null;

// Find prev/next for navigation
const currentIndex = sections.findIndex((s) => s.slug === slug);
const prevSection = currentIndex > 0 ? sections[currentIndex - 1] : null;
const nextSection = currentIndex < sections.length - 1 ? sections[currentIndex + 1] : null;

// Ensure usage has imports
let displayUsage = rawSection.usage || '';
if (displayUsage && !displayUsage.includes('import')) {
  const componentName = rawSection.name.replace(/\s/g, '');
  displayUsage = `---
import { ${componentName} } from 'astro-component-kit';
---

${displayUsage}`;
}

// Detect if this section belongs to any complete template
const parentTemplates = templates.filter((tpl) =>
  tpl.newComponents?.includes(rawSection.slug) ||
  tpl.reusedComponents?.includes(rawSection.slug)
);

// Related sections (prioritize same sectionCategory, then fill up to 4 items)
const sameCategorySections = sections.filter(
  (s) => s.slug !== rawSection.slug && s.sectionCategory && s.sectionCategory === rawSection.sectionCategory
);
const otherSections = sections.filter(
  (s) => s.slug !== rawSection.slug && (!rawSection.sectionCategory || s.sectionCategory !== rawSection.sectionCategory)
);
const relatedSections = [...sameCategorySections, ...otherSections]
  .slice(0, 4)
  .map((s) => ({
    raw: s,
    loc: getLocalizedComponent(s as any, lang),
    category: getSectionCategoryById(s.sectionCategory || ''),
  }));
---

<DocsLayout title={seo.title} description={seo.description} lang={lang}>
  <div class="doc-page anim-fade-in">
    <!-- Prev/Next navigation at top -->
    <nav class="doc-nav" aria-label={t('nav.sections')}>
      {prevSection ? (
        <a href={getLocalizedPath(`/sections/${prevSection.slug}`, lang)} class="doc-nav-link doc-nav-link--prev">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>{prevSection.name}</span>
        </a>
      ) : <span></span>}
      {nextSection ? (
        <a href={getLocalizedPath(`/sections/${nextSection.slug}`, lang)} class="doc-nav-link doc-nav-link--next">
          <span>{nextSection.name}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      ) : <span></span>}
    </nav>

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label={t('a11y.breadcrumb')}>
      <a href={getLocalizedPath('/', lang)}>{t('nav.home')}</a>
      <span class="breadcrumb__sep">›</span>
      <a href={getLocalizedPath('/sections', lang)}>{t('nav.sections')}</a>
      {sectionCategory && (
        <>
          <span class="breadcrumb__sep">›</span>
          <span class="breadcrumb__current">{sectionCategory.name}</span>
        </>
      )}
      <span class="breadcrumb__sep">›</span>
      <span class="breadcrumb__current">{section.name}</span>
    </nav>

    <!-- Section header -->
    <header class="section-header">
      <span class="section-header__badge">{sectionCategory ? sectionCategory.name : (category?.name || 'Section')}</span>
      <h1 class="section-header__title">{section.name}</h1>
      <p class="section-header__desc">{section.description}</p>
      <div class="section-header__tags">
        {section.tags.map((tag) => <span class="section-header__tag">{tag}</span>)}
      </div>
    </header>

    <!-- 1. Live Preview -->
    <section class="doc-section anim-slide-up" id="section-preview">
      {Component ? (
        <div class="section-preview-full">
          <div class="section-preview-full__label">{t('doc.livePreview')}</div>
          <Component />
        </div>
      ) : (
        <div class="preview-placeholder">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
          <p>Preview coming soon</p>
        </div>
      )}
    </section>

    <!-- 2. Usage Section -->
    <section class="doc-section anim-slide-up" id="section-usage" style="animation-delay: 0.1s">
      <h2 class="doc-section__title">{t('doc.usage')}</h2>
      <p class="doc-section__subtitle">{t('doc.usageDesc')}</p>
      <CodeBlock code={displayUsage} lang="astro" id={`usage-${rawSection.slug}`} />
    </section>

    <!-- 3. Manual Installation -->
    <section class="doc-section anim-slide-up" id="section-code" style="animation-delay: 0.2s">
      <h2 class="doc-section__title">{t('doc.manualInstall')}</h2>
      <div class="manual-box">
        <p>{t('doc.manualInstallDesc')} <code>src/components/sections/{rawSection.name.replace(/\s/g, '')}.astro</code>:</p>
      </div>
      <div style="margin-top: var(--sp-4)">
        <CodeBlock code={rawSection.code} lang="astro" id={`code-${rawSection.slug}`} />
      </div>
    </section>

    <!-- 4. Template Showcase (if this section is part of a template) -->
    {parentTemplates.length > 0 && (
      <section class="doc-section anim-slide-up" id="section-template-showcase" style="animation-delay: 0.25s">
        <div class="tpl-showcase-box">
          <div class="tpl-showcase-box__header">
            <span class="tpl-showcase-box__badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <span>{t('sections.partOfTemplate')}</span>
            </span>
            <p class="tpl-showcase-box__lead">{t('sections.partOfTemplateDesc')}</p>
          </div>

          <div class="tpl-showcase-list">
            {parentTemplates.map((tpl) => {
              const tplName = tpl.name[lang] || tpl.name.en;
              const tplTagline = tpl.tagline[lang] || tpl.tagline.en;
              const tplUrl = getLocalizedPath(`/templates/${tpl.slug}`, lang);
              const totalComponents = (tpl.newComponents?.length || 0) + (tpl.reusedComponents?.length || 0);

              return (
                <div class="tpl-card">
                  <div class="tpl-card__meta">
                    <span class="tpl-card__chip">{t('templates.badge')}</span>
                    <span class="tpl-card__stats">{tpl.pages?.length || 0} {t('templates.pagesCount')} · {totalComponents} {t('templates.componentsCount')}</span>
                  </div>

                  <h3 class="tpl-card__title">
                    <a href={tplUrl}>{tplName}</a>
                  </h3>
                  <p class="tpl-card__desc">{tplTagline}</p>

                  <div class="tpl-card__actions">
                    <a href={tplUrl} class="tpl-btn tpl-btn--primary">
                      <span>{t('sections.viewTemplate')}</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                    {tpl.previewBase && (
                      <a href={tpl.previewBase} target="_blank" rel="noopener noreferrer" class="tpl-btn tpl-btn--ghost">
                        <span>{t('templates.openPreview')}</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- 5. More Sections to Explore -->
    <section class="doc-section anim-slide-up" id="section-more-sections" style="animation-delay: 0.3s">
      <div class="more-sections-header">
        <div>
          <h2 class="doc-section__title" id="more-sections-heading" style="margin-bottom: var(--sp-1); border-bottom: none;">
            {t('sections.moreSections')}
          </h2>
          <p class="doc-section__subtitle" style="margin-bottom: 0;">
            {t('sections.moreSectionsDesc')}
          </p>
        </div>
        <a href={getLocalizedPath('/sections', lang)} class="more-sections-all-link">
          <span>{t('sections.exploreAll')}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="more-sections-grid">
        {relatedSections.map(({ raw: r, loc: s, category: cat }) => {
          const localizedCat = cat ? getLocalizedSectionCategory(cat, lang) : null;
          const sUrl = getLocalizedPath(`/sections/${r.slug}`, lang);

          return (
            <a href={sUrl} class="more-section-card">
              <div class="more-section-card__top">
                <span class="more-section-card__badge">{localizedCat?.name || 'Section'}</span>
              </div>
              <h3 class="more-section-card__title">{s.name}</h3>
              <p class="more-section-card__desc">{s.description}</p>
              <div class="more-section-card__footer">
                <span class="more-section-card__cta">{t('templates.viewSection')}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</DocsLayout>

<style>
  .doc-page {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .doc-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--c-border);
  }
  .doc-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--c-text-3);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-sm);
    transition: color 0.15s, background 0.15s;
  }
  .doc-nav-link:hover {
    color: var(--c-primary-light);
    background: rgba(255,255,255,0.04);
  }
  .doc-nav-link svg {
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.15s;
  }
  .doc-nav-link:hover svg { opacity: 1; }

  .breadcrumb {
    display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap;
    font-size: 0.8rem; color: var(--c-text-3); margin-bottom: var(--sp-6);
  }
  .breadcrumb a { color: var(--c-text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--c-text-1); }
  .breadcrumb__sep { color: var(--c-text-3); opacity: 0.5; }
  .breadcrumb__current { color: var(--c-text-2); font-weight: 500; }

  .section-header {
    display: flex; flex-direction: column; gap: var(--sp-3);
    margin-bottom: var(--sp-8);
  }
  .section-header__badge {
    display: inline-flex; align-items: center; gap: var(--sp-2); width: fit-content;
    padding: 0.3rem 0.8rem; font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: #facc15;
    background: rgba(234,179,8,0.1); border: 1px solid rgba(234,179,8,0.25);
    border-radius: var(--r-full);
  }
  .section-header__title {
    font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 900;
    color: var(--c-text-1); letter-spacing: -0.03em; margin: 0;
  }
  .section-header__desc {
    font-size: 1rem; color: var(--c-text-2); max-width: 100%; margin: 0;
  }
  .section-header__tags { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .section-header__tag {
    padding: 0.15rem 0.5rem; font-size: 0.75rem; font-weight: 600;
    color: var(--c-text-3); background: rgba(255,255,255,0.04);
    border: 1px solid var(--c-border); border-radius: var(--r-full);
  }

  .section-preview-full {
    margin-bottom: var(--sp-8);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    background: #050505;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  .section-preview-full__label {
    font-size: 0.8rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: #facc15;
    margin: 0;
    padding: var(--sp-4) var(--sp-6);
    border-bottom: 1px solid var(--c-border);
    background: rgba(255,255,255,0.02);
  }

  .preview-placeholder {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--sp-3); padding: var(--sp-12);
    background: rgba(255,255,255,0.02);
    border: 1px dashed var(--c-border);
    border-radius: var(--r-lg);
    color: var(--c-text-3);
  }
  .preview-placeholder svg { opacity: 0.4; }
  .preview-placeholder p { margin: 0; font-size: 0.9rem; }

  .anim-slide-up {
    opacity: 0; transform: translateY(10px);
    animation: slide-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes slide-up { to { opacity: 1; transform: translateY(0); } }

  .doc-section { margin-top: var(--sp-8); }
  .doc-section__title {
    font-size: 1.1rem; font-weight: 700; color: var(--c-text-1);
    margin-bottom: var(--sp-4); padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--c-border);
  }
  .doc-section__subtitle {
    font-size: 0.9rem; color: var(--c-text-3); margin-bottom: var(--sp-4);
  }

  .manual-box { display: flex; flex-direction: column; gap: var(--sp-2); }
  .manual-box p { font-size: 0.95rem; color: var(--c-text-2); line-height: 1.6; margin: 0; }
  .manual-box code { color: #facc15; background: rgba(255,255,255,0.05); padding: 0.1rem 0.3rem; border-radius: 4px; overflow-wrap: anywhere; }

  /* Template Showcase Box */
  .tpl-showcase-box {
    margin-top: var(--sp-2);
    padding: clamp(var(--sp-5), 3vw, var(--sp-8));
    border-radius: var(--r-xl);
    background: radial-gradient(circle at top left, rgba(234, 179, 8, 0.08), transparent 70%), rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(234, 179, 8, 0.3);
    box-shadow: 0 4px 24px -6px rgba(0, 0, 0, 0.4);
  }
  .tpl-showcase-box__header {
    margin-bottom: var(--sp-6);
  }
  .tpl-showcase-box__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(234, 179, 8, 0.15);
    border: 1px solid rgba(234, 179, 8, 0.4);
    color: #facc15;
    margin-bottom: var(--sp-3);
  }
  .tpl-showcase-box__badge svg {
    color: #facc15;
  }
  .tpl-showcase-box__lead {
    font-size: 0.95rem;
    color: var(--c-text-2);
    margin: 0;
    line-height: 1.6;
    max-width: 720px;
  }
  .tpl-showcase-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .tpl-card {
    position: relative;
    padding: var(--sp-6);
    border-radius: var(--r-lg);
    background: rgba(10, 14, 23, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
  }
  .tpl-card:hover {
    border-color: rgba(234, 179, 8, 0.4);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }
  .tpl-card__meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
    flex-wrap: wrap;
  }
  .tpl-card__chip {
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }
  .tpl-card__stats {
    font-size: 0.78rem;
    color: var(--c-text-3);
  }
  .tpl-card__title {
    margin: 0 0 var(--sp-2) 0;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .tpl-card__title a {
    color: var(--c-text-1);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .tpl-card__title a:hover {
    color: #facc15;
  }
  .tpl-card__desc {
    margin: 0 0 var(--sp-5) 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--c-text-2);
  }
  .tpl-card__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .tpl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: var(--r-md);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .tpl-btn--primary {
    background: #facc15;
    color: #0b0f19;
    border: 1px solid #facc15;
  }
  .tpl-btn--primary:hover {
    background: #fde047;
    color: #000000;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(234, 179, 8, 0.3);
  }
  .tpl-btn--ghost {
    background: rgba(255, 255, 255, 0.05);
    color: var(--c-text-1);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .tpl-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
  }

  /* More Sections Block */
  .more-sections-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--sp-6);
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .more-sections-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #facc15;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .more-sections-all-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    transform: translateX(2px);
  }
  .more-sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--sp-4);
  }
  .more-section-card {
    display: flex;
    flex-direction: column;
    padding: var(--sp-5);
    border-radius: var(--r-lg);
