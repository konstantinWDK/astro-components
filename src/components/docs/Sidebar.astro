---
// src/components/docs/Sidebar.astro
// Docs navigation: search → Get started → Components → Sections → Templates.
// One scrollable list; only the group that contains the current page starts open.
import { components, sectionCategories } from '../../data/registry/index';
import { templates } from '../../data/registry/templates';
import type { Locale } from '../../config/site';
import { getLangFromUrl, useTranslations, getLocalizedPath, cleanPath } from '../../i18n/translations';
import { getLocalizedCategory, getLocalizedSectionCategory } from '../../i18n/catalog';

interface Props {
  categories: { id: string; name: string; icon: string; description: string }[];
  currentPath: string;
  lang?: Locale;
}

const detectedLang = getLangFromUrl(Astro.url);
const { categories, currentPath, lang = detectedLang } = Astro.props;
const t = useTranslations(lang);

const path = cleanPath(currentPath).replace(/\/$/, '') || '/';
const NEW_CATEGORIES = new Set(['ecommerce']);

const componentGroups = categories
  .filter((c) => c.id !== 'sections')
  .map((c) => {
    const loc = getLocalizedCategory(c, lang);
    const items = components
      .filter((comp) => comp.category === c.id)
      .map((comp) => ({ name: comp.name, raw: `/docs/${comp.slug}` }));
    return { id: c.id, name: loc.name, icon: c.icon, items, isNew: NEW_CATEGORIES.has(c.id) };
  })
  .filter((g) => g.items.length > 0);

const sectionGroups = sectionCategories
  .map((sc) => {
    const loc = getLocalizedSectionCategory(sc, lang);
    const items = components
      .filter((comp) => comp.category === 'sections' && comp.sectionCategory === sc.id)
      .map((comp) => ({ name: comp.name, raw: `/sections/${comp.slug}` }));
    return { id: `s-${sc.id}`, name: loc.name, icon: sc.icon, items, isNew: false };
  })
  .filter((g) => g.items.length > 0);

const componentTotal = componentGroups.reduce((n, g) => n + g.items.length, 0);
const sectionTotal = sectionGroups.reduce((n, g) => n + g.items.length, 0);
const isOpen = (g: { items: { raw: string }[] }) => g.items.some((i) => i.raw === path);

const icons = {
  install: '<path d="M12 3v12M7 10l5 5 5-5"/><path d="M5 21h14"/>',
  templates: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  notes: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  store: '<path d="M6 7h12l-1 13H7z"/><path d="M9 7V6a3 3 0 0 1 6 0v1"/>',
};
const getStarted = [
  { label: t('nav.install'), raw: '/install', icon: icons.install, match: (p: string) => p.startsWith('/install') },
  { label: t('nav.templates'), raw: '/templates', icon: icons.templates, match: (p: string) => p === '/templates', isNew: true },
  { label: t('nav.notes'), raw: '/notes', icon: icons.notes, match: (p: string) => p.startsWith('/notes') || p.startsWith('/blog') },
];
const searchLabel = t('sidebar.search').replace('{n}', String(componentTotal + sectionTotal));
const chevron = '<polyline points="6 9 12 15 18 9"></polyline>';
---

<aside class="sidebar" id="sidebar" aria-label={t('sidebar.navLabel')}>
  <div class="sidebar__search" role="search">
    <svg class="sidebar__search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input type="search" id="sidebar-search" placeholder={searchLabel} aria-label={searchLabel} aria-describedby="sidebar-search-status" autocomplete="off" />
    <kbd class="sidebar__kbd" aria-hidden="true">/</kbd>
    <button type="button" class="sidebar__clear" id="sidebar-clear" aria-label={t('sidebar.clear')} hidden>×</button>
  </div>
  <p class="sidebar__status" id="sidebar-search-status" aria-live="polite" data-results={t('sidebar.results')}></p>

  <nav class="sidebar__nav" aria-label={t('sidebar.navLabel')}>
    <!-- Get started -->
    <section class="sb-section" data-sb-section>
      <h2 class="sb-label">{t('sidebar.getStarted')}</h2>
      <ul class="sb-quick">
        {getStarted.map((item) => {
          const active = item.match(path);
          return (
            <li class="sidebar__item" data-name={item.label.toLowerCase()}>
              <a href={getLocalizedPath(item.raw, lang)} class:list={['sb-quick__link', { 'is-active': active }]} aria-current={active ? 'page' : undefined}>
                <span class="sb-quick__icon" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={item.icon} /></svg></span>
                <span class="sb-quick__text">{item.label}</span>
                {item.isNew && <span class="sb-new">{t('sidebar.new')}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Components & Sections -->
    {[
      { key: 'components', label: t('nav.components'), total: componentTotal, groups: componentGroups, all: '/docs/glass-button' },
      { key: 'sections', label: t('nav.sections'), total: sectionTotal, groups: sectionGroups, all: '/sections' },
    ].map((block) => (
      <section class="sb-section" data-sb-section data-block={block.key}>
        <h2 class="sb-label">
          <span>{block.label}</span>
          <span class="sb-label__count">{block.total}</span>
          {block.key === 'sections' && <a class="sb-label__link" href={getLocalizedPath(block.all, lang)}>{t('sidebar.viewAll')}</a>}
        </h2>
        {block.groups.map((g) => {
          const open = isOpen(g);
          return (
            <div class:list={['sidebar__group', { 'is-expanded': open }]} data-group={g.id}>
              <button type="button" class="sidebar__group-header" aria-expanded={open ? 'true' : 'false'} aria-controls={`sbg-${g.id}`}>
                <span class="sidebar__group-icon" aria-hidden="true" set:html={g.icon}></span>
                <span class="sidebar__group-name">{g.name}</span>
                {g.isNew && <span class="sb-new">{t('sidebar.new')}</span>}
                <span class="sidebar__group-count">{g.items.length}</span>
                <svg class="sidebar__group-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={chevron} /></svg>
              </button>
              <div class="sidebar__group-content" id={`sbg-${g.id}`}>
                <div class="sidebar__group-content-inner">
                  <ul class="sidebar__list">
                    {g.items.map((item) => {
                      const active = item.raw === path;
                      return (
                        <li class="sidebar__item" data-name={item.name.toLowerCase()}>
                          <a href={getLocalizedPath(item.raw, lang)} class:list={['sidebar__link', { 'sidebar__link--active': active }]} aria-current={active ? 'page' : undefined} tabindex={open ? undefined : '-1'}>{item.name}</a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            </div>
          );
        })}
      </section>
    ))}

    <!-- Templates -->
    <section class="sb-section" data-sb-section>
      <h2 class="sb-label">
        <span>{t('nav.templates')}</span>
        <span class="sb-label__count">{templates.length}</span>
      </h2>
      <ul class="sb-quick">
        {templates.map((tpl) => {
          const raw = `/templates/${tpl.slug}`;
          const active = path === raw;
          return (
            <li class="sidebar__item" data-name={`${tpl.name[lang]} ${tpl.slug} template`.toLowerCase()}>
              <a href={getLocalizedPath(raw, lang)} class:list={['sb-quick__link', 'sb-quick__link--tpl', { 'is-active': active }]} aria-current={active ? 'page' : undefined}>
                <span class="sb-quick__icon sb-quick__icon--tpl" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={icons.store} /></svg></span>
                <span class="sb-quick__text">
                  {tpl.name[lang]}
                  <small>{tpl.pages.length} {t('sidebar.pages')}</small>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <p class="sidebar__empty" id="sidebar-empty" data-prefix={t('sidebar.noResultsFor')} hidden></p>
  </nav>
</aside>

<div class="mobile-filter-trigger">
  <button id="mobile-filter-btn" type="button" aria-label={t('sidebar.exploreLabel')} aria-controls="sidebar" aria-expanded="false">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <span>{t('sidebar.explore')}</span>
  </button>
</div>
<div class="mobile-filter-backdrop" id="mobile-filter-backdrop"></div>

<script is:inline>
  (function () {
    var sidebar = document.getElementById('sidebar');
    if (!sidebar) return;

    // ── Keep scroll position between pages ─────────────────────
    var SCROLL_KEY = 'sidebar-scroll-pos';
    var savedScroll = null;
    try { savedScroll = sessionStorage.getItem(SCROLL_KEY); } catch (e) {}
    if (savedScroll !== null) requestAnimationFrame(function () { sidebar.scrollTop = parseInt(savedScroll, 10); });
    var saveTimeout;
    sidebar.addEventListener('scroll', function () {
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(function () { try { sessionStorage.setItem(SCROLL_KEY, String(sidebar.scrollTop)); } catch (e) {} }, 60);
    });

    // ── Group accordions ───────────────────────────────────────
    function setGroup(group, open) {
      group.classList.toggle('is-expanded', open);
      var header = group.querySelector('.sidebar__group-header');
      if (header) header.setAttribute('aria-expanded', open ? 'true' : 'false');
      group.querySelectorAll('.sidebar__link').forEach(function (a) {
        if (open) a.removeAttribute('tabindex'); else a.setAttribute('tabindex', '-1');
      });
    }
    sidebar.querySelectorAll('.sidebar__group-header').forEach(function (header) {
      header.addEventListener('click', function () {
        var group = header.closest('.sidebar__group');
        if (group) setGroup(group, !group.classList.contains('is-expanded'));
      });
    });

    // Bring the current page into view on first visit
    var current = sidebar.querySelector('[aria-current="page"]');
    if (current && savedScroll === null) setTimeout(function () { current.scrollIntoView({ block: 'center' }); }, 150);

    // ── Search ─────────────────────────────────────────────────
    var input = document.getElementById('sidebar-search');
    var clearBtn = document.getElementById('sidebar-clear');
    var status = document.getElementById('sidebar-search-status');
    var empty = document.getElementById('sidebar-empty');
    var groups = Array.prototype.slice.call(sidebar.querySelectorAll('.sidebar__group'));
    var openBefore = groups.map(function (g) { return g.classList.contains('is-expanded'); });

    function filter() {
      var q = (input.value || '').toLowerCase().trim();
      var total = 0;
      sidebar.querySelectorAll('.sidebar__item').forEach(function (item) {
        var ok = !q || (item.getAttribute('data-name') || '').indexOf(q) !== -1;
        item.hidden = !ok;
        if (ok && q) total++;
      });
      groups.forEach(function (g, i) {
        if (!q) { g.hidden = false; setGroup(g, openBefore[i]); return; }
        var any = g.querySelector('.sidebar__item:not([hidden])');
        g.hidden = !any;
        setGroup(g, Boolean(any));
      });
      sidebar.querySelectorAll('[data-sb-section]').forEach(function (sec) {
        sec.hidden = Boolean(q) && !sec.querySelector('.sidebar__item:not([hidden])');
      });
      if (clearBtn) clearBtn.hidden = !q;
      if (status) status.textContent = q ? (status.getAttribute('data-results') || '{n}').replace('{n}', String(total)) : '';
      if (empty) {
        empty.hidden = !q || total > 0;
        empty.textContent = (empty.getAttribute('data-prefix') || '') + ' “' + input.value.trim() + '”';
      }
    }
    if (input) {
      input.addEventListener('input', filter);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { input.value = ''; filter(); }
        if (e.key === 'Enter') {
          var first = sidebar.querySelector('.sidebar__item:not([hidden]) a');
          if (first && input.value.trim()) first.click();
        }
      });
      document.addEventListener('keydown', function (e) {
        var tag = (document.activeElement && document.activeElement.tagName) || '';
        if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(tag) && !(document.activeElement && document.activeElement.isContentEditable)) {
          e.preventDefault();
          input.focus();
        }
      });
    }
    if (clearBtn) clearBtn.addEventListener('click', function () { input.value = ''; filter(); input.focus(); });

    // ── Mobile drawer ──────────────────────────────────────────
    var mobileBtn = document.getElementById('mobile-filter-btn');
    var backdrop = document.getElementById('mobile-filter-backdrop');
    function openMobile() {
      sidebar.classList.add('is-open');
      if (backdrop) backdrop.classList.add('is-open');
      if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeMobile() {
      sidebar.classList.remove('is-open');
      if (backdrop) backdrop.classList.remove('is-open');
      if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    if (mobileBtn) mobileBtn.addEventListener('click', openMobile);
    if (backdrop) backdrop.addEventListener('click', closeMobile);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && sidebar.classList.contains('is-open')) closeMobile(); });
    sidebar.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () { if (window.innerWidth <= 768) closeMobile(); });
    });
  })();
</script>

<style>
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    overflow-y: auto;
    border-right: 1px solid var(--c-border);
    padding: 0 0 var(--sp-10);
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.08) transparent;
  }
  .sidebar::-webkit-scrollbar { width: 4px; }
  .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 10px; }

  /* ── Search (sticky) ── */
  .sidebar__search {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: var(--sp-5) var(--sp-3) var(--sp-3);
    background: linear-gradient(var(--c-bg) 80%, transparent);
  }
  .sidebar__search input {
    width: 100%;
    min-height: 40px;
    padding: 0.55rem 2.2rem 0.55rem 2.2rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    color: var(--c-text-1);
    font-size: 0.8rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    -webkit-appearance: none;
  }
  .sidebar__search input::-webkit-search-cancel-button { display: none; }
  .sidebar__search input::placeholder { color: var(--c-text-3); }
  .sidebar__search input:focus { border-color: rgba(234,179,8,0.45); background: rgba(255,255,255,0.05); }
  .sidebar__search-icon { position: absolute; left: calc(var(--sp-3) + 0.75rem); top: calc(var(--sp-5) + 20px); transform: translateY(-50%); color: var(--c-text-3); pointer-events: none; }
  .sidebar__kbd, .sidebar__clear {
    position: absolute;
    right: calc(var(--sp-3) + 0.5rem);
    top: calc(var(--sp-5) + 20px);
    transform: translateY(-50%);
  }
  .sidebar__kbd {
    padding: 0.05rem 0.4rem;
    border-radius: 5px;
    border: 1px solid var(--c-border);
    background: rgba(255,255,255,0.04);
    color: var(--c-text-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .sidebar__search input:focus ~ .sidebar__kbd, .sidebar__clear:not([hidden]) ~ .sidebar__kbd { display: none; }
  .sidebar__clear {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    color: var(--c-text-1);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .sidebar__clear[hidden] { display: none; }
  .sidebar__search input:not(:placeholder-shown) ~ .sidebar__kbd { display: none; }
  .sidebar__status { margin: 0; padding: 0 var(--sp-4); font-size: 0.7rem; color: var(--c-text-3); }
  .sidebar__status:empty { display: none; }

  /* ── Sections ── */
  .sidebar__nav { display: flex; flex-direction: column; gap: var(--sp-4); padding: var(--sp-1) var(--sp-3) 0; }
  .sb-section[hidden] { display: none; }
  .sb-label {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-1);
    padding: 0 var(--sp-2);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-3);
  }
  .sb-label__count {
    padding: 0.05rem 0.4rem;
    border-radius: var(--r-full);
    background: rgba(234,179,8,0.1);
    color: #facc15;
    font-size: 0.62rem;
    letter-spacing: 0.02em;
  }
  .sb-label__link { margin-left: auto; font-size: 0.66rem; letter-spacing: 0.04em; text-transform: none; color: var(--c-text-3); font-weight: 600; }
  .sb-label__link:hover { color: #facc15; }

  .sb-new {
    padding: 0.05rem 0.4rem;
    border-radius: var(--r-full);
    background: rgba(52,211,153,0.12);
    color: #34d399;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Quick links (Get started, Templates) */
  .sb-quick { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .sb-quick .sidebar__item[hidden] { display: none; }
  .sb-quick__link {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 36px;
    padding: 0.35rem var(--sp-2);
    border-radius: var(--r-md);
    color: var(--c-text-2);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .sb-quick__link:hover { background: rgba(255,255,255,0.04); color: var(--c-text-1); }
  .sb-quick__link.is-active { background: rgba(234,179,8,0.1); color: #facc15; }
  .sb-quick__icon { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 7px; background: rgba(255,255,255,0.04); color: var(--c-text-2); flex-shrink: 0; }
  .sb-quick__link.is-active .sb-quick__icon, .sb-quick__icon--tpl { background: rgba(234,179,8,0.12); color: #facc15; }
  .sb-quick__text { flex: 1; display: grid; line-height: 1.25; }
  .sb-quick__text small { font-size: 0.68rem; font-weight: 500; color: var(--c-text-3); }

  /* Groups (accordion) */
  .sidebar__group { display: flex; flex-direction: column; }
  .sidebar__group[hidden] { display: none; }
  .sidebar__group-header {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    width: 100%;
    min-height: 34px;
    padding: 0.3rem var(--sp-2);
    border: none;
    border-radius: var(--r-md);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s;
  }
  .sidebar__group-header:hover { background: rgba(255,255,255,0.04); }
  .sidebar__group-header:focus-visible, .sidebar__link:focus-visible, .sb-quick__link:focus-visible, .sb-label__link:focus-visible, .sidebar__clear:focus-visible {
    outline: 2px solid #facc15;
    outline-offset: -2px;
  }
  .sidebar__group-icon { display: grid; place-items: center; width: 18px; height: 18px; flex-shrink: 0; color: var(--c-text-3); transition: color 0.2s; }
  .sidebar__group-icon :global(svg) { width: 14px; height: 14px; }
  .sidebar__group.is-expanded .sidebar__group-icon { color: #facc15; }
  .sidebar__group-name { flex: 1; font-size: 0.82rem; font-weight: 600; color: var(--c-text-2); transition: color 0.2s; }
  .sidebar__group-header:hover .sidebar__group-name, .sidebar__group.is-expanded .sidebar__group-name { color: var(--c-text-1); }
  .sidebar__group-count {
    min-width: 22px;
    padding: 0.05rem 0.35rem;
    border-radius: var(--r-full);
    background: rgba(255,255,255,0.04);
    color: var(--c-text-3);
    font-size: 0.64rem;
    font-weight: 600;
    text-align: center;
  }
  .sidebar__group-chevron { flex-shrink: 0; opacity: 0.45; transition: transform 0.25s ease, opacity 0.2s; }
  .sidebar__group.is-expanded .sidebar__group-chevron { transform: rotate(180deg); opacity: 1; color: #facc15; }
  .sidebar__group-content { display: grid; grid-template-rows: 0fr; overflow: hidden; transition: grid-template-rows 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
  .sidebar__group.is-expanded .sidebar__group-content { grid-template-rows: 1fr; }
  .sidebar__group-content-inner { min-height: 0; }

  .sidebar__list {
    margin: 2px 0 6px calc(var(--sp-2) + 8px);
    padding: 0 0 0 var(--sp-3);
    list-style: none;
    border-left: 1px solid rgba(255,255,255,0.07);
  }
  .sidebar__list .sidebar__item[hidden] { display: none; }
  .sidebar__link {
    position: relative;
    display: block;
    padding: 0.32rem var(--sp-2);
    border-radius: var(--r-sm);
    color: var(--c-text-3);
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .sidebar__link:hover { color: var(--c-text-1); background: rgba(255,255,255,0.03); }
  .sidebar__link--active { color: #facc15; background: linear-gradient(90deg, rgba(234,179,8,0.1), transparent); font-weight: 600; }
  .sidebar__link--active::before {
    content: '';
    position: absolute;
    left: calc(var(--sp-3) * -1 - 1px);
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 60%;
    border-radius: 1px;
    background: #facc15;
  }

  .sidebar__empty { margin: 0; padding: var(--sp-6) var(--sp-3); border: 1px dashed var(--c-border); border-radius: var(--r-md); text-align: center; font-size: 0.8rem; color: var(--c-text-3); }
  .sidebar__empty[hidden] { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .sidebar__group-content, .sidebar__group-chevron { transition: none; }
  }

  /* ── Mobile drawer ── */
  .mobile-filter-trigger { display: none; }
  .mobile-filter-backdrop { display: none; }

  @media (max-width: 768px) {
    .mobile-filter-trigger {
      display: flex; position: fixed; bottom: var(--sp-6); left: 0; width: 100%;
      justify-content: center; z-index: 40; pointer-events: none;
