---
// src/components/docs/Sidebar.astro
import { components, sectionCategories } from '../../data/registry/index';
import type { Locale } from '../../config/site';
import { getLangFromUrl, useTranslations, getLocalizedPath, cleanPath } from '../../i18n/translations';
import { getLocalizedCategory, getLocalizedSectionCategory } from '../../i18n/catalog';

interface Props {
  categories: { id: string; name: string; icon: string; description: string }[];
  currentPath: string;
  lang?: Locale;
}

const detectedLang = getLangFromUrl(Astro.url);
const { categories, currentPath, lang = detectedLang } = Astro.props;
const t = useTranslations(lang);

// Path detection
const normalizedCurrentPath = cleanPath(currentPath).replace(/\/$/, '') || '/';
const isSectionsPath = normalizedCurrentPath.startsWith('/sections');
const isComponentsPath = !isSectionsPath;

// Component categories vs sections category
const rawComponentCategories = categories.filter((c) => c.id !== 'sections');
const componentCategories = rawComponentCategories.map((c) => getLocalizedCategory(c, lang));
const localizedSectionCategories = sectionCategories.map((sc) => getLocalizedSectionCategory(sc, lang));

const totalComponentsCount = components.filter((c) => c.category !== 'sections').length;
const totalSectionsCount = components.filter((c) => c.category === 'sections').length;

// Server-side: determine which component categories should be expanded
const expandedCategories = new Set<string>();
rawComponentCategories.forEach((cat) => {
  const catComponents = components.filter((c) => c.category === cat.id);
  const hasActive = catComponents.some(comp => `/docs/${comp.slug}` === normalizedCurrentPath);
  if (hasActive) {
    expandedCategories.add(cat.id);
  }
});
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar__search">
    <svg class="sidebar__search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input type="text" id="sidebar-search" placeholder={t('search.placeholder')} aria-label={t('search.placeholder')} />
  </div>

  <!-- Quick Switcher Tabs between Components and Sections -->
  <div class="sidebar__tabs" role="tablist" aria-label="Library Section Switcher">
    <button 
      type="button" 
      class:list={['sidebar__tab-btn', { 'sidebar__tab-btn--active': isComponentsPath }]}
      id="tabBtnComponents"
      data-target="components"
      aria-label="Switch to UI Components"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>{t('nav.components')}</span>
      <span class="sidebar__tab-count">{totalComponentsCount}</span>
    </button>
    <button 
      type="button" 
      class:list={['sidebar__tab-btn', { 'sidebar__tab-btn--active': isSectionsPath }]}
      id="tabBtnSections"
      data-target="sections"
      aria-label="Switch to Page Sections"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
      <span>{t('nav.sections')}</span>
      <span class="sidebar__tab-count">{totalSectionsCount}</span>
    </button>
  </div>

  <nav class="sidebar__inner" aria-label="Component categories">
    <!-- ==================== BUBBLE 1: UI COMPONENTS ==================== -->
    <div 
      class:list={['sidebar__bubble', 'sidebar__bubble--components', { 'is-expanded': isComponentsPath }]} 
      id="bubble-components"
      data-bubble="components"
    >
      <button type="button" class="sidebar__bubble-header" aria-expanded={isComponentsPath ? 'true' : 'false'}>
        <div class="sidebar__bubble-meta">
          <span class="sidebar__bubble-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
          </span>
          <div class="sidebar__bubble-text">
            <span class="sidebar__bubble-title">{t('sidebar.components')}</span>
            <span class="sidebar__bubble-subtitle">{componentCategories.length} categories · {totalComponentsCount} items</span>
          </div>
        </div>
        <div class="sidebar__bubble-right">
          <span class="sidebar__bubble-badge">{totalComponentsCount}</span>
          <svg class="sidebar__bubble-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </button>

      <div class="sidebar__bubble-body">
        <div class="sidebar__bubble-body-inner">
          {componentCategories.map((cat) => {
            const catComponents = components.filter((c) => c.category === cat.id);
            if (catComponents.length === 0) return null;

            const isExpanded = expandedCategories.has(cat.id);

            return (
              <div class:list={['sidebar__group', { 'is-expanded': isExpanded }]} data-category={cat.id}>
                <button class="sidebar__group-header" aria-expanded={isExpanded ? 'true' : 'false'}>
                  <span class="sidebar__group-icon" set:html={cat.icon}></span>
                  <span class="sidebar__group-name">{cat.name}</span>
                  <span class="sidebar__group-count">{catComponents.length}</span>
                  <svg class="sidebar__group-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>

                <div class="sidebar__group-content">
                  <div class="sidebar__group-content-inner">
                    <ul class="sidebar__list">
                      {catComponents.map((comp) => {
                        const rawHref = `/docs/${comp.slug}`;
                        const href = getLocalizedPath(rawHref, lang);
                        const isActive = normalizedCurrentPath === rawHref;
                        return (
                          <li class="sidebar__item" data-name={comp.name.toLowerCase()}>
                            <a
                              href={href}
                              class:list={['sidebar__link', { 'sidebar__link--active': isActive }]}
                              aria-current={isActive ? 'page' : undefined}
                            >
                              {comp.name}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- ==================== BUBBLE 2: PAGE SECTIONS ==================== -->
    <div 
      class:list={['sidebar__bubble', 'sidebar__bubble--sections', { 'is-expanded': isSectionsPath }]} 
      id="bubble-sections"
      data-bubble="sections"
    >
      <button type="button" class="sidebar__bubble-header" aria-expanded={isSectionsPath ? 'true' : 'false'}>
        <div class="sidebar__bubble-meta">
          <span class="sidebar__bubble-icon sidebar__bubble-icon--sections">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </span>
          <div class="sidebar__bubble-text">
            <span class="sidebar__bubble-title">{t('sidebar.sections')}</span>
            <span class="sidebar__bubble-subtitle">{localizedSectionCategories.length} categories · {totalSectionsCount} templates</span>
          </div>
        </div>
        <div class="sidebar__bubble-right">
          <span class="sidebar__bubble-badge sidebar__bubble-badge--sections">{totalSectionsCount}</span>
          <svg class="sidebar__bubble-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </button>

      <div class="sidebar__bubble-body">
        <div class="sidebar__bubble-body-inner">
          <div class="sidebar__subgroups">
            {localizedSectionCategories.map((subCat) => {
              const subComps = components.filter((c) => c.category === 'sections' && c.sectionCategory === subCat.id);
              if (subComps.length === 0) return null;
              return (
                <div class="sidebar__subgroup" data-subgroup={subCat.id}>
                  <div class="sidebar__subgroup-title">
                    <span class="sidebar__subgroup-name">{subCat.name}</span>
                    <span class="sidebar__subgroup-count">{subComps.length}</span>
                  </div>
                  <ul class="sidebar__list sidebar__list--sub">
                    {subComps.map((comp) => {
                      const rawHref = `/sections/${comp.slug}`;
                      const href = getLocalizedPath(rawHref, lang);
                      const isActive = normalizedCurrentPath === rawHref;
                      return (
                        <li class="sidebar__item" data-name={comp.name.toLowerCase()}>
                          <a
                            href={href}
                            class:list={['sidebar__link', { 'sidebar__link--active': isActive }]}
                            aria-current={isActive ? 'page' : undefined}
                          >
                            {comp.name}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </nav>
</aside>

<div class="mobile-filter-trigger">
  <button id="mobile-filter-btn" aria-label="Explore components">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <span>Explore</span>
  </button>
</div>

<div class="mobile-filter-backdrop" id="mobile-filter-backdrop"></div>

<script is:inline>
  (function () {
    const sidebar = document.getElementById('sidebar');
    if (!sidebar) return;

    const SCROLL_KEY = 'sidebar-scroll-pos';

    // Restore scroll position
    const savedScroll = sessionStorage.getItem(SCROLL_KEY);
    if (savedScroll !== null) {
      requestAnimationFrame(function () {
        sidebar.scrollTop = parseInt(savedScroll, 10);
      });
    }

    // Save scroll position
    let saveTimeout;
    sidebar.addEventListener('scroll', function () {
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(function () {
        sessionStorage.setItem(SCROLL_KEY, String(sidebar.scrollTop));
      }, 50);
    });

    // Bubble Headers Click Toggle
    document.querySelectorAll('.sidebar__bubble-header').forEach(function (header) {
      header.addEventListener('click', function () {
        var bubble = header.closest('.sidebar__bubble');
        if (!bubble) return;
        var isExp = bubble.classList.contains('is-expanded');
        if (isExp) {
          bubble.classList.remove('is-expanded');
          header.setAttribute('aria-expanded', 'false');
        } else {
          bubble.classList.add('is-expanded');
          header.setAttribute('aria-expanded', 'true');
        }
        updateTabsState();
      });
    });

    // Quick Switcher Tabs
    var tabComponents = document.getElementById('tabBtnComponents');
    var tabSections = document.getElementById('tabBtnSections');
    var bubbleComponents = document.getElementById('bubble-components');
    var bubbleSections = document.getElementById('bubble-sections');

    function selectBubble(target) {
      if (target === 'components') {
        if (tabComponents) tabComponents.classList.add('sidebar__tab-btn--active');
        if (tabSections) tabSections.classList.remove('sidebar__tab-btn--active');
        if (bubbleComponents) {
          bubbleComponents.classList.add('is-expanded');
          var h = bubbleComponents.querySelector('.sidebar__bubble-header');
          if (h) h.setAttribute('aria-expanded', 'true');
          bubbleComponents.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        if (bubbleSections) {
          bubbleSections.classList.remove('is-expanded');
          var hs = bubbleSections.querySelector('.sidebar__bubble-header');
          if (hs) hs.setAttribute('aria-expanded', 'false');
        }
      } else if (target === 'sections') {
        if (tabSections) tabSections.classList.add('sidebar__tab-btn--active');
        if (tabComponents) tabComponents.classList.remove('sidebar__tab-btn--active');
        if (bubbleSections) {
          bubbleSections.classList.add('is-expanded');
          var hs = bubbleSections.querySelector('.sidebar__bubble-header');
          if (hs) hs.setAttribute('aria-expanded', 'true');
          bubbleSections.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        if (bubbleComponents) {
          bubbleComponents.classList.remove('is-expanded');
          var h = bubbleComponents.querySelector('.sidebar__bubble-header');
          if (h) h.setAttribute('aria-expanded', 'false');
        }
      }
    }

    function updateTabsState() {
      var isCompOpen = bubbleComponents && bubbleComponents.classList.contains('is-expanded');
      var isSecOpen = bubbleSections && bubbleSections.classList.contains('is-expanded');
      if (tabComponents) tabComponents.classList.toggle('sidebar__tab-btn--active', isCompOpen && !isSecOpen);
      if (tabSections) tabSections.classList.toggle('sidebar__tab-btn--active', isSecOpen && !isCompOpen);
    }

    if (tabComponents) {
      tabComponents.addEventListener('click', function () {
        selectBubble('components');
      });
    }

    if (tabSections) {
      tabSections.addEventListener('click', function () {
        selectBubble('sections');
      });
    }

    // Category Group Accordion Toggle inside components
    document.querySelectorAll('.sidebar__group-header').forEach(function (header) {
      header.addEventListener('click', function (e) {
        e.stopPropagation();
        var group = header.closest('.sidebar__group');
        if (!group) return;
        var isExpanded = group.classList.contains('is-expanded');
        if (isExpanded) {
          group.classList.remove('is-expanded');
          header.setAttribute('aria-expanded', 'false');
        } else {
          group.classList.add('is-expanded');
          header.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Scroll active link into view
    var allLinks = document.querySelectorAll('[aria-current="page"]');
    if (allLinks.length > 0 && savedScroll === null) {
      setTimeout(function () {
        allLinks[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 300);
    }

    // Search logic across both bubbles
    var searchInput = document.getElementById('sidebar-search');
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var query = searchInput.value.toLowerCase().trim();

        ['bubble-components', 'bubble-sections'].forEach(function (bubbleId) {
          var bubble = document.getElementById(bubbleId);
          if (!bubble) return;
          var anyVisibleInBubble = false;

          // Component groups
          bubble.querySelectorAll('.sidebar__group').forEach(function (group) {
            var hasVisible = false;
            group.querySelectorAll('.sidebar__item').forEach(function (item) {
              var name = item.getAttribute('data-name') || '';
              var visible = name.includes(query);
              item.style.display = visible ? '' : 'none';
              if (visible) hasVisible = true;
            });
            if (query.length > 0) {
              group.style.display = hasVisible ? '' : 'none';
              if (hasVisible) {
                group.classList.add('is-expanded');
                var gh = group.querySelector('.sidebar__group-header');
                if (gh) gh.setAttribute('aria-expanded', 'true');
                anyVisibleInBubble = true;
              }
            } else {
              group.style.display = '';
            }
          });

          // Section subgroups
          bubble.querySelectorAll('.sidebar__subgroup').forEach(function (subgroup) {
            var items = subgroup.querySelectorAll('.sidebar__item');
            var subHasVisible = false;
            items.forEach(function (it) {
              var name = it.getAttribute('data-name') || '';
              var visible = name.includes(query);
              it.style.display = visible ? '' : 'none';
              if (visible) subHasVisible = true;
            });
            subgroup.style.display = (query.length > 0 && !subHasVisible) ? 'none' : '';
            if (subHasVisible) anyVisibleInBubble = true;
          });

          if (query.length > 0) {
            bubble.style.display = anyVisibleInBubble ? '' : 'none';
            if (anyVisibleInBubble) {
              bubble.classList.add('is-expanded');
              var bh = bubble.querySelector('.sidebar__bubble-header');
              if (bh) bh.setAttribute('aria-expanded', 'true');
            }
          } else {
            bubble.style.display = '';
            bubble.querySelectorAll('.sidebar__subgroup').forEach(function (sub) {
              sub.style.display = '';
            });
          }
        });
      });
    }

    // Mobile filter drawer
    var mobileBtn = document.getElementById('mobile-filter-btn');
    var backdrop = document.getElementById('mobile-filter-backdrop');

    function openMobileFilter() {
      sidebar.classList.add('is-open');
      if (backdrop) backdrop.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileFilter() {
      sidebar.classList.remove('is-open');
      if (backdrop) backdrop.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (mobileBtn) mobileBtn.addEventListener('click', openMobileFilter);
    if (backdrop) backdrop.addEventListener('click', closeMobileFilter);

    sidebar.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        if (window.innerWidth <= 768) closeMobileFilter();
      });
    });
  })();
</script>

<style>
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    overflow-y: auto;
    border-right: 1px solid var(--c-border);
    padding: var(--sp-5) 0 var(--sp-10);
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.08) transparent;
  }
  .sidebar::-webkit-scrollbar { width: 4px; }
  .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 10px; }

  /* Search bar */
  .sidebar__search {
    padding: 0 var(--sp-3);
    margin-bottom: var(--sp-3);
    position: relative;
  }
  .sidebar__search input {
    width: 100%;
    padding: 0.62rem 0.75rem 0.62rem 2.3rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    color: var(--c-text-1);
    font-size: 0.78rem;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    font-family: var(--font-sans);
  }
  .sidebar__search input::placeholder { color: var(--c-text-3); }
  .sidebar__search input:focus {
    border-color: rgba(234,179,8,0.4);
    background: rgba(255,255,255,0.05);
  }
  .sidebar__search-icon {
    position: absolute;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--c-text-3);
    pointer-events: none;
    opacity: 0.6;
  }

  /* Quick Switcher Tabs */
  .sidebar__tabs {
    display: flex;
    gap: 6px;
    padding: 0 var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .sidebar__tab-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0.45rem 0.4rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    color: var(--c-text-3);
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .sidebar__tab-btn:hover {
    color: var(--c-text-1);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
  }
  .sidebar__tab-btn--active {
    color: #facc15;
    background: rgba(234, 179, 8, 0.12);
    border-color: rgba(234, 179, 8, 0.35);
    box-shadow: 0 4px 12px rgba(234, 179, 8, 0.1);
  }
  .sidebar__tab-count {
    font-size: 0.6rem;
    padding: 0.08rem 0.35rem;
    border-radius: var(--r-full);
    background: rgba(0, 0, 0, 0.4);
    color: currentColor;
    font-weight: 800;
  }

  /* Nav shell */
  .sidebar__inner {
    padding: 0 var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  /* ==================== BUBBLE CONTAINERS ==================== */
  .sidebar__bubble {
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.07);
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sidebar__bubble:hover {
    border-color: rgba(255, 255, 255, 0.14);
  }

  .sidebar__bubble.is-expanded {
    background: rgba(15, 23, 42, 0.65);
    border-color: rgba(234, 179, 8, 0.28);
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.5), 0 0 16px -4px rgba(234, 179, 8, 0.08);
  }

  .sidebar__bubble-header {
    width: 100%;
    padding: 0.75rem 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s ease;
  }

  .sidebar__bubble-header:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .sidebar__bubble-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .sidebar__bubble-icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .sidebar__bubble.is-expanded .sidebar__bubble-icon {
    background: rgba(234, 179, 8, 0.15);
    border-color: rgba(234, 179, 8, 0.35);
    color: #facc15;
    box-shadow: 0 0 12px rgba(234, 179, 8, 0.15);
  }

  .sidebar__bubble-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .sidebar__bubble-title {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .sidebar__bubble-subtitle {
    font-size: 0.62rem;
    color: #94a3b8;
  }

  .sidebar__bubble-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sidebar__bubble-badge {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.06);
    color: #94a3b8;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sidebar__bubble.is-expanded .sidebar__bubble-badge {
    background: rgba(234, 179, 8, 0.12);
    color: #facc15;
    border-color: rgba(234, 179, 8, 0.3);
  }

  .sidebar__bubble-chevron {
    color: #64748b;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
    flex-shrink: 0;
  }

  .sidebar__bubble.is-expanded .sidebar__bubble-chevron {
    transform: rotate(180deg);
    color: #facc15;
  }

  .sidebar__bubble-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

