---
---
<div class="confetti-btn-trigger">
  <span>Success!</span>
  <div class="confetti-container">
    <div class="piece" style="--l: 10%; --d: 0.5s"></div>
    <div class="piece" style="--l: 50%; --d: 1s"></div>
    <div class="piece" style="--l: 80%; --d: 0.2s"></div>
  </div>
</div>
<style>
  .confetti-container { position: absolute; inset: 0; pointer-events: none; }
  .piece { position: absolute; left: var(--l); top: 0; width: 8px; height: 8px; background: #6366f1; border-radius: 2px; opacity: 0; animation: fall 2s infinite var(--d); }
  @keyframes fall {
    0% { transform: translateY(0) rotate(0); opacity: 1; }
    100% { transform: translateY(100px) rotate(360deg); opacity: 0; }
  }
</style>
