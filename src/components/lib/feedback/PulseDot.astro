<div class="status-wrap">
  <div class="pulse-dot"></div>
  <span>System Active</span>
</div>
<style>
  .status-wrap { display: flex; align-items: center; gap: 0.6rem; color: #34d399; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; }
  .pulse-dot { width: 8px; height: 8px; background: #34d399; border-radius: 50%; position: relative; }
  .pulse-dot::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #34d399; animation: pulse 1.5s infinite; }
  @keyframes pulse { 100% { opacity: 0; transform: scale(3.5); } }
</style>
