---
interface Props { percent: number; }
const { percent } = Astro.props;
const radius = 30;
const circum = 2 * Math.PI * radius;
const offset = circum - (percent / 100) * circum;
---
<div class="circle-box">
  <svg width="80" height="80">
    <circle class="bg" cx="40" cy="40" r={radius} />
    <circle class="val" cx="40" cy="40" r={radius} stroke-dasharray={circum} stroke-dashoffset={offset} />
  </svg>
  <div class="label">{percent}%</div>
</div>
<style>
  .circle-box { position: relative; width: 80px; height: 80px; display: grid; place-items: center; }
  svg { transform: rotate(-90deg); }
  circle { fill: transparent; stroke-width: 6; stroke-linecap: round; }
  .bg { stroke: rgba(255,255,255,0.05); }
  .val { stroke: #6366f1; transition: stroke-dashoffset 1s ease; }
  .label { position: absolute; font-size: 0.8rem; font-weight: 800; color: #fff; }
</style>
