---
<div class="glitch-alert">
  <span class="glitch-text" data-text="CRITICAL ERROR">CRITICAL ERROR</span>
</div>
<style>
  .glitch-alert { background: #ff003c; padding: 1.5rem; border: 2px solid #fff; position: relative; overflow: hidden; }
  .glitch-text { font-family: monospace; font-weight: 900; color: #fff; font-size: 1.2rem; }
  .glitch-text::before { content: attr(data-text); position: absolute; left: -2px; text-shadow: 2px 0 #00e0ff; animation: glitch-anim 1s infinite linear alternate-reverse; }
  @keyframes glitch-anim { 0% { clip: rect(44px, 450px, 56px, 0); } 100% { clip: rect(12px, 450px, 80px, 0); } }
</style>
