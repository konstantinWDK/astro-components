<div class="tooltip-wrap" data-tip="Click to copy ID">
  <slot />
</div>
<style>
  .tooltip-wrap { position: relative; display: inline-block; cursor: help; }
  .tooltip-wrap::after { content: attr(data-tip); position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%); padding: 5px 10px; background: #111; color: #fff; font-size: 0.75rem; border-radius: 6px; white-space: nowrap; opacity: 0; pointer-events: none; transition: 0.2s; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 5px 15px rgba(0,0,0,0.4); }
  .tooltip-wrap:hover::after { opacity: 1; bottom: 110%; }
</style>
