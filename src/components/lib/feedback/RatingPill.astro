---
interface Props { score: number; }
const { score } = Astro.props;
---
<div class:list={["rate-pill", { "high": score >= 4, "mid": score >= 3 && score < 4, "low": score < 3 }]}>
  {score.toFixed(1)} ★
</div>
<style>
  .rate-pill { padding: 4px 12px; border-radius: 100px; font-weight: 800; font-size: 0.75rem; color: #fff; width: fit-content; }
  .high { background: #10b981; }
  .mid { background: #f59e0b; }
  .low { background: #ef4444; }
</style>
