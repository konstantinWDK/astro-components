---
interface Props { type?: 'info' | 'success' | 'warning' | 'error'; title: string; }
const { type = 'info', title } = Astro.props;
---
<div class:list={['alert', `alert--${type}` ]}>
  <div class="alert-icon">!</div>
  <div class="alert-content">
    <div class="alert-title">{title}</div>
    <div class="alert-body"><slot /></div>
  </div>
</div>
<style>
  .alert { display: flex; gap: 1rem; padding: 1.25rem; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(12px); background: rgba(255,255,255,0.03); }
  .alert--success { border-color: rgba(52,211,153,0.3); background: rgba(52,211,153,0.05); }
  .alert--warning { border-color: rgba(245,158,11,0.3); background: rgba(245,158,11,0.05); }
  .alert--error { border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.05); }
  .alert-icon { font-weight: 900; background: rgba(255,255,255,0.1); width: 24px; height: 24px; display: grid; place-items: center; border-radius: 50%; font-size: 0.8rem; }
  .alert-title { font-weight: 700; color: #fff; margin-bottom: 2px; }
  .alert-body { font-size: 0.85rem; color: #94a3b8; }
</style>
