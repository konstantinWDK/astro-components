---
<div class="skeleton-list">
  {[1,2,3].map(() => (
    <div class="skel-item">
      <div class="skel-avatar"></div>
      <div class="skel-lines"><div></div><div></div></div>
    </div>
  ))}
</div>
<style>
  .skel-item { display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .skel-avatar { width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.05); }
  .skel-lines { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .skel-lines div { height: 10px; background: rgba(255,255,255,0.05); border-radius: 5px; }
  .skel-lines div:last-child { width: 60%; }
  .skel-item div { position: relative; overflow: hidden; }
  .skel-item div::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.03), transparent); animation: shimmer 1.5s infinite; }
  @keyframes shimmer { 100% { transform: translateX(100%); } }
</style>
