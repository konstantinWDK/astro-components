---
/**
 * GlassCardGrid — A responsive grid specifically designed for card layouts with auto-fill columns.
 * 
 * @param {string} minWidth - Minimum width of columns (default: '300px').
 * @param {string} gap - Gap between items (default: '2rem').
 */
interface Props {
  minWidth?: string;
  gap?: string;
  className?: string;
}

const { minWidth = '300px', gap = '2rem', className = '' } = Astro.props;
---

<div class={`card-grid ${className}`} style={`--min-width: ${minWidth}; --gap: ${gap};`}>
  <slot />
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--min-width, 300px), 1fr));
    gap: var(--gap, 2rem);
    width: 100%;
  }
</style>
