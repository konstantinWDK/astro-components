---
import AnimatedGalaxy from '@components/lib/AnimatedGalaxy.astro';
---
<section class="f-hero">
  <div class="f-galaxy-bg">
    <AnimatedGalaxy />
  </div>
  <div class="f-overlay"></div>
  <div class="f-inner">
    <h1>Experience the <span>Next Dimension</span> of Design</h1>
    <p>Build stunning interfaces faster than ever with our premium component ecosystem.</p>
    <div class="f-actions"><slot /></div>
  </div>
</section>
<style>
  .f-hero { 
    position: relative;
    padding: 8rem 2rem; 
    text-align: center; 
    overflow: hidden;
    background: radial-gradient(circle at top, rgba(99,102,241,0.15) 0%, transparent 70%);
  }
  .f-galaxy-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.5;
  }
  .f-galaxy-bg svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .f-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.6) 100%);
    pointer-events: none;
  }
  .f-inner { 
    position: relative;
    z-index: 2;
    max-width: 800px; 
    margin: 0 auto; 
  }
  h1 { 
    font-size: 4rem; 
    font-weight: 900; 
    line-height: 1.1; 
    margin-bottom: 1.5rem; 
    color: #fff;
    text-shadow: 0 2px 20px rgba(0,0,0,0.5), 0 0 40px rgba(99,102,241,0.3);
  }
  h1 span { 
    background: linear-gradient(135deg, #6366f1, #c084fc); 
    -webkit-background-clip: text; 
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 20px rgba(99,102,241,0.5));
  }
  p { 
    font-size: 1.25rem; 
    color: #e2e8f0; 
    line-height: 1.6; 
    margin-bottom: 2.5rem;
    text-shadow: 0 1px 10px rgba(0,0,0,0.4);
  }
  .f-actions { 
    display: flex; 
    justify-content: center; 
    gap: 1rem; 
  }

  @media (prefers-reduced-motion: reduce) {
    .f-galaxy-bg * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
