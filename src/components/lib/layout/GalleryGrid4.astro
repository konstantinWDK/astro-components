---
/**
 * GalleryGrid4 — 4-Column aspect ratio grid for visual galleries and photos.
 */
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`gal-grid ${className}`}>
  <slot>
    <div class="gal-item"><span>Photo 1</span></div>
    <div class="gal-item"><span>Photo 2</span></div>
    <div class="gal-item"><span>Photo 3</span></div>
    <div class="gal-item"><span>Photo 4</span></div>
  </slot>
</div>

<style>
  .gal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    width: 100%;
  }
  .gal-grid :global(> *), .gal-item {
    aspect-ratio: 1;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    font-weight: 600;
  }
</style>
