---
import LogoWithGalaxy from '../LogoWithGalaxy.astro';
---
<footer class="c-footer">
  <div class="c-logo">
    <LogoWithGalaxy size="medium" />
  </div>
  <div class="c-copy">© 2024 Built with ❤️ and Astro.</div>
</footer>
<style>
  .c-footer { text-align: center; padding: 4rem; border-top: 1px solid rgba(255, 255, 255, 0.05); }
  .c-logo { margin-bottom: 0.5rem; display: flex; justify-content: center; }
  .c-copy { font-size: 0.8rem; color: #64748b; }
</style>
