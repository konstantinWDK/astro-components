---
/**
 * FooterCenteredMinimal — A minimal centered footer with copyright text.
 *
 * Displays a simple, clean footer with a logo slot and copyright text.
 * Suitable for landing pages, documentation sites, and minimal layouts.
 *
 * @param {string} copyright - Copyright text. Default: '© 2026 Built with Astro Components Kit.'.
 * @param {string} className - Additional CSS class to apply.
 *
 * @example
 * ```astro
 * <FooterCenteredMinimal copyright="© 2026 MyCompany. All rights reserved." />
 * ```
 */
interface Props {
  copyright?: string;
  className?: string;
}

const { copyright = '© 2026 Built with Astro Components Kit.', className = '' } = Astro.props;
---

<footer class:list={['footer-centered', className]}>
  <div class="footer-centered__inner">
    <div class="footer-centered__logo">
      <slot name="logo" />
    </div>
    <p class="footer-centered__copy">{copyright}</p>
  </div>
</footer>

<style>
  .footer-centered {
    border-top: 1px solid var(--c-border);
    padding: var(--sp-10) var(--sp-6);
    text-align: center;
  }
  .footer-centered__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }
  .footer-centered__logo {
    display: flex;
    justify-content: center;
  }
  .footer-centered__copy {
    font-size: 0.8rem;
    color: var(--c-text-3);
    margin: 0;
  }

  @media (max-width: 640px) {
    .footer-centered {
      padding: var(--sp-8) var(--sp-4);
    }
  }
</style>