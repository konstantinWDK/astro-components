---
/**
 * StepLayoutVertical — Vertical Progress Steps with space for detailed descriptions.
 */
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`step-lay ${className}`}>
  <div class="step-line">
    <div class="step-point">1</div>
    <div class="step-point">2</div>
    <div class="step-point">3</div>
  </div>
  <div class="step-content">
    <div class="step-block">
      <h4>1. Installation</h4>
      <p>Install astro-component-kit via npm in seconds.</p>
    </div>
    <div class="step-block">
      <h4>2. Configuration</h4>
      <p>Import components and design tokens into your Astro project.</p>
    </div>
    <div class="step-block">
      <h4>3. Build & Ship</h4>
      <p>Enjoy zero-runtime overhead and instant static builds.</p>
    </div>
  </div>
</div>

<style>
  .step-lay {
    display: flex;
    gap: 2rem;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }
  .step-line {
    width: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }
  .step-line::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    width: 2px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 0;
  }
  .step-point {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #6366f1;
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 0.9rem;
    box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
    z-index: 1;
  }
  .step-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex: 1;
  }
  .step-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 50px;
  }
  .step-block h4 {
    margin: 0;
    color: #fff;
    font-size: 1.05rem;
  }
  .step-block p {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0.25rem 0 0;
  }
</style>
