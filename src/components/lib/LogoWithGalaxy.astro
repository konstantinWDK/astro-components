---
import AnimatedGalaxy from './AnimatedGalaxy.astro';

interface Props {
  size?: 'small' | 'medium' | 'large';
  className?: string;
}

const { size = 'medium', className = '' } = Astro.props;

const sizes = {
  small: { logoHeight: '36px', galaxyWidth: '160px', galaxyHeight: '96px', galaxyTop: '-5px', galaxyLeft: '-40px' },
  medium: { logoHeight: '48px', galaxyWidth: '220px', galaxyHeight: '132px', galaxyTop: '0px', galaxyLeft: '-55px' },
  large: { logoHeight: '70px', galaxyWidth: '320px', galaxyHeight: '192px', galaxyTop: '5px', galaxyLeft: '-70px' },
};

const s = sizes[size];
---

<div
  class={`logo-container ${className}`.trim()}
  style={`--logo-height: ${s.logoHeight}; --galaxy-top: ${s.galaxyTop}; --galaxy-left: ${s.galaxyLeft};`}
>
  <!-- Galaxy behind, bottom-left -->
  <div class="galaxy-wrap">
    <AnimatedGalaxy className="galaxy-svg" style={`width: ${s.galaxyWidth}; height: ${s.galaxyHeight};`} />
  </div>
  <!-- Logo text on top -->
  <div class="logo-text">
    <img src="/logo.svg" alt="Astro Kit Components" />
  </div>
</div>

<style>
  .logo-container {
    position: relative;
    display: inline-block;
    vertical-align: middle;
  }

  .galaxy-wrap {
    position: absolute;
    top: var(--galaxy-top, 0px);
    left: var(--galaxy-left, 0px);
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }

  .galaxy-wrap :global(.galaxy-svg) {
    display: block;
    opacity: 0.7;
  }

  .logo-text {
    position: relative;
    z-index: 2;
    display: block;
  }

  .logo-text img {
    height: var(--logo-height, 48px);
    width: auto;
    display: block;
  }
</style>
