---
---
<div class="prod-card">
  <div class="image"></div>
  <div class="info">
    <div class="meta"><span>New</span><span>5.0 ★</span></div>
    <h4>Premium Headphones</h4>
    <div class="bot">
      <span class="price">$299</span>
      <button>Add</button>
    </div>
  </div>
</div>
<style>
  .prod-card { background: #0f172a; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); overflow: hidden; transition: 0.3s; }
  .prod-card:hover { border-color: #6366f1; transform: translateY(-3px); }
  .image { height: 180px; background: #1e293b; }
  .info { padding: 1.25rem; }
  .meta { display: flex; justify-content: space-between; font-size: 0.7rem; color: #818cf8; font-weight: 700; margin-bottom: 0.5rem; }
  h4 { color: #fff; margin: 0; font-size: 1.1rem; }
  .bot { display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; }
  .price { font-weight: 800; color: #fff; font-size: 1.25rem; }
  button { background: #6366f1; border: none; color: #fff; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; cursor: pointer; }
</style>
