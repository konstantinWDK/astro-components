<div class="cyber-card">
  <div class="glitch-line"></div>
  <h3>System Core</h3>
  <p>Advanced neural processing activated.</p>
</div>
<style>
  .cyber-card { background: #000; color: #00e0ff; border: 1px solid #ff003c; padding: 1.5rem; clip-path: polygon(0 0, 100% 0, 100% 85%, 85% 100%, 0 100%); position: relative; }
  .glitch-line { position: absolute; height: 1px; width: 100%; background: #ff003c; top: 10%; left: 0; opacity: 0.5; animation: glitch 4s infinite; }
  @keyframes glitch { 0%, 100% { top: 10%; } 50% { top: 90%; } }
</style>
