---
---
<div class="music-mini">
  <div class="art"></div>
  <div class="track">
    <h4>Moonlight Sonatina</h4>
    <p>Astro Orchestra</p>
    <div class="progress"><div class="bar"></div></div>
  </div>
  <div class="play">▶</div>
</div>
<style>
  .music-mini { display: flex; align-items: center; gap: 1rem; background: #111; padding: 0.75rem; border-radius: 14px; border: 1px solid #333; width: 100%; max-width: 320px; }
  .art { width: 50px; height: 50px; background: #818cf8; border-radius: 8px; flex-shrink: 0; }
  .track { flex: 1; }
  h4 { font-size: 0.85rem; color: #fff; margin: 0; }
  p { font-size: 0.7rem; color: #64748b; margin: 0; }
  .progress { height: 3px; background: #222; border-radius: 2px; margin-top: 8px; position: relative; }
  .bar { position: absolute; left: 0; top: 0; height: 100%; width: 40%; background: #6366f1; border-radius: 2px; }
  .play { font-size: 1.2rem; cursor: pointer; color: #fff; }
</style>
