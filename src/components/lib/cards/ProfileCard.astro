<div class="profile-card">
  <div class="banner"></div>
  <div class="avatar"></div>
  <h3>Sarah Jenkins</h3>
  <p>Lead Developer</p>
  <div class="socials"><span>🐦</span><span>💼</span><span>🌐</span></div>
</div>
<style>
  .profile-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; text-align: center; overflow: hidden; padding-bottom: 1.5rem; }
  .banner { height: 80px; background: linear-gradient(135deg, #6366f1, #c084fc); }
  .avatar { width: 80px; height: 80px; background: #334155; border: 4px solid #080b14; border-radius: 50%; margin: -40px auto 1rem; }
  h3 { color: #fff; margin: 0; }
  p { font-size: 0.85rem; color: #94a3b8; }
  .socials { display: flex; justify-content: center; gap: 1rem; margin-top: 1rem; cursor: pointer; }
</style>
