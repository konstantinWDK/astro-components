---
interface Props { plan: string; price: string; featured?: boolean; }
const { plan, price, featured = false } = Astro.props;
---
<div class:list={["price-card", { "featured": featured }]}>
  <span class="plan">{plan}</span>
  <div class="price"><span>$</span>{price}</div>
  <ul class="features"><li>Unlimited Projects</li><li>24/7 Support</li><li>Custom Domain</li></ul>
  <button>Choose Plan</button>
</div>
<style>
  .price-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; padding: 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .featured { border-color: #6366f1; background: rgba(99,102,241,0.05); transform: scale(1.05); }
  .price { font-size: 2.5rem; font-weight: 800; color: #fff; }
  .features { list-style: none; padding: 0; font-size: 0.9rem; color: #94a3b8; }
  button { background: #6366f1; color: #fff; border: none; padding: 0.8rem; border-radius: 12px; font-weight: 700; cursor: pointer; }
</style>
