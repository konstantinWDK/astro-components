<div class="glow-wrap">
  <div class="glow-content">
    <h3>Project Title</h3>
    <p>Web design / 2024</p>
  </div>
</div>
<style>
  .glow-wrap { position: relative; padding: 2px; border-radius: 20px; background: rgba(255,255,255,0.1); overflow: hidden; }
  .glow-wrap::before { content: ''; position: absolute; inset: -50%; background: conic-gradient(from 0deg, transparent, #6366f1, transparent); animation: rotate 4s linear infinite; }
  .glow-content { position: relative; background: #080b14; padding: 2rem; border-radius: 18px; z-index: 1; text-align: center; }
  h3 { margin: 0; color: #fff; }
  p { color: #94a3b8; font-size: 0.9rem; }
  @keyframes rotate { 100% { transform: rotate(360deg); } }
</style>
