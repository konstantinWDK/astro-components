---
import LogoWithGalaxy from '../LogoWithGalaxy.astro';
---
<div class="splash">
  <div class="logo-anim">
    <LogoWithGalaxy size="large" />
  </div>
</div>
<style>
  .splash { position: fixed; inset: 0; background: #080b14; z-index: 9999; display: grid; place-items: center; animation: fade-out 1s forwards 2s; }
  .logo-anim { animation: scale-pulse 1.5s infinite linear; }
  @keyframes fade-out { to { opacity: 0; pointer-events: none; } }
  @keyframes scale-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
</style>
