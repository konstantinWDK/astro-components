---
/**
 * UnivResearch — Flagship scientific research institutes, KPIs and high-impact publications showcase.
 *
 * @param {Record<string, string>} routes - Route map
 * @param {string} className - Optional additional CSS class
 */
import type { HTMLAttributes } from 'astro/types';
import { researchInstitutes, univRoutes } from '../templates/university/data';

interface Props extends HTMLAttributes<'section'> {
  routes?: typeof univRoutes;
  className?: string;
}

const {
  routes = univRoutes,
  class: classProp,
  className = '',
  ...rest
} = Astro.props;

const classes = ['univ-research', classProp, className].filter(Boolean).join(' ');
---

<section class={classes} id="investigacion-institutos" {...rest}>
  <div class="univ-research__container">
    <div class="univ-research__header">
      <div class="univ-research__eyebrow">I+D+i DE IMPACTO GLOBAL</div>
      <h2 class="univ-research__title">Institutos de Investigación de Vanguardia</h2>
      <p class="univ-research__lead">
        Nuestros 42 grupos de investigación lideran consorcios internacionales con más de 54M € en proyectos Horizon Europe, transferencias de patentes a la industria y ensayos clínicos avanzados.
      </p>
    </div>

    <!-- Research KPIs Banner -->
    <div class="univ-research__kpis-strip">
      <div class="univ-research__kpi-item">
        <span class="univ-research__kpi-num">54.8M €</span>
        <span class="univ-research__kpi-label">Financiación en Proyectos I+D</span>
      </div>
      <div class="univ-research__kpi-item">
        <span class="univ-research__kpi-num">274</span>
        <span class="univ-research__kpi-label">Papers en Revistas Q1 Nature/IEEE</span>
      </div>
      <div class="univ-research__kpi-item">
        <span class="univ-research__kpi-num">38</span>
        <span class="univ-research__kpi-label">Patentes Activas Transferidas</span>
      </div>
      <div class="univ-research__kpi-item">
        <span class="univ-research__kpi-num">84</span>
        <span class="univ-research__kpi-label">Doctorandos con Beca FPI/FPU</span>
      </div>
    </div>

    <!-- Flagship Institutes Grid -->
    <div class="univ-research__grid">
      {researchInstitutes.map((inst) => (
        <article class="univ-research__card">
          <div class="univ-research__card-top">
            <div class="univ-research__icon-wrap" set:html={inst.iconSvg} />
            <div class="univ-research__metrics">
              <span class="univ-research__metric-tag">{inst.metrics.papers} papers</span>
              <span class="univ-research__metric-tag">{inst.metrics.citations} citas</span>
              <span class="univ-research__metric-tag univ-research__metric-tag--gold">{inst.metrics.budget}</span>
            </div>
          </div>

          <h3 class="univ-research__card-title">{inst.name}</h3>
          <p class="univ-research__director">
            <strong>Dirección:</strong> {inst.director}
          </p>
          <p class="univ-research__desc">{inst.description}</p>

          <div class="univ-research__projects">
            <span class="univ-research__projects-title">Proyectos en curso:</span>
            <ul class="univ-research__projects-list">
              {inst.leadProjects.map((p) => (
                <li>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="univ-research__dot" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="univ-research__card-footer">
            <a href={routes.programs} class="univ-research__btn-phd">
              <span>Ver Programas de Doctorado &rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Corporate Collaboration Callout -->
    <div class="univ-research__collab-banner">
      <div class="univ-research__collab-content">
        <h3 class="univ-research__collab-title">¿Tu Empresa Necesita Transferencia Tecnológica o I+D a Medida?</h3>
        <p class="univ-research__collab-desc">
          Colaboramos con más de 180 multinacionales e instituciones públicas mediante contratos de I+D bajo el Art. 83 LOU, cátedras de empresa y doctorados industriales compartidos.
        </p>
      </div>
      <div class="univ-research__collab-action">
        <a href={`mailto:transferencia@veritas.edu.es`} class="univ-research__btn-collab">
          <span>Contactar con la Oficina OTRI</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .univ-research {
    padding: 5rem 0;
    background: var(--univ-bg, #070c1a);
  }

  .univ-research__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .univ-research__header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3rem;
  }

  .univ-research__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--univ-gold, #f59e0b);
    margin-bottom: 0.75rem;
  }

  .univ-research__title {
    font-family: var(--univ-font-serif, serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .univ-research__lead {
    font-size: 1.0625rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
  }

  /* KPIs Strip */
  .univ-research__kpis-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius, 12px);
    padding: 2rem;
    margin-bottom: 3.5rem;
    text-align: center;
  }

  .univ-research__kpi-num {
    display: block;
    font-family: var(--univ-font-serif, serif);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--univ-gold, #f59e0b);
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .univ-research__kpi-label {
    font-size: 0.8125rem;
    color: var(--univ-text-muted, #94a3b8);
    font-weight: 600;
  }

  /* Grid */
  .univ-research__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .univ-research__card {
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius, 12px);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .univ-research__card:hover {
    transform: translateY(-4px);
    border-color: var(--univ-gold, #f59e0b);
  }

  .univ-research__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    gap: 1rem;
  }

  .univ-research__icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--univ-gold-bg, rgba(245, 158, 11, 0.1));
    border: 1px solid rgba(245, 158, 11, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--univ-gold, #f59e0b);
    flex-shrink: 0;
  }

  .univ-research__metrics {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .univ-research__metric-tag {
    font-size: 0.6875rem;
    background: var(--univ-bg-surface, #101b38);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: var(--univ-text-muted, #94a3b8);
    font-weight: 600;
  }

  .univ-research__metric-tag--gold {
    color: var(--univ-gold, #f59e0b);
    background: var(--univ-gold-bg, rgba(245, 158, 11, 0.1));
  }

  .univ-research__card-title {
    font-family: var(--univ-font-serif, serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }

  .univ-research__director {
    font-size: 0.8125rem;
    color: var(--univ-text-dim, #64748b);
    margin: 0 0 1rem;
    line-height: 1.4;
  }

  .univ-research__desc {
    font-size: 0.875rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .univ-research__projects {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--univ-border-subtle, #182548);
    margin-bottom: 1.5rem;
  }

  .univ-research__projects-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--univ-text-dim, #64748b);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .univ-research__projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .univ-research__projects-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.4;
  }

  .univ-research__dot {
    color: var(--univ-gold, #f59e0b);
    margin-top: 4px;
    flex-shrink: 0;
  }

  .univ-research__btn-phd {
    color: var(--univ-gold, #f59e0b);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    display: inline-block;
  }

  .univ-research__btn-phd:hover {
    text-decoration: underline;
  }

  /* Collab Banner */
  .univ-research__collab-banner {
    background: linear-gradient(135deg, #0d162d 0%, #16244a 100%);
    border: 1px solid var(--univ-gold, #f59e0b);
    border-radius: var(--univ-radius, 12px);
    padding: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .univ-research__collab-title {
    font-family: var(--univ-font-serif, serif);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    margin: 0 0 0.5rem;
  }

  .univ-research__collab-desc {
    font-size: 0.9375rem;
    color: var(--univ-text-muted, #94a3b8);
    margin: 0;
    max-width: 680px;
    line-height: 1.6;
  }

  .univ-research__btn-collab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--univ-gold, #f59e0b);
    color: #070c1a;
    font-weight: 700;
    font-size: 0.9375rem;
    border-radius: var(--univ-radius-sm, 6px);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .univ-research__btn-collab:hover {
    background: var(--univ-gold-hover, #fbbf24);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .univ-research__kpis-strip {
      grid-template-columns: repeat(2, 1fr);
    }

    .univ-research__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .univ-research__kpis-strip {
      grid-template-columns: 1fr;
    }
  }
</style>

