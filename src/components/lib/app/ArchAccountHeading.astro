---
/**
 * ArchAccountHeading — Page heading for the members area: kicker, large serif title, description,
 * optional back link and a slot for action buttons.
 *
 * Thin wrapper over the shared `AccountHeading`: it only chooses this template's copy and typography.
 *
 * @param {string} title - Page title (the page's <h1>).
 * @param {string} kicker - Small label above the title.
 * @param {string} description - Supporting text.
 * @param {string} backHref - Optional "back" link.
 * @param {string} backLabel - Text of the back link.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: renders the page <h1>; the back link has visible text and a 44px target.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/architecture/arch-theme.css';
import AccountHeading from './AccountHeading.astro';

interface OwnProps {
  title: string;
  kicker?: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'header'>, keyof OwnProps | 'class'> & { class?: string };

const { title, kicker = '', description = '', backHref = '', backLabel = 'Volver', ...rest } = Astro.props;
---

<AccountHeading
  themeClass="arch-ui"
  tokenPrefix="ar"
  title={title}
  kicker={kicker}
  description={description}
  backHref={backHref}
  backLabel={backLabel}
  titleWeight={900}
  titleStretch="75%"
  titleSpacing="0.12em"
  titleTransform="uppercase"
  {...rest}
>
  <slot />
</AccountHeading>
