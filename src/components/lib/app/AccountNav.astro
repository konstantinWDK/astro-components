---
/**
 * AccountNav — Shared navigation of a template's customer area: wordmark plus text tabs in a header row
 * on desktop, and a fixed bottom tab bar on phones. Text only (no icons), no JavaScript. The per-template
 * wrappers (`FishAccountNav`, `WineMemberNav`, ...) only choose the copy and the wordmark typography.
 *
 * Theming: pass the template's root class (`themeClass`) and token prefix (`tokenPrefix`); the component
 * reads `--{prefix}-accent`, `-bg-raised`, `-border`, `-border-strong`, `-brand`, `-brand-rgb`, `-font-body`,
 * `-font-display`, `-on-brand`, `-text`, `-text-2` and `-text-3`, and the `{prefix}-sr` class.
 *
 * @param {string} themeClass - Root class that defines the template tokens (e.g. `fish-ui`).
 * @param {string} tokenPrefix - Token prefix of that theme (e.g. `fs`).
 * @param {Array<{label: string, href: string, badge?: string|number}>} items - Links (keep 3–5).
 * @param {string} currentHref - Marks the matching link with aria-current="page".
 * @param {string} brand - Wordmark (desktop only; phones show it in the top bar).
 * @param {string} ariaLabel - Accessible name of the <nav>.
 * @param {string} brandStyle - normal | italic.
 * @param {number} brandWeight - Wordmark font weight.
 * @param {string} brandStretch - Wordmark font-stretch (e.g. `75%`).
 * @param {string} brandTransform - Wordmark text-transform.
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: <nav> landmark with aria-label; aria-current on the active link; 56px tap targets
 * on the bottom bar; badges are announced as text.
 */
import type { HTMLAttributes } from 'astro/types';

interface Item { label: string; href: string; badge?: string | number }

interface OwnProps {
  themeClass: string;
  tokenPrefix: string;
  items?: Item[];
  currentHref?: string;
  brand?: string;
  homeHref?: string;
  ariaLabel?: string;
  brandStyle?: 'normal' | 'italic';
  brandWeight?: number;
  brandStretch?: string;
  brandTransform?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'nav'>, keyof OwnProps | 'class'> & { class?: string };

const {
  themeClass,
  tokenPrefix: p,
  items = [{ label: 'Resumen', href: '#' }],
  currentHref = '#',
  brand = '',
  homeHref = '#',
  ariaLabel = 'Área de cliente',
  brandStyle = 'normal',
  brandWeight = 400,
  brandStretch = '100%',
  brandTransform = 'none',
  class: classAttr,
  style,
  ...rest
} = Astro.props;
const tokens = ['accent', 'bg-raised', 'border', 'border-strong', 'brand', 'brand-rgb', 'font-body', 'font-display', 'on-brand', 'text', 'text-2', 'text-3']
  .map((token) => `--ac-${token}: var(--${p}-${token})`)
  .join('; ');
const rootStyle = `${tokens}; --ac-brand-style: ${brandStyle}; --ac-brand-weight: ${brandWeight}; --ac-brand-stretch: ${brandStretch}; --ac-brand-transform: ${brandTransform}${typeof style === 'string' && style ? `; ${style}` : ''}`;

const isCurrent = (href: string) => href.replace(/\/$/, '') === currentHref.replace(/\/$/, '');
---

<nav class:list={[themeClass, 'acct-nav', classAttr]} style={rootStyle} aria-label={ariaLabel} {...rest}>
  <a href={homeHref} class="acct-nav__brand">{brand}<small>Club</small></a>
  <ul class="acct-nav__list" role="list">
    {items.map((it) => (
      <li>
        <a href={it.href} class="acct-nav__link" aria-current={isCurrent(it.href) ? 'page' : undefined}>
          {it.label}
          {it.badge !== undefined && it.badge !== 0 && <span class="acct-nav__badge">{it.badge}<span class={`${p}-sr`}> pendientes</span></span>}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .acct-nav {
    display: flex;
    align-items: center;
    gap: var(--sp-8, 2rem);
    color: var(--ac-text);
    font-family: var(--ac-font-body);
  }

  .acct-nav__brand {
    display: none;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--ac-font-display);
    font-style: var(--ac-brand-style);
    font-weight: var(--ac-brand-weight);
    font-stretch: var(--ac-brand-stretch);
    text-transform: var(--ac-brand-transform);
    font-size: 1.7rem;
    color: var(--ac-text);
    text-decoration: none;
  }

  .acct-nav__brand small {
    font: 600 0.65rem/1 var(--ac-font-body);
    font-style: normal;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ac-accent);
  }

  .acct-nav__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .acct-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: var(--ac-text-3);
    font: 600 0.78rem/1 var(--ac-font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .acct-nav__link:hover {
    color: var(--ac-text);
  }

  .acct-nav__link[aria-current='page'] {
    color: var(--ac-text);
  }

  .acct-nav__link:focus-visible,
  .acct-nav__brand:focus-visible {
    outline: 2px solid var(--ac-brand);
    outline-offset: 2px;
  }

  .acct-nav__badge {
    min-width: 18px;
    padding: 0 5px;
    background: var(--ac-brand);
    color: var(--ac-on-brand);
    font-size: 0.68rem;
    line-height: 18px;
    letter-spacing: 0;
    text-align: center;
  }

  /* Phones: fixed bottom tab bar */
  @media (max-width: 759px) {
    .acct-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      background: var(--ac-bg-raised);
      border-top: 1px solid var(--ac-border-strong);
      padding-bottom: env(safe-area-inset-bottom, 0);
    }

    .acct-nav__list {
      flex: 1;
    }

    .acct-nav__list li {
      flex: 1;
    }

    .acct-nav__link {
      min-height: 60px;
      padding: 0 var(--sp-2, 0.5rem);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      border-top: 3px solid transparent;
    }

    .acct-nav__link[aria-current='page'] {
      border-top-color: var(--ac-brand);
      color: var(--ac-brand);
    }
  }

  @media (min-width: 760px) {
    .acct-nav__brand {
      display: inline-flex;
    }

    .acct-nav__list {
      gap: var(--sp-6, 1.5rem);
    }

    .acct-nav__link {
      min-height: 48px;
      border-bottom: 2px solid transparent;
    }

    .acct-nav__link[aria-current='page'] {
      border-bottom-color: var(--ac-brand);
    }
  }
</style>
