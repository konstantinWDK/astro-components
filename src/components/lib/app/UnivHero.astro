---
/**
 * UnivHero — Grand academic hero for university portal.
 * Features international prestige badge, distinguished serif typography, degree finder, campus KPIs and dual CTAs.
 *
 * @param {Record<string, string>} routes - Route map
 * @param {string} className - Optional additional CSS class
 */
import type { HTMLAttributes } from 'astro/types';
import { univRoutes, univKPIs } from '../templates/university/data';

interface Props extends HTMLAttributes<'section'> {
  routes?: typeof univRoutes;
  className?: string;
}

const {
  routes = univRoutes,
  class: classProp,
  className = '',
  ...rest
} = Astro.props;

const classes = ['univ-hero', classProp, className].filter(Boolean).join(' ');
---

<section class={classes} {...rest}>
  <!-- Background Glow & Grid Texture -->
  <div class="univ-hero__bg" aria-hidden="true">
    <div class="univ-hero__glow-gold"></div>
    <div class="univ-hero__glow-blue"></div>
    <div class="univ-hero__grid-pattern"></div>
  </div>

  <div class="univ-hero__container">
    <!-- Prestige Badge -->
    <div class="univ-hero__badge-wrap">
      <div class="univ-hero__badge">
        <span class="univ-hero__badge-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.45 1-1 1H7.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5h9c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5H15c-.55 0-1-.45-1-1v-2.34"/><path d="M18 4H6v7a6 6 0 0 0 12 0V4Z"/></svg>
        </span>
        <span>#1 en Empleabilidad y Salidas Profesionales · Ranking Forbes 2026</span>
      </div>
    </div>

    <!-- Main Title & Tagline -->
    <div class="univ-hero__content">
      <h1 class="univ-hero__title">
        La universidad donde la <span class="univ-hero__highlight">excelencia académica</span> transforma el mundo real
      </h1>
      <p class="univ-hero__lead">
        Formación universitaria oficial de vanguardia, profesorado investigador de prestigio internacional y conexión directa con las corporaciones líderes globales desde el primer curso.
      </p>

      <!-- Dual Primary CTAs -->
      <div class="univ-hero__ctas">
        <a href={routes.admissions} class="univ-hero__btn-primary">
          <span>Solicitar Admisión 2027</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={routes.campus} class="univ-hero__btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span>Jornadas de Puertas Abiertas</span>
        </a>
      </div>
    </div>

    <!-- Interactive Degree Finder Box -->
    <div class="univ-hero__finder-card" data-degree-finder>
      <div class="univ-hero__finder-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="univ-hero__finder-icon" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <div>
          <h2 class="univ-hero__finder-title">Buscador Oficial de Titulaciones</h2>
          <p class="univ-hero__finder-subtitle">Encuentra tu Grado, Máster Universitario o Doctorado</p>
        </div>
      </div>

      <form class="univ-hero__finder-form" action={routes.programs} method="GET">
        <div class="univ-hero__finder-field">
          <label for="hero-level-select" class="univ-hero__finder-label">Nivel Académico</label>
          <select id="hero-level-select" name="level" class="univ-hero__finder-select">
            <option value="all">Todos los niveles</option>
            <option value="grado">Grados Oficiales (4 años)</option>
            <option value="master">Másters Universitarios Oficiales</option>
            <option value="doctorado">Programas de Doctorado</option>
            <option value="executive">Executive & Diplomas</option>
          </select>
        </div>

        <div class="univ-hero__finder-field">
          <label for="hero-faculty-select" class="univ-hero__finder-label">Área de Conocimiento</label>
          <select id="hero-faculty-select" name="faculty" class="univ-hero__finder-select">
            <option value="all">Todas las facultades</option>
            <option value="tech">Ingeniería, IA & Tecnologías</option>
            <option value="business">Economía, Finanzas & ADE</option>
            <option value="health">Medicina & Biomedicina</option>
            <option value="humanities">Comunicación & Diseño</option>
          </select>
        </div>

        <div class="univ-hero__finder-action">
          <button type="submit" class="univ-hero__finder-submit">
            <span>Ver Programas</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Live Campus KPIs -->
    <div class="univ-hero__kpis">
      {univKPIs.map((kpi) => (
        <div class="univ-hero__kpi-card">
          <div class="univ-hero__kpi-val">{kpi.value}</div>
          <div class="univ-hero__kpi-label">{kpi.label}</div>
          <div class="univ-hero__kpi-sub">{kpi.subtext}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .univ-hero {
    position: relative;
    padding: 5rem 0 4rem;
    overflow: hidden;
    background: var(--univ-bg, #070c1a);
  }

  .univ-hero__container {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Background Glows */
  .univ-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .univ-hero__glow-gold {
    position: absolute;
    top: -150px;
    right: 10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.12) 0%, rgba(245, 158, 11, 0) 70%);
    filter: blur(40px);
  }

  .univ-hero__glow-blue {
    position: absolute;
    top: 50px;
    left: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, rgba(59, 130, 246, 0) 70%);
    filter: blur(50px);
  }

  .univ-hero__grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(30, 47, 93, 0.25) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(30, 47, 93, 0.25) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 80%);
  }

  /* Prestige Badge */
  .univ-hero__badge-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .univ-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4rem 1rem;
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius-full, 9999px);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--univ-gold, #f59e0b);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
  }

  .univ-hero__badge-icon {
    display: inline-flex;
    align-items: center;
    color: var(--univ-gold, #f59e0b);
  }

  /* Content */
  .univ-hero__content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 3rem;
  }

  .univ-hero__title {
    font-family: var(--univ-font-serif, serif);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--univ-text, #f8fafc);
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
  }

  .univ-hero__highlight {
    background: linear-gradient(135deg, var(--univ-gold, #f59e0b) 0%, #fbbf24 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .univ-hero__lead {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: var(--univ-text-muted, #94a3b8);
    max-width: 760px;
    margin: 0 auto 2.25rem;
  }

  /* CTAs */
  .univ-hero__ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .univ-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    background: linear-gradient(135deg, var(--univ-gold, #f59e0b) 0%, #d97706 100%);
    color: #070c1a;
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--univ-radius-sm, 6px);
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .univ-hero__btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(245, 158, 11, 0.5);
  }

  .univ-hero__btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.5rem;
    background: var(--univ-bg-card, #0d162d);
    color: var(--univ-text, #f8fafc);
    border: 1px solid var(--univ-border, #1e2f5d);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: var(--univ-radius-sm, 6px);
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .univ-hero__btn-secondary:hover {
    background: var(--univ-bg-card-hover, #142042);
    border-color: var(--univ-gold, #f59e0b);
  }

  /* Degree Finder Card */
  .univ-hero__finder-card {
    max-width: 980px;
    margin: 0 auto 4rem;
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius, 12px);
    padding: 1.75rem 2rem;
    box-shadow: var(--univ-shadow, 0 10px 30px -10px rgba(0, 0, 0, 0.6));
  }

  .univ-hero__finder-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--univ-border-subtle, #182548);
  }

  .univ-hero__finder-icon {
    color: var(--univ-gold, #f59e0b);
    flex-shrink: 0;
  }

  .univ-hero__finder-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    margin: 0;
  }

  .univ-hero__finder-subtitle {
    font-size: 0.8125rem;
    color: var(--univ-text-muted, #94a3b8);
    margin: 0.15rem 0 0;
  }

  .univ-hero__finder-form {
    display: grid;
    grid-template-columns: 1.2fr 1.2fr 1fr;
    gap: 1.25rem;
    align-items: flex-end;
  }

  .univ-hero__finder-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .univ-hero__finder-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--univ-text-muted, #94a3b8);
  }

  .univ-hero__finder-select {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--univ-bg-surface, #101b38);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius-sm, 6px);
    color: var(--univ-text, #f8fafc);
    font-size: 0.875rem;
    outline: none;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .univ-hero__finder-select:focus {
    border-color: var(--univ-gold, #f59e0b);
  }

  .univ-hero__finder-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    height: 44px;
    background: var(--univ-gold, #f59e0b);
    color: #070c1a;
    font-weight: 700;
    font-size: 0.9375rem;
    border: none;
    border-radius: var(--univ-radius-sm, 6px);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .univ-hero__finder-submit:hover {
    background: var(--univ-gold-hover, #fbbf24);
    transform: translateY(-1px);
  }

  /* KPIs */
  .univ-hero__kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .univ-hero__kpi-card {
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border-subtle, #182548);
    border-radius: var(--univ-radius, 12px);
    padding: 1.5rem;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .univ-hero__kpi-card:hover {
    transform: translateY(-3px);
    border-color: var(--univ-gold, #f59e0b);
  }

  .univ-hero__kpi-val {
    font-family: var(--univ-font-serif, serif);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--univ-gold, #f59e0b);
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .univ-hero__kpi-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    margin-bottom: 0.25rem;
  }

  .univ-hero__kpi-sub {
    font-size: 0.75rem;
    color: var(--univ-text-dim, #64748b);
    line-height: 1.4;
  }

  @media (max-width: 960px) {
    .univ-hero__finder-form {
      grid-template-columns: 1fr;
    }

    .univ-hero__kpis {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .univ-hero {
      padding: 3rem 0;
    }

    .univ-hero__kpis {
      grid-template-columns: 1fr;
    }
  }
</style>
