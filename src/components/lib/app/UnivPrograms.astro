---
/**
 * UnivPrograms — Academic program directory with level tabs, faculty filter chips, instant search and detail cards.
 *
 * @param {Record<string, string>} routes - Route map
 * @param {string} initialLevel - Initial degree level tab
 * @param {string} className - Optional additional CSS class
 */
import type { HTMLAttributes } from 'astro/types';
import { univPrograms, univFaculties, univRoutes } from '../templates/university/data';

interface Props extends HTMLAttributes<'section'> {
  routes?: typeof univRoutes;
  initialLevel?: string;
  className?: string;
}

const {
  routes = univRoutes,
  initialLevel = 'all',
  class: classProp,
  className = '',
  ...rest
} = Astro.props;

const classes = ['univ-programs', classProp, className].filter(Boolean).join(' ');

const levelTabs = [
  { id: 'all', label: 'Todos los Programas' },
  { id: 'grado', label: 'Grados Oficiales' },
  { id: 'master', label: 'Másters Oficiales' },
  { id: 'doctorado', label: 'Doctorado' },
  { id: 'executive', label: 'Executive' },
];
---

<section class={classes} id="programas-catalogo" data-programs-root {...rest}>
  <div class="univ-programs__container">
    <!-- Header -->
    <div class="univ-programs__header">
      <div class="univ-programs__eyebrow">OFERTA ACADÉMICA OFICIAL 2026 / 2027</div>
      <h2 class="univ-programs__title">Titulaciones con Máximo Reconocimiento Internacional</h2>
      <p class="univ-programs__lead">
        Planes de estudio acreditados por la ANECA, adaptados al Espacio Europeo de Educación Superior (EEES) y con metodologías eminentemente prácticas.
      </p>
    </div>

    <!-- Controls Bar -->
    <div class="univ-programs__controls">
      <!-- Level Tabs -->
      <div class="univ-programs__tabs" role="tablist" aria-label="Niveles de titulación">
        {levelTabs.map((tab) => (
          <button
            type="button"
            role="tab"
            class:list={['univ-programs__tab', { 'univ-programs__tab--active': tab.id === 'all' }]}
            data-level-tab={tab.id}
            aria-selected={tab.id === 'all' ? 'true' : 'false'}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Search Box -->
      <div class="univ-programs__search-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="univ-programs__search-icon">
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="univ-program-search"
          placeholder="Buscar por titulación o salida laboral..."
          class="univ-programs__search-input"
          aria-label="Buscar programas académicos"
        />
      </div>
    </div>

    <!-- Faculty Filter Chips -->
    <div class="univ-programs__faculties">
      <span class="univ-programs__faculties-label">Filtrar por Área:</span>
      <div class="univ-programs__chips">
        {univFaculties.map((f) => (
          <button
            type="button"
            class:list={['univ-programs__chip', { 'univ-programs__chip--active': f.id === 'all' }]}
            data-faculty-chip={f.id}
          >
            {f.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Programs Grid -->
    <div class="univ-programs__grid" id="univ-programs-list">
      {univPrograms.map((prog) => (
        <article
          class="univ-programs__card"
          data-program-id={prog.id}
          data-level={prog.level}
          data-faculty={prog.facultyId}
        >
          <div class="univ-programs__card-header">
            <span class="univ-programs__badge">{prog.levelLabel}</span>
            <span class="univ-programs__modality">{prog.modality}</span>
          </div>

          <h3 class="univ-programs__card-title">{prog.title}</h3>
          <p class="univ-programs__faculty">{prog.faculty}</p>

          <p class="univ-programs__highlight">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="univ-programs__star" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span>{prog.highlight}</span>
          </p>

          <div class="univ-programs__specs">
            <div class="univ-programs__spec">
              <span class="univ-programs__spec-label">Duración</span>
              <span class="univ-programs__spec-val">{prog.duration}</span>
            </div>
            <div class="univ-programs__spec">
              <span class="univ-programs__spec-label">Idioma</span>
              <span class="univ-programs__spec-val">{prog.language}</span>
            </div>
            <div class="univ-programs__spec">
              <span class="univ-programs__spec-label">Matrícula anual</span>
              <span class="univ-programs__spec-val univ-programs__spec-val--gold">{prog.tuitionYear.toLocaleString('es-ES')} €</span>
            </div>
          </div>

          <!-- Career Outlets -->
          <div class="univ-programs__outlets">
            <span class="univ-programs__outlets-label">Salidas profesionales:</span>
            <div class="univ-programs__tags">
              {prog.careerOutlets.map((outlet) => (
                <span class="univ-programs__tag">{outlet}</span>
              ))}
            </div>
          </div>

          <div class="univ-programs__card-footer">
            <a href={routes.admissions} class="univ-programs__btn-info">
              <span>Solicitar Plan Docente</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div class="univ-programs__empty" id="univ-programs-empty" hidden>
      <p class="univ-programs__empty-title">No se han encontrado titulaciones con estos criterios</p>
      <p class="univ-programs__empty-desc">Prueba a seleccionar «Todos los Programas» o limpia el campo de búsqueda.</p>
    </div>
  </div>
</section>

<script>
  // Interactive Filtering by level, faculty and search term
  const root = document.querySelector<HTMLElement>('[data-programs-root]');
  if (root) {
    const container = root;
    const levelTabs = container.querySelectorAll<HTMLButtonElement>('[data-level-tab]');
    const facultyChips = container.querySelectorAll<HTMLButtonElement>('[data-faculty-chip]');
    const searchInput = container.querySelector<HTMLInputElement>('#univ-program-search');
    const cards = container.querySelectorAll<HTMLElement>('.univ-programs__card');
    const emptyState = container.querySelector<HTMLElement>('#univ-programs-empty');

    let currentLevel = 'all';
    let currentFaculty = 'all';
    let searchQuery = '';

    // Check URL params if present (from hero finder)
    const urlParams = new URLSearchParams(window.location.search);
    const paramLevel = urlParams.get('level');
    const paramFaculty = urlParams.get('faculty');
    if (paramLevel && paramLevel !== 'all') {
      currentLevel = paramLevel;
      levelTabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-level-tab') === currentLevel;
        tab.classList.toggle('univ-programs__tab--active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
      });
    }
    if (paramFaculty && paramFaculty !== 'all') {
      currentFaculty = paramFaculty;
      facultyChips.forEach((chip) => {
        const isActive = chip.getAttribute('data-faculty-chip') === currentFaculty;
        chip.classList.toggle('univ-programs__chip--active', isActive);
      });
    }

    function filterCards() {
      let visibleCount = 0;
      const query = searchQuery.trim().toLowerCase();

      cards.forEach((card) => {
        const cardLevel = card.getAttribute('data-level') || '';
        const cardFaculty = card.getAttribute('data-faculty') || '';
        const cardText = card.textContent?.toLowerCase() || '';

        const matchLevel = currentLevel === 'all' || cardLevel === currentLevel;
        const matchFaculty = currentFaculty === 'all' || cardFaculty === currentFaculty;
        const matchQuery = !query || cardText.includes(query);

        if (matchLevel && matchFaculty && matchQuery) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', '');
        }
      }
    }

    // Level tabs click
    levelTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        levelTabs.forEach((t) => {
          t.classList.remove('univ-programs__tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('univ-programs__tab--active');
        tab.setAttribute('aria-selected', 'true');
        currentLevel = tab.getAttribute('data-level-tab') || 'all';
        filterCards();
      });
    });

    // Faculty chips click
    facultyChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        facultyChips.forEach((c) => c.classList.remove('univ-programs__chip--active'));
        chip.classList.add('univ-programs__chip--active');
        currentFaculty = chip.getAttribute('data-faculty-chip') || 'all';
        filterCards();
      });
    });

    // Search input
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        filterCards();
      });
    }

    // Run initial filter
    filterCards();
  }
</script>

<style>
  .univ-programs {
    padding: 5rem 0;
    background: var(--univ-bg, #070c1a);
  }

  .univ-programs__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .univ-programs__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
  }

  .univ-programs__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--univ-gold, #f59e0b);
    margin-bottom: 0.75rem;
  }

  .univ-programs__title {
    font-family: var(--univ-font-serif, serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .univ-programs__lead {
    font-size: 1.0625rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
  }

  /* Controls */
  .univ-programs__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .univ-programs__tabs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--univ-bg-card, #0d162d);
    padding: 0.35rem;
    border-radius: var(--univ-radius-sm, 6px);
    border: 1px solid var(--univ-border, #1e2f5d);
    overflow-x: auto;
  }

  .univ-programs__tab {
    background: transparent;
    border: none;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--univ-text-muted, #94a3b8);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .univ-programs__tab:hover {
    color: var(--univ-text, #f8fafc);
  }

  .univ-programs__tab--active {
    background: var(--univ-gold, #f59e0b);
    color: #070c1a;
  }

  /* Search */
  .univ-programs__search-wrap {
    position: relative;
    min-width: 300px;
    flex: 1;
    max-width: 400px;
  }

  .univ-programs__search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--univ-text-dim, #64748b);
    pointer-events: none;
  }

  .univ-programs__search-input {
    width: 100%;
    padding: 0.625rem 1rem 0.625rem 2.625rem;
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius-sm, 6px);
    color: var(--univ-text, #f8fafc);
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .univ-programs__search-input:focus {
    border-color: var(--univ-gold, #f59e0b);
  }

  /* Faculty chips */
  .univ-programs__faculties {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .univ-programs__faculties-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--univ-text-dim, #64748b);
  }

  .univ-programs__chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .univ-programs__chip {
    background: var(--univ-bg-surface, #101b38);
    border: 1px solid var(--univ-border-subtle, #182548);
    padding: 0.35rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--univ-text-muted, #94a3b8);
    border-radius: var(--univ-radius-full, 9999px);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .univ-programs__chip:hover {
    color: var(--univ-text, #f8fafc);
    border-color: var(--univ-border, #1e2f5d);
  }

  .univ-programs__chip--active {
    background: var(--univ-gold-bg, rgba(245, 158, 11, 0.1));
    border-color: var(--univ-gold, #f59e0b);
    color: var(--univ-gold, #f59e0b);
    font-weight: 600;
  }

  /* Grid & Cards */
  .univ-programs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .univ-programs__card {
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius, 12px);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .univ-programs__card:hover {
    transform: translateY(-4px);
    border-color: var(--univ-gold, #f59e0b);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .univ-programs__card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .univ-programs__badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    background: var(--univ-gold-bg, rgba(245, 158, 11, 0.1));
    color: var(--univ-gold, #f59e0b);
    border-radius: 4px;
    border: 1px solid rgba(245, 158, 11, 0.2);
  }

  .univ-programs__modality {
    font-size: 0.75rem;
    color: var(--univ-text-dim, #64748b);
    font-weight: 500;
  }

  .univ-programs__card-title {
    font-family: var(--univ-font-serif, serif);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--univ-text, #f8fafc);
    margin: 0 0 0.5rem;
  }

  .univ-programs__faculty {
    font-size: 0.8125rem;
    color: var(--univ-text-dim, #64748b);
    margin: 0 0 1rem;
  }

  .univ-programs__highlight {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--univ-text-muted, #94a3b8);
    background: var(--univ-bg-surface, #101b38);
    padding: 0.75rem;
    border-radius: 6px;
    margin: 0 0 1.25rem;
  }

  .univ-programs__star {
    color: var(--univ-gold, #f59e0b);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .univ-programs__specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--univ-border-subtle, #182548);
    border-bottom: 1px solid var(--univ-border-subtle, #182548);
    margin-bottom: 1.25rem;
  }

  .univ-programs__spec {
    display: flex;
    flex-direction: column;
  }

  .univ-programs__spec-label {
    font-size: 0.6875rem;
    color: var(--univ-text-dim, #64748b);
  }

  .univ-programs__spec-val {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--univ-text, #f8fafc);
  }

  .univ-programs__spec-val--gold {
    color: var(--univ-gold, #f59e0b);
  }

  .univ-programs__outlets {
    margin-bottom: 1.5rem;
  }

  .univ-programs__outlets-label {
    display: block;
    font-size: 0.6875rem;
    color: var(--univ-text-dim, #64748b);
    margin-bottom: 0.35rem;
  }

  .univ-programs__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .univ-programs__tag {
    font-size: 0.6875rem;
    background: var(--univ-bg-surface, #101b38);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    color: var(--univ-text-muted, #94a3b8);
  }

  .univ-programs__card-footer {
    margin-top: auto;
  }

  .univ-programs__btn-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.6875rem 1rem;
    background: transparent;
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius-sm, 6px);
    color: var(--univ-text, #f8fafc);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .univ-programs__btn-info:hover {
    background: var(--univ-gold, #f59e0b);
    border-color: var(--univ-gold, #f59e0b);
    color: #070c1a;
  }

  /* Empty */
  .univ-programs__empty {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--univ-bg-card, #0d162d);
    border: 1px dashed var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius, 12px);
    margin-top: 2rem;
  }

  .univ-programs__empty-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    margin: 0 0 0.5rem;
  }

  .univ-programs__empty-desc {
    font-size: 0.875rem;
    color: var(--univ-text-muted, #94a3b8);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .univ-programs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .univ-programs__grid {
      grid-template-columns: 1fr;
    }

    .univ-programs__controls {
      flex-direction: column;
      align-items: stretch;
    }

    .univ-programs__search-wrap {
      max-width: 100%;
    }
  }
</style>
