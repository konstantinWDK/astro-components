---
/**
 * ArchSignIn — Split sign-in for the client area: a large generated elevation drawing with a client quote on one side, the form (email, password with show/hide, remember me) on the other, plus a demo quick-access link and a link to join the club.
 *
 * Thin wrapper over the shared `AccountSignIn` split layout: it only picks this template's
 * illustration, copy and typography.
 *
 * @param {string} dashboardHref - Where a successful sign-in goes.
 * @param {string} joinHref - Link to the club page.
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} action - Backend endpoint. Empty runs a demo sign-in that redirects.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: see `AccountSignIn` (labelled fields, password toggle with aria-pressed, errors in
 * role="alert", visible focus rings and 48px controls; the illustration is decorative).
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/architecture/arch-theme.css';
import ArchElevation from './ArchElevation.astro';
import { archWork } from '../templates/architecture/data';
import AccountSignIn from './AccountSignIn.astro';

interface OwnProps {
  dashboardHref?: string;
  joinHref?: string;
  homeHref?: string;
  action?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const { dashboardHref = '/obra', joinHref = '/presupuesto', homeHref = '/', action = '', ...rest } = Astro.props;
const work = archWork;
---

<AccountSignIn
  themeClass="arch-ui"
  tokenPrefix="ar"
  brand="Cota"
  quote="Cada viernes leemos el diario de obra antes de que nadie nos llame. Sabemos qué se ha hecho, qué se ha pagado y qué toca decidir."
  author="Inés Roldán · promotora de Casa en el Pinar"
  eyebrow="Mi obra"
  heading="Bienvenidos de nuevo"
  joinPrompt="¿Quieres construir?"
  joinLabel="Pide un estudio previo"
  homeHref={homeHref}
  dashboardHref={dashboardHref}
  joinHref={joinHref}
  action={action}
  brandWeight={900}
  brandStretch="75%"
  brandTransform="uppercase"
  quoteWeight={600}
  {...rest}
>
  <Fragment slot="art"><ArchElevation seed={work.seed} floors={work.floors} bays={work.bays} roof={work.roof} decorative /></Fragment>
</AccountSignIn>
