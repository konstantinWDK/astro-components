---
/**
 * UnivFooter — Distinguished university footer with accreditation seals, department directories, newsletter and legal compliance.
 *
 * @param {Record<string, string>} routes - Route map for navigation
 * @param {string} className - Optional additional CSS class
 */
import type { HTMLAttributes } from 'astro/types';
import { univRoutes, univBrand } from '../templates/university/data';

interface Props extends HTMLAttributes<'footer'> {
  routes?: typeof univRoutes;
  className?: string;
}

const {
  routes = univRoutes,
  class: classProp,
  className = '',
  ...rest
} = Astro.props;

const classes = ['univ-footer', classProp, className].filter(Boolean).join(' ');
---

<footer class={classes} {...rest}>
  <!-- Accreditations & Quality Seals Band -->
  <div class="univ-footer__accreditations">
    <div class="univ-footer__container">
      <div class="univ-footer__seals-wrap">
        <span class="univ-footer__seals-label">ACREDITACIONES Y RECONOCIMIENTOS DE CALIDAD:</span>
        <div class="univ-footer__seals-list">
          <span class="univ-footer__seal" title="Agencia Nacional de Evaluación de la Calidad y Acreditación">ANECA Institucional</span>
          <span class="univ-footer__seal" title="European Quality Improvement System">EQUIS Accredited</span>
          <span class="univ-footer__seal" title="Accreditation Board for Engineering and Technology">ABET Engineering</span>
          <span class="univ-footer__seal" title="Ranking Forbes Universidades">#1 Forbes Empleabilidad</span>
          <span class="univ-footer__seal" title="European University Association">EUA Member</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Links Grid -->
  <div class="univ-footer__main">
    <div class="univ-footer__container univ-footer__grid">
      <!-- Col 1: University Identity -->
      <div class="univ-footer__col-brand">
        <div class="univ-footer__brand-header">
          <div class="univ-footer__crest" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
              <rect width="40" height="40" rx="8" fill="#101b38" stroke="#f59e0b" stroke-width="1.5"/>
              <path d="M20 7L31 13V22C31 28.5 26.2 33.5 20 35C13.8 33.5 9 28.5 9 22V13L20 7Z" fill="rgba(245, 158, 11, 0.15)" stroke="#f59e0b" stroke-width="1.5"/>
              <path d="M20 12L25 18H15L20 12Z" fill="#f59e0b"/>
            </svg>
          </div>
          <div>
            <h3 class="univ-footer__name">UNIVERSIDAD VERITAS</h3>
            <p class="univ-footer__motto">«{univBrand.motto}»</p>
          </div>
        </div>
        <p class="univ-footer__bio">
          Fundada en {univBrand.founded}, la Universidad Veritas lidera la formación superior internacional, la investigación puntera en IA y biomedicina, y el compromiso con la excelencia ética.
        </p>
        <div class="univ-footer__meta">
          <p>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {univBrand.location}
          </p>
          <p>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Tel: <a href={`tel:${univBrand.admissionsPhone}`}>{univBrand.admissionsPhone}</a>
          </p>
          <p>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href={`mailto:${univBrand.admissionsEmail}`}>{univBrand.admissionsEmail}</a>
          </p>
        </div>
      </div>

      <!-- Col 2: Academic Programs -->
      <div class="univ-footer__col">
        <h4 class="univ-footer__col-title">Estudios Oficiales</h4>
        <ul class="univ-footer__links">
          <li><a href={routes.programs}>Grados Oficiales (4 años)</a></li>
          <li><a href={routes.programs}>Másters Universitarios</a></li>
          <li><a href={routes.programs}>Escuela de Doctorado</a></li>
          <li><a href={routes.programs}>Executive Education & Diplomas</a></li>
          <li><a href={routes.programs}>Dobles Grados Internacionales</a></li>
          <li><a href={routes.programs}>Cursos de Verano & Idiomas</a></li>
        </ul>
      </div>

      <!-- Col 3: Admissions & Campus -->
      <div class="univ-footer__col">
        <h4 class="univ-footer__col-title">Admisión & Campus</h4>
        <ul class="univ-footer__links">
          <li><a href={routes.admissions}>Proceso de Admisión</a></li>
          <li><a href={routes.admissions}>Calculadora de Becas al Mérito</a></li>
          <li><a href={routes.admissions}>Calendario de Convocatorias</a></li>
          <li><a href={routes.campus}>Colegio Mayor & Residencias</a></li>
          <li><a href={routes.campus}>Biblioteca Central 24h</a></li>
          <li><a href={routes.campus}>Jornadas de Puertas Abiertas</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter & Academic Bulletin -->
      <div class="univ-footer__col">
        <h4 class="univ-footer__col-title">Boletín Veritas</h4>
        <p class="univ-footer__news-text">
          Recibe convocatorias de admisiones, alertas de becas, papers científicos destacados y agenda cultural del campus.
        </p>
        <form
          class="univ-footer__form"
          id="univ-news-form"
          onsubmit="event.preventDefault(); document.getElementById('univ-news-success')?.removeAttribute('hidden'); this.reset();"
        >
          <div class="univ-footer__input-wrap">
            <input
              type="email"
              placeholder="tu.email@ejemplo.com"
              required
              class="univ-footer__input"
              aria-label="Correo electrónico para boletín universitario"
            />
            <button type="submit" class="univ-footer__btn" aria-label="Suscribirse">
              &rarr;
            </button>
          </div>
          <div class="univ-footer__success" id="univ-news-success" hidden role="status">
            ✓ ¡Gracias! Te has suscrito a las alertas académicas.
          </div>
        </form>

        <div class="univ-footer__socials">
          <span class="univ-footer__social-label">Síguenos:</span>
          <div class="univ-footer__social-icons">
            <a href="#" aria-label="LinkedIn Universidad Veritas" class="univ-footer__social-link">in</a>
            <a href="#" aria-label="X / Twitter Universidad Veritas" class="univ-footer__social-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
            <a href="#" aria-label="YouTube Universidad Veritas" class="univ-footer__social-link">yt</a>
            <a href="#" aria-label="Instagram Universidad Veritas" class="univ-footer__social-link">ig</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="univ-footer__bottom">
    <div class="univ-footer__container univ-footer__bottom-inner">
      <p class="univ-footer__copy">
        &copy; {new Date().getFullYear()} Universidad Veritas. Todos los derechos reservados. Titularidad autorizada por el Ministerio de Universidades.
      </p>
      <div class="univ-footer__legal-links">
        <a href="#">Portal de Transparencia</a>
        <a href="#">Aviso Legal</a>
        <a href="#">Privacidad & Cookies</a>
        <a href="#">Accesibilidad AA</a>
        <a href="#">Canal Ético</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .univ-footer {
    background-color: var(--univ-navy-deep, #0a0f1d);
    color: var(--univ-text, #f8fafc);
    border-top: 1px solid var(--univ-border, #1e2f5d);
    font-size: 0.875rem;
  }

  .univ-footer__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Accreditations Strip */
  .univ-footer__accreditations {
    background: #060a14;
    border-bottom: 1px solid var(--univ-border-subtle, #182548);
    padding: 0.875rem 0;
  }

  .univ-footer__seals-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .univ-footer__seals-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--univ-text-dim, #64748b);
  }

  .univ-footer__seals-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .univ-footer__seal {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--univ-gold, #f59e0b);
  }

  /* Main Footer */
  .univ-footer__main {
    padding: 4rem 0 3rem;
  }

  .univ-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 3rem;
  }

  .univ-footer__brand-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1rem;
  }

  .univ-footer__name {
    font-family: var(--univ-font-serif, serif);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--univ-text, #f8fafc);
    margin: 0;
  }

  .univ-footer__motto {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--univ-gold, #f59e0b);
    margin: 0.15rem 0 0;
  }

  .univ-footer__bio {
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .univ-footer__meta {
    font-size: 0.8125rem;
    color: var(--univ-text-muted, #94a3b8);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .univ-footer__meta p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .univ-footer__meta svg {
    color: var(--univ-gold, #f59e0b);
    flex-shrink: 0;
  }

  .univ-footer__meta a {
    color: var(--univ-text, #f8fafc);
    text-decoration: none;
  }

  .univ-footer__meta a:hover {
    color: var(--univ-gold, #f59e0b);
  }

  /* Columns */
  .univ-footer__col-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    margin: 0 0 1.25rem 0;
    letter-spacing: 0.04em;
    border-bottom: 2px solid var(--univ-gold, #f59e0b);
    display: inline-block;
    padding-bottom: 0.35rem;
  }

  .univ-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .univ-footer__links a {
    color: var(--univ-text-muted, #94a3b8);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .univ-footer__links a:hover {
    color: var(--univ-gold, #f59e0b);
    transform: translateX(3px);
  }

  /* Newsletter Form */
  .univ-footer__news-text {
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.5;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
  }

  .univ-footer__input-wrap {
    display: flex;
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius-sm, 6px);
    overflow: hidden;
  }

  .univ-footer__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    color: var(--univ-text, #f8fafc);
    outline: none;
  }

  .univ-footer__btn {
    background: var(--univ-gold, #f59e0b);
    color: #0a0f1d;
    border: none;
    padding: 0 1rem;
    font-size: 1.125rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .univ-footer__btn:hover {
    background: var(--univ-gold-hover, #fbbf24);
  }

  .univ-footer__success {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: #10b981;
  }

  .univ-footer__socials {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .univ-footer__social-label {
    font-size: 0.75rem;
    color: var(--univ-text-dim, #64748b);
  }

  .univ-footer__social-icons {
    display: flex;
    gap: 0.5rem;
  }

  .univ-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: 4px;
    color: var(--univ-text-muted, #94a3b8);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .univ-footer__social-link:hover {
    color: var(--univ-gold, #f59e0b);
    border-color: var(--univ-gold, #f59e0b);
  }

  /* Bottom Strip */
  .univ-footer__bottom {
    border-top: 1px solid var(--univ-border-subtle, #182548);
    padding: 1.5rem 0;
    background: #050811;
    font-size: 0.75rem;
    color: var(--univ-text-dim, #64748b);
  }

  .univ-footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .univ-footer__copy {
    margin: 0;
  }

  .univ-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .univ-footer__legal-links a {
    color: var(--univ-text-dim, #64748b);
    text-decoration: none;
  }

  .univ-footer__legal-links a:hover {
    color: var(--univ-text, #f8fafc);
  }

  @media (max-width: 1024px) {
    .univ-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .univ-footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .univ-footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
