---
/**
 * AccountTopbar — Shared right side of a template's customer-area header: wordmark on phones, today's date,
 * a theme toggle, notifications and the user menu (native popovers). The per-template wrappers
 * (`FishAccountTopbar`, `WineMemberTopbar`, ...) only choose the copy, the demo user and the wordmark typography.
 *
 * Theming: pass the template's root class (`themeClass`) and token prefix (`tokenPrefix`); it reads
 * `--{prefix}-accent`, `-bg-raised`, `-border`, `-border-strong`, `-brand`, `-brand-rgb`, `-font-body`,
 * `-font-display`, `-on-brand`, `-text`, `-text-2` and `-text-3`.
 *
 * @param {string} themeClass - Root class that defines the template tokens (e.g. `fish-ui`).
 * @param {string} tokenPrefix - Token prefix of that theme (e.g. `fs`).
 * @param {{name: string, plan: string, id: string}} user - Signed-in user.
 * @param {Array<{title: string, text: string, time: string, unread?: boolean}>} notifications - Notification list.
 * @param {Array<{label: string, href: string}>} links - Entries of the user menu.
 * @param {string} signOutHref - Sign-out link.
 * @param {string} brand - Wordmark (phones only).
 * @param {string} brandStyle - normal | italic.
 * @param {number} brandWeight - Wordmark font weight.
 * @param {string} brandStretch - Wordmark font-stretch (e.g. `75%`).
 * @param {string} brandTransform - Wordmark text-transform.
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: popovers close with Escape and outside click (native); the bell announces the
 * unread count; the theme toggle reports aria-pressed; targets are 44px.
 */
import type { HTMLAttributes } from 'astro/types';

interface Note { title: string; text: string; time: string; unread?: boolean }

interface OwnProps {
  themeClass: string;
  tokenPrefix: string;
  user?: { name: string; plan: string; id: string };
  notifications?: Note[];
  links?: Array<{ label: string; href: string }>;
  signOutHref?: string;
  brand?: string;
  homeHref?: string;
  brandStyle?: 'normal' | 'italic';
  brandWeight?: number;
  brandStretch?: string;
  brandTransform?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'div'>, keyof OwnProps | 'class'> & { class?: string };

const {
  themeClass,
  tokenPrefix: p,
  user = { name: 'Invitado', plan: 'Cuenta de demostración', id: '0000' },
  notifications = [],
  links = [],
  signOutHref = '#',
  brand = '',
  homeHref = '#',
  brandStyle = 'normal',
  brandWeight = 400,
  brandStretch = '100%',
  brandTransform = 'none',
  class: classAttr,
  style,
  ...rest
} = Astro.props;
const tokens = ['accent', 'bg-raised', 'border', 'border-strong', 'brand', 'brand-rgb', 'font-body', 'font-display', 'on-brand', 'text', 'text-2', 'text-3']
  .map((token) => `--ac-${token}: var(--${p}-${token})`)
  .join('; ');
const rootStyle = `${tokens}; --ac-brand-style: ${brandStyle}; --ac-brand-weight: ${brandWeight}; --ac-brand-stretch: ${brandStretch}; --ac-brand-transform: ${brandTransform}${typeof style === 'string' && style ? `; ${style}` : ''}`;

const uid = `atb-${Math.random().toString(36).slice(2, 8)}`;
const unread = notifications.filter((n) => n.unread).length;
const initials = user.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---

<div class:list={[themeClass, 'acct-top', classAttr]} style={rootStyle} data-acct-top {...rest}>
  <a href={homeHref} class="acct-top__brand">{brand}</a>
  <time class="acct-top__date" data-today></time>

  <div class="acct-top__actions">
    <button type="button" class="acct-top__icon" aria-pressed="false" aria-label="Cambiar tema claro u oscuro" data-theme-toggle>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
    </button>

    <button type="button" class="acct-top__icon" popovertarget={`${uid}-notes`} aria-label={unread ? `Avisos, ${unread} sin leer` : 'Avisos'}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9a6 6 0 1 1 12 0c0 6 2 7 2 7H4s2-1 2-7M10 20a2 2 0 0 0 4 0" /></svg>
      {unread > 0 && <span class="acct-top__dot" aria-hidden="true"></span>}
    </button>
    <div id={`${uid}-notes`} popover class="acct-pop" data-acct-pop>
      <p class="acct-pop__title">Avisos</p>
      {notifications.length ? (
        <ul role="list">
          {notifications.map((n) => (
            <li class:list={[n.unread && 'is-unread']}>
              <strong>{n.title}</strong>
              <span>{n.text}</span>
              <small>{n.time}</small>
            </li>
          ))}
        </ul>
      ) : <p class="acct-pop__empty">Todo al día.</p>}
    </div>

    <button type="button" class="acct-top__me" popovertarget={`${uid}-me`} aria-label={`Menú de ${user.name}`}>
      <span class="acct-top__avatar" aria-hidden="true">{initials}</span>
      <span class="acct-top__who"><strong>{user.name}</strong><small>{user.plan}</small></span>
    </button>
    <div id={`${uid}-me`} popover class="acct-pop" data-acct-pop>
      <p class="acct-pop__title">{user.name}<small>Socia nº {user.id}</small></p>
      <ul role="list" class="acct-pop__menu">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={signOutHref}>Cerrar sesión</a></li>
      </ul>
    </div>
  </div>
</div>

<style>
  .acct-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4, 1rem);
    flex: 1;
    min-width: 0;
    color: var(--ac-text);
    font-family: var(--ac-font-body);
  }

  .acct-top__brand {
    font-family: var(--ac-font-display);
    font-style: var(--ac-brand-style);
    font-weight: var(--ac-brand-weight);
    font-stretch: var(--ac-brand-stretch);
    text-transform: var(--ac-brand-transform);
    font-size: 1.6rem;
    color: var(--ac-text);
    text-decoration: none;
  }

  .acct-top__date {
    display: none;
    margin-left: auto;
    font-size: 0.85rem;
    text-transform: capitalize;
    color: var(--ac-text-3);
  }

  .acct-top__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-1, 0.25rem);
  }

  .acct-top__icon,
  .acct-top__me {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2, 0.5rem);
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--sp-2, 0.5rem);
    justify-content: center;
    border: 0;
    background: none;
    color: var(--ac-text-2);
    font: inherit;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .acct-top__icon:hover,
  .acct-top__me:hover {
    color: var(--ac-text);
  }

  .acct-top__dot {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ac-accent);
  }

  .acct-top__avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--ac-brand);
    border-radius: 50%;
    font-family: var(--ac-font-display);
    font-size: 0.95rem;
    color: var(--ac-brand);
  }

  .acct-top__who {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
    text-align: left;
  }

  .acct-top__who strong {
    font-size: 0.88rem;
    color: var(--ac-text);
  }

  .acct-top__who small {
    font-size: 0.74rem;
    color: var(--ac-text-3);
  }

  .acct-pop {
    position: fixed;
    inset: auto;
    margin: 0;
    width: min(320px, calc(100vw - 16px));
    max-height: 70vh;
    overflow: auto;
    padding: var(--sp-3, 0.75rem);
    border: 1px solid var(--ac-border-strong);
    border-radius: 2px;
    background: var(--ac-bg-raised);
    color: var(--ac-text);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
  }

  .acct-pop__title {
    margin: 0 0 var(--sp-2, 0.5rem);
    font-family: var(--ac-font-display);
    font-size: 1.15rem;
  }

  .acct-pop__title small {
    display: block;
    font: 500 0.78rem var(--ac-font-body);
    color: var(--ac-text-3);
  }

  .acct-pop ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .acct-pop li:not(:last-child) {
    border-bottom: 1px solid var(--ac-border);
  }

  .acct-pop li > strong,
  .acct-pop li > span,
  .acct-pop li > small {
    display: block;
  }

  .acct-pop li:not(.acct-pop__menu li) {
    padding: var(--sp-2, 0.5rem) 0;
  }

  .acct-pop li.is-unread > strong::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--ac-accent);
  }

  .acct-pop li > span {
    font-size: 0.88rem;
    color: var(--ac-text-2);
  }

  .acct-pop li > small {
    font-size: 0.76rem;
    color: var(--ac-text-3);
  }

  .acct-pop__menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--sp-2, 0.5rem);
    color: var(--ac-text);
    text-decoration: none;
  }

  .acct-pop__menu a:hover {
    background: rgba(var(--ac-brand-rgb), 0.1);
  }

  .acct-pop__empty {
    margin: 0;
    color: var(--ac-text-3);
  }

  @media (min-width: 760px) {
    .acct-top__brand {
      display: none;
    }

    .acct-top__date {
      display: block;
    }

    .acct-top__who {
      display: flex;
    }
  }
</style>

<script>
  function initTop(root: HTMLElement) {
    if (root.dataset.bound) return;
    root.dataset.bound = 'true';
    const time = root.querySelector<HTMLTimeElement>('[data-today]');
    if (time) {
      const now = new Date();
      time.dateTime = now.toISOString().slice(0, 10);
      time.textContent = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long' }).format(now);
    }
    const toggle = root.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const sync = () => toggle?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'light'));
    sync();
    toggle?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('ack-theme', next); } catch (e) { /* storage unavailable */ }
      sync();
    });
    root.querySelectorAll<HTMLElement>('[data-acct-pop]').forEach((pop) => {
      pop.addEventListener('toggle', (e) => {
        if ((e as Event & { newState?: string }).newState !== 'open') return;
        const btn = root.querySelector<HTMLElement>(`[popovertarget="${pop.id}"]`);
        if (!btn) return;
        const r = btn.getBoundingClientRect();
        pop.style.top = `${r.bottom + 8}px`;
        pop.style.left = `${Math.max(8, Math.min(window.innerWidth - pop.offsetWidth - 8, r.right - pop.offsetWidth))}px`;
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-acct-top]').forEach(initTop);
</script>
