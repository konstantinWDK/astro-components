---
/**
 * RestSignIn — Split sign-in for the customer area: a large generated plate with a customer quote on one side, the form (email, password with show/hide, remember me) on the other, plus a demo quick-access link and a link to join the club.
 *
 * Thin wrapper over the shared `AccountSignIn` split layout: it only picks this template's
 * illustration, copy and typography.
 *
 * @param {string} dashboardHref - Where a successful sign-in goes.
 * @param {string} joinHref - Link to the club page.
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} action - Backend endpoint. Empty runs a demo sign-in that redirects.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: see `AccountSignIn` (labelled fields, password toggle with aria-pressed, errors in
 * role="alert", visible focus rings and 48px controls; the illustration is decorative).
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/restaurant/rest-theme.css';
import RestPlate from './RestPlate.astro';
import { restCourses } from '../templates/restaurant/data';
import AccountSignIn from './AccountSignIn.astro';

interface OwnProps {
  dashboardHref?: string;
  joinHref?: string;
  homeHref?: string;
  action?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const { dashboardHref = '/mesa', joinHref = '/reservar', homeHref = '/', action = '', ...rest } = Astro.props;
const course = restCourses[2];
---

<AccountSignIn
  themeClass="rest-ui"
  tokenPrefix="rs"
  brand="Lumbre"
  quote="Reservo siempre la misma mesa junto a la brasa y ya no tengo que repetir mis alergias. Cuando llego, saben que la yema curada es lo primero que quiero."
  author="Álex Beltrán · cliente desde 2024"
  eyebrow="Mi mesa"
  heading="Bienvenido de nuevo"
  joinPrompt="¿Primera vez?"
  joinLabel="Reserva tu mesa"
  homeHref={homeHref}
  dashboardHref={dashboardHref}
  joinHref={joinHref}
  action={action}
  brandStyle="italic"
  quoteStyle="italic"
  {...rest}
>
  <Fragment slot="art"><RestPlate course={course} decorative /></Fragment>
</AccountSignIn>
