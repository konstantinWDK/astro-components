---
/**
 * MotoArt — Product illustration drawn in SVG from an item's data: a motocross bike in side view
 * (wheels with spokes and knobby tyres, frame, fork, tank, seat, number plate, exhaust and swingarm), a
 * helmet with peak and goggles, a boot, a glove, a jersey or a spare part (air filter or chain kit).
 * Colours come from the item's palette and the number on the plate from its seed. No images needed.
 *
 * @param {MotoProduct} item - Product to draw (art kind, seed, palette, name).
 * @param {boolean} decorative - Hide from assistive tech (use when the name is next to it).
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: exposed as an image with the product name, or aria-hidden when decorative.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/motocross/moto-theme.css';
import { motoProducts, motoRng, type MotoProduct } from '../templates/motocross/data';

interface OwnProps {
  item?: MotoProduct;
  decorative?: boolean;
}

type Props = OwnProps & Omit<HTMLAttributes<'figure'>, keyof OwnProps | 'class'> & { class?: string };

const { item = motoProducts[0], decorative = false, class: classAttr, ...rest } = Astro.props;

const { kind, seed, palette } = item.art;
const [c1, c2, c3] = palette;
const rnd = motoRng(seed);
const uid = `ma-${item.id}-${Math.random().toString(36).slice(2, 6)}`;
const f = (n: number) => Math.round(n * 10) / 10;
const num = String(10 + Math.floor(rnd() * 89));
const spokes = Array.from({ length: 14 }, (_, i) => (i / 14) * Math.PI * 2);
const knobs = Array.from({ length: 24 }, (_, i) => (i / 24) * Math.PI * 2);
const big = Array.from({ length: 28 }, (_, i) => { const a = (i / 28) * Math.PI * 2; return { x: f(-52 + Math.cos(a) * 66), y: f(10 + Math.sin(a) * 66), r: f((a * 180) / Math.PI) }; });
const small = Array.from({ length: 13 }, (_, i) => { const a = (i / 13) * Math.PI * 2; return { x: f(66 + Math.cos(a) * 28), y: f(38 + Math.sin(a) * 28) }; });
const aria = decorative ? undefined : item.name;
const wheel = (cx: number, cy: number, r: number) => ({ cx, cy, r });
const wf = wheel(232, 206, 50);
const wr = wheel(66, 206, 50);
---

<figure class:list={['moto-ui', 'moto-art', classAttr]} {...rest}>
  <svg viewBox="0 0 300 300" role={decorative ? undefined : 'img'} aria-label={aria} aria-hidden={decorative ? 'true' : undefined} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id={`${uid}-bg`} cx="0.5" cy="0.6" r="0.7">
        <stop offset="0" stop-color={c1} stop-opacity="0.26"></stop>
        <stop offset="1" stop-color={c1} stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <rect width="300" height="300" fill={`url(#${uid}-bg)`}></rect>
    <polygon points="0,262 300,236 300,300 0,300" fill="#000" opacity="0.18"></polygon>

    {kind === 'bike' && (
      <g>
        <ellipse cx="150" cy="258" rx="126" ry="7" fill="#000" opacity="0.32"></ellipse>
        {[wr, wf].map((w) => (
          <g>
            <circle cx={w.cx} cy={w.cy} r={w.r} fill="none" stroke="#161616" stroke-width="9"></circle>
            {knobs.map((a) => (
              <line x1={f(w.cx + Math.cos(a) * (w.r + 2))} y1={f(w.cy + Math.sin(a) * (w.r + 2))} x2={f(w.cx + Math.cos(a) * (w.r + 9))} y2={f(w.cy + Math.sin(a) * (w.r + 9))} stroke="#161616" stroke-width="4.5" stroke-linecap="round"></line>
            ))}
            <circle cx={w.cx} cy={w.cy} r={w.r - 8} fill="none" stroke="#b9b4a8" stroke-width="3.5"></circle>
            {spokes.map((a) => (<line x1={w.cx} y1={w.cy} x2={f(w.cx + Math.cos(a) * (w.r - 8))} y2={f(w.cy + Math.sin(a) * (w.r - 8))} stroke="#8e8a80" stroke-width="0.9"></line>))}
            <circle cx={w.cx} cy={w.cy} r="7" fill={c2}></circle>
            <circle cx={w.cx} cy={w.cy} r="3" fill="#b9b4a8"></circle>
          </g>
        ))}
        <!-- swingarm, frame and engine -->
        <path d="M66 206 L 128 196 L 150 176" fill="none" stroke="#2a2a2a" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M88 150 L 142 118 L 190 124 L 168 178 L 128 196 Z" fill="#2b2b2b" stroke="#161616" stroke-width="2"></path>
        <rect x="118" y="150" width="52" height="40" rx="8" fill="#3c3c3c"></rect>
        <circle cx="140" cy="172" r="11" fill="#555"></circle>
        <!-- fork -->
        <path d="M188 112 L 226 200" fill="none" stroke="#c9c4b6" stroke-width="7" stroke-linecap="round"></path>
        <path d="M194 112 L 232 200" fill="none" stroke="#8e8a80" stroke-width="3" stroke-linecap="round"></path>
        <path d="M182 104 L 214 96" stroke="#161616" stroke-width="7" stroke-linecap="round"></path>
        <circle cx="216" cy="95" r="5" fill="#161616"></circle>
        <!-- tank, shrouds, seat -->
        <path d="M118 120 Q 150 92 192 112 L 184 140 Q 150 130 124 142 Z" fill={c1}></path>
        <path d="M94 138 Q 112 116 136 120 L 128 146 L 94 150 Z" fill={c1} opacity="0.92"></path>
        <path d="M60 138 Q 90 128 128 132 L 124 146 L 58 150 Z" fill="#161616"></path>
        <path d="M156 124 Q 176 118 190 128" fill="none" stroke={c3} stroke-width="3"></path>
        <!-- front fender, number plate, exhaust -->
        <path d="M208 142 Q 238 130 262 150 L 256 160 Q 232 150 212 156 Z" fill={c1}></path>
        <ellipse cx="206" cy="140" rx="17" ry="20" fill={c3} stroke="#161616" stroke-width="2.4" transform="rotate(-18 206 140)"></ellipse>
        <text x="206" y="146" text-anchor="middle" font-size="19" font-weight="800" font-family="Barlow Condensed, Impact, sans-serif" fill="#161616" transform="rotate(-18 206 140)">{num}</text>
        <path d="M126 190 Q 92 188 70 156 L 36 148" fill="none" stroke="#d9d2c0" stroke-width="9" stroke-linecap="round"></path>
        <rect x="30" y="142" width="24" height="12" rx="3" fill="#8e8a80" transform="rotate(-18 42 148)"></rect>
        <rect x="104" y="196" width="34" height="9" rx="3" fill="#161616"></rect>
      </g>
    )}

    {kind === 'helmet' && (
      <g transform="translate(150 150)">
        <ellipse cx="0" cy="104" rx="84" ry="9" fill="#000" opacity="0.3"></ellipse>
        <path d="M-88 22 C -88 -64 -34 -98 20 -92 C 62 -88 92 -56 94 -14 L 94 40 C 92 78 52 100 0 100 C -52 100 -88 76 -88 22 Z" fill={c1}></path>
        <path d="M-88 22 C -88 -64 -34 -98 20 -92" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="3"></path>
        <path d="M-90 -6 Q -134 -4 -150 -34 L -120 -46 Q -100 -30 -76 -34 Z" fill={c3} transform="translate(30 -4)"></path>
        <path d="M-54 -6 L 94 -6 L 94 46 Q 52 64 -4 52 Q -50 44 -54 -6 Z" fill="#161616"></path>
        <path d="M-40 4 L 86 4 L 86 34 Q 50 46 0 38 Q -36 30 -40 4 Z" fill={c2} opacity="0.85"></path>
        <rect x="-56" y="-12" width="150" height="8" rx="4" fill={c3}></rect>
        {[-52, -26, 0, 26, 52].map((x) => (<line x1={x} y1="-80" x2={x + 18} y2="-52" stroke={c2} stroke-width="5" stroke-linecap="round"></line>))}
        <path d="M-20 66 L 70 70 L 66 88 L -16 84 Z" fill="#2a2a2a"></path>
      </g>
    )}

    {kind === 'boots' && (
      <g transform="translate(150 150)">
        <ellipse cx="0" cy="110" rx="96" ry="8" fill="#000" opacity="0.3"></ellipse>
        <path d="M-44 -100 L 30 -100 L 38 40 L 100 70 Q 112 76 108 94 L 100 108 L -80 108 L -80 60 Q -52 50 -48 20 Z" fill={c1} stroke="#000" stroke-opacity="0.4" stroke-width="2"></path>
        <rect x="-40" y="-100" width="68" height="16" fill={c3}></rect>
        {[-70, -44, -18, 8].map((y) => (<rect x="-6" y={y} width="44" height="14" rx="3" fill={c2} stroke="#000" stroke-opacity="0.3"></rect>))}
        <rect x="-84" y="92" width="190" height="16" rx="4" fill="#111"></rect>
        <path d="M-30 -50 Q -50 0 -44 40" fill="none" stroke="#fff" stroke-opacity="0.25" stroke-width="3"></path>
        {[-60, -30, 0, 30, 60, 90].map((x) => (<rect x={x} y="104" width="12" height="8" fill="#000"></rect>))}
      </g>
    )}

    {kind === 'gloves' && (
      <g transform="translate(150 152) rotate(-8)">
        <ellipse cx="0" cy="118" rx="76" ry="7" fill="#000" opacity="0.28"></ellipse>
        <path d="M-46 90 L -52 20 Q -56 -4 -44 -22 L -40 -74 Q -38 -86 -28 -84 Q -20 -82 -20 -70 L -18 -56 L -16 -92 Q -14 -104 -4 -102 Q 4 -100 4 -88 L 4 -54 L 8 -90 Q 10 -100 20 -98 Q 28 -96 28 -86 L 26 -48 L 32 -72 Q 36 -80 44 -76 Q 52 -72 50 -62 L 44 -10 Q 66 -8 66 14 Q 64 42 48 60 L 44 90 Z" fill={c1} stroke="#000" stroke-opacity="0.35" stroke-width="2"></path>
        <path d="M-46 92 L 44 92 L 44 116 L -46 116 Z" fill={c2}></path>
        {[-34, -6, 22].map((x) => (<line x1={x} y1="-30" x2={x + 4} y2="-8" stroke={c3} stroke-width="3" stroke-linecap="round"></line>))}
        <path d="M-40 64 Q -2 54 40 64" fill="none" stroke={c3} stroke-width="3"></path>
      </g>
    )}

    {kind === 'jersey' && (
      <g transform="translate(150 150)">
        <ellipse cx="0" cy="116" rx="84" ry="7" fill="#000" opacity="0.28"></ellipse>
        <path d="M-40 -96 Q 0 -78 40 -96 L 110 -64 L 130 4 L 96 14 L 82 -22 L 76 112 L -76 112 L -82 -22 L -96 14 L -130 4 L -110 -64 Z" fill={c1}></path>
        <path d="M-40 -96 Q 0 -70 40 -96 L 30 -84 Q 0 -60 -30 -84 Z" fill={c2}></path>
        <path d="M-76 112 L -82 -22 L -96 14 L -130 4 L -110 -64 L -40 -96" fill="none" stroke="#000" stroke-opacity="0.25" stroke-width="2"></path>
        <path d="M-60 40 L 60 -20 L 60 4 L -60 64 Z" fill={c3} opacity="0.9"></path>
        <path d="M-60 76 L 60 16 L 60 34 L -60 94 Z" fill={c2} opacity="0.85"></path>
        <text x="0" y="-26" text-anchor="middle" font-size="34" font-weight="800" font-family="Barlow Condensed, Impact, sans-serif" fill={c3}>{num}</text>
      </g>
    )}

    {kind === 'part' && !item.id.includes('cadena') && (
      <g transform="translate(150 150)">
        <ellipse cx="0" cy="96" rx="92" ry="8" fill="#000" opacity="0.28"></ellipse>
        <rect x="-86" y="-52" width="172" height="130" rx="22" fill={c1}></rect>
        <rect x="-70" y="-36" width="140" height="98" rx="14" fill="#fff" opacity="0.14"></rect>
        {Array.from({ length: 9 }, (_, i) => (<line x1="-64" y1={-24 + i * 10} x2="64" y2={-24 + i * 10} stroke={c2} stroke-width="3.2" opacity="0.8"></line>))}
        <rect x="-96" y="-62" width="192" height="16" rx="8" fill={c2}></rect>
      </g>
    )}

    {kind === 'part' && item.id.includes('cadena') && (
      <g transform="translate(150 150)">
        <ellipse cx="0" cy="100" rx="96" ry="8" fill="#000" opacity="0.28"></ellipse>
        <circle cx="-52" cy="10" r="62" fill="none" stroke={c3} stroke-width="14"></circle>
        {big.map((t) => (<rect x={f(t.x - 5)} y={f(t.y - 5)} width="10" height="10" fill={c3} transform={`rotate(${t.r} ${t.x} ${t.y})`}></rect>))}
        <circle cx="-52" cy="10" r="14" fill="#161616"></circle>
        <circle cx="66" cy="38" r="26" fill="none" stroke={c1} stroke-width="9"></circle>
        {small.map((t) => (<rect x={f(t.x - 3)} y={f(t.y - 3)} width="6" height="6" fill={c1}></rect>))}
        <path d="M-52 -52 L 66 12 M-52 72 L 66 64" fill="none" stroke="#b9b4a8" stroke-width="5" stroke-dasharray="7 3"></path>
      </g>
    )}
  </svg>
</figure>

<style>
  .moto-art {
    margin: 0;
    width: 100%;
    max-width: 440px;
  }

  .moto-art svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
