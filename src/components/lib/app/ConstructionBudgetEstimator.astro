---
/**
 * ConstructionBudgetEstimator — Interactive construction cost & budget calculator for developers, architects and clients.
 * Estimates PEM (Presupuesto de Ejecución Material), PEC (Presupuesto de Ejecución por Contrata),
 * architectural fees, municipal licenses, and construction duration in months.
 *
 * @param {number} defaultM2 - Initial building surface area in m².
 * @param {string} contactHref - URL to send formal project dossier.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  defaultM2?: number;
  contactHref?: string;
  className?: string;
}

const {
  defaultM2 = 280,
  contactHref = '/preview/construction/contact',
  className = '',
} = Astro.props;

const typologies = [
  { id: 'residential', label: 'Vivienda Residencial Nueva', rate: 1450, icon: '🏠' },
  { id: 'passivhaus', label: 'Villa Bioclimática Passivhaus', rate: 1950, icon: '🌱' },
  { id: 'commercial', label: 'Edificio Oficinas & Terciario', rate: 1250, icon: '🏢' },
  { id: 'industrial', label: 'Nave Industrial & Logística', rate: 680, icon: '🏭' },
  { id: 'rehab', label: 'Rehabilitación Integral de Edificio', rate: 950, icon: '🔨' },
];
---

<div class={`construction-estimator ${className}`} id="budget-estimator" data-base-m2={defaultM2}>
  <div class="estimator-header">
    <div class="header-left">
      <span class="eyebrow">Calculadora de Presupuestos de Obra</span>
      <h3 class="estimator-title">Estimador Técnico de Construcción</h3>
      <p class="estimator-sub">Calcula el Presupuesto de Ejecución Material (PEM), contrata (PEC) y cronograma de meses según m² y tipología.</p>
    </div>
    <div class="cte-badge">
      <span>Conforme a CTE &amp; Precios COAM 2026</span>
    </div>
  </div>

  <div class="estimator-grid">
    <!-- Left: Inputs & Sliders -->
    <div class="inputs-col">
      <!-- Step 1: Typology -->
      <div class="input-section">
        <label class="section-label">1. Tipología de Edificación</label>
        <div class="typo-grid">
          {typologies.map((t, idx) => (
            <label class={`typo-pill ${idx === 0 ? 'is-selected' : ''}`}>
              <input type="radio" name="typology" value={t.rate} checked={idx === 0} />
              <span class="typo-icon">{t.icon}</span>
              <div class="typo-text">
                <strong class="typo-title">{t.label}</strong>
                <span class="typo-rate">~{t.rate} €/m²</span>
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- Step 2: Surface Slider -->
      <div class="input-section">
        <div class="slider-head">
          <label class="section-label" for="surface-range">2. Superficie Total a Construir</label>
          <div class="m2-display">
            <span class="m2-number" id="m2-val-text">{defaultM2}</span>
            <span class="m2-unit">m² construidos</span>
          </div>
        </div>
        <input
          type="range"
          id="surface-range"
          min="80"
          max="3500"
          step="10"
          value={defaultM2}
          class="surface-slider"
        />
        <div class="slider-ticks">
          <span>80 m²</span>
          <span>500 m²</span>
          <span>1.500 m²</span>
          <span>3.500 m²</span>
        </div>
      </div>

      <!-- Step 3: Qualities -->
      <div class="input-section">
        <label class="section-label">3. Nivel de Calidades &amp; Acabados</label>
        <div class="qualities-row">
          <label class="quality-radio is-selected">
            <input type="radio" name="quality" value="1.0" checked />
            <div class="quality-box">
              <strong class="q-name">Estándar Confort</strong>
              <span class="q-sub">CTE Clase B · PVC Climalit</span>
            </div>
          </label>
          <label class="quality-radio">
            <input type="radio" name="quality" value="1.2" />
            <div class="quality-box">
              <strong class="q-name">Premium Aislado</strong>
              <span class="q-sub">Aerotermia A · Porcelanosa</span>
            </div>
          </label>
          <label class="quality-radio">
            <input type="radio" name="quality" value="1.45" />
            <div class="quality-box">
              <strong class="q-name">Gran Lujo Passivhaus</strong>
              <span class="q-sub">Geotermia · Domótica KNX</span>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Right: Calculation Breakdown Card -->
    <aside class="breakdown-card">
      <div class="breakdown-head">
        <h4 class="breakdown-title">Presupuesto Estimado de Obra</h4>
        <span class="tax-pill">Precios sin IVA</span>
      </div>

      <!-- Key Totals -->
      <div class="breakdown-metrics">
        <div class="metric-row">
          <span class="m-lbl">Presupuesto Ejecución Material (PEM)</span>
          <strong class="m-val" id="pem-val">406.000 €</strong>
        </div>
        <div class="metric-row">
          <span class="m-lbl">Gastos Generales (13%) &amp; Bº Industrial (6%)</span>
          <strong class="m-val" id="gg-bi-val">77.140 €</strong>
        </div>
        <div class="metric-row">
          <span class="m-lbl">Proyecto Arquitectura &amp; Dirección Técnica (8%)</span>
          <strong class="m-val" id="arch-val">32.480 €</strong>
        </div>
        <div class="metric-row">
          <span class="m-lbl">Licencia Municipal de Obras e ICIO (4.5%)</span>
          <strong class="m-val" id="license-val">18.270 €</strong>
        </div>
      </div>

      <div class="total-execution-block">
        <div class="total-row">
          <div class="total-labels">
            <span class="t-eyebrow">Coste Total Estimado de Inversión</span>
            <strong class="t-main" id="total-val">533.890 €</strong>
          </div>
          <div class="time-block">
            <span class="time-lbl">Plazo de Obra</span>
            <strong class="time-val" id="timeline-val">12 meses</strong>
          </div>
        </div>
      </div>

      <div class="breakdown-actions">
        <a href={contactHref} class="btn-request-quote">
          <span>Solicitar Estudio de Viabilidad Detallado</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <p class="disclaimer">
          * Estimación paramétrica sujeta a estudio geotécnico de parcela y proyecto de ejecución final visado.
        </p>
      </div>
    </aside>
  </div>
</div>

<script>
  function initBudgetEstimator() {
    const root = document.getElementById('budget-estimator');
    if (!root) return;

    const slider = root.querySelector('#surface-range') as HTMLInputElement;
    const m2Text = root.querySelector('#m2-val-text');
    const pemEl = root.querySelector('#pem-val');
    const ggBiEl = root.querySelector('#gg-bi-val');
    const archEl = root.querySelector('#arch-val');
    const licenseEl = root.querySelector('#license-val');
    const totalEl = root.querySelector('#total-val');
    const timelineEl = root.querySelector('#timeline-val');

    function updateCalculations() {
      const surface = Number(slider?.value) || 280;
      if (m2Text) m2Text.textContent = surface.toLocaleString();

      const checkedTypo = root?.querySelector('input[name="typology"]:checked') as HTMLInputElement;
      const typoRate = Number(checkedTypo?.value) || 1450;

      const checkedQuality = root?.querySelector('input[name="quality"]:checked') as HTMLInputElement;
      const qualityFactor = Number(checkedQuality?.value) || 1.0;

      const effectiveRate = typoRate * qualityFactor;
      const pem = surface * effectiveRate;
      const ggBi = pem * 0.19; // 13% GG + 6% BI
      const arch = pem * 0.08;
      const license = pem * 0.045;
      const total = pem + ggBi + arch + license;

      let months = Math.round(8 + Math.sqrt(surface) * 0.25);
      if (months > 30) months = 30;

      if (pemEl) pemEl.textContent = `${Math.round(pem).toLocaleString()} €`;
      if (ggBiEl) ggBiEl.textContent = `${Math.round(ggBi).toLocaleString()} €`;
      if (archEl) archEl.textContent = `${Math.round(arch).toLocaleString()} €`;
      if (licenseEl) licenseEl.textContent = `${Math.round(license).toLocaleString()} €`;
      if (totalEl) totalEl.textContent = `${Math.round(total).toLocaleString()} €`;
      if (timelineEl) timelineEl.textContent = `${months} meses`;
    }

    slider?.addEventListener('input', updateCalculations);

    const typoInputs = root.querySelectorAll('input[name="typology"]');
    typoInputs.forEach(i => i.addEventListener('change', () => {
      root.querySelectorAll('.typo-pill').forEach(p => p.classList.remove('is-selected'));
      i.closest('.typo-pill')?.classList.add('is-selected');
      updateCalculations();
    }));

    const qualityInputs = root.querySelectorAll('input[name="quality"]');
    qualityInputs.forEach(q => q.addEventListener('change', () => {
      root.querySelectorAll('.quality-radio').forEach(p => p.classList.remove('is-selected'));
      q.closest('.quality-radio')?.classList.add('is-selected');
      updateCalculations();
    }));

    updateCalculations();
  }

  initBudgetEstimator();
  document.addEventListener('astro:page-load', initBudgetEstimator);
</script>

<style>
  .construction-estimator {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2rem;
    color: #f8fafc;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .estimator-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #f59e0b;
  }

  .estimator-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .estimator-sub {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0;
    max-width: 620px;
  }

  .cte-badge {
    padding: 0.35rem 0.75rem;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #f59e0b;
  }

  /* Grid */
  .estimator-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.85fr;
    gap: 2rem;
  }

  @media (max-width: 960px) {
    .estimator-grid {
      grid-template-columns: 1fr;
    }
  }

  .inputs-col {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .input-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #cbd5e1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .typo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .typo-pill {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.15s ease;
    position: relative;
  }

  .typo-pill input {
    position: absolute;
    opacity: 0;
  }

  .typo-pill:hover {
    border-color: rgba(245, 158, 11, 0.4);
  }

  .typo-pill.is-selected {
    background: rgba(245, 158, 11, 0.12);
    border-color: #f59e0b;
  }

  .typo-icon {
    font-size: 1.4rem;
  }

  .typo-text {
    display: flex;
    flex-direction: column;
  }

  .typo-title {
    font-size: 0.85rem;
    color: #ffffff;
  }

  .typo-rate {
    font-size: 0.72rem;
    color: #f59e0b;
    font-weight: 700;
  }

  /* Slider */
  .slider-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .m2-display {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .m2-number {
    font-size: 1.6rem;
    font-weight: 900;
    color: #f59e0b;
  }

  .m2-unit {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .surface-slider {
    width: 100%;
    accent-color: #f59e0b;
    cursor: pointer;
  }

  .slider-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: #64748b;
  }

  /* Qualities */
  .qualities-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .quality-radio {
    cursor: pointer;
    position: relative;
  }

  .quality-radio input {
    position: absolute;
    opacity: 0;
  }

  .quality-box {
    padding: 0.75rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    transition: all 0.15s ease;
  }

  .quality-radio:hover .quality-box {
    border-color: rgba(245, 158, 11, 0.4);
  }

  .quality-radio.is-selected .quality-box {
    background: rgba(245, 158, 11, 0.12);
    border-color: #f59e0b;
  }

  .q-name {
    font-size: 0.82rem;
    color: #ffffff;
  }

  .q-sub {
    font-size: 0.7rem;
    color: #94a3b8;
  }

  /* Breakdown Card */
  .breakdown-card {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  }

  .breakdown-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .breakdown-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .tax-pill {
    font-size: 0.7rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .breakdown-metrics {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: #cbd5e1;
  }

  .m-val {
    color: #ffffff;
  }

  .total-execution-block {
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .total-labels {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .t-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    color: #fbbf24;
    text-transform: uppercase;
  }

  .t-main {
    font-size: 1.85rem;
    font-weight: 900;
    color: #f59e0b;
    letter-spacing: -0.02em;
  }

  .time-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
  }

  .time-lbl {
    font-size: 0.68rem;
    color: #94a3b8;
  }

  .time-val {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .breakdown-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .btn-request-quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem;
    background: #f59e0b;
    color: #0f172a;
    border-radius: 10px;
    font-weight: 800;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-request-quote:hover {
    background: #d97706;
    transform: translateY(-1px);
  }

  .disclaimer {
    font-size: 0.7rem;
    color: #64748b;
    line-height: 1.4;
    margin: 0;
    text-align: center;
  }
</style>
