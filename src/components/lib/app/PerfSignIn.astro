---
/**
 * PerfSignIn — Split sign-in for the customer area: a large generated flacon with a customer quote on one side, the form (email, password with show/hide, remember me) on the other, plus a demo quick-access link and a link to join the club.
 *
 * Thin wrapper over the shared `AccountSignIn` split layout: it only picks this template's
 * illustration, copy and typography.
 *
 * @param {string} dashboardHref - Where a successful sign-in goes.
 * @param {string} joinHref - Link to the club page.
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} action - Backend endpoint. Empty runs a demo sign-in that redirects.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: see `AccountSignIn` (labelled fields, password toggle with aria-pressed, errors in
 * role="alert", visible focus rings and 48px controls; the illustration is decorative).
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/perfumery/perf-theme.css';
import PerfBottle from './PerfBottle.astro';
import { perfList } from '../templates/perfumery/data';
import AccountSignIn from './AccountSignIn.astro';

interface OwnProps {
  dashboardHref?: string;
  joinHref?: string;
  homeHref?: string;
  action?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const { dashboardHref = '/cuenta', joinHref = '/fragancias', homeHref = '/', action = '', ...rest } = Astro.props;
const fragrance = perfList.find((f) => f.id === 'iris-noir') ?? perfList[0];
---

<AccountSignIn
  themeClass="perf-ui"
  tokenPrefix="pf"
  brand="Umbra"
  quote="Llevo tres años con Iris Noir y todavía hay días en que alguien me pregunta qué llevo. Lo bueno es que ya sé cuánto me queda en el frasco y cuándo pedir otro."
  author="Marta Vidal · clienta desde 2022"
  eyebrow="Área de cliente"
  heading="Bienvenida de nuevo"
  joinPrompt="¿Primera vez?"
  joinLabel="Descubre las seis fragancias"
  homeHref={homeHref}
  dashboardHref={dashboardHref}
  joinHref={joinHref}
  action={action}
  brandStyle="italic"
  quoteStyle="italic"
  {...rest}
>
  <Fragment slot="art"><PerfBottle fragrance={fragrance} decorative /></Fragment>
</AccountSignIn>
