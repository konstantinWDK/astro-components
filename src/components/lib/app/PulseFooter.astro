---
/**
 * PulseFooter — Site footer for the Pulse Tech Summit template.
 * Includes summit branding, quick navigation links, newsletter subscription with
 * client-side feedback toast, code of conduct link, diversity statement, and copyright.
 *
 * @param {PulseRoutes} routes - Routing configuration object.
 * @param {string} class - Additional CSS classes.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/tech-event/pls-theme.css';
import { pulseRoutes, type PulseRoutes } from '../templates/tech-event/data';

interface OwnProps {
  routes?: PulseRoutes;
}

type Props = OwnProps & Omit<HTMLAttributes<'footer'>, keyof OwnProps | 'class'> & { class?: string };

const {
  routes = pulseRoutes,
  class: className = '',
  ...rest
} = Astro.props;
---

<footer class:list={['pls-footer', className]} {...rest}>
  <div class="pls-footer__container">
    <div class="pls-footer__grid">
      <!-- Col 1: Brand & Mission -->
      <div class="pls-footer__brand">
        <a href={routes.home} class="pls-footer__logo" aria-label="Pulse Tech Summit 2027">
          <div class="pls-logo__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <div class="pls-logo__text">
            <span class="pls-logo__title">PULSE</span>
            <span class="pls-logo__sub">SUMMIT 2027</span>
          </div>
        </a>

        <p class="pls-footer__mission">
          El punto de encuentro internacional para los ingenieros, arquitectos y fundadores que están construyendo la próxima generación de software inteligente y distribuido.
        </p>

        <div class="pls-footer__meta-badges">
          <span class="pls-meta-chip">14 - 16 OCT 2027</span>
          <span class="pls-meta-chip">Madrid, España</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="pls-footer__col">
        <h3 class="pls-footer__heading">Cumbre</h3>
        <ul class="pls-footer__links">
          <li><a href={routes.home}>Inicio</a></li>
          <li><a href={routes.schedule}>Programa Completo</a></li>
          <li><a href={routes.speakers}>Ponentes Invitados</a></li>
          <li><a href={routes.tickets}>Comprar Entradas</a></li>
          <li><a href={routes.venue}>Sede & Viaje</a></li>
        </ul>
      </div>

      <!-- Col 3: Community & Policies -->
      <div class="pls-footer__col">
        <h3 class="pls-footer__heading">Comunidad</h3>
        <ul class="pls-footer__links">
          <li><a href="#call-for-papers">Call for Papers (Cerrado)</a></li>
          <li><a href="#sponsors">Patrocina la Cumbre</a></li>
          <li><a href="#diversity">Becas de Diversidad</a></li>
          <li><a href="#conduct">Código de Conducta</a></li>
          <li><a href="#terms">Términos y Cancelaciones</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div class="pls-footer__col pls-footer__col--newsletter">
        <h3 class="pls-footer__heading">Mantente al día</h3>
        <p class="pls-footer__newsletter-desc">
          Recibe en primicia los anuncios de nuevos ponentes, agendas de workshops y apertura de entradas.
        </p>
        <form class="pls-footer__form" id="pls-newsletter-form" onsubmit="event.preventDefault(); document.getElementById('pls-news-success')?.removeAttribute('hidden'); this.reset();">
          <div class="pls-newsletter__input-wrap">
            <input
              type="email"
              required
              placeholder="tu.correo@empresa.com"
              class="pls-newsletter__input"
              aria-label="Correo electrónico para boletín"
            />
            <button type="submit" class="pls-btn pls-btn--primary pls-btn--sm pls-newsletter__btn">
              Suscribirme
            </button>
          </div>
          <p class="pls-newsletter__success" id="pls-news-success" hidden>
            ✓ ¡Gracias! Te mantendremos informado sin spam.
          </p>
        </form>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="pls-footer__bottom">
      <p class="pls-footer__copy">
        © 2027 Pulse Tech Summit. Todos los derechos reservados. Diseñado para comunidades tecnológicas abiertas.
      </p>
      <div class="pls-footer__socials" aria-label="Redes sociales">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .pls-footer {
    border-top: 1px solid var(--pls-border);
    background: var(--pls-bg-elevated);
    padding: 4.5rem 0 2.5rem;
    color: var(--pls-text-2);
    font-size: 0.9rem;
  }

  .pls-footer__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .pls-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.8fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 960px) {
    .pls-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .pls-footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .pls-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pls-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--pls-text-1);
  }

  .pls-footer__mission {
    line-height: 1.6;
    color: var(--pls-text-2);
    margin: 0;
    max-width: 24rem;
  }

  .pls-footer__meta-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pls-meta-chip {
    padding: 0.25rem 0.6rem;
    border-radius: var(--pls-radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--pls-border);
    font-family: var(--pls-font-mono);
    font-size: 0.75rem;
    color: var(--pls-cyan);
    font-weight: 600;
  }

  .pls-footer__heading {
    margin: 0 0 1.2rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pls-text-1);
  }

  .pls-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .pls-footer__links a {
    color: var(--pls-text-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .pls-footer__links a:hover {
    color: var(--pls-cyan);
  }

  .pls-footer__newsletter-desc {
    margin: 0 0 1rem;
    line-height: 1.5;
    font-size: 0.88rem;
  }

  .pls-newsletter__input-wrap {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 480px) {
    .pls-newsletter__input-wrap {
      flex-direction: column;
    }
  }

  .pls-newsletter__input {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.85rem;
    border-radius: var(--pls-radius-sm);
    border: 1px solid var(--pls-border);
    background: rgba(0, 0, 0, 0.2);
    color: var(--pls-text-1);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.18s;
  }

  .pls-newsletter__input:focus {
    border-color: var(--pls-cyan);
  }

  .pls-newsletter__success {
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    color: var(--pls-emerald);
    font-weight: 600;
  }

  /* Bottom */
  .pls-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--pls-border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .pls-footer__copy {
    margin: 0;
    font-size: 0.82rem;
    color: var(--pls-text-3);
  }

  .pls-footer__socials {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pls-footer__socials a {
    color: var(--pls-text-3);
    transition: color 0.18s, transform 0.18s;
    display: grid;
    place-items: center;
  }

  .pls-footer__socials a:hover {
    color: var(--pls-cyan);
    transform: translateY(-2px);
  }
</style>

