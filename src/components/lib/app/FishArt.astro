---
/**
 * FishArt — Product illustration drawn in SVG from a tackle item's data: a rod with cork handle, reel
 * seat and guides; a reel with spool, wound line and handle; a lure (spoon, shad or minnow by seed)
 * with eye, gill and hooks; a spool of line; or a landing net / bait bucket. Colours come from the
 * item's palette and every drawing is repeatable. No images needed.
 *
 * @param {FishProduct} item - Product to draw (art kind, seed, palette, name).
 * @param {boolean} decorative - Hide from assistive tech (use when the name is next to it).
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: exposed as an image with the product name, or aria-hidden when decorative.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/fishing/fish-theme.css';
import { fishProducts, fishRng, type FishProduct } from '../templates/fishing/data';

interface OwnProps {
  item?: FishProduct;
  decorative?: boolean;
}

type Props = OwnProps & Omit<HTMLAttributes<'figure'>, keyof OwnProps | 'class'> & { class?: string };

const { item = fishProducts[0], decorative = false, class: classAttr, ...rest } = Astro.props;

const { kind, seed, palette } = item.art;
const [c1, c2, c3] = palette;
const rnd = fishRng(seed);
const uid = `fa-${item.id}-${Math.random().toString(36).slice(2, 6)}`;
const f = (n: number) => Math.round(n * 10) / 10;
const lureShape = ['spoon', 'shad', 'minnow'][seed % 3];
const guides = Array.from({ length: 7 }, (_, i) => ({ t: 0.18 + i * 0.12 }));
const bend = 8 + rnd() * 14;
const wraps = Array.from({ length: 9 }, (_, i) => i);
const aria = decorative ? undefined : item.name;
---

<figure class:list={['fish-ui', 'fish-art', classAttr]} {...rest}>
  <svg viewBox="0 0 300 300" role={decorative ? undefined : 'img'} aria-label={aria} aria-hidden={decorative ? 'true' : undefined} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id={`${uid}-bg`} cx="0.5" cy="0.55" r="0.65">
        <stop offset="0" stop-color={c3} stop-opacity="0.28"></stop>
        <stop offset="1" stop-color={c3} stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id={`${uid}-body`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={c2}></stop>
        <stop offset="0.55" stop-color={c1}></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0.85"></stop>
      </linearGradient>
    </defs>
    <rect width="300" height="300" fill={`url(#${uid}-bg)`}></rect>
    <circle cx="150" cy="170" r="104" fill="none" stroke={c3} stroke-opacity="0.22"></circle>
    <circle cx="150" cy="170" r="80" fill="none" stroke={c3} stroke-opacity="0.14"></circle>

    {kind === 'rod' && (
      <g>
        <path d={`M44 262 C 110 ${f(200 - bend)}, 190 ${f(110 - bend)}, 262 ${f(34 + bend)}`} fill="none" stroke={c1} stroke-width="5" stroke-linecap="round"></path>
        <path d={`M44 262 C 110 ${f(200 - bend)}, 190 ${f(110 - bend)}, 262 ${f(34 + bend)}`} fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="1.4" stroke-linecap="round" transform="translate(-1.5 -1.5)"></path>
        <line x1="42" y1="266" x2="86" y2="228" stroke="#c9a46a" stroke-width="11" stroke-linecap="round"></line>
        {[0, 1, 2, 3, 4].map((i) => (<line x1={f(48 + i * 8)} y1={f(262 - i * 7)} x2={f(54 + i * 8)} y2={f(266 - i * 7)} stroke="#7a5a2b" stroke-width="1.2"></line>))}
        <rect x="88" y="206" width="22" height="9" rx="3" fill={c3} transform="rotate(-42 99 210)"></rect>
        {wraps.map((i) => (<line x1={f(120 + i * 15)} y1={f(185 - i * 13 - 4)} x2={f(120 + i * 15)} y2={f(185 - i * 13 + 4)} stroke={c2} stroke-width="2" transform={`rotate(-35 ${f(120 + i * 15)} ${f(185 - i * 13)})`} opacity="0.9"></line>))}
        {guides.map((g, i) => (<circle cx={f(44 + g.t * 218)} cy={f(262 - g.t * 228 + Math.sin(g.t * 3) * -bend * 0.6)} r={f(4.2 - i * 0.35)} fill="none" stroke={c3} stroke-width="1.6"></circle>))}
      </g>
    )}

    {kind === 'reel' && (
      <g transform="translate(150 160)">
        <rect x="-8" y="76" width="16" height="30" rx="3" fill={c3}></rect>
        <rect x="-48" y="104" width="96" height="9" rx="4.5" fill={c3}></rect>
        <circle r="72" fill={c1}></circle>
        <circle r="72" fill="none" stroke="#fff" stroke-opacity="0.25" stroke-width="2"></circle>
        {[62, 54, 46, 38].map((r) => (<circle r={r} fill="none" stroke={c2} stroke-opacity="0.75" stroke-width="2.4"></circle>))}
        <circle r="26" fill={c3}></circle>
        <circle r="9" fill={c2}></circle>
        <path d="M72 -4 C 108 -2 120 -26 126 -58" fill="none" stroke={c3} stroke-width="9" stroke-linecap="round"></path>
        <circle cx="126" cy="-60" r="13" fill={c2}></circle>
        <rect x="-16" y="-96" width="32" height="26" rx="6" fill={c3}></rect>
      </g>
    )}

    {kind === 'lure' && lureShape === 'minnow' && (
      <g transform="translate(150 150) rotate(-14)">
        <path d="M-96 0 C -70 -34 40 -38 92 -6 L 108 -16 L 108 16 L 92 6 C 40 36 -70 34 -96 0 Z" fill={`url(#${uid}-body)`} stroke="#000" stroke-opacity="0.25"></path>
        <path d="M-96 0 L -112 14 L -86 8 Z" fill={c3}></path>
        <circle cx="-66" cy="-6" r="7" fill="#fff"></circle><circle cx="-65" cy="-6" r="3.6" fill="#111"></circle>
        <path d="M-52 -22 Q -46 0 -52 22" fill="none" stroke="#000" stroke-opacity="0.3" stroke-width="2"></path>
        {[-20, 6, 32, 58].map((x) => (<path d={`M${x} -24 q 6 14 12 0`} fill="none" stroke={c3} stroke-opacity="0.5"></path>))}
        <path d="M-48 18 q -4 20 -16 30 M10 20 q -2 22 -12 34 M-12 18 l 0 0" fill="none" stroke="#9aa3a8" stroke-width="2.4" stroke-linecap="round"></path>
        <path d="M88 -2 q 14 10 28 0" fill="none" stroke="#9aa3a8" stroke-width="2.4" stroke-linecap="round"></path>
      </g>
    )}

    {kind === 'lure' && lureShape === 'spoon' && (
      <g transform="translate(150 148) rotate(18)">
        <path d="M-30 -70 C 40 -78 56 -10 38 44 C 24 86 -34 86 -42 44 C -52 -6 -50 -58 -30 -70 Z" fill={`url(#${uid}-body)`} stroke="#000" stroke-opacity="0.28" stroke-width="2"></path>
        <path d="M-12 -52 C 24 -54 34 -8 22 34" fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="3" stroke-linecap="round"></path>
        <circle cx="-26" cy="-58" r="6" fill="#111" opacity="0.6"></circle>
        <circle cx="-5" cy="84" r="5" fill="none" stroke="#9aa3a8" stroke-width="3"></circle>
        <path d="M-5 89 v 18 M-5 107 q 14 6 22 -6 M-5 107 q -14 6 -22 -6" fill="none" stroke="#9aa3a8" stroke-width="3" stroke-linecap="round"></path>
      </g>
    )}

    {kind === 'lure' && lureShape === 'shad' && (
      <g transform="translate(150 150) rotate(-8)">
        <path d="M-100 -4 C -70 -34 20 -36 56 -8 C 76 -22 100 -34 118 -40 C 112 -14 112 14 118 40 C 100 34 76 22 56 8 C 20 36 -70 34 -100 -4 Z" fill={`url(#${uid}-body)`} stroke="#000" stroke-opacity="0.25"></path>
        <circle cx="-72" cy="-8" r="6.5" fill="#fff"></circle><circle cx="-71" cy="-8" r="3.2" fill="#111"></circle>
        {[-52, -26, 0, 26].map((x) => (<line x1={x} y1="-26" x2={x} y2="26" stroke="#000" stroke-opacity="0.18" stroke-width="2"></line>))}
        <path d="M-74 0 L -108 -10 L -96 12 Z" fill={c3} opacity="0.6"></path>
      </g>
    )}

    {kind === 'line' && (
      <g transform="translate(150 150)">
        <ellipse cx="0" cy="62" rx="86" ry="22" fill={c3}></ellipse>
        <rect x="-86" y="-50" width="172" height="112" fill={c3}></rect>
        <ellipse cx="0" cy="-50" rx="86" ry="22" fill={c1}></ellipse>
        {[0, 1, 2, 3, 4, 5, 6].map((i) => (<path d={`M-86 ${-34 + i * 15} Q 0 ${-12 + i * 15} 86 ${-34 + i * 15}`} fill="none" stroke={c2} stroke-width="3"></path>))}
        <ellipse cx="0" cy="-50" rx="86" ry="22" fill="none" stroke="#fff" stroke-opacity="0.3"></ellipse>
        <path d="M60 -44 C 96 -30 108 20 90 70" fill="none" stroke={c2} stroke-width="3"></path>
      </g>
    )}

    {kind === 'gear' && !item.id.includes('cubo') && (
      <g transform="translate(150 150)">
        <line x1="-96" y1="96" x2="-18" y2="18" stroke={c3} stroke-width="10" stroke-linecap="round"></line>
        <ellipse cx="46" cy="-34" rx="70" ry="60" fill="none" stroke={c1} stroke-width="8" transform="rotate(-32 46 -34)"></ellipse>
        {[-4, -2, 0, 2, 4].map((i) => (<path d={`M${f(46 + i * 12 - 30)} ${f(-82)} Q ${f(46 + i * 14)} ${f(-34)} ${f(46 + i * 12 + 30)} ${f(14)}`} fill="none" stroke={c2} stroke-opacity="0.7" stroke-width="1.8"></path>))}
        {[-3, -1.5, 0, 1.5, 3].map((i) => (<path d={`M${f(-14)} ${f(-34 + i * 16)} Q ${f(46)} ${f(-34 + i * 20 + 10)} ${f(106)} ${f(-34 + i * 16)}`} fill="none" stroke={c2} stroke-opacity="0.7" stroke-width="1.8"></path>))}
      </g>
    )}

    {kind === 'gear' && item.id.includes('cubo') && (
      <g transform="translate(150 160)">
        <path d="M-62 -52 L 62 -52 L 52 78 Q 0 90 -52 78 Z" fill={c1}></path>
        <ellipse cx="0" cy="-52" rx="62" ry="14" fill={c2} opacity="0.9"></ellipse>
        <ellipse cx="0" cy="-52" rx="52" ry="9" fill={c3}></ellipse>
        <path d="M-62 -52 Q 0 -120 62 -52" fill="none" stroke={c3} stroke-width="6" stroke-linecap="round"></path>
        {[-24, 0, 24].map((x) => (<circle cx={x} cy={f(10 + (x === 0 ? -8 : 6))} r="5" fill="#fff" opacity="0.35"></circle>))}
        <rect x="-62" y="-4" width="124" height="14" fill="#000" opacity="0.18"></rect>
      </g>
    )}
  </svg>
</figure>

<style>
  .fish-art {
    margin: 0;
    width: 100%;
    max-width: 420px;
  }

  .fish-art svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
