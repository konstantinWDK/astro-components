---
/**
 * FoodOrderTracker — Live food delivery order tracking status component.
 * Displays real-time order stages (Confirmed → Kitchen Cooking → Courier on the Way → Delivered),
 * live ETA countdown, courier contact card, delivery address instructions, and itemized receipt.
 *
 * @param {FoodOrder} order - Delivery order record.
 * @param {string} className - Optional CSS class.
 */
import type { FoodOrder } from '../templates/food-delivery/data';
import { foodOrders } from '../templates/food-delivery/data';

interface Props {
  order?: FoodOrder;
  supportPhone?: string;
  className?: string;
}

const {
  order = foodOrders[0],
  supportPhone = '+34 910 774 220',
  className = '',
} = Astro.props;

const steps = [
  { id: 'new', label: 'Order Placed', time: order.orderTime },
  { id: 'kitchen_prep', label: 'Kitchen Cooking', time: 'In oven' },
  { id: 'out_for_delivery', label: 'Courier on the Way', time: order.courier ? `${order.courier.etaMin}m away` : 'Assigned' },
  { id: 'delivered', label: 'Delivered', time: 'Target 14:15' },
];

const statusOrder = ['new', 'kitchen_prep', 'ready_for_pickup', 'out_for_delivery', 'delivered'];
const currentStepIdx = statusOrder.indexOf(order.status);
const stepsWithState = steps.map((st, i) => ({
  ...st,
  stepNum: i + 1,
  isDone: !(i > currentStepIdx),
  isCurrent: i === currentStepIdx,
}));
---

<div class={`order-tracker-card ${className}`}>
  <!-- ETA Header -->
  <div class="tracker-header">
    <div class="eta-headline">
      <span class="eta-tag">LIVE DELIVERY TRACKING</span>
      <h3 class="eta-title">
        {order.status === 'delivered' ? (
          'Order Delivered · Enjoy your meal!'
        ) : (
          `Estimated Arrival in ${order.courier?.etaMin || 12} Minutes`
        )}
      </h3>
      <span class="order-ref-text">Order #{order.reference} · Placed at {order.orderTime}</span>
    </div>

    <div class="tracker-status-badge">
      <span class={`food-status-badge food-status-badge--${order.status}`}>
        {order.status.replace('_', ' ')}
      </span>
    </div>
  </div>

  <!-- Progress Bar -->
  <div class="tracker-progress">
    {stepsWithState.map((st) => (
      <div class={`progress-step ${st.isDone ? 'done' : ''} ${st.isCurrent ? 'current' : ''}`}>
        <div class="step-circle">
          {st.isDone ? '✓' : st.stepNum}
        </div>
        <div class="step-labels">
          <strong class="step-name">{st.label}</strong>
          <span class="step-time">{st.time}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Courier Card (if out for delivery) -->
  {order.courier && (
    <div class="courier-card">
      <div class="courier-left">
        <div class="courier-avatar">
          {order.courier.name[0]}
        </div>
        <div class="courier-info">
          <span class="courier-role">Your BiteFlow Courier</span>
          <strong class="courier-name">{order.courier.name}</strong>
          <span class="courier-vehicle">
            {order.courier.vehicle === 'ebike' ? '⚡ Eco E-Bike' : '🛵 125cc Scooter'}
          </span>
        </div>
      </div>

      <div class="courier-actions">
        <a href={`tel:${order.courier.phone}`} class="btn-call-courier">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>
          </svg>
          <span>Call Driver</span>
        </a>
        {supportPhone && (
          <a href={`tel:${supportPhone}`} class="btn-call-support" title="Call restaurant support">
            <span>Help Desk</span>
          </a>
        )}
      </div>
    </div>
  )}

  <!-- Delivery Destination -->
  <div class="delivery-address-box">
    <div class="addr-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
      </svg>
    </div>
    <div class="addr-text">
      <span class="addr-label">Delivering to</span>
      <strong class="addr-main">{order.deliveryAddress}</strong>
      <span class="addr-sub">{order.floorDoor}</span>
      {order.notes && <p class="addr-notes">“{order.notes}”</p>}
    </div>
  </div>

  <!-- Items Summary -->
  <div class="order-summary-box">
    <h4 class="summary-head">Order Items ({order.items.length})</h4>
    <div class="summary-items-list">
      {order.items.map((it) => (
        <div class="summary-item-row">
          <div class="it-name-wrap">
            <span class="it-qty">{it.qty}×</span>
            <span class="it-name">{it.name}</span>
            {it.selectedModifiers && it.selectedModifiers.length > 0 && (
              <small class="it-mods">({it.selectedModifiers.join(', ')})</small>
            )}
          </div>
          <strong class="it-price">€{(it.unitPrice * it.qty).toFixed(2)}</strong>
        </div>
      ))}
    </div>

    <div class="summary-totals">
      <div class="tot-row"><span>Subtotal</span><span>€{order.subtotal.toFixed(2)}</span></div>
      <div class="tot-row"><span>Delivery Fee</span><span>€{order.deliveryFee.toFixed(2)}</span></div>
      <div class="tot-row"><span>Rider Tip</span><span>€{order.tip.toFixed(2)}</span></div>
      <div class="tot-row tot-total">
        <strong>Total Paid</strong>
        <strong>€{order.total.toFixed(2)}</strong>
      </div>
    </div>
  </div>
</div>

<style>
  .order-tracker-card {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 1.75rem;
    box-shadow: var(--food-card-shadow);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tracker-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-border);
  }

  .eta-tag {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--c-primary);
    letter-spacing: 0.05em;
  }

  .eta-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--c-text);
    margin: 0.25rem 0;
  }

  .order-ref-text {
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }

  /* Progress */
  .tracker-progress {
    display: flex;
    justify-content: space-between;
    position: relative;
    padding: 0.5rem 0;
  }

  .tracker-progress::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 20px;
    right: 20px;
    height: 3px;
    background: var(--c-border);
    z-index: 1;
  }

  .progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .step-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c-surface);
    border: 2px solid var(--c-border);
    color: var(--c-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .progress-step.done .step-circle {
    background: var(--c-primary);
    border-color: var(--c-primary);
    color: #ffffff;
  }

  .progress-step.current .step-circle {
    background: #16a34a;
    border-color: #16a34a;
    color: #ffffff;
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.25);
  }

  .step-labels {
    display: flex;
    flex-direction: column;
    margin-top: 0.4rem;
  }

  .step-name {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-text);
  }

  .step-time {
    font-size: 0.68rem;
    color: var(--c-text-muted);
  }

  /* Courier Card */
  .courier-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: rgba(234, 88, 12, 0.05);
    border: 1px dashed var(--c-primary);
    border-radius: var(--r-lg);
  }

  .courier-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .courier-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--c-primary);
    color: #ffffff;
    font-weight: 800;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .courier-role {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--c-primary);
  }

  .courier-name {
    font-size: 0.95rem;
    color: var(--c-text);
    display: block;
  }

  .courier-vehicle {
    font-size: 0.72rem;
    color: var(--c-text-muted);
  }

  .btn-call-courier {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    background: var(--c-surface);
    border: 1px solid var(--c-primary);
    color: var(--c-primary);
    border-radius: var(--r-md);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-call-courier:hover {
    background: var(--c-primary);
    color: #ffffff;
  }

  /* Address */
  .delivery-address-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 0.9rem;
  }

  .addr-icon {
    color: var(--c-primary);
    margin-top: 0.15rem;
  }

  .addr-text {
    display: flex;
    flex-direction: column;
  }

  .addr-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .addr-main {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--c-text);
  }

  .addr-sub {
    font-size: 0.75rem;
    color: var(--c-text-muted);
  }

  .addr-notes {
    font-size: 0.75rem;
    color: var(--c-text-subtle);
    font-style: italic;
    margin: 0.25rem 0 0;
  }

  /* Summary */
  .order-summary-box {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 1rem;
  }

  .summary-head {
    font-size: 0.85rem;
    font-weight: 800;
    margin: 0 0 0.75rem;
    color: var(--c-text);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .summary-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--c-border);
  }

  .summary-item-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.82rem;
  }

  .it-qty {
    font-weight: 800;
    color: var(--c-primary);
    margin-right: 0.35rem;
  }

  .it-name {
    color: var(--c-text);
    font-weight: 600;
  }

  .it-mods {
    font-size: 0.72rem;
    color: var(--c-text-muted);
    margin-left: 0.25rem;
  }

  .summary-totals {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }

  .tot-row {
    display: flex;
    justify-content: space-between;
  }

  .tot-total {
    font-size: 1rem;
    color: var(--c-text);
    padding-top: 0.4rem;
    border-top: 1px dashed var(--c-border);
    margin-top: 0.2rem;
  }
</style>
