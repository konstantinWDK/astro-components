---
/**
 * AgtHeading — Page heading for the AI-agents workspace: kicker, large title, description and an
 * action slot (buttons) aligned to the right on wide screens.
 *
 * @param {string} kicker - Small label above the title.
 * @param {string} title - Page title (h1).
 * @param {string} description - Short description.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: renders the page's single <h1>.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/ai-agents/agt-theme.css';

interface OwnProps {
  kicker?: string;
  title: string;
  description?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'header'>, keyof OwnProps | 'class'> & { class?: string };

const { kicker, title, description, class: classAttr, ...rest } = Astro.props;
---

<header class:list={['agt-ui', 'agt-head', classAttr]} {...rest}>
  <div>
    {kicker && <p class="ag-eyebrow">{kicker}</p>}
    <h1>{title}</h1>
    {description && <p class="agt-head__desc">{description}</p>}
  </div>
  <div class="agt-head__actions"><slot /></div>
</header>

<style>
  .agt-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-4, 1rem);
    margin-bottom: var(--sp-6, 1.5rem);
    color: var(--ag-text);
    font-family: var(--ag-font-body);
  }

  .agt-head h1 {
    margin: 0;
    font-family: var(--ag-font-display);
    font-weight: 750;
    font-size: clamp(1.9rem, 4.5vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .agt-head__desc {
    max-width: 58ch;
    margin: var(--sp-2, 0.5rem) 0 0;
    color: var(--ag-text-2);
  }

  .agt-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2, 0.5rem);
  }

  .agt-head__actions:empty {
    display: none;
  }
</style>
