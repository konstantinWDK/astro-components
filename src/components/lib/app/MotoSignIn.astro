---
/**
 * MotoSignIn — Split sign-in for the customer area: a large generated rod illustration with a customer quote on one side, the form (email, password with show/hide, remember me) on the other, plus a demo quick-access link and a link to join the club.
 *
 * Thin wrapper over the shared `AccountSignIn` split layout: it only picks this template's
 * illustration, copy and typography.
 *
 * @param {string} dashboardHref - Where a successful sign-in goes.
 * @param {string} joinHref - Link to the club page.
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} action - Backend endpoint. Empty runs a demo sign-in that redirects.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: see `AccountSignIn` (labelled fields, password toggle with aria-pressed, errors in
 * role="alert", visible focus rings and 48px controls; the illustration is decorative).
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/motocross/moto-theme.css';
import MotoArt from './MotoArt.astro';
import { motoProducts } from '../templates/motocross/data';
import AccountSignIn from './AccountSignIn.astro';

interface OwnProps {
  dashboardHref?: string;
  joinHref?: string;
  homeHref?: string;
  action?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const { dashboardHref = '/cuenta', joinHref = '/tienda', homeHref = '/', action = '', ...rest } = Astro.props;
const item = motoProducts[1];
---

<AccountSignIn
  themeClass="moto-ui"
  tokenPrefix="mt"
  brand="Barro"
  quote="Pido el miércoles y el domingo ya estoy en la pista. Desde mi garaje sé cuándo toca cambiar el aceite sin acordarme yo."
  author="Dani Ferrer · piloto de club desde 2022"
  eyebrow="Mi garaje"
  heading="Bienvenido de nuevo"
  joinPrompt="¿Primera vez?"
  joinLabel="Ve a la tienda"
  homeHref={homeHref}
  dashboardHref={dashboardHref}
  joinHref={joinHref}
  action={action}
  brandWeight={700}
  quoteWeight={600}
  {...rest}
>
  <Fragment slot="art"><MotoArt item={item} decorative /></Fragment>
</AccountSignIn>
