---
/**
 * WineSignIn — Split sign-in for the members area: a large generated wine label with a member quote on one side, the form (email, password with show/hide, remember me) on the other, plus a demo quick-access link and a link to join the club.
 *
 * Thin wrapper over the shared `AccountSignIn` split layout: it only picks this template's
 * illustration, copy and typography.
 *
 * @param {string} dashboardHref - Where a successful sign-in goes.
 * @param {string} joinHref - Link to the club page.
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} action - Backend endpoint. Empty runs a demo sign-in that redirects.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: see `AccountSignIn` (labelled fields, password toggle with aria-pressed, errors in
 * role="alert", visible focus rings and 48px controls; the illustration is decorative).
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/winery/wine-theme.css';
import WineBottleLabel from './WineBottleLabel.astro';
import { wineList } from '../templates/winery/data';
import AccountSignIn from './AccountSignIn.astro';

interface OwnProps {
  dashboardHref?: string;
  joinHref?: string;
  homeHref?: string;
  action?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const { dashboardHref = '/socios', joinHref = '/club', homeHref = '/', action = '', ...rest } = Astro.props;
const wine = wineList.find((w) => w.id === 'madre') ?? wineList[0];
---

<AccountSignIn
  themeClass="wine-ui"
  tokenPrefix="wn"
  brand="Solera"
  quote="Cada trimestre abro la caja y sé qué estoy bebiendo, de qué parcela viene y cuándo toca abrirlo. Es como tener un viñedo en casa."
  author="Lucía Ferrer · socia desde 2023"
  eyebrow="Área de socios"
  heading="Bienvenida de nuevo"
  joinPrompt="¿Aún no eres socia o socio?"
  joinLabel="Descubre el club"
  homeHref={homeHref}
  dashboardHref={dashboardHref}
  joinHref={joinHref}
  action={action}
  brandStyle="italic"
  quoteStyle="italic"
  {...rest}
>
  <Fragment slot="art"><WineBottleLabel wine={wine} variant="label" decorative /></Fragment>
</AccountSignIn>
