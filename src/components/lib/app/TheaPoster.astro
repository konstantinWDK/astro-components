---
/**
 * TheaPoster — Show poster drawn in SVG from a show's data: four styles (curtain, spot, mask, stage)
 * built from its three-colour palette and a seed, with the title set in the display serif, the genre
 * and the venue. Every show gets its own repeatable poster. No images needed.
 *
 * @param {TheaShow} show - Show to draw (palette, seed, style, title, genre, venue).
 * @param {boolean} decorative - Hide from assistive tech (use when the title is next to it).
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: exposed as an image with the title, genre and venue, or aria-hidden when decorative.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/theater/thea-theme.css';
import { theaShows, theaRng, type TheaShow } from '../templates/theater/data';

interface OwnProps {
  show?: TheaShow;
  decorative?: boolean;
}

type Props = OwnProps & Omit<HTMLAttributes<'figure'>, keyof OwnProps | 'class'> & { class?: string };

const { show = theaShows[0], decorative = false, class: classAttr, ...rest } = Astro.props;

const rnd = theaRng(show.seed);
const [c1, c2, c3] = show.palette;
const uid = `tp-${show.id}-${Math.random().toString(36).slice(2, 6)}`;
const f = (n: number) => Math.round(n * 10) / 10;

// title in up to three lines
const words = show.title.split(' ');
const lines: string[] = [];
let cur = '';
for (const w of words) {
  if ((cur + ' ' + w).trim().length > 13 && cur) { lines.push(cur); cur = w; } else cur = (cur + ' ' + w).trim();
}
if (cur) lines.push(cur);
const titleLines = lines.slice(0, 4);
const fs = titleLines.length > 2 ? 27 : 32;
const startY = 296 - (titleLines.length - 1) * (fs + 2);

const stars = Array.from({ length: 26 }, () => ({ x: f(rnd() * 300), y: f(rnd() * 190), r: f(0.6 + rnd() * 1.4) }));
const headX = 150 + (rnd() - 0.5) * 70;
const folds = Array.from({ length: 9 }, (_, i) => i);
const aria = decorative ? undefined : `Cartel de ${show.title}, ${show.genre} en ${show.venue}`;
---

<figure class:list={['thea-ui', 'thea-poster', classAttr]} {...rest}>
  <svg viewBox="0 0 300 400" role={decorative ? undefined : 'img'} aria-label={aria} aria-hidden={decorative ? 'true' : undefined} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={c3}></stop>
        <stop offset="1" stop-color={c1} stop-opacity="0.55"></stop>
      </linearGradient>
      <radialGradient id={`${uid}-spot`} cx="0.5" cy="0.2" r="0.8">
        <stop offset="0" stop-color={c2} stop-opacity="0.95"></stop>
        <stop offset="1" stop-color={c2} stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id={`${uid}-fold`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#000" stop-opacity="0.45"></stop>
        <stop offset="0.5" stop-color="#fff" stop-opacity="0.12"></stop>
        <stop offset="1" stop-color="#000" stop-opacity="0.45"></stop>
      </linearGradient>
      <linearGradient id={`${uid}-fade`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.55" stop-color={c3} stop-opacity="0"></stop>
        <stop offset="1" stop-color={c3} stop-opacity="0.92"></stop>
      </linearGradient>
    </defs>

    <rect width="300" height="400" fill={`url(#${uid}-bg)`}></rect>

    {show.style === 'curtain' && (
      <g>
        <ellipse cx="150" cy="150" rx="120" ry="140" fill={`url(#${uid}-spot)`}></ellipse>
        <g>
          {folds.map((i) => (
            <rect x={f(i * 18)} y="0" width="18" height="330" fill={c1} opacity={i % 2 ? 0.92 : 1}></rect>
          ))}
          {folds.map((i) => (<rect x={f(i * 18)} y="0" width="18" height="330" fill={`url(#${uid}-fold)`}></rect>))}
        </g>
        <g transform="translate(300 0) scale(-1 1)">
          {folds.map((i) => (
            <rect x={f(i * 18)} y="0" width="18" height="330" fill={c1} opacity={i % 2 ? 0.92 : 1}></rect>
          ))}
          {folds.map((i) => (<rect x={f(i * 18)} y="0" width="18" height="330" fill={`url(#${uid}-fold)`}></rect>))}
        </g>
        <path d="M0 0 H300 V26 Q150 70 0 26 Z" fill={c1}></path>
        <path d="M0 26 Q150 70 300 26" fill="none" stroke={c2} stroke-width="3"></path>
      </g>
    )}

    {show.style === 'spot' && (
      <g>
        <polygon points="120,0 180,0 270,330 30,330" fill={`url(#${uid}-spot)`} opacity="0.85"></polygon>
        <ellipse cx="150" cy="332" rx="118" ry="16" fill={c2} opacity="0.55"></ellipse>
        <g fill="#000" opacity="0.88">
          <circle cx={f(headX)} cy="236" r="12"></circle>
          <path d={`M${f(headX - 20)} 332 Q${f(headX - 18)} 258 ${f(headX)} 252 Q${f(headX + 18)} 258 ${f(headX + 20)} 332 Z`}></path>
        </g>
      </g>
    )}

    {show.style === 'mask' && (
      <g>
        {stars.map((s) => (<circle cx={s.x} cy={s.y} r={s.r} fill={c2} opacity="0.7"></circle>))}
        <g transform="translate(88 170) rotate(-12)">
          <path d="M-52 -60 Q0 -78 52 -60 Q58 10 0 66 Q-58 10 -52 -60 Z" fill={c2}></path>
          <ellipse cx="-20" cy="-20" rx="11" ry="7" fill={c3}></ellipse>
          <ellipse cx="20" cy="-20" rx="11" ry="7" fill={c3}></ellipse>
          <path d="M-24 22 Q0 44 24 22" fill="none" stroke={c3} stroke-width="5" stroke-linecap="round"></path>
        </g>
        <g transform="translate(212 196) rotate(14)" opacity="0.92">
          <path d="M-52 -60 Q0 -78 52 -60 Q58 10 0 66 Q-58 10 -52 -60 Z" fill={c1}></path>
          <ellipse cx="-20" cy="-20" rx="11" ry="7" fill={c3}></ellipse>
          <ellipse cx="20" cy="-20" rx="11" ry="7" fill={c3}></ellipse>
          <path d="M-24 40 Q0 18 24 40" fill="none" stroke={c3} stroke-width="5" stroke-linecap="round"></path>
        </g>
      </g>
    )}

    {show.style === 'stage' && (
      <g>
        {stars.map((s) => (<circle cx={s.x} cy={s.y} r={s.r} fill={c2} opacity="0.55"></circle>))}
        <path d="M30 330 V120 Q150 40 270 120 V330" fill="none" stroke={c2} stroke-width="5"></path>
        <path d="M44 330 V128 Q150 58 256 128 V330" fill="none" stroke={c2} stroke-width="1.5" opacity="0.6"></path>
        <polygon points="44,330 256,330 300,400 0,400" fill={c1} opacity="0.7"></polygon>
        {[0, 1, 2, 3, 4, 5].map((i) => (<line x1={f(44 + i * 42.4)} y1="330" x2={f(i * 60)} y2="400" stroke={c2} stroke-opacity="0.35"></line>))}
        <ellipse cx="150" cy="250" rx="70" ry="90" fill={`url(#${uid}-spot)`} opacity="0.6"></ellipse>
        <path d={`M${f(headX - 8)} 335 Q${f(headX)} 250 ${f(headX + 8)} 335 Z`} fill={c2}></path>
        <circle cx={f(headX)} cy="244" r="9" fill={c2}></circle>
      </g>
    )}

    <rect width="300" height="400" fill={`url(#${uid}-fade)`}></rect>
    <text x="150" y="28" text-anchor="middle" font-size="9" letter-spacing="3.5" fill={c2} font-family="Figtree, sans-serif" font-weight="700">{show.genre.toUpperCase()}</text>
    {titleLines.map((l, i) => (
      <text x="150" y={startY + i * (fs + 2)} text-anchor="middle" font-size={fs} font-style="italic" font-weight="700" fill="#fff7ea" font-family="'Playfair Display', Georgia, serif">{l}</text>
    ))}
    <text x="150" y="386" text-anchor="middle" font-size="8.5" letter-spacing="1.8" fill={c2} font-family="Figtree, sans-serif" font-weight="600">{show.venue.toUpperCase()}</text>
  </svg>
</figure>

<style>
  .thea-poster {
    margin: 0;
    width: 100%;
    max-width: 420px;
  }

  .thea-poster svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    border-radius: 4px;
  }
</style>
