---
/**
 * BankTransactionsTable — Movements list: search, category and type filters, sorting by date or
 * amount, status badges, a running count and total, and a CSV export of the filtered rows.
 *
 * @param {BankTransaction[]} transactions - Rows to list.
 * @param {BankCategory[]} categories - Category definitions (filter options and badges).
 * @param {number} limit - Show only the first N rows, without filters. Default 0 = all.
 * @param {string} title - Card heading.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: real <table> with <caption>; sortable headers are buttons with aria-sort;
 * the count and total are an aria-live region; amounts show a +/− sign, not only colour;
 * status is text.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/fintech/bank-theme.css';
import { bankTransactions, bankCategories, formatBankMoney, formatBankDate, getBankCategory, type BankTransaction, type BankCategory } from '../templates/fintech/data';

interface OwnProps {
  transactions?: BankTransaction[];
  categories?: BankCategory[];
  limit?: number;
  title?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const { transactions = bankTransactions, categories = bankCategories, limit = 0, title = 'Movimientos', class: classAttr, ...rest } = Astro.props;

const uid = `btt-${Math.random().toString(36).slice(2, 8)}`;
const rows = [...transactions].sort((a, b) => b.date.localeCompare(a.date));
const list = limit > 0 ? rows.slice(0, limit) : rows;
const filters = limit === 0;
---

<section class:list={['bank-ui', 'bank-tx', classAttr]} aria-labelledby={`${uid}-title`} data-bank-tx {...rest}>
  <header class="bank-tx__head">
    <h2 id={`${uid}-title`} class="bank-tx__title">{title}</h2>
    {filters && <button type="button" class="bank-tx__export" data-tx-export>Exportar CSV</button>}
  </header>

  {filters && (
    <div class="bank-tx__tools">
      <div class="bank-tx__field bank-tx__field--grow"><label for={`${uid}-q`}>Buscar</label><input id={`${uid}-q`} type="search" placeholder="Comercio o cliente…" autocomplete="off" data-tx-q /></div>
      <div class="bank-tx__field"><label for={`${uid}-cat`}>Categoría</label>
        <select id={`${uid}-cat`} data-tx-cat><option value="">Todas</option>{categories.map((c) => <option value={c.id}>{c.name}</option>)}</select>
      </div>
      <div class="bank-tx__field"><label for={`${uid}-type`}>Tipo</label>
        <select id={`${uid}-type`} data-tx-type><option value="">Todos</option><option value="in">Ingresos</option><option value="out">Gastos</option></select>
      </div>
    </div>
    <p class="bank-tx__count" role="status" aria-live="polite" data-tx-count></p>
  )}

  <div class="bank-tx__scroll" tabindex="0" role="region" aria-label="Tabla de movimientos, desplazable">
    <table>
      <caption class="bk-sr">Movimientos de la cuenta</caption>
      <thead>
        <tr>
          <th scope="col" aria-sort={filters ? 'descending' : undefined} data-sort-th="date">{filters ? <button type="button" data-tx-sort="date">Fecha<span aria-hidden="true"></span></button> : 'Fecha'}</th>
          <th scope="col">Concepto</th>
          <th scope="col">Categoría</th>
          <th scope="col">Estado</th>
          <th scope="col" class="is-num" aria-sort={filters ? 'none' : undefined} data-sort-th="amount">{filters ? <button type="button" data-tx-sort="amount">Importe<span aria-hidden="true"></span></button> : 'Importe'}</th>
        </tr>
      </thead>
      <tbody data-tx-body>
        {list.map((t) => {
          const cat = getBankCategory(t.category, categories);
          return (
            <tr data-row data-merchant={t.merchant.toLowerCase()} data-cat={t.category} data-date={t.date} data-amount={t.amount} data-label={`${t.date};${t.merchant};${cat?.name};${t.status};${t.amount}`}>
              <td class="bank-tx__date">{formatBankDate(t.date)}</td>
              <th scope="row" class="bank-tx__merchant">{t.merchant}</th>
              <td><span class="bank-tx__cat" style={`--cat-hue:${cat?.hue ?? 160}`}>{cat?.name}</span></td>
              <td><span class:list={['bank-tx__status', `is-${t.status === 'Completado' ? 'ok' : t.status === 'Pendiente' ? 'wait' : 'bad'}`]}>{t.status}</span></td>
              <td class:list={['is-num', 'bank-tx__amount', t.amount > 0 && 'is-in']}>{t.amount > 0 ? '+' : '−'}{formatBankMoney(Math.abs(t.amount))}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="bank-tx__empty" hidden data-tx-empty>Ningún movimiento coincide con los filtros.</p>
</section>

<script>
  function initTx(root: HTMLElement) {
    if (root.dataset.bound) return;
    root.dataset.bound = 'true';
    const q = root.querySelector<HTMLInputElement>('[data-tx-q]');
    if (!q) return;
    const cat = root.querySelector<HTMLSelectElement>('[data-tx-cat]')!;
    const type = root.querySelector<HTMLSelectElement>('[data-tx-type]')!;
    const body = root.querySelector<HTMLElement>('[data-tx-body]')!;
    const count = root.querySelector<HTMLElement>('[data-tx-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-tx-empty]')!;
    const rows = Array.from(body.querySelectorAll<HTMLTableRowElement>('[data-row]'));
    const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });
    let key = 'date';
    let dir = -1;

    const apply = () => {
      const term = q.value.trim().toLowerCase();
      const sorted = [...rows].sort((a, b) => {
        const av = key === 'date' ? a.dataset.date! : Number(a.dataset.amount);
        const bv = key === 'date' ? b.dataset.date! : Number(b.dataset.amount);
        return (av > bv ? 1 : av < bv ? -1 : 0) * dir;
      });
      let n = 0;
      let net = 0;
      sorted.forEach((r) => {
        const amount = Number(r.dataset.amount);
        const ok =
          (!term || (r.dataset.merchant ?? '').includes(term)) &&
          (!cat.value || r.dataset.cat === cat.value) &&
          (!type.value || (type.value === 'in' ? amount > 0 : amount < 0));
        r.hidden = !ok;
        if (ok) { n++; net += amount; }
        body.appendChild(r);
      });
      count.textContent = `${n} ${n === 1 ? 'movimiento' : 'movimientos'} · balance ${net > 0 ? '+' : ''}${eur.format(net)}`;
      empty.hidden = n > 0;
    };

    [q, cat, type].forEach((el) => el.addEventListener(el === q ? 'input' : 'change', apply));
    root.querySelectorAll<HTMLButtonElement>('[data-tx-sort]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const k = btn.dataset.txSort ?? 'date';
        dir = key === k ? -dir : -1;
        key = k;
        root.querySelectorAll<HTMLElement>('[data-sort-th]').forEach((th) => th.setAttribute('aria-sort', th.dataset.sortTh === k ? (dir === 1 ? 'ascending' : 'descending') : 'none'));
        apply();
      }),
    );
    root.querySelector<HTMLButtonElement>('[data-tx-export]')?.addEventListener('click', () => {
      const lines = ['fecha;concepto;categoria;estado;importe', ...rows.filter((r) => !r.hidden).map((r) => r.dataset.label)];
      const url = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: 'movimientos.csv' });
      a.click();
      URL.revokeObjectURL(url);
    });
    apply();
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('[data-bank-tx]').forEach(initTx);
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>

<style>
  .bank-tx {
    min-width: 0;
    padding: var(--sp-5, 1.25rem);
    border: 1px solid var(--bk-border);
    border-radius: var(--r-xl, 24px);
    background: var(--bk-bg-raised);
    color: var(--bk-text);
    font-family: var(--bk-font-body);
  }

  .bank-tx__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3, 0.75rem);
    margin-bottom: var(--sp-3, 0.75rem);
  }

  .bank-tx__title {
    margin: 0;
    font-family: var(--bk-font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }

  .bank-tx__export {
    min-height: 44px;
    padding: 0 var(--sp-4, 1rem);
    border: 1px solid var(--bk-border-strong);
    border-radius: var(--r-full, 999px);
    background: transparent;
    color: var(--bk-brand);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .bank-tx__export:hover {
    border-color: var(--bk-brand);
  }

  .bank-tx__tools {
    display: grid;
    gap: var(--sp-3, 0.75rem);
    margin-bottom: var(--sp-3, 0.75rem);
  }

  .bank-tx__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bank-tx__field label {
    color: var(--bk-text-3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .bank-tx__field input,
  .bank-tx__field select {
    min-height: 44px;
    padding: 0 var(--sp-3, 0.75rem);
    border: 1px solid var(--bk-border-strong);
    border-radius: var(--r-md, 12px);
    background: var(--bk-surface);
    color: var(--bk-text);
    font: inherit;
  }

  .bank-tx__field input:focus-visible,
  .bank-tx__field select:focus-visible,
  .bank-tx__export:focus-visible,
  .bank-tx__scroll:focus-visible,
  .bank-tx button:focus-visible {
    outline: 2px solid var(--bk-brand);
    outline-offset: 2px;
  }

  .bank-tx__count {
    margin: 0 0 var(--sp-2, 0.5rem);
    color: var(--bk-text-3);
    font-size: 0.85rem;
  }

  .bank-tx__scroll {
    position: relative;
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  th,
  td {
    padding: var(--sp-3, 0.75rem);
    border-top: 1px solid var(--bk-border);
    text-align: left;
    vertical-align: middle;
  }

  thead th {
    border-top: 0;
    color: var(--bk-text-3);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  thead button {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  thead th[aria-sort='ascending'] button span::after { content: '▲'; font-size: 0.7em; color: var(--bk-brand); }
  thead th[aria-sort='descending'] button span::after { content: '▼'; font-size: 0.7em; color: var(--bk-brand); }

  tbody tr[hidden] {
    display: none;
  }

  .is-num {
    text-align: right;
  }

  .bank-tx__date {
    color: var(--bk-text-3);
    white-space: nowrap;
  }

  .bank-tx__merchant {
    font-weight: 600;
  }

  .bank-tx__cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--bk-text-2);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .bank-tx__cat::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: hsl(var(--cat-hue) 70% 58%);
  }

  .bank-tx__status {
    padding: 0.15rem 0.6rem;
    border-radius: var(--r-full, 999px);
    background: var(--bk-surface);
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .bank-tx__status.is-ok { color: var(--bk-ok); }
  .bank-tx__status.is-wait { color: var(--bk-warn); }
  .bank-tx__status.is-bad { color: var(--bk-bad); }

  .bank-tx__amount {
    font-family: var(--bk-font-mono);
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .bank-tx__amount.is-in {
    color: var(--bk-mint);
  }

  .bank-tx__empty {
    margin: var(--sp-4, 1rem) 0 0;
    color: var(--bk-text-2);
    text-align: center;
  }

  @media (min-width: 720px) {
    .bank-tx__tools {
      grid-template-columns: 1fr 200px 160px;
    }
  }
</style>
