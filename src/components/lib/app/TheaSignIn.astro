---
/**
 * TheaSignIn — Split sign-in for the customer area: a large generated show poster with a customer quote on one side, the form (email, password with show/hide, remember me) on the other, plus a demo quick-access link and a link to join the club.
 *
 * Thin wrapper over the shared `AccountSignIn` split layout: it only picks this template's
 * illustration, copy and typography.
 *
 * @param {string} dashboardHref - Where a successful sign-in goes.
 * @param {string} joinHref - Link to the club page.
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} action - Backend endpoint. Empty runs a demo sign-in that redirects.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: see `AccountSignIn` (labelled fields, password toggle with aria-pressed, errors in
 * role="alert", visible focus rings and 48px controls; the illustration is decorative).
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/theater/thea-theme.css';
import TheaPoster from './TheaPoster.astro';
import { theaShows } from '../templates/theater/data';
import AccountSignIn from './AccountSignIn.astro';

interface OwnProps {
  dashboardHref?: string;
  joinHref?: string;
  homeHref?: string;
  action?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const { dashboardHref = '/cuenta', joinHref = '/cartelera', homeHref = '/', action = '', ...rest } = Astro.props;
const show = theaShows[0];
---

<AccountSignIn
  themeClass="thea-ui"
  tokenPrefix="th"
  brand="Telón"
  quote="Elijo mi butaca en el plano, pago y la entrada ya está en el móvil. La última vez entré con el QR sin sacar la cartera."
  author="Clara Domínguez · abonada desde 2023"
  eyebrow="Mis entradas"
  heading="Bienvenida de nuevo"
  joinPrompt="¿Primera vez?"
  joinLabel="Mira la cartelera"
  homeHref={homeHref}
  dashboardHref={dashboardHref}
  joinHref={joinHref}
  action={action}
  brandStyle="italic"
  brandWeight={700}
  quoteWeight={600}
  {...rest}
>
  <Fragment slot="art"><TheaPoster show={show} decorative /></Fragment>
</AccountSignIn>
