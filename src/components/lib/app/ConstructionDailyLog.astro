---
/**
 * ConstructionDailyLog — Daily site inspection journal (Cuaderno de Bitácora / Libro de Órdenes de Obra).
 * Records meteorological conditions, active trade counts, material deliveries with quality tickets,
 * occupational safety checks, and technical supervisor notes.
 *
 * @param {SiteDailyLog} log - Daily log record.
 * @param {string} className - Optional CSS class.
 */
import type { SiteDailyLog } from '../templates/construction/data';
import { siteDailyLogs } from '../templates/construction/data';

interface Props {
  log?: SiteDailyLog;
  className?: string;
}

const {
  log = siteDailyLogs[0],
  className = '',
} = Astro.props;
---

<div class={`construction-daily-log ${className}`}>
  <!-- Journal Top Ribbon -->
  <div class="log-ribbon">
    <div class="ribbon-left">
      <span class="ribbon-id">PARTE DIARIO DE OBRA #{log.id.toUpperCase()}</span>
      <h3 class="ribbon-site">{log.siteName}</h3>
      <span class="ribbon-date">📅 Fecha de reporte: <strong>{log.date}</strong></span>
    </div>

    <!-- Weather Widget -->
    <div class="weather-box">
      <div class="weather-icon">
        {log.weather.condition === 'Sunny' ? '☀️' :
         log.weather.condition === 'Rain' ? '🌧️' :
         log.weather.condition === 'Wind' ? '💨' : '⛅'}
      </div>
      <div class="weather-info">
        <span class="weather-temp">{log.weather.tempC}°C · {log.weather.condition}</span>
        <span class="weather-sub">Viento: {log.weather.windKmh} km/h · Lluvia: {log.weather.rainMm} mm</span>
      </div>
      <div class="safety-stamp">
        <span class="stamp-check">✓</span>
        <span>Seguridad Apta</span>
      </div>
    </div>
  </div>

  <div class="log-grid">
    <!-- Active Trades & Subcontractors -->
    <div class="log-card">
      <div class="card-head">
        <h4 class="card-title">Gremios &amp; Subcontratas Activas</h4>
        <span class="crew-total-badge">👷 <strong>{log.crewTotal}</strong> operarios en obra</span>
      </div>

      <div class="trades-list">
        {log.activeTrades.map((t) => (
          <div class="trade-row">
            <div class="trade-main">
              <strong class="trade-name">{t.trade}</strong>
              <span class="sub-name">{t.subcontractor}</span>
              <span class="trade-zone">📍 Zona: {t.zone}</span>
            </div>
            <div class="trade-count">
              <span class="count-num">{t.workers}</span>
              <span class="count-lbl">trabajadores</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Material Deliveries & Quality Control -->
    <div class="log-card">
      <div class="card-head">
        <h4 class="card-title">Acopio de Materiales &amp; Control de Calidad</h4>
        <span class="deliveries-count">{log.materialDeliveries.length} albaranes hoy</span>
      </div>

      <div class="materials-list">
        {log.materialDeliveries.map((m) => (
          <div class="material-row">
            <div class="mat-details">
              <strong class="mat-name">{m.material}</strong>
              <span class="mat-supplier">Proveedor: {m.supplier}</span>
            </div>
            <div class="mat-qty-box">
              <span class="mat-qty">{m.quantity}</span>
              <span class="mat-ticket">🎫 {m.qualityTicket}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Safety Check -->
      <div class="safety-banner">
        <div class="safety-icon">🛡️</div>
        <div class="safety-text">
          <strong>Inspección de Seguridad y Salud (PRL): Aprobada</strong>
          <span>EPIS reglamentarios, líneas de vida revisadas y perímetro señalizado sin no-conformidades.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Supervisor Daily Observations / Logbook -->
  <div class="journal-entry-card">
    <div class="journal-head">
      <span class="journal-icon">📝</span>
      <h4 class="journal-title">Observaciones Técnicas y Avance de Jornada</h4>
    </div>
    <p class="journal-notes">{log.notes}</p>

    <div class="journal-signature">
      <div class="sig-stamp">
        <span class="sig-seal">STRUKTO CONTROL TÉCNICO</span>
        <span class="sig-name">{log.supervisor}</span>
        <span class="sig-cert">Colegiado COAATM nº 14.892 · Firma Digitalizada</span>
      </div>
    </div>
  </div>
</div>

<style>
  .construction-daily-log {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2rem;
    color: #f8fafc;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .log-ribbon {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  .ribbon-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ribbon-id {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 800;
    color: #f59e0b;
    letter-spacing: 0.08em;
  }

  .ribbon-site {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .ribbon-date {
    font-size: 0.82rem;
    color: #94a3b8;
  }

  .ribbon-date strong {
    color: #ffffff;
  }

  /* Weather Widget */
  .weather-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }

  .weather-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .weather-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .weather-temp {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
  }

  .weather-sub {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .safety-stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    color: #34d399;
  }

  .stamp-check {
    font-weight: 900;
  }

  /* Grid */
  .log-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .log-grid {
      grid-template-columns: 1fr;
    }
  }

  .log-card {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .crew-total-badge, .deliveries-count {
    font-size: 0.75rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .crew-total-badge strong {
    color: #f59e0b;
  }

  /* Trades list */
  .trades-list, .materials-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .trade-row, .material-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    gap: 1rem;
  }

  .trade-main, .mat-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .trade-name, .mat-name {
    font-size: 0.85rem;
    color: #ffffff;
  }

  .sub-name, .mat-supplier {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .trade-zone {
    font-size: 0.7rem;
    color: #64748b;
  }

  .trade-count {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(245, 158, 11, 0.12);
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .count-num {
    font-size: 1.1rem;
    font-weight: 800;
    color: #f59e0b;
    line-height: 1;
  }

  .count-lbl {
    font-size: 0.62rem;
    color: #cbd5e1;
  }

  .mat-qty-box {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
  }

  .mat-qty {
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
  }

  .mat-ticket {
    font-size: 0.68rem;
    color: #38bdf8;
    font-family: monospace;
  }

  /* Safety banner */
  .safety-banner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 10px;
    margin-top: auto;
  }

  .safety-icon {
    font-size: 1.4rem;
  }

  .safety-text {
    display: flex;
    flex-direction: column;
    font-size: 0.75rem;
    gap: 0.15rem;
  }

  .safety-text strong {
    color: #34d399;
  }

  .safety-text span {
    color: #94a3b8;
  }

  /* Journal card */
  .journal-entry-card {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .journal-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .journal-icon {
    font-size: 1.2rem;
  }

  .journal-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .journal-notes {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
    background: rgba(0, 0, 0, 0.25);
    padding: 1rem;
    border-radius: 8px;
    border-left: 3px solid #f59e0b;
  }

  .journal-signature {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.5rem;
  }

  .sig-stamp {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    padding: 0.65rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: 8px;
  }

  .sig-seal {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #f59e0b;
  }

  .sig-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
  }

  .sig-cert {
    font-size: 0.68rem;
    color: #64748b;
  }
</style>
