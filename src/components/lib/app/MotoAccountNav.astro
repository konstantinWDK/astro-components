---
/**
 * MotoAccountNav — Navigation of the members area: wordmark plus text tabs in a header row on
 * desktop, and a fixed bottom tab bar on phones. Text only (no icons), no JavaScript.
 *
 * Thin wrapper over the shared `AccountNav`: it only chooses this template's copy and typography.
 *
 * @param {Array<{label: string, href: string, badge?: string|number}>} items - Links (keep 3–5).
 * @param {string} currentHref - Marks the matching link with aria-current="page".
 * @param {string} brand - Motocross name (desktop only; phones show it in the top bar).
 * @param {string} homeHref - Link of the wordmark.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: <nav> landmark with aria-label; aria-current on the active link; 56px tap targets
 * on the bottom bar; badges are announced as text.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/motocross/moto-theme.css';
import AccountNav from './AccountNav.astro';

interface Item { label: string; href: string; badge?: string | number }

interface OwnProps {
  items?: Item[];
  currentHref?: string;
  brand?: string;
  homeHref?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'nav'>, keyof OwnProps | 'class'> & { class?: string };

const {
  items = [
    { label: 'Resumen', href: '#' },
    { label: 'Pedidos', href: '#pedidos' },
    { label: 'Deseos', href: '#deseos' },
  ],
  currentHref = '#',
  brand = 'Barro',
  homeHref = '#',
  ...rest
} = Astro.props;
---

<AccountNav
  themeClass="moto-ui"
  tokenPrefix="mt"
  ariaLabel="Área de cliente"
  items={items}
  currentHref={currentHref}
  brand={brand}
  homeHref={homeHref}
  {...rest}
/>
