---
/**
 * UnivCampus — Interactive campus facilities, student life, clubs and international exchange showcase.
 *
 * @param {Record<string, string>} routes - Route map
 * @param {string} className - Optional additional CSS class
 */
import type { HTMLAttributes } from 'astro/types';
import { campusFacilities, univRoutes } from '../templates/university/data';

interface Props extends HTMLAttributes<'section'> {
  routes?: typeof univRoutes;
  className?: string;
}

const {
  routes = univRoutes,
  class: classProp,
  className = '',
  ...rest
} = Astro.props;

const classes = ['univ-campus', classProp, className].filter(Boolean).join(' ');
---

<section class={classes} id="campus-instalaciones" {...rest}>
  <div class="univ-campus__container">
    <div class="univ-campus__header">
      <div class="univ-campus__eyebrow">UN CAMPUS UNIVERSITARIO VIBRANTE</div>
      <h2 class="univ-campus__title">Instalaciones de Primer Nivel para Aprender y Vivir</h2>
      <p class="univ-campus__lead">
        Más de 140.000 m² de espacios verdes, laboratorios de prototipado 24 horas, residencia universitaria en el propio recinto y una comunidad internacional procedente de 68 países.
      </p>
    </div>

    <!-- Facilities Grid -->
    <div class="univ-campus__grid">
      {campusFacilities.map((fac) => (
        <div class="univ-campus__card">
          <div class="univ-campus__card-header">
            <span class="univ-campus__category">{fac.category}</span>
            <span class="univ-campus__capacity">{fac.capacity}</span>
          </div>

          <h3 class="univ-campus__name">{fac.name}</h3>
          <p class="univ-campus__desc">{fac.description}</p>

          <div class="univ-campus__highlights">
            <span class="univ-campus__hl-label">Puntos destacados:</span>
            <ul class="univ-campus__hl-list">
              {fac.highlights.map((h) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="univ-campus__check" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="univ-campus__schedule">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="univ-campus__clock" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{fac.schedule}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Student Life & Global Mobility Strip -->
    <div class="univ-campus__life-strip">
      <div class="univ-campus__life-col">
        <h3 class="univ-campus__life-title">Clubes y Vida Estudiantil</h3>
        <p class="univ-campus__life-desc">
          Más de 30 asociaciones estudiantiles organizadas por alumnos: Veritas Robotics Team, Sociedad de Debate Parlamentario, Club de Inversión & FinTech, Club de Teatro y Club de Voluntariado Social.
        </p>
        <div class="univ-campus__pills">
          <span class="univ-campus__pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="18" height="12" x="3" y="6" rx="2"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><path d="M12 2v4"/><path d="m8 2 2 4"/><path d="m16 2-2 4"/></svg>
            Robotics Formula Student
          </span>
          <span class="univ-campus__pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
            Debate & MUN Model UN
          </span>
          <span class="univ-campus__pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Veritas Investment Fund
          </span>
          <span class="univ-campus__pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="5" r="2"/><path d="m9 20 3-6 3 6"/><path d="m6 8 6 2 6-2"/><path d="M12 10v4"/></svg>
            Equipo de Remo y Vela
          </span>
        </div>
      </div>

      <div class="univ-campus__life-col">
        <h3 class="univ-campus__life-title">Movilidad Global & Erasmus+</h3>
        <p class="univ-campus__life-desc">
          El 72% de nuestros graduados cursa al menos un semestre en universidades socias de primer orden en Estados Unidos, Reino Unido, Alemania, Japón o Singapur, con convalidación automática de créditos ECTS.
        </p>
        <div class="univ-campus__destinations">
          <span class="univ-campus__dest">University of California</span>
          <span class="univ-campus__dest">Imperial College London</span>
          <span class="univ-campus__dest">NUS Singapore</span>
          <span class="univ-campus__dest">TU Munich</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .univ-campus {
    padding: 5rem 0;
    background: var(--univ-navy-deep, #0a0f1d);
  }

  .univ-campus__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .univ-campus__header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }

  .univ-campus__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--univ-gold, #f59e0b);
    margin-bottom: 0.75rem;
  }

  .univ-campus__title {
    font-family: var(--univ-font-serif, serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .univ-campus__lead {
    font-size: 1.0625rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
  }

  /* Facilities Grid */
  .univ-campus__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .univ-campus__card {
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius, 12px);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .univ-campus__card:hover {
    transform: translateY(-4px);
    border-color: var(--univ-gold, #f59e0b);
  }

  .univ-campus__card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .univ-campus__category {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    background: var(--univ-gold-bg, rgba(245, 158, 11, 0.1));
    color: var(--univ-gold, #f59e0b);
    border-radius: 4px;
  }

  .univ-campus__capacity {
    font-size: 0.75rem;
    color: var(--univ-text-dim, #64748b);
    font-weight: 600;
  }

  .univ-campus__name {
    font-family: var(--univ-font-serif, serif);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.3;
    margin: 0 0 0.75rem;
  }

  .univ-campus__desc {
    font-size: 0.875rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .univ-campus__highlights {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--univ-border-subtle, #182548);
    margin-bottom: 1.25rem;
  }

  .univ-campus__hl-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--univ-text-dim, #64748b);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .univ-campus__hl-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .univ-campus__hl-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.4;
  }

  .univ-campus__check {
    color: var(--univ-gold, #f59e0b);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .univ-campus__schedule {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--univ-gold, #f59e0b);
    background: var(--univ-bg-surface, #101b38);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-weight: 500;
  }

  .univ-campus__clock {
    flex-shrink: 0;
  }

  /* Life Strip */
  .univ-campus__life-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    background: var(--univ-bg-card, #0d162d);
    border: 1px solid var(--univ-border, #1e2f5d);
    border-radius: var(--univ-radius, 12px);
    padding: 2.5rem;
  }

  .univ-campus__life-title {
    font-family: var(--univ-font-serif, serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    margin: 0 0 0.75rem;
  }

  .univ-campus__life-desc {
    font-size: 0.875rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }

  .univ-campus__pills,
  .univ-campus__destinations {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .univ-campus__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    background: var(--univ-bg-surface, #101b38);
    border: 1px solid var(--univ-border-subtle, #182548);
    padding: 0.3rem 0.6rem;
    border-radius: var(--univ-radius-full, 9999px);
    color: var(--univ-text, #f8fafc);
  }

  .univ-campus__pill svg {
    color: var(--univ-gold, #f59e0b);
    flex-shrink: 0;
  }

  .univ-campus__dest {
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--univ-gold-bg, rgba(245, 158, 11, 0.1));
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    color: var(--univ-gold, #f59e0b);
  }

  @media (max-width: 900px) {
    .univ-campus__grid {
      grid-template-columns: 1fr;
    }

    .univ-campus__life-strip {
      grid-template-columns: 1fr;
    }
  }
</style>

