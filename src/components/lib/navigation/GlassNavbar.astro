---
/**
 * GlassNavbar — Sticky top navigation bar with glassmorphism blur and smooth scroll behavior.
 *
 * @param {string} brand - Brand name or logo text (default: 'Astro Components')
 * @param {string} brandHref - URL for the brand link (default: '/')
 * @param {string} className - Optional additional CSS class
 */
interface Props {
  brand?: string;
  brandHref?: string;
  className?: string;
}

const {
  brand = 'Astro Components',
  brandHref = '/',
  className = '',
} = Astro.props;
---

<header class:list={['glass-nav', className]}>
  <div class="glass-nav__inner">
    <a href={brandHref} class="glass-nav__brand">
      <slot name="brand">{brand}</slot>
    </a>
    <nav class="glass-nav__links" aria-label="Main Navigation">
      <slot name="links" />
    </nav>
    <div class="glass-nav__actions">
      <slot name="actions" />
    </div>
  </div>
</header>

<style>
  .glass-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(10, 10, 20, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .glass-nav__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .glass-nav__brand {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #f1f5f9;
    text-decoration: none;
    background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .glass-nav__brand:hover {
    opacity: 0.9;
  }

  .glass-nav__links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    justify-content: center;
  }

  /* Support links wrapped inside a container slot div */
  .glass-nav__links :global(> div) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .glass-nav__links :global(a) {
    padding: 0.4rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #94a3b8;
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .glass-nav__links :global(a:hover) {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.06);
  }

  .glass-nav__links :global(a.active) {
    color: #ffffff;
    background: rgba(99, 102, 241, 0.15);
  }

  .glass-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Support actions wrapped inside a container slot div */
  .glass-nav__actions :global(> div) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .glass-nav__inner {
      padding: 0 1rem;
      gap: 0.75rem;
    }

    .glass-nav__links {
      display: none;
    }
  }
</style>
