---
import LogoWithGalaxy from '../LogoWithGalaxy.astro';
---
<aside class="sidebar">
  <div class="sidebar-logo">
    <LogoWithGalaxy size="small" />
  </div>
  <nav class="sidebar-nav">
    <a href="#" class="active">Overview</a>
    <a href="#">Projects</a>
    <a href="#">Team</a>
    <a href="#">Settings</a>
  </nav>
</aside>
<style>
  .sidebar { width: 260px; height: 100vh; background: #080b14; border-right: 1px solid rgba(255, 255, 255, 0.1); padding: 1.5rem; display: flex; flex-direction: column; gap: 2rem; }
  .sidebar-logo { width: 100%; display: flex; align-items: center; justify-content: center; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 0.5rem; }
  .sidebar-nav a { padding: 0.75rem 1rem; border-radius: 10px; color: #94a3b8; text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: 0.2s; }
  .sidebar-nav a:hover, .sidebar-nav a.active { background: rgba(255,255,255,0.05); color: #fff; }
</style>
