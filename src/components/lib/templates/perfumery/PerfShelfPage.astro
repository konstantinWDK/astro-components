---
/**
 * PerfShelfPage — The customer shelf with every bottle at its liquid level, and the layering lab with saved mixes.
 *
 * @param {PerfRoutes} routes - Template route URLs.
 * @param {typeof perfData} data - Fragrances, customer, shelf, orders and saved mixes.
 */
import PerfAccountLayout from './PerfAccountLayout.astro';
import PerfAccountHeading from '../../app/PerfAccountHeading.astro';
import PerfShelf from '../../app/PerfShelf.astro';
import PerfLayering from '../../app/PerfLayering.astro';
import { perfRoutes, perfData, type PerfRoutes } from './data';

interface Props {
  routes?: PerfRoutes;
  data?: typeof perfData;
}

const { routes = perfRoutes, data = perfData } = Astro.props;
---

<PerfAccountLayout title="Mi estantería" current="shelf" routes={routes}>
  <PerfAccountHeading kicker="Área de cliente" title="Mi estantería" description="Cuánto te queda de cada frasco y qué tal te sientan." />
  <PerfShelf shelf={data.shelf} fragrances={data.fragrances} reorderHref={routes.fragrances} />
  <section class="perf-app-section" id="capas" aria-labelledby="capas-title">
    <h2 id="capas-title">Laboratorio de capas</h2>
    <PerfLayering fragrances={data.fragrances} combos={data.combos} />
  </section>
</PerfAccountLayout>
