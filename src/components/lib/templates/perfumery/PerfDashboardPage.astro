---
/**
 * PerfDashboardPage — Customer home: the order in progress with its timeline, customer figures and the bottle running out.
 *
 * @param {PerfRoutes} routes - Template route URLs.
 * @param {typeof perfData} data - Fragrances, customer, shelf, orders and saved mixes.
 */
import PerfAccountLayout from './PerfAccountLayout.astro';
import PerfAccountHeading from '../../app/PerfAccountHeading.astro';
import PerfAccountSummary from '../../app/PerfAccountSummary.astro';
import { perfRoutes, perfData, type PerfRoutes } from './data';

interface Props {
  routes?: PerfRoutes;
  data?: typeof perfData;
}

const { routes = perfRoutes, data = perfData } = Astro.props;
---

<PerfAccountLayout title="Resumen" current="dashboard" routes={routes}>
  <PerfAccountHeading kicker="Área de cliente" title="Tu resumen" description="Dónde está tu pedido y qué frasco se te acaba." />
  <PerfAccountSummary member={data.member} order={data.orders[0]} shelf={data.shelf} fragrances={data.fragrances} ordersHref={routes.orders} shelfHref={routes.shelf} />
</PerfAccountLayout>
