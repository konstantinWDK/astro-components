---
/**
 * PerfDiscoverPage — Discovery: the four-question profile test and the 2 ml discovery-set builder with live total.
 *
 * @param {PerfRoutes} routes - Template route URLs.
 * @param {typeof perfData} data - Fragrances, materials, quiz, samples, FAQs, customer, shelf and orders.
 * @param {string} action - Backend endpoint for the set form. Empty shows a demo confirmation.
 */
import PerfSiteLayout from './PerfSiteLayout.astro';
import PerfQuiz from '../../sections/PerfQuiz.astro';
import PerfDiscovery from '../../sections/PerfDiscovery.astro';
import PerfFaq from '../../sections/PerfFaq.astro';
import { perfRoutes, perfData, type PerfRoutes } from './data';

interface Props {
  routes?: PerfRoutes;
  data?: typeof perfData;
  action?: string;
}

const { routes = perfRoutes, data = perfData, action = '' } = Astro.props;
---

<PerfSiteLayout
  title={`Descubrir · ${data.brand.name}`}
  description="Un test de cuatro preguntas y un set de viales de 2 ml para probar las fragancias en casa."
  current="discover"
  routes={routes}
>
  <PerfQuiz questions={data.quiz} fragrances={data.fragrances} headingLevel="h1" discoverHref="#set" />
  <PerfDiscovery fragrances={data.fragrances} perSample={data.discovery.perSample} freeFrom={data.discovery.freeShippingFrom} action={action} />
  <PerfFaq faqs={data.faqs} />
</PerfSiteLayout>
