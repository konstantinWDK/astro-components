---
/**
 * PerfSignInPage — Customer sign-in: a full-screen split with a generated flacon and the form.
 * Standalone document (no site header or footer).
 *
 * @param {PerfRoutes} routes - Template route URLs.
 * @param {string} action - Backend endpoint for the form. Empty runs a demo sign-in.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 */
import '../../../../styles/global.css';
import './perf-theme.css';
import PerfSignIn from '../../app/PerfSignIn.astro';
import { perfRoutes, type PerfRoutes } from './data';

interface Props {
  routes?: PerfRoutes;
  action?: string;
  theme?: 'light' | 'dark' | 'auto';
}

const { routes = perfRoutes, action = '', theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-perf" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso de clientes — Umbra</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="perf-si-body">
    <main id="main-content">
      <PerfSignIn dashboardHref={routes.dashboard} joinHref={routes.fragrances} homeHref={routes.home} action={action} />
    </main>
  </body>
</html>

<style>
  .perf-si-body {
    margin: 0;
    background: var(--pf-bg);
    color: var(--pf-text);
    font-family: var(--pf-font-body);
  }
</style>
