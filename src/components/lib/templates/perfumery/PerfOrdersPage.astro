---
/**
 * PerfOrdersPage — Orders as an accordion with timeline, carrier and tracking, and actions for orders still being prepared.
 *
 * @param {PerfRoutes} routes - Template route URLs.
 * @param {typeof perfData} data - Fragrances, customer, shelf, orders and saved mixes.
 */
import PerfAccountLayout from './PerfAccountLayout.astro';
import PerfAccountHeading from '../../app/PerfAccountHeading.astro';
import PerfOrderTracker from '../../app/PerfOrderTracker.astro';
import { perfRoutes, perfData, type PerfRoutes } from './data';

interface Props {
  routes?: PerfRoutes;
  data?: typeof perfData;
}

const { routes = perfRoutes, data = perfData } = Astro.props;
---

<PerfAccountLayout title="Pedidos" current="orders" routes={routes}>
  <PerfAccountHeading kicker="Área de cliente" title="Mis pedidos" description="Cada pedido con su seguimiento. Mientras se prepara aún puedes cambiarlo." />
  <PerfOrderTracker orders={data.orders} fragrances={data.fragrances} reorderHref={routes.fragrances} />
</PerfAccountLayout>
