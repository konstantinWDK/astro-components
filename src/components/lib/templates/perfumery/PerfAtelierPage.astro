---
/**
 * PerfAtelierPage — The atelier: raw materials with the kilos of matter per kilo of essence, and the evolution of each fragrance on skin.
 *
 * @param {PerfRoutes} routes - Template route URLs.
 * @param {typeof perfData} data - Fragrances, materials, quiz, samples, FAQs, customer, shelf and orders.
 */
import PerfSiteLayout from './PerfSiteLayout.astro';
import PerfAtelier from '../../sections/PerfAtelier.astro';
import PerfSkin from '../../sections/PerfSkin.astro';
import PerfFaq from '../../sections/PerfFaq.astro';
import { perfRoutes, perfData, type PerfRoutes } from './data';

interface Props {
  routes?: PerfRoutes;
  data?: typeof perfData;
}

const { routes = perfRoutes, data = perfData } = Astro.props;
---

<PerfSiteLayout
  title={`El atelier · ${data.brand.name}`}
  description="Siete materias primas, de dónde vienen y cuánto cuesta reunirlas. Y cómo evoluciona cada fragancia sobre la piel."
  current="atelier"
  routes={routes}
>
  <PerfAtelier materials={data.materials} headingLevel="h1" />
  <PerfSkin fragrances={data.fragrances} />
  <PerfFaq faqs={data.faqs} />
</PerfSiteLayout>
