---
/**
 * PerfHomePage — Home of the "Umbra" perfumery template: hero, three fragrances to start with, the evolution-on-skin scene and the atelier materials.
 *
 * @param {PerfRoutes} routes - Template route URLs.
 * @param {typeof perfData} data - Fragrances, materials, quiz, samples, FAQs, customer, shelf and orders.
 */
import PerfSiteLayout from './PerfSiteLayout.astro';
import PerfHero from '../../sections/PerfHero.astro';
import PerfCollection from '../../sections/PerfCollection.astro';
import PerfSkin from '../../sections/PerfSkin.astro';
import PerfAtelier from '../../sections/PerfAtelier.astro';
import { perfRoutes, perfData, type PerfRoutes } from './data';

interface Props {
  routes?: PerfRoutes;
  data?: typeof perfData;
}

const { routes = perfRoutes, data = perfData } = Astro.props;
---

<PerfSiteLayout
  title={`${data.brand.name} · Perfumería de autor en Madrid`}
  description="Seis fragancias de extracto al 25%, hechas a mano en Madrid. Atelier con cita y set de descubrimiento."
  routes={routes}
>
  <PerfHero fragrance={data.fragrances[0]} stats={data.stats} fragrancesHref={routes.fragrances} discoverHref={routes.discover} />
  <PerfCollection fragrances={data.fragrances.slice(0, 3)} title="Tres para empezar" discoverHref={routes.discover} />
  <PerfSkin fragrances={data.fragrances.slice(0, 4)} />
  <PerfAtelier materials={data.materials.slice(0, 3)} title="Lo que tarda en estar listo" />
</PerfSiteLayout>
