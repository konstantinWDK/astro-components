---
/**
 * PerfFragrancesPage — The six fragrances: the full rail with sizes and prices, and the olfactory map.
 *
 * @param {PerfRoutes} routes - Template route URLs.
 * @param {typeof perfData} data - Fragrances, materials, quiz, samples, FAQs, customer, shelf and orders.
 */
import PerfSiteLayout from './PerfSiteLayout.astro';
import PerfCollection from '../../sections/PerfCollection.astro';
import PerfMap from '../../sections/PerfMap.astro';
import PerfFaq from '../../sections/PerfFaq.astro';
import { perfRoutes, perfData, type PerfRoutes } from './data';

interface Props {
  routes?: PerfRoutes;
  data?: typeof perfData;
}

const { routes = perfRoutes, data = perfData } = Astro.props;
---

<PerfSiteLayout
  title={`Fragancias · ${data.brand.name}`}
  description="Las seis fragancias de Umbra con sus notas, tamaños y precios, y el mapa olfativo para elegir."
  current="fragrances"
  routes={routes}
>
  <PerfCollection fragrances={data.fragrances} title="Las seis" headingLevel="h1" discoverHref={routes.discover} />
  <PerfMap fragrances={data.fragrances} />
  <PerfFaq faqs={data.faqs} />
</PerfSiteLayout>
