---
/**
 * MotoDashboardPage — Customer home: the order on its way, rider figures and the garage with its maintenance plan.
 *
 * @param {MotoRoutes} routes - Template route URLs.
 * @param {typeof motoData} data - Customer, orders, wish list, products and garage.
 */
import MotoAccountLayout from './MotoAccountLayout.astro';
import MotoAccountHeading from '../../app/MotoAccountHeading.astro';
import MotoAccountSummary from '../../app/MotoAccountSummary.astro';
import { motoRoutes, motoData, type MotoRoutes } from './data';

interface Props {
  routes?: MotoRoutes;
  data?: typeof motoData;
}

const { routes = motoRoutes, data = motoData } = Astro.props;
---

<MotoAccountLayout title="Resumen" current="dashboard" routes={routes}>
  <MotoAccountHeading kicker="Mi garaje" title="Tu garaje" description="Tu pedido en camino y qué toca mantener en tu moto." />
  <MotoAccountSummary member={data.member} orders={data.orders} wishlist={data.wishlist} products={data.products} garage={data.garage} ordersHref={routes.orders} shopHref={routes.shop} />
</MotoAccountLayout>
