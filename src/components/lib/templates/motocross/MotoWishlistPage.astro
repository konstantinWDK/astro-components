---
/**
 * MotoWishlistPage — The wish list with move-to-cart and remove actions.
 *
 * @param {MotoRoutes} routes - Template route URLs.
 * @param {typeof motoData} data - Customer, orders, wish list, products and garage.
 */
import MotoAccountLayout from './MotoAccountLayout.astro';
import MotoAccountHeading from '../../app/MotoAccountHeading.astro';
import MotoWishlist from '../../app/MotoWishlist.astro';
import { motoRoutes, motoData, type MotoRoutes } from './data';

interface Props {
  routes?: MotoRoutes;
  data?: typeof motoData;
}

const { routes = motoRoutes, data = motoData } = Astro.props;
---

<MotoAccountLayout title="Deseos" current="wishlist" routes={routes}>
  <MotoAccountHeading kicker="Mi garaje" title="Mi lista de deseos" description="Lo que has guardado para la próxima carrera." />
  <MotoWishlist wishlist={data.wishlist} products={data.products} productHref={routes.product} shopHref={routes.shop} />
</MotoAccountLayout>
