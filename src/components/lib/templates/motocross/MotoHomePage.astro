---
/**
 * MotoHomePage — Home of the "Barro" motocross shop: a speed-stripes hero with a category list, the scroll-driven ride scene, the most requested products and FAQ.
 *
 * @param {MotoRoutes} routes - Template route URLs.
 * @param {typeof motoData} data - Products, sizes, FAQs, customer, orders, wish list and garage.
 */
import MotoSiteLayout from './MotoSiteLayout.astro';
import MotoHero from '../../sections/MotoHero.astro';
import MotoRide from '../../sections/MotoRide.astro';
import MotoShop from '../../sections/MotoShop.astro';
import MotoFaq from '../../sections/MotoFaq.astro';
import { motoRoutes, motoData, type MotoRoutes } from './data';

interface Props {
  routes?: MotoRoutes;
  data?: typeof motoData;
}

const { routes = motoRoutes, data = motoData } = Astro.props;
---

<MotoSiteLayout
  title={`${data.brand.name} · Motos y equipo de cross`}
  description="Motos puestas a punto en el taller, equipación con guía de tallas y financiación hasta 60 meses."
  routes={routes}
>
  <MotoHero products={data.products} stats={data.stats} shopHref={routes.shop} kitHref={routes.kit} />
  <MotoRide />
  <MotoShop products={data.products.slice(0, 6)} productHref={routes.product} title="Lo más pedido" />
  <MotoFaq faqs={data.faqs} />
</MotoSiteLayout>
