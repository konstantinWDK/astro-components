---
/**
 * MotoOrdersPage — Orders as an accordion with items, timeline, tracking and returns.
 *
 * @param {MotoRoutes} routes - Template route URLs.
 * @param {typeof motoData} data - Customer, orders, wish list, products and garage.
 */
import MotoAccountLayout from './MotoAccountLayout.astro';
import MotoAccountHeading from '../../app/MotoAccountHeading.astro';
import MotoOrders from '../../app/MotoOrders.astro';
import { motoRoutes, motoData, type MotoRoutes } from './data';

interface Props {
  routes?: MotoRoutes;
  data?: typeof motoData;
}

const { routes = motoRoutes, data = motoData } = Astro.props;
---

<MotoAccountLayout title="Pedidos" current="orders" routes={routes}>
  <MotoAccountHeading kicker="Mi garaje" title="Mis pedidos" description="Sigue cada envío y devuelve en 30 días." />
  <MotoOrders orders={data.orders} products={data.products} shopHref={routes.shop} />
</MotoAccountLayout>
