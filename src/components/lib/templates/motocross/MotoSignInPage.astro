---
/**
 * MotoSignInPage — Customer sign-in: a full-screen split with a generated bike and the form.
 * Standalone document (no site header or footer).
 *
 * @param {MotoRoutes} routes - Template route URLs.
 * @param {string} action - Backend endpoint for the form. Empty runs a demo sign-in.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 */
import '../../../../styles/global.css';
import './moto-theme.css';
import MotoSignIn from '../../app/MotoSignIn.astro';
import { motoRoutes, type MotoRoutes } from './data';

interface Props {
  routes?: MotoRoutes;
  action?: string;
  theme?: 'light' | 'dark' | 'auto';
}

const { routes = motoRoutes, action = '', theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-moto" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mi garaje — Barro</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="moto-si-body">
    <main id="main-content">
      <MotoSignIn dashboardHref={routes.dashboard} joinHref={routes.shop} homeHref={routes.home} action={action} />
    </main>
  </body>
</html>

<style>
  .moto-si-body {
    margin: 0;
    background: var(--mt-bg);
    color: var(--mt-text);
    font-family: var(--mt-font-body);
  }
</style>
