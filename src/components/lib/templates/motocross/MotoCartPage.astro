---
/**
 * MotoCartPage — Cart and checkout with quantity steppers, free-shipping progress, a promo code and a demo payment.
 *
 * @param {MotoRoutes} routes - Template route URLs.
 * @param {typeof motoData} data - Products, sizes, FAQs, customer, orders, wish list and garage.
 */
import MotoSiteLayout from './MotoSiteLayout.astro';
import MotoCart from '../../sections/MotoCart.astro';
import { motoRoutes, motoData, type MotoRoutes } from './data';

interface Props {
  routes?: MotoRoutes;
  data?: typeof motoData;
}

const { routes = motoRoutes, data = motoData } = Astro.props;
---

<MotoSiteLayout
  title={`Carrito · ${data.brand.name}`}
  description="Revisa tu carrito, aplica un código y completa tu pedido."
  routes={routes}
>
  <MotoCart products={data.products} shopHref={routes.shop} ordersHref={routes.orders} />
</MotoSiteLayout>
