---
/**
 * MotoProductPage — The product page: options with live price, quantity, add to cart and save, and specs. Reads ?p=id.
 *
 * @param {MotoRoutes} routes - Template route URLs.
 * @param {typeof motoData} data - Products, sizes, FAQs, customer, orders, wish list and garage.
 */
import MotoSiteLayout from './MotoSiteLayout.astro';
import MotoProduct from '../../sections/MotoProduct.astro';
import MotoFaq from '../../sections/MotoFaq.astro';
import { motoRoutes, motoData, type MotoRoutes } from './data';

interface Props {
  routes?: MotoRoutes;
  data?: typeof motoData;
}

const { routes = motoRoutes, data = motoData } = Astro.props;
---

<MotoSiteLayout
  title={`Producto · ${data.brand.name}`}
  description="Ficha de producto con opciones, precio en vivo y especificaciones."
  current="shop"
  routes={routes}
>
  <MotoProduct products={data.products} cartHref={routes.cart} kitHref={routes.kit} />
  <MotoFaq faqs={data.faqs} />
</MotoSiteLayout>
