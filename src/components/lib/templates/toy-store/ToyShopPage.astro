---
/**
 * ToyShopPage — Toy store catalogue: breadcrumb, ProductToolbar with live count and sort, a
 * character avatar rail that filters by character, FilterSidebar with type, character, universe,
 * scale and age facets, and ToyFigureGrid. Every filter is shareable through the URL
 * (`?character=vex,raikou&universe=…&scale=6in&age=kids&category=figures&max=25`).
 *
 * Usage (src/pages/shop.astro):
 *   import { ToyShopPage } from 'astro-component-kit/templates/toy-store';
 *   <ToyShopPage />
 *
 * @param {ToyStore} store - Catalogue and settings. Default: Kapow demo store.
 * @param {ToyRoutes} routes - Page URLs.
 * @param {boolean} seedCart - Pre-fill the cart with demo items. Default false.
 * @param {string} theme - Initial theme (light|dark|auto). Default 'light'.
 * @param {boolean} noindex - Add robots noindex. Default false.
 */
import ToyLayout from './ToyLayout.astro';
import ToyCharacterRail from '../../sections/ToyCharacterRail.astro';
import ProductToolbar from '../../ecommerce/ProductToolbar.astro';
import FilterSidebar from '../../ecommerce/FilterSidebar.astro';
import ToyFigureGrid from '../../ecommerce/ToyFigureGrid.astro';
import TrustBadges from '../../ecommerce/TrustBadges.astro';
import { kapowStore, toyRoutes, toyProducts, toyCardMeta, toyCharacterItems, type ToyStore, type ToyRoutes } from './data';

interface Props {
  store?: ToyStore;
  routes?: ToyRoutes;
  seedCart?: boolean;
  noindex?: boolean;
  theme?: 'light' | 'dark' | 'auto';
}

const { store = kapowStore, routes = toyRoutes, seedCart = false, noindex = false, theme = 'light' } = Astro.props;

const products = toyProducts(store);
const count = (facet: string, id: string) => products.filter((p) => {
  const v = p.facets?.[facet];
  return Array.isArray(v) ? v.includes(id) : v === id;
}).length;
const maxPrice = Math.ceil(Math.max(...store.products.map((p) => p.price)) / 10) * 10;
const types = store.categories.map((c) => ({ id: c.id, name: c.name, count: products.filter((p) => p.category === c.id).length }));
const facets = [
  { name: 'character', label: 'Character', options: store.characters.map((c) => ({ id: c.id, name: c.name, count: count('character', c.id) })) },
  { name: 'universe', label: 'Universe', options: store.universes.map((u) => ({ id: u.id, name: u.name, count: count('universe', u.id) })) },
  { name: 'age', label: 'Age', options: store.ages.map((a) => ({ id: a.id, name: `${a.name} (${a.range})`, count: count('age', a.id) })) },
  { name: 'scale', label: 'Scale', options: store.scales.map((s) => ({ id: s.id, name: s.name, count: count('scale', s.id) })).filter((s) => s.count > 0) },
];
---

<ToyLayout theme={theme} title="Shop all toys" description="Action figures, collector editions, vehicles, playsets and minis. Filter by character, universe, age and scale." store={store} routes={routes} currentHref={routes.shop} seedCart={seedCart} noindex={noindex}>
  <div class="kapow-container shop">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={routes.home}>Home</a></li>
        <li><span aria-current="page">Shop</span></li>
      </ol>
    </nav>

    <ProductToolbar
      title="The toy box"
      description="Tap a character to see all of their figures, or narrow things down by universe, age and scale."
      total={products.length}
      target="toy-grid"
      filtersId="toy-filters"
      countLabel="toys"
      sortOptions={[
        { label: 'Featured', value: 'featured' },
        { label: 'Top rated', value: 'rating' },
        { label: 'Price: low to high', value: 'price-asc' },
        { label: 'Price: high to low', value: 'price-desc' },
        { label: 'Name A–Z', value: 'name' },
      ]}
    />

    <div class="shop__rail">
      <ToyCharacterRail
        title=""
        mode="filter"
        filters="toy-filters"
        facet="character"
        size="sm"
        id="shop-characters"
        characters={toyCharacterItems(store, routes).map((c) => ({ ...c, count: undefined }))}
      />
    </div>

    <div class="shop__layout">
      <div class="shop__filters">
        <FilterSidebar
          target="toy-grid"
          id="toy-filters"
          categoryLabel="Type"
          categories={types}
          facets={facets}
          maxPrice={maxPrice}
          colors={[]}
          currency={store.currency}
          locale={store.locale}
        />
      </div>
      <ToyFigureGrid
        id="toy-grid"
        products={products}
        meta={toyCardMeta(store)}
        productBase={routes.product}
        columns={3}
        currency={store.currency}
        locale={store.locale}
        cartKey={store.cartKey}
        openCart={false}
      />
    </div>

    <div class="shop__trust">
      <TrustBadges
        variant="divided"
        size="sm"
        items={[
          { icon: 'truck', title: 'Free shipping', text: `On orders over ${new Intl.NumberFormat(store.locale, { style: 'currency', currency: store.currency, maximumFractionDigits: 0 }).format(store.freeShippingThreshold)}` },
          { icon: 'gift', title: 'Free gift wrap', text: 'Add a note at checkout' },
          { icon: 'return', title: '30-day returns', text: 'Even opened boxes' },
          { icon: 'lock', title: 'Safety tested', text: 'EN 71 & ASTM F963' },
        ]}
      />
    </div>
  </div>
</ToyLayout>

<style>
  .shop { padding-block: var(--sp-6) clamp(3rem, 7vw, 5rem); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin: 0 0 var(--sp-6); padding: 0; list-style: none; font-size: 0.85rem; }
  .crumbs li { display: flex; align-items: center; gap: var(--sp-2); color: var(--c-text-2); }
  .crumbs li + li::before { content: '/'; opacity: 0.5; }
  .crumbs a { color: var(--c-text-2); }
  .crumbs a:hover { color: var(--c-text-1); }
  .crumbs [aria-current='page'] { color: var(--c-text-1); font-weight: 700; }

  .shop__rail { margin: var(--sp-6) 0 var(--sp-4); }
  .shop__layout { display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: var(--sp-8); align-items: start; }
  .shop__filters { position: sticky; top: 88px; max-height: calc(100vh - 100px); overflow-y: auto; padding: 0 8px 10px 0; scrollbar-width: thin; }
  .shop__trust { margin-top: clamp(3rem, 6vw, 4.5rem); }

  @media (max-width: 900px) {
    .shop__layout { grid-template-columns: 1fr; gap: var(--sp-4); }
    .shop__filters { position: static; max-height: none; overflow: visible; }
  }
</style>
