---
/**
 * RestSignInPage — Customer sign-in: a full-screen split with a generated plate and the form.
 * Standalone document (no site header or footer).
 *
 * @param {RestRoutes} routes - Template route URLs.
 * @param {string} action - Backend endpoint for the form. Empty runs a demo sign-in.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 */
import '../../../../styles/global.css';
import './rest-theme.css';
import RestSignIn from '../../app/RestSignIn.astro';
import { restRoutes, type RestRoutes } from './data';

interface Props {
  routes?: RestRoutes;
  action?: string;
  theme?: 'light' | 'dark' | 'auto';
}

const { routes = restRoutes, action = '', theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-rest" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mi mesa — Lumbre</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="rest-si-body">
    <main id="main-content">
      <RestSignIn dashboardHref={routes.dashboard} joinHref={routes.reserve} homeHref={routes.home} action={action} />
    </main>
  </body>
</html>

<style>
  .rest-si-body {
    margin: 0;
    background: var(--rs-bg);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
  }
</style>
