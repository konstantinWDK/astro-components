---
/**
 * RestSiteLayout — Public layout for the "Lumbre" restaurant template.
 * Skip link, sticky header with the wordmark and primary nav (disclosure menu on mobile),
 * members link, "book a visit" button and the RestFooter.
 *
 * @param {string} title - Document title.
 * @param {string} description - Meta description.
 * @param {string} current - Active nav key (menu | origin | reserve).
 * @param {RestRoutes} routes - Template route URLs.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 * @param {boolean} noindex - Adds a robots noindex meta.
 * @param {string} lang - Document language. Default 'es'.
 *
 * Accessibility: skip link to #main-content, aria-current on the active link, the mobile menu
 * button exposes aria-expanded / aria-controls and closes on Escape.
 */
import '../../../../styles/global.css';
import './rest-theme.css';
import RestFooter from '../../sections/RestFooter.astro';
import { restRoutes, restBrand, type RestRoutes } from './data';

type NavKey = 'menu' | 'origin' | 'reserve';

interface Props {
  title: string;
  description?: string;
  current?: NavKey;
  routes?: RestRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = 'Lumbre · Cocina a la brasa de autor en Madrid. Menú degustación de ocho pases, carta del día y reserva eligiendo tu mesa en el plano de la sala.',
  current,
  routes = restRoutes,
  theme = 'dark',
  noindex = false,
  lang = 'es',
} = Astro.props;

const navLinks: Array<{ key: NavKey; label: string; href: string }> = [
  { key: 'menu', label: 'Menú', href: routes.menu },
  { key: 'origin', label: 'Origen', href: routes.origin },
  { key: 'reserve', label: 'Reservar', href: routes.reserve },
];
const footerColumns = [
  { title: 'La casa', links: [{ label: 'Menú y carta', href: routes.menu }, { label: 'De dónde viene', href: routes.origin }, { label: 'Reservar mesa', href: routes.reserve }] },
  { title: 'Clientes', links: [{ label: 'Mi mesa', href: routes.signIn }] },
];
---

<!doctype html>
<html lang={lang} class="theme-rest" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="rest-body">
    <a href="#main-content" class="rest-skip">Saltar al contenido</a>

    <header class="rest-header">
      <div class="rest-header__inner">
        <a href={routes.home} class="rest-logo" aria-label={`${restBrand.name} inicio`}>{restBrand.name}</a>

        <button type="button" class="rest-menu-btn" aria-expanded="false" aria-controls="rest-nav" data-rest-menu>
          <span class="rest-menu-btn__bars" aria-hidden="true"></span>
          <span class="rest-sr">Menú</span>
        </button>

        <nav id="rest-nav" class="rest-nav-main" aria-label="Navegación principal">
          <ul class="rest-nav-main__list">
            {navLinks.map((l) => (
              <li><a href={l.href} class="rest-nav-main__link" aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
          <div class="rest-nav-main__actions">
            <a href={routes.signIn} class="rest-nav-main__members">Mi mesa</a>
            <a href={routes.reserve} class="rest-nav-main__cta">Reservar mesa</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main-content" class="rest-main" tabindex="-1">
      <slot />
    </main>

    <RestFooter brand={restBrand.name} columns={footerColumns} cta={{ title: 'Ven a sentarte junto a la brasa', text: 'Veintiséis comensales por servicio, de miércoles a domingo. Elige tu mesa en el plano y te esperamos.', href: routes.reserve, label: 'Reservar mesa' }} />

    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-rest-menu]');
      const nav = document.getElementById('rest-nav');
      if (btn && nav) {
        const set = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
        };
        btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            set(false);
            btn.focus();
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .rest-body {
    margin: 0;
    min-height: 100vh;
    background: var(--rs-bg);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
  }

  .rest-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .rest-skip {
    position: absolute;
    left: 1rem;
    top: -100px;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--rs-brand);
    color: var(--rs-on-brand);
    font-weight: 700;
    text-decoration: none;
  }

  .rest-skip:focus {
    top: 1rem;
  }

  .rest-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--rs-bg) 86%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rs-border);
  }

  .rest-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1240px;
    min-height: 68px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .rest-logo {
    font-family: var(--rs-font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.9rem;
    letter-spacing: -0.01em;
    color: var(--rs-text);
    text-decoration: none;
  }

  .rest-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--rs-border-strong);
    border-radius: 2px;
    background: none;
    color: var(--rs-text);
    cursor: pointer;
  }

  .rest-menu-btn__bars,
  .rest-menu-btn__bars::before {
    display: block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
  }

  .rest-menu-btn__bars {
    position: relative;
    top: -3px;
  }

  .rest-menu-btn__bars::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
  }

  .rest-nav-main {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: none;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    background: var(--rs-bg-raised);
    border-bottom: 1px solid var(--rs-border-strong);
  }

  .rest-nav-main.is-open {
    display: flex;
  }

  .rest-nav-main__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rest-nav-main__link,
  .rest-nav-main__members {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: var(--rs-text-2);
    font: 600 0.82rem/1 var(--rs-font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .rest-nav-main__link:hover,
  .rest-nav-main__members:hover {
    color: var(--rs-text);
  }

  .rest-nav-main__link[aria-current='page'] {
    color: var(--rs-brand);
  }

  .rest-nav-main__actions {
    display: grid;
    gap: 0.5rem;
  }

  .rest-nav-main__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.4rem;
    border: 1px solid var(--rs-brand);
    border-radius: 2px;
    background: var(--rs-brand);
    color: var(--rs-on-brand);
    font: 600 0.78rem/1 var(--rs-font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .rest-nav-main__cta:hover {
    background: var(--rs-brand-hover);
  }

  .rest-header a:focus-visible,
  .rest-header button:focus-visible {
    outline: 2px solid var(--rs-brand);
    outline-offset: 3px;
  }

  .rest-main:focus {
    outline: none;
  }

  @media (min-width: 900px) {
    .rest-menu-btn {
      display: none;
    }

    .rest-nav-main {
      position: static;
      display: flex;
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 0;
      background: none;
      border: 0;
    }

    .rest-nav-main__list {
      display: flex;
      gap: 1.75rem;
      margin-left: 2rem;
    }

    .rest-nav-main__actions {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
  }
</style>
