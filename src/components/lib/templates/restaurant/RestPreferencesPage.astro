---
/**
 * RestPreferencesPage — Preferences for the kitchen (allergies, diet, zone, celebrations) and the gift cards.
 *
 * @param {RestRoutes} routes - Template route URLs.
 * @param {typeof restData} data - Customer, reservations, preferences and gift cards.
 */
import RestAccountLayout from './RestAccountLayout.astro';
import RestAccountHeading from '../../app/RestAccountHeading.astro';
import RestPreferences from '../../app/RestPreferences.astro';
import RestGiftCards from '../../app/RestGiftCards.astro';
import { restRoutes, restData, type RestRoutes } from './data';

interface Props {
  routes?: RestRoutes;
  data?: typeof restData;
}

const { routes = restRoutes, data = restData } = Astro.props;
---

<RestAccountLayout title="Preferencias" current="preferences" routes={routes}>
  <RestAccountHeading kicker="Mi mesa" title="Preferencias" description="Lo que la cocina debe saber antes de que llegues." />
  <RestPreferences preferences={data.preferences} />
  <section class="rest-app-section" id="vales" aria-labelledby="vales-title">
    <h2 id="vales-title">Vales regalo</h2>
    <RestGiftCards cards={data.giftCards} />
  </section>
</RestAccountLayout>
