---
/**
 * RestOriginPage — Origin: a radar of the producers at their real distance, with who they are and what they send.
 *
 * @param {RestRoutes} routes - Template route URLs.
 * @param {typeof restData} data - Courses, dishes, producers, tables, FAQs, customer, reservations and gift cards.
 */
import RestSiteLayout from './RestSiteLayout.astro';
import RestOrigin from '../../sections/RestOrigin.astro';
import RestFaq from '../../sections/RestFaq.astro';
import { restRoutes, restData, type RestRoutes } from './data';

interface Props {
  routes?: RestRoutes;
  data?: typeof restData;
}

const { routes = restRoutes, data = restData } = Astro.props;
---

<RestSiteLayout
  title={`De dónde viene · ${data.brand.name}`}
  description="Seis productores a su distancia real. De media, cada producto recorre 125 km hasta la brasa."
  current="origin"
  routes={routes}
>
  <RestOrigin producers={data.producers} headingLevel="h1" />
  <RestFaq faqs={data.faqs} />
</RestSiteLayout>
