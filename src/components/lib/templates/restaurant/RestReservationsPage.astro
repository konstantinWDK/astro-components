---
/**
 * RestReservationsPage — The customer reservations in upcoming and past views, with cancel and change actions.
 *
 * @param {RestRoutes} routes - Template route URLs.
 * @param {typeof restData} data - Customer, reservations, preferences and gift cards.
 */
import RestAccountLayout from './RestAccountLayout.astro';
import RestAccountHeading from '../../app/RestAccountHeading.astro';
import RestReservations from '../../app/RestReservations.astro';
import { restRoutes, restData, type RestRoutes } from './data';

interface Props {
  routes?: RestRoutes;
  data?: typeof restData;
}

const { routes = restRoutes, data = restData } = Astro.props;
---

<RestAccountLayout title="Reservas" current="reservations" routes={routes}>
  <RestAccountHeading kicker="Mi mesa" title="Mis reservas" description="Cancela sin coste hasta 24 horas antes." />
  <RestReservations reservations={data.reservations} reserveHref={routes.reserve} />
</RestAccountLayout>
