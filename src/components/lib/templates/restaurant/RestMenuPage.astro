---
/**
 * RestMenuPage — The menu: the eight-course tasting menu plate by plate, the à la carte list with diet filter, and FAQ.
 *
 * @param {RestRoutes} routes - Template route URLs.
 * @param {typeof restData} data - Courses, dishes, producers, tables, FAQs, customer, reservations and gift cards.
 */
import RestSiteLayout from './RestSiteLayout.astro';
import RestTasting from '../../sections/RestTasting.astro';
import RestMenu from '../../sections/RestMenu.astro';
import RestFaq from '../../sections/RestFaq.astro';
import { restRoutes, restData, type RestRoutes } from './data';

interface Props {
  routes?: RestRoutes;
  data?: typeof restData;
}

const { routes = restRoutes, data = restData } = Astro.props;
---

<RestSiteLayout
  title={`Menú y carta · ${data.brand.name}`}
  description="El menú degustación de ocho pases y la carta de hoy con filtro por dieta."
  current="menu"
  routes={routes}
>
  <RestTasting courses={data.courses} reserveHref={routes.reserve} headingLevel="h1" />
  <RestMenu dishes={data.dishes} />
  <RestFaq faqs={data.faqs} />
</RestSiteLayout>
