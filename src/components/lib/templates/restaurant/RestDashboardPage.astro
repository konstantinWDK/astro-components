---
/**
 * RestDashboardPage — Customer home: the next reservation with a countdown, customer figures and a one-tap rebook card.
 *
 * @param {RestRoutes} routes - Template route URLs.
 * @param {typeof restData} data - Customer, reservations, preferences and gift cards.
 */
import RestAccountLayout from './RestAccountLayout.astro';
import RestAccountHeading from '../../app/RestAccountHeading.astro';
import RestAccountSummary from '../../app/RestAccountSummary.astro';
import { restRoutes, restData, type RestRoutes } from './data';

interface Props {
  routes?: RestRoutes;
  data?: typeof restData;
}

const { routes = restRoutes, data = restData } = Astro.props;
---

<RestAccountLayout title="Resumen" current="dashboard" routes={routes}>
  <RestAccountHeading kicker="Mi mesa" title="Tu resumen" description="Cuándo es tu próxima mesa y qué tenemos apuntado de ti." />
  <RestAccountSummary member={data.member} reservations={data.reservations} preferences={data.preferences} giftCards={data.giftCards} reservationsHref={routes.reservations} reserveHref={routes.reserve} />
</RestAccountLayout>
