---
/**
 * RestReservePage — Booking: date, time and guests, then pick your table on the floor plan; tables taken or too small are disabled.
 *
 * @param {RestRoutes} routes - Template route URLs.
 * @param {typeof restData} data - Courses, dishes, producers, tables, FAQs, customer, reservations and gift cards.
 * @param {string} action - Backend endpoint for the booking form. Empty shows a demo confirmation.
 */
import RestSiteLayout from './RestSiteLayout.astro';
import RestBooking from '../../sections/RestBooking.astro';
import RestFaq from '../../sections/RestFaq.astro';
import { restRoutes, restData, type RestRoutes } from './data';

interface Props {
  routes?: RestRoutes;
  data?: typeof restData;
  action?: string;
}

const { routes = restRoutes, data = restData, action = '' } = Astro.props;
---

<RestSiteLayout
  title={`Reservar mesa · ${data.brand.name}`}
  description="Elige fecha, hora y comensales y escoge tu mesa en el plano de la sala."
  current="reserve"
  routes={routes}
>
  <RestBooking tables={data.tables} slots={data.slots} action={action} headingLevel="h1" />
  <RestFaq faqs={data.faqs} />
</RestSiteLayout>
