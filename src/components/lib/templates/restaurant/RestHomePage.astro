---
/**
 * RestHomePage — Home of the "Lumbre" restaurant template: ember hero, the tasting menu plate by plate and the origin radar.
 *
 * @param {RestRoutes} routes - Template route URLs.
 * @param {typeof restData} data - Courses, dishes, producers, tables, FAQs, customer, reservations and gift cards.
 */
import RestSiteLayout from './RestSiteLayout.astro';
import RestHero from '../../sections/RestHero.astro';
import RestTasting from '../../sections/RestTasting.astro';
import RestOrigin from '../../sections/RestOrigin.astro';
import { restRoutes, restData, type RestRoutes } from './data';

interface Props {
  routes?: RestRoutes;
  data?: typeof restData;
}

const { routes = restRoutes, data = restData } = Astro.props;
---

<RestSiteLayout
  title={`${data.brand.name} · Cocina a la brasa de autor en Madrid`}
  description="Cocina a la brasa de autor. Menú degustación de ocho pases, carta del día y reserva eligiendo tu mesa en el plano de la sala."
  routes={routes}
>
  <RestHero stats={data.stats} reserveHref={routes.reserve} menuHref={routes.menu} />
  <RestTasting courses={data.courses} reserveHref={routes.reserve} />
  <RestOrigin producers={data.producers} />
</RestSiteLayout>
