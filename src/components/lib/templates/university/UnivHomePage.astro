---
/**
 * UnivHomePage — Flagship portal home page for Veritas University.
 * Combines Hero, Programs showcase, Research summary, Campus facilities teaser and Open Days invitation.
 */
import UnivSiteLayout from './UnivSiteLayout.astro';
import UnivHero from '../../app/UnivHero.astro';
import UnivPrograms from '../../app/UnivPrograms.astro';
import UnivResearch from '../../app/UnivResearch.astro';
import UnivOpenDay from '../../app/UnivOpenDay.astro';
import { univRoutes, type UnivRouteMap } from './data';

interface Props {
  routes?: UnivRouteMap;
}

const { routes = univRoutes } = Astro.props;
---

<UnivSiteLayout
  title="Universidad Veritas · Campus Internacional de Estudios Superiores"
  description="Universidad oficial con titulaciones adaptadas al EEES, investigación de impacto en IA y biomedicina y #1 en empleabilidad según Forbes."
  currentPath={routes.home}
  routes={routes}
>
  <UnivHero routes={routes} />
  <UnivPrograms routes={routes} />
  <UnivResearch routes={routes} />
  <UnivOpenDay />
</UnivSiteLayout>
