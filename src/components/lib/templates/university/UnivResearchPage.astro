---
/**
 * UnivResearchPage — Research institutes, publications, PhD contracts and corporate transfer.
 */
import UnivSiteLayout from './UnivSiteLayout.astro';
import UnivResearch from '../../app/UnivResearch.astro';
import { univRoutes, type UnivRouteMap } from './data';

interface Props {
  routes?: UnivRouteMap;
}

const { routes = univRoutes } = Astro.props;
---

<UnivSiteLayout
  title="Investigación de Impacto y Transferencia · Universidad Veritas"
  description="42 grupos de I+D+i, institutos en IA, medicina molecular y energía cuántica con 54M € en proyectos competitivos y programas de doctorado."
  currentPath={routes.research}
  routes={routes}
>
  <div class="univ-page-hero">
    <div class="univ-page-hero__container">
      <span class="univ-page-hero__eyebrow">INVESTIGACIÓN Y TRANSFERENCIA TECNOLÓGICA</span>
      <h1 class="univ-page-hero__title">Ciencia de Frontera al Servicio de la Sociedad</h1>
      <p class="univ-page-hero__desc">
        Explora nuestros institutos de investigación punteros en Inteligencia Artificial, Biomedicina Regenerativa y Transición Energética. Descubre cómo colaborar en proyectos I+D o cursar tu doctorado.
      </p>
    </div>
  </div>

  <UnivResearch routes={routes} />
</UnivSiteLayout>

<style>
  .univ-page-hero {
    background: var(--univ-navy-deep, #0a0f1d);
    border-bottom: 1px solid var(--univ-border, #1e2f5d);
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .univ-page-hero__container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .univ-page-hero__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--univ-gold, #f59e0b);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .univ-page-hero__title {
    font-family: var(--univ-font-serif, serif);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .univ-page-hero__desc {
    font-size: 1.0625rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
  }
</style>
