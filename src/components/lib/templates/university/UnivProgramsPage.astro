---
/**
 * UnivProgramsPage — Full catalog of degrees, masters and doctorates with filters.
 */
import UnivSiteLayout from './UnivSiteLayout.astro';
import UnivPrograms from '../../app/UnivPrograms.astro';
import { univRoutes, type UnivRouteMap } from './data';

interface Props {
  routes?: UnivRouteMap;
}

const { routes = univRoutes } = Astro.props;
---

<UnivSiteLayout
  title="Oferta Académica Oficial · Grados y Másters · Universidad Veritas"
  description="Catálogo de titulaciones oficiales adaptadas al EEES y acreditadas por la ANECA: Ingeniería en IA, Biotecnología, ADE Analytics, FinTech y Ciberseguridad."
  currentPath={routes.programs}
  routes={routes}
>
  <div class="univ-page-hero">
    <div class="univ-page-hero__container">
      <span class="univ-page-hero__eyebrow">CATÁLOGO DE TITULACIONES OFICIALES</span>
      <h1 class="univ-page-hero__title">Grados, Másters Universitarios y Doctorado</h1>
      <p class="univ-page-hero__desc">
        Encuentra el programa que definirá tu trayectoria profesional. Todos nuestros títulos cuentan con acreditación oficial de la ANECA y convalidación en el Espacio Europeo de Educación Superior.
      </p>
    </div>
  </div>

  <UnivPrograms routes={routes} />
</UnivSiteLayout>

<style>
  .univ-page-hero {
    background: var(--univ-navy-deep, #0a0f1d);
    border-bottom: 1px solid var(--univ-border, #1e2f5d);
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .univ-page-hero__container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .univ-page-hero__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--univ-gold, #f59e0b);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .univ-page-hero__title {
    font-family: var(--univ-font-serif, serif);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .univ-page-hero__desc {
    font-size: 1.0625rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
  }
</style>
