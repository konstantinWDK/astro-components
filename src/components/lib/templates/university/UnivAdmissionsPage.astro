---
/**
 * UnivAdmissionsPage — Admissions guide, calendar and tuition/scholarship calculator.
 */
import UnivSiteLayout from './UnivSiteLayout.astro';
import UnivAdmissions from '../../app/UnivAdmissions.astro';
import UnivCalculator from '../../app/UnivCalculator.astro';
import { univRoutes, type UnivRouteMap } from './data';

interface Props {
  routes?: UnivRouteMap;
}

const { routes = univRoutes } = Astro.props;
---

<UnivSiteLayout
  title="Admisiones 2027 y Becas al Mérito · Universidad Veritas"
  description="Proceso de admisión telemático, calendario de convocatorias ordinarias y simulador financiero de becas por excelencia académica."
  currentPath={routes.admissions}
  routes={routes}
>
  <div class="univ-page-hero">
    <div class="univ-page-hero__container">
      <span class="univ-page-hero__eyebrow">ACCESO UNIVERSITARIO 2027</span>
      <h1 class="univ-page-hero__title">Admisiones, Becas al Mérito y Financiación</h1>
      <p class="univ-page-hero__desc">
        Consulta los requisitos por titulación, los plazos de convocatoria ordinaria y extraordinaria, y simula en tiempo real tu beca al mérito académico y facilidades de pago en 10 cuotas.
      </p>
    </div>
  </div>

  <UnivAdmissions routes={routes} />
  <UnivCalculator />
</UnivSiteLayout>

<style>
  .univ-page-hero {
    background: var(--univ-navy-deep, #0a0f1d);
    border-bottom: 1px solid var(--univ-border, #1e2f5d);
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .univ-page-hero__container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .univ-page-hero__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--univ-gold, #f59e0b);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .univ-page-hero__title {
    font-family: var(--univ-font-serif, serif);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .univ-page-hero__desc {
    font-size: 1.0625rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
  }
</style>
