---
/**
 * UnivCampusPage — Campus life, facilities, sports, residence and Open Days booking.
 */
import UnivSiteLayout from './UnivSiteLayout.astro';
import UnivCampus from '../../app/UnivCampus.astro';
import UnivOpenDay from '../../app/UnivOpenDay.astro';
import { univRoutes, type UnivRouteMap } from './data';

interface Props {
  routes?: UnivRouteMap;
}

const { routes = univRoutes } = Astro.props;
---

<UnivSiteLayout
  title="Campus Veritas · Instalaciones, Vida Universitaria y Colegio Mayor"
  description="140.000 m² de campus universitario: Biblioteca Central 24h, FabLab, Colegio Mayor Veritas Hall, Polideportivo Olímpico y más de 30 clubes estudiantiles."
  currentPath={routes.campus}
  routes={routes}
>
  <div class="univ-page-hero">
    <div class="univ-page-hero__container">
      <span class="univ-page-hero__eyebrow">VIDA UNIVERSITARIA Y COMUNIDAD</span>
      <h1 class="univ-page-hero__title">Un Entorno Diseñado para Crecer y Convivir</h1>
      <p class="univ-page-hero__desc">
        Conoce el Colegio Mayor Veritas Hall, la Biblioteca Central 24h, el Complejo Deportivo Olímpico y las actividades que hacen única la experiencia universitaria en nuestro campus.
      </p>
    </div>
  </div>

  <UnivCampus routes={routes} />
  <UnivOpenDay />
</UnivSiteLayout>

<style>
  .univ-page-hero {
    background: var(--univ-navy-deep, #0a0f1d);
    border-bottom: 1px solid var(--univ-border, #1e2f5d);
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .univ-page-hero__container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .univ-page-hero__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--univ-gold, #f59e0b);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .univ-page-hero__title {
    font-family: var(--univ-font-serif, serif);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--univ-text, #f8fafc);
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .univ-page-hero__desc {
    font-size: 1.0625rem;
    color: var(--univ-text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
  }
</style>
