---
/**
 * ConstructionSignInPage — Site OS sign-in of the "Strukto" template, built on
 * ConstructionSignIn. Each profile lands on its screen; in the demo any email and a 6-character
 * password work.
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {string} theme - Initial theme ('dark' | 'light' | 'auto'). Default 'dark'.
 * @param {boolean} noindex - Add robots noindex. Default true.
 */
import '../../../../styles/global.css';
import './construction-theme.css';
import ConstructionSignIn from '../../app/ConstructionSignIn.astro';
import { constructionRoutes, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = constructionRoutes, theme = 'dark', noindex = true } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-construction" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso Site OS — Strukto</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="sk-signin-page">
    <main>
      <ConstructionSignIn
        destinations={{ obra: routes.sites, direccion: routes.dashboard, prl: routes.dailyLog, comercial: routes.unitsCms }}
        backHref={routes.home}
      />
    </main>
  </body>
</html>

<style>
  .sk-signin-page {
    margin: 0;
    min-height: 100vh;
    background: var(--sk-bg);
    overflow-x: clip;
  }
</style>
