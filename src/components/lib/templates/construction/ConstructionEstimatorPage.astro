---
/**
 * ConstructionEstimatorPage — Budget estimator of the "Strukto" template
 * (ConstructionCostEstimator) under a plan-sheet heading.
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 */
import ConstructionSiteLayout from './ConstructionSiteLayout.astro';
import ConstructionCostEstimator from '../../app/ConstructionCostEstimator.astro';
import { constructionRoutes, constructionCompany, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
}

const { routes = constructionRoutes } = Astro.props;
---

<ConstructionSiteLayout title={`Calcular presupuesto · ${constructionCompany.name}`} description="Calcula al momento el presupuesto orientativo de tu obra: PEM, gastos, honorarios, licencias, IVA y plazo." current="estimator" routes={routes}>
  <section class="sk-ui sk-ep sk-grid-bg" aria-labelledby="sk-ep-h">
    <div class="sk-ep__inner">
      <p class="sk-ep__kicker sk-mono">Hoja 02 · Mediciones y presupuesto</p>
      <h1 id="sk-ep-h" class="sk-ep__title">Calcula tu obra</h1>
      <p class="sk-ep__lead">Mueve los valores y mira cómo crece el edificio y cambia el presupuesto. Te enviamos uno cerrado sobre proyecto en 10 días.</p>
      <ConstructionCostEstimator contactHref={routes.contact} />
    </div>
  </section>
</ConstructionSiteLayout>

<style>
  .sk-ep {
    padding: clamp(2.5rem, 6vw, 4.5rem) 16px;
  }

  .sk-ep__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .sk-ep__kicker {
    margin: 0;
    color: var(--sk-accent);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .sk-ep__title {
    margin: 6px 0 0;
    font-family: var(--sk-font-display);
    font-stretch: 125%;
    font-size: clamp(2.4rem, 9vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .sk-ep__lead {
    max-width: 40rem;
    margin: 14px 0 32px;
    color: var(--sk-ink-2);
    font-size: 1.05rem;
  }
</style>
