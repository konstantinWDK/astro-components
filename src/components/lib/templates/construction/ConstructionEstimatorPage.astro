---
/**
 * ConstructionEstimatorPage — Online technical budget & feasibility calculator page.
 * Allows developers, plot owners and architects to simulate construction costs (PEM, PEC, licenses, duration)
 * with real-time feedback and direct quotation inquiry.
 *
 * @param {ConstructionRoutes} routes - Template route paths.
 */
import ConstructionSiteLayout from './ConstructionSiteLayout.astro';
import ConstructionBudgetEstimator from '../../app/ConstructionBudgetEstimator.astro';
import { constructionRoutes, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
}

const { routes = constructionRoutes } = Astro.props;
---

<ConstructionSiteLayout
  title="Calculadora de Costes y Presupuesto de Obra — Strukto Constructora"
  description="Estime el coste por m² de su edificio residencial, terciario o nave logística con desglose de PEM, PEC, honorarios y plazos de ejecución."
  routes={routes}
>
  <div class="estimator-page-hero">
    <div class="page-container">
      <span class="page-tag">Simulador Técnico & Económico</span>
      <h1 class="page-title">Calculadora de Presupuestos de Construcción</h1>
      <p class="page-desc">
        Obtenga una estimación preliminar y detallada de su proyecto arquitectónico conforme a los baremos de referencia del CTE (Código Técnico de la Edificación) y precios de mercado de la Comunidad de Madrid.
      </p>
    </div>
  </div>

  <section class="estimator-section">
    <div class="page-container">
      <ConstructionBudgetEstimator
        defaultM2={350}
        contactHref={routes.contact}
      />
    </div>
  </section>
</ConstructionSiteLayout>

<style>
  .estimator-page-hero {
    background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.1) 0%, rgba(9, 13, 22, 1) 75%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3.5rem 1.5rem 2.5rem;
    text-align: center;
  }

  .page-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-tag {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #f59e0b;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: #f8fafc;
    margin: 0 0 1rem;
  }

  .page-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 auto;
    max-width: 720px;
  }

  .estimator-section {
    padding: 3rem 1.5rem 5rem;
  }
</style>
