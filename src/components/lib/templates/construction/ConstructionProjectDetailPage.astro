---
/**
 * ConstructionProjectDetailPage — Development page of the "Strukto" template: drawn elevation with
 * a title block of facts, the isometric unit picker (orbit, explode, pick floor and home, request
 * information) and the works programme.
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {typeof constructionData} data - Projects and units.
 * @param {string} slug - Project to show. Default the first project.
 * @param {string} action - Optional action for the information request.
 */
import ConstructionSiteLayout from './ConstructionSiteLayout.astro';
import ConstructionIsoUnitPicker from '../../app/ConstructionIsoUnitPicker.astro';
import ConstructionGanttBoard from '../../app/ConstructionGanttBoard.astro';
import { elevation } from './construction-draw';
import { constructionRoutes, constructionData, constructionKindLabel, constructionStatusLabel, formatEurShort, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  data?: typeof constructionData;
  slug?: string;
  action?: string;
}

const { routes = constructionRoutes, data = constructionData, slug, action } = Astro.props;
const p = data.projects.find((x) => x.slug === slug) ?? data.projects[0];
const draw = elevation(p.floors, p.bays, { crane: p.status === 'obra' });
const free = data.units.filter((u) => u.status === 'libre');
const from = free.length ? Math.min(...free.map((u) => u.price)) : 0;
const facts = [
  { k: 'Tipología', v: constructionKindLabel[p.kind] },
  { k: 'Estado', v: `${constructionStatusLabel[p.status]} · ${p.progress} %` },
  { k: 'Dirección', v: `${p.address}, ${p.city}` },
  { k: 'Superficie', v: `${p.areaM2.toLocaleString('es-ES')} m²` },
  { k: 'Viviendas', v: `${p.units} · ${p.unitsFree} libres` },
  { k: 'Calificación', v: p.energy },
  { k: 'Arquitectura', v: p.architect },
  { k: 'Plazo', v: `${p.start} → ${p.end}` },
  { k: 'PEC', v: formatEurShort(p.budget) },
];
---

<ConstructionSiteLayout title={`${p.name} · ${p.district} · ${data.company.name}`} description={p.summary} current="projects" routes={routes}>
  <section class="sk-ui sk-pd sk-grid-bg" aria-labelledby="sk-pd-h">
    <div class="sk-pd__inner">
      <div class="sk-pd__copy">
        <nav class="sk-pd__crumbs sk-mono" aria-label="Migas de pan"><a href={routes.projects}>Proyectos</a> / <span aria-current="page">{p.name}</span></nav>
        <h1 id="sk-pd-h" class="sk-pd__title">{p.name}</h1>
        <p class="sk-pd__lead">{p.summary}</p>
        <ul class="sk-pd__tags sk-mono" role="list">{p.tags.map((t) => <li>{t}</li>)}</ul>
        {from ? <p class="sk-pd__from">Viviendas libres desde <strong>{from.toLocaleString('es-ES')} €</strong></p> : null}
        <a href="#selector" class="sk-pd__cta">Elegir vivienda</a>
      </div>
      <figure class="sk-pd__drawing sk-crop">
        <svg class="sk-draw" viewBox={`0 0 ${draw.width} ${draw.height}`} role="img" aria-label={`Alzado de ${p.name}: ${p.floors} plantas`} set:html={draw.svg} />
        <dl class="sk-pd__block sk-mono">
          {facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </figure>
    </div>
  </section>

  <section id="selector" class="sk-ui sk-pd__section" aria-label="Selector de viviendas">
    <ConstructionIsoUnitPicker units={data.units} projectName={p.name} action={action} />
  </section>

  {p.phases.length ? (
    <section class="sk-ui sk-pd__section sk-pd__section--alt" aria-label="Planning de la obra">
      <ConstructionGanttBoard phases={p.phases} title={`Así va la obra · ${p.progress} %`} variant="compact" />
    </section>
  ) : null}
</ConstructionSiteLayout>

<style>
  .sk-pd {
    padding: clamp(2rem, 6vw, 4rem) 16px;
    border-bottom: 1px solid var(--sk-line);
  }

  .sk-pd__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 980px) {
    .sk-pd__inner {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  .sk-pd__crumbs {
    color: var(--sk-ink-3);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .sk-pd__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--sk-ink-2);
  }

  .sk-pd__title {
    margin: 4px 0 0;
    font-family: var(--sk-font-display);
    font-stretch: 125%;
    font-size: clamp(2.2rem, 8vw, 4.4rem);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .sk-pd__lead {
    max-width: 34rem;
    margin: 16px 0 0;
    color: var(--sk-ink-2);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .sk-pd__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .sk-pd__tags li {
    padding: 4px 8px;
    border: 1px solid var(--sk-line-soft);
  }

  .sk-pd__from {
    margin: 18px 0 0;
    color: var(--sk-ink-2);
  }

  .sk-pd__from strong {
    color: var(--sk-accent);
    font-family: var(--sk-font-display);
    font-stretch: 112%;
    font-size: 1.4rem;
  }

  .sk-pd__cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 16px;
    padding: 0 1.3rem;
    border: 1px solid var(--sk-accent);
    background: var(--sk-accent);
    color: var(--sk-on-accent);
    font-family: var(--sk-font-mono);
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
  }

  .sk-pd a:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 3px;
  }

  .sk-pd__drawing {
    margin: 0;
    padding: 16px;
    border: 1px solid var(--sk-line-soft);
    background: var(--sk-glass);
  }

  .sk-pd__drawing svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 46vh;
  }

  .sk-pd__block {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 14px 0 0;
    border-top: 1px solid var(--sk-line);
    border-left: 1px solid var(--sk-line-soft);
    font-size: 0.75rem;
  }

  .sk-pd__block div {
    padding: 8px 10px;
    border-right: 1px solid var(--sk-line-soft);
    border-bottom: 1px solid var(--sk-line-soft);
    min-width: 0;
  }

  .sk-pd__block dt {
    color: var(--sk-ink-3);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .sk-pd__block dd {
    margin: 2px 0 0;
    overflow-wrap: anywhere;
  }

  .sk-pd__section {
    padding: clamp(2.5rem, 6vw, 4.5rem) 16px;
    background: var(--sk-bg);
    scroll-margin-top: 64px;
  }

  .sk-pd__section > :global(*) {
    max-width: 1280px;
    margin-inline: auto;
  }

  .sk-pd__section--alt {
    background: var(--sk-bg-2);
    border-top: 1px solid var(--sk-line-soft);
  }
</style>
