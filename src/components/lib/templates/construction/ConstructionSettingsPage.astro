---
/**
 * ConstructionSettingsPage — Contractor technical settings, ISO quality standards & safety certifications.
 * Configures company information, official building registry numbers, Passivhaus credentials, and subcontractor compliance rules.
 *
 * @param {ConstructionRoutes} routes - Template route paths.
 */
import ConstructionLayout from './ConstructionLayout.astro';
import { constructionRoutes, constructionData, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
}

const { routes = constructionRoutes } = Astro.props;
const comp = constructionData.company;
---

<ConstructionLayout
  title="Ajustes Técnicos & Homologaciones"
  current="settings"
  routes={routes}
>
  <div class="settings-header">
    <div>
      <span class="eyebrow">Configuración Empresarial &amp; Normativa</span>
      <h1 class="page-title">Parámetros Técnicos, ISO & Subcontratación</h1>
      <p class="page-sub">Gestión de acreditaciones oficiales, registros REA (Registro de Empresas Acreditadas), pólizas de seguro todo riesgo construcción y sellos ESG.</p>
    </div>

    <div class="actions">
      <button class="btn-save" type="button" onclick="alert('Configuración técnica y normativas guardadas con éxito.')">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
          <polyline points="17 21 17 13 7 13 7 21"/>
          <polyline points="7 3 7 8 15 8"/>
        </svg>
        <span>Guardar Cambios</span>
      </button>
    </div>
  </div>

  <div class="settings-grid">
    <!-- Left Column: Company & Legal Details -->
    <div class="settings-card">
      <h2 class="card-title">Identificación de la Constructora</h2>
      <p class="card-sub">Datos oficiales y colegiación técnica para visados y licitaciones.</p>

      <form class="settings-form" onsubmit="event.preventDefault();">
        <div class="form-row">
          <div class="form-group">
            <label>Razón Social</label>
            <input type="text" value={comp.name} />
          </div>
          <div class="form-group">
            <label>CIF / NIF Empresarial</label>
            <input type="text" value="B-84992102" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Nº Registro REA (Construcción)</label>
            <input type="text" value="REA-12/28/0094120" />
          </div>
          <div class="form-group">
            <label>Póliza Todo Riesgo Construcción (TRC)</label>
            <input type="text" value="Mapfre Empresas · Cobertura 12.000.000 €" />
          </div>
        </div>

        <div class="form-group">
          <label>Dirección Sede Central</label>
          <input type="text" value={comp.headquarters} />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Teléfono Oficial</label>
            <input type="text" value={comp.phone} />
          </div>
          <div class="form-group">
            <label>Email Técnico</label>
            <input type="email" value={comp.email} />
          </div>
        </div>
      </form>
    </div>

    <!-- Right Column: Certifications & Safety -->
    <div class="settings-card">
      <h2 class="card-title">Certificaciones Técnicas Activas</h2>
      <p class="card-sub">Sellos de calidad, sostenibilidad y prevención de riesgos laborales.</p>

      <div class="certs-list">
        {comp.certifications.map((cert) => (
          <div class="cert-item">
            <div class="cert-check">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <div class="cert-info">
              <span class="cert-name">{cert}</span>
              <span class="cert-valid">Auditoría vigente 2026/2027 · AENOR / Passivhaus Institut</span>
            </div>
          </div>
        ))}
      </div>

      <div class="subcontract-rules-box">
        <h3 class="rules-title">Requisitos Obligatorios Subcontratas (CAE)</h3>
        <ul class="rules-list">
          <li>Certificado de estar al corriente con Hacienda y Seguridad Social (mensual).</li>
          <li>Acreditación de formación PRL de 20h para todos los trabajadores en tajo.</li>
          <li>Apertura de centro de trabajo y designación de recurso preventivo.</li>
          <li>Revisión de maquinaria y marcado CE con libro de mantenimiento al día.</li>
        </ul>
      </div>
    </div>
  </div>
</ConstructionLayout>

<style>
  .settings-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .eyebrow {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #f59e0b;
    font-weight: 700;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0.25rem 0 0.35rem;
  }

  .page-sub {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0;
    max-width: 760px;
  }

  .btn-save {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    background: #f59e0b;
    color: #0f172a;
    font-size: 0.84rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-save:hover {
    background: #d97706;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 960px) {
    .settings-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .settings-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.75rem;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0 0 0.25rem;
  }

  .card-sub {
    font-size: 0.82rem;
    color: #94a3b8;
    margin: 0 0 1.5rem;
  }

  .settings-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.76rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .form-group input {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    color: #f8fafc;
    font-size: 0.85rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-group input:focus {
    border-color: #f59e0b;
  }

  .certs-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .cert-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.85rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cert-check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cert-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .cert-name {
    font-size: 0.86rem;
    font-weight: 600;
    color: #f8fafc;
  }

  .cert-valid {
    font-size: 0.72rem;
    color: #64748b;
  }

  .subcontract-rules-box {
    padding: 1.25rem;
    border-radius: 10px;
    background: rgba(245, 158, 11, 0.07);
    border: 1px solid rgba(245, 158, 11, 0.2);
  }

  .rules-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #f59e0b;
    margin: 0 0 0.6rem;
  }

  .rules-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.78rem;
    color: #cbd5e1;
    line-height: 1.6;
  }
</style>
