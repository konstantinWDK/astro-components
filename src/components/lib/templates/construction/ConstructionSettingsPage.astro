---
/**
 * ConstructionSettingsPage — Technical and regulatory settings of the "Strukto" Site OS:
 * company registry (REA, TRC insurance), active quality/sustainability certifications and
 * site-alert thresholds (wind, daily log reminder, automatic certification lock).
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {typeof constructionData} data - Company details.
 * @param {string} action - Optional POST endpoint.
 *
 * Accessibility: grouped fieldsets with legends, native switches with role="switch", labelled
 * inputs and a polite status announcement when saving.
 */
import ConstructionAppLayout from './ConstructionAppLayout.astro';
import ConstructionOsHeading from '../../app/ConstructionOsHeading.astro';
import { constructionRoutes, constructionData, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  data?: typeof constructionData;
  action?: string;
}

const { routes = constructionRoutes, data = constructionData, action } = Astro.props;
const c = data.company;
const alerts = [
  { id: 'wind', label: 'Parar grúa automáticamente con rachas > 35 km/h', checked: true },
  { id: 'prl', label: 'Exigir checklist PRL completo antes de firmar el diario', checked: true },
  { id: 'cert', label: 'Avisar a dirección si el desvío de certificación supera el 5 %', checked: true },
  { id: 'digest', label: 'Enviar resumen diario de tajos a las 19:30', checked: false },
];
---

<ConstructionAppLayout title="Ajustes" current="settings" routes={routes}>
  <ConstructionOsHeading
    sheet="OS-05"
    title="Ajustes técnicos"
    description="Datos de la constructora, acreditaciones REA, pólizas y avisos automáticos de obra."
  />

  <form class="sk-ui sk-set" method="post" action={action} data-sk-set>
    <fieldset class="sk-set__card sk-crop">
      <legend>Identificación y registro</legend>
      <div class="sk-set__grid">
        <label>Razón social<input type="text" name="legalName" value={c.legalName} /></label>
        <label>CIF<input type="text" name="cif" value="B-84992102" /></label>
        <label>N.º Registro REA<input type="text" name="rea" value={c.rea} /></label>
        <label>Póliza TRC<input type="text" name="trc" value="Mapfre Empresas · 12.000.000 €" /></label>
        <label class="sk-set__full">Sede central<input type="text" name="address" value={c.address} /></label>
        <label>Teléfono de obra<input type="tel" name="phone" value={c.phone} /></label>
        <label>Correo técnico<input type="email" name="email" value={c.email} /></label>
      </div>
    </fieldset>

    <fieldset class="sk-set__card">
      <legend>Certificaciones y normativa</legend>
      <ul class="sk-set__certs" role="list">
        {c.iso.map((cert, i) => (
          <li>
            <label class="sk-set__switch">
              <input type="checkbox" role="switch" name={`cert-${i}`} checked />
              <span class="sk-set__track" aria-hidden="true"><i></i></span>
              <span>{cert}</span>
            </label>
          </li>
        ))}
      </ul>
    </fieldset>

    <fieldset class="sk-set__card">
      <legend>Reglas de obra y PRL</legend>
      <ul class="sk-set__certs" role="list">
        {alerts.map((rule) => (
          <li>
            <label class="sk-set__switch">
              <input type="checkbox" role="switch" name={rule.id} checked={rule.checked} />
              <span class="sk-set__track" aria-hidden="true"><i></i></span>
              <span>{rule.label}</span>
            </label>
          </li>
        ))}
      </ul>
    </fieldset>

    <div class="sk-set__bar">
      <p class="sk-mono" role="status" aria-live="polite" data-set-status>Sin cambios pendientes.</p>
      <button type="submit" class="sk-set__save">Guardar configuración</button>
    </div>
  </form>
</ConstructionAppLayout>

<style>
  .sk-set {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }

  .sk-set__card {
    margin: 0;
    padding: 20px;
    border: 1px solid var(--sk-line-soft);
    background: var(--sk-panel);
  }

  .sk-set__card legend {
    padding: 0 8px;
    color: var(--sk-accent);
    font-family: var(--sk-font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .sk-set__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 600px) {
    .sk-set__grid {
      grid-template-columns: 1fr;
    }
  }

  .sk-set__full {
    grid-column: 1 / -1;
  }

  .sk-set__grid label {
    display: grid;
    gap: 6px;
    color: var(--sk-ink-2);
    font-family: var(--sk-font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .sk-set__grid input {
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--sk-line-soft);
    border-radius: var(--sk-radius);
    background: var(--sk-bg);
    color: var(--sk-ink);
    font-family: var(--sk-font-body);
    font-size: 0.92rem;
  }

  .sk-set__grid input:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 2px;
  }

  .sk-set__certs {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sk-set__switch {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--sk-ink);
    font-size: 0.92rem;
    cursor: pointer;
  }

  .sk-set__switch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .sk-set__track {
    position: relative;
    flex-shrink: 0;
    width: 42px;
    height: 24px;
    border: 1px solid var(--sk-line-soft);
    background: var(--sk-bg);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .sk-set__track i {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    background: var(--sk-ink-3);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .sk-set__switch input:checked + .sk-set__track {
    border-color: var(--sk-accent);
    background: color-mix(in srgb, var(--sk-accent) 22%, var(--sk-bg));
  }

  .sk-set__switch input:checked + .sk-set__track i {
    transform: translateX(18px);
    background: var(--sk-accent);
  }

  .sk-set__switch input:focus-visible + .sk-set__track {
    outline: 2px solid var(--sk-accent);
    outline-offset: 2px;
  }

  .sk-set__bar {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border: 1px solid var(--sk-line-soft);
    background: var(--sk-panel);
  }

  .sk-set__bar p {
    margin: 0;
    color: var(--sk-ink-2);
    font-size: 0.78rem;
  }

  .sk-set__save {
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--sk-accent);
    border-radius: var(--sk-radius);
    background: var(--sk-accent);
    color: var(--sk-on-accent);
    font-family: var(--sk-font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
  }

  .sk-set__save:hover {
    background: var(--sk-accent-hover);
  }

  .sk-set__save:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 3px;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-sk-set]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-set-status]');
    form.addEventListener('input', () => {
      if (status) status.textContent = 'Cambios sin guardar.';
    });
    form.addEventListener('submit', (e) => {
      if (!form.getAttribute('action')) {
        e.preventDefault();
        if (status) status.textContent = `Configuración guardada (${new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}).`;
      }
    });
  });
</script>
