---
/**
 * ConstructionContactPage — Developer, promoter & plot owner contact & tender submission page.
 * Features headquarters details, telephone assistance, tender file submissions, and the interactive inquiry form.
 *
 * @param {ConstructionRoutes} routes - Template route paths.
 */
import ConstructionSiteLayout from './ConstructionSiteLayout.astro';
import ConstructionInquiryForm from '../../sections/ConstructionInquiryForm.astro';
import { constructionRoutes, constructionData, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
}

const { routes = constructionRoutes } = Astro.props;
---

<ConstructionSiteLayout
  title="Contacto & Licitaciones de Obra — Strukto Constructora"
  description="Contacte con el departamento técnico y de contratación de Strukto Constructora. Sede en Madrid. Atención a promotores, arquitectos e inversores."
  routes={routes}
>
  <div class="contact-page-hero">
    <div class="page-container">
      <span class="page-tag">Oficinas Centrales & Licitaciones</span>
      <h1 class="page-title">Hablemos de su Próximo Proyecto</h1>
      <p class="page-desc">
        Ponga su proyecto en manos de un equipo de ingenieros de edificación con más de 35 años de experiencia, solvencia técnica contrastada y compromiso total de plazos.
      </p>

      <div class="contact-cards-grid">
        <div class="contact-card">
          <div class="card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3 class="card-title">Sede Central</h3>
          <p class="card-val">{constructionData.company.headquarters}</p>
          <span class="card-sub">Horario: Lunes a Viernes 08:00 – 19:00</span>
        </div>

        <div class="contact-card">
          <div class="card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <h3 class="card-title">Atención Telefónica</h3>
          <p class="card-val">
            <a href={`tel:${constructionData.company.phone.replace(/\s+/g, '')}`}>{constructionData.company.phone}</a>
          </p>
          <span class="card-sub">Línea directa departamento técnico</span>
        </div>

        <div class="contact-card">
          <div class="card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <h3 class="card-title">Licitaciones & Email</h3>
          <p class="card-val">
            <a href={`mailto:${constructionData.company.email}`}>{constructionData.company.email}</a>
          </p>
          <span class="card-sub">Recepción de proyectos de ejecución y mediciones</span>
        </div>
      </div>
    </div>
  </div>

  <ConstructionInquiryForm
    phone={constructionData.company.phone}
    email={constructionData.company.email}
  />
</ConstructionSiteLayout>

<style>
  .contact-page-hero {
    background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.1) 0%, rgba(9, 13, 22, 1) 75%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3.5rem 1.5rem 3.5rem;
  }

  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .page-tag {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #f59e0b;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: #f8fafc;
    margin: 0 0 1rem;
  }

  .page-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 auto 3rem;
    max-width: 720px;
  }

  .contact-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    text-align: left;
  }

  .contact-card {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.75rem;
    transition: transform 0.2s, border-color 0.2s;
  }

  .contact-card:hover {
    transform: translateY(-2px);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .card-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .card-val {
    font-size: 0.95rem;
    color: #cbd5e1;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }

  .card-val a {
    color: #f59e0b;
    text-decoration: none;
    font-weight: 600;
  }

  .card-val a:hover {
    text-decoration: underline;
  }

  .card-sub {
    font-size: 0.78rem;
    color: #64748b;
  }
</style>
