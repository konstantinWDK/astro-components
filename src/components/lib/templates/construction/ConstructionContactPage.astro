---
/**
 * ConstructionContactPage — Contact page of the "Strukto" template: the work-order request form
 * with live title block, plus offices and working hours.
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {string} action - Optional action for the request form.
 */
import ConstructionSiteLayout from './ConstructionSiteLayout.astro';
import ConstructionTenderForm from '../../sections/ConstructionTenderForm.astro';
import { constructionRoutes, constructionCompany, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  action?: string;
}

const { routes = constructionRoutes, action } = Astro.props;
const offices = [
  { city: 'Madrid · Sede', address: constructionCompany.address, phone: constructionCompany.phone },
  { city: 'Alcobendas · Delegación norte', address: 'Av. de la Industria 12, 28108 Alcobendas', phone: '+34 916 500 210' },
  { city: 'Getafe · Parque de maquinaria', address: 'Calle Torres Quevedo 8, 28906 Getafe', phone: '+34 916 820 433' },
];
---

<ConstructionSiteLayout title={`Contacto · ${constructionCompany.name}`} description="Pide un estudio de tu obra a Strukto: vivienda, edificio, rehabilitación o nave. Te llamamos en 48 h." current="contact" routes={routes}>
  <h1 class="sk-sr">Contacto</h1>
  <ConstructionTenderForm action={action} title="Pide un estudio de tu obra" size="lg" />
  <section class="sk-ui sk-cp" aria-labelledby="sk-cp-h">
    <h2 id="sk-cp-h" class="sk-cp__h">Oficinas</h2>
    <ul class="sk-cp__list" role="list">
      {offices.map((o, i) => (
        <li class="sk-crop">
          <p class="sk-mono">{String(i + 1).padStart(2, '0')} · {o.city}</p>
          <p>{o.address}</p>
          <a href={`tel:${o.phone.replace(/\s+/g, '')}`}>{o.phone}</a>
        </li>
      ))}
    </ul>
  </section>
</ConstructionSiteLayout>

<style>
  .sk-cp {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px clamp(3rem, 7vw, 5rem);
  }

  .sk-cp__h {
    margin: 0 0 16px;
    font-family: var(--sk-font-display);
    font-stretch: 125%;
    font-size: 1.6rem;
    text-transform: uppercase;
  }

  .sk-cp__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sk-cp__list li {
    padding: 16px;
    border: 1px solid var(--sk-line-soft);
    background: var(--sk-panel);
  }

  .sk-cp__list p {
    margin: 0 0 6px;
    color: var(--sk-ink-2);
  }

  .sk-cp__list p.sk-mono {
    color: var(--sk-accent);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .sk-cp__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--sk-ink);
    font-weight: 600;
  }

  .sk-cp__list a:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 2px;
  }
</style>
