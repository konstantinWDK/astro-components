---
/**
 * ConstructionDailyLogPage — Digital site logbook (libro de órdenes) of the "Strukto" Site OS,
 * built on ConstructionSiteLogbook.
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {typeof constructionData} data - Daily log and sites.
 */
import ConstructionAppLayout from './ConstructionAppLayout.astro';
import ConstructionOsHeading from '../../app/ConstructionOsHeading.astro';
import ConstructionSiteLogbook from '../../app/ConstructionSiteLogbook.astro';
import { constructionRoutes, constructionData, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  data?: typeof constructionData;
}

const { routes = constructionRoutes, data = constructionData } = Astro.props;
---

<ConstructionAppLayout title="Diario de obra" current="dailyLog" routes={routes}>
  <ConstructionOsHeading
    sheet="OS-03"
    title="Diario de obra"
    description="Parte diario de meteorología, cuadrillas por oficio, anotaciones y revisión PRL."
    actions={[
      { label: 'Ver obras', href: routes.sites },
      { label: 'Cuadro de mando', href: routes.dashboard },
    ]}
  />
  <ConstructionSiteLogbook log={data.dailyLog} sites={data.sites} />
</ConstructionAppLayout>
