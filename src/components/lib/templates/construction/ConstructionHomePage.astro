---
/**
 * ConstructionHomePage — Corporate landing page for Strukto Constructora & Desarrollos.
 * Showcases high-precision buildings, active sites ticker, portfolio grid, 5-stage turnkey workflow,
 * Passivhaus sustainability credentials, and project inquiry form.
 *
 * @param {ConstructionRoutes} routes - Template route paths.
 */
import ConstructionSiteLayout from './ConstructionSiteLayout.astro';
import ConstructionHero from '../../sections/ConstructionHero.astro';
import ConstructionProjectsGrid from '../../sections/ConstructionProjectsGrid.astro';
import ConstructionStageTimeline from '../../sections/ConstructionStageTimeline.astro';
import ConstructionSustainabilityBanner from '../../sections/ConstructionSustainabilityBanner.astro';
import ConstructionInquiryForm from '../../sections/ConstructionInquiryForm.astro';
import { constructionRoutes, constructionProjects, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
}

const { routes = constructionRoutes } = Astro.props;
---

<ConstructionSiteLayout
  title="Strukto Constructora & Desarrollos · Edificación Residencial y Terciario de Alta Eficiencia"
  description="Líderes en construcción residencial prémium, locales comerciales y edificación Passivhaus con más de 35 años de experiencia técnica."
  routes={routes}
>
  <ConstructionHero
    projectsHref={routes.projects}
    estimatorHref={routes.estimator}
  />

  <ConstructionProjectsGrid
    projects={constructionProjects}
    detailBase={routes.projects}
  />

  <ConstructionStageTimeline
    ctaHref={routes.estimator}
  />

  <ConstructionSustainabilityBanner />

  <ConstructionInquiryForm
    phone="+34 912 400 900"
    email="contacto@strukto-constructora.es"
  />
</ConstructionSiteLayout>
