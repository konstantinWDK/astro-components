---
/**
 * ConstructionSiteLayout — Public layout for the "Strukto" construction template: skip link,
 * sticky header on a drafting-sheet band (nav collapses into a disclosure on phones), Site OS
 * access, phone and "Pedir estudio" CTA, and the title-block ConstructionFooter.
 *
 * @param {string} title - Document title.
 * @param {string} description - Meta description.
 * @param {string} current - Active nav key (home | projects | estimator | contact).
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {string} theme - Initial theme ('dark' blueprint | 'light' tracing paper | 'auto'). Default 'dark'.
 * @param {boolean} noindex - Adds a robots noindex meta.
 * @param {string} lang - Document language. Default 'es'.
 *
 * Accessibility: skip link to #main-content, aria-current on the active link, the menu button
 * exposes aria-expanded / aria-controls and closes on Escape.
 */
import '../../../../styles/global.css';
import './construction-theme.css';
import ConstructionFooter from '../../sections/ConstructionFooter.astro';
import { constructionRoutes, constructionCompany, type ConstructionRoutes } from './data';

type NavKey = 'home' | 'projects' | 'estimator' | 'contact';

interface Props {
  title: string;
  description?: string;
  current?: NavKey;
  routes?: ConstructionRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = 'Strukto · Constructora en Madrid: obra nueva, rehabilitación y naves con plazo y presupuesto cerrados. Proyectos, calculadora de presupuesto y Site OS.',
  current,
  routes = constructionRoutes,
  theme = 'dark',
  noindex = false,
  lang = 'es',
} = Astro.props;

const nav: Array<{ key: NavKey; label: string; href: string; code: string }> = [
  { key: 'projects', label: 'Proyectos', href: routes.projects, code: '01' },
  { key: 'estimator', label: 'Presupuesto', href: routes.estimator, code: '02' },
  { key: 'contact', label: 'Contacto', href: routes.contact, code: '03' },
];
const c = constructionCompany;
const telHref = `tel:${c.phone.replace(/\s+/g, '')}`;
const columns = [
  { title: 'Empresa', links: [{ label: 'Proyectos', href: routes.projects }, { label: 'Residencial Caelum', href: routes.projectDetail }, { label: 'Calcular presupuesto', href: routes.estimator }] },
  { title: 'Clientes', links: [{ label: 'Pedir estudio', href: routes.contact }, { label: 'Acceso Site OS', href: routes.signIn }, { label: 'Cuadro de mando (demo)', href: routes.dashboard }] },
];
---

<!doctype html>
<html lang={lang} class="theme-construction" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="sk-body">
    <a href="#main-content" class="sk-skip">Saltar al contenido</a>

    <header class="sk-header">
      <div class="sk-header__inner">
        <a href={routes.home} class="sk-logo" aria-label={`${c.name}, inicio`}>
          <svg width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 25h22M6 25V9l8-6 8 6v16M10 25v-7h8v7M6 13h16" /></svg>
          <span>{c.name}</span>
        </a>

        <nav id="sk-nav" class="sk-nav" aria-label="Navegación principal">
          <ul role="list">
            {nav.map((l) => (
              <li>
                <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
                  <span class="sk-nav__code" aria-hidden="true">{l.code}</span>{l.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="sk-nav__end">
            <a href={telHref} class="sk-nav__phone">{c.phone}</a>
            <a href={routes.signIn} class="sk-nav__os">Site OS</a>
            <a href={routes.contact} class="sk-nav__cta">Pedir estudio</a>
          </div>
        </nav>

        <button type="button" class="sk-menu-btn" aria-expanded="false" aria-controls="sk-nav" data-sk-menu>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
          <span class="sk-sr">Menú</span>
        </button>
      </div>
    </header>

    <main id="main-content" class="sk-main" tabindex="-1">
      <slot />
    </main>

    <ConstructionFooter brand={c.name} columns={columns} company={c} copyright={`© ${new Date().getFullYear()} ${c.legalName} · ${c.address}`} />

    <script>
      function initSkMenu() {
        const btn = document.querySelector<HTMLButtonElement>('[data-sk-menu]');
        const nav = document.getElementById('sk-nav');
        if (!btn || !nav || btn.dataset.bound) return;
        btn.dataset.bound = 'true';
        const setOpen = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
        };
        btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            btn.focus();
          }
        });
      }
      initSkMenu();
      document.addEventListener('astro:page-load', initSkMenu);
    </script>
  </body>
</html>

<style>
  .sk-body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--sk-bg);
    color: var(--sk-ink);
    font-family: var(--sk-font-body);
    overflow-x: clip;
  }

  .sk-skip {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    padding: 8px 16px;
    background: var(--sk-accent);
    color: var(--sk-on-accent);
    font-family: var(--sk-font-mono);
    text-decoration: none;
  }

  .sk-skip:focus {
    top: 12px;
  }

  .sk-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--sk-line);
    background: var(--sk-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .sk-header__inner {
    position: relative;
    max-width: 1280px;
    min-height: 64px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .sk-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--sk-ink);
    text-decoration: none;
  }

  .sk-logo svg {
    color: var(--sk-accent);
  }

  .sk-logo span {
    font-family: var(--sk-font-display);
    font-stretch: 125%;
    font-size: 1.35rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sk-nav {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .sk-nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sk-nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    color: var(--sk-ink-2);
    text-decoration: none;
  }

  .sk-nav ul a:hover {
    color: var(--sk-ink);
  }

  .sk-nav ul a[aria-current='page'] {
    color: var(--sk-ink);
    box-shadow: inset 0 -2px 0 var(--sk-accent);
  }

  .sk-nav__code {
    color: var(--sk-accent);
    font-family: var(--sk-font-mono);
    font-size: 0.68rem;
  }

  .sk-nav__end {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sk-nav__phone,
  .sk-nav__os {
    font-family: var(--sk-font-mono);
    font-size: 0.8rem;
  }

  .sk-nav__os {
    border: 1px solid var(--sk-line-soft);
  }

  .sk-nav__cta {
    border: 1px solid var(--sk-accent);
    background: var(--sk-accent);
    color: var(--sk-on-accent) !important;
    font-family: var(--sk-font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .sk-nav__cta:hover {
    background: var(--sk-accent-hover);
  }

  .sk-menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 1px solid var(--sk-line-soft);
    background: transparent;
    color: var(--sk-ink);
    cursor: pointer;
  }

  .sk-header :is(a, button):focus-visible,
  .sk-skip:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 2px;
  }

  .sk-main {
    flex: 1;
  }

  .sk-main:focus {
    outline: none;
  }

  @media (max-width: 1040px) {
    .sk-nav__phone {
      display: none;
    }
  }

  @media (max-width: 880px) {
    .sk-menu-btn {
      display: grid;
    }

    .sk-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      padding: 12px 16px 16px;
      border-bottom: 1px solid var(--sk-line);
      background: var(--sk-bg);
    }

    .sk-nav.is-open {
      display: flex;
    }

    .sk-nav ul,
    .sk-nav__end {
      flex-direction: column;
      align-items: stretch;
    }

    .sk-nav__phone {
      display: inline-flex;
    }
  }
</style>
