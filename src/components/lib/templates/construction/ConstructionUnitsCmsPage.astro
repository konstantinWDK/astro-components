---
/**
 * ConstructionUnitsCmsPage — Residential and commercial units sales ledger of the "Strukto"
 * Site OS, built on ConstructionUnitsLedger.
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {typeof constructionData} data - Units and projects.
 */
import ConstructionAppLayout from './ConstructionAppLayout.astro';
import ConstructionOsHeading from '../../app/ConstructionOsHeading.astro';
import ConstructionUnitsLedger from '../../app/ConstructionUnitsLedger.astro';
import { constructionRoutes, constructionData, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  data?: typeof constructionData;
}

const { routes = constructionRoutes, data = constructionData } = Astro.props;
---

<ConstructionAppLayout title="Viviendas" current="unitsCms" routes={routes}>
  <ConstructionOsHeading
    sheet="OS-04"
    title="Viviendas y ventas"
    description="Estado comercial, precio por metro cuadrado y plano de ventas por planta."
    actions={[
      { label: 'Ver ficha pública', href: routes.projectDetail },
      { label: 'Cuadro de mando', href: routes.dashboard },
    ]}
  />
  <ConstructionUnitsLedger units={data.units} projectName={data.projects[0].name} />
</ConstructionAppLayout>
