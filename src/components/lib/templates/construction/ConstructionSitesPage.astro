---
/**
 * ConstructionSitesPage — Active sites overview of the "Strukto" Site OS: situation map of
 * Madrid with interactive pins, health filters and site cards (ConstructionSitesBoard).
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {typeof constructionData} data - Active sites data.
 */
import ConstructionAppLayout from './ConstructionAppLayout.astro';
import ConstructionOsHeading from '../../app/ConstructionOsHeading.astro';
import ConstructionSitesBoard from '../../app/ConstructionSitesBoard.astro';
import { constructionRoutes, constructionData, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  data?: typeof constructionData;
}

const { routes = constructionRoutes, data = constructionData } = Astro.props;
---

<ConstructionAppLayout title="Obras" current="sites" routes={routes}>
  <ConstructionOsHeading
    sheet="OS-02"
    title="Obras en ejecución"
    description="Plano de situación, desvío de certificación, personal en tajo y alertas activas."
    actions={[
      { label: 'Diario de obra', href: routes.dailyLog, primary: true },
      { label: 'Cuadro de mando', href: routes.dashboard },
    ]}
  />
  <ConstructionSitesBoard sites={data.sites} logHref={routes.dailyLog} projectBase={routes.projects} variant="map" />
</ConstructionAppLayout>

