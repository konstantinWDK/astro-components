---
/**
 * ConstructionDashboardPage — Executive overview of the "Strukto" Site OS: live KPIs across active
 * sites (active works, certified vs planned budget, crew on site, available homes) and the
 * interactive ConstructionGanttBoard for the flagship development.
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {typeof constructionData} data - Projects, sites and units.
 */
import ConstructionAppLayout from './ConstructionAppLayout.astro';
import ConstructionOsHeading from '../../app/ConstructionOsHeading.astro';
import ConstructionGanttBoard from '../../app/ConstructionGanttBoard.astro';
import { constructionRoutes, constructionData, formatEurShort, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  data?: typeof constructionData;
}

const { routes = constructionRoutes, data = constructionData } = Astro.props;

const activeSites = data.sites.length;
const alertsCount = data.sites.reduce((s, site) => s + site.alerts.length, 0);
const totalCrew = data.sites.reduce((s, site) => s + site.crew, 0);
const totalBudget = data.sites.reduce((s, site) => s + site.budget, 0);
const certifiedValue = data.sites.reduce((s, site) => s + (site.budget * site.certified) / 100, 0);
const avgCertified = Math.round((certifiedValue / totalBudget) * 100);
const freeUnits = data.units.filter((u) => u.status === 'libre').length;
const mainProject = data.projects[0];
---

<ConstructionAppLayout title="Cuadro de mando" current="dashboard" routes={routes}>
  <ConstructionOsHeading
    sheet="OS-01"
    title="Cuadro de mando"
    description="Resumen de producción certificada, cuadrillas en tajo y planning maestro de obra."
    actions={[
      { label: 'Diario de hoy', href: routes.dailyLog, primary: true },
      { label: `Obras (${activeSites})`, href: routes.sites },
    ]}
  />

  <section class="sk-ui sk-dash-kpis" aria-label="Indicadores generales">
    <article class="sk-dash-kpi sk-crop">
      <p class="sk-dash-kpi__label sk-mono">Certificación acumulada</p>
      <p class="sk-dash-kpi__value">{avgCertified}%</p>
      <p class="sk-dash-kpi__meta sk-mono">{formatEurShort(certifiedValue)} de {formatEurShort(totalBudget)}</p>
    </article>

    <article class="sk-dash-kpi">
      <p class="sk-dash-kpi__label sk-mono">Obras activas</p>
      <p class="sk-dash-kpi__value">{activeSites}</p>
      <p class="sk-dash-kpi__meta sk-mono">{alertsCount} alertas abiertas</p>
    </article>

    <article class="sk-dash-kpi">
      <p class="sk-dash-kpi__label sk-mono">Personal en tajo hoy</p>
      <p class="sk-dash-kpi__value">{totalCrew}</p>
      <p class="sk-dash-kpi__meta sk-mono">Subcontratas y equipo propio</p>
    </article>

    <article class="sk-dash-kpi">
      <p class="sk-dash-kpi__label sk-mono">Viviendas libres</p>
      <p class="sk-dash-kpi__value">{freeUnits}</p>
      <p class="sk-dash-kpi__meta sk-mono"><a href={routes.unitsCms}>Abrir inventario →</a></p>
    </article>
  </section>

  <div class="sk-dash-gantt">
    <ConstructionGanttBoard
      phases={mainProject.phases}
      today={46}
      title={`Planning · ${mainProject.name}`}
      startDate="2025-02-03"
      variant="full"
    />
  </div>
</ConstructionAppLayout>

<style>
  .sk-dash-kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
  }

  .sk-dash-kpi {
    display: grid;
    gap: 6px;
    padding: 18px;
    border: 1px solid var(--sk-line-soft);
    background: var(--sk-panel);
  }

  .sk-dash-kpi__label {
    margin: 0;
    color: var(--sk-ink-3);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .sk-dash-kpi__value {
    margin: 0;
    color: var(--sk-ink);
    font-family: var(--sk-font-display);
    font-stretch: 120%;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    line-height: 1;
  }

  .sk-dash-kpi__meta {
    margin: 0;
    color: var(--sk-ink-2);
    font-size: 0.78rem;
  }

  .sk-dash-kpi__meta a {
    color: var(--sk-accent);
    text-decoration: none;
  }

  .sk-dash-kpi__meta a:hover {
    text-decoration: underline;
  }

  .sk-dash-kpi__meta a:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 2px;
  }
</style>
