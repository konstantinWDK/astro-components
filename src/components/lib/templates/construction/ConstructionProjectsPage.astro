---
/**
 * ConstructionProjectsPage — Project portfolio of the "Strukto" template: every project as a
 * drawing sheet with filters by type and status and sorting.
 *
 * @param {ConstructionRoutes} routes - Template route URLs.
 * @param {typeof constructionData} data - Projects.
 */
import ConstructionSiteLayout from './ConstructionSiteLayout.astro';
import ConstructionProjectSheets from '../../sections/ConstructionProjectSheets.astro';
import { constructionRoutes, constructionData, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
  data?: typeof constructionData;
}

const { routes = constructionRoutes, data = constructionData } = Astro.props;
const m2 = data.projects.reduce((s, p) => s + p.areaM2, 0).toLocaleString('es-ES');
---

<ConstructionSiteLayout title={`Proyectos · ${data.company.name}`} description="Obra nueva, rehabilitación, oficinas y naves construidas por Strukto en Madrid." current="projects" routes={routes}>
  <header class="sk-ui sk-pp__head sk-grid-bg">
    <p class="sk-mono">Archivo de planos · {data.projects.length} proyectos · {m2} m²</p>
    <h1>Proyectos</h1>
  </header>
  <ConstructionProjectSheets projects={data.projects} detailBase={routes.projects} title="Todos los planos" />
</ConstructionSiteLayout>

<style>
  .sk-pp__head {
    padding: clamp(2.5rem, 7vw, 5rem) 16px;
    border-bottom: 1px solid var(--sk-line);
  }

  .sk-pp__head > * {
    max-width: 1280px;
    margin-inline: auto;
  }

  .sk-pp__head p {
    margin-bottom: 8px;
    color: var(--sk-accent);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .sk-pp__head h1 {
    margin-top: 0;
    margin-bottom: 0;
    font-family: var(--sk-font-display);
    font-stretch: 125%;
    font-size: clamp(2.6rem, 10vw, 6rem);
    font-weight: 800;
    line-height: 0.9;
    text-transform: uppercase;
  }
</style>
