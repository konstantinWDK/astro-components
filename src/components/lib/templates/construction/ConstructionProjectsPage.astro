---
/**
 * ConstructionProjectsPage — Complete developments catalog and executed works showcase.
 * Displays residential promotions, commercial hubs, logistics centers and rehabilitation projects
 * with surface areas, budgets, progress bars and direct access to project dossiers.
 *
 * @param {ConstructionRoutes} routes - Template route paths.
 */
import ConstructionSiteLayout from './ConstructionSiteLayout.astro';
import ConstructionProjectsGrid from '../../sections/ConstructionProjectsGrid.astro';
import { constructionRoutes, constructionProjects, type ConstructionRoutes } from './data';

interface Props {
  routes?: ConstructionRoutes;
}

const { routes = constructionRoutes } = Astro.props;
---

<ConstructionSiteLayout
  title="Portfolio de Obras & Edificaciones — Strukto Constructora"
  description="Explore nuestra selección de obras ejecutadas y promociones inmobiliarias en curso en la Comunidad de Madrid y principales ciudades."
  routes={routes}
>
  <div class="projects-page-hero">
    <div class="page-container">
      <span class="page-tag">Catálogo de Edificación & Obras</span>
      <h1 class="page-title">Proyectos Singulares & Desarrollos Inmobiliarios</h1>
      <p class="page-desc">
        Más de 148.000 m² construidos con los más altos estándares de calidad, rigor en la ejecución estructural, acabados de alta gama y certificación medioambiental Passivhaus y BREEAM.
      </p>

      <div class="kpi-band">
        <div class="kpi-item">
          <span class="kpi-num">6</span>
          <span class="kpi-label">Obras Activas en Ejecución</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">840+</span>
          <span class="kpi-label">Viviendas Entregadas</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">100%</span>
          <span class="kpi-label">Control Presupuestario</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">35</span>
          <span class="kpi-label">Años de Trayectoria</span>
        </div>
      </div>
    </div>
  </div>

  <ConstructionProjectsGrid
    projects={constructionProjects}
    detailBase={routes.projects}
  />
</ConstructionSiteLayout>

<style>
  .projects-page-hero {
    background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.12) 0%, rgba(9, 13, 22, 1) 70%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4rem 1.5rem 3.5rem;
    text-align: center;
  }

  .page-container {
    max-width: 960px;
    margin: 0 auto;
  }

  .page-tag {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #f59e0b;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    color: #f8fafc;
    margin: 0 0 1.25rem;
  }

  .page-desc {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 auto 2.5rem;
    max-width: 780px;
  }

  .kpi-band {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .kpi-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .kpi-num {
    font-size: 1.85rem;
    font-weight: 800;
    color: #f59e0b;
    font-family: 'JetBrains Mono', monospace;
  }

  .kpi-label {
    font-size: 0.8rem;
    color: #94a3b8;
    text-align: center;
  }
</style>
