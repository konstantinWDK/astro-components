---
/**
 * WineHomePage — Home of the "Solera" winery template: hero, a first look at the wines, the vintage scroll scene and press scores.
 *
 * @param {WineRoutes} routes - Template route URLs.
 * @param {typeof wineData} data - Wines, parcels, visits, member, cellar and shipments.

 */
import WineSiteLayout from './WineSiteLayout.astro';
import WineHero from '../../sections/WineHero.astro';
import WineCollection from '../../sections/WineCollection.astro';
import WineVintageScene from '../../sections/WineVintageScene.astro';
import WineAwards from '../../sections/WineAwards.astro';
import { wineRoutes, wineData, type WineRoutes } from './data';

interface Props {
  routes?: WineRoutes;
  data?: typeof wineData;
}

const { routes = wineRoutes, data = wineData } = Astro.props;
---

<WineSiteLayout
  title={`${data.brand.name} · Bodega de altura en Ribera del Duero`}
  description="Vinos de parcela a 920 metros, vendimiados a mano y criados bajo tierra. Visitas con cata y club de socios."
  routes={routes}
>
  <WineHero winesHref={routes.wines} visitsHref={routes.visits} stats={data.stats} />
  <WineCollection wines={data.wines.slice(0, 3)} clubHref={routes.club} title="Tres para empezar" filter={false} />
  <WineVintageScene stages={data.stages} />
  <WineAwards awards={data.awards} />
</WineSiteLayout>
