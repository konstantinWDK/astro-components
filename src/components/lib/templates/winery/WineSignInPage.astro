---
/**
 * WineSignInPage — Members sign-in: a full-screen split with a generated wine label and the form.
 * Standalone document (no site header or footer).
 *
 * @param {WineRoutes} routes - Template route URLs.
 * @param {string} action - Backend endpoint for the form. Empty runs a demo sign-in.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 */
import '../../../../styles/global.css';
import './wine-theme.css';
import WineSignIn from '../../app/WineSignIn.astro';
import { wineRoutes, type WineRoutes } from './data';

interface Props {
  routes?: WineRoutes;
  action?: string;
  theme?: 'light' | 'dark' | 'auto';
}

const { routes = wineRoutes, action = '', theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-wine" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso de socios — Solera</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="wine-si-body">
    <main id="main-content">
      <WineSignIn dashboardHref={routes.dashboard} joinHref={routes.club} homeHref={routes.home} action={action} />
    </main>
  </body>
</html>

<style>
  .wine-si-body {
    margin: 0;
    background: var(--wn-bg);
    color: var(--wn-text);
    font-family: var(--wn-font-body);
  }
</style>
