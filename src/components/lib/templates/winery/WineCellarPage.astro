---
/**
 * WineCellarPage — The member cellar with drinking windows and ratings, and the tasting notebook.
 *
 * @param {WineRoutes} routes - Template route URLs.
 * @param {typeof wineData} data - Member, cellar, shipments, notes and plan.
 */
import WineMemberLayout from './WineMemberLayout.astro';
import WineMemberHeading from '../../app/WineMemberHeading.astro';
import WineCellar from '../../app/WineCellar.astro';
import WineTastingNotebook from '../../app/WineTastingNotebook.astro';
import { wineRoutes, wineData, type WineRoutes } from './data';

interface Props {
  routes?: WineRoutes;
  data?: typeof wineData;
}

const { routes = wineRoutes, data = wineData } = Astro.props;
---

<WineMemberLayout title="Mi bodega" current="cellar" routes={routes}>
  <WineMemberHeading kicker="Área de socios" title="Mi bodega" description="Cuántas botellas te quedan, cuándo abrirlas y qué te pareció cada una." />
  <WineCellar cellar={data.cellar} wines={data.wines} notesHref="#cuaderno" />
  <section class="wine-app-section" id="cuaderno" aria-labelledby="cuaderno-title">
    <h2 id="cuaderno-title">Cuaderno de cata</h2>
    <WineTastingNotebook notes={data.notes} wines={data.wines} />
  </section>
</WineMemberLayout>
