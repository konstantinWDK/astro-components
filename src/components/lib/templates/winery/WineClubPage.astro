---
/**
 * WineClubPage — The wine club: a live configurator for bottles, style and frequency, plus FAQ.
 *
 * @param {WineRoutes} routes - Template route URLs.
 * @param {typeof wineData} data - Wines, parcels, visits, member, cellar and shipments.
 * @param {string} action - Backend endpoint for the sign-up form. Empty shows a demo confirmation.
 */
import WineSiteLayout from './WineSiteLayout.astro';
import WineClub from '../../sections/WineClub.astro';
import WineFaq from '../../sections/WineFaq.astro';
import { wineRoutes, wineData, type WineRoutes } from './data';

interface Props {
  routes?: WineRoutes;
  data?: typeof wineData;
  action?: string;
}

const { routes = wineRoutes, data = wineData, action = '' } = Astro.props;
---

<WineSiteLayout
  title={`El club · ${data.brand.name}`}
  description="Elige cuántas botellas, qué estilo y cada cuánto. Sin permanencia: pausa, salta o cancela cuando quieras."
  current="club"
  routes={routes}
>
  <WineClub action={action} headingLevel="h1" />
  <WineFaq faqs={data.faqs} />
</WineSiteLayout>
