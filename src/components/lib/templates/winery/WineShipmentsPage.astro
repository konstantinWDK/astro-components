---
/**
 * WineShipmentsPage — Shipments with tracking and actions (postpone, skip, change address) and plan management.
 *
 * @param {WineRoutes} routes - Template route URLs.
 * @param {typeof wineData} data - Member, cellar, shipments, notes and plan.
 */
import WineMemberLayout from './WineMemberLayout.astro';
import WineMemberHeading from '../../app/WineMemberHeading.astro';
import WineShipmentTracker from '../../app/WineShipmentTracker.astro';
import WinePlanManager from '../../app/WinePlanManager.astro';
import { wineRoutes, wineData, type WineRoutes } from './data';

interface Props {
  routes?: WineRoutes;
  data?: typeof wineData;
}

const { routes = wineRoutes, data = wineData } = Astro.props;
---

<WineMemberLayout title="Envíos" current="shipments" routes={routes}>
  <WineMemberHeading kicker="Área de socios" title="Envíos y plan" description="Sigue tus cajas, aplaza o salta un envío y ajusta tu plan cuando quieras." />
  <WineShipmentTracker shipments={data.shipments} wines={data.wines} />
  <section class="wine-app-section" aria-labelledby="plan-title">
    <h2 id="plan-title">Mi plan</h2>
    <WinePlanManager plan={data.plan} />
  </section>
</WineMemberLayout>
