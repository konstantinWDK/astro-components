---
/**
 * WineDashboardPage — Members home: next box with countdown, cellar figures and a suggestion of what to open.
 *
 * @param {WineRoutes} routes - Template route URLs.
 * @param {typeof wineData} data - Member, cellar, shipments, notes and plan.
 */
import WineMemberLayout from './WineMemberLayout.astro';
import WineMemberHeading from '../../app/WineMemberHeading.astro';
import WineMemberSummary from '../../app/WineMemberSummary.astro';
import { wineRoutes, wineData, type WineRoutes } from './data';

interface Props {
  routes?: WineRoutes;
  data?: typeof wineData;
}

const { routes = wineRoutes, data = wineData } = Astro.props;
---

<WineMemberLayout title="Resumen" current="dashboard" routes={routes}>
  <WineMemberHeading kicker="Área de socios" title="Tu próxima caja" description="Lo que llega, lo que guardas y lo que toca abrir este mes." />
  <WineMemberSummary member={data.member} shipment={data.shipments[0]} cellar={data.cellar} wines={data.wines} shipmentsHref={routes.shipments} cellarHref={routes.cellar} />
</WineMemberLayout>
