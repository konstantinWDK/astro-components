---
/**
 * WineVisitsPage — Visit booking: experience, date, time and guests with a live total, plus FAQ.
 *
 * @param {WineRoutes} routes - Template route URLs.
 * @param {typeof wineData} data - Wines, parcels, visits, member, cellar and shipments.
 * @param {string} action - Backend endpoint for the booking form. Empty shows a demo confirmation.
 */
import WineSiteLayout from './WineSiteLayout.astro';
import WineVisits from '../../sections/WineVisits.astro';
import WineFaq from '../../sections/WineFaq.astro';
import { wineRoutes, wineData, type WineRoutes } from './data';

interface Props {
  routes?: WineRoutes;
  data?: typeof wineData;
  action?: string;
}

const { routes = wineRoutes, data = wineData, action = '' } = Astro.props;
---

<WineSiteLayout
  title={`Visitas y catas · ${data.brand.name}`}
  description="Reserva una visita con cata, un picnic entre viñas o un día de vendimia en la bodega."
  current="visits"
  routes={routes}
>
  <WineVisits visits={data.visits} action={action} headingLevel="h1" />
  <WineFaq faqs={data.faqs} />
</WineSiteLayout>
