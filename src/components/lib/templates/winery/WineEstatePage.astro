---
/**
 * WineEstatePage — The estate: family history, an interactive plot map and the year in the vineyard.
 *
 * @param {WineRoutes} routes - Template route URLs.
 * @param {typeof wineData} data - Wines, parcels, visits, member, cellar and shipments.

 */
import WineSiteLayout from './WineSiteLayout.astro';
import WineStory from '../../sections/WineStory.astro';
import WineTerroir from '../../sections/WineTerroir.astro';
import WineVintageScene from '../../sections/WineVintageScene.astro';
import { wineRoutes, wineData, type WineRoutes } from './data';

interface Props {
  routes?: WineRoutes;
  data?: typeof wineData;
}

const { routes = wineRoutes, data = wineData } = Astro.props;
---

<WineSiteLayout
  title={`La finca · ${data.brand.name}`}
  description="Cien años, cuatro generaciones y cinco parcelas a casi mil metros de altitud en Peñafiel."
  current="estate"
  routes={routes}
>
  <WineStory milestones={data.milestones} headingLevel="h1" />
  <WineTerroir parcels={data.parcels} wines={data.wines} />
  <WineVintageScene stages={data.stages} />
</WineSiteLayout>
