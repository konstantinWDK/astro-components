---
/**
 * FoodRidersPage — Fleet dispatch of the "BiteFlow" kitchen OS (FoodRiderDispatch): live map,
 * queue of orders without rider and assignment by distance.
 *
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {typeof foodDeliveryData} data - Riders and orders.
 */
import FoodAppLayout from './FoodAppLayout.astro';
import FoodOpsHeading from '../../app/FoodOpsHeading.astro';
import FoodRiderDispatch from '../../app/FoodRiderDispatch.astro';
import { foodRoutes, foodDeliveryData, type FoodRoutes } from './data';

interface Props {
  routes?: FoodRoutes;
  data?: typeof foodDeliveryData;
}

const { routes = foodRoutes, data = foodDeliveryData } = Astro.props;
const free = data.riders.filter((r) => r.status === 'libre').length;
---

<FoodAppLayout title="Riders" current="riders" routes={routes}>
  <FoodOpsHeading
    kicker="Reparto"
    title="Despacho de riders"
    description={`${data.riders.length} riders en turno, ${free} libres. Elige un pedido y asígnalo al más cercano.`}
  />
  <FoodRiderDispatch riders={data.riders} orders={data.orders} kitchen={{ x: data.tracking.kitchen.x, y: data.tracking.kitchen.y }} />
</FoodAppLayout>
