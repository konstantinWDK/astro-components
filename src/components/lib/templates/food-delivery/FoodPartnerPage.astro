---
/**
 * FoodPartnerPage — Restaurant partner page of the "BiteFlow" template: what you get, the savings
 * calculator with sign-up (FoodPartnerPitch) and an FAQ.
 *
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {string} action - Optional sign-up form action.
 */
import FoodSiteLayout from './FoodSiteLayout.astro';
import FoodPartnerPitch from '../../sections/FoodPartnerPitch.astro';
import { foodRoutes, foodBrand, type FoodRoutes } from './data';

interface Props {
  routes?: FoodRoutes;
  action?: string;
}

const { routes = foodRoutes, action } = Astro.props;

const perks = [
  { title: 'Tu web y tu app', text: 'Con tu marca, tu carta y pagos con Bizum o al repartidor.' },
  { title: 'Pantalla de cocina', text: 'Comandas con cronómetro, alergias resaltadas y aviso de retraso.' },
  { title: 'Riders eléctricos', text: 'Flota propia en un radio de 1,8 km o usa la tuya.' },
  { title: 'Clientes tuyos', text: 'Los datos y las valoraciones son de tu restaurante, no del agregador.' },
];
const faq = [
  { q: '¿Hay permanencia?', a: 'No. Pagas por semana o por pedido y puedes darte de baja cuando quieras.' },
  { q: '¿Cuánto tardáis en dar de alta mi carta?', a: 'Unas 48 horas: fotografiamos o ilustramos los platos, cargamos la carta y te enviamos la tablet KDS.' },
  { q: '¿Puedo seguir en otras plataformas?', a: 'Sí. El panel de carta apaga un plato agotado en todos los canales a la vez.' },
];
---

<FoodSiteLayout title={`Para restaurantes · ${foodBrand.name}`} description="Vende a domicilio sin comisiones abusivas: web, app, pantalla de cocina y riders eléctricos." current="partner" routes={routes}>
  <section class="bf-ui bf-partner" aria-labelledby="bf-partner-h">
    <h1 id="bf-partner-h" class="bf-partner__title">Cocina tú.<br /><span>Del resto nos encargamos.</span></h1>
    <ul class="bf-partner__perks" role="list">
      {perks.map((p, i) => (
        <li style={`--r:${(i % 2 ? 1 : -1) * 1.2}deg`}><h2>{p.title}</h2><p>{p.text}</p></li>
      ))}
    </ul>
  </section>
  <FoodPartnerPitch action={action} />
  <section class="bf-ui bf-partner__faq" aria-labelledby="bf-faq-h">
    <h2 id="bf-faq-h">Preguntas frecuentes</h2>
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
</FoodSiteLayout>

<style>
  .bf-partner {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(2.5rem, 7vw, 5rem) var(--sp-4, 1rem);
  }

  .bf-partner__title {
    margin: 0;
    font-family: var(--bf-font-display);
    font-size: clamp(2.6rem, 10vw, 5.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .bf-partner__title span {
    color: var(--bf-tomato);
  }

  .bf-partner__perks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: var(--sp-4, 1rem);
    margin: var(--sp-8, 2rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .bf-partner__perks li {
    padding: var(--sp-5, 1.25rem);
    border: 3px solid var(--bf-outline);
    border-radius: 22px;
    background: var(--bf-paper);
    box-shadow: var(--bf-shadow);
    transform: rotate(var(--r));
    transition: transform 0.3s var(--bf-ease-pop);
  }

  .bf-partner__perks li:hover {
    transform: rotate(0) translateY(-4px);
  }

  .bf-partner__perks h2 {
    margin: 0;
    font-family: var(--bf-font-display);
    font-size: 1.35rem;
    font-weight: 800;
  }

  .bf-partner__perks p {
    margin: 6px 0 0;
    color: var(--bf-ink-2);
  }

  .bf-partner__faq {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--sp-4, 1rem);
  }

  .bf-partner__faq h2 {
    margin: 0 0 var(--sp-5, 1.25rem);
    font-family: var(--bf-font-display);
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    font-weight: 800;
  }

  .bf-partner__faq details {
    margin-bottom: 10px;
    border: 3px solid var(--bf-outline);
    border-radius: 18px;
    background: var(--bf-paper);
  }

  .bf-partner__faq summary {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0 18px;
    font-weight: 800;
    cursor: pointer;
  }

  .bf-partner__faq summary:focus-visible {
    outline: 3px solid var(--bf-sky);
    outline-offset: 2px;
    border-radius: 15px;
  }

  .bf-partner__faq details p {
    margin: 0;
    padding: 0 18px 16px;
    color: var(--bf-ink-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .bf-partner__perks li {
      transition: none;
    }
  }
</style>
