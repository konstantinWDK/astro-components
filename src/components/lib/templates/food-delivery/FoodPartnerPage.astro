---
/**
 * FoodPartnerPage — Restaurant & Ghost Kitchen B2B partnership and onboarding page.
 * Features Kitchen OS technology benefits, commission plans, and a signup registration form.
 */
import FoodSiteLayout from './FoodSiteLayout.astro';
import { foodDeliveryRoutes, type FoodDeliveryRoutes } from './data';

interface Props {
  routes?: FoodDeliveryRoutes;
}

const { routes = foodDeliveryRoutes } = Astro.props;

const tiers = [
  {
    name: 'Starter Kitchen',
    fee: '12%',
    sub: 'Per delivered order',
    desc: 'Ideal for independent food trucks, bakeries and single-location ghost kitchens.',
    features: [
      'Access to BiteFlow customer marketplace',
      'Web-based KDS tablet app',
      'Instant 86’d stock menu editor',
      'Automated e-bike courier dispatch',
      'Weekly automated payouts',
    ],
    cta: 'Start Free Trial',
  },
  {
    name: 'Pro Multi-Brand OS',
    fee: '8%',
    popular: true,
    sub: 'Per delivered order + 49€/mo',
    desc: 'For busy dark kitchens, multi-brand restaurant groups and high-volume delivery operations.',
    features: [
      'Multi-station KDS displays (Fryer, Grill, Packing)',
      'Multi-brand virtual menus from 1 kitchen',
      'Custom allergen & modifier workflow',
      'Dedicated delivery courier fleet priority',
      'Real-time food waste & ingredient analytics',
      '24/7 Priority restaurant operations hotline',
    ],
    cta: 'Claim Pro Hardware Kit',
  },
];
---

<FoodSiteLayout
  title="Partner with BiteFlow — Kitchen OS & Delivery Platform"
  routes={routes}
>
  <div class="partner-hero">
    <div class="partner-hero__inner">
      <span class="eyebrow">Grow Your Culinary Business</span>
      <h1 class="hero-title">Supercharge Your Kitchen with Next-Gen Delivery &amp; Kitchen OS</h1>
      <p class="hero-desc">
        Connect to hungry local diners, eradicate lost tickets with tactile KDS displays, and manage your entire delivery operations from one screen.
      </p>

      <div class="hero-cta-group">
        <a href="#partner-form" class="btn-primary">Register Your Restaurant</a>
        <a href={routes.dashboard} class="btn-secondary">Test Kitchen OS Live Demo →</a>
      </div>
    </div>
  </div>

  <section class="partner-stats-band">
    <div class="stats-container">
      <div class="stat-box">
        <span class="stat-number">+32%</span>
        <span class="stat-label">Faster Ticket Prep Time with KDS</span>
      </div>
      <div class="stat-box">
        <span class="stat-number">99.8%</span>
        <span class="stat-label">Modifier &amp; Allergy Accuracy</span>
      </div>
      <div class="stat-box">
        <span class="stat-number">22 min</span>
        <span class="stat-label">Average Courier Delivery Speed</span>
      </div>
      <div class="stat-box">
        <span class="stat-number">0 €</span>
        <span class="stat-label">Setup Fee · Hardware Tablet Included</span>
      </div>
    </div>
  </section>

  <!-- Pricing & Commission Tiers -->
  <section class="partner-tiers-section">
    <div class="tiers-container">
      <div class="section-head">
        <h2 class="section-title">Transparent Restaurant Partnership Plans</h2>
        <p class="section-sub">Zero lock-in contracts. Transparent commission tiers that scale with your order volume.</p>
      </div>

      <div class="tiers-grid">
        {tiers.map((t) => (
          <div class={`tier-card ${t.popular ? 'is-popular' : ''}`}>
            {t.popular && <span class="popular-ribbon">⭐ Most Popular</span>}
            <h3 class="tier-name">{t.name}</h3>
            <div class="tier-price-wrap">
              <span class="tier-rate">{t.fee}</span>
              <span class="tier-sub">{t.sub}</span>
            </div>
            <p class="tier-desc">{t.desc}</p>

            <ul class="tier-features">
              {t.features.map((f) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <a href="#partner-form" class={`tier-btn ${t.popular ? 'popular' : ''}`}>{t.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partner Onboarding Form -->
  <section class="partner-form-section" id="partner-form">
    <div class="form-container">
      <div class="form-card">
        <div class="form-card-head">
          <h2 class="form-title">Join BiteFlow in 3 Simple Steps</h2>
          <p class="form-sub">Fill out your kitchen details below. Our culinary operations team will deliver your tablet within 48 hours.</p>
        </div>

        <form class="partner-app-form">
          <div class="form-row-2">
            <div class="field-wrap">
              <label>Restaurant / Brand Name</label>
              <input type="text" placeholder="e.g. Smashed Bros Burgers" required />
            </div>
            <div class="field-wrap">
              <label>Cuisine Category</label>
              <select required>
                <option value="">Select primary cuisine...</option>
                <option value="burgers">Burgers &amp; Sandwiches</option>
                <option value="pizza">Pizza &amp; Italian</option>
                <option value="asian">Asian &amp; Bowls</option>
                <option value="tacos">Mexican &amp; Tacos</option>
                <option value="bakery">Bakery &amp; Desserts</option>
              </select>
            </div>
          </div>

          <div class="form-row-2">
            <div class="field-wrap">
              <label>Kitchen Street Address</label>
              <input type="text" placeholder="e.g. Calle Fuencarral 88, Madrid" required />
            </div>
            <div class="field-wrap">
              <label>Manager Mobile Number</label>
              <input type="tel" placeholder="+34 600 000 000" required />
            </div>
          </div>

          <div class="field-wrap">
            <label>Current Delivery Setup</label>
            <div class="radio-choices">
              <label class="choice-pill">
                <input type="radio" name="setup" value="new" checked />
                <span>Launching first delivery brand</span>
              </label>
              <label class="choice-pill">
                <input type="radio" name="setup" value="existing" />
                <span>Existing restaurant switching to BiteFlow OS</span>
              </label>
            </div>
          </div>

          <button type="submit" class="submit-partner-btn">
            <span>Submit Kitchen Application</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>
</FoodSiteLayout>

<style>
  .partner-hero {
    padding: 5rem 1.5rem 4rem;
    background: radial-gradient(circle at 50% 10%, rgba(234, 88, 12, 0.15) 0%, transparent 60%),
                #0f172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }

  .partner-hero__inner {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .eyebrow {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ea580c;
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-desc {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  .btn-primary {
    padding: 0.85rem 1.75rem;
    background: #ea580c;
    color: #ffffff;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(234, 88, 12, 0.4);
  }

  .btn-primary:hover {
    background: #c2410c;
  }

  .btn-secondary {
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Stats band */
  .partner-stats-band {
    padding: 2.5rem 1.5rem;
    background: #0b0f19;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stats-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: center;
  }

  .stat-number {
    font-size: 2.4rem;
    font-weight: 800;
    color: #ea580c;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  /* Tiers */
  .partner-tiers-section {
    padding: 5rem 1.5rem;
    background: var(--c-bg, #0b0f19);
  }

  .tiers-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .section-sub {
    font-size: 1rem;
    color: #94a3b8;
    margin: 0;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .tier-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
  }

  .tier-card.is-popular {
    border-color: #ea580c;
    background: linear-gradient(145deg, rgba(234, 88, 12, 0.1), rgba(30, 41, 59, 0.7));
    box-shadow: 0 15px 35px -10px rgba(234, 88, 12, 0.2);
  }

  .popular-ribbon {
    position: absolute;
    top: -12px;
    right: 24px;
    padding: 0.25rem 0.75rem;
    background: #ea580c;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    border-radius: 9999px;
  }

  .tier-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .tier-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .tier-rate {
    font-size: 2.8rem;
    font-weight: 800;
    color: #ea580c;
  }

  .tier-sub {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .tier-desc {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tier-features li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: #cbd5e1;
  }

  .tier-features svg {
    color: #22c55e;
    flex-shrink: 0;
  }

  .tier-btn {
    margin-top: auto;
    padding: 0.85rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .tier-btn.popular {
    background: #ea580c;
  }

  .tier-btn.popular:hover {
    background: #c2410c;
  }

  /* Form */
  .partner-form-section {
    padding: 4rem 1.5rem 6rem;
    background: #0f172a;
  }

  .form-container {
    max-width: 780px;
    margin: 0 auto;
  }

  .form-card {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .form-card-head {
    margin-bottom: 2rem;
  }

  .form-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.4rem;
  }

  .form-sub {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: 0;
  }

  .partner-app-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 600px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }

  .field-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .field-wrap label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .field-wrap input,
  .field-wrap select {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 0.95rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.92rem;
    outline: none;
  }

  .field-wrap input:focus,
  .field-wrap select:focus {
    border-color: #ea580c;
  }

  .radio-choices {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .choice-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    font-size: 0.85rem;
    color: #cbd5e1;
    cursor: pointer;
  }

  .choice-pill input {
    accent-color: #ea580c;
  }

  .submit-partner-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem;
    background: #ea580c;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(234, 88, 12, 0.4);
    margin-top: 0.75rem;
  }

  .submit-partner-btn:hover {
    background: #c2410c;
  }
</style>

