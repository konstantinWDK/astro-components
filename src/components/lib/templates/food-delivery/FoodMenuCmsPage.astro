---
/**
 * FoodMenuCmsPage — Restaurant Menu & Stock CMS editor for BiteFlow Kitchen OS.
 * Enables live price tuning, quick 86'd out-of-stock toggles, calorie counts and allergen updates.
 */
import FoodLayout from './FoodLayout.astro';
import FoodMenuCmsEditor from '../../app/FoodMenuCmsEditor.astro';
import { foodDeliveryRoutes, foodDeliveryData, type FoodDeliveryRoutes } from './data';

interface Props {
  routes?: FoodDeliveryRoutes;
}

const { routes = foodDeliveryRoutes } = Astro.props;
---

<FoodLayout
  title="Menu CMS & Stock Control (86'd)"
  current="menuCms"
  routes={routes}
>
  <div class="menu-cms-page-wrap">
    <FoodMenuCmsEditor
      dishes={foodDeliveryData.dishes}
    />
  </div>
</FoodLayout>

<style>
  .menu-cms-page-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>

