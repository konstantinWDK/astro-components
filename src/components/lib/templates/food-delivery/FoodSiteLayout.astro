---
/**
 * FoodSiteLayout — Public layout for the "BiteFlow" food delivery template: skip link, open-now
 * strip, sticky sticker header (nav collapses into a disclosure on phones) with the cart button
 * (FoodCartDrawer, so dishes fly into it from any page), and FoodFooter.
 *
 * @param {string} title - Document title.
 * @param {string} description - Meta description.
 * @param {string} current - Active nav key (home | menu | tracking | partner).
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'light'.
 * @param {boolean} noindex - Adds a robots noindex meta.
 * @param {string} lang - Document language. Default 'es'.
 *
 * Accessibility: skip link to #main-content, aria-current on the active link, the menu button
 * exposes aria-expanded / aria-controls and closes on Escape.
 */
import '../../../../styles/global.css';
import './food-theme.css';
import FoodFooter from '../../sections/FoodFooter.astro';
import FoodCartDrawer from '../../app/FoodCartDrawer.astro';
import { foodRoutes, foodBrand, type FoodRoutes } from './data';

type NavKey = 'home' | 'menu' | 'tracking' | 'partner';

interface Props {
  title: string;
  description?: string;
  current?: NavKey;
  routes?: FoodRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = 'BiteFlow · Comida a domicilio en Madrid cocinada al momento: smash burgers, ramen, tacos, pizza y poke. Entrega en ~24 min con seguimiento en directo.',
  current,
  routes = foodRoutes,
  theme = 'light',
  noindex = false,
  lang = 'es',
} = Astro.props;

const navLinks: Array<{ key: NavKey; label: string; href: string }> = [
  { key: 'menu', label: 'Carta', href: routes.menu },
  { key: 'tracking', label: 'Seguir pedido', href: routes.tracking },
  { key: 'partner', label: 'Restaurantes', href: routes.partner },
];

const footerColumns = [
  { title: 'Pide', links: [{ label: 'La carta', href: routes.menu }, { label: 'Seguir mi pedido', href: routes.tracking }, { label: 'Envío gratis desde 25 €', href: routes.menu }] },
  { title: 'BiteFlow', links: [{ label: 'Para restaurantes', href: routes.partner }, { label: 'Acceso equipo', href: routes.signIn }, { label: 'Kitchen OS (demo)', href: routes.dashboard }] },
];
---

<!doctype html>
<html lang={lang} class="theme-food" data-theme={theme === 'auto' ? 'light' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=DM+Sans:opsz,wght@9..40,400..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="bf-body" id="top">
    <a href="#main-content" class="bf-skip">Saltar al contenido</a>

    <p class="bf-strip">
      <span class="bf-strip__dot" aria-hidden="true"></span>
      Abierto · {foodBrand.hours} · envío gratis desde {foodBrand.freeDeliveryFrom} €
    </p>

    <header class="bf-header">
      <div class="bf-header__inner">
        <a href={routes.home} class="bf-logo" aria-label={`${foodBrand.name}, inicio`}>
          <span class="bf-logo__mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13a8 8 0 0 0 16 0z" /><path d="M8 9c0-2 2-2 2-4M13 9c0-2 2-2 2-4" /></svg>
          </span>
          <span class="bf-logo__name">{foodBrand.name}</span>
        </a>

        <nav id="bf-nav" class="bf-mainnav" aria-label="Navegación principal">
          <ul role="list">
            {navLinks.map((l) => (
              <li><a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
            ))}
            <li><a href={routes.signIn} class="bf-mainnav__crew">Equipo</a></li>
          </ul>
        </nav>

        <div class="bf-header__end">
          <FoodCartDrawer trackHref={routes.tracking} deliveryFee={foodBrand.deliveryFee} freeFrom={foodBrand.freeDeliveryFrom} minutes={foodBrand.avgMinutes} />
          <button type="button" class="bf-menu-btn" aria-expanded="false" aria-controls="bf-nav" data-bf-menu-btn>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <span class="bf-sr">Menú</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" class="bf-main" tabindex="-1">
      <slot />
    </main>

    <FoodFooter
      brand={foodBrand.name}
      columns={footerColumns}
      contact={{ address: foodBrand.address, phone: foodBrand.phone, email: foodBrand.email, hours: foodBrand.hours }}
      copyright={`© ${new Date().getFullYear()} ${foodBrand.legalName} · Madrid`}
    />

    <script>
      function initBfMenu() {
        const btn = document.querySelector<HTMLButtonElement>('[data-bf-menu-btn]');
        const nav = document.getElementById('bf-nav');
        if (!btn || !nav || btn.dataset.bound) return;
        btn.dataset.bound = 'true';
        const setOpen = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
        };
        btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            btn.focus();
          }
        });
      }
      initBfMenu();
      document.addEventListener('astro:page-load', initBfMenu);
    </script>
  </body>
</html>

<style>
  .bf-body {
    --bf-sticky-top: 72px;
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bf-bg);
    color: var(--bf-ink);
    font-family: var(--bf-font-body);
    overflow-x: clip;
  }

  .bf-skip {
    position: absolute;
    left: var(--sp-4, 1rem);
    top: -100px;
    z-index: 100;
    padding: var(--sp-2, 0.5rem) var(--sp-4, 1rem);
    border: 2px solid var(--bf-outline);
    border-radius: 999px;
    background: var(--bf-mustard);
    color: var(--bf-on-mustard);
    font-weight: 800;
    text-decoration: none;
  }

  .bf-skip:focus {
    top: var(--sp-3, 0.75rem);
  }

  .bf-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px var(--sp-4, 1rem);
    background: var(--bf-night);
    color: var(--bf-on-night);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }

  .bf-strip__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bf-mint);
  }

  .bf-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 3px solid var(--bf-outline);
    background: color-mix(in srgb, var(--bf-bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .bf-header__inner {
    position: relative;
    max-width: 1240px;
    min-height: 66px;
    margin: 0 auto;
    padding: 0 var(--sp-4, 1rem);
    display: flex;
    align-items: center;
    gap: var(--sp-5, 1.25rem);
  }

  .bf-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--bf-ink);
    text-decoration: none;
  }

  .bf-logo__mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 3px solid var(--bf-outline);
    border-radius: 14px;
    background: var(--bf-tomato);
    color: var(--bf-on-tomato);
    transform: rotate(-6deg);
    box-shadow: 3px 3px 0 var(--bf-outline);
    transition: transform 0.3s var(--bf-ease-pop);
  }

  .bf-logo:hover .bf-logo__mark {
    transform: rotate(8deg) scale(1.06);
  }

  .bf-logo__name {
    font-family: var(--bf-font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .bf-mainnav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bf-mainnav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 2px solid transparent;
    border-radius: 999px;
    color: var(--bf-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .bf-mainnav a:hover {
    border-color: var(--bf-line);
  }

  .bf-mainnav a[aria-current='page'] {
    border-color: var(--bf-outline);
    background: var(--bf-mustard);
    color: var(--bf-on-mustard);
  }

  .bf-mainnav__crew {
    color: var(--bf-ink-2) !important;
  }

  .bf-header__end {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .bf-menu-btn {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 2px solid var(--bf-outline);
    border-radius: 50%;
    background: var(--bf-paper);
    color: var(--bf-ink);
    cursor: pointer;
  }

  .bf-header :is(a, button):focus-visible,
  .bf-skip:focus-visible {
    outline: 3px solid var(--bf-sky);
    outline-offset: 2px;
  }

  .bf-main {
    flex: 1;
  }

  .bf-main:focus {
    outline: none;
  }

  @media (max-width: 820px) {
    .bf-menu-btn {
      display: grid;
    }

    .bf-mainnav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: var(--sp-3, 0.75rem) var(--sp-4, 1rem) var(--sp-4, 1rem);
      border-bottom: 3px solid var(--bf-outline);
      background: var(--bf-bg);
    }

    .bf-mainnav.is-open {
      display: block;
      animation: bf-nav-drop 0.3s var(--bf-ease-pop);
    }

    .bf-mainnav ul {
      flex-direction: column;
    }

    .bf-mainnav a {
      width: 100%;
      box-sizing: border-box;
      border-color: var(--bf-line);
      border-radius: 14px;
    }
  }

  @keyframes bf-nav-drop { from { opacity: 0; transform: translateY(-10px); } }

  @media (prefers-reduced-motion: reduce) {
    .bf-header *,
    .bf-mainnav.is-open {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
