---
/**
 * FoodKdsPage — Interactive Kitchen Display System (KDS) page for BiteFlow OS.
 * Designed for wall-mounted touchscreens and commercial kitchen tablets.
 */
import FoodLayout from './FoodLayout.astro';
import FoodKitchenDisplay from '../../app/FoodKitchenDisplay.astro';
import { foodDeliveryRoutes, foodDeliveryData, type FoodDeliveryRoutes } from './data';

interface Props {
  routes?: FoodDeliveryRoutes;
}

const { routes = foodDeliveryRoutes } = Astro.props;
---

<FoodLayout
  title="KDS Kitchen Display System"
  current="kds"
  routes={routes}
>
  <div class="kds-page-container">
    <FoodKitchenDisplay
      tickets={foodDeliveryData.tickets}
      stationName="Station #01 · Smash Grill & Pizza Line"
    />
  </div>
</FoodLayout>

<style>
  .kds-page-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
