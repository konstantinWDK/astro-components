---
/**
 * FoodKdsPage — Kitchen display of the "BiteFlow" kitchen OS (FoodKitchenBoard): lanes, live
 * timers, allergy bands, item tick-off, bump with undo and station filters.
 *
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {typeof foodDeliveryData} data - Tickets.
 */
import FoodAppLayout from './FoodAppLayout.astro';
import FoodKitchenBoard from '../../app/FoodKitchenBoard.astro';
import { foodRoutes, foodDeliveryData, type FoodRoutes } from './data';

interface Props {
  routes?: FoodRoutes;
  data?: typeof foodDeliveryData;
}

const { routes = foodRoutes, data = foodDeliveryData } = Astro.props;
---

<FoodAppLayout title="Pantalla de cocina" current="kds" routes={routes}>
  <h1 class="bf-sr">Pantalla de cocina</h1>
  <FoodKitchenBoard tickets={data.tickets} stationName={`Pase · ${data.brand.kitchen}`} />
</FoodAppLayout>
