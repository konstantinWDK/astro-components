---
/**
 * FoodMenuPage — Full menu of the "BiteFlow" template with category tabs, search, dietary
 * filters and add-to-cart (the cart and 3-step checkout live in the header's FoodCartDrawer).
 *
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {typeof foodDeliveryData} data - Categories and dishes.
 */
import FoodSiteLayout from './FoodSiteLayout.astro';
import FoodMenuBoard from '../../sections/FoodMenuBoard.astro';
import { foodRoutes, foodDeliveryData, type FoodRoutes } from './data';

interface Props {
  routes?: FoodRoutes;
  data?: typeof foodDeliveryData;
}

const { routes = foodRoutes, data = foodDeliveryData } = Astro.props;
---

<FoodSiteLayout
  title={`Carta · ${data.brand.name}`}
  description="Carta de BiteFlow: smash burgers, pizzas de horno, ramen, tacos, poke, postres y bebidas. Pide online y síguelo en directo."
  current="menu"
  routes={routes}
>
  <FoodMenuBoard dishes={data.dishes} categories={data.categories} title="La carta" variant="grid" size="md" />
</FoodSiteLayout>
