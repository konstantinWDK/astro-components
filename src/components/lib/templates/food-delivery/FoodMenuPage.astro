---
/**
 * FoodMenuPage — Complete ordering catalog & dish customization page.
 * Includes category filtering, interactive modifier configurator, and quick checkout wizard.
 */
import FoodSiteLayout from './FoodSiteLayout.astro';
import FoodCategoryRail from '../../sections/FoodCategoryRail.astro';
import FoodDishCustomizer from '../../app/FoodDishCustomizer.astro';
import FoodMenuGrid from '../../sections/FoodMenuGrid.astro';
import FoodCheckoutWizard from '../../sections/FoodCheckoutWizard.astro';
import { foodDeliveryRoutes, foodDeliveryData, type FoodDeliveryRoutes } from './data';

interface Props {
  routes?: FoodDeliveryRoutes;
}

const { routes = foodDeliveryRoutes } = Astro.props;
const sampleDish = foodDeliveryData.dishes[0]; // Truffle smash burger with modifiers
---

<FoodSiteLayout
  title="Full Kitchen Menu & Online Ordering — BiteFlow"
  routes={routes}
>
  <div class="menu-page-header">
    <div class="menu-page-header__inner">
      <div class="header-breadcrumb">
        <a href={routes.home}>Home</a>
        <span>/</span>
        <span>Online Menu</span>
      </div>
      <h1 class="page-title">Handcrafted Kitchen Menu</h1>
      <p class="page-subtitle">Every order is cooked fresh upon receipt. Customise ingredients, patties and dietary options below.</p>
    </div>
  </div>

  <FoodCategoryRail
    baseUrl={routes.menu}
    activeCategory="all"
  />

  <section class="customizer-spotlight" id="customizer">
    <div class="customizer-container">
      <div class="spotlight-badge">
        <span class="spotlight-dot"></span>
        <span>Interactive Dish Customizer · Live Price Calculation</span>
      </div>
      <FoodDishCustomizer
        dish={sampleDish}
        checkoutHref="#checkout"
      />
    </div>
  </section>

  <FoodMenuGrid
    dishes={foodDeliveryData.dishes}
    title="All Kitchen Categories"
    subtitle="Choose your favorite dishes and add them to your delivery bag."
  />

  <section class="checkout-preview-section" id="checkout">
    <div class="checkout-container">
      <div class="checkout-heading">
        <span class="eyebrow">Instant Order</span>
        <h2 class="title">Review Bag &amp; Fast Checkout</h2>
        <p class="subtitle">Complete your delivery address and receive your order in 25 minutes.</p>
      </div>

      <FoodCheckoutWizard
        orderSuccessHref={routes.tracking}
      />
    </div>
  </section>
</FoodSiteLayout>

<style>
  .menu-page-header {
    background: radial-gradient(circle at 50% 0%, rgba(234, 88, 12, 0.12) 0%, transparent 70%), #0f172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3rem 1.5rem 2.5rem;
  }

  .menu-page-header__inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .header-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #64748b;
  }

  .header-breadcrumb a {
    color: #ea580c;
    text-decoration: none;
  }

  .page-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1rem;
    color: #94a3b8;
    margin: 0;
    max-width: 650px;
  }

  .customizer-spotlight {
    padding: 3.5rem 1.5rem 2rem;
    background: radial-gradient(circle at 10% 30%, rgba(234, 88, 12, 0.06) 0%, transparent 50%),
                var(--c-bg, #0b0f19);
  }

  .customizer-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .spotlight-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    background: rgba(234, 88, 12, 0.15);
    border: 1px solid rgba(234, 88, 12, 0.35);
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fb923c;
  }

  .spotlight-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ea580c;
  }

  .checkout-preview-section {
    padding: 4rem 1.5rem 5rem;
    background: #0f172a;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .checkout-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .checkout-heading {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ea580c;
  }

  .title {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
    margin: 0;
  }
</style>
