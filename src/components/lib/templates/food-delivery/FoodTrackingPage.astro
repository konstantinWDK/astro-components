---
/**
 * FoodTrackingPage — Live order tracking of the "BiteFlow" template: animated map with the rider
 * driving to the door, ETA countdown, status steps, rider contact, receipt and rating.
 * Reads ?pedido= to show the order number placed in the checkout.
 *
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {typeof foodDeliveryData} data - Tracking demo and dishes.
 */
import FoodSiteLayout from './FoodSiteLayout.astro';
import FoodOrderMap from '../../app/FoodOrderMap.astro';
import { foodRoutes, foodDeliveryData, type FoodRoutes } from './data';

interface Props {
  routes?: FoodRoutes;
  data?: typeof foodDeliveryData;
}

const { routes = foodRoutes, data = foodDeliveryData } = Astro.props;
---

<FoodSiteLayout title={`Tu pedido · ${data.brand.name}`} current="tracking" routes={routes} noindex>
  <div class="bf-ui bf-trackpage">
    <FoodOrderMap tracking={data.tracking} dishes={data.dishes} durationSec={60} />
    <p class="bf-trackpage__help">¿Algún problema? Llámanos al <a href={`tel:${data.brand.phone.replace(/\s+/g, '')}`}>{data.brand.phone}</a> o <a href={routes.menu}>vuelve a la carta</a>.</p>
  </div>
</FoodSiteLayout>

<style>
  .bf-trackpage {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) var(--sp-4, 1rem) clamp(3rem, 6vw, 5rem);
  }

  .bf-trackpage__help {
    margin: var(--sp-6, 1.5rem) 0 0;
    color: var(--bf-ink-2);
    text-align: center;
  }

  .bf-trackpage__help a {
    color: var(--bf-ink);
    font-weight: 800;
  }

  .bf-trackpage__help a:focus-visible {
    outline: 3px solid var(--bf-sky);
    outline-offset: 2px;
  }
</style>
