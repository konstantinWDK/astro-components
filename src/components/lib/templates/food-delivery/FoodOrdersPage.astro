---
/**
 * FoodOrdersPage — Order book of the "BiteFlow" kitchen OS (FoodOrdersTable) with today's totals
 * per status. Reads ?q= from the top bar search.
 *
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {typeof foodDeliveryData} data - Orders, dishes and riders.
 */
import FoodAppLayout from './FoodAppLayout.astro';
import FoodOpsHeading from '../../app/FoodOpsHeading.astro';
import FoodOrdersTable from '../../app/FoodOrdersTable.astro';
import { foodRoutes, foodDeliveryData, formatEur, type FoodRoutes } from './data';

interface Props {
  routes?: FoodRoutes;
  data?: typeof foodDeliveryData;
}

const { routes = foodRoutes, data = foodDeliveryData } = Astro.props;
const live = data.orders.filter((o) => o.status !== 'entregado' && o.status !== 'cancelado');
const billed = data.orders.filter((o) => o.status !== 'cancelado').reduce((s, o) => s + o.total, 0);
---

<FoodAppLayout title="Pedidos" current="orders" routes={routes}>
  <FoodOpsHeading
    kicker="Pase"
    title="Pedidos de hoy"
    description={`${live.length} en curso · ${formatEur(billed)} facturados en esta lista.`}
    actions={[{ label: 'Exportar CSV' }, { label: 'Pantalla de cocina', href: routes.kds, primary: true }]}
  />
  <FoodOrdersTable orders={data.orders} dishes={data.dishes} riders={data.riders} data-orders-page />
</FoodAppLayout>

<script>
  const q = new URLSearchParams(location.search).get('q');
  const input = document.querySelector<HTMLInputElement>('[data-orders-page] [data-q]');
  if (q && input) {
    input.value = q;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  }
</script>
