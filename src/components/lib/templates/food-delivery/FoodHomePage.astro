---
/**
 * FoodHomePage — Customer-facing storefront landing page for BiteFlow.
 * Composes FoodDeliveryHero, FoodCategoryRail, FoodLivePromoBanner, FoodMenuGrid, and FoodRestaurantPartnerCta.
 */
import FoodSiteLayout from './FoodSiteLayout.astro';
import FoodDeliveryHero from '../../sections/FoodDeliveryHero.astro';
import FoodCategoryRail from '../../sections/FoodCategoryRail.astro';
import FoodLivePromoBanner from '../../sections/FoodLivePromoBanner.astro';
import FoodMenuGrid from '../../sections/FoodMenuGrid.astro';
import FoodRestaurantPartnerCta from '../../sections/FoodRestaurantPartnerCta.astro';
import { foodDeliveryRoutes, foodDeliveryData, type FoodDeliveryRoutes } from './data';

interface Props {
  routes?: FoodDeliveryRoutes;
}

const { routes = foodDeliveryRoutes } = Astro.props;
---

<FoodSiteLayout
  title="BiteFlow — Sizzling Hot Food Delivery in 25 Minutes"
  routes={routes}
>
  <FoodDeliveryHero
    menuHref={routes.menu}
    trackHref={routes.tracking}
  />

  <FoodCategoryRail
    baseUrl={routes.menu}
    activeCategory="all"
  />

  <FoodLivePromoBanner
    ctaHref={`${routes.menu}?cat=burgers`}
  />

  <FoodMenuGrid
    dishes={foodDeliveryData.dishes}
    title="Signature Kitchen Favorites"
    subtitle="Order from our top-rated smash burgers, artisan pizzas and fresh poke bowls."
  />

  <FoodRestaurantPartnerCta
    partnerHref={routes.partner}
    demoHref={routes.dashboard}
  />
</FoodSiteLayout>

