---
/**
 * FoodSignInPage — Crew sign-in for the "BiteFlow" kitchen OS, built on FoodCrewSignIn. Each
 * station lands on its screen (kitchen → KDS, pass → orders, dispatch → riders, manager → panel).
 * In the demo any crew number and 4-digit PIN work.
 *
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'light'.
 * @param {boolean} noindex - Add robots noindex. Default true.
 */
import '../../../../styles/global.css';
import './food-theme.css';
import FoodCrewSignIn from '../../app/FoodCrewSignIn.astro';
import { foodRoutes, type FoodRoutes } from './data';

interface Props {
  routes?: FoodRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = foodRoutes, theme = 'light', noindex = true } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-food" data-theme={theme === 'auto' ? 'light' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso del equipo — BiteFlow</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=DM+Sans:opsz,wght@9..40,400..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="bf-signin-page">
    <main>
      <FoodCrewSignIn
        destinations={{ cocina: routes.kds, pase: routes.orders, reparto: routes.riders, gerencia: routes.dashboard }}
        backHref={routes.home}
      />
    </main>
  </body>
</html>

<style>
  .bf-signin-page {
    margin: 0;
    min-height: 100vh;
    background: var(--bf-bg);
    overflow-x: clip;
  }
</style>
