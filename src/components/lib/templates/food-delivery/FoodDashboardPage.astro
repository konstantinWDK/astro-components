---
/**
 * FoodDashboardPage — Service overview of the "BiteFlow" kitchen OS: count-up KPIs, orders per
 * hour vs last week, station load, best sellers and a live event feed (FoodServicePulse), plus
 * shortcuts to the kitchen screen and dispatch.
 *
 * @param {FoodRoutes} routes - Template route URLs.
 * @param {typeof foodDeliveryData} data - Stats and hourly orders.
 */
import FoodAppLayout from './FoodAppLayout.astro';
import FoodOpsHeading from '../../app/FoodOpsHeading.astro';
import FoodServicePulse from '../../app/FoodServicePulse.astro';
import { foodRoutes, foodDeliveryData, type FoodRoutes } from './data';

interface Props {
  routes?: FoodRoutes;
  data?: typeof foodDeliveryData;
}

const { routes = foodRoutes, data = foodDeliveryData } = Astro.props;
---

<FoodAppLayout title="Servicio" current="dashboard" routes={routes}>
  <FoodOpsHeading
    kicker="Turno de noche"
    title="Así va el servicio"
    description="Ventas, ritmo de pedidos y carga de cada partida en tiempo real."
    actions={[{ label: 'Abrir pantalla de cocina', href: routes.kds, primary: true }, { label: 'Despachar riders', href: routes.riders }]}
  />
  <FoodServicePulse stats={data.stats} hourly={data.hourly} />
</FoodAppLayout>
