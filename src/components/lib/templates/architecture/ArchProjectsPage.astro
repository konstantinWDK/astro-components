---
/**
 * ArchProjectsPage — Built work: the full index with a type filter, generated floor plan and elevation, facts and FAQ.
 *
 * @param {ArchRoutes} routes - Template route URLs.
 * @param {typeof archData} data - Projects, phases, principles, FAQs, estimate rules, client work, budget, decisions, diary and documents.
 */
import ArchSiteLayout from './ArchSiteLayout.astro';
import ArchProjects from '../../sections/ArchProjects.astro';
import ArchFaq from '../../sections/ArchFaq.astro';
import { archRoutes, archData, type ArchRoutes } from './data';

interface Props {
  routes?: ArchRoutes;
  data?: typeof archData;
}

const { routes = archRoutes, data = archData } = Astro.props;
---

<ArchSiteLayout
  title={`Obras · ${data.brand.name}`}
  description="Seis obras con su planta, su alzado, su superficie, su coste por metro cuadrado y sus materiales."
  current="projects"
  routes={routes}
>
  <ArchProjects projects={data.projects} headingLevel="h1" />
  <ArchFaq faqs={data.faqs} />
</ArchSiteLayout>
