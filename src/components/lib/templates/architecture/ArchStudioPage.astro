---
/**
 * ArchStudioPage — The studio: four principles, the process as a Gantt accordion, the solar study and FAQ.
 *
 * @param {ArchRoutes} routes - Template route URLs.
 * @param {typeof archData} data - Projects, phases, principles, FAQs, estimate rules, client work, budget, decisions, diary and documents.
 */
import ArchSiteLayout from './ArchSiteLayout.astro';
import ArchPrinciples from '../../sections/ArchPrinciples.astro';
import ArchProcess from '../../sections/ArchProcess.astro';
import ArchSun from '../../sections/ArchSun.astro';
import ArchFaq from '../../sections/ArchFaq.astro';
import { archRoutes, archData, type ArchRoutes } from './data';

interface Props {
  routes?: ArchRoutes;
  data?: typeof archData;
}

const { routes = archRoutes, data = archData } = Astro.props;
---

<ArchSiteLayout
  title={`El estudio · ${data.brand.name}`}
  description="Cuatro reglas que no negociamos, el proceso del solar a las llaves y un estudio solar interactivo."
  current="studio"
  routes={routes}
>
  <ArchPrinciples principles={data.principles} headingLevel="h1" />
  <ArchProcess phases={data.phases} />
  <ArchSun latitude={data.brand.latitude} />
  <ArchFaq faqs={data.faqs} />
</ArchSiteLayout>
