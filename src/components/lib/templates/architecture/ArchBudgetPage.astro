---
/**
 * ArchBudgetPage — The works budget with paid vs budget per line, change orders to approve or reject, and the pending decisions.
 *
 * @param {ArchRoutes} routes - Template route URLs.
 * @param {typeof archData} data - Client work, phases, budget, change orders, decisions, diary and documents.
 */
import ArchAccountLayout from './ArchAccountLayout.astro';
import ArchAccountHeading from '../../app/ArchAccountHeading.astro';
import ArchBudget from '../../app/ArchBudget.astro';
import ArchDecisions from '../../app/ArchDecisions.astro';
import { archRoutes, archData, type ArchRoutes } from './data';

interface Props {
  routes?: ArchRoutes;
  data?: typeof archData;
}

const { routes = archRoutes, data = archData } = Astro.props;
---

<ArchAccountLayout title="Presupuesto" current="budget" routes={routes}>
  <ArchAccountHeading kicker="Mi obra" title="Presupuesto y decisiones" description="Qué está pagado, qué falta y qué necesita tu aprobación." />
  <ArchBudget lines={data.budgetLines} changeOrders={data.changeOrders} />
  <section class="arch-app-section" id="decisiones" aria-labelledby="decisiones-title">
    <h2 id="decisiones-title">Decisiones pendientes</h2>
    <ArchDecisions decisions={data.decisions} />
  </section>
</ArchAccountLayout>
