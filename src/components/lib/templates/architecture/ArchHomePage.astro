---
/**
 * ArchHomePage — Home of the "Cota" architecture template: a self-drawing elevation hero, built work as an index with generated plans, the solar study and the studio principles.
 *
 * @param {ArchRoutes} routes - Template route URLs.
 * @param {typeof archData} data - Projects, phases, principles, FAQs, estimate rules, client work, budget, decisions, diary and documents.
 */
import ArchSiteLayout from './ArchSiteLayout.astro';
import ArchHero from '../../sections/ArchHero.astro';
import ArchProjects from '../../sections/ArchProjects.astro';
import ArchSun from '../../sections/ArchSun.astro';
import ArchPrinciples from '../../sections/ArchPrinciples.astro';
import { archRoutes, archData, type ArchRoutes } from './data';

interface Props {
  routes?: ArchRoutes;
  data?: typeof archData;
}

const { routes = archRoutes, data = archData } = Astro.props;
---

<ArchSiteLayout
  title={`${data.brand.name} · Estudio de arquitectura en Madrid`}
  description="Casas, rehabilitaciones y edificios públicos en Madrid con presupuesto cerrado, y un área donde sigues tu obra semana a semana."
  routes={routes}
>
  <ArchHero stats={data.stats} project={data.projects[0]} estimateHref={routes.estimate} projectsHref={routes.projects} />
  <ArchProjects projects={data.projects.slice(0, 4)} title="Obra reciente" />
  <ArchSun latitude={data.brand.latitude} />
  <ArchPrinciples principles={data.principles} />
</ArchSiteLayout>
