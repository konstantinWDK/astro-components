---
/**
 * ArchEstimatePage — Estimate: the cost calculator with a price range, breakdown and calendar, plus the request form and FAQ.
 *
 * @param {ArchRoutes} routes - Template route URLs.
 * @param {typeof archData} data - Projects, phases, principles, FAQs, estimate rules, client work, budget, decisions, diary and documents.
 * @param {string} action - Backend endpoint for the request form. Empty shows a demo confirmation.
 */
import ArchSiteLayout from './ArchSiteLayout.astro';
import ArchEstimate from '../../sections/ArchEstimate.astro';
import ArchProcess from '../../sections/ArchProcess.astro';
import ArchFaq from '../../sections/ArchFaq.astro';
import { archRoutes, archData, type ArchRoutes } from './data';

interface Props {
  routes?: ArchRoutes;
  data?: typeof archData;
  action?: string;
}

const { routes = archRoutes, data = archData, action = '' } = Astro.props;
---

<ArchSiteLayout
  title={`Presupuesto · ${data.brand.name}`}
  description="Calcula cuánto cuesta y cuánto tarda tu obra y pide un estudio previo del solar."
  current="estimate"
  routes={routes}
>
  <ArchEstimate rules={data.rules} phases={data.phases} action={action} headingLevel="h1" />
  <ArchProcess phases={data.phases} />
  <ArchFaq faqs={data.faqs} />
</ArchSiteLayout>
