---
/**
 * ArchDocumentsPage — Project documents with a status filter and signing, and the full searchable site diary.
 *
 * @param {ArchRoutes} routes - Template route URLs.
 * @param {typeof archData} data - Client work, phases, budget, change orders, decisions, diary and documents.
 */
import ArchAccountLayout from './ArchAccountLayout.astro';
import ArchAccountHeading from '../../app/ArchAccountHeading.astro';
import ArchDocuments from '../../app/ArchDocuments.astro';
import ArchDiary from '../../app/ArchDiary.astro';
import { archRoutes, archData, type ArchRoutes } from './data';

interface Props {
  routes?: ArchRoutes;
  data?: typeof archData;
}

const { routes = archRoutes, data = archData } = Astro.props;
---

<ArchAccountLayout title="Documentos" current="documents" routes={routes}>
  <ArchAccountHeading kicker="Mi obra" title="Documentos y diario" description="Firma lo que falta y lee lo que ha pasado cada semana." />
  <ArchDocuments documents={data.documents} />
  <section class="arch-app-section" aria-labelledby="diario-title">
    <h2 id="diario-title">Diario de obra</h2>
    <ArchDiary entries={data.diary} />
  </section>
</ArchAccountLayout>
