---
/**
 * ArchSignInPage — Client sign-in: a full-screen split with a generated elevation and the form.
 * Standalone document (no site header or footer).
 *
 * @param {ArchRoutes} routes - Template route URLs.
 * @param {string} action - Backend endpoint for the form. Empty runs a demo sign-in.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 */
import '../../../../styles/global.css';
import './arch-theme.css';
import ArchSignIn from '../../app/ArchSignIn.astro';
import { archRoutes, type ArchRoutes } from './data';

interface Props {
  routes?: ArchRoutes;
  action?: string;
  theme?: 'light' | 'dark' | 'auto';
}

const { routes = archRoutes, action = '', theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-arch" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mi obra — Cota</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="arch-si-body">
    <main id="main-content">
      <ArchSignIn dashboardHref={routes.dashboard} joinHref={routes.estimate} homeHref={routes.home} action={action} />
    </main>
  </body>
</html>

<style>
  .arch-si-body {
    margin: 0;
    background: var(--ar-bg);
    color: var(--ar-text);
    font-family: var(--ar-font-body);
  }
</style>
