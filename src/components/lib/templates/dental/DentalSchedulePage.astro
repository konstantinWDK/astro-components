---
/**
 * DentalSchedulePage — Multi-chair operatory schedule view.
 *
 * @param {DentalRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto').
 */
import DentalLayout from './DentalLayout.astro';
import DentalChairTimeline from '../../app/DentalChairTimeline.astro';
import { dentalRoutes, dentalData, type DentalRoutes } from './data';

interface Props {
  routes?: DentalRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = dentalRoutes, theme = 'light', noindex = true } = Astro.props;
---

<DentalLayout
  title="Operatories Schedule"
  current="schedule"
  routes={routes}
  theme={theme}
  noindex={noindex}
>
  <div class="schedule-page-view">
    <div class="page-top-bar">
      <div>
        <h2 class="page-title">Dental Operatories & Chair Agenda</h2>
        <p class="page-subtitle">Real-time chair occupancy, turnover hygiene, and day timeline</p>
      </div>

      <div class="top-controls">
        <a href={routes.book} target="_blank" class="btn-top-outline">
          + Add Appointment
        </a>
      </div>
    </div>

    <DentalChairTimeline chairs={dentalData.chairs} appointments={dentalData.appointments} />
  </div>
</DentalLayout>

<style>
  .schedule-page-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .page-title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--c-text-1);
  }

  .page-subtitle {
    margin: 4px 0 0;
    font-size: 0.85rem;
    color: var(--c-text-3);
  }

  .btn-top-outline {
    background: var(--c-primary);
    color: #fff;
    padding: 9px 16px;
    border-radius: var(--r-md);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
  }
</style>

