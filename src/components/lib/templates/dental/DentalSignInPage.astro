---
/**
 * DentalSignInPage — Staff sign-in page for the Dentis practice management app.
 * Provides 1-click demo logins for Lead Dentist, Orthodontist, and Office Manager.
 *
 * @param {DentalRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto').
 */
import './dental-theme.css';
import { dentalRoutes, type DentalRoutes } from './data';

interface Props {
  routes?: DentalRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = dentalRoutes, theme = 'light', noindex = true } = Astro.props;

const demoRoles = [
  { role: 'Dr. Adrián Ramos', title: 'Lead Dentist (Full Access)', icon: 'tooth' },
  { role: 'Dr. Elena Silva', title: 'Orthodontics & Invisalign', icon: 'smile' },
  { role: 'Carla Vega, RDH', title: 'Hygiene & Prevention Care', icon: 'sparkles' },
  { role: 'Marta Gómez', title: 'Office Manager & Receptionist', icon: 'clipboard' },
];
---

<!doctype html>
<html lang="en" class="theme-dental" data-theme={theme === 'auto' ? 'light' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dental Staff Sign In · Dentis Dental Studio</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="dentis sign-in-body">
    <div class="sign-in-container">
      <div class="sign-in-brand">
        <div class="brand-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 2C9 2 7 3.5 6 6c-1 3-1 6-.5 9 .5 3 2 7 3.5 7s2-3 3-5c1 2 1.5 5 3 5s3-4 3.5-7c.5-3 .5-6-.5-9-1-2.5-3-4-6-4z"/>
          </svg>
        </div>
        <h1 class="brand-title">Dentis Practice OS</h1>
        <p class="brand-sub">Dental Practice Management & Operatories Schedule</p>
      </div>

      <div class="sign-in-card">
        <h2 class="card-title">Dental Staff Sign In</h2>
        <p class="card-desc">Choose a simulated clinic profile for immediate access:</p>

        <div class="demo-logins-list">
          {demoRoles.map((d) => (
            <a href={routes.dashboard} class="demo-login-btn">
              <div class="role-avatar">{d.role[0]}</div>
              <div class="role-details">
                <strong>{d.role}</strong>
                <span>{d.title}</span>
              </div>
              <span class="enter-arrow">→</span>
            </a>
          ))}
        </div>

        <div class="divider">
          <span>or sign in with credentials</span>
        </div>

        <form action={routes.dashboard} method="GET" class="manual-login-form">
          <div class="field-group">
            <label for="dentist-email">Clinical Email</label>
            <input type="email" id="dentist-email" value="ramos@dentis.studio" class="login-input" />
          </div>
          <div class="field-group">
            <label for="dentist-pwd">Password</label>
            <input type="password" id="dentist-pwd" value="••••••••••••" class="login-input" />
          </div>

          <button type="submit" class="btn-submit-login">
            Access Practice Dashboard →
          </button>
        </form>

        <div class="card-footer-link">
          <a href={routes.home}>← Return to Public Clinic Website</a>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  .sign-in-body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    background: radial-gradient(circle at 50% 20%, rgba(2, 132, 199, 0.12) 0%, var(--c-bg) 60%);
  }

  .sign-in-container {
    max-width: 460px;
    width: 100%;
  }

  .sign-in-brand {
    text-align: center;
    margin-bottom: 2rem;
  }

  .brand-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark));
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    box-shadow: 0 8px 20px rgba(2, 132, 199, 0.3);
  }

  .brand-title {
    margin: 0 0 4px;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
  }

  .brand-sub {
    margin: 0;
    font-size: 0.88rem;
    color: var(--c-text-3);
  }

  .sign-in-card {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 2rem;
    box-shadow: var(--dental-shadow-md);
  }

  .card-title {
    margin: 0 0 4px;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--c-text-1);
  }

  .card-desc {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--c-text-3);
  }

  .demo-logins-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 1.5rem;
  }

  .demo-login-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    background: var(--c-bg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .demo-login-btn:hover {
    border-color: var(--c-primary);
    background: var(--dental-surface-hover);
    transform: translateX(3px);
  }

  .role-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--c-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .role-details {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .role-details strong {
    font-size: 0.88rem;
    color: var(--c-text-1);
  }

  .role-details span {
    font-size: 0.75rem;
    color: var(--c-text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .enter-arrow {
    color: var(--c-primary);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 1.5rem 0;
    color: var(--c-text-3);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--c-border);
  }

  .divider span {
    padding: 0 10px;
  }

  .manual-login-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field-group label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--c-text-2);
  }

  .login-input {
    padding: 10px 12px;
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    background: var(--c-bg);
    color: var(--c-text-1);
    font-size: 0.9rem;
    outline: none;
  }

  .login-input:focus {
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }

  .btn-submit-login {
    background: var(--c-primary);
    color: #fff;
    padding: 12px;
    border-radius: var(--r-md);
    font-size: 0.92rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    margin-top: 0.5rem;
    transition: all 0.2s;
  }

  .btn-submit-login:hover {
    background: var(--c-primary-dark);
  }

  .card-footer-link {
    text-align: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border);
  }

  .card-footer-link a {
    color: var(--c-text-3);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .card-footer-link a:hover {
    color: var(--c-primary);
  }
</style>

