---
/**
 * DentalBookingPage — Public 4-step appointment booking page for dental patients.
 * Integrates DentalBookingWizard with .ics export and instant SMS confirmation.
 *
 * @param {DentalRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto').
 */
import DentalSiteLayout from './DentalSiteLayout.astro';
import DentalBookingWizard from '../../sections/DentalBookingWizard.astro';
import { dentalRoutes, dentalData, type DentalRoutes } from './data';

interface Props {
  routes?: DentalRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = dentalRoutes, theme = 'light', noindex = false } = Astro.props;
---

<DentalSiteLayout
  title={`Book Dental Appointment · ${dentalData.workspace.name}`}
  description="Select your dental treatment, choose specialist, pick date and time with zero waiting time guarantee."
  theme={theme}
  routes={routes}
  noindex={noindex}
>
  <div class="booking-page-wrap">
    <div class="booking-page-header">
      <span class="bp-badge">Direct Clinic Calendar</span>
      <h1 class="bp-title">Reserve Your Dental Appointment</h1>
      <p class="bp-desc">
        Select your required dental care, choose your preferred doctor, and confirm your visit with automated SMS updates and calendar download.
      </p>
    </div>

    <DentalBookingWizard />
  </div>
</DentalSiteLayout>

<style>
  .booking-page-wrap {
    padding: 3.5rem 1.5rem 6rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .booking-page-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .bp-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .bp-title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
  }

  .bp-desc {
    margin: 0;
    font-size: 1rem;
    color: var(--c-text-3);
    line-height: 1.5;
  }
</style>

