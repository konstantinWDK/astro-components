---
/**
 * DentalHomePage — Public landing page for modern dental clinic ("Dentis").
 * Composed of DentalHero, DentalTreatmentsGrid, DentalBeforeAfter, DentalTeamDirectory, and DentalEmergencyBanner.
 *
 * @param {DentalRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto').
 */
import DentalSiteLayout from './DentalSiteLayout.astro';
import DentalHero from '../../sections/DentalHero.astro';
import DentalTreatmentsGrid from '../../sections/DentalTreatmentsGrid.astro';
import DentalBeforeAfter from '../../sections/DentalBeforeAfter.astro';
import DentalTeamDirectory from '../../sections/DentalTeamDirectory.astro';
import DentalEmergencyBanner from '../../sections/DentalEmergencyBanner.astro';
import { dentalRoutes, dentalData, type DentalRoutes } from './data';

interface Props {
  routes?: DentalRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = dentalRoutes, theme = 'light', noindex = false } = Astro.props;
---

<DentalSiteLayout
  title={`${dentalData.workspace.name} — Modern Dental Care & Aesthetics`}
  description={dentalData.workspace.tagline}
  theme={theme}
  routes={routes}
  noindex={noindex}
>
  <!-- Hero with quick booker & emergency notice -->
  <DentalHero bookHref={routes.book} emergencyPhone={dentalData.workspace.emergencyPhone} />

  <!-- Treatments & Fees Grid -->
  <DentalTreatmentsGrid bookBase={routes.book} />

  <!-- Smile Transformations Before/After -->
  <div id="transformations">
    <DentalBeforeAfter />
  </div>

  <!-- Medical Faculty & Specialists -->
  <div id="team">
    <DentalTeamDirectory bookBase={routes.book} />
  </div>

  <!-- Emergency 24/7 Dental Care Banner -->
  <div id="emergency">
    <DentalEmergencyBanner
      phone={dentalData.workspace.emergencyPhone}
      bookHref={`${routes.book}?treatment=root-canal`}
    />
  </div>
</DentalSiteLayout>

