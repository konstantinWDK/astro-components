---
/**
 * DentalTreatmentsPage — Public treatments & pricing page for dental clinics.
 *
 * @param {DentalRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto').
 */
import DentalSiteLayout from './DentalSiteLayout.astro';
import DentalTreatmentsGrid from '../../sections/DentalTreatmentsGrid.astro';
import DentalEmergencyBanner from '../../sections/DentalEmergencyBanner.astro';
import { dentalRoutes, dentalData, type DentalRoutes } from './data';

interface Props {
  routes?: DentalRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = dentalRoutes, theme = 'light', noindex = false } = Astro.props;
---

<DentalSiteLayout
  title={`Dental Treatments & Pricing · ${dentalData.workspace.name}`}
  description="Transparent dental fee schedule, procedure duration, and 0% financing options."
  theme={theme}
  routes={routes}
  noindex={noindex}
>
  <div class="treatments-page-hero">
    <div class="t-hero-inner">
      <span class="t-badge">Transparent Fee Policy</span>
      <h1 class="t-title">Dental Treatments & Fee Schedule</h1>
      <p class="t-desc">
        We believe in complete clinical transparency. Below is our full dental procedure fee catalog with estimated treatment times and anesthesia options.
      </p>
    </div>
  </div>

  <DentalTreatmentsGrid bookBase={routes.book} />

  <DentalEmergencyBanner
    phone={dentalData.workspace.emergencyPhone}
    bookHref={`${routes.book}?treatment=root-canal`}
  />
</DentalSiteLayout>

<style>
  .treatments-page-hero {
    background: radial-gradient(circle at 50% 0%, rgba(2, 132, 199, 0.1) 0%, transparent 60%);
    padding: 4.5rem 1.5rem 2rem;
    text-align: center;
    border-bottom: 1px solid var(--c-border);
  }

  .t-hero-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .t-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .t-title {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
  }

  .t-desc {
    margin: 0;
    font-size: 1.05rem;
    color: var(--c-text-2);
    line-height: 1.5;
  }
</style>

