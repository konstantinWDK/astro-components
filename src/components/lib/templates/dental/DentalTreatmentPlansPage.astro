---
/**
 * DentalTreatmentPlansPage — Backoffice treatment plans & quotes generator.
 *
 * @param {DentalRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto').
 */
import DentalLayout from './DentalLayout.astro';
import DentalTreatmentPlanBuilder from '../../app/DentalTreatmentPlanBuilder.astro';
import { dentalRoutes, type DentalRoutes } from './data';

interface Props {
  routes?: DentalRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = dentalRoutes, theme = 'light', noindex = true } = Astro.props;
---

<DentalLayout
  title="Treatment Plans & Estimates"
  current="treatmentPlans"
  routes={routes}
  theme={theme}
  noindex={noindex}
>
  <div class="plans-page-view">
    <div class="plans-top-bar">
      <div>
        <h2 class="page-title">Dental Treatment Plans & Budget Quotes</h2>
        <p class="page-subtitle">Multi-phased clinical proposals with insurance benefit calculations</p>
      </div>

      <div class="plans-top-actions">
        <button class="btn-new-plan">+ Create New Treatment Plan</button>
      </div>
    </div>

    <!-- Active Plan Builder Component -->
    <DentalTreatmentPlanBuilder />
  </div>
</DentalLayout>

<style>
  .plans-page-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .plans-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .page-title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--c-text-1);
  }

  .page-subtitle {
    margin: 4px 0 0;
    font-size: 0.85rem;
    color: var(--c-text-3);
  }

  .btn-new-plan {
    background: var(--c-primary);
    color: #fff;
    border: none;
    padding: 9px 16px;
    border-radius: var(--r-md);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
  }
</style>

