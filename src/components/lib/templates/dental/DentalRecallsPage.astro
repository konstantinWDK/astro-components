---
/**
 * DentalRecallsPage — Preventative hygiene recall manager and automated patient notifications.
 *
 * @param {DentalRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto').
 */
import DentalLayout from './DentalLayout.astro';
import DentalRecallManager from '../../app/DentalRecallManager.astro';
import { dentalRoutes, dentalData, type DentalRoutes } from './data';

interface Props {
  routes?: DentalRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = dentalRoutes, theme = 'light', noindex = true } = Astro.props;
---

<DentalLayout
  title="Hygiene Recalls"
  current="recalls"
  routes={routes}
  theme={theme}
  noindex={noindex}
>
  <div class="recalls-page-view">
    <div class="recalls-top-bar">
      <div>
        <h2 class="page-title">Preventative Recalls & Patient Reactivation</h2>
        <p class="page-subtitle">Automated 6-month checkup reminders, periodontal tracking, and SMS outreach</p>
      </div>
    </div>

    <!-- Recall Manager Component -->
    <DentalRecallManager recalls={dentalData.recalls} />
  </div>
</DentalLayout>

<style>
  .recalls-page-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .recalls-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .page-title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--c-text-1);
  }

  .page-subtitle {
    margin: 4px 0 0;
    font-size: 0.85rem;
    color: var(--c-text-3);
  }
</style>

