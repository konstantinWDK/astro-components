---
/**
 * FishSignInPage — Customer sign-in: a full-screen split with a generated product illustration and
 * the form. Standalone document (no site header or footer).
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {string} action - Backend endpoint for the form. Empty runs a demo sign-in.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 */
import '../../../../styles/global.css';
import './fish-theme.css';
import FishSignIn from '../../app/FishSignIn.astro';
import { fishRoutes, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  action?: string;
  theme?: 'light' | 'dark' | 'auto';
}

const { routes = fishRoutes, action = '', theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-fish" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mis pedidos — Corcho</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="fish-si-body">
    <main id="main-content">
      <FishSignIn dashboardHref={routes.dashboard} joinHref={routes.shop} homeHref={routes.home} action={action} />
    </main>
  </body>
</html>

<style>
  .fish-si-body {
    margin: 0;
    background: var(--fs-bg);
    color: var(--fs-text);
    font-family: var(--fs-font-body);
  }
</style>
