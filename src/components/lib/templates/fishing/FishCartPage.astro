---
/**
 * FishCartPage — Cart and checkout with quantity steppers, free-shipping progress, a promo code, live totals and a demo payment.
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {typeof fishData} data - Products, species, FAQs, customer, orders and wishlist.
 */
import FishSiteLayout from './FishSiteLayout.astro';
import FishCart from '../../sections/FishCart.astro';
import { fishRoutes, fishData, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  data?: typeof fishData;
}

const { routes = fishRoutes, data = fishData } = Astro.props;
---

<FishSiteLayout
  title={`Carrito · ${data.brand.name}`}
  description="Revisa tu carrito, aplica un código y completa tu pedido."
  routes={routes}
>
  <FishCart products={data.products} shopHref={routes.shop} ordersHref={routes.orders} />
</FishSiteLayout>
