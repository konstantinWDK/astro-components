---
/**
 * FishDashboardPage — Customer home: the order on its way with a written timeline, customer figures and what bites this month.
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {typeof fishData} data - Customer, orders, wishlist, products and species.
 */
import FishAccountLayout from './FishAccountLayout.astro';
import FishAccountHeading from '../../app/FishAccountHeading.astro';
import FishAccountSummary from '../../app/FishAccountSummary.astro';
import { fishRoutes, fishData, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  data?: typeof fishData;
}

const { routes = fishRoutes, data = fishData } = Astro.props;
---

<FishAccountLayout title="Resumen" current="dashboard" routes={routes}>
  <FishAccountHeading kicker="Mi cuenta" title="Tu pedido en camino" description="Dónde está tu material y qué pica este mes." />
  <FishAccountSummary member={data.member} orders={data.orders} wishlist={data.wishlist} products={data.products} species={data.species} ordersHref={routes.orders} kitHref={routes.kit} />
</FishAccountLayout>
