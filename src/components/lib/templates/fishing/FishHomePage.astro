---
/**
 * FishHomePage — Home of the "Corcho" fishing shop: a ripples hero with a category list, the scroll-driven casting scene, the most requested products and FAQ.
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {typeof fishData} data - Products, species, FAQs, customer, orders and wishlist.
 */
import FishSiteLayout from './FishSiteLayout.astro';
import FishHero from '../../sections/FishHero.astro';
import FishCast from '../../sections/FishCast.astro';
import FishShop from '../../sections/FishShop.astro';
import FishFaq from '../../sections/FishFaq.astro';
import { fishRoutes, fishData, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  data?: typeof fishData;
}

const { routes = fishRoutes, data = fishData } = Astro.props;
---

<FishSiteLayout
  title={`${data.brand.name} · Material de pesca con criterio`}
  description="Cañas, carretes y señuelos probados en el río, con guía por especies y envío en 24 horas."
  routes={routes}
>
  <FishHero products={data.products} stats={data.stats} shopHref={routes.shop} kitHref={routes.kit} />
  <FishCast />
  <FishShop products={data.products.slice(0, 6)} productHref={routes.product} title="Lo más pedido" />
  <FishFaq faqs={data.faqs} />
</FishSiteLayout>
