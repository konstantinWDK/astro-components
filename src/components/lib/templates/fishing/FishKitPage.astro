---
/**
 * FishKitPage — Build your kit by species: seasons, tips and recommended tackle with a live kit total, plus the casting scene.
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {typeof fishData} data - Products, species, FAQs, customer, orders and wishlist.
 */
import FishSiteLayout from './FishSiteLayout.astro';
import FishKit from '../../sections/FishKit.astro';
import FishCast from '../../sections/FishCast.astro';
import FishFaq from '../../sections/FishFaq.astro';
import { fishRoutes, fishData, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  data?: typeof fishData;
}

const { routes = fishRoutes, data = fishData } = Astro.props;
---

<FishSiteLayout
  title={`Monta tu equipo · ${data.brand.name}`}
  description="Elige qué pescas y te recomendamos el equipo, con la mejor época de pesca de cada especie."
  current="kit"
  routes={routes}
>
  <FishKit species={data.species} products={data.products} cartHref={routes.cart} headingLevel="h1" />
  <FishCast />
  <FishFaq faqs={data.faqs} />
</FishSiteLayout>
