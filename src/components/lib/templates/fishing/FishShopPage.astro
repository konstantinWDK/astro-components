---
/**
 * FishShopPage — The shop: search, category filter, price slider, stock switch and sorting over generated product illustrations.
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {typeof fishData} data - Products, species, FAQs, customer, orders and wishlist.
 */
import FishSiteLayout from './FishSiteLayout.astro';
import FishShop from '../../sections/FishShop.astro';
import FishFaq from '../../sections/FishFaq.astro';
import { fishRoutes, fishData, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  data?: typeof fishData;
}

const { routes = fishRoutes, data = fishData } = Astro.props;
---

<FishSiteLayout
  title={`Tienda · ${data.brand.name}`}
  description="Todo el catálogo con búsqueda, filtro por categoría, precio máximo, solo con stock y orden."
  current="shop"
  routes={routes}
>
  <FishShop products={data.products} productHref={routes.product} headingLevel="h1" />
  <FishFaq faqs={data.faqs} />
</FishSiteLayout>
