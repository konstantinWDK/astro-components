---
/**
 * FishWishlistPage — The wish list with move-to-cart and remove actions.
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {typeof fishData} data - Customer, orders, wishlist, products and species.
 */
import FishAccountLayout from './FishAccountLayout.astro';
import FishAccountHeading from '../../app/FishAccountHeading.astro';
import FishWishlist from '../../app/FishWishlist.astro';
import { fishRoutes, fishData, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  data?: typeof fishData;
}

const { routes = fishRoutes, data = fishData } = Astro.props;
---

<FishAccountLayout title="Deseos" current="wishlist" routes={routes}>
  <FishAccountHeading kicker="Mi cuenta" title="Mi lista de deseos" description="Lo que has guardado para la próxima salida." />
  <FishWishlist wishlist={data.wishlist} products={data.products} productHref={routes.product} shopHref={routes.shop} />
</FishAccountLayout>
