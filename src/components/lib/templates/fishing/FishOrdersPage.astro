---
/**
 * FishOrdersPage — Orders as an accordion with items, timeline, tracking and a return within 30 days.
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {typeof fishData} data - Customer, orders, wishlist, products and species.
 */
import FishAccountLayout from './FishAccountLayout.astro';
import FishAccountHeading from '../../app/FishAccountHeading.astro';
import FishOrders from '../../app/FishOrders.astro';
import { fishRoutes, fishData, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  data?: typeof fishData;
}

const { routes = fishRoutes, data = fishData } = Astro.props;
---

<FishAccountLayout title="Pedidos" current="orders" routes={routes}>
  <FishAccountHeading kicker="Mi cuenta" title="Mis pedidos" description="Sigue cada envío y devuelve en 30 días." />
  <FishOrders orders={data.orders} products={data.products} shopHref={routes.shop} />
</FishAccountLayout>
