---
/**
 * FishProductPage — The product page: options with live price, quantity, add to cart and save, specs and the species it is good for. Reads ?p=id.
 *
 * @param {FishRoutes} routes - Template route URLs.
 * @param {typeof fishData} data - Products, species, FAQs, customer, orders and wishlist.
 */
import FishSiteLayout from './FishSiteLayout.astro';
import FishProduct from '../../sections/FishProduct.astro';
import FishFaq from '../../sections/FishFaq.astro';
import { fishRoutes, fishData, type FishRoutes } from './data';

interface Props {
  routes?: FishRoutes;
  data?: typeof fishData;
}

const { routes = fishRoutes, data = fishData } = Astro.props;
---

<FishSiteLayout
  title={`Producto · ${data.brand.name}`}
  description="Ficha de producto con opciones, precio en vivo, especificaciones y especies para las que sirve."
  current="shop"
  routes={routes}
>
  <FishProduct products={data.products} species={data.species} cartHref={routes.cart} kitHref={routes.kit} />
  <FishFaq faqs={data.faqs} />
</FishSiteLayout>
