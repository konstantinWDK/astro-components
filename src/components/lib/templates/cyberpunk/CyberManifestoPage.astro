---
/**
 * CyberManifestoPage — Why the grid exists: CyberPageHero, CyberManifesto (theses that light up on
 * scroll), CyberCrewGrid (access-badge team) and the stats band.
 *
 * Usage (src/pages/manifesto.astro):
 *   import { CyberManifestoPage } from 'astro-component-kit/templates/cyberpunk';
 *   <CyberManifestoPage />
 *
 * @param {CyberData} data - Site content.
 * @param {CyberRoutes} routes - Page URLs.
 * @param {string} theme - Initial theme (dark|light|auto). Default 'dark'.
 * @param {boolean} noindex - Add robots noindex. Default false.
 */
import CyberLayout from './CyberLayout.astro';
import CyberPageHero from '../../sections/CyberPageHero.astro';
import CyberManifesto from '../../sections/CyberManifesto.astro';
import CyberCrewGrid from '../../sections/CyberCrewGrid.astro';
import StatsCounterBand from '../../sections/StatsCounterBand.astro';
import { nullSector, cyberRoutes, type CyberData, type CyberRoutes } from './data';

interface Props {
  data?: CyberData;
  routes?: CyberRoutes;
  theme?: 'dark' | 'light' | 'auto';
  noindex?: boolean;
}

const { data = nullSector, routes = cyberRoutes, theme = 'dark', noindex = false } = Astro.props;
---

<CyberLayout title="Manifesto" description="Compute is a commons. The NULL/SECTOR manifesto and the crew behind the grid." data={data} routes={routes} current="manifesto" theme={theme} noindex={noindex}>
  <CyberPageHero index="03" path={[{ label: 'SYS', href: routes.home }, { label: 'MANIFESTO' }]} title="NO" outline="CENTRE" intro="We did not build a cloud. We built the opposite: a grid that belongs to whoever plugs into it." tags={['SIGNED BY 2,417 OPERATORS', 'LICENSE: CC BY-SA']} />

  <div class="ns-wrap">
    <CyberManifesto theses={data.theses} />
  </div>

  <div class="ns-wrap">
    <CyberCrewGrid crew={data.crew} />
  </div>

  <div class="ns-wrap ns-wrap--last">
    <StatsCounterBand title="Operators, paid every block" stats={data.stats} variant="divided" />
  </div>
</CyberLayout>
