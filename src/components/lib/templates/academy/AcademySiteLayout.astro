---
/**
 * AcademySiteLayout — Public layout for the "Lumen" online academy template.
 * Skip link, announcement strip, sticky header with primary nav (disclosure menu on mobile),
 * sign-in link + free-start CTA, and the AcademyFooter.
 *
 * @param {string} title - Document title.
 * @param {string} description - Meta description.
 * @param {string} current - Active nav key (courses | pricing | teach).
 * @param {AcademyRoutes} routes - Template route URLs.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 * @param {boolean} noindex - Adds a robots noindex meta.
 * @param {string} lang - Document language. Default 'es'.
 *
 * Accessibility: skip link to #main-content, aria-current on the active link, the mobile menu
 * button exposes aria-expanded / aria-controls and closes on Escape.
 */
import '../../../../styles/global.css';
import './academy-theme.css';
import AcademyFooter from '../../sections/AcademyFooter.astro';
import { academyRoutes, academyData, type AcademyRoutes } from './data';

type NavKey = 'courses' | 'pricing' | 'teach';

interface Props {
  title: string;
  description?: string;
  current?: NavKey;
  routes?: AcademyRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = 'Lumen · Cursos online con proyecto real, instructores en activo y certificados verificables. Empieza gratis.',
  current,
  routes = academyRoutes,
  theme = 'dark',
  noindex = false,
  lang = 'es',
} = Astro.props;

const { brand } = academyData;
const navLinks: Array<{ key: NavKey; label: string; href: string }> = [
  { key: 'courses', label: 'Cursos', href: routes.courses },
  { key: 'pricing', label: 'Planes', href: routes.pricing },
  { key: 'teach', label: 'Enseña', href: routes.teach },
];
const footerColumns = [
  { title: 'Aprende', links: [{ label: 'Catálogo de cursos', href: routes.courses }, { label: 'Planes y precios', href: routes.pricing }, { label: 'Mi aula', href: routes.dashboard }] },
  { title: 'Lumen', links: [{ label: 'Enseña con nosotros', href: routes.teach }, { label: 'Acceso instructores', href: routes.signIn }, { label: 'Contacto', href: routes.teach }] },
];
---

<!doctype html>
<html lang={lang} class="theme-academy" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="academy-body">
    <a href="#main-content" class="academy-skip">Saltar al contenido</a>

    <p class="academy-strip">
      Nuevo: <strong>Diseño de interfaces desde cero</strong> con proyecto final revisado.
      <a href={routes.courses}>Ver cursos</a>
    </p>

    <header class="academy-header">
      <div class="academy-header__inner">
        <a href={routes.home} class="academy-logo" aria-label={`${brand.name} inicio`}>
          <span class="academy-logo__mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z" /></svg>
          </span>
          <span class="academy-logo__name">{brand.name}</span>
        </a>

        <button type="button" class="academy-menu-btn" aria-expanded="false" aria-controls="academy-nav" data-academy-menu>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <span class="academy-sr">Menú</span>
        </button>

        <nav id="academy-nav" class="academy-nav" aria-label="Navegación principal">
          <ul class="academy-nav__list">
            {navLinks.map((l) => (
              <li><a href={l.href} class="academy-nav__link" aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
          <div class="academy-nav__actions">
            <a href={routes.signIn} class="academy-nav__signin">Entrar</a>
            <a href={routes.pricing} class="academy-nav__cta">Empieza gratis</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main-content" class="academy-main" tabindex="-1">
      <slot />
    </main>

    <AcademyFooter
      brand={brand.name}
      cta={{ title: 'Tu primera clase es gratis', text: 'Crea tu cuenta y prueba cualquier curso sin tarjeta.', href: routes.signIn, label: 'Empezar a aprender' }}
      columns={footerColumns}
      contact={brand}
    />

    <script>
      function initAcademyMenu() {
        const btn = document.querySelector<HTMLButtonElement>('[data-academy-menu]');
        const nav = document.getElementById('academy-nav');
        if (!btn || !nav || btn.dataset.bound) return;
        btn.dataset.bound = 'true';
        const setOpen = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
        };
        btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            btn.focus();
          }
        });
      }
      initAcademyMenu();
      document.addEventListener('astro:page-load', initAcademyMenu);
    </script>
  </body>
</html>

<style>
  .academy-body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--ac-bg);
    color: var(--ac-text);
    font-family: var(--ac-font-body);
  }

  .academy-main {
    flex: 1;
  }

  .academy-main:focus {
    outline: none;
  }

  .academy-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .academy-skip {
    position: absolute;
    left: var(--sp-4, 1rem);
    top: -100px;
    z-index: 100;
    padding: var(--sp-2, 0.5rem) var(--sp-4, 1rem);
    border-radius: var(--r-sm, 8px);
    background: var(--ac-brand);
    color: var(--ac-on-brand);
    font-weight: 700;
    text-decoration: none;
  }

  .academy-skip:focus {
    top: var(--sp-4, 1rem);
  }

  .academy-strip {
    margin: 0;
    padding: var(--sp-2, 0.5rem) var(--sp-4, 1rem);
    background: linear-gradient(90deg, rgba(var(--ac-brand-rgb), 0.2), rgba(var(--ac-violet-rgb), 0.2));
    color: var(--ac-text);
    font-size: 0.88rem;
    text-align: center;
  }

  .academy-strip a {
    margin-left: var(--sp-2, 0.5rem);
    color: var(--ac-brand);
    font-weight: 700;
  }

  .academy-header {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid var(--ac-border);
    background: color-mix(in srgb, var(--ac-bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .academy-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4, 1rem);
    max-width: 1280px;
    min-height: 68px;
    margin: 0 auto;
    padding: 0 var(--sp-4, 1rem);
  }

  .academy-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2, 0.5rem);
    min-height: 44px;
    color: var(--ac-text);
    text-decoration: none;
  }

  .academy-logo__mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--ac-brand);
    color: var(--ac-on-brand);
  }

  .academy-logo__name {
    font-family: var(--ac-font-display);
    font-size: 1.6rem;
    font-weight: 600;
  }

  .academy-menu-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--ac-border-strong);
    border-radius: var(--r-md, 12px);
    background: transparent;
    color: var(--ac-text);
    cursor: pointer;
  }

  .academy-nav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: none;
    flex-direction: column;
    gap: var(--sp-3, 0.75rem);
    padding: var(--sp-4, 1rem);
    border-bottom: 1px solid var(--ac-border);
    background: var(--ac-bg-raised);
  }

  .academy-nav.is-open {
    display: flex;
  }

  .academy-nav__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .academy-nav__link {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: var(--ac-text-2);
    font-weight: 600;
    text-decoration: none;
  }

  .academy-nav__link:hover,
  .academy-nav__link[aria-current='page'] {
    color: var(--ac-brand);
  }

  .academy-nav__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3, 0.75rem);
  }

  .academy-nav__signin,
  .academy-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--sp-5, 1.25rem);
    border-radius: var(--r-full, 999px);
    font-weight: 700;
    text-decoration: none;
  }

  .academy-nav__signin {
    border: 1px solid var(--ac-border-strong);
    color: var(--ac-text);
  }

  .academy-nav__signin:hover {
    border-color: var(--ac-brand);
  }

  .academy-nav__cta {
    background: var(--ac-brand);
    color: var(--ac-on-brand);
  }

  .academy-nav__cta:hover {
    background: var(--ac-brand-hover);
  }

  .academy-logo:focus-visible,
  .academy-menu-btn:focus-visible,
  .academy-nav a:focus-visible,
  .academy-strip a:focus-visible {
    outline: 2px solid var(--ac-brand);
    outline-offset: 2px;
  }

  @media (min-width: 900px) {
    .academy-header__inner {
      padding: 0 var(--sp-8, 2rem);
    }

    .academy-menu-btn {
      display: none;
    }

    .academy-nav {
      position: static;
      display: flex;
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 0 0 0 var(--sp-8, 2rem);
      border: 0;
      background: transparent;
    }

    .academy-nav__list {
      display: flex;
      gap: var(--sp-5, 1.25rem);
    }
  }
</style>
