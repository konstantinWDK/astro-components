---
/**
 * AcademyCoursesPage — Full catalog with search, category chips, level filter and sorting.
 * Reads `?q=` and `?cat=` from the URL.
 *
 * @param {AcademyRoutes} routes - Template route URLs.
 * @param {typeof academyData} data - Categories, courses and instructors.
 */
import AcademySiteLayout from './AcademySiteLayout.astro';
import AcademyCourseGrid from '../../sections/AcademyCourseGrid.astro';
import { academyRoutes, academyData, academyCourseBase, type AcademyRoutes } from './data';

interface Props {
  routes?: AcademyRoutes;
  data?: typeof academyData;
}

const { routes = academyRoutes, data = academyData } = Astro.props;
---

<AcademySiteLayout
  title={`Catálogo de cursos · ${data.brand.name}`}
  description="Explora más de 120 cursos online de diseño, programación, datos, negocio, idiomas y música. Filtra por área y nivel."
  current="courses"
  routes={routes}
>
  <AcademyCourseGrid
    courses={data.courses}
    categories={data.categories}
    instructors={data.instructors}
    courseBase={academyCourseBase(routes)}
    title="Catálogo de cursos"
    headingLevel="h1"
  />
</AcademySiteLayout>
