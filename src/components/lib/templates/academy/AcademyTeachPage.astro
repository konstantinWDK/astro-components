---
/**
 * AcademyTeachPage — "Teach on Lumen": the teaching team and the instructor application form.
 *
 * @param {AcademyRoutes} routes - Template route URLs.
 * @param {typeof academyData} data - Instructors and categories.
 * @param {string} action - Backend endpoint for the form. Empty shows a confirmation on the page.
 */
import AcademySiteLayout from './AcademySiteLayout.astro';
import AcademyTeachForm from '../../sections/AcademyTeachForm.astro';
import AcademyInstructors from '../../sections/AcademyInstructors.astro';
import { academyRoutes, academyData, type AcademyRoutes } from './data';

interface Props {
  routes?: AcademyRoutes;
  data?: typeof academyData;
  action?: string;
}

const { routes = academyRoutes, data = academyData, action = '' } = Astro.props;
---

<AcademySiteLayout
  title={`Enseña en ${data.brand.name}`}
  description="Publica tu curso online: producción, plataforma y audiencia. Te quedas con el 70 % de cada venta."
  current="teach"
  routes={routes}
>
  <AcademyTeachForm categories={data.categories} action={action} headingLevel="h1" />
  <AcademyInstructors instructors={data.instructors} title="Quienes ya enseñan aquí" />
</AcademySiteLayout>
