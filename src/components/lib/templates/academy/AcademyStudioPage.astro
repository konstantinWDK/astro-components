---
/**
 * AcademyStudioPage — Instructor studio: revenue and enrolment KPIs with a 12-month chart
 * and a course manager table.
 *
 * @param {AcademyRoutes} routes - Template route URLs.
 * @param {typeof academyData} data - Studio data.
 */
import AcademyAppLayout from './AcademyAppLayout.astro';
import AcademyAreaHeading from '../../app/AcademyAreaHeading.astro';
import AcademyStudioStats from '../../app/AcademyStudioStats.astro';
import AcademyCoursesTable from '../../app/AcademyCoursesTable.astro';
import { academyRoutes, academyData, type AcademyRoutes } from './data';

interface Props {
  routes?: AcademyRoutes;
  data?: typeof academyData;
}

const { routes = academyRoutes, data = academyData } = Astro.props;
---

<AcademyAppLayout title="Estudio del instructor" current="studio" routes={routes}>
  <AcademyAreaHeading
    kicker="Estudio"
    title="Tus cursos y tus números"
    description={`Panel de ${data.studio.instructor} · datos hasta noviembre de 2026`}
    actions={[{ label: 'Nuevo curso', href: routes.studio, primary: true }]}
  />
  <div class="academy-studio">
    <AcademyStudioStats revenue={data.studio.revenue} enrolments={data.studio.enrolments} months={data.studio.months} />
    <AcademyCoursesTable courses={data.studio.courses} editBase={routes.studio} />
  </div>
</AcademyAppLayout>

<style>
  .academy-studio {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-4, 1rem);
    margin-top: var(--sp-6, 1.5rem);
  }
</style>
