---
/**
 * LawAreasPage — Practice areas (interactive tabs), fee models and the FAQ. Reads `?area=` to
 * open the matching area.
 *
 * @param {LawRoutes} routes - Template route URLs.
 * @param {typeof lawData} data - Areas, fees and FAQ.
 */
import LawSiteLayout from './LawSiteLayout.astro';
import LawPracticeAreas from '../../sections/LawPracticeAreas.astro';
import LawFees from '../../sections/LawFees.astro';
import LawFaq from '../../sections/LawFaq.astro';
import { lawRoutes, lawData, type LawRoutes } from './data';

interface Props {
  routes?: LawRoutes;
  data?: typeof lawData;
}

const { routes = lawRoutes, data = lawData } = Astro.props;
---

<LawSiteLayout
  title={`Áreas de práctica · ${data.brand.name}`}
  description="Derecho de familia, mercantil, laboral, inmobiliario, penal y extranjería. Descubre en qué te podemos ayudar."
  current="areas"
  routes={routes}
>
  <LawPracticeAreas areas={data.areas} consultHref={routes.consult} title="Áreas de práctica" headingLevel="h1" />
  <LawFees options={data.fees} consultHref={routes.consult} />
  <LawFaq faqs={data.faqs} />
</LawSiteLayout>
