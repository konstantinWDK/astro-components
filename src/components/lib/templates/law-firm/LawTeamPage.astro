---
/**
 * LawTeamPage — The lawyers with a filter by practice area, how the firm works and the results.
 *
 * @param {LawRoutes} routes - Template route URLs.
 * @param {typeof lawData} data - Lawyers, areas and process.
 */
import LawSiteLayout from './LawSiteLayout.astro';
import LawTeam from '../../sections/LawTeam.astro';
import LawProcess from '../../sections/LawProcess.astro';
import LawResults from '../../sections/LawResults.astro';
import { lawRoutes, lawData, type LawRoutes } from './data';

interface Props {
  routes?: LawRoutes;
  data?: typeof lawData;
}

const { routes = lawRoutes, data = lawData } = Astro.props;
---

<LawSiteLayout
  title={`Nuestro equipo · ${data.brand.name}`}
  description="Conoce a los abogados de Fuero: especialidades, años de experiencia e idiomas."
  current="team"
  routes={routes}
>
  <LawTeam lawyers={data.lawyers} areas={data.areas} filter headingLevel="h1" />
  <LawProcess steps={data.process} />
  <LawResults />
</LawSiteLayout>
