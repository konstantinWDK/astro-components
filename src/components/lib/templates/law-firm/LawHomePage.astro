---
/**
 * LawHomePage — Home of the "Fuero" law firm template: hero, practice areas, process, results,
 * fee models, team, insights and FAQ.
 *
 * @param {LawRoutes} routes - Template route URLs.
 * @param {typeof lawData} data - Brand, areas, lawyers, fees, insights and FAQ.
 */
import LawSiteLayout from './LawSiteLayout.astro';
import LawHero from '../../sections/LawHero.astro';
import LawPracticeAreas from '../../sections/LawPracticeAreas.astro';
import LawProcess from '../../sections/LawProcess.astro';
import LawResults from '../../sections/LawResults.astro';
import LawFees from '../../sections/LawFees.astro';
import LawTeam from '../../sections/LawTeam.astro';
import LawInsights from '../../sections/LawInsights.astro';
import LawFaq from '../../sections/LawFaq.astro';
import { lawRoutes, lawData, type LawRoutes } from './data';

interface Props {
  routes?: LawRoutes;
  data?: typeof lawData;
}

const { routes = lawRoutes, data = lawData } = Astro.props;
---

<LawSiteLayout
  title={`${data.brand.name} · Despacho de abogados en Madrid`}
  description="Abogados de familia, mercantil, laboral, inmobiliario, penal y extranjería. Honorarios claros, portal del cliente y primera consulta gratuita."
  routes={routes}
>
  <LawHero consultHref={routes.consult} areasHref={routes.areas} stats={data.stats} />
  <LawPracticeAreas areas={data.areas} consultHref={routes.consult} />
  <LawProcess steps={data.process} />
  <LawResults />
  <LawFees options={data.fees} consultHref={routes.consult} />
  <LawTeam lawyers={data.lawyers.slice(0, 3)} areas={data.areas} />
  <LawInsights insights={data.insights} />
  <LawFaq faqs={data.faqs} />
</LawSiteLayout>
