---
/**
 * LawDocumentsPage — Document vault: search, filters, upload and electronic signature.
 *
 * @param {LawRoutes} routes - Template route URLs.
 * @param {typeof lawData} data - Documents and cases.
 */
import LawPortalLayout from './LawPortalLayout.astro';
import LawPortalHeading from '../../app/LawPortalHeading.astro';
import LawDocumentVault from '../../app/LawDocumentVault.astro';
import { lawRoutes, lawData, type LawRoutes } from './data';

interface Props {
  routes?: LawRoutes;
  data?: typeof lawData;
}

const { routes = lawRoutes, data = lawData } = Astro.props;
---

<LawPortalLayout title="Documentos" current="documents" routes={routes}>
  <LawPortalHeading
    kicker="Mi portal"
    title="Documentos"
    description="Todo lo de tus expedientes, cifrado y siempre a mano."
    back={{ label: 'Resumen', href: routes.dashboard }}
  />
  <div class="law-page">
    <LawDocumentVault documents={data.documents} cases={data.cases} />
  </div>
</LawPortalLayout>

<style>
  .law-page {
    margin-top: var(--sp-4, 1rem);
  }
</style>
