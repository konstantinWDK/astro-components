---
/**
 * LawCasesPage — The client's cases with status filter, progress, next step and timeline.
 *
 * @param {LawRoutes} routes - Template route URLs.
 * @param {typeof lawData} data - Cases, lawyers and areas.
 */
import LawPortalLayout from './LawPortalLayout.astro';
import LawPortalHeading from '../../app/LawPortalHeading.astro';
import LawCaseExplorer from '../../app/LawCaseExplorer.astro';
import { lawRoutes, lawData, type LawRoutes } from './data';

interface Props {
  routes?: LawRoutes;
  data?: typeof lawData;
}

const { routes = lawRoutes, data = lawData } = Astro.props;
---

<LawPortalLayout title="Expedientes" current="cases" routes={routes}>
  <LawPortalHeading
    kicker="Mi portal"
    title="Expedientes"
    description="El estado de cada asunto, con su cronología y el siguiente paso."
    back={{ label: 'Resumen', href: routes.dashboard }}
  />
  <div class="law-page">
    <LawCaseExplorer cases={data.cases} lawyers={data.lawyers} areas={data.areas} messagesHref={routes.messages} />
  </div>
</LawPortalLayout>

<style>
  .law-page {
    margin-top: var(--sp-4, 1rem);
  }
</style>
