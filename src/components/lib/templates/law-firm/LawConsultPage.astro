---
/**
 * LawConsultPage — Book the free first consultation. Reads `?area=` to pre-select the area.
 *
 * @param {LawRoutes} routes - Template route URLs.
 * @param {typeof lawData} data - Areas and brand.
 * @param {string} action - Backend endpoint for the form. Empty shows a demo confirmation.
 */
import LawSiteLayout from './LawSiteLayout.astro';
import LawConsultation from '../../sections/LawConsultation.astro';
import LawFaq from '../../sections/LawFaq.astro';
import { lawRoutes, lawData, type LawRoutes } from './data';

interface Props {
  routes?: LawRoutes;
  data?: typeof lawData;
  action?: string;
}

const { routes = lawRoutes, data = lawData, action = '' } = Astro.props;
---

<LawSiteLayout
  title={`Consulta gratuita · ${data.brand.name}`}
  description="Reserva tu primera consulta gratuita de 30 minutos, en el despacho o por videollamada."
  current="consult"
  routes={routes}
>
  <LawConsultation areas={data.areas} action={action} headingLevel="h1" />
  <LawFaq faqs={data.faqs} />
</LawSiteLayout>
