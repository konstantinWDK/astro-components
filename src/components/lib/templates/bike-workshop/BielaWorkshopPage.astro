---
/**
 * BielaWorkshopPage — The workshop: the six stages of a build, a comparison of frame materials and
 * the build queue by month.
 *
 * @param {BielaRoutes} routes - Template route URLs.
 * @param {typeof bielaData} data - Steps, materials and months (override with your own).
 */
import BielaSiteLayout from './BielaSiteLayout.astro';
import BielaProcess from '../../app/BielaProcess.astro';
import BielaMaterials from '../../app/BielaMaterials.astro';
import BielaSlots from '../../app/BielaSlots.astro';
import { bielaRoutes, bielaData, type BielaRoutes } from './data';

interface Props {
  routes?: BielaRoutes;
  data?: typeof bielaData;
}

const { routes = bielaRoutes, data = bielaData } = Astro.props;
---

<BielaSiteLayout title="El taller — Biela" current="workshop" routes={routes} description="Cómo hacemos una bici: los seis pasos, los materiales del cuadro y las plazas libres de cada mes.">
  <header class="biela-pagehead">
    <p class="bl-eyebrow">El taller</p>
    <h1 class="biela-title">Cómo se hace una bici</h1>
    <p class="biela-lead">Somos tres personas y un taller con olor a plata fundida y pintura. Esto es lo que pasa entre que nos conoces y que te llevas la bici.</p>
  </header>

  <BielaProcess steps={data.steps} />

  <section class="biela-section" aria-labelledby="ws-materials">
    <div class="biela-section__head">
      <div>
        <h2 id="ws-materials">Acero, titanio o carbono</h2>
        <p class="biela-lead">No hay uno mejor: hay uno que encaja con cómo montas y cuánto quieres que dure.</p>
      </div>
    </div>
    <BielaMaterials materials={data.materials} />
  </section>

  <section class="biela-section" aria-labelledby="ws-slots">
    <div class="biela-section__head">
      <div>
        <h2 id="ws-slots">Plazas libres</h2>
        <p class="biela-lead">Seis cuadros al mes. Si tu mes está completo, te apuntamos a la lista de espera.</p>
      </div>
    </div>
    <BielaSlots months={data.months} configuratorHref={routes.configurator} />
  </section>
</BielaSiteLayout>
