---
/**
 * BielaVisitPage — Book a visit to the workshop: pick a day and time, the reason and your contact
 * data; the workshop address and opening hours sit next to the form.
 *
 * @param {BielaRoutes} routes - Template route URLs.
 * @param {typeof bielaData} data - Brand data (address and hours; override with your own).
 */
import BielaSiteLayout from './BielaSiteLayout.astro';
import BielaVisit from '../../app/BielaVisit.astro';
import { bielaRoutes, bielaData, type BielaRoutes } from './data';

interface Props {
  routes?: BielaRoutes;
  data?: typeof bielaData;
}

const { routes = bielaRoutes, data = bielaData } = Astro.props;
---

<BielaSiteLayout title="Visítanos — Biela" current="visit" routes={routes} description="Reserva una visita al taller: charla para una bici nueva, ajuste en el banco, revisión o recogida.">
  <header class="biela-pagehead">
    <p class="bl-eyebrow">Visítanos</p>
    <h1 class="biela-title">Pásate por el taller</h1>
    <p class="biela-lead">Una charla sin compromiso, un ajuste en el banco o recoger tu bici. Elige un hueco y te esperamos con café.</p>
  </header>
  <div class="bv">
    <BielaVisit address={data.brand.address} />
    <aside class="bl-ui bv__aside" aria-label="Cómo llegar">
      <h2>Dónde estamos</h2>
      <p>{data.brand.address}</p>
      <h2>Horario</h2>
      <p>{data.brand.hoursLabel}</p>
      <h2>Escríbenos</h2>
      <p><a class="bl-link" href={`mailto:${data.brand.email}`}>{data.brand.email}</a><br /><a class="bl-link" href={`tel:${data.brand.phone.replace(/\s/g, '')}`}>{data.brand.phone}</a></p>
    </aside>
  </div>
</BielaSiteLayout>

<style>
  .bv {
    display: grid;
    gap: var(--sp-8, 2rem);
    align-items: start;
  }

  .bv__aside {
    padding: var(--sp-5, 1.25rem);
    border: 1px solid var(--bl-border-strong);
    border-radius: 16px;
    background: var(--bl-bg-raised);
    color: var(--bl-text-2);
    font-family: var(--bl-font-body);
  }

  .bv__aside h2 {
    margin: 0 0 0.3rem;
    font: 500 0.76rem var(--bl-font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bl-accent);
  }

  .bv__aside p {
    margin: 0 0 var(--sp-4, 1rem);
    line-height: 1.6;
  }

  @media (min-width: 900px) {
    .bv {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }
</style>
