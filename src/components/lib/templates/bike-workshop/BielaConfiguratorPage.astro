---
/**
 * BielaConfiguratorPage — Live bike configurator: type, material, transmission, wheels, colour,
 * extras and size, with the drawing, price and delivery time updating as you choose.
 *
 * @param {BielaRoutes} routes - Template route URLs.
 * @param {typeof bielaData} data - Options, builds and months (override with your own).
 */
import BielaSiteLayout from './BielaSiteLayout.astro';
import BielaConfigurator from '../../app/BielaConfigurator.astro';
import { bielaRoutes, bielaData, type BielaRoutes } from './data';

interface Props {
  routes?: BielaRoutes;
  data?: typeof bielaData;
}

const { routes = bielaRoutes, data = bielaData } = Astro.props;
---

<BielaSiteLayout title="Diseña tu bici — Biela" current="configurator" routes={routes} description="Configura tu bici a medida: tipo, material del cuadro, transmisión, ruedas, color y extras, con el precio y el plazo al momento.">
  <header class="biela-pagehead">
    <p class="bl-eyebrow">Configurador</p>
    <h1 class="biela-title">Diseña tu bici</h1>
    <p class="biela-lead">Elige cada pieza y mira cómo cambia el dibujo, el precio y el plazo. No es un pedido: es el punto de partida de la charla.</p>
  </header>
  <BielaConfigurator
    types={data.types}
    materials={data.materials}
    groupsets={data.groupsets}
    wheels={data.wheels}
    colours={data.colours}
    extras={data.extras}
    months={data.months}
    builds={data.builds}
  />
</BielaSiteLayout>
