---
/**
 * BielaFitPage — Size and fit calculator: height, inseam, flexibility and bike type give a frame
 * size, saddle height, stem, handlebar width, cranks and drop, with a link to the configurator.
 *
 * @param {BielaRoutes} routes - Template route URLs.
 */
import BielaSiteLayout from './BielaSiteLayout.astro';
import BielaFit from '../../app/BielaFit.astro';
import { bielaRoutes, type BielaRoutes } from './data';

interface Props {
  routes?: BielaRoutes;
}

const { routes = bielaRoutes } = Astro.props;
---

<BielaSiteLayout title="Tu talla — Biela" current="fit" routes={routes} description="Calcula la talla del cuadro, la altura del sillín y el resto de medidas de tu bici con tu altura y tu entrepierna.">
  <header class="biela-pagehead">
    <p class="bl-eyebrow">Tu talla</p>
    <h1 class="biela-title">Qué talla necesitas</h1>
    <p class="biela-lead">Con dos medidas te damos una talla de partida y el resto de cotas. La confirmamos en el banco de ajuste.</p>
  </header>
  <BielaFit configuratorHref={routes.configurator} visitHref={routes.visit} />
</BielaSiteLayout>
