---
/**
 * BielaBuildsPage — Gallery of finished bikes with a type filter, a sort order and a link to start
 * the configurator from any of them.
 *
 * @param {BielaRoutes} routes - Template route URLs.
 * @param {typeof bielaData} data - Builds (override with your own).
 */
import BielaSiteLayout from './BielaSiteLayout.astro';
import BielaBuilds from '../../app/BielaBuilds.astro';
import { bielaRoutes, bielaData, type BielaRoutes } from './data';

interface Props {
  routes?: BielaRoutes;
  data?: typeof bielaData;
}

const { routes = bielaRoutes, data = bielaData } = Astro.props;
---

<BielaSiteLayout title="Bicis construidas — Biela" current="builds" routes={routes} description="Las bicis que han salido del taller: para quién se hicieron, de qué están hechas y cuánto costaron.">
  <header class="biela-pagehead">
    <p class="bl-eyebrow">Bicis construidas</p>
    <h1 class="biela-title">Cada una, para alguien</h1>
    <p class="biela-lead">Estas son algunas de las bicis que han salido del taller. Parte de cualquiera de ellas y cámbiale lo que quieras.</p>
  </header>
  <BielaBuilds builds={data.builds} configuratorHref={routes.configurator} />
</BielaSiteLayout>
