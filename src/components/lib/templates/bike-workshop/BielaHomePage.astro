---
/**
 * BielaHomePage — Home of the "Biela" custom bicycle workshop: hero with a repaintable drawn bike,
 * three recent builds, the six stages of a build and the build queue by month.
 *
 * @param {BielaRoutes} routes - Template route URLs.
 * @param {typeof bielaData} data - Builds, months and steps (override with your own).
 */
import BielaSiteLayout from './BielaSiteLayout.astro';
import BielaHero from '../../app/BielaHero.astro';
import BielaBuilds from '../../app/BielaBuilds.astro';
import BielaProcess from '../../app/BielaProcess.astro';
import BielaSlots from '../../app/BielaSlots.astro';
import { bielaRoutes, bielaData, type BielaRoutes } from './data';

interface Props {
  routes?: BielaRoutes;
  data?: typeof bielaData;
}

const { routes = bielaRoutes, data = bielaData } = Astro.props;
---

<BielaSiteLayout title="Biela — Bicis a medida, hechas a mano en València" routes={routes}>
  <BielaHero primaryHref={routes.configurator} secondaryHref={routes.builds} />

  <section class="biela-section" aria-labelledby="home-builds">
    <div class="biela-section__head">
      <h2 id="home-builds">Las últimas que han salido</h2>
      <a class="bl-link" href={routes.builds}>Ver todas las bicis</a>
    </div>
    <BielaBuilds builds={data.builds} limit={3} configuratorHref={routes.configurator} />
  </section>

  <section class="biela-section" aria-labelledby="home-process">
    <div class="biela-section__head">
      <div>
        <h2 id="home-process">Seis pasos, de la charla a la entrega</h2>
        <p class="biela-lead">Nada se corta sin que hayas visto el plano. Hasta el paso tres puedes echarte atrás y te devolvemos la señal.</p>
      </div>
    </div>
    <BielaProcess steps={data.steps} />
  </section>

  <section class="biela-section" aria-labelledby="home-slots">
    <div class="biela-section__head">
      <div>
        <h2 id="home-slots">Plazas para empezar tu cuadro</h2>
        <p class="biela-lead">Hacemos seis cuadros al mes, ni uno más. Elige cuándo quieres que empiece el tuyo.</p>
      </div>
    </div>
    <BielaSlots months={data.months} configuratorHref={routes.configurator} />
  </section>
</BielaSiteLayout>
