---
/**
 * GymClassesPage — Full weekly timetable with discipline filters, plus the disciplines guide.
 *
 * @param {GymRoutes} routes - Template route URLs.
 * @param {typeof gymData} data - Classes, disciplines and trainers.
 */
import GymSiteLayout from './GymSiteLayout.astro';
import GymSchedule from '../../sections/GymSchedule.astro';
import GymDisciplines from '../../sections/GymDisciplines.astro';
import { gymRoutes, gymData, type GymRoutes } from './data';

interface Props {
  routes?: GymRoutes;
  data?: typeof gymData;
}

const { routes = gymRoutes, data = gymData } = Astro.props;
---

<GymSiteLayout
  title={`Horario de clases · ${data.brand.name}`}
  description="Horario semanal de clases de fuerza, HIIT, funcional, boxeo, ciclo indoor y yoga en Bilbao. Reserva desde la app."
  current="classes"
  routes={routes}
>
  <GymSchedule
    classes={data.classes}
    disciplines={data.disciplines}
    trainers={data.trainers}
    bookingHref={routes.booking}
    title="Clases y horario"
    headingLevel="h1"
  />
  <GymDisciplines disciplines={data.disciplines} classesHref={routes.classes} title="Qué es cada clase" variant="list" />
</GymSiteLayout>
