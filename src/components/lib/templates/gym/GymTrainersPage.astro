---
/**
 * GymTrainersPage — The coaching team with certifications and the classes each one teaches.
 *
 * @param {GymRoutes} routes - Template route URLs.
 * @param {typeof gymData} data - Trainers and disciplines.
 */
import GymSiteLayout from './GymSiteLayout.astro';
import GymTrainersGrid from '../../sections/GymTrainersGrid.astro';
import { gymRoutes, gymData, type GymRoutes } from './data';

interface Props {
  routes?: GymRoutes;
  data?: typeof gymData;
}

const { routes = gymRoutes, data = gymData } = Astro.props;
---

<GymSiteLayout
  title={`Entrenadores · ${data.brand.name}`}
  description="Conoce al equipo de entrenadores de Forja: fuerza, boxeo, ciclo indoor y yoga."
  current="trainers"
  routes={routes}
>
  <GymTrainersGrid trainers={data.trainers} disciplines={data.disciplines} title="Entrenadores" headingLevel="h1" />
</GymSiteLayout>
