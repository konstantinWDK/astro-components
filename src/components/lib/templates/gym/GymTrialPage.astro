---
/**
 * GymTrialPage — Free trial sign-up with the club's address, hours and contact details.
 * Plan buttons link here with ?plan=<id>, which pre-selects the plan.
 *
 * @param {GymRoutes} routes - Template route URLs.
 * @param {typeof gymData} data - Brand, disciplines and plans.
 * @param {string} action - Backend endpoint for the form. Empty shows the pass on the page.
 */
import GymSiteLayout from './GymSiteLayout.astro';
import GymTrialForm from '../../sections/GymTrialForm.astro';
import { gymRoutes, gymData, type GymRoutes } from './data';

interface Props {
  routes?: GymRoutes;
  data?: typeof gymData;
  action?: string;
}

const { routes = gymRoutes, data = gymData, action = '' } = Astro.props;
---

<GymSiteLayout
  title={`Prueba gratis 7 días · ${data.brand.name}`}
  description="Prueba el gimnasio y todas las clases gratis durante 7 días. Sin tarjeta."
  current="trial"
  routes={routes}
>
  <GymTrialForm disciplines={data.disciplines} plans={data.plans} action={action} headingLevel="h1" />
</GymSiteLayout>
