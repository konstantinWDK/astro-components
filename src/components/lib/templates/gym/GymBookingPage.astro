---
/**
 * GymBookingPage — Member class booking: day picker, classes with spots left, book / cancel /
 * waitlist and the member's bookings. Links from the public schedule add ?class=<id>.
 *
 * @param {GymRoutes} routes - Template route URLs.
 * @param {typeof gymData} data - Classes, disciplines, trainers and the member's bookings.
 */
import GymAppLayout from './GymAppLayout.astro';
import GymAreaHeading from '../../app/GymAreaHeading.astro';
import GymClassBooking from '../../app/GymClassBooking.astro';
import { gymRoutes, gymData, type GymRoutes } from './data';

interface Props {
  routes?: GymRoutes;
  data?: typeof gymData;
}

const { routes = gymRoutes, data = gymData } = Astro.props;
---

<GymAppLayout title="Reservar clase" current="booking" routes={routes}>
  <GymAreaHeading
    title="Reservar clase"
    description="Reserva con hasta 7 días de antelación. Cancela gratis hasta 2 horas antes."
    back={{ label: 'Mi progreso', href: routes.dashboard }}
    actions={[{ label: 'Horario público', href: routes.classes }]}
  />
  <div class="gym-booking-wrap">
    <GymClassBooking classes={data.classes} disciplines={data.disciplines} trainers={data.trainers} booked={data.member.bookings} />
  </div>
</GymAppLayout>

<style>
  .gym-booking-wrap {
    margin-top: var(--sp-6, 1.5rem);
  }
</style>
