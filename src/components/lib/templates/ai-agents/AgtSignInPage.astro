---
/**
 * AgtSignInPage — Sign-in of the "Nexo" AI-agents template: a full-screen split with a drawn
 * conversation and the form. Standalone document (no app shell).
 *
 * @param {AgtRoutes} routes - Template route URLs.
 * @param {string} action - Backend endpoint for the form. Empty runs a demo sign-in.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 */
import '../../../../styles/global.css';
import './agt-theme.css';
import AgtSignIn from '../../app/AgtSignIn.astro';
import { agtRoutes, type AgtRoutes } from './data';

interface Props {
  routes?: AgtRoutes;
  action?: string;
  theme?: 'light' | 'dark' | 'auto';
}

const { routes = agtRoutes, action = '', theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-agt" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso — Nexo</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="agt-si-body">
    <main id="main-content">
      <AgtSignIn dashboardHref={routes.chat} homeHref={routes.home} action={action} />
    </main>
  </body>
</html>

<style>
  .agt-si-body {
    margin: 0;
    background: var(--ag-bg);
    color: var(--ag-text);
    font-family: var(--ag-font-body);
  }
</style>
