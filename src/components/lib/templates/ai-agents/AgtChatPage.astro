---
/**
 * AgtChatPage — Home of the "Nexo" template: the general chat with conversations, tool calls and an agent inspector.
 *
 * @param {AgtRoutes} routes - Template route URLs.
 * @param {typeof agtData} data - Workspace, agents, conversations, users, integrations and usage.
 */
import AgtAppLayout from './AgtAppLayout.astro';
import AgtHeading from '../../app/AgtHeading.astro';
import AgtChat from '../../app/AgtChat.astro';
import { agtRoutes, agtData, type AgtRoutes } from './data';

interface Props {
  routes?: AgtRoutes;
  data?: typeof agtData;
}

const { routes = agtRoutes, data = agtData } = Astro.props;
---

<AgtAppLayout title="Chat" current="chat" wide routes={routes}>
  <AgtHeading kicker="Espacio de trabajo" title="Chat general" description="Habla con cualquiera de tus agentes en un solo sitio. Cada respuesta enseña qué herramientas usó." />
  <AgtChat threads={data.threads} agents={data.agents} agentsHref={routes.agents} />
</AgtAppLayout>
