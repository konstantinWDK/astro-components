---
/**
 * AgtIntegrationsPage — APIs and integrations: connected services, API keys, webhooks and a request example.
 *
 * @param {AgtRoutes} routes - Template route URLs.
 * @param {typeof agtData} data - Workspace, agents, conversations, users, integrations and usage.
 */
import AgtAppLayout from './AgtAppLayout.astro';
import AgtHeading from '../../app/AgtHeading.astro';
import AgtIntegrations from '../../app/AgtIntegrations.astro';
import { agtRoutes, agtData, type AgtRoutes } from './data';

interface Props {
  routes?: AgtRoutes;
  data?: typeof agtData;
}

const { routes = agtRoutes, data = agtData } = Astro.props;
---

<AgtAppLayout title="Integraciones" current="integrations" routes={routes}>
  <AgtHeading kicker="Conexiones" title="Integraciones y claves" description="Conecta servicios, guarda tus claves de API y avisa a tus sistemas con webhooks." />
  <AgtIntegrations providers={data.providers} keys={data.keys} webhooks={data.webhooks} />
</AgtAppLayout>
