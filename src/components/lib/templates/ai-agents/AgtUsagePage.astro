---
/**
 * AgtUsagePage — Consumption: token and spend meters, daily chart, share per agent and spending limits.
 *
 * @param {AgtRoutes} routes - Template route URLs.
 * @param {typeof agtData} data - Workspace, agents, conversations, users, integrations and usage.
 */
import AgtAppLayout from './AgtAppLayout.astro';
import AgtHeading from '../../app/AgtHeading.astro';
import AgtUsage from '../../app/AgtUsage.astro';
import { agtRoutes, agtData, type AgtRoutes } from './data';

interface Props {
  routes?: AgtRoutes;
  data?: typeof agtData;
}

const { routes = agtRoutes, data = agtData } = Astro.props;
---

<AgtAppLayout title="Consumo" current="usage" routes={routes}>
  <AgtHeading kicker="Facturación" title="Consumo y límites" description="Cuántos tokens gastáis, quién los gasta y dónde poner el tope." />
  <AgtUsage usage={data.usage} />
</AgtAppLayout>
