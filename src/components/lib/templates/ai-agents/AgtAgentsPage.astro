---
/**
 * AgtAgentsPage — Agent management: list, filters, pause/activate and a dialog to create or edit an agent.
 *
 * @param {AgtRoutes} routes - Template route URLs.
 * @param {typeof agtData} data - Workspace, agents, conversations, users, integrations and usage.
 */
import AgtAppLayout from './AgtAppLayout.astro';
import AgtHeading from '../../app/AgtHeading.astro';
import AgtAgents from '../../app/AgtAgents.astro';
import { agtRoutes, agtData, type AgtRoutes } from './data';

interface Props {
  routes?: AgtRoutes;
  data?: typeof agtData;
}

const { routes = agtRoutes, data = agtData } = Astro.props;
---

<AgtAppLayout title="Agentes" current="agents" routes={routes}>
  <AgtHeading kicker="Equipo de IA" title="Agentes" description="Crea agentes con su propio modelo, instrucciones y herramientas, y decide cuáles están en marcha." />
  <AgtAgents agents={data.agents} models={data.models} chatHref={routes.chat} />
</AgtAppLayout>
