---
/**
 * AgtUsersPage — User management: members table, roles, invitations, suspension and the permissions matrix.
 *
 * @param {AgtRoutes} routes - Template route URLs.
 * @param {typeof agtData} data - Workspace, agents, conversations, users, integrations and usage.
 */
import AgtAppLayout from './AgtAppLayout.astro';
import AgtHeading from '../../app/AgtHeading.astro';
import AgtUsers from '../../app/AgtUsers.astro';
import { agtRoutes, agtData, type AgtRoutes } from './data';

interface Props {
  routes?: AgtRoutes;
  data?: typeof agtData;
}

const { routes = agtRoutes, data = agtData } = Astro.props;
---

<AgtAppLayout title="Usuarios" current="users" routes={routes}>
  <AgtHeading kicker="Personas" title="Usuarios y roles" description="Invita a tu equipo, cambia roles y mira qué puede hacer cada uno." />
  <AgtUsers users={data.users} seats={8} />
</AgtAppLayout>
