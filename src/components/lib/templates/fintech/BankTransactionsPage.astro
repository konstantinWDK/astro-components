---
/**
 * BankTransactionsPage — Full movements list with search, filters, sorting and CSV export.
 *
 * @param {BankRoutes} routes - Template route URLs.
 * @param {typeof bankData} data - Transactions and categories.
 */
import BankAppLayout from './BankAppLayout.astro';
import BankAppHeading from '../../app/BankAppHeading.astro';
import BankTransactionsTable from '../../app/BankTransactionsTable.astro';
import { bankRoutes, bankData, type BankRoutes } from './data';

interface Props {
  routes?: BankRoutes;
  data?: typeof bankData;
}

const { routes = bankRoutes, data = bankData } = Astro.props;
---

<BankAppLayout title="Movimientos" current="transactions" routes={routes}>
  <BankAppHeading
    kicker="Mi cuenta"
    title="Movimientos"
    description="Busca, filtra y exporta lo que entra y sale de tus cuentas."
    back={{ label: 'Resumen', href: routes.dashboard }}
  />
  <div class="bank-page">
    <BankTransactionsTable transactions={data.transactions} categories={data.categories} />
  </div>
</BankAppLayout>

<style>
  .bank-page {
    margin-top: var(--sp-4, 1rem);
  }
</style>
