---
/**
 * BankCardsPage — Card management: pick a card, reveal its number, freeze it and set its limit.
 *
 * @param {BankRoutes} routes - Template route URLs.
 * @param {typeof bankData} data - Cards.
 */
import BankAppLayout from './BankAppLayout.astro';
import BankAppHeading from '../../app/BankAppHeading.astro';
import BankCardManager from '../../app/BankCardManager.astro';
import { bankRoutes, bankData, type BankRoutes } from './data';

interface Props {
  routes?: BankRoutes;
  data?: typeof bankData;
}

const { routes = bankRoutes, data = bankData } = Astro.props;
---

<BankAppLayout title="Tarjetas" current="cards" routes={routes}>
  <BankAppHeading
    kicker="Mi cuenta"
    title="Tarjetas"
    description="Congela, limita y revisa el gasto de cada tarjeta al instante."
    back={{ label: 'Resumen', href: routes.dashboard }}
    actions={[{ label: 'Nueva tarjeta virtual', href: routes.cards, primary: true }]}
  />
  <div class="bank-page">
    <BankCardManager cards={data.cards} />
  </div>
</BankAppLayout>

<style>
  .bank-page {
    margin-top: var(--sp-4, 1rem);
  }
</style>
