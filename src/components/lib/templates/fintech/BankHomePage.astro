---
/**
 * BankHomePage — Home of the "Cobre" neobank template: hero, benefits, card picker, savings
 * calculator, fee comparison, security and FAQ.
 *
 * @param {BankRoutes} routes - Template route URLs.
 * @param {typeof bankData} data - Brand, features, plans and FAQ.
 */
import BankSiteLayout from './BankSiteLayout.astro';
import BankHero from '../../sections/BankHero.astro';
import BankFeatures from '../../sections/BankFeatures.astro';
import BankCardShowcase from '../../sections/BankCardShowcase.astro';
import BankSavingsCalculator from '../../sections/BankSavingsCalculator.astro';
import BankFeeTable from '../../sections/BankFeeTable.astro';
import BankSecurity from '../../sections/BankSecurity.astro';
import BankFaq from '../../sections/BankFaq.astro';
import { bankRoutes, bankData, type BankRoutes } from './data';

interface Props {
  routes?: BankRoutes;
  data?: typeof bankData;
}

const { routes = bankRoutes, data = bankData } = Astro.props;
---

<BankSiteLayout
  title={`${data.brand.name} · La cuenta para autónomos y pymes`}
  description="Cuenta online para autónomos y pymes: IBAN español, reserva de impuestos automática, tarjetas con control y una hucha al 2,5 % TAE."
  routes={routes}
>
  <BankHero openHref={routes.open} pricingHref={routes.pricing} stats={data.stats} />
  <BankFeatures features={data.features} />
  <BankCardShowcase openHref={routes.open} />
  <BankSavingsCalculator openHref={routes.open} />
  <BankFeeTable brand={data.brand.name} />
  <BankSecurity />
  <BankFaq faqs={data.faqs} />
</BankSiteLayout>
