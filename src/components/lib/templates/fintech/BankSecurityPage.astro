---
/**
 * BankSecurityPage — Security and regulation: protection pillars, deposit guarantee and FAQ.
 *
 * @param {BankRoutes} routes - Template route URLs.
 * @param {typeof bankData} data - Brand and FAQ.
 */
import BankSiteLayout from './BankSiteLayout.astro';
import BankSecurity from '../../sections/BankSecurity.astro';
import BankFaq from '../../sections/BankFaq.astro';
import { bankRoutes, bankData, type BankRoutes } from './data';

interface Props {
  routes?: BankRoutes;
  data?: typeof bankData;
}

const { routes = bankRoutes, data = bankData } = Astro.props;
---

<BankSiteLayout
  title={`Seguridad y garantías · ${data.brand.name}`}
  description="Depósitos garantizados hasta 100.000 €, autenticación reforzada PSD2, control de tarjetas y monitorización 24/7."
  current="security"
  routes={routes}
>
  <BankSecurity headingLevel="h1" />
  <BankFaq faqs={data.faqs} title="Sobre tu dinero y tus datos" />
</BankSiteLayout>
