---
/**
 * BankPricingPage — Plans with the monthly / yearly switch, the fee comparison and the FAQ.
 *
 * @param {BankRoutes} routes - Template route URLs.
 * @param {typeof bankData} data - Plans, brand and FAQ.
 */
import BankSiteLayout from './BankSiteLayout.astro';
import BankPlans from '../../sections/BankPlans.astro';
import BankFeeTable from '../../sections/BankFeeTable.astro';
import BankFaq from '../../sections/BankFaq.astro';
import { bankRoutes, bankData, type BankRoutes } from './data';

interface Props {
  routes?: BankRoutes;
  data?: typeof bankData;
}

const { routes = bankRoutes, data = bankData } = Astro.props;
---

<BankSiteLayout
  title={`Precios · ${data.brand.name}`}
  description="Planes Base (gratis), Autónomo y Empresa. Sin permanencia, sin comisiones ocultas. Ahorra pagando al año."
  current="pricing"
  routes={routes}
>
  <BankPlans plans={data.plans} ctaHref={routes.open} title="Precios" headingLevel="h1" />
  <BankFeeTable brand={data.brand.name} />
  <BankFaq faqs={data.faqs} />
</BankSiteLayout>
