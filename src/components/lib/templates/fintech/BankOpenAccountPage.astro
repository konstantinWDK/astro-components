---
/**
 * BankOpenAccountPage — Open-an-account wizard in three steps. Reads `?plan=` to pre-select
 * the plan.
 *
 * @param {BankRoutes} routes - Template route URLs.
 * @param {typeof bankData} data - Plans and brand.
 * @param {string} action - Backend endpoint for the form. Empty shows a demo confirmation.
 */
import BankSiteLayout from './BankSiteLayout.astro';
import BankOnboarding from '../../sections/BankOnboarding.astro';
import { bankRoutes, bankData, type BankRoutes } from './data';

interface Props {
  routes?: BankRoutes;
  data?: typeof bankData;
  action?: string;
}

const { routes = bankRoutes, data = bankData, action = '' } = Astro.props;
---

<BankSiteLayout
  title={`Abrir cuenta · ${data.brand.name}`}
  description="Abre tu cuenta de autónomo o empresa en 6 minutos, sin papeles ni citas."
  current="open"
  routes={routes}
>
  <BankOnboarding plans={data.plans} action={action} dashboardHref={routes.dashboard} headingLevel="h1" />
</BankSiteLayout>
