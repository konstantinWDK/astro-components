---
/**
 * EstateListingsCmsPage — Listings manager: inventory summary and a searchable, sortable
 * table with status filters (active, reserved, sold), price, views and leads per listing.
 *
 * @param {EstateRoutes} routes - Template route URLs.
 * @param {typeof estateData} data - Listings and agents.
 */
import EstateAppLayout from './EstateAppLayout.astro';
import PageHeader from '../../app/PageHeader.astro';
import DataTable from '../../app/DataTable.astro';
import { estateRoutes, estateData, estateTypeLabels, getEstateAgent, type EstateRoutes } from './data';

interface Props {
  routes?: EstateRoutes;
  data?: typeof estateData;
}

const { routes = estateRoutes, data = estateData } = Astro.props;

const statusNames = { active: 'Activa', reserved: 'Reservada', sold: 'Vendida', draft: 'Borrador' } as const;

const rows = data.properties.map((p) => ({
  property: { name: p.title, sub: `${estateTypeLabels[p.type]} · ${p.zone}` },
  operation: p.operation === 'sale' ? 'Venta' : 'Alquiler',
  agent: getEstateAgent(p.agentId, data.agents)?.name ?? '—',
  price: p.price,
  status: statusNames[p.status],
  views: p.views,
  leads: p.leads,
  days: p.publishedDays,
}));

const saleVolume = data.properties.filter((p) => p.operation === 'sale' && p.status !== 'sold').reduce((s, p) => s + p.price, 0);
const eur = (n: number) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', notation: 'compact', maximumFractionDigits: 1 }).format(n);
---

<EstateAppLayout title="Propiedades" current="listingsCms" routes={routes}>
  <PageHeader
    title="Propiedades"
    description="Gestiona la cartera: precios, estado y rendimiento de cada anuncio."
    breadcrumb={[{ label: 'CRM', href: routes.dashboard }, { label: 'Propiedades' }]}
    actions={[
      { label: 'Exportar', icon: 'download' },
      { label: 'Nueva propiedad', icon: 'plus', primary: true },
    ]}
    periods={[]}
  />

  <ul class="estate-ui estate-inv" role="list">
    <li><span>En cartera</span><strong>{data.properties.length}</strong></li>
    <li><span>Activas</span><strong>{data.properties.filter((p) => p.status === 'active').length}</strong></li>
    <li><span>Reservadas</span><strong>{data.properties.filter((p) => p.status === 'reserved').length}</strong></li>
    <li><span>Volumen en venta</span><strong>{eur(saleVolume)}</strong></li>
  </ul>

  <DataTable
    id="estate-listings"
    title="Anuncios"
    columns={[
      { key: 'property', label: 'Propiedad', type: 'person', sortable: true },
      { key: 'operation', label: 'Operación', sortable: true },
      { key: 'agent', label: 'Agente', sortable: true },
      { key: 'price', label: 'Precio', type: 'money', align: 'right', sortable: true },
      { key: 'status', label: 'Estado', type: 'status' },
      { key: 'views', label: 'Visitas', type: 'number', align: 'right', sortable: true },
      { key: 'leads', label: 'Leads', type: 'number', align: 'right', sortable: true },
      { key: 'days', label: 'Días publicada', type: 'number', align: 'right', sortable: true },
    ]}
    rows={rows}
    statusTones={{ Activa: 'success', Reservada: 'warning', Vendida: 'default', Borrador: 'info' }}
    filterKey="status"
    bulkActions={['Exportar', 'Republicar en portales']}
    searchPlaceholder="Buscar por título, barrio o agente…"
    locale="es-ES"
    emptyText="No hay propiedades con estos filtros."
  />
</EstateAppLayout>

<style>
  .estate-inv {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: var(--sp-3, 0.75rem);
    margin: var(--sp-6, 1.5rem) 0;
    padding: 0;
    list-style: none;
  }

  .estate-inv li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--sp-4, 1rem) var(--sp-5, 1.25rem);
    border-radius: var(--r-lg, 20px);
    border: 1px solid var(--estate-border);
    background: var(--estate-bg-raised);
  }

  .estate-inv span {
    color: var(--estate-text-3);
    font-size: 0.85rem;
  }

  .estate-inv strong {
    font-family: var(--estate-font-display);
    font-size: 1.7rem;
    font-weight: 600;
  }
</style>
