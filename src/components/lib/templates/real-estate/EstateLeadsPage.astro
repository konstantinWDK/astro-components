---
/**
 * EstateLeadsPage — Full lead pipeline for the agency: every buyer and tenant lead by stage,
 * with move buttons, call links and notes.
 *
 * @param {EstateRoutes} routes - Template route URLs.
 * @param {typeof estateData} data - Leads, listings and agents.
 */
import EstateAppLayout from './EstateAppLayout.astro';
import PageHeader from '../../app/PageHeader.astro';
import EstateLeadsPipeline from '../../app/EstateLeadsPipeline.astro';
import { estateRoutes, estateData, type EstateRoutes } from './data';

interface Props {
  routes?: EstateRoutes;
  data?: typeof estateData;
}

const { routes = estateRoutes, data = estateData } = Astro.props;
---

<EstateAppLayout title="Leads" current="leads" routes={routes}>
  <PageHeader
    title="Leads"
    description="Compradores e inquilinos interesados, de la primera consulta a la firma."
    breadcrumb={[{ label: 'CRM', href: routes.dashboard }, { label: 'Leads' }]}
    actions={[{ label: 'Añadir lead', icon: 'plus', primary: true }]}
    periods={['7 días', '30 días', 'Trimestre']}
    activePeriod={1}
  />
  <div class="estate-leads-wrap">
    <EstateLeadsPipeline leads={data.leads} properties={data.properties} agents={data.agents} propertyBase={routes.listings} />
  </div>
</EstateAppLayout>

<style>
  .estate-leads-wrap {
    margin-top: var(--sp-6, 1.5rem);
  }
</style>
