---
/**
 * EstateSignInPage — Agent sign-in for the Nido CRM, built on EstateAgentSignIn.
 * In the demo any email and password open the dashboard.
 *
 * @param {EstateRoutes} routes - Template route URLs (sign-in goes to `routes.dashboard`).
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 * @param {boolean} noindex - Add robots noindex. Default true.
 */
import '../../../../styles/global.css';
import './real-estate-theme.css';
import EstateAgentSignIn from '../../app/EstateAgentSignIn.astro';
import { estateRoutes, type EstateRoutes } from './data';

interface Props {
  routes?: EstateRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = estateRoutes, theme = 'dark', noindex = true } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-estate" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso agentes — Nido CRM</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="estate-signin-page">
    <EstateAgentSignIn
      brand="Nido CRM"
      successHref={routes.dashboard}
      backHref={routes.home}
    />
  </body>
</html>

<style>
  .estate-signin-page {
    margin: 0;
    min-height: 100vh;
    font-family: var(--estate-font-body);
    background: var(--estate-bg);
    color: var(--estate-text);
  }
</style>
