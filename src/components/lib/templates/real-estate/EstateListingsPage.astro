---
/**
 * EstateListingsPage — Search results page: filters, sorting, favourites and the zone map.
 * Reads ?op=&zone=&type=&max= from the URL, so links from the hero, the nav and the
 * neighbourhood cards open already filtered.
 *
 * @param {EstateRoutes} routes - Template route URLs.
 * @param {typeof estateData} data - Brand, listings, zones and agents.
 */
import EstateSiteLayout from './EstateSiteLayout.astro';
import EstateListingsGrid from '../../sections/EstateListingsGrid.astro';
import EstateValuationCta from '../../sections/EstateValuationCta.astro';
import { estateRoutes, estateData, type EstateRoutes } from './data';

interface Props {
  routes?: EstateRoutes;
  data?: typeof estateData;
}

const { routes = estateRoutes, data = estateData } = Astro.props;
---

<EstateSiteLayout
  title={`Pisos y casas en Valencia · ${data.brand.name}`}
  description="Busca pisos, áticos, estudios y chalets en venta y alquiler en Valencia. Filtra por barrio, precio y habitaciones."
  current="listings"
  routes={routes}
>
  <EstateListingsGrid
    properties={data.properties}
    detailBase={routes.listings}
    title="Propiedades en Valencia"
    headingLevel="h1"
    showMap
  />
  <EstateValuationCta
    href={routes.valuation}
    variant="subtle"
    title="¿Buscas vender antes de comprar?"
    text="Te decimos cuánto vale tu casa actual y coordinamos la venta con la compra, para que no pagues dos hipotecas."
  />
</EstateSiteLayout>
