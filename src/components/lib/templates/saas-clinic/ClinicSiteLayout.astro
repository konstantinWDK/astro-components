---
/**
 * ClinicSiteLayout — Public page shell for the clinic template: sticky navbar (brand, anchor links,
 * theme toggle, CTAs), main slot and FooterMegaSection. Used by the Pulso marketing landing and by
 * the clinic's own patient booking page.
 *
 * @param {string} title - Document title.
 * @param {string} description - Meta description.
 * @param {string} brand - Brand name in the navbar. Default 'Pulso'.
 * @param {string} brandHref - Brand link. Default '/'.
 * @param {Array<{label: string, href: string}>} links - Navbar links.
 * @param {{label: string, href: string}} login - Secondary nav link (optional).
 * @param {{label: string, href: string}} cta - Primary nav button (optional).
 * @param {string} tagline - Footer tagline.
 * @param {Array<{title: string, links: Array<{label: string, href: string}>}>} footer - Footer columns.
 * @param {string} theme - Initial theme (light|dark|auto). Default 'light'.
 * @param {boolean} noindex - Add robots noindex. Default false.
 * @param {string} lang - Document language. Default 'en'.
 */
import '../../../../styles/global.css';
import './pulso-theme.css';
import FooterMegaSection from '../../sections/FooterMegaSection.astro';

interface Props {
  title: string;
  description?: string;
  brand?: string;
  brandHref?: string;
  links?: Array<{ label: string; href: string }>;
  login?: { label: string; href: string };
  cta?: { label: string; href: string };
  tagline?: string;
  footer?: Array<{ title: string; links: Array<{ label: string; href: string }> }>;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description,
  brand = 'Pulso',
  brandHref = '/',
  links = [],
  login,
  cta,
  tagline = '',
  footer = [],
  theme = 'light',
  noindex = false,
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="theme-pulso" data-theme={theme === 'auto' ? 'light' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="pulso pulso--site">
    <a class="pulso__skip" href="#main">Skip to content</a>
    <header class="site-nav">
      <div class="site-nav__inner">
        <a class="site-nav__brand" href={brandHref}>
          <span aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-5 4 10 2-5h6"/></svg></span>
          {brand}
        </a>
        {links.length > 0 && (
          <nav aria-label="Main">
            <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
        )}
        <div class="site-nav__cta">
          <button type="button" class="site-nav__theme" aria-label="Switch between light and dark theme" data-site-theme>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
          </button>
          {login && <a class="site-nav__link" href={login.href}>{login.label}</a>}
          {cta && <a class="site-nav__btn" href={cta.href}>{cta.label}</a>}
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <FooterMegaSection
      brand={brand}
      tagline={tagline}
      columns={footer}
      status="All systems operational"
      copyright={`© ${new Date().getFullYear()} ${brand}. Demo template built with Astro Components Kit. All people and records are fictional.`}
    />
  </body>
</html>

<script>
  document.querySelector('[data-site-theme]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { window.localStorage.setItem('ack-theme', next); } catch { /* ignore */ }
  });
</script>

<style is:global>
  .pulso--site main { position: relative; overflow-x: clip; outline: none; }
  .pulso--site main > *, .pulso--site main > div > * { --c-primary: var(--app-accent); --c-primary-light: var(--app-accent); }
  .site-nav { position: sticky; top: 0; z-index: 50; background: rgb(var(--paper-rgb) / 0.86); backdrop-filter: blur(14px) saturate(1.3); border-bottom: 1px solid var(--c-border); }
  .site-nav__inner { display: flex; align-items: center; gap: var(--sp-6); max-width: 1200px; height: 68px; margin: 0 auto; padding: 0 var(--sp-5); }
  .site-nav__brand { display: inline-flex; align-items: center; gap: var(--sp-2); font-weight: 800; font-size: 1.1rem; color: var(--c-text-1); }
  .site-nav__brand span { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--app-accent); color: var(--c-on-primary); }
  .site-nav nav ul { display: flex; gap: var(--sp-1); margin: 0; padding: 0; list-style: none; }
  .site-nav nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.8rem; border-radius: 8px; color: var(--c-text-2); font-size: 0.95rem; font-weight: 500; }
  .site-nav nav a:hover { color: var(--c-text-1); background: rgb(var(--ink-rgb) / 0.05); }
  .site-nav__cta { display: flex; align-items: center; gap: var(--sp-2); margin-left: auto; }
  .site-nav__theme { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 10px; background: transparent; color: var(--c-text-2); cursor: pointer; }
  .site-nav__theme:hover { background: rgb(var(--ink-rgb) / 0.06); color: var(--c-text-1); }
  .site-nav__link { min-height: 44px; display: inline-flex; align-items: center; padding: 0 0.8rem; color: var(--c-text-1); font-weight: 600; font-size: 0.95rem; }
  .site-nav__btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.1rem; border-radius: 10px; background: var(--app-accent); color: var(--c-on-primary); font-weight: 700; font-size: 0.92rem; }
  .site-nav__btn:hover { color: var(--c-on-primary); filter: brightness(1.08); }
  .site-nav :is(a, button):focus-visible { outline: 3px solid var(--app-accent); outline-offset: 2px; }
  .pulso-section { max-width: 1200px; margin: 0 auto; padding: clamp(3rem, 7vw, 5rem) var(--sp-5) 0; }
  @media (max-width: 900px) { .site-nav nav { display: none; } }
  @media (max-width: 460px) { .site-nav__link { display: none; } .site-nav__inner { gap: var(--sp-3); } }
</style>
