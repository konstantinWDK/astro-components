---
/**
 * ClinicConsultationPage — The visit in progress: MedConsultationNote (SOAP with vitals flags,
 * ICD-10 diagnoses, templates, autosave, sign & lock) beside MedPrescriptionPad (allergy and
 * duplicate-therapy checks) and the patient's summary.
 *
 * Usage (src/pages/app/consultation.astro):
 *   import { ClinicConsultationPage } from 'astro-component-kit/templates/saas-clinic';
 *   <ClinicConsultationPage />
 *
 * @param {string} appointment - Appointment id. Default: the visit in progress.
 * @param {ClinicData} data - Workspace data.
 * @param {ClinicRoutes} routes - Page URLs.
 * @param {string} theme - Initial theme (light|dark|auto). Default 'light'.
 */
import ClinicLayout from './ClinicLayout.astro';
import PageHeader from '../../app/PageHeader.astro';
import MedConsultationNote from '../../app/MedConsultationNote.astro';
import MedPrescriptionPad from '../../app/MedPrescriptionPad.astro';
import MedPatientSummary from '../../app/MedPatientSummary.astro';
import { clinicData, clinicRoutes, clinicPatient, clinicDoctor, patientVitals, patientHref, type ClinicData, type ClinicRoutes } from './data';

interface Props {
  appointment?: string;
  data?: ClinicData;
  routes?: ClinicRoutes;
  theme?: 'light' | 'dark' | 'auto';
}

const { appointment, data = clinicData, routes = clinicRoutes, theme = 'light' } = Astro.props;

const appt = data.appointments.find((a) => a.id === appointment) ?? data.appointments.find((a) => a.status === 'in-progress') ?? data.appointments[0];
const p = clinicPatient(data, appt.patient)!;
const doc = clinicDoctor(data, appt.doctor)!;
const current = p.medications
  .map((m) => data.formulary.find((f) => f.name.toLowerCase() === m.name.toLowerCase())?.class)
  .filter((c): c is string => Boolean(c));
---

<ClinicLayout title={`Consultation · ${p.name}`} current="consultation" data={data} routes={routes} theme={theme}>
  <PageHeader
    title="Consultation"
    description={`${p.name} · ${p.age} y · ${appt.reason}`}
    breadcrumb={[{ label: data.workspace.name, href: routes.dashboard }, { label: 'Patients', href: routes.patients }, { label: p.name, href: patientHref(routes, p.id) }, { label: 'Consultation' }]}
    actions={[{ label: 'Patient record', icon: 'clipboard', href: patientHref(routes, p.id) }, { label: 'Switch to video', icon: 'video', href: routes.telehealth }]}
    periods={[]}
  />

  <div class="pulso-grid pulso-grid--3-2 consult">
    <MedConsultationNote
      patient={p.name}
      visit={`${data.days[appt.day]} ${appt.start} · ${appt.type === 'video' ? 'Video' : `In person, ${doc.room}`} · ${appt.reason}`}
      clinician={doc.name}
      diagnoses={data.diagnoses}
      storageKey={`pulso-note-${appt.id}`}
    />
    <div class="consult__side">
      <MedPrescriptionPad
        patient={p.name}
        allergies={p.allergies}
        current={current}
        formulary={data.formulary}
        prescriber={doc.name}
      />
      <MedPatientSummary
        patient={{ name: p.name, age: p.age, sex: p.sex, mrn: p.mrn, insurance: p.insurance }}
        allergies={p.allergies}
        vitals={patientVitals(p).slice(0, 2)}
        conditions={p.conditions}
        medications={p.medications}
        visits={[]}
        actions={[]}
      />
    </div>
  </div>
</ClinicLayout>

<style>
  .consult { align-items: start; }
  .consult__side { display: grid; gap: var(--sp-5); min-width: 0; }
  .consult__side :global(.pt-sum__vitals) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
</style>
