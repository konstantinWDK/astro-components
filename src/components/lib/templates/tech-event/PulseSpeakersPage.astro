---
/**
 * PulseSpeakersPage — Dedicated speakers directory page for Pulse Tech Summit.
 *
 * @param {PulseRoutes} routes - Routing configuration object.
 */
import PulseSiteLayout from './PulseSiteLayout.astro';
import PulseSpeakers from '../../app/PulseSpeakers.astro';
import { pulseRoutes, type PulseRoutes } from './data';

interface Props {
  routes?: PulseRoutes;
}

const { routes = pulseRoutes } = Astro.props;
---

<PulseSiteLayout
  title="Ponentes y Especialistas Invitados · Pulse Tech Summit 2027"
  description="Conoce a los 48 ponentes líderes mundiales en IA, Wasm, rendimiento web y criptografía cuántica que participan en la cumbre."
  current="speakers"
  routes={routes}
>
  <PulseSpeakers />
</PulseSiteLayout>

