---
/**
 * PulseVenuePage — Dedicated venue and travel logistics page for Pulse Tech Summit.
 *
 * @param {PulseRoutes} routes - Routing configuration object.
 */
import PulseSiteLayout from './PulseSiteLayout.astro';
import PulseVenue from '../../app/PulseVenue.astro';
import PulseSponsors from '../../app/PulseSponsors.astro';
import { pulseRoutes, type PulseRoutes } from './data';

interface Props {
  routes?: PulseRoutes;
}

const { routes = pulseRoutes } = Astro.props;
---

<PulseSiteLayout
  title="Sede y Guía de Viaje · Pulse Tech Summit 2027"
  description="Toda la información práctica sobre el Madrid Tech Arena, transporte en Metro y Cercanías, plano interactivo de salas y hoteles colaboradores con descuento."
  current="venue"
  routes={routes}
>
  <PulseVenue />
  <PulseSponsors />
</PulseSiteLayout>

