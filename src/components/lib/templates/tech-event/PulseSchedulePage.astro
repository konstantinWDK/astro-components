---
/**
 * PulseSchedulePage — Dedicated conference schedule & agenda page for Pulse Tech Summit.
 *
 * @param {PulseRoutes} routes - Routing configuration object.
 */
import PulseSiteLayout from './PulseSiteLayout.astro';
import PulseSchedule from '../../app/PulseSchedule.astro';
import { pulseRoutes, type PulseRoutes } from './data';

interface Props {
  routes?: PulseRoutes;
}

const { routes = pulseRoutes } = Astro.props;
---

<PulseSiteLayout
  title="Programa Técnico Completo · Pulse Tech Summit 2027"
  description="Consulta la agenda de los 3 días de conferencia en los 4 tracks temáticos. Filtra por tema, ponente y guarda tus charlas en tu agenda personal."
  current="schedule"
  routes={routes}
>
  <PulseSchedule />
</PulseSiteLayout>

