---
/**
 * PulseHomePage — Landing page for the Pulse Tech Summit.
 * Orchestrates the Hero with live countdown, 4 core tracks, keynote speakers teaser,
 * interactive schedule preview, tiered tickets CTA, interactive venue teaser, and sponsors.
 *
 * @param {PulseRoutes} routes - Routing configuration object.
 */
import PulseSiteLayout from './PulseSiteLayout.astro';
import PulseHero from '../../app/PulseHero.astro';
import PulseTracks from '../../app/PulseTracks.astro';
import PulseSpeakers from '../../app/PulseSpeakers.astro';
import PulseTickets from '../../app/PulseTickets.astro';
import PulseVenue from '../../app/PulseVenue.astro';
import PulseSponsors from '../../app/PulseSponsors.astro';
import { pulseRoutes, type PulseRoutes } from './data';

interface Props {
  routes?: PulseRoutes;
}

const { routes = pulseRoutes } = Astro.props;
---

<PulseSiteLayout
  title="Pulse Tech Summit 2027 · Cumbre Tecnológica Internacional en Madrid"
  description="14-16 de Octubre 2027. 3 días de inmersión técnica en IA distribuida, Edge Computing, Web de alto rendimiento y Ciberseguridad cuántica."
  current="home"
  routes={routes}
>
  <!-- Hero Section -->
  <PulseHero
    primaryHref={routes.tickets}
    secondaryHref={routes.schedule}
  />

  <!-- 4 Tracks -->
  <PulseTracks scheduleHref={routes.schedule} />

  <!-- Featured Keynotes -->
  <PulseSpeakers
    featuredOnly={true}
    allHref={routes.speakers}
    title="Keynote Speakers Confirmados"
  />

  <!-- Venue & Floor Map -->
  <PulseVenue />

  <!-- Ticket Pricing -->
  <PulseTickets />

  <!-- Sponsors & Partners -->
  <PulseSponsors />
</PulseSiteLayout>

