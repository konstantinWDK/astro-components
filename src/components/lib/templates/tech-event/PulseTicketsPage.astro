---
/**
 * PulseTicketsPage — Dedicated registration & ticket checkout page for Pulse Tech Summit.
 *
 * @param {PulseRoutes} routes - Routing configuration object.
 */
import PulseSiteLayout from './PulseSiteLayout.astro';
import PulseTickets from '../../app/PulseTickets.astro';
import { pulseRoutes, type PulseRoutes } from './data';

interface Props {
  routes?: PulseRoutes;
}

const { routes = pulseRoutes } = Astro.props;
---

<PulseSiteLayout
  title="Entradas y Registro Oficial · Pulse Tech Summit 2027"
  description="Consigue tu pase para el Pulse Tech Summit 2027 en Madrid. Pases Virtuales, Presenciales y VIP con acceso a talleres prácticos."
  current="tickets"
  routes={routes}
>
  <PulseTickets />
</PulseSiteLayout>

