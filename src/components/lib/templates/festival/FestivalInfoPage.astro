---
/**
 * FestivalInfoPage — Practical info: site map, getting there, gates, camping, accessibility and FAQ.
 *
 * @param {FestivalRoutes} routes - Template route URLs.
 * @param {typeof festivalData} data - Festival brand, days, stages, artists, tickets and FAQ.
 */
import FestivalSiteLayout from './FestivalSiteLayout.astro';
import FestivalVenueInfo from '../../sections/FestivalVenueInfo.astro';
import FestivalSponsors from '../../sections/FestivalSponsors.astro';
import { festivalRoutes, festivalData, type FestivalRoutes } from './data';

interface Props {
  routes?: FestivalRoutes;
  data?: typeof festivalData;
}

const { routes = festivalRoutes, data = festivalData } = Astro.props;
---

<FestivalSiteLayout
  title={`Información práctica · ${data.brand.name}`}
  description="Cómo llegar, puertas, camping, accesibilidad y preguntas frecuentes de Pulso 2027."
  current="info"
  routes={routes}
>
  <FestivalVenueInfo venue={data.venue} address={data.brand.address} faq={data.faq} headingLevel="h1" />
  <FestivalSponsors sponsors={data.sponsors} />
</FestivalSiteLayout>
