---
/**
 * FestivalSchedulePage — Timetable by day with stage filters and add-to-agenda toggles.
 *
 * @param {FestivalRoutes} routes - Template route URLs.
 * @param {typeof festivalData} data - Festival brand, days, stages, artists, tickets and FAQ.
 */
import FestivalSiteLayout from './FestivalSiteLayout.astro';
import FestivalSchedule from '../../sections/FestivalSchedule.astro';
import { festivalRoutes, festivalData, type FestivalRoutes } from './data';

interface Props {
  routes?: FestivalRoutes;
  data?: typeof festivalData;
}

const { routes = festivalRoutes, data = festivalData } = Astro.props;
---

<FestivalSiteLayout
  title={`Horarios · ${data.brand.name}`}
  description="Horarios por día y escenario de Pulso 2027. Guarda tus conciertos en tu agenda personal."
  current="schedule"
  routes={routes}
>
  <FestivalSchedule artists={data.artists} days={data.days} stages={data.stages} agendaHref={routes.myFestival} headingLevel="h1" />
</FestivalSiteLayout>
