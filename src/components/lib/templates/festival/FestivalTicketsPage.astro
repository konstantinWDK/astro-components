---
/**
 * FestivalTicketsPage — Ticket tiers with quantity, add-ons and order summary, plus the FAQ.
 *
 * @param {FestivalRoutes} routes - Template route URLs.
 * @param {typeof festivalData} data - Festival brand, days, stages, artists, tickets and FAQ.
 */
import FestivalSiteLayout from './FestivalSiteLayout.astro';
import FestivalTickets from '../../sections/FestivalTickets.astro';
import FestivalVenueInfo from '../../sections/FestivalVenueInfo.astro';
import { festivalRoutes, festivalData, type FestivalRoutes } from './data';

interface Props {
  routes?: FestivalRoutes;
  data?: typeof festivalData;
}

const { routes = festivalRoutes, data = festivalData } = Astro.props;
---

<FestivalSiteLayout
  title={`Entradas · ${data.brand.name}`}
  description="Entradas y abonos de Sonora 2027 con camping y autobús lanzadera."
  current="tickets"
  routes={routes}
>
  <FestivalTickets tickets={data.tickets} addons={data.addons} headingLevel="h1" />
  <FestivalVenueInfo venue={data.venue} address={data.brand.address} faq={data.faq} title="Dudas antes de comprar" />
</FestivalSiteLayout>
