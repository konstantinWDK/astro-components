---
/**
 * FestivalHomePage — Home of the "Sonora" festival template: hero with countdown, line-up by day, stages, tickets and sponsors.
 *
 * @param {FestivalRoutes} routes - Template route URLs.
 * @param {typeof festivalData} data - Festival brand, days, stages, artists, tickets and FAQ.
 */
import FestivalSiteLayout from './FestivalSiteLayout.astro';
import FestivalHero from '../../sections/FestivalHero.astro';
import FestivalLineup from '../../sections/FestivalLineup.astro';
import FestivalStages from '../../sections/FestivalStages.astro';
import FestivalTickets from '../../sections/FestivalTickets.astro';
import FestivalSponsors from '../../sections/FestivalSponsors.astro';
import { festivalRoutes, festivalData, type FestivalRoutes } from './data';

interface Props {
  routes?: FestivalRoutes;
  data?: typeof festivalData;
}

const { routes = festivalRoutes, data = festivalData } = Astro.props;
---

<FestivalSiteLayout
  title={`Cartel, entradas y programa · ${data.brand.name}`}
  description="Sonora 2027: 16–18 de julio junto al lago de Valencia. Cartel con más de 60 artistas, tres escenarios, horarios y entradas."
  routes={routes}
>
  <FestivalHero name={data.brand.name} tagline={data.brand.tagline} dateRange={data.dateRange} venue={data.venue} startsAt={data.startsAt} headliners={data.artists.filter((a) => a.headliner)} ticketsHref={routes.tickets} lineupHref={routes.lineup} stats={data.stats} />
  <FestivalLineup artists={data.artists} days={data.days} stages={data.stages} scheduleHref={routes.schedule} />
  <FestivalStages stages={data.stages} artists={data.artists} />
  <FestivalTickets tickets={data.tickets} addons={data.addons} title="Consigue tu abono" />
  <FestivalSponsors sponsors={data.sponsors} />
</FestivalSiteLayout>
