---
/**
 * MovingHiringPage — Backoffice driver & mover recruitment management.
 * Embeds HiringPipelineBoard with applicant screening, license checks and onboarding status.
 *
 * @param {MovingRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme. Default 'light'.
 */
import MovingLayout from './MovingLayout.astro';
import HiringPipelineBoard from '../../app/HiringPipelineBoard.astro';
import { movingRoutes, type MovingRoutes } from './data';

interface Props {
  routes?: MovingRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = movingRoutes, theme = 'light', noindex = true } = Astro.props;
---

<MovingLayout
  title="Driver & Mover Hiring Pipeline"
  routes={routes}
  current="hiring"
  theme={theme}
  noindex={noindex}
>
  <div class="hiring-page-container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Fleet Recruitment & Applicant Tracking</h1>
        <p class="page-desc">Screen van driver applicants, review vehicle ownership, and track trial shift evaluations.</p>
      </div>

      <div class="header-badges">
        <span class="active-badge">15 Open Slots in Madrid</span>
      </div>
    </div>

    <HiringPipelineBoard />
  </div>
</MovingLayout>

<style>
  .hiring-page-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-border);
  }

  @media (min-width: 768px) {
    .page-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .page-title {
    font-size: 1.45rem;
    font-weight: 800;
    margin: 0;
    color: var(--c-text);
  }

  .page-desc {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    margin: 0.2rem 0 0;
  }

  .active-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    background: rgba(37, 99, 235, 0.1);
    color: var(--c-primary);
    border-radius: var(--r-full);
    font-size: 0.78rem;
    font-weight: 700;
  }
</style>

