---
/**
 * MovingDispatchPage — Backoffice Fleet and Van Dispatch Schedule Matrix.
 * Displays vehicle telemetry, payload load percentages, driver allocation and schedule timeline.
 *
 * @param {MovingRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme. Default 'light'.
 */
import MovingLayout from './MovingLayout.astro';
import FleetDispatchTimeline from '../../app/FleetDispatchTimeline.astro';
import { movingRoutes, type MovingRoutes } from './data';

interface Props {
  routes?: MovingRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = movingRoutes, theme = 'light', noindex = true } = Astro.props;
---

<MovingLayout
  title="Fleet Dispatch Board"
  routes={routes}
  current="dispatch"
  theme={theme}
  noindex={noindex}
>
  <div class="dispatch-page-container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Fleet Dispatch & Driver Schedule</h1>
        <p class="page-desc">Allocate move orders to commercial vans, monitor payload capacity, and balance driver shifts.</p>
      </div>

      <div class="header-badges">
        <span class="live-dispatch-badge">
          <span class="pulse-indicator"></span>
          Live GPS Sync Active
        </span>
      </div>
    </div>

    <FleetDispatchTimeline />
  </div>
</MovingLayout>

<style>
  .dispatch-page-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-border);
  }

  @media (min-width: 768px) {
    .page-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .page-title {
    font-size: 1.45rem;
    font-weight: 800;
    margin: 0;
    color: var(--c-text);
  }

  .page-desc {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    margin: 0.2rem 0 0;
  }

  .live-dispatch-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--r-full);
    font-size: 0.78rem;
    font-weight: 700;
    color: #10b981;
  }

  .pulse-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
  }
</style>

