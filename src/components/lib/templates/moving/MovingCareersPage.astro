---
/**
 * MovingCareersPage — Driver, mover and logistics crew recruitment portal.
 * Features job descriptions for own-van drivers, fleet drivers, and movers,
 * and embeds the job application form.
 *
 * @param {MovingRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme. Default 'light'.
 */
import MovingSiteLayout from './MovingSiteLayout.astro';
import MovingCareersBanner from '../../sections/MovingCareersBanner.astro';
import MovingApplicationForm from '../../sections/MovingApplicationForm.astro';
import { movingRoutes, type MovingRoutes } from './data';

interface Props {
  routes?: MovingRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = movingRoutes, theme = 'light', noindex = false } = Astro.props;
---

<MovingSiteLayout
  title="Drive & Move with Muvr · Careers & Hiring"
  description="We are hiring van drivers with own vehicle, company fleet drivers, and professional furniture movers in Madrid. Top hourly pay and weekly payouts."
  routes={routes}
  current="careers"
  theme={theme}
  noindex={noindex}
>
  <MovingCareersBanner applyHref="#apply" />
  <MovingApplicationForm />
</MovingSiteLayout>

