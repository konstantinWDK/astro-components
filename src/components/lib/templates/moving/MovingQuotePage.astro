---
/**
 * MovingQuotePage — Public volume calculator and instant relocation estimate page.
 * Allows customers to select furniture items room-by-room, see their total cubic meters (m³),
 * choose elevator/stair accessibility, and receive an instant transparent price quote.
 *
 * @param {MovingRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme. Default 'light'.
 */
import MovingSiteLayout from './MovingSiteLayout.astro';
import MoveInventoryCalculator from '../../app/MoveInventoryCalculator.astro';
import { movingRoutes, type MovingRoutes } from './data';

interface Props {
  routes?: MovingRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = movingRoutes, theme = 'light', noindex = false } = Astro.props;
---

<MovingSiteLayout
  title="Instant Move & Furniture Volume Calculator"
  description="Select your furniture items room-by-room to calculate total cubic meters, required van size, and guaranteed moving quote."
  routes={routes}
  current="quote"
  theme={theme}
  noindex={noindex}
>
  <div class="quote-page-wrapper">
    <div class="page-container">
      <div class="page-intro">
        <span class="page-badge">Interactive Inventory Tool</span>
        <h1 class="page-title">Itemize Your Move & Get a Live Price</h1>
        <p class="page-desc">
          Add the furniture you need transported. Our system dynamically tallies cubic meters, calculates the optimal van, and generates an all-inclusive quote with zero surprise fees.
        </p>
      </div>

      <MoveInventoryCalculator />

      <div class="guarantees-grid">
        <div class="guarantee-card">
          <div class="g-icon">🛡️</div>
          <strong>€100,000 Transit Insurance</strong>
          <p>Every single item is insured from the moment we wrap it until it is placed in your new room.</p>
        </div>
        <div class="guarantee-card">
          <div class="g-icon">⏱️</div>
          <strong>Punctuality Guarantee</strong>
          <p>Our dispatch board tracks every vehicle in real-time. If we are late by 30+ minutes, get €30 off.</p>
        </div>
        <div class="guarantee-card">
          <div class="g-icon">🪛</div>
          <strong>Professional Toolkits</strong>
          <p>Cordless drivers, soft padding blankets, and mattress bags provided on every van run.</p>
        </div>
      </div>
    </div>
  </div>
</MovingSiteLayout>

<style>
  .quote-page-wrapper {
    padding: 3rem 1.5rem 5rem;
    background: var(--c-bg);
  }

  .page-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .page-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-primary);
    background: rgba(37, 99, 235, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: var(--r-full);
    margin-bottom: 0.65rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 900;
    margin: 0 0 0.75rem;
    color: var(--c-text);
    letter-spacing: -0.03em;
  }

  .page-desc {
    font-size: 1.05rem;
    color: var(--c-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .guarantees-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 3.5rem;
  }

  .guarantee-card {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 1.5rem;
    box-shadow: var(--muvr-card-shadow);
  }

  .g-icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .guarantee-card strong {
    display: block;
    font-size: 1rem;
    font-weight: 800;
    color: var(--c-text);
    margin-bottom: 0.35rem;
  }

  .guarantee-card p {
    font-size: 0.82rem;
    color: var(--c-text-muted);
    margin: 0;
    line-height: 1.45;
  }
</style>

