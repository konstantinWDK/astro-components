---
/**
 * MovingFleetPage — Public commercial fleet catalog and vehicle guide.
 * Highlights cargo volume, payload capacity, loading bed dimensions and equipment.
 *
 * @param {MovingRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme. Default 'light'.
 */
import MovingSiteLayout from './MovingSiteLayout.astro';
import MovingFleetGrid from '../../sections/MovingFleetGrid.astro';
import { movingRoutes, type MovingRoutes } from './data';

interface Props {
  routes?: MovingRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = movingRoutes, theme = 'light', noindex = false } = Astro.props;
---

<MovingSiteLayout
  title="Our Commercial Van & Box Truck Fleet"
  description="Explore Muvr’s clean Euro 6 van fleet: compact city vans, high-roof Sprinters, and Luton box trucks with hydraulic tail-lifts."
  routes={routes}
  current="fleet"
  theme={theme}
  noindex={noindex}
>
  <div class="fleet-page-header">
    <div class="header-content">
      <span class="header-badge">Modern Transport Equipment</span>
      <h1 class="header-title">Engineered for Safe Furniture Transport</h1>
      <p class="header-desc">
        Every vehicle in our fleet is custom-fitted with plywood interior tie rails, heavy-duty Ratchet straps, 15+ quilted furniture blankets, and low-angle aluminum ramps or 500kg hydraulic tail-lifts.
      </p>
    </div>
  </div>

  <MovingFleetGrid bookBase={routes.quote} />

  <section class="safety-specs-section">
    <div class="specs-container">
      <div class="specs-grid">
        <div class="spec-highlight">
          <span class="highlight-val">Euro 6d</span>
          <strong class="highlight-title">Low Emission Zone (ZBE) Certified</strong>
          <p>Unrestricted access to Madrid Central, restricted residential areas and underground loading docks.</p>
        </div>
        <div class="spec-highlight">
          <span class="highlight-val">500 kg</span>
          <strong class="highlight-title">Hydraulic Tail-Lift Platforms</strong>
          <p>Effortlessly load commercial fridges, grand pianos, and heavy solid-wood armoires without tilting.</p>
        </div>
        <div class="spec-highlight">
          <span class="highlight-val">100%</span>
          <strong class="highlight-title">Sanitized & Cleaned Daily</strong>
          <p>Floors swept and swept clean after every run to keep mattresses and sofas pristine.</p>
        </div>
      </div>
    </div>
  </section>
</MovingSiteLayout>

<style>
  .fleet-page-header {
    padding: 4rem 1.5rem 3rem;
    background: linear-gradient(180deg, rgba(37, 99, 235, 0.06) 0%, transparent 100%);
    text-align: center;
  }

  .header-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .header-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-primary);
    background: rgba(37, 99, 235, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: var(--r-full);
    margin-bottom: 0.65rem;
  }

  .header-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 900;
    margin: 0 0 0.85rem;
    color: var(--c-text);
    letter-spacing: -0.03em;
  }

  .header-desc {
    font-size: 1.05rem;
    color: var(--c-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .safety-specs-section {
    padding: 3.5rem 1.5rem 5rem;
    background: var(--c-surface);
  }

  .specs-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .spec-highlight {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 1.75rem;
    box-shadow: var(--muvr-card-shadow);
  }

  .highlight-val {
    display: block;
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--c-primary);
    margin-bottom: 0.35rem;
  }

  .highlight-title {
    display: block;
    font-size: 1rem;
    font-weight: 800;
    color: var(--c-text);
    margin-bottom: 0.35rem;
  }

  .spec-highlight p {
    font-size: 0.82rem;
    color: var(--c-text-muted);
    margin: 0;
    line-height: 1.45;
  }
</style>

