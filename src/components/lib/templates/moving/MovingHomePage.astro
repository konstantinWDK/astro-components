---
/**
 * MovingHomePage — Public landing page for Muvr · Moving, Logistics & Fleet Operations.
 * Embeds Hero with route estimator, housing volume calculator, commercial van fleet,
 * pricing packages, and the driver/mover hiring recruitment banner.
 *
 * @param {MovingRoutes} routes - Template route paths.
 * @param {string} theme - Initial theme. Default 'light'.
 */
import MovingSiteLayout from './MovingSiteLayout.astro';
import MovingHero from '../../sections/MovingHero.astro';
import MovingVolumeEstimator from '../../sections/MovingVolumeEstimator.astro';
import MovingFleetGrid from '../../sections/MovingFleetGrid.astro';
import MovingPricingTiers from '../../sections/MovingPricingTiers.astro';
import MovingCareersBanner from '../../sections/MovingCareersBanner.astro';
import { movingRoutes, type MovingRoutes } from './data';

interface Props {
  routes?: MovingRoutes;
  theme?: 'light' | 'dark' | 'auto';
  noindex?: boolean;
}

const { routes = movingRoutes, theme = 'light', noindex = false } = Astro.props;
---

<MovingSiteLayout
  title="Express Furniture Removals & Van Fleet"
  description="Book professional movers with modern tail-lift vans. Instant volume calculator, transparent hourly pricing and driver hiring in Madrid."
  routes={routes}
  current="home"
  theme={theme}
  noindex={noindex}
>
  <MovingHero
    quoteHref={routes.quote}
    careersHref={routes.careers}
  />

  <MovingVolumeEstimator
    quoteHref={routes.quote}
  />

  <MovingFleetGrid
    bookBase={routes.quote}
  />

  <MovingPricingTiers
    bookBase={routes.quote}
  />

  <MovingCareersBanner
    applyHref={`${routes.careers}#apply`}
  />
</MovingSiteLayout>

