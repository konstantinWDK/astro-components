---
/**
 * TheaCartPage — Cart and checkout with a ten-minute seat hold, a promo code, live totals and a demo payment.
 *
 * @param {TheaRoutes} routes - Template route URLs.
 * @param {typeof theaData} data - Shows, venues, FAQs, customer, tickets and orders.
 */
import TheaSiteLayout from './TheaSiteLayout.astro';
import TheaCart from '../../sections/TheaCart.astro';
import { theaRoutes, theaData, type TheaRoutes } from './data';

interface Props {
  routes?: TheaRoutes;
  data?: typeof theaData;
}

const { routes = theaRoutes, data = theaData } = Astro.props;
---

<TheaSiteLayout
  title={`Carrito · ${data.brand.name}`}
  description="Revisa tus entradas, aplica un código y paga antes de que se acaben los diez minutos."
  routes={routes}
>
  <TheaCart shows={data.shows} showsHref={routes.shows} ticketsHref={routes.tickets} />
</TheaSiteLayout>
