---
/**
 * TheaOrdersPage — Orders as an accordion with return and change actions (free until 48 hours before).
 *
 * @param {TheaRoutes} routes - Template route URLs.
 * @param {typeof theaData} data - Customer, tickets, orders and shows.
 */
import TheaAccountLayout from './TheaAccountLayout.astro';
import TheaAccountHeading from '../../app/TheaAccountHeading.astro';
import TheaOrders from '../../app/TheaOrders.astro';
import { theaRoutes, theaData, type TheaRoutes } from './data';

interface Props {
  routes?: TheaRoutes;
  data?: typeof theaData;
}

const { routes = theaRoutes, data = theaData } = Astro.props;
---

<TheaAccountLayout title="Pedidos" current="orders" routes={routes}>
  <TheaAccountHeading kicker="Mi cuenta" title="Mis pedidos" description="Cambia de sesión o devuelve hasta 48 horas antes." />
  <TheaOrders orders={data.orders} shows={data.shows} showsHref={routes.shows} />
</TheaAccountLayout>
