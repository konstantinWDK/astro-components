---
/**
 * TheaTicketsPage — The ticket wallet: classic tickets with a perforated stub and a code shown full screen at the door.
 *
 * @param {TheaRoutes} routes - Template route URLs.
 * @param {typeof theaData} data - Customer, tickets, orders and shows.
 */
import TheaAccountLayout from './TheaAccountLayout.astro';
import TheaAccountHeading from '../../app/TheaAccountHeading.astro';
import TheaTickets from '../../app/TheaTickets.astro';
import { theaRoutes, theaData, type TheaRoutes } from './data';

interface Props {
  routes?: TheaRoutes;
  data?: typeof theaData;
}

const { routes = theaRoutes, data = theaData } = Astro.props;
---

<TheaAccountLayout title="Mis entradas" current="tickets" routes={routes}>
  <TheaAccountHeading kicker="Mi cuenta" title="Mis entradas" description="Enséñalas desde el móvil en la puerta del teatro." />
  <TheaTickets tickets={data.tickets} shows={data.shows} />
</TheaAccountLayout>
