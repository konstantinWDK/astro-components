---
/**
 * TheaDashboardPage — Customer home: the next performance with a countdown, customer figures and suggestions.
 *
 * @param {TheaRoutes} routes - Template route URLs.
 * @param {typeof theaData} data - Customer, tickets, orders and shows.
 */
import TheaAccountLayout from './TheaAccountLayout.astro';
import TheaAccountHeading from '../../app/TheaAccountHeading.astro';
import TheaAccountSummary from '../../app/TheaAccountSummary.astro';
import { theaRoutes, theaData, type TheaRoutes } from './data';

interface Props {
  routes?: TheaRoutes;
  data?: typeof theaData;
}

const { routes = theaRoutes, data = theaData } = Astro.props;
---

<TheaAccountLayout title="Resumen" current="dashboard" routes={routes}>
  <TheaAccountHeading kicker="Mi cuenta" title="Tu próxima función" description="Cuándo es, dónde y con qué butacas." />
  <TheaAccountSummary member={data.member} tickets={data.tickets} orders={data.orders} shows={data.shows} ticketsHref={routes.tickets} showHref={routes.show} />
</TheaAccountLayout>
