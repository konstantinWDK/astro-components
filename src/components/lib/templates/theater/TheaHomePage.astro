---
/**
 * TheaHomePage — Home of the "Telón" theatre-ticket shop: a hero whose curtains part as you scroll, the title marquee, the billboard and the FAQ.
 *
 * @param {TheaRoutes} routes - Template route URLs.
 * @param {typeof theaData} data - Shows, venues, FAQs, customer, tickets and orders.
 */
import TheaSiteLayout from './TheaSiteLayout.astro';
import TheaHero from '../../sections/TheaHero.astro';
import TheaMarquee from '../../sections/TheaMarquee.astro';
import TheaShows from '../../sections/TheaShows.astro';
import TheaFaq from '../../sections/TheaFaq.astro';
import { theaRoutes, theaData, type TheaRoutes } from './data';

interface Props {
  routes?: TheaRoutes;
  data?: typeof theaData;
}

const { routes = theaRoutes, data = theaData } = Astro.props;
---

<TheaSiteLayout
  title={`${data.brand.name} · Entradas de teatro sin colas`}
  description="Elige tu butaca en el plano de la sala, págala en diez minutos y llévate la entrada en el móvil."
  routes={routes}
>
  <TheaHero shows={data.shows} stats={data.stats} showsHref={routes.shows} showHref={routes.show} />
  <TheaMarquee shows={data.shows} showHref={routes.show} />
  <TheaShows shows={data.shows.slice(0, 4)} showHref={routes.show} title="Esta semana" headingLevel="h2" />
  <TheaFaq faqs={data.faqs} />
</TheaSiteLayout>
