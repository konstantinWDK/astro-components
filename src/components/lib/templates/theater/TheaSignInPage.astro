---
/**
 * TheaSignInPage — Customer sign-in: a full-screen split with a generated show poster and the form.
 * Standalone document (no site header or footer).
 *
 * @param {TheaRoutes} routes - Template route URLs.
 * @param {string} action - Backend endpoint for the form. Empty runs a demo sign-in.
 * @param {string} theme - Initial theme ('light' | 'dark' | 'auto'). Default 'dark'.
 */
import '../../../../styles/global.css';
import './thea-theme.css';
import TheaSignIn from '../../app/TheaSignIn.astro';
import { theaRoutes, type TheaRoutes } from './data';

interface Props {
  routes?: TheaRoutes;
  action?: string;
  theme?: 'light' | 'dark' | 'auto';
}

const { routes = theaRoutes, action = '', theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang="es" class="theme-thea" data-theme={theme === 'auto' ? 'dark' : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mis entradas — Telón</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,700;0,900;1,500;1,700&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ initial: theme }}>
      (function () {
        var t = initial;
        try { t = localStorage.getItem('ack-theme') || t; } catch (e) {}
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="thea-si-body">
    <main id="main-content">
      <TheaSignIn dashboardHref={routes.dashboard} joinHref={routes.shows} homeHref={routes.home} action={action} />
    </main>
  </body>
</html>

<style>
  .thea-si-body {
    margin: 0;
    background: var(--th-bg);
    color: var(--th-text);
    font-family: var(--th-font-body);
  }
</style>
