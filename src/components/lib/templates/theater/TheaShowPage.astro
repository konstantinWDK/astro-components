---
/**
 * TheaShowPage — A show page with sessions and the interactive hall plan: pick seats, see prices by zone and add them to the cart. Reads ?show=id from the address.
 *
 * @param {TheaRoutes} routes - Template route URLs.
 * @param {typeof theaData} data - Shows, venues, FAQs, customer, tickets and orders.
 */
import TheaSiteLayout from './TheaSiteLayout.astro';
import TheaShowDetail from '../../sections/TheaShowDetail.astro';
import TheaFaq from '../../sections/TheaFaq.astro';
import { theaRoutes, theaData, type TheaRoutes } from './data';

interface Props {
  routes?: TheaRoutes;
  data?: typeof theaData;
}

const { routes = theaRoutes, data = theaData } = Astro.props;
---

<TheaSiteLayout
  title={`Elige tus butacas · ${data.brand.name}`}
  description="Elige función y butacas en el plano de la sala. Tus butacas se reservan diez minutos."
  current="show"
  routes={routes}
>
  <TheaShowDetail shows={data.shows} cartHref={routes.cart} />
  <TheaFaq faqs={data.faqs} />
</TheaSiteLayout>
