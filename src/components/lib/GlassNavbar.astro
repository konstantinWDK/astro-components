---
// src/components/lib/GlassNavbar.astro
import LogoWithGalaxy from './LogoWithGalaxy.astro';

interface Props {
  brandHref?: string;
}
const { brandHref = '/' } = Astro.props;
---

<header class="glass-nav">
  <div class="glass-nav__inner">
    <a href={brandHref} class="glass-nav__brand">
      <LogoWithGalaxy size="small" />
    </a>
    <nav class="glass-nav__links">
      <slot name="links" />
    </nav>
    <div class="glass-nav__actions">
      <slot name="actions" />
    </div>
  </div>
</header>

<style>
  .glass-nav {
    background: rgba(10, 10, 20, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
  }

  .glass-nav__inner {
    padding: 0 1.5rem;
    height: 70px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .glass-nav__brand {
    text-decoration: none;
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .glass-nav__brand:hover {
    opacity: 0.9;
  }

  .glass-nav__links {
    display: flex; align-items: center; gap: 0.25rem; flex: 1;
  }

  .glass-nav__links :global(a) {
    padding: 0.4rem 0.8rem; font-size: 0.875rem; font-weight: 500;
    color: #94a3b8; text-decoration: none; border-radius: 8px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .glass-nav__links :global(a:hover) { color: #e2e8f0; background: rgba(255,255,255,0.06); }

  .glass-nav__actions {
    display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0;
  }
</style>
