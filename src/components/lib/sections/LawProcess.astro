---
/**
 * LawProcess — "How we work" in numbered steps along a vertical line with large serif numerals.
 *
 * @param {Array<{title: string, text: string}>} steps - Process steps.
 * @param {string} title - Section heading.
 * @param {string} subtitle - Supporting text.
 * @param {string} headingLevel - 'h1' | 'h2'. Default 'h2'.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: an ordered list (<ol>) so the sequence is announced; numerals are decorative
 * (aria-hidden) because list numbering already conveys the order.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/law-firm/law-theme.css';
import { lawProcess } from '../templates/law-firm/data';

interface OwnProps {
  steps?: Array<{ title: string; text: string }>;
  title?: string;
  subtitle?: string;
  headingLevel?: 'h1' | 'h2';
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const {
  steps = lawProcess,
  title = 'Así trabajamos contigo',
  subtitle = 'Cuatro pasos, siempre por escrito y con fechas. Tú decides en cada uno.',
  headingLevel = 'h2',
  class: classAttr,
  ...rest
} = Astro.props;

const Heading = headingLevel;
const uid = `lpr-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['law-ui', 'law-process', classAttr]} aria-labelledby={`${uid}-title`} {...rest}>
  <div class="law-process__inner">
    <header class="law-process__head">
      <Heading id={`${uid}-title`} class="law-process__title">{title}</Heading>
      {subtitle && <p class="law-process__subtitle">{subtitle}</p>}
    </header>
    <ol class="law-process__list">
      {steps.map((s, i) => (
        <li class="law-step">
          <span class="law-step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="law-step__body">
            <h3 class="law-step__title">{s.title}</h3>
            <p class="law-step__text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .law-process {
    padding: var(--sp-12, 3rem) var(--sp-4, 1rem);
    background: var(--lw-bg);
    color: var(--lw-text);
    font-family: var(--lw-font-body);
  }

  .law-process__inner {
    display: grid;
    gap: var(--sp-8, 2rem);
    max-width: 1180px;
    margin: 0 auto;
  }

  .law-process__title {
    margin: 0;
    font-family: var(--lw-font-display);
    font-weight: 600;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .law-process__subtitle {
    max-width: 420px;
    margin: var(--sp-3, 0.75rem) 0 0;
    color: var(--lw-text-2);
    line-height: 1.6;
  }

  .law-process__list {
    position: relative;
    display: grid;
    gap: var(--sp-6, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .law-process__list::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 30px;
    width: 1px;
    background: linear-gradient(180deg, var(--lw-brand), transparent);
  }

  .law-step {
    position: relative;
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: var(--sp-4, 1rem);
  }

  .law-step__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border: 1px solid var(--lw-border-strong);
    border-radius: 50%;
    background: var(--lw-bg);
    color: var(--lw-brand);
    font-family: var(--lw-font-display);
    font-size: 1.6rem;
    font-weight: 600;
  }

  .law-step__title {
    margin: 6px 0 var(--sp-1, 0.25rem);
    font-family: var(--lw-font-display);
    font-size: 1.7rem;
    font-weight: 600;
  }

  .law-step__text {
    max-width: 520px;
    margin: 0;
    color: var(--lw-text-2);
    line-height: 1.6;
  }

  @media (min-width: 960px) {
    .law-process__inner {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--sp-12, 3rem);
      align-items: start;
    }
  }
</style>
