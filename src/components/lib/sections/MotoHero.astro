---
/**
 * MotoHero — Motocross-shop hero: a huge headline over slowly spreading ripples (pure CSS rings that
 * expand from three points), two buttons, the free-shipping and return promises as three figures, and
 * the categories as a big typographic list of links with the number of products in each. No
 * photography, no icons.
 *
 * @param {MotoProduct[]} products - Catalog, to count products per category.
 * @param {MotoStat[]} stats - Three key figures.
 * @param {string} title - Headline.
 * @param {string} text - Supporting paragraph.
 * @param {string} shopHref - Base link of the shop (the category is added as ?cat=).
 * @param {string} kitHref - Link of the secondary button.
 * @param {string} headingLevel - 'h1' | 'h2'. Default 'h1'.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: the ripples are decorative (aria-hidden) and stop under prefers-reduced-motion;
 * the headline and category links are real text.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/motocross/moto-theme.css';
import { motoProducts, motoStats, type MotoProduct, type MotoStat } from '../templates/motocross/data';

interface OwnProps {
  products?: MotoProduct[];
  stats?: MotoStat[];
  title?: string;
  text?: string;
  shopHref?: string;
  kitHref?: string;
  headingLevel?: 'h1' | 'h2';
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const {
  products = motoProducts,
  stats = motoStats,
  title = 'A fondo desde la salida',
  text = 'Motos puestas a punto en nuestro taller y equipación que hemos probado en pista. Sin relleno y con consejo de quien compite.',
  shopHref = '/tienda',
  kitHref = '/tu-moto',
  headingLevel = 'h1',
  class: classAttr,
  ...rest
} = Astro.props;

const Heading = headingLevel;
const uid = `fh-${Math.random().toString(36).slice(2, 8)}`;
const cats = [...new Set(products.map((p) => p.category))].map((c) => ({ name: c, n: products.filter((p) => p.category === c).length }));
---

<section class:list={['moto-ui', 'moto-hero', classAttr]} aria-labelledby={`${uid}-title`} {...rest}>
  <div class="moto-hero__rings" aria-hidden="true">
    <span style="top:12%;--w:46%;--d:0s"></span><span style="top:34%;--w:30%;--d:-1.4s"></span><span style="top:58%;--w:58%;--d:-2.6s"></span><span style="top:80%;--w:36%;--d:-0.7s"></span>
  </div>

  <div class="moto-hero__inner">
    <div>
      <p class="mt-eyebrow">Motos y equipo de cross · Madrid</p>
      <Heading id={`${uid}-title`} class="moto-hero__title">{title}</Heading>
      <p class="moto-hero__text">{text}</p>
      <div class="moto-hero__actions">
        <a class="mt-btn" href={shopHref}>Ver la tienda</a>
        <a class="mt-btn mt-btn--ghost" href={kitHref}>Compara y financia</a>
      </div>
    </div>

    <nav aria-label="Categorías" class="moto-hero__cats">
      <ul>
        {cats.map((c) => (
          <li><a href={`${shopHref}?cat=${encodeURIComponent(c.name)}`}><span>{c.name}</span><small>{c.n}</small></a></li>
        ))}
      </ul>
    </nav>
  </div>

  <dl class="moto-hero__stats">
    {stats.map((s) => (
      <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
    ))}
  </dl>
</section>

<style>
  .moto-hero {
    position: relative;
    overflow: hidden;
    padding: var(--sp-12, 3rem) var(--sp-4, 1rem) var(--sp-8, 2rem);
    background: radial-gradient(120% 80% at 100% 0%, rgba(var(--mt-brand-rgb), 0.22), transparent 55%), var(--mt-bg);
    color: var(--mt-text);
    font-family: var(--mt-font-body);
  }

  .moto-hero__rings {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .moto-hero__rings span {
    position: absolute;
    left: -60%;
    width: var(--w);
    height: 6px;
    background: linear-gradient(90deg, transparent, rgba(var(--mt-brand-rgb), 0.85));
    transform: skewX(-30deg);
    animation: moto-dash 2.6s linear infinite;
    animation-delay: var(--d);
  }

  @keyframes moto-dash {
    from { left: -60%; }
    to { left: 130%; }
  }

  .moto-hero__inner {
    position: relative;
    display: grid;
    gap: var(--sp-8, 2rem);
    max-width: 1280px;
    margin: 0 auto;
  }

  .moto-hero__title {
    margin: 0 0 var(--sp-4, 1rem);
    font-family: var(--mt-font-display);
    font-weight: 800;
    font-size: clamp(3.6rem, 13vw, 9.6rem);
    line-height: 0.84;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .moto-hero__text {
    max-width: 44ch;
    margin: 0 0 var(--sp-6, 1.5rem);
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--mt-text-2);
  }

  .moto-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3, 0.75rem);
  }

  .moto-hero__cats ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--mt-text);
  }

  .moto-hero__cats a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--mt-border);
    color: var(--mt-text);
    text-decoration: none;
    transition: padding 0.25s ease, color 0.2s ease;
  }

  .moto-hero__cats a span {
    font-family: var(--mt-font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
  }

  .moto-hero__cats a small {
    font: 500 0.9rem/1 var(--mt-font-mono);
    color: var(--mt-text-3);
  }

  .moto-hero__cats a:hover,
  .moto-hero__cats a:focus-visible {
    padding-left: 0.75rem;
    color: var(--mt-brand);
  }

  .moto-hero__stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4, 1rem);
    max-width: 1280px;
    margin: var(--sp-10, 2.5rem) auto 0;
    padding-top: var(--sp-4, 1rem);
    border-top: 1px solid var(--mt-border-strong);
  }

  .moto-hero__stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .moto-hero__stats dt {
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--mt-text-2);
  }

  .moto-hero__stats dd {
    margin: 0;
    font-family: var(--mt-font-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  @media (min-width: 900px) {
    .moto-hero {
      padding: var(--sp-16, 4rem) var(--sp-8, 2rem) var(--sp-8, 2rem);
    }

    .moto-hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: end;
    }
  }
</style>
