---
/**
 * FishShop — The catalog as a shop grid with real filtering. A text search, a category filter (radio
 * group), a maximum-price slider, an "in stock only" switch and a sort selector (featured, price, rating)
 * filter and reorder product cards live; each card draws its own generated illustration, shows brand,
 * name, rating, price (with the old price struck through when on offer) and has a "save" toggle and a
 * quick add for products without options. A counter in a live region says how many match.
 *
 * @param {FishProduct[]} products - Products to list.
 * @param {string} productHref - Base link of a product (the id is added as ?p=).
 * @param {string} title - Section heading.
 * @param {string} headingLevel - 'h1' | 'h2'. Default 'h2'.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: native search, radio, range, checkbox and select controls with labels, the results
 * counter is aria-live, each card has one link with the full product name and separate labelled
 * buttons; without JavaScript every product is listed.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/fishing/fish-theme.css';
import FishArt from '../app/FishArt.astro';
import { fishProducts, fishMoney, type FishProduct } from '../templates/fishing/data';

interface OwnProps {
  products?: FishProduct[];
  productHref?: string;
  title?: string;
  headingLevel?: 'h1' | 'h2';
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const {
  products = fishProducts,
  productHref = '/producto',
  title = 'La tienda',
  headingLevel = 'h2',
  class: classAttr,
  ...rest
} = Astro.props;

const Heading = headingLevel;
const uid = `fsh-${Math.random().toString(36).slice(2, 8)}`;
const cats = ['Todo', ...new Set(products.map((p) => p.category))];
const max = Math.ceil(Math.max(...products.map((p) => p.price)) / 10) * 10;
const fmt = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

<section class:list={['fish-ui', 'fish-shop', classAttr]} aria-labelledby={`${uid}-title`} data-fish-shop data-max={max} {...rest}>
  <div class="fish-shop__inner">
    <header class="fish-shop__head">
      <p class="fs-eyebrow">Catálogo</p>
      <Heading id={`${uid}-title`} class="fish-shop__title">{title}</Heading>
    </header>

    <div class="fish-shop__layout">
      <form class="fish-shop__filters" onsubmit="return false" aria-label="Filtros">
        <div class="fish-shop__field">
          <label for={`${uid}-q`}>Buscar</label>
          <input id={`${uid}-q`} type="search" placeholder="caña, minnow, trenzado…" data-q />
        </div>

        <fieldset class="fish-shop__cats">
          <legend>Categoría</legend>
          {cats.map((c, i) => (
            <label>
              <input type="radio" name={`${uid}-c`} value={c} checked={i === 0} />
              <span>{c}</span>
            </label>
          ))}
        </fieldset>

        <div class="fish-shop__field">
          <label for={`${uid}-p`}>Precio máximo <output data-out>{max} €</output></label>
          <input id={`${uid}-p`} type="range" min="5" max={max} step="5" value={max} data-price />
        </div>

        <label class="fish-shop__switch"><input type="checkbox" data-stock /><span>Solo con stock</span></label>

        <div class="fish-shop__field">
          <label for={`${uid}-s`}>Ordenar por</label>
          <select id={`${uid}-s`} data-sort>
            <option value="featured">Destacados</option>
            <option value="price-asc">Precio: de menor a mayor</option>
            <option value="price-desc">Precio: de mayor a menor</option>
            <option value="rating">Mejor valorados</option>
          </select>
        </div>
      </form>

      <div>
        <p class="fish-shop__count" aria-live="polite" data-count>{products.length} productos</p>
        <ul class="fish-shop__grid" data-grid>
          {products.map((p, i) => (
            <li data-cat={p.category} data-price={p.price} data-rating={p.rating} data-stock={p.stock} data-order={i} data-text={`${p.name} ${p.brand} ${p.category} ${p.text}`.toLowerCase()}>
              <article class="fish-card">
                <a href={`${productHref}?p=${p.id}`} class="fish-card__link" aria-label={`${p.name}, ${fishMoney(p.price)}`}>
                  <span class="fish-card__art"><FishArt item={p} decorative /></span>
                  <span class="fish-card__brand">{p.brand}</span>
                  <strong>{p.name}</strong>
                </a>
                <p class="fish-card__rate">{fmt(p.rating)} de 5 · {p.reviews} opiniones</p>
                <p class="fish-card__price">
                  <b>{fishMoney(p.price)}</b>
                  {p.oldPrice && <s>{fishMoney(p.oldPrice)}</s>}
                  {p.oldPrice && <em>−{Math.round((1 - p.price / p.oldPrice) * 100)} %</em>}
                </p>
                <p class="fish-card__stock">{p.stock > 10 ? 'En stock' : p.stock > 0 ? `Quedan ${p.stock}` : 'Agotado'}</p>
                <div class="fish-card__acts">
                  {p.options.length === 0 ? (
                    <button type="button" class="fs-btn" data-add={p.id} aria-label={`Añadir ${p.name} al carrito`}>Añadir</button>
                  ) : (
                    <a class="fs-btn" href={`${productHref}?p=${p.id}`} aria-label={`Elegir opciones de ${p.name}`}>Elegir opciones</a>
                  )}
                  <button type="button" class="fs-btn fs-btn--ghost" data-wish={p.id} aria-pressed="false" aria-label={`Guardar ${p.name} en deseos`}>Guardar</button>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <p class="fish-shop__none" data-none hidden>Ningún producto coincide con esos filtros.</p>
        <p class="fish-shop__live" role="status" aria-live="polite" data-live></p>
      </div>
    </div>
  </div>
</section>

<style>
  .fish-shop {
    padding: var(--sp-12, 3rem) var(--sp-4, 1rem) var(--sp-16, 4rem);
    background: var(--fs-bg);
    color: var(--fs-text);
    font-family: var(--fs-font-body);
  }

  .fish-shop [hidden] {
    display: none !important;
  }

  .fish-shop__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .fish-shop__title {
    margin: 0 0 var(--sp-6, 1.5rem);
    font-family: var(--fs-font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .fish-shop__layout {
    display: grid;
    gap: var(--sp-6, 1.5rem);
  }

  .fish-shop__filters {
    display: grid;
    gap: var(--sp-4, 1rem);
    align-content: start;
    padding: var(--sp-4, 1rem);
    border: 1px solid var(--fs-border);
    border-radius: 16px;
    background: var(--fs-bg-raised);
  }

  .fish-shop__filters label:not(.fish-shop__switch),
  .fish-shop__filters legend {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
    padding: 0;
    font: 600 0.74rem/1.2 var(--fs-font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fs-text-2);
  }

  .fish-shop__filters output {
    color: var(--fs-brand);
  }

  .fish-shop__field input[type='search'],
  .fish-shop__field select {
    width: 100%;
    min-height: 48px;
    padding: 0 1rem;
    box-sizing: border-box;
    border: 1.5px solid var(--fs-border-strong);
    border-radius: 12px;
    background: var(--fs-surface);
    color: var(--fs-text);
    font: 400 1rem var(--fs-font-body);
  }

  .fish-shop__field input[type='range'] {
    width: 100%;
    height: 44px;
    margin: 0;
    accent-color: var(--fs-brand);
    cursor: pointer;
  }

  .fish-shop__filters fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .fish-shop__cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2, 0.5rem);
  }

  .fish-shop__cats legend {
    width: 100%;
  }

  .fish-shop__cats input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .fish-shop__cats span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1.5px solid var(--fs-border-strong);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .fish-shop__cats input:checked + span {
    background: var(--fs-brand);
    border-color: var(--fs-brand);
    color: var(--fs-on-brand);
  }

  .fish-shop__cats input:focus-visible + span {
    outline: 2px solid var(--fs-accent);
    outline-offset: 3px;
  }

  .fish-shop__switch {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .fish-shop__switch input {
    width: 22px;
    height: 22px;
    accent-color: var(--fs-brand);
  }

  .fish-shop__count {
    margin: 0 0 var(--sp-4, 1rem);
    font-size: 0.88rem;
    color: var(--fs-text-3);
  }

  .fish-shop__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fish-card {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    align-content: start;
    padding: var(--sp-3, 0.75rem);
    border: 1px solid var(--fs-border);
    border-radius: 16px;
    background: var(--fs-bg-raised);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .fish-card:hover,
  .fish-card:focus-within {
    border-color: var(--fs-brand);
    transform: translateY(-3px);
  }

  .fish-card__link {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .fish-card__art {
    display: block;
    margin-bottom: 0.3rem;
    border-radius: 12px;
    background: var(--fs-surface);
  }

  .fish-card__brand {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fs-accent);
  }

  .fish-card__link strong {
    font-family: var(--fs-font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .fish-card__rate,
  .fish-card__stock {
    margin: 0;
    font-size: 0.8rem;
    color: var(--fs-text-3);
  }

  .fish-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0.2rem 0;
  }

  .fish-card__price b {
    font-family: var(--fs-font-display);
    font-size: 1.35rem;
  }

  .fish-card__price s {
    font-size: 0.85rem;
    color: var(--fs-text-3);
  }

  .fish-card__price em {
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 700;
    color: var(--fs-ok);
  }

  .fish-card__acts {
    display: grid;
    gap: var(--sp-2, 0.5rem);
    margin-top: 0.3rem;
  }

  .fish-card__acts .fs-btn {
    min-height: 44px;
    padding: 0 0.8rem;
    font-size: 0.88rem;
  }

  .fish-card__acts .fs-btn[aria-pressed='true'] {
    border-color: var(--fs-accent);
    color: var(--fs-accent);
  }

  .fish-shop__none {
    color: var(--fs-text-3);
  }

  .fish-shop__live {
    min-height: 1.4em;
    margin: var(--sp-3, 0.75rem) 0 0;
    color: var(--fs-ok);
    font-size: 0.9rem;
  }

  @media (min-width: 700px) {
    .fish-shop__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .fish-shop {
      padding-inline: var(--sp-8, 2rem);
    }

    .fish-shop__layout {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: var(--sp-8, 2rem);
      align-items: start;
    }

    .fish-shop__filters {
      position: sticky;
      top: 90px;
    }
  }
</style>

<script>
  const CART = 'fish-cart';
  const WISH = 'fish-wish';
  const read = (k: string): any[] => { try { return JSON.parse(localStorage.getItem(k) ?? '[]'); } catch { return []; } };
  const write = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* ignore */ } };

  document.querySelectorAll<HTMLElement>('[data-fish-shop]').forEach((root) => {
    const q = root.querySelector<HTMLInputElement>('[data-q]');
    const price = root.querySelector<HTMLInputElement>('[data-price]');
    const stock = root.querySelector<HTMLInputElement>('[data-stock]');
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]');
    const out = root.querySelector<HTMLElement>('[data-out]');
    const radios = [...root.querySelectorAll<HTMLInputElement>('.fish-shop__cats input')];
    const grid = root.querySelector<HTMLElement>('[data-grid]');
    const items = grid ? ([...grid.children] as HTMLElement[]) : [];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const none = root.querySelector<HTMLElement>('[data-none]');
    const live = root.querySelector<HTMLElement>('[data-live]');
    if (!q || !price || !stock || !sort || !grid) return;

    const apply = () => {
      const c = radios.find((r) => r.checked)?.value ?? 'Todo';
      const term = q.value.trim().toLowerCase();
      const max = Number(price.value);
      let n = 0;
      if (out) out.textContent = `${max} €`;
      items.forEach((li) => {
        const ok = (c === 'Todo' || li.dataset.cat === c) && Number(li.dataset.price) <= max && (!stock.checked || Number(li.dataset.stock) > 0) && (!term || (li.dataset.text ?? '').includes(term));
        li.hidden = !ok;
        if (ok) n += 1;
      });
      const k = sort.value;
      [...items].sort((a, b) =>
        k === 'price-asc' ? Number(a.dataset.price) - Number(b.dataset.price)
        : k === 'price-desc' ? Number(b.dataset.price) - Number(a.dataset.price)
        : k === 'rating' ? Number(b.dataset.rating) - Number(a.dataset.rating)
        : Number(a.dataset.order) - Number(b.dataset.order),
      ).forEach((li) => grid.append(li));
      if (count) count.textContent = `${n} ${n === 1 ? 'producto' : 'productos'}`;
      if (none) none.hidden = n > 0;
    };
    const initial = new URLSearchParams(location.search).get('cat');
    const first = radios.find((r) => r.value === initial);
    if (first) first.checked = true;
    [q, price, stock, sort].forEach((el) => el.addEventListener('input', apply));
    radios.forEach((r) => r.addEventListener('change', apply));
    apply();

    const wish = read(WISH) as string[];
    root.querySelectorAll<HTMLButtonElement>('[data-wish]').forEach((b) => {
      const on = wish.includes(b.dataset.wish ?? '');
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? 'Guardado' : 'Guardar';
    });
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const w = t.closest<HTMLButtonElement>('[data-wish]');
      const a = t.closest<HTMLButtonElement>('[data-add]');
      if (w) {
        const id = w.dataset.wish ?? '';
        let list = read(WISH) as string[];
        const on = list.includes(id);
        list = on ? list.filter((x) => x !== id) : [...list, id];
        write(WISH, list);
        w.setAttribute('aria-pressed', String(!on));
        w.textContent = on ? 'Guardar' : 'Guardado';
        if (live) live.textContent = on ? 'Quitado de tu lista de deseos.' : 'Guardado en tu lista de deseos.';
      } else if (a) {
        const id = a.dataset.add ?? '';
        const lines = read(CART) as Array<{ productId: string; qty: number; options: Record<string, string> }>;
        const ex = lines.find((l) => l.productId === id && !Object.keys(l.options).length);
        if (ex) ex.qty += 1; else lines.push({ productId: id, qty: 1, options: {} });
        write(CART, lines);
        document.querySelectorAll('[data-cart-count]').forEach((el) => { el.textContent = String(lines.reduce((s, l) => s + l.qty, 0)); });
        if (live) live.textContent = 'Añadido al carrito.';
      }
    });
  });
</script>
