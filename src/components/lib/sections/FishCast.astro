---
/**
 * FishCast — A scroll-driven scene that plays like a short film as you scroll. A pinned stage shows a
 * river at dawn: the sky and sun change from first light to full day, the rod swings back and
 * forward, the line flies in an arc and draws itself, the float lands and ripples spread, and a fish
 * takes the bait with a splash. Four captions light up in turn (choose, rig, cast, wait). Everything
 * is SVG driven by the scroll progress written to the section on every animation frame. Without
 * JavaScript, or with reduced motion, the scene shows its final frame and the captions are a list.
 *
 * @param {Array<{title: string, text: string}>} steps - Four captions, in order.
 * @param {string} title - Section heading.
 * @param {string} headingLevel - 'h1' | 'h2'. Default 'h2'.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: the SVG is decorative (aria-hidden), the four steps are a real ordered list that is
 * always readable, motion respects prefers-reduced-motion and the scene never traps scrolling.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/fishing/fish-theme.css';

interface OwnProps {
  steps?: Array<{ title: string; text: string }>;
  title?: string;
  headingLevel?: 'h1' | 'h2';
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const {
  steps = [
    { title: 'Elige la caña', text: 'Larga para lanzar lejos, corta para el río cerrado. Mira el peso de lanzado antes que el precio.' },
    { title: 'Monta el señuelo', text: 'Un nudo limpio y un bajo de línea de la medida del pez. Lo que cuelgas decide si pica.' },
    { title: 'Lanza con el codo', text: 'La caña hace el trabajo: sube a las doce, baja a las dos y suelta la línea sin tirar.' },
    { title: 'Espera el pique', text: 'Cuando el corcho se hunde no tires: deja que el pez coja el anzuelo y clava firme.' },
  ],
  title = 'Un lanzado, de la caña al pique',
  headingLevel = 'h2',
  class: classAttr,
  ...rest
} = Astro.props;

const Heading = headingLevel;
const uid = `fc-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['fish-ui', 'fish-cast', classAttr]} aria-labelledby={`${uid}-title`} data-fish-cast {...rest}>
  <div class="fish-cast__sticky">
    <div class="fish-cast__head">
      <p class="fs-eyebrow">Cómo se hace</p>
      <Heading id={`${uid}-title`} class="fish-cast__title">{title}</Heading>
    </div>

    <svg class="fish-cast__svg" viewBox="0 0 800 450" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" data-top stop-color="#243b55"></stop>
          <stop offset="1" data-bottom stop-color="#f0a96b"></stop>
        </linearGradient>
        <linearGradient id={`${uid}-water`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2b6f86"></stop>
          <stop offset="1" stop-color="#0c2f3b"></stop>
        </linearGradient>
      </defs>
      <rect width="800" height="320" fill={`url(#${uid}-sky)`}></rect>
      <circle data-sun cx="560" cy="300" r="36" fill="#ffe9a8" opacity="0.95"></circle>
      <polygon points="0,320 120,230 230,290 360,200 500,290 640,220 800,300 800,330 0,330" fill="#1e3a3a" opacity="0.8"></polygon>
      <polygon points="0,330 160,270 300,320 460,262 640,318 800,276 800,340 0,340" fill="#14302f"></polygon>
      <rect y="316" width="800" height="134" fill={`url(#${uid}-water)`}></rect>
      <g data-waves opacity="0.5">
        <path class="fish-cast__wave" d="M-40 350 q 40 -10 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0" fill="none" stroke="#bfe6ee" stroke-width="1.6"></path>
        <path class="fish-cast__wave is-b" d="M-40 385 q 50 -12 100 0 t 100 0 t 100 0 t 100 0 t 100 0 t 100 0 t 100 0 t 100 0 t 100 0" fill="none" stroke="#bfe6ee" stroke-width="1.4"></path>
        <path class="fish-cast__wave is-c" d="M-40 420 q 60 -12 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0" fill="none" stroke="#bfe6ee" stroke-width="1.2"></path>
      </g>

      <!-- bank and angler's rod -->
      <polygon points="0,330 0,450 210,450 170,368 110,342" fill="#0f2422"></polygon>
      <path data-rod d="M70 360 C 90 300 120 250 150 200" fill="none" stroke="#e8d9a0" stroke-width="5" stroke-linecap="round"></path>
      <line x1="64" y1="366" x2="84" y2="338" stroke="#c9a46a" stroke-width="10" stroke-linecap="round"></line>

      <!-- line, float, ripples and fish -->
      <path data-line d="M150 200 Q 360 20 560 330" fill="none" stroke="#eaf7f5" stroke-width="1.6" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"></path>
      <g data-ripples opacity="0">
        <ellipse class="fish-cast__ripple" cx="560" cy="334" rx="14" ry="4" fill="none" stroke="#e8f6f8" stroke-width="1.5"></ellipse>
        <ellipse class="fish-cast__ripple is-b" cx="560" cy="334" rx="14" ry="4" fill="none" stroke="#e8f6f8" stroke-width="1.5"></ellipse>
        <ellipse class="fish-cast__ripple is-c" cx="560" cy="334" rx="14" ry="4" fill="none" stroke="#e8f6f8" stroke-width="1.5"></ellipse>
      </g>
      <g data-float transform="translate(150 200)">
        <circle r="7" cy="-3" fill="#ff6b3d"></circle>
        <rect x="-7" y="0" width="14" height="7" rx="3" fill="#f6f1e3"></rect>
        <line x1="0" y1="-10" x2="0" y2="-18" stroke="#ff6b3d" stroke-width="2"></line>
      </g>
      <g data-fish opacity="0" transform="translate(560 330)">
        <path d="M-34 0 C -18 -16 18 -16 34 -2 L 50 -14 L 50 14 L 34 2 C 18 16 -18 16 -34 0 Z" fill="#d7e6e9"></path>
        <circle cx="-22" cy="-3" r="2.4" fill="#0c2f3b"></circle>
      </g>
      <g data-drops opacity="0" fill="#e8f6f8">
        <circle cx="530" cy="300" r="3"></circle><circle cx="548" cy="282" r="2.4"></circle><circle cx="578" cy="286" r="3"></circle><circle cx="596" cy="306" r="2.2"></circle>
      </g>
    </svg>

    <ol class="fish-cast__steps">
      {steps.map((s, i) => (
        <li data-step={i}>
          <span class="fish-cast__no">{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{s.title}</h3><p>{s.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .fish-cast {
    position: relative;
    background: var(--fs-bg);
    color: var(--fs-text);
    font-family: var(--fs-font-body);
    border-block: 1px solid var(--fs-border);
  }

  .fish-cast.is-live {
    height: 330vh;
  }

  .fish-cast__sticky {
    display: grid;
    gap: var(--sp-5, 1.25rem);
    padding: var(--sp-10, 2.5rem) var(--sp-4, 1rem);
    max-width: 1240px;
    margin: 0 auto;
  }

  .fish-cast.is-live .fish-cast__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    align-content: center;
  }

  .fish-cast__title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--fs-font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .fish-cast__svg {
    width: 100%;
    height: min(46vh, 520px);
    border-radius: 18px;
    border: 1px solid var(--fs-border-strong);
    background: #0c2f3b;
  }

  .fish-cast__wave {
    animation: fish-wave 9s linear infinite;
  }

  .fish-cast__wave.is-b { animation-duration: 13s; animation-direction: reverse; }
  .fish-cast__wave.is-c { animation-duration: 17s; }

  @keyframes fish-wave {
    to { transform: translateX(-80px); }
  }

  .fish-cast__ripple {
    transform-origin: 560px 334px;
    animation: fish-ripple 2.6s ease-out infinite;
  }

  .fish-cast__ripple.is-b { animation-delay: 0.85s; }
  .fish-cast__ripple.is-c { animation-delay: 1.7s; }

  @keyframes fish-ripple {
    from { transform: scale(0.4); opacity: 0.9; }
    to { transform: scale(4.6); opacity: 0; }
  }

  .fish-cast__steps {
    display: grid;
    gap: var(--sp-3, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fish-cast__steps li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-left: 3px solid var(--fs-border-strong);
    transition: border-color 0.3s ease, background 0.3s ease, opacity 0.3s ease;
  }

  .fish-cast.is-live .fish-cast__steps li {
    opacity: 0.45;
  }

  .fish-cast__steps li.is-on {
    border-left-color: var(--fs-brand);
    background: rgba(var(--fs-brand-rgb), 0.1);
    opacity: 1;
  }

  .fish-cast__no {
    font: 700 0.9rem/1.6 var(--fs-font-mono);
    color: var(--fs-accent);
  }

  .fish-cast__steps h3 {
    margin: 0 0 0.2rem;
    font-family: var(--fs-font-display);
    font-weight: 700;
    font-size: 1.25rem;
  }

  .fish-cast__steps p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--fs-text-2);
  }

  @media (max-width: 899px) {
    .fish-cast.is-live .fish-cast__steps li:not(.is-on) {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .fish-cast__sticky {
      padding-inline: var(--sp-8, 2rem);
    }

    .fish-cast__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--sp-4, 1rem);
    }

    .fish-cast__steps li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fish-cast__wave,
    .fish-cast__ripple {
      animation: none;
    }
  }
</style>

<script>
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const mix = (a: string, b: string, t: number) => `rgb(${hex(a).map((v, i) => Math.round(lerp(v, hex(b)[i], t))).join(',')})`;
  const clamp = (n: number) => Math.min(1, Math.max(0, n));

  document.querySelectorAll<HTMLElement>('[data-fish-cast]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const svg = q<SVGSVGElement>('.fish-cast__svg');
    const top = q<SVGStopElement>('[data-top]');
    const bottom = q<SVGStopElement>('[data-bottom]');
    const sun = q<SVGCircleElement>('[data-sun]');
    const rod = q<SVGPathElement>('[data-rod]');
    const line = q<SVGPathElement>('[data-line]');
    const float = q<SVGGElement>('[data-float]');
    const ripples = q<SVGGElement>('[data-ripples]');
    const fish = q<SVGGElement>('[data-fish]');
    const drops = q<SVGGElement>('[data-drops]');
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    if (!svg || !line) return;

    // the line path is fixed: from the rod tip to the landing spot
    const len = line.getTotalLength();
    const paint = (p: number) => {
      const day = clamp(p * 1.2);
      top.setAttribute('stop-color', mix('#243b55', '#5aa9d6', day));
      bottom.setAttribute('stop-color', mix('#f0a96b', '#cfe9f2', day));
      sun.setAttribute('cy', String(lerp(300, 110, clamp(p * 1.1))));
      sun.setAttribute('cx', String(lerp(560, 600, p)));

      // rod: back (0.15–0.3), forward (0.3–0.45), relaxed after
      const back = clamp((p - 0.12) / 0.18);
      const fwd = clamp((p - 0.3) / 0.16);
      const tipX = lerp(lerp(150, 92, back), 214, fwd);
      const tipY = lerp(lerp(200, 190, back), 214, fwd);
      rod.setAttribute('d', `M70 360 C ${lerp(90, 76, back)} 300 ${lerp(120, 98, back)} 250 ${tipX} ${tipY}`);

      // line flies 0.42–0.72
      const fly = clamp((p - 0.42) / 0.3);
      line.setAttribute('d', `M${tipX} ${tipY} Q 360 ${lerp(20, 10, fly)} 560 330`);
      line.setAttribute('stroke-dashoffset', String(1 - fly));
      const pt = line.getPointAtLength(len * 0.001 + fly * (line.getTotalLength() - len * 0.001));
      const landed = p > 0.72;
      const bite = clamp((p - 0.88) / 0.1);
      const bob = landed ? Math.sin(p * 120) * 1.6 + bite * 9 : 0;
      const fx = fly > 0 ? pt.x : tipX;
      const fy = fly > 0 ? pt.y : tipY;
      float.setAttribute('transform', `translate(${fx} ${landed ? 330 + bob : fy})`);
      ripples.setAttribute('opacity', landed ? '1' : '0');
      const splash = p > 0.9;
      fish.setAttribute('opacity', splash ? '1' : '0');
      fish.setAttribute('transform', `translate(${lerp(560, 600, clamp((p - 0.9) / 0.1))} ${lerp(332, 270, Math.sin(clamp((p - 0.9) / 0.1) * Math.PI))}) rotate(${lerp(-20, 25, clamp((p - 0.9) / 0.1))})`);
      drops.setAttribute('opacity', splash ? String(1 - clamp((p - 0.96) / 0.04)) : '0');

      const active = Math.min(steps.length - 1, Math.floor(p * steps.length * 0.999));
      steps.forEach((s, i) => s.classList.toggle('is-on', i === active));
    };

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { paint(1); steps.forEach((s) => s.classList.add('is-on')); return; }
    root.classList.add('is-live');
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      paint(total > 0 ? clamp(-r.top / total) : 1);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  });
</script>
