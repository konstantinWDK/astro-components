---
/**
 * DentalBeforeAfter — Interactive smile transformation gallery with before/after case studies.
 * Highlights Invisalign alignment, porcelain veneers, and implant restorations with case metrics.
 *
 * @param {string} title - Heading.
 * @param {string} subtitle - Subtitle.
 * @param {string} className - Optional container CSS class.
 */
interface SmileCase {
  id: string;
  treatment: string;
  duration: string;
  doctor: string;
  description: string;
  shadeImprovement: string;
  beforeStats: string;
  afterStats: string;
  quote: string;
}

const cases: SmileCase[] = [
  {
    id: 'case-1',
    treatment: 'Handcrafted Porcelain Veneers (8 Upper Teeth)',
    duration: '2 appointments (3 weeks)',
    doctor: 'Dr. Adrián Ramos, DDS',
    description: 'Correction of severe enamel wear, midline misalignment and irregular tooth contouring.',
    shadeImprovement: 'From A3.5 to BL2 Natural Luster Bleach',
    beforeStats: 'Heavy wear & tetracycline discoloration',
    afterStats: 'Symmetrical, youthful Golden Proportion smile',
    quote: '“I stopped hiding my smile in photos for the first time in 15 years. The process was completely painless!”',
  },
  {
    id: 'case-2',
    treatment: 'Comprehensive Invisalign Clear Aligners',
    duration: '11 months (22 aligner trays)',
    doctor: 'Dr. Elena Silva, DDS',
    description: 'Correction of severe lower incisor crowding and deep overbite without extractions.',
    shadeImprovement: 'Class I Ideal Bite Alignment',
    beforeStats: 'Moderate-severe anterior crowding',
    afterStats: 'Perfect dental arch harmony and stable occlusion',
    quote: '“Nobody even noticed I was wearing aligners at work. The 3D iTero simulation on day 1 came out exact.”',
  },
  {
    id: 'case-3',
    treatment: 'Single Central Incisor Guided Implant & Zirconia Crown',
    duration: '3 months full osseointegration',
    doctor: 'Dr. Adrián Ramos, DDS',
    description: 'Post-trauma tooth loss restored with guided surgical placement and custom ceramic emergence profile.',
    shadeImprovement: '100% Optical Match to Adjacent Natural Tooth',
    beforeStats: 'Missing upper central incisor #9',
    afterStats: 'Permanent titanium fixture & lifelike porcelain',
    quote: '“It feels and bites exactly like my real tooth did. I can eat apples again with zero fear.”',
  },
];

interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  title = 'Real Smile Transformations',
  subtitle = 'Clinical precision meets aesthetic artistry. Explore real patient outcomes from our Madrid clinic.',
  className = '',
} = Astro.props;
---

<section class={`dental-before-after ${className}`}>
  <div class="cases-container">
    <div class="section-head">
      <span class="section-badge">Proven Results</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-desc">{subtitle}</p>
    </div>

    <div class="cases-grid">
      {cases.map((c) => (
        <div class="case-card" data-case-id={c.id}>
          <!-- Case Visual Transformation Display -->
          <div class="transformation-box">
            <div class="state-side state-side--before">
              <span class="state-pill state-pill--before">BEFORE</span>
              <div class="state-graphic">
                <svg viewBox="0 0 100 60" class="smile-svg" width="100%" height="90">
                  <!-- Abstract before smile curve with misaligned teeth -->
                  <path d="M 15 25 Q 50 35 85 25" stroke="#94a3b8" stroke-width="3" fill="none" />
                  <rect x="22" y="16" width="10" height="15" rx="2" fill="#cbd5e1" transform="rotate(-6 27 23)" />
                  <rect x="35" y="18" width="12" height="17" rx="2" fill="#e2e8f0" transform="rotate(4 41 26)" />
                  <rect x="52" y="17" width="12" height="17" rx="2" fill="#cbd5e1" transform="rotate(-3 58 25)" />
                  <rect x="67" y="16" width="10" height="15" rx="2" fill="#e2e8f0" transform="rotate(8 72 23)" />
                </svg>
              </div>
              <p class="state-caption">{c.beforeStats}</p>
            </div>

            <div class="state-divider">
              <span class="versus-icon">VS</span>
            </div>

            <div class="state-side state-side--after">
              <span class="state-pill state-pill--after">AFTER</span>
              <div class="state-graphic">
                <svg viewBox="0 0 100 60" class="smile-svg" width="100%" height="90">
                  <!-- Abstract after smile curve with radiant alignment -->
                  <path d="M 15 20 Q 50 42 85 20" stroke="#0284c7" stroke-width="3" fill="none" />
                  <rect x="22" y="12" width="11" height="18" rx="3" fill="#ffffff" stroke="#38bdf8" stroke-width="1.5" />
                  <rect x="36" y="10" width="13" height="21" rx="3" fill="#ffffff" stroke="#38bdf8" stroke-width="1.5" />
                  <rect x="51" y="10" width="13" height="21" rx="3" fill="#ffffff" stroke="#38bdf8" stroke-width="1.5" />
                  <rect x="66" y="12" width="11" height="18" rx="3" fill="#ffffff" stroke="#38bdf8" stroke-width="1.5" />
                </svg>
              </div>
              <p class="state-caption">{c.afterStats}</p>
            </div>
          </div>

          <!-- Case Details -->
          <div class="case-body">
            <div class="case-top-meta">
              <span class="case-doctor">{c.doctor}</span>
              <span class="case-duration">{c.duration}</span>
            </div>

            <h3 class="case-title">{c.treatment}</h3>
            <p class="case-desc">{c.description}</p>

            <div class="shade-badge">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
              <span>{c.shadeImprovement}</span>
            </div>

            <blockquote class="patient-quote">
              {c.quote}
            </blockquote>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .dental-before-after {
    padding: 5rem 1.5rem;
    background: var(--c-bg-subtle);
  }

  .cases-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--c-text-2);
    margin: 0;
  }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .case-card {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--dental-shadow-md);
    display: flex;
    flex-direction: column;
  }

  .transformation-box {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    background: rgba(var(--ink-rgb), 0.03);
    border-bottom: 1px solid var(--c-border);
    padding: 1.5rem 1rem;
    align-items: center;
  }

  .state-side {
    text-align: center;
  }

  .state-pill {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }

  .state-pill--before {
    background: rgba(148, 163, 184, 0.2);
    color: var(--c-text-3);
  }

  .state-pill--after {
    background: rgba(2, 132, 199, 0.15);
    color: var(--c-primary);
  }

  .smile-svg {
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.06));
  }

  .state-caption {
    margin: 6px 0 0;
    font-size: 0.74rem;
    color: var(--c-text-3);
    line-height: 1.3;
  }

  .state-divider {
    padding: 0 6px;
  }

  .versus-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--c-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--c-text-3);
  }

  .case-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .case-top-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--c-text-3);
    margin-bottom: 0.5rem;
  }

  .case-doctor {
    font-weight: 600;
    color: var(--c-primary);
  }

  .case-title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--c-text-1);
    line-height: 1.35;
  }

  .case-desc {
    font-size: 0.88rem;
    color: var(--c-text-2);
    line-height: 1.5;
    margin: 0 0 1rem;
  }

  .shade-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--r-md);
    padding: 6px 10px;
    font-size: 0.8rem;
    color: var(--c-accent);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .patient-quote {
    margin: auto 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--c-text-2);
    line-height: 1.5;
  }
</style>

