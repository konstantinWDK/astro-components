---
/**
 * FoodDeliveryHero — Above-the-fold landing hero for food delivery apps, restaurant platforms and ghost kitchens.
 * Features an instant delivery address finder, live prep-time promise (25 min ETA),
 * dietary category shortcut pills, and floating chef recommendation card.
 *
 * @param {string} title - Main headline.
 * @param {string} subtitle - Subtitle copy.
 * @param {string} etaMinutes - Guaranteed delivery time in minutes.
 * @param {string} promoCode - First order promotional coupon code.
 * @param {string} menuHref - Link to full catalog / menu.
 * @param {string} trackHref - Link to live order tracking.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  etaMinutes?: number;
  promoCode?: string;
  menuHref?: string;
  trackHref?: string;
  className?: string;
}

const {
  title = 'Artisan food delivered to your door in 25 minutes, sizzling hot.',
  subtitle = 'Craft smash burgers, wood-fired sourdough pizzas, and wholesome bowls cooked on-demand by local culinary masters.',
  etaMinutes = 25,
  promoCode = 'BITEFLOW',
  menuHref = '/preview/food-delivery/menu',
  trackHref = '/preview/food-delivery/track',
  className = '',
} = Astro.props;
---

<section class={`food-hero ${className}`}>
  <div class="food-hero__container">
    <!-- Live Dispatch Banner -->
    <div class="food-hero__banner">
      <div class="food-hero__pulse">
        <span class="pulse-dot"></span>
        <span class="pulse-text">Kitchen active · Average dispatch <strong>{etaMinutes} min</strong> in central zone</span>
      </div>
      <div class="food-hero__promo">
        <span class="promo-label">Code:</span>
        <code class="promo-code">{promoCode}</code>
        <span class="promo-benefit">Free delivery on 1st order</span>
      </div>
    </div>

    <div class="food-hero__grid">
      <!-- Left Column: Copy & Address Input -->
      <div class="food-hero__content">
        <div class="food-hero__pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
          </svg>
          <span>Fastest delivery in town · 100% eco-friendly e-bikes</span>
        </div>

        <h1 class="food-hero__title">{title}</h1>
        <p class="food-hero__subtitle">{subtitle}</p>

        <!-- Address Search Box -->
        <form class="food-hero__search-box" action={menuHref} method="get">
          <div class="search-input-wrap">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <input
              type="text"
              name="address"
              placeholder="Enter delivery street & number (e.g. Gran Vía 42)"
              aria-label="Delivery address"
              required
            />
          </div>
          <button type="submit" class="search-submit-btn">
            <span>Find Food</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </form>

        <!-- Quick category suggestions -->
        <div class="food-hero__quick-tags">
          <span class="quick-tags-label">Popular now:</span>
          <a href={`${menuHref}?cat=burgers`} class="tag-pill">🔥 Smash Burgers</a>
          <a href={`${menuHref}?cat=pizza`} class="tag-pill">🍕 Wood-Fired Pizza</a>
          <a href={`${menuHref}?cat=bowls`} class="tag-pill">🥗 Superfood Bowls</a>
          <a href={`${menuHref}?diet=vegan`} class="tag-pill">🌱 100% Vegan</a>
        </div>

        <!-- Trust Stats -->
        <div class="food-hero__metrics">
          <div class="metric-item">
            <span class="metric-val">4.9 / 5</span>
            <span class="metric-sub">⭐ 14,200+ reviews</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-val">&lt; 25 min</span>
            <span class="metric-sub">⚡ Real-time GPS tracking</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-val">100% Hot</span>
            <span class="metric-sub">🛡️ Thermal bag guarantee</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Showcase & Active Order Teaser -->
      <div class="food-hero__visual">
        <div class="dish-showcase-card">
          <div class="dish-badge-strip">
            <span class="badge-tag chef-pick">👨‍🍳 Chef Recommendation</span>
            <span class="badge-time">Prep: 9 min</span>
          </div>

          <div class="dish-illustration">
            <div class="dish-art">
              <span class="art-emoji">🍔</span>
              <div class="smoke-ring smoke-1"></div>
              <div class="smoke-ring smoke-2"></div>
            </div>
            <div class="dietary-tags">
              <span class="diet-chip halal">HALAL</span>
              <span class="diet-chip spice">MEDIUM SPICE</span>
            </div>
          </div>

          <div class="dish-details">
            <div class="dish-headline">
              <h2 class="dish-name">Truffle Smash Double Cheeseburger</h2>
              <span class="dish-price">13.90 €</span>
            </div>
            <p class="dish-blurb">Dry-aged smash patties, melted vintage cheddar, caramelized shallots & black truffle aioli.</p>
            <div class="dish-card-actions">
              <a href={`${menuHref}#dish-01`} class="order-direct-btn">Customize & Add</a>
              <a href={trackHref} class="live-track-link">Track existing order →</a>
            </div>
          </div>

          <!-- Floating Courier Rider Pill -->
          <div class="floating-rider-card">
            <div class="rider-avatar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="18.5" cy="17.5" r="3.5"/>
                <circle cx="5.5" cy="17.5" r="3.5"/>
                <circle cx="15" cy="5" r="1"/>
                <path d="M12 17.5V14l-3-3 4-3 2 3h2"/>
              </svg>
            </div>
            <div class="rider-info">
              <span class="rider-title">Courier Nearby</span>
              <span class="rider-sub">E-Bike Rider Leo · 4 min to pickup</span>
            </div>
            <div class="rider-badge-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .food-hero {
    position: relative;
    padding: 3rem 1.5rem 4.5rem;
    background: radial-gradient(circle at 10% 20%, rgba(234, 88, 12, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 90% 70%, rgba(22, 163, 74, 0.05) 0%, transparent 40%),
                var(--c-bg, #0b0f19);
    color: var(--c-text, #f8fafc);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .food-hero__container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .food-hero__banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.6rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    backdrop-filter: blur(12px);
  }

  .food-hero__pulse {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.82rem;
    color: #e2e8f0;
  }

  .pulse-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 12px #16a34a;
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .food-hero__promo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .promo-code {
    padding: 0.15rem 0.5rem;
    background: rgba(234, 88, 12, 0.15);
    border: 1px dashed rgba(234, 88, 12, 0.4);
    border-radius: 4px;
    color: #f97316;
    font-weight: 700;
    font-family: monospace;
    letter-spacing: 0.05em;
  }

  .food-hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .food-hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .food-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .food-hero__pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(234, 88, 12, 0.12);
    border: 1px solid rgba(234, 88, 12, 0.3);
    border-radius: 9999px;
    color: #fb923c;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .food-hero__title {
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .food-hero__subtitle {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
    max-width: 580px;
  }

  .food-hero__search-box {
    display: flex;
    gap: 0.6rem;
    padding: 0.4rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 600px) {
    .food-hero__search-box {
      flex-direction: column;
    }
  }

  .search-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-left: 0.85rem;
  }

  .search-icon {
    color: #ea580c;
    flex-shrink: 0;
  }

  .search-input-wrap input {
    width: 100%;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 0.95rem;
    outline: none;
    padding: 0.6rem 0;
  }

  .search-input-wrap input::placeholder {
    color: #64748b;
  }

  .search-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.6rem;
    background: linear-gradient(135deg, #ea580c, #c2410c);
    color: #ffffff;
    border: none;
    border-radius: 9px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(234, 88, 12, 0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .search-submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(234, 88, 12, 0.5);
  }

  .food-hero__quick-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .quick-tags-label {
    font-size: 0.82rem;
    color: #64748b;
  }

  .tag-pill {
    padding: 0.3rem 0.7rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9999px;
    font-size: 0.8rem;
    color: #cbd5e1;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .tag-pill:hover {
    background: rgba(234, 88, 12, 0.15);
    border-color: rgba(234, 88, 12, 0.35);
    color: #ffffff;
  }

  .food-hero__metrics {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-val {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .metric-sub {
    font-size: 0.78rem;
    color: #94a3b8;
  }

  .metric-divider {
    width: 1px;
    height: 28px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Right column dish card */
  .food-hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .dish-showcase-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(16px);
  }

  .dish-badge-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .chef-pick {
    padding: 0.25rem 0.65rem;
    background: rgba(234, 88, 12, 0.2);
    border: 1px solid rgba(234, 88, 12, 0.4);
    border-radius: 9999px;
    color: #ea580c;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .badge-time {
    font-size: 0.78rem;
    color: #94a3b8;
  }

  .dish-illustration {
    position: relative;
    height: 180px;
    background: radial-gradient(circle, rgba(234, 88, 12, 0.12) 0%, transparent 70%);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .dish-art {
    position: relative;
    font-size: 5rem;
    filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.5));
    animation: hoverFloat 3.5s ease-in-out infinite;
  }

  @keyframes hoverFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .dietary-tags {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.35rem;
  }

  .diet-chip {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .diet-chip.halal {
    background: rgba(22, 163, 74, 0.2);
    color: #4ade80;
    border: 1px solid rgba(22, 163, 74, 0.4);
  }

  .diet-chip.spice {
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  .dish-headline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  .dish-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .dish-price {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ea580c;
  }

  .dish-blurb {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0 0 1.25rem 0;
  }

  .dish-card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .order-direct-btn {
    padding: 0.65rem 1.25rem;
    background: #ea580c;
    color: #ffffff;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 700;
    transition: background 0.15s ease;
  }

  .order-direct-btn:hover {
    background: #c2410c;
  }

  .live-track-link {
    font-size: 0.82rem;
    color: #94a3b8;
    text-decoration: none;
  }

  .live-track-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Floating rider card */
  .floating-rider-card {
    position: absolute;
    bottom: -18px;
    left: -20px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    animation: riderFloat 4s ease-in-out infinite alternate;
  }

  @keyframes riderFloat {
    0% { transform: translateY(0); }
    100% { transform: translateY(-6px); }
  }

  .rider-avatar {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(22, 163, 74, 0.2);
    color: #22c55e;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rider-info {
    display: flex;
    flex-direction: column;
  }

  .rider-title {
    font-size: 0.76rem;
    font-weight: 700;
    color: #ffffff;
  }

  .rider-sub {
    font-size: 0.7rem;
    color: #94a3b8;
  }

  .rider-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }
</style>

