---
/**
 * DevArticle — Blog post layout for developer portfolios ("Keycap" design): back link, meta line,
 * title, lead, tags, a reading-progress bar and monochrome prose styles for headings, lists, quotes
 * and code blocks, followed by previous / next article keys.
 *
 * @param {string} title - Post title (h1).
 * @param {string} excerpt - Lead paragraph.
 * @param {string} date - ISO date (YYYY-MM-DD).
 * @param {string} category - Category.
 * @param {string} readingTime - e.g. "6 min".
 * @param {string} author - Optional author name.
 * @param {string[]} tags - Tags.
 * @param {string} html - Trusted HTML body. Alternatively pass the body in the default slot.
 * @param {{label: string, href: string}} back - Back link. Default 'All articles' → '/blog/'.
 * @param {{title: string, href: string}} prev - Previous article.
 * @param {{title: string, href: string}} next - Next article.
 * @param {string} locale - Date locale. Default 'en-US'.
 * @param {string} className - Extra class.
 *
 * Accessibility: article landmark with one h1; the progress bar is decorative (aria-hidden);
 * code blocks scroll horizontally and are focusable; pager is a labelled nav.
 */
interface Props {
  title?: string;
  excerpt?: string;
  date?: string;
  category?: string;
  readingTime?: string;
  author?: string;
  tags?: string[];
  html?: string;
  back?: { label: string; href: string };
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
  locale?: string;
  className?: string;
}

const {
  title = 'Damped springs instead of per-frame tweens',
  excerpt = 'Why calling a tween library every frame makes a 3D slider feel rubbery, and the one-line function that fixes it.',
  date = '2026-09-14',
  category = 'animation',
  readingTime = '5 min',
  author,
  tags = ['animation', 'javascript'],
  html = Astro.slots.has('default') ? undefined : '<p>Compute where each card <em>should</em> be and move it a fraction of the way every frame:</p><pre><code>const damp = (a, b, k, dt) =&gt; a + (b - a) * (1 - Math.exp(-k * dt));</code></pre><h2>Continuous layouts</h2><p>Smoothstep between the centre and its neighbours, and the card no longer jumps when it crosses the middle.</p>',
  back = { label: 'All articles', href: '/blog/' }, prev, next, locale = 'en-US', className = '' } = Astro.props;
const formatted = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
---

<article class:list={['dvar', className]} data-dev-article>
  <div class="dvar__progress" aria-hidden="true"><span data-progress></span></div>
  <header class="dvar__head">
    <a class="dvar__back" href={back.href}>← {back.label}</a>
    <p class="dvar__meta">
      <time datetime={date}>{formatted}</time>
      {author && <><span aria-hidden="true">•</span><span>{author}</span></>}
      {category && <><span aria-hidden="true">•</span><span>/{category}</span></>}
      {readingTime && <><span aria-hidden="true">•</span><span>{readingTime}</span></>}
    </p>
    <h1 class="dvar__title">{title}</h1>
    {excerpt && <p class="dvar__lead">{excerpt}</p>}
    {tags.length > 0 && <ul class="dvar__tags">{tags.map((t) => <li>#{t}</li>)}</ul>}
  </header>

  <div class="dvar__prose" data-prose>
    {html ? <Fragment set:html={html} /> : <slot />}
  </div>

  {(prev || next) && (
    <nav class="dvar__pager" aria-label="More articles">
      {prev ? <a href={prev.href} rel="prev"><span>← Previous</span><strong>{prev.title}</strong></a> : <span></span>}
      {next && <a class="dvar__next" href={next.href} rel="next"><span>Next →</span><strong>{next.title}</strong></a>}
    </nav>
  )}
</article>

<style>
  .dvar { max-width: 760px; margin: 0 auto; padding: clamp(7rem, 14vw, 9rem) clamp(1rem, 3vw, 1.5rem) clamp(3rem, 7vw, 5rem); color: var(--c-text-1); }
  .dvar__progress { position: fixed; inset: 0 0 auto; z-index: 950; height: 3px; pointer-events: none; }
  .dvar__progress span { display: block; height: 100%; width: 100%; background: var(--c-text-1); transform-origin: 0 50%; transform: scaleX(0); }
  .dvar__back { display: inline-flex; align-items: center; min-height: 36px; margin-bottom: 1.5rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--c-text-2); text-decoration: none; }
  .dvar__back:hover { color: var(--c-text-1); }
  .dvar__meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--c-text-3); }
  .dvar__title { margin: 0 0 1rem; font-size: clamp(2rem, 5vw, 3.1rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.05; }
  .dvar__lead { margin: 0 0 1.25rem; font-size: 1.15rem; line-height: 1.65; color: var(--c-text-2); }
  .dvar__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 2rem; padding: 0 0 2rem; list-style: none; border-bottom: 1.5px solid var(--c-text-1); }
  .dvar__tags li { padding: 0.2rem 0.55rem; border: 1px solid var(--c-border); border-radius: 2px; font-family: var(--font-mono); font-size: 0.7rem; color: var(--c-text-2); }

  .dvar__prose { font-size: 1.05rem; line-height: 1.8; color: var(--c-text-2); }
  .dvar__prose :global(> * + *) { margin-top: 1.25rem; }
  .dvar__prose :global(h2) { margin-top: 2.5rem; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; color: var(--c-text-1); }
  .dvar__prose :global(h3) { margin-top: 2rem; font-size: 1.2rem; font-weight: 700; color: var(--c-text-1); }
  .dvar__prose :global(p) { margin-bottom: 0; }
  .dvar__prose :global(a) { color: var(--c-text-1); text-decoration: underline; text-underline-offset: 3px; }
  .dvar__prose :global(strong) { color: var(--c-text-1); }
  .dvar__prose :global(ul), .dvar__prose :global(ol) { padding-left: 1.25rem; }
  .dvar__prose :global(li + li) { margin-top: 0.4rem; }
  .dvar__prose :global(li::marker) { color: var(--c-text-1); }
  .dvar__prose :global(blockquote) { margin-left: 0; padding: 0.25rem 0 0.25rem 1.25rem; border-left: 3px solid var(--c-text-1); font-style: italic; color: var(--c-text-1); }
  .dvar__prose :global(:not(pre) > code) { padding: 0.12rem 0.38rem; border-radius: 3px; background: rgb(var(--ink-rgb, 0 0 0) / 0.06); font-family: var(--font-mono); font-size: 0.88em; color: var(--c-text-1); }
  .dvar__prose :global(pre) { overflow-x: auto; padding: 1.1rem 1.25rem; border: 1.5px solid var(--c-text-1); border-radius: 4px; background: var(--c-text-1); color: var(--c-bg); box-shadow: 4px 4px 0 rgb(var(--ink-rgb, 0 0 0) / 0.18); font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.6; }
  .dvar__prose :global(pre:focus-visible) { outline: 2px solid var(--c-text-1); outline-offset: 3px; }
  .dvar__prose :global(img) { max-width: 100%; height: auto; border-radius: 4px; }
  .dvar__prose :global(hr) { border: 0; height: 1px; background: var(--c-border); margin: 2.5rem 0; }

  .dvar__pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3.5rem; padding-top: 2rem; border-top: 1.5px solid var(--c-text-1); }
  .dvar__pager a { display: flex; flex-direction: column; gap: 0.3rem; padding: 1rem 1.1rem; border: 1.5px solid var(--c-text-1); border-radius: 4px; color: var(--c-text-1); text-decoration: none; box-shadow: 0 4px 0 var(--c-text-1); transition: transform 0.18s ease, box-shadow 0.18s ease; }
  .dvar__pager a:hover { transform: translateY(2px); box-shadow: 0 2px 0 var(--c-text-1); }
  .dvar__pager span { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-text-3); }
  .dvar__pager strong { font-size: 1rem; line-height: 1.35; }
  .dvar__next { grid-column: 2; text-align: right; }
  .dvar :focus-visible { outline: 2px solid var(--c-text-1); outline-offset: 3px; }
  @media (max-width: 560px) { .dvar__pager { grid-template-columns: 1fr; } .dvar__next { grid-column: auto; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-dev-article]:not([data-bound])').forEach((root) => {
    root.dataset.bound = '';
    root.querySelectorAll<HTMLElement>('[data-prose] pre').forEach((pre) => pre.setAttribute('tabindex', '0'));
    const bar = root.querySelector<HTMLElement>('[data-progress]');
    if (!bar) return;
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = root.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    update();
  });
</script>
