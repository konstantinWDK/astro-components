---
/**
 * MovingHero — Above-the-fold landing hero for moving, removals and van transport services.
 * Features an instant route-quote calculation form (origin, destination, move size),
 * trust metrics (cargo transit insurance, 4.9 customer rating), and express same-day van dispatch badge.
 *
 * @param {string} title - Main headline.
 * @param {string} subtitle - Subtitle copy.
 * @param {string} quoteHref - URL for the full quote calculator.
 * @param {string} careersHref - URL for the driver/mover hiring portal.
 * @param {string} emergencyPhone - Express telephone booking number.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  quoteHref?: string;
  careersHref?: string;
  emergencyPhone?: string;
  className?: string;
}

const {
  title = 'Stress-Free Furniture Removals & Express Van Transport.',
  subtitle = 'Professional movers, hydraulic tail-lift vans, and instant transparent pricing. From a single sofa to full 4-bedroom home relocations.',
  quoteHref = '/preview/moving/quote',
  careersHref = '/preview/moving/careers',
  emergencyPhone = '+34 910 882 400',
  className = '',
} = Astro.props;
---

<section class={`moving-hero ${className}`}>
  <div class="moving-hero__container">
    <!-- Same-day Express Dispatch Strip -->
    <div class="dispatch-notice-strip">
      <div class="dispatch-badge">
        <span class="live-dot"></span>
        <span>Express Van Dispatch Active · Same-day slots available in Madrid & surrounding areas</span>
      </div>
      <a href={`tel:${emergencyPhone}`} class="phone-link">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>
        </svg>
        <span>Call {emergencyPhone}</span>
      </a>
    </div>

    <div class="moving-hero__grid">
      <!-- Left Column: Copy & Value Proposition -->
      <div class="moving-hero__content">
        <div class="rating-strip">
          <span class="stars">★★★★★</span>
          <span class="rating-text"><strong>4.9 / 5</strong> from 1,280+ verified house & office moves</span>
        </div>

        <h1 class="moving-hero__title">{title}</h1>
        <p class="moving-hero__subtitle">{subtitle}</p>

        <!-- Trust Badges -->
        <div class="trust-pill-list">
          <div class="trust-pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
            </svg>
            <span>€100,000 Cargo Transit Insurance</span>
          </div>
          <div class="trust-pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><path d="m10 15 5-3-5-3v6z"/>
            </svg>
            <span>Real-time GPS Tracking</span>
          </div>
          <div class="trust-pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
            <span>Fixed Quote · No Hidden Stair Fees</span>
          </div>
        </div>

        <!-- Secondary CTA: Careers -->
        <div class="careers-teaser">
          <span>Are you a van owner or furniture mover?</span>
          <a href={careersHref} class="careers-link">We are hiring drivers & movers →</a>
        </div>
      </div>

      <!-- Right Column: Quick Route & Move Quote Card -->
      <div class="moving-hero__widget">
        <div class="quick-quote-card">
          <div class="quote-card-header">
            <span class="quote-tag">Instant Estimate</span>
            <h3 class="quote-card-title">Get Your Move Price in 30 Seconds</h3>
            <p class="quote-card-desc">No home visit required. Choose your route and size.</p>
          </div>

          <form class="quote-form" action={quoteHref} method="GET">
            <div class="form-group">
              <label for="hero-origin" class="form-label">
                <span class="dot-origin"></span>
                Pickup Address / City
              </label>
              <input
                type="text"
                id="hero-origin"
                name="origin"
                class="form-input"
                placeholder="e.g. Madrid, Calle Alcalá 45"
                required
              />
            </div>

            <div class="form-group">
              <label for="hero-dest" class="form-label">
                <span class="dot-dest"></span>
                Delivery Address / City
              </label>
              <input
                type="text"
                id="hero-dest"
                name="dest"
                class="form-input"
                placeholder="e.g. Pozuelo de Alarcón, Av. Europa"
                required
              />
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label for="hero-size" class="form-label">Move Size</label>
                <select id="hero-size" name="size" class="form-select">
                  <option value="single">Single Item / Sofa</option>
                  <option value="room">1 Room / Studio (6 m³)</option>
                  <option value="flat-1" selected>1-2 Bed Flat (14 m³)</option>
                  <option value="house-3">3-4 Bed House (20-35 m³)</option>
                  <option value="office">Commercial / Office</option>
                </select>
              </div>

              <div class="form-group">
                <label for="hero-date" class="form-label">Target Date</label>
                <input
                  type="date"
                  id="hero-date"
                  name="date"
                  class="form-input"
                />
              </div>
            </div>

            <button type="submit" class="submit-btn">
              <span>Calculate My Move & View Vans</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </form>

          <div class="quote-footer">
            <span>Guaranteed fixed rate after item inventory. No spam calls.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .moving-hero {
    background: linear-gradient(180deg, rgba(37, 99, 235, 0.04) 0%, transparent 100%);
    padding: 3rem 1.5rem 4rem;
    position: relative;
    border-bottom: 1px solid var(--c-border);
  }

  .moving-hero__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Dispatch notice */
  .dispatch-notice-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-full);
    margin-bottom: 2.5rem;
    box-shadow: var(--muvr-card-shadow);
  }

  .dispatch-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-text);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-accent);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .phone-link:hover {
    color: var(--muvr-orange-hover);
  }

  /* Main Grid */
  .moving-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .moving-hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }

  /* Left Column */
  .moving-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rating-strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--c-text-muted);
  }

  .stars {
    color: #f59e0b;
    letter-spacing: 2px;
  }

  .moving-hero__title {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--c-text);
    margin: 0;
  }

  .moving-hero__subtitle {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--c-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .trust-pill-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-text);
  }

  .trust-pill svg {
    color: var(--c-primary);
    flex-shrink: 0;
  }

  .careers-teaser {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--c-text-muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--c-border);
  }

  .careers-link {
    font-weight: 700;
    color: var(--c-primary);
    text-decoration: none;
  }

  .careers-link:hover {
    text-decoration: underline;
  }

  /* Right Column: Quick Quote Card */
  .quick-quote-card {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 1.75rem;
    box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.08);
  }

  .quote-card-header {
    margin-bottom: 1.25rem;
  }

  .quote-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--c-accent);
    letter-spacing: 0.05em;
    background: rgba(234, 88, 12, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }

  .quote-card-title {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
    color: var(--c-text);
  }

  .quote-card-desc {
    font-size: 0.82rem;
    color: var(--c-text-muted);
    margin: 0;
  }

  .quote-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--c-text);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dot-origin {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2563eb;
  }

  .dot-dest {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ea580c;
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface);
    color: var(--c-text);
    font-size: 0.88rem;
    outline: none;
    transition: all 0.15s ease;
    box-sizing: border-box;
  }

  .form-input:focus,
  .form-select:focus {
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    background: var(--c-accent);
    color: #ffffff;
    border: none;
    border-radius: var(--r-md);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 0.35rem;
  }

  .submit-btn:hover {
    background: var(--muvr-orange-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(234, 88, 12, 0.3);
  }

  .quote-footer {
    margin-top: 0.85rem;
    font-size: 0.72rem;
    color: var(--c-text-muted);
    text-align: center;
  }
</style>

