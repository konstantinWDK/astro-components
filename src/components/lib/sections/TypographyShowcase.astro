---
// TypographyShowcase.astro — Premium typography section with live preview
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Typography", subtitle = "Headings and text patterns." } = Astro.props;
---

<section class="typography-showcase">
  <div class="container">
    <div class="showcase-header">
      <span class="showcase-eyebrow">✍️ Typography</span>
      <h2 class="showcase-title">{title}</h2>
      <p class="showcase-subtitle">{subtitle}</p>
    </div>

    <div class="preview-stage">
      <div class="preview-stage__inner">
        <div class="typo-stack">
          <!-- Gradient Heading Mockup -->
          <div class="typo-mockup typo-mockup--gradient">
            <h3 class="gradient-heading">Premium Design System</h3>
          </div>

          <!-- Blockquote Mockup -->
          <div class="typo-mockup typo-mockup--blockquote">
            <blockquote class="blockquote">
              <p>Great design is invisible. It simply feels right.</p>
              <cite>— Design Philosophy</cite>
            </blockquote>
          </div>

          <!-- Animated Text Reveal Mockup -->
          <div class="typo-mockup typo-mockup--reveal">
            <span class="text-reveal">Shimmer Reveal Effect</span>
          </div>

          <!-- Link Styles Mockup -->
          <div class="typo-mockup typo-mockup--links">
            <div class="link-group">
              <a href="#" class="styled-link">Hover Underline</a>
              <a href="#" class="styled-link">Animated Link</a>
              <a href="#" class="styled-link">Gold Accent</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="usage-code">
      <code>&lt;Typography variant="heading" size="xl"&gt;Premium Design&lt;/Typography&gt;</code>
    </div>
  </div>
</section>

<style>
  .typography-showcase {
    padding: var(--sp-16) 0;
    position: relative;
  }
  .showcase-header {
    text-align: center;
    margin-bottom: var(--sp-10);
  }
  .showcase-eyebrow {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-primary-light);
    background: rgba(184,134,11,0.1);
    border: 1px solid rgba(184,134,11,0.25);
    border-radius: var(--r-full);
    margin-bottom: var(--sp-4);
  }
  .showcase-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--c-text-1);
    margin-bottom: var(--sp-3);
  }
  .showcase-subtitle {
    font-size: 1.05rem;
    color: var(--c-text-2);
    max-width: 500px;
    margin: 0 auto;
  }

  /* Preview Stage */
  .preview-stage {
    padding: var(--sp-12);
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-xl);
    margin-bottom: var(--sp-6);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  .preview-stage__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }
  .typo-stack {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
    width: 100%;
    max-width: 600px;
  }

  /* Typography Mockups */
  .typo-mockup {
    padding: var(--sp-6);
    background: rgba(255,255,255,0.02);
    border-radius: var(--r-md);
    border: 1px solid rgba(255,255,255,0.05);
  }

  /* Gradient Heading */
  .gradient-heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    font-family: var(--font-sans);
    margin: 0;
    background: linear-gradient(135deg, var(--c-primary-light), var(--c-primary), #d4a017);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  /* Blockquote */
  .blockquote {
    margin: 0;
    padding-left: var(--sp-5);
    border-left: 3px solid var(--c-primary);
    font-family: var(--font-sans);
  }
  .blockquote p {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--c-text-1);
    margin: 0 0 var(--sp-2) 0;
    line-height: 1.6;
  }
  .blockquote cite {
    font-size: 0.85rem;
    font-style: normal;
    color: var(--c-text-2);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Animated Text Reveal */
  .text-reveal {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    font-family: var(--font-sans);
    background: linear-gradient(
      110deg,
      var(--c-text-1) 0%,
      var(--c-text-1) 40%,
      var(--c-primary-light) 50%,
      var(--c-text-1) 60%,
      var(--c-text-1) 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: textShimmer 3.5s linear infinite;
  }
  @keyframes textShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Link Styles */
  .link-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: center;
  }
  .styled-link {
    font-size: 1rem;
    font-weight: 500;
    font-family: var(--font-sans);
    color: var(--c-text-1);
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
    transition: color 0.25s ease;
  }
  .styled-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--c-primary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s ease;
  }
  .styled-link:hover {
    color: var(--c-primary-light);
  }
  .styled-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .usage-code {
    text-align: center;
    padding: var(--sp-4);
    background: rgba(255,255,255,0.02);
    border-radius: var(--r-md);
  }
  .usage-code code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-primary-light);
  }

  @media (max-width: 640px) {
    .typo-stack { gap: var(--sp-5); }
    .typo-mockup { padding: var(--sp-4); }
    .preview-stage { padding: var(--sp-8) var(--sp-4); }
    .link-group { flex-direction: column; align-items: flex-start; gap: var(--sp-3); }
  }
</style>
