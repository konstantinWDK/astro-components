---
/**
 * ToyCharacterHero — Character profile header for a toy store: breadcrumb, comic panel with the
 * character art, hero / villain stamp and a speech-bubble quote; universe eyebrow, name (h1), alias,
 * bio, power meters, facts (debut, figures) and CTAs to shop that character.
 *
 * @param {object} character - `{ name, alias?, icon?, hue?, faction?, universe?, bio?, quote?, powers?: {label, value}[], debut? }`.
 * @param {Array<{label: string, href?: string}>} breadcrumbs - Trail; the last item is the current page.
 * @param {number} count - Number of products for this character (shown as a fact).
 * @param {{label: string, href: string}} primary - Main CTA. Default jumps to #figures.
 * @param {{label: string, href: string}} secondary - Secondary CTA (optional).
 * @param {number} maxPower - Scale of the power meters. Default 10.
 * @param {string} variant - Panel style (comic|soft). Default 'comic'.
 * @param {string} size - Vertical rhythm (sm|md|lg). Default 'md'.
 * @param {string} className - Extra class.
 *
 * Accessibility: one h1; meters are native <meter> elements with visible labels and values; the
 * panel art is decorative; the faction is written in text, not only colour.
 */
import { productIcon } from '../ecommerce/product-icons';

interface CharacterInfo {
  name: string;
  alias?: string;
  icon?: string;
  hue?: number;
  faction?: 'hero' | 'villain';
  universe?: string;
  bio?: string;
  quote?: string;
  powers?: Array<{ label: string; value: number }>;
  debut?: string;
}

interface Props {
  character?: CharacterInfo;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  count?: number;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  maxPower?: number;
  variant?: 'comic' | 'soft';
  size?: 'sm' | 'md' | 'lg';
  className?: string;
}

const {
  character = {
    name: 'Kira Blaze',
    alias: 'Fire-blade ninja',
    icon: 'ninja',
    hue: 12,
    faction: 'hero',
    universe: 'Shadow Clan',
    bio: 'The youngest master of the Ember Dojo, Kira fights with a blade that glows hotter the braver she feels. She never misses training — or dessert.',
    quote: 'Fear is just fuel.',
    debut: 'Shadow Clan · 2022',
    powers: [{ label: 'Strength', value: 6 }, { label: 'Speed', value: 10 }, { label: 'Stealth', value: 8 }, { label: 'Focus', value: 9 }],
  },
  breadcrumbs = [{ label: 'Home', href: '#' }, { label: 'Characters', href: '#' }, { label: 'Kira Blaze' }],
  count = 3,
  primary = { label: 'Shop her figures', href: '#figures' },
  secondary,
  maxPower = 10,
  variant = 'comic',
  size = 'md',
  className = '',
} = Astro.props;

const villain = character.faction === 'villain';
---

<section class:list={['tch', `tch--${variant}`, `tch--${size}`, className]} style={`--ch-hue: ${character.hue ?? 12}`} aria-labelledby="tch-name">
  {breadcrumbs.length > 0 && (
    <nav class="tch__crumbs" aria-label="Breadcrumb">
      <ol>
        {breadcrumbs.map((b, i) => (
          <li>{b.href && i < breadcrumbs.length - 1 ? <a href={b.href}>{b.label}</a> : <span aria-current="page">{b.label}</span>}</li>
        ))}
      </ol>
    </nav>
  )}

  <div class="tch__inner">
    <div class="tch__panel">
      <div class="tch__art" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={productIcon(character.icon ?? 'figure')} /></svg>
      </div>
      {character.faction && (
        <span class:list={['tch__stamp', { 'tch__stamp--villain': villain }]}>{villain ? 'Villain' : 'Hero'}</span>
      )}
      {character.quote && (
        <blockquote class="tch__bubble">
          <p>{character.quote}</p>
        </blockquote>
      )}
    </div>

    <div class="tch__info">
      {character.universe && <p class="tch__universe">{character.universe}</p>}
      <h1 class="tch__name" id="tch-name">{character.name}</h1>
      {character.alias && <p class="tch__alias">{character.alias}</p>}
      {character.bio && <p class="tch__bio">{character.bio}</p>}

      {character.powers && character.powers.length > 0 && (
        <div class="tch__powers">
          <h2 class="tch__powers-title">Power levels</h2>
          <ul>
            {character.powers.map((p, i) => (
              <li>
                <label for={`tch-power-${i}`}>{p.label}</label>
                <meter id={`tch-power-${i}`} min="0" max={maxPower} value={p.value}>{p.value} / {maxPower}</meter>
                <span class="tch__power-value">{p.value}<span class="tch__power-max">/{maxPower}</span></span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {(character.debut || count !== undefined) && (
        <dl class="tch__facts">
          {character.debut && <div><dt>First appearance</dt><dd>{character.debut}</dd></div>}
          {count !== undefined && <div><dt>In the toy box</dt><dd>{count} {count === 1 ? 'product' : 'products'}</dd></div>}
        </dl>
      )}

      <div class="tch__ctas">
        {primary && <a class="tch__btn tch__btn--primary" href={primary.href}>{primary.label}</a>}
        {secondary && <a class="tch__btn" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .tch {
    --tch-edge: var(--toy-edge, var(--c-text-1, #17121f));
    --tch-drop: var(--toy-drop, var(--tch-edge));
    container-type: inline-size;
    padding-block: var(--sp-6, 1.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .tch--sm { padding-bottom: var(--sp-8, 2rem); }
  .tch--lg { padding-bottom: clamp(3.5rem, 8vw, 6rem); }

  .tch__crumbs ol { display: flex; flex-wrap: wrap; gap: var(--sp-2, 0.5rem); margin: 0 0 var(--sp-6, 1.5rem); padding: 0; list-style: none; font-size: 0.85rem; }
  .tch__crumbs li { display: flex; align-items: center; gap: var(--sp-2, 0.5rem); color: var(--c-text-2, #a3a3a3); }
  .tch__crumbs li + li::before { content: '/'; opacity: 0.5; }
  .tch__crumbs a { color: var(--c-text-2, #a3a3a3); }
  .tch__crumbs a:hover { color: var(--c-text-1, #fff); }
  .tch__crumbs [aria-current='page'] { color: var(--c-text-1, #fff); font-weight: 700; }

  .tch__inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }

  .tch__panel { position: relative; padding: 0 var(--sp-4, 1rem) var(--sp-4, 1rem) 0; }
  .tch__art {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 3.5px solid var(--tch-edge);
    border-radius: var(--r-xl, 28px);
    background:
      radial-gradient(rgb(0 0 0 / 0.15) 1.6px, transparent 2.2px) 0 0 / 12px 12px,
      repeating-conic-gradient(from 0deg at 50% 50%, hsl(var(--ch-hue) 95% 66%) 0deg 10deg, hsl(var(--ch-hue) 90% 58%) 10deg 20deg);
    box-shadow: 10px 10px 0 var(--tch-drop);
    color: var(--toy-art-ink, #17121f);
    transform: rotate(-1.5deg);
  }
  .tch--soft .tch__art { border-width: 0; box-shadow: none; transform: none; }
  .tch__art svg { width: 64%; height: auto; filter: drop-shadow(6px 6px 0 rgb(0 0 0 / 0.16)); }

  .tch__stamp {
    position: absolute;
    top: 6%;
    left: -2%;
    padding: 0.35rem 1rem;
    border: 3px solid #17121f;
    border-radius: 8px;
    background: #fff;
    color: #17121f;
    box-shadow: 4px 4px 0 #17121f;
    font-family: var(--font-display, inherit);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(-8deg);
  }
  .tch__stamp--villain { background: #17121f; color: #ff8a95; box-shadow: 4px 4px 0 #ff5c6c; }

  .tch__bubble {
    position: absolute;
    right: 0;
    bottom: 10%;
    max-width: 62%;
    margin: 0;
    padding: var(--sp-3, 0.75rem) var(--sp-5, 1.25rem);
    border: 3px solid #17121f;
    border-radius: 22px;
    background: #fff;
    color: #17121f;
    box-shadow: 4px 4px 0 #17121f;
  }
  .tch__bubble::after {
    content: '';
    position: absolute;
    left: 22%;
    bottom: -16px;
    width: 22px;
    height: 16px;
    background: #fff;
    border: solid #17121f;
    border-width: 0 3px 3px 0;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    transform: skewX(-20deg);
  }
  .tch__bubble p { margin: 0; font-family: var(--font-display, inherit); font-size: clamp(0.95rem, 2.2vw, 1.2rem); line-height: 1.2; }

  .tch__universe { margin: 0 0 var(--sp-2, 0.5rem); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-primary-light, #d4a017); }
  .tch__name { margin: 0; font-family: var(--font-display, inherit); font-size: clamp(2.6rem, 7vw, 4.8rem); font-weight: 400; line-height: 0.95; color: var(--c-text-1, #fff); }
  .tch__alias {
    display: inline-block;
    margin: var(--sp-3, 0.75rem) 0 0;
    padding: 0.25rem 0.75rem;
    border: 2px solid var(--tch-edge);
    border-radius: 6px;
    background: var(--toy-yellow, #ffd23f);
    color: #17121f;
    font-weight: 800;
    transform: rotate(-1deg);
  }
  .tch__bio { margin: var(--sp-5, 1.25rem) 0 0; max-width: 56ch; font-size: 1.05rem; line-height: 1.7; color: var(--c-text-2, #a3a3a3); }

  .tch__powers { margin-top: var(--sp-6, 1.5rem); }
  .tch__powers-title { margin: 0 0 var(--sp-3, 0.75rem); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-text-1, #fff); }
  .tch__powers ul { display: grid; gap: var(--sp-2, 0.5rem); margin: 0; padding: 0; list-style: none; max-width: 30rem; }
  .tch__powers li { display: grid; grid-template-columns: 90px 1fr 44px; align-items: center; gap: var(--sp-3, 0.75rem); }
  .tch__powers label { font-size: 0.85rem; font-weight: 700; color: var(--c-text-2, #a3a3a3); }
  .tch__powers meter {
    appearance: none;
    width: 100%;
    height: 16px;
    border: 2.5px solid var(--tch-edge);
    border-radius: 999px;
    background: rgb(var(--ink-rgb, 255 255 255) / 0.06);
    overflow: hidden;
  }
  .tch__powers meter::-webkit-meter-bar { background: transparent; border: 0; border-radius: 999px; height: 100%; }
  .tch__powers meter::-webkit-meter-optimum-value { background: repeating-linear-gradient(-45deg, hsl(var(--ch-hue) 88% 58%) 0 6px, hsl(var(--ch-hue) 88% 48%) 6px 12px); border-radius: 999px; }
  .tch__powers meter::-moz-meter-bar { background: repeating-linear-gradient(-45deg, hsl(var(--ch-hue) 88% 58%) 0 6px, hsl(var(--ch-hue) 88% 48%) 6px 12px); border-radius: 999px; }
  .tch__power-value { font-family: var(--font-display, inherit); font-size: 1.05rem; color: var(--c-text-1, #fff); text-align: right; }
  .tch__power-max { font-size: 0.7em; color: var(--c-text-2, #a3a3a3); }

  .tch__facts { display: flex; flex-wrap: wrap; gap: var(--sp-4, 1rem) var(--sp-8, 2rem); margin: var(--sp-6, 1.5rem) 0 0; }
  .tch__facts div { display: grid; gap: 2px; }
  .tch__facts dt { font-size: 0.75rem; color: var(--c-text-2, #a3a3a3); }
  .tch__facts dd { margin: 0; font-weight: 800; color: var(--c-text-1, #fff); }

  .tch__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-3, 0.75rem); margin-top: var(--sp-8, 2rem); }
  .tch__btn {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 0 var(--sp-6, 1.5rem);
    border: 2.5px solid var(--tch-edge);
    border-radius: 999px;
    background: var(--toy-card-bg, var(--c-bg-1, #0a0a0a));
    color: var(--c-text-1, #fff);
    box-shadow: 4px 4px 0 var(--tch-drop);
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .tch__btn--primary { background: var(--c-primary-light, #d62839); color: var(--c-on-primary, #fff); }
  .tch__btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--tch-drop); color: inherit; }
  .tch__btn--primary:hover { color: var(--c-on-primary, #fff); }
  .tch__btn:focus-visible { outline: 3px solid var(--toy-yellow, #ffd23f); outline-offset: 4px; }

  @container (max-width: 760px) {
    .tch__inner { grid-template-columns: 1fr; }
    .tch__panel { max-width: 420px; width: 100%; margin: 0 auto; }
    .tch__powers li { grid-template-columns: 76px 1fr 40px; }
  }
  @media (prefers-reduced-motion: reduce) { .tch__btn { transition: none; } }
</style>
