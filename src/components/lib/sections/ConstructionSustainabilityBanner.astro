---
/**
 * ConstructionSustainabilityBanner — High-level ESG, sustainability, and Passivhaus green building credentials.
 * Highlights zero-emission buildings, energy rating A, BREEAM/LEED certifications, and renewable thermal systems.
 *
 * @param {string} title - Section headline.
 * @param {string} subtitle - Subtitle copy.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  title = 'Construcción Sostenible & Eficiencia Energética Clase A',
  subtitle = 'Diseñamos y ejecutamos edificios con emisiones casi nulas (nZEB), maximizando el confort térmico y reduciendo la factura energética hasta un 85%.',
  className = '',
} = Astro.props;

const pillars = [
  {
    icon: '🌱',
    name: 'Passivhaus & nZEB',
    desc: 'Edificios de consumo casi nulo con hermeticidad certificada por Blower Door y ventilación mecánica con recuperación de calor del 92%.',
  },
  {
    icon: '⚡',
    name: 'Aerotermia & Geotermia',
    desc: 'Sistemas de climatización renovable por bomba de calor y pozos geotérmicos asociados a suelo radiante/refrescante.',
  },
  {
    icon: '🏅',
    name: 'Certificaciones BREEAM & LEED',
    desc: 'Proyectos auditados con sellos BREEAM Excellent y LEED Gold que incrementan el valor patrimonial y reducen la huella de carbono.',
  },
  {
    icon: '☀️',
    name: 'Autoconsumo Fotovoltaico',
    desc: 'Integración arquitectónica de placas solares fotovoltaicas de alto rendimiento en cubiertas planas para alimentar zonas comunes y recarga de vehículos eléctricos.',
  },
];
---

<section class={`construction-sustainability ${className}`}>
  <div class="sustain-container">
    <div class="sustain-card">
      <div class="sustain-header">
        <div class="sustain-left">
          <span class="sustain-badge">COMPROMISO ESG &amp; DESCARBONIZACIÓN</span>
          <h2 class="sustain-title">{title}</h2>
          <p class="sustain-sub">{subtitle}</p>
        </div>

        <div class="energy-seal">
          <span class="seal-letter">A</span>
          <div class="seal-text">
            <strong>MÁXIMA EFICIENCIA</strong>
            <span>CTE 2026 Conforme</span>
          </div>
        </div>
      </div>

      <div class="pillars-grid">
        {pillars.map((p) => (
          <div class="pillar-item">
            <span class="pillar-icon">{p.icon}</span>
            <div class="pillar-copy">
              <h3 class="pillar-name">{p.name}</h3>
              <p class="pillar-desc">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .construction-sustainability {
    padding: 3.5rem 1.5rem 4.5rem;
    background: #0b0f19;
  }

  .sustain-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .sustain-card {
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.12) 0%, rgba(30, 41, 59, 0.8) 100%);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 24px;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    box-shadow: 0 20px 45px -10px rgba(16, 185, 129, 0.15);
  }

  @media (max-width: 768px) {
    .sustain-card {
      padding: 2rem 1.5rem;
    }
  }

  .sustain-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .sustain-left {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 750px;
  }

  .sustain-badge {
    align-self: flex-start;
    padding: 0.25rem 0.65rem;
    background: rgba(34, 197, 94, 0.2);
    border: 1px solid rgba(34, 197, 94, 0.5);
    color: #4ade80;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .sustain-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .sustain-sub {
    font-size: 0.95rem;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.6;
  }

  .energy-seal {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: rgba(15, 23, 42, 0.7);
    border: 2px solid #22c55e;
    border-radius: 16px;
    box-shadow: 0 0 20px rgba(34, 197, 94, 0.3);
  }

  .seal-letter {
    font-size: 3rem;
    font-weight: 900;
    color: #22c55e;
    line-height: 1;
  }

  .seal-text {
    display: flex;
    flex-direction: column;
  }

  .seal-text strong {
    font-size: 0.85rem;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  .seal-text span {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .pillar-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.25rem;
  }

  .pillar-icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  .pillar-copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .pillar-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .pillar-desc {
    font-size: 0.82rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }
</style>
