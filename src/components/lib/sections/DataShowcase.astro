---
// DataShowcase.astro — Premium data display section with live preview
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Data Display", subtitle = "Stats, tables, and visualization elements." } = Astro.props;
---

<section class="data-showcase">
  <div class="container">
    <div class="showcase-header">
      <span class="showcase-eyebrow">📊 Data Display</span>
      <h2 class="showcase-title">{title}</h2>
      <p class="showcase-subtitle">{subtitle}</p>
    </div>

    <div class="preview-stage">
      <div class="preview-stage__inner">
        <div class="data-mockups">
          <!-- Stats Row -->
          <div class="stats-row">
            <div class="stat-card">
              <span class="stat-value">12,847</span>
              <span class="stat-label">Total Users</span>
            </div>
            <div class="stat-card">
              <span class="stat-value">94.2%</span>
              <span class="stat-label">Uptime</span>
            </div>
            <div class="stat-card">
              <span class="stat-value">3.6s</span>
              <span class="stat-label">Avg. Response</span>
            </div>
          </div>

          <!-- Mini Table -->
          <div class="mini-table">
            <div class="table-header">
              <span class="col col--name">Endpoint</span>
              <span class="col col--status">Status</span>
              <span class="col col--latency">Latency</span>
            </div>
            <div class="table-row">
              <span class="col col--name">/api/users</span>
              <span class="col col--status"><span class="badge badge--ok">200</span></span>
              <span class="col col--latency">12ms</span>
            </div>
            <div class="table-row">
              <span class="col col--name">/api/products</span>
              <span class="col col--status"><span class="badge badge--warn">301</span></span>
              <span class="col col--latency">48ms</span>
            </div>
            <div class="table-row">
              <span class="col col--name">/api/orders</span>
              <span class="col col--status"><span class="badge badge--err">500</span></span>
              <span class="col col--latency">210ms</span>
            </div>
          </div>

          <!-- Progress Bar / Chart -->
          <div class="progress-section">
            <div class="progress-labels">
              <span class="progress-label">CPU Usage</span>
              <span class="progress-value">73%</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="usage-code">
      <code set:html={`&lt;DataTable data={items} variant="glass" /&gt;`}></code>
    </div>
  </div>
</section>

<style>
  .data-showcase {
    padding: var(--sp-16) 0;
    position: relative;
  }
  .showcase-header {
    text-align: center;
    margin-bottom: var(--sp-10);
  }
  .showcase-eyebrow {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-primary-light);
    background: rgba(184,134,11,0.1);
    border: 1px solid rgba(184,134,11,0.25);
    border-radius: var(--r-full);
    margin-bottom: var(--sp-4);
  }
  .showcase-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--c-text-1);
    margin-bottom: var(--sp-3);
  }
  .showcase-subtitle {
    font-size: 1.05rem;
    color: var(--c-text-2);
    max-width: 500px;
    margin: 0 auto;
  }

  /* Preview Stage */
  .preview-stage {
    padding: var(--sp-12);
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-xl);
    margin-bottom: var(--sp-6);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  .preview-stage__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-8);
  }
  .data-mockups {
    width: 100%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  /* Stats Row */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }
  .stat-card {
    padding: var(--sp-5);
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-lg);
    text-align: center;
    transition: all 0.25s ease;
  }
  .stat-card:hover {
    background: rgba(255,255,255,0.07);
    border-color: rgba(184,134,11,0.25);
    transform: translateY(-2px);
  }
  .stat-value {
    display: block;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--c-text-1);
    margin-bottom: var(--sp-1);
  }
  .stat-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--c-text-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Mini Table */
  .mini-table {
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .table-header {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 1fr;
    padding: var(--sp-3) var(--sp-5);
    background: rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-2);
  }
  .table-row {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 1fr;
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid rgba(255,255,255,0.04);
    font-size: 0.85rem;
    align-items: center;
    transition: background 0.2s ease;
  }
  .table-row:last-child {
    border-bottom: none;
  }
  .table-row:hover {
    background: rgba(255,255,255,0.03);
  }
  .col--name {
    color: var(--c-text-1);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .col--status {
    display: flex;
    justify-content: center;
  }
  .col--latency {
    color: var(--c-text-2);
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    border-radius: var(--r-sm);
  }
  .badge--ok {
    background: rgba(34,197,94,0.15);
    color: #22c55e;
    border: 1px solid rgba(34,197,94,0.3);
  }
  .badge--warn {
    background: rgba(234,179,8,0.15);
    color: #eab308;
    border: 1px solid rgba(234,179,8,0.3);
  }
  .badge--err {
    background: rgba(239,68,68,0.15);
    color: #ef4444;
    border: 1px solid rgba(239,68,68,0.3);
  }

  /* Progress Bar */
  .progress-section {
    padding: var(--sp-5);
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-lg);
  }
  .progress-labels {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--sp-3);
  }
  .progress-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-text-2);
  }
  .progress-value {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-primary-light);
    font-family: var(--font-mono);
  }
  .progress-track {
    height: 8px;
    background: rgba(255,255,255,0.08);
    border-radius: var(--r-full);
    overflow: hidden;
  }
  .progress-fill {
    width: 73%;
    height: 100%;
    background: linear-gradient(90deg, var(--c-primary-light), var(--c-primary), rgba(184,134,11,0.4));
    border-radius: var(--r-full);
    box-shadow: 0 0 12px rgba(184,134,11,0.3);
    animation: progress-pulse 2.5s ease-in-out infinite;
  }
  @keyframes progress-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }

  .usage-code {
    text-align: center;
    padding: var(--sp-4);
    background: rgba(255,255,255,0.02);
    border-radius: var(--r-md);
  }
  .usage-code code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-primary-light);
  }

  @media (max-width: 640px) {
    .stats-row {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }
    .stat-card {
      padding: var(--sp-4);
    }
    .stat-value {
      font-size: 1.3rem;
    }
    .table-header,
    .table-row {
      grid-template-columns: 1.2fr 0.6fr 0.8fr;
      padding: var(--sp-3) var(--sp-4);
      font-size: 0.75rem;
    }
    .preview-stage {
      padding: var(--sp-8) var(--sp-4);
    }
    .data-mockups {
      gap: var(--sp-6);
    }
  }
</style>
