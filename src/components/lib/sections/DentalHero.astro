---
/**
 * DentalHero — Public landing hero for modern dental clinics.
 * Features trust metrics (painless anesthesia, 5.0 Google score), quick appointment selector, and emergency care hotline.
 *
 * @param {string} title - Hero heading.
 * @param {string} subtitle - Supporting description.
 * @param {string} bookHref - Direct appointment booking URL.
 * @param {string} emergencyPhone - 24/7 emergency dental hotline.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  bookHref?: string;
  emergencyPhone?: string;
  className?: string;
}

const {
  title = 'Artisan Smile Design, Painless Dental Care.',
  subtitle = 'Experience anxiety-free dentistry with computerized painless anesthesia, 3D intraoral diagnostics and same-day ceramic restorations in the heart of Madrid.',
  bookHref = '/preview/dental/book',
  emergencyPhone = '+34 600 911 200',
  className = '',
} = Astro.props;
---

<section class={`dental-hero ${className}`}>
  <div class="dental-hero__container">
    <!-- Top Emergency Notice Bar -->
    <div class="emergency-pill-wrap">
      <a href={`tel:${emergencyPhone}`} class="emergency-pill">
        <span class="emergency-dot"></span>
        <strong>Urgent Tooth Pain?</strong>
        <span>Same-day emergency slots open now · Call {emergencyPhone}</span>
        <span class="emergency-arrow">→</span>
      </a>
    </div>

    <div class="dental-hero__grid">
      <!-- Left Column: Copy & Trust -->
      <div class="dental-hero__content">
        <div class="rating-badge">
          <div class="stars">★★★★★</div>
          <span class="rating-text"><strong>4.98 / 5.0</strong> from 1,280+ verified patients</span>
        </div>

        <h1 class="dental-hero__title">{title}</h1>
        <p class="dental-hero__subtitle">{subtitle}</p>

        <!-- CTA row -->
        <div class="dental-hero__actions">
          <a href={bookHref} class="btn-primary-dental">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
            </svg>
            Book Appointment Online
          </a>
          <a href="#treatments" class="btn-outline-dental">
            Explore Dental Treatments
          </a>
        </div>

        <!-- Trust Features Row -->
        <div class="trust-features">
          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <strong>100% Pain-Free</strong>
              <span>Computer-guided anesthesia</span>
            </div>
          </div>

          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/>
              </svg>
            </div>
            <div>
              <strong>Zero Waiting Time</strong>
              <span>Guaranteed chair on time</span>
            </div>
          </div>

          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>
              </svg>
            </div>
            <div>
              <strong>Flexible 0% APR</strong>
              <span>Up to 24 months financing</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Quick-Booking Widget -->
      <div class="dental-hero__widget">
        <div class="quick-book-card">
          <div class="widget-header">
            <span class="widget-badge">Direct Clinic Calendar</span>
            <h3 class="widget-title">Reserve Your Dental Visit</h3>
            <p class="widget-desc">Select treatment & preferred time slot</p>
          </div>

          <form action={bookHref} method="GET" class="quick-form">
            <div class="form-group">
              <label for="hero-treatment">Reason for Visit</label>
              <select id="hero-treatment" name="treatment" class="dental-select">
                <option value="prophy">Routine Cleaning & Checkup (AirFlow)</option>
                <option value="emergency">Emergency / Acute Tooth Pain</option>
                <option value="invisalign">Clear Aligners / Invisalign 3D Scan</option>
                <option value="whitening">Laser Teeth Whitening (Philips Zoom)</option>
                <option value="implant">Dental Implant Consultation</option>
              </select>
            </div>

            <div class="form-group">
              <label for="hero-specialist">Preferred Specialist</label>
              <select id="hero-specialist" name="doctor" class="dental-select">
                <option value="any">First Available Specialist</option>
                <option value="dr-ramos">Dr. Adrián Ramos (Implants & Surgery)</option>
                <option value="dr-silva">Dr. Elena Silva (Orthodontics & Invisalign)</option>
                <option value="dr-vance">Dr. Marcus Vance (Endodontics & Restorative)</option>
                <option value="vega-rdh">Carla Vega, RDH (Hygiene & Prevention)</option>
              </select>
            </div>

            <div class="form-row-two">
              <div class="form-group">
                <label for="hero-date">Preferred Day</label>
                <input type="date" id="hero-date" name="date" class="dental-input" value="2026-11-09" />
              </div>
              <div class="form-group">
                <label for="hero-time">Preferred Time</label>
                <select id="hero-time" name="time" class="dental-select">
                  <option value="morning">Morning (09:00 – 13:00)</option>
                  <option value="afternoon">Afternoon (14:00 – 19:30)</option>
                </select>
              </div>
            </div>

            <button type="submit" class="btn-widget-submit">
              Check Live Availability & Book →
            </button>
          </form>

          <div class="widget-footer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Instant SMS & Email confirmation · Free cancellation</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dental-hero {
    position: relative;
    padding: 3rem 1.5rem 5rem;
    background: radial-gradient(circle at 10% 20%, rgba(2, 132, 199, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.06) 0%, transparent 40%);
  }

  .dental-hero__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .emergency-pill-wrap {
    display: flex;
    margin-bottom: 2rem;
  }

  .emergency-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.82rem;
    color: var(--c-text-1);
    transition: all 0.2s ease;
  }

  .emergency-pill:hover {
    background: rgba(220, 38, 38, 0.15);
    border-color: rgba(220, 38, 38, 0.4);
    transform: translateY(-1px);
  }

  .emergency-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #dc2626;
    animation: pulse-red 1.5s infinite;
  }

  @keyframes pulse-red {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .emergency-pill strong {
    color: #dc2626;
  }

  .emergency-arrow {
    color: #dc2626;
    font-weight: 700;
  }

  .dental-hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .dental-hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--c-bg-subtle);
    border: 1px solid var(--c-border);
    padding: 4px 12px;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }

  .stars {
    color: #f59e0b;
    letter-spacing: 2px;
    font-size: 0.85rem;
  }

  .rating-text {
    font-size: 0.82rem;
    color: var(--c-text-2);
  }

  .dental-hero__title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }

  .dental-hero__subtitle {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--c-text-2);
    margin: 0 0 2rem;
    max-width: 580px;
  }

  .dental-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .btn-primary-dental {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--c-primary);
    color: #fff;
    padding: 12px 24px;
    border-radius: var(--r-md);
    font-size: 0.95rem;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
    transition: all 0.2s ease;
  }

  .btn-primary-dental:hover {
    background: var(--c-primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
  }

  .btn-outline-dental {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    border-radius: var(--r-md);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-text-1);
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    transition: all 0.2s ease;
  }

  .btn-outline-dental:hover {
    background: var(--dental-surface-hover);
    border-color: var(--c-primary);
  }

  .trust-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .trust-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(2, 132, 199, 0.1);
    color: var(--c-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-item strong {
    display: block;
    font-size: 0.85rem;
    color: var(--c-text-1);
  }

  .trust-item span {
    display: block;
    font-size: 0.72rem;
    color: var(--c-text-3);
  }

  /* Quick-booking widget card */
  .quick-book-card {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 2rem;
    box-shadow: var(--dental-shadow-md);
    position: relative;
  }

  .widget-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .widget-title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--c-text-1);
  }

  .widget-desc {
    margin: 4px 0 1.5rem;
    font-size: 0.85rem;
    color: var(--c-text-3);
  }

  .quick-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .form-group label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--c-text-2);
  }

  .form-row-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .dental-select,
  .dental-input {
    width: 100%;
    padding: 10px 12px;
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    background: var(--c-bg);
    color: var(--c-text-1);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .dental-select:focus,
  .dental-input:focus {
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }

  .btn-widget-submit {
    margin-top: 0.5rem;
    background: var(--c-primary);
    color: #fff;
    padding: 12px;
    border-radius: var(--r-md);
    font-size: 0.95rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
    transition: all 0.2s;
  }

  .btn-widget-submit:hover {
    background: var(--c-primary-dark);
    transform: translateY(-1px);
  }

  .widget-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 1rem;
    font-size: 0.74rem;
    color: var(--c-text-3);
  }
</style>

