---
/**
 * MovingApplicationForm — Interactive and accessible job application form for drivers and movers.
 * Captures driving license category, own van ownership details, previous logistics experience,
 * and working availability with client-side validation and instant confirmation.
 *
 * @param {string} title - Section title.
 * @param {string} subtitle - Section subtitle.
 * @param {string} className - Optional container CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  title = 'Apply to Join the Muvr Crew',
  subtitle = 'Fill out your experience and vehicle details below. Our fleet recruitment team reviews applications within 24 hours.',
  className = '',
} = Astro.props;
---

<section id="apply" class={`app-form-section ${className}`}>
  <div class="form-container">
    <div class="form-card">
      <div class="form-head">
        <span class="form-badge">Fast-Track Hiring</span>
        <h2 class="form-title">{title}</h2>
        <p class="form-subtitle">{subtitle}</p>
      </div>

      <form class="hiring-form" id="driver-application-form">
        <!-- Role selector -->
        <div class="form-group">
          <label for="apply-role" class="form-label">Position You Are Applying For *</label>
          <select id="apply-role" name="role" class="form-select" required>
            <option value="driver_own_van" selected>Van Driver with Own Vehicle (€32 - €45/hr)</option>
            <option value="driver_company_van">Company Fleet Van Driver (€1,850 - €2,200/mo)</option>
            <option value="furniture_mover">Furniture Mover & Heavy Lift (€16 - €20/hr)</option>
            <option value="assembly_tech">Furniture Assembly Technician (€22 - €28/hr)</option>
          </select>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label for="apply-name" class="form-label">Full Legal Name *</label>
            <input
              type="text"
              id="apply-name"
              name="name"
              class="form-input"
              placeholder="e.g. Andrés Gil Carmona"
              required
            />
          </div>

          <div class="form-group">
            <label for="apply-phone" class="form-label">Mobile Phone (WhatsApp) *</label>
            <input
              type="tel"
              id="apply-phone"
              name="phone"
              class="form-input"
              placeholder="+34 600 000 000"
              required
            />
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label for="apply-email" class="form-label">Email Address *</label>
            <input
              type="email"
              id="apply-email"
              name="email"
              class="form-input"
              placeholder="andres@email.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="apply-license" class="form-label">Driving License Category *</label>
            <select id="apply-license" name="license" class="form-select" required>
              <option value="B">Class B (Standard Cars & Vans up to 3.5T)</option>
              <option value="C1">Class C1 (Vans & Light Trucks up to 7.5T)</option>
              <option value="C">Class C (Heavy Rigid Trucks)</option>
              <option value="none">No Driving License (Mover / Loader Only)</option>
            </select>
          </div>
        </div>

        <!-- Conditional Own Van Details Block -->
        <div class="van-details-box" id="van-details-group">
          <h4 class="box-title">Own Vehicle Specifications</h4>
          <div class="form-grid-2">
            <div class="form-group">
              <label for="apply-van-model" class="form-label">Vehicle Make & Model</label>
              <input
                type="text"
                id="apply-van-model"
                name="vanModel"
                class="form-input"
                placeholder="e.g. Ford Transit L3H2, Iveco Daily Box"
              />
            </div>
            <div class="form-group">
              <label for="apply-van-volume" class="form-label">Cargo Volume (m³)</label>
              <input
                type="number"
                id="apply-van-volume"
                name="vanVolume"
                class="form-input"
                placeholder="e.g. 13"
                min="3"
                max="40"
              />
            </div>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label for="apply-experience" class="form-label">Years of Experience</label>
            <select id="apply-experience" name="experience" class="form-select">
              <option value="0-1">Less than 1 year</option>
              <option value="1-3" selected>1 - 3 years</option>
              <option value="3-5">3 - 5 years</option>
              <option value="5+">5+ years</option>
            </select>
          </div>

          <div class="form-group">
            <label for="apply-availability" class="form-label">Availability</label>
            <select id="apply-availability" name="availability" class="form-select">
              <option value="immediate" selected>Immediate (Full-time)</option>
              <option value="part_time">Part-time (Mornings / Afternoons)</option>
              <option value="weekends">Weekends only</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" required />
            <span>I confirm that my driving record is clean and I agree to background verification for high-value cargo handling.</span>
          </label>
        </div>

        <button type="submit" class="submit-btn" id="submit-app-btn">
          <span>Submit Driver / Mover Application</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>

        <div class="form-success-banner" id="form-success" style="display: none;">
          <div class="success-icon">✓</div>
          <div>
            <strong>Application Received!</strong>
            <p>Our fleet coordinator will contact you via WhatsApp or phone within 24 business hours for a short interview.</p>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  function initApplicationForm() {
    const form = document.getElementById('driver-application-form') as HTMLFormElement | null;
    const roleSelect = document.getElementById('apply-role') as HTMLSelectElement | null;
    const vanGroup = document.getElementById('van-details-group') as HTMLElement | null;
    const successBanner = document.getElementById('form-success') as HTMLElement | null;

    if (!form) return;

    roleSelect?.addEventListener('change', () => {
      if (vanGroup) {
        if (roleSelect.value === 'driver_own_van') {
          vanGroup.style.display = 'block';
        } else {
          vanGroup.style.display = 'none';
        }
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successBanner) {
        successBanner.style.display = 'flex';
        form.reset();
        successBanner.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  initApplicationForm();
  document.addEventListener('astro:page-load', initApplicationForm);
</script>

<style>
  .app-form-section {
    padding: 4.5rem 1.5rem;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
  }

  .form-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .form-card {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 2.5rem 2rem;
    box-shadow: 0 16px 36px -8px rgba(15, 23, 42, 0.08);
  }

  .form-head {
    margin-bottom: 2rem;
    text-align: center;
  }

  .form-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-primary);
    background: rgba(37, 99, 235, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: var(--r-full);
    margin-bottom: 0.65rem;
  }

  .form-title {
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--c-text);
  }

  .form-subtitle {
    font-size: 0.95rem;
    color: var(--c-text-muted);
    margin: 0;
  }

  .hiring-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .form-grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-text);
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface);
    color: var(--c-text);
    font-size: 0.9rem;
    outline: none;
    transition: all 0.15s ease;
    box-sizing: border-box;
  }

  .form-input:focus,
  .form-select:focus {
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .van-details-box {
    background: rgba(37, 99, 235, 0.04);
    border: 1px dashed var(--c-primary);
    border-radius: var(--r-md);
    padding: 1.25rem;
  }

  .box-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--c-primary);
    margin: 0 0 0.85rem;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.82rem;
    color: var(--c-text-muted);
    line-height: 1.4;
    cursor: pointer;
  }

  .checkbox-label input {
    accent-color: var(--c-primary);
    margin-top: 0.15rem;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem;
    background: var(--c-primary);
    color: #ffffff;
    border: none;
    border-radius: var(--r-md);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 0.5rem;
  }

  .submit-btn:hover {
    background: var(--c-primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
  }

  .form-success-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--r-md);
    padding: 1rem;
    color: var(--c-text);
    font-size: 0.88rem;
    margin-top: 1rem;
  }

  .success-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #10b981;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    flex-shrink: 0;
  }

  .form-success-banner p {
    margin: 0.25rem 0 0;
    color: var(--c-text-muted);
    font-size: 0.82rem;
  }
</style>

