---
/**
 * EstateValuationCta — "What is my home worth?" call to action for property owners.
 * Short pitch, three reasons to sell with the agency and a link to the valuation wizard.
 *
 * @param {string} title - Heading.
 * @param {string} text - Supporting text.
 * @param {string} href - Valuation page.
 * @param {string} cta - Button label.
 * @param {string[]} points - Short selling points.
 * @param {string} variant - 'banner' (brand background) | 'subtle' (surface). Default 'banner'.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: decorative house illustration is aria-hidden; text on the brand background
 * uses the theme's on-brand colour for contrast.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/real-estate/real-estate-theme.css';

interface OwnProps {
  title?: string;
  text?: string;
  href?: string;
  cta?: string;
  points?: string[];
  variant?: 'banner' | 'subtle';
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const {
  title = '¿Cuánto vale tu casa hoy?',
  text = 'Responde seis preguntas y recibe una horquilla de precio basada en ventas reales de tu calle. Un agente la revisa y te llama en 24 horas.',
  href = '/preview/real-estate/valoracion',
  cta = 'Valorar gratis',
  points = ['Sin compromiso de venta', 'Fotos y plano profesionales incluidos', 'Precio medio de venta: 98 % del precio de salida'],
  variant = 'banner',
  class: classAttr,
  ...rest
} = Astro.props;

const uid = `evc-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['estate-ui', 'estate-vcta', `estate-vcta--${variant}`, classAttr]} aria-labelledby={`${uid}-title`} {...rest}>
  <div class="estate-vcta__inner">
    <div class="estate-vcta__copy">
      <h2 id={`${uid}-title`} class="estate-vcta__title">{title}</h2>
      <p class="estate-vcta__text">{text}</p>
      <ul class="estate-vcta__points" role="list">
        {points.map((p) => (
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {p}
          </li>
        ))}
      </ul>
      <a href={href} class="estate-vcta__btn">
        {cta}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
    <svg class="estate-vcta__art" viewBox="0 0 220 180" aria-hidden="true">
      <path d="M20 90 110 20l90 70" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M45 80v85h130V80" fill="none" stroke="currentColor" stroke-width="10" stroke-linejoin="round" />
      <path d="M92 165v-48h36v48" fill="none" stroke="currentColor" stroke-width="10" stroke-linejoin="round" />
      <circle cx="170" cy="40" r="16" fill="currentColor" opacity="0.4" />
    </svg>
  </div>
</section>

<style>
  .estate-vcta {
    padding: var(--sp-8, 2rem) var(--sp-4, 1rem);
    background: var(--estate-bg);
    font-family: var(--estate-font-body);
  }

  .estate-vcta__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    gap: var(--sp-8, 2rem);
    align-items: center;
    padding: var(--sp-8, 2rem) var(--sp-6, 1.5rem);
    border-radius: var(--r-xl, 28px);
  }

  .estate-vcta--banner .estate-vcta__inner {
    background: var(--estate-brand);
    color: var(--estate-on-brand);
  }

  .estate-vcta--subtle .estate-vcta__inner {
    background: var(--estate-surface);
    border: 1px solid var(--estate-border);
    color: var(--estate-text);
  }

  .estate-vcta__title {
    margin: 0;
    font-family: var(--estate-font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    letter-spacing: -0.015em;
  }

  .estate-vcta__text {
    margin: var(--sp-3, 0.75rem) 0 var(--sp-4, 1rem);
    max-width: 560px;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .estate-vcta__points {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2, 0.5rem);
    margin: 0 0 var(--sp-6, 1.5rem);
    padding: 0;
    list-style: none;
    font-weight: 500;
  }

  .estate-vcta__points li {
    display: flex;
    align-items: center;
    gap: var(--sp-2, 0.5rem);
  }

  .estate-vcta__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2, 0.5rem);
    min-height: 48px;
    padding: 0 var(--sp-6, 1.5rem);
    border-radius: var(--r-full, 999px);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .estate-vcta--banner .estate-vcta__btn {
    background: var(--estate-on-brand);
    color: var(--estate-brand);
  }

  .estate-vcta--subtle .estate-vcta__btn {
    background: var(--estate-brand);
    color: var(--estate-on-brand);
  }

  .estate-vcta__btn:hover {
    transform: translateX(3px);
  }

  .estate-vcta__btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .estate-vcta--banner .estate-vcta__btn:focus-visible {
    outline-color: var(--estate-on-brand);
  }

  .estate-vcta__art {
    display: none;
    width: 100%;
    max-width: 260px;
    justify-self: center;
    opacity: 0.85;
  }

  @media (min-width: 860px) {
    .estate-vcta__inner {
      grid-template-columns: minmax(0, 1fr) 280px;
      padding: var(--sp-12, 3rem);
    }

    .estate-vcta__art {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .estate-vcta__btn {
      transition: none;
    }

    .estate-vcta__btn:hover {
      transform: none;
    }
  }
</style>
