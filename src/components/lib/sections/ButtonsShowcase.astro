---
// ButtonsShowcase.astro — Premium buttons section with live preview
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Buttons", subtitle = "Interactive button components with premium styles and animations." } = Astro.props;
---

<section class="buttons-showcase">
  <div class="container">
    <div class="showcase-header">
      <span class="showcase-eyebrow">⚡ Buttons</span>
      <h2 class="showcase-title">{title}</h2>
      <p class="showcase-subtitle">{subtitle}</p>
    </div>

    <div class="preview-stage">
      <div class="preview-stage__inner">
        <div class="button-grid">
          <button class="btn btn--primary">Primary</button>
          <button class="btn btn--glass">Glass</button>
          <button class="btn btn--glow">Glow</button>
          <button class="btn btn--shimmer">Shimmer</button>
          <button class="btn btn--neumorphic">Neumorphic</button>
          <button class="btn btn--ghost">Ghost</button>
        </div>
      </div>
    </div>

    <div class="usage-code">
      <code>&lt;GlassButton variant="primary"&gt;Click me&lt;/GlassButton&gt;</code>
    </div>
  </div>
</section>

<style>
  .buttons-showcase {
    padding: var(--sp-16) 0;
    position: relative;
  }
  .showcase-header {
    text-align: center;
    margin-bottom: var(--sp-10);
  }
  .showcase-eyebrow {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-primary-light);
    background: rgba(184,134,11,0.1);
    border: 1px solid rgba(184,134,11,0.25);
    border-radius: var(--r-full);
    margin-bottom: var(--sp-4);
  }
  .showcase-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--c-text-1);
    margin-bottom: var(--sp-3);
  }
  .showcase-subtitle {
    font-size: 1.05rem;
    color: var(--c-text-2);
    max-width: 500px;
    margin: 0 auto;
  }

  /* Preview Stage */
  .preview-stage {
    padding: var(--sp-12);
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-xl);
    margin-bottom: var(--sp-6);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  .preview-stage__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }
  .button-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    justify-content: center;
  }

  /* Button Styles */
  .btn {
    padding: 0.75rem 1.8rem;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-sans);
    border: none;
    border-radius: var(--r-md);
    cursor: pointer;
    transition: all 0.25s ease;
    min-width: 120px;
  }
  .btn--primary {
    background: linear-gradient(135deg, var(--c-primary-light), var(--c-primary));
    color: #0a0a0a;
    box-shadow: 0 4px 20px rgba(184,134,11,0.3);
  }
  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(184,134,11,0.4);
  }
  .btn--glass {
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(12px);
    color: var(--c-text-1);
    border: 1px solid rgba(255,255,255,0.12);
  }
  .btn--glass:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(184,134,11,0.3);
  }
  .btn--glow {
    background: transparent;
    color: var(--c-primary-light);
    border: 1px solid var(--c-primary);
    box-shadow: 0 0 12px rgba(184,134,11,0.2);
  }
  .btn--glow:hover {
    box-shadow: 0 0 24px rgba(184,134,11,0.5);
    transform: translateY(-2px);
  }
  .btn--shimmer {
    background: linear-gradient(110deg, #b8860b 0%, #d4a017 40%, #fef3c7 50%, #d4a017 60%, #b8860b 100%);
    background-size: 200% 100%;
    color: #0a0a0a;
    animation: shimmer 3s linear infinite;
  }
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .btn--neumorphic {
    background: #1a1a1a;
    color: var(--c-text-1);
    box-shadow: 4px 4px 12px rgba(0,0,0,0.5), -4px -4px 12px rgba(255,255,255,0.05);
  }
  .btn--neumorphic:hover {
    box-shadow: 2px 2px 8px rgba(0,0,0,0.4), -2px -2px 8px rgba(255,255,255,0.04);
  }
  .btn--ghost {
    background: transparent;
    color: var(--c-text-2);
    border: 1px solid var(--c-border);
  }
  .btn--ghost:hover {
    color: var(--c-text-1);
    border-color: var(--c-primary-light);
  }

  .usage-code {
    text-align: center;
    padding: var(--sp-4);
    background: rgba(255,255,255,0.02);
    border-radius: var(--r-md);
  }
  .usage-code code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-primary-light);
  }

  @media (max-width: 640px) {
    .button-grid { gap: var(--sp-3); }
    .btn { min-width: 100px; padding: 0.6rem 1.2rem; font-size: 0.85rem; }
    .preview-stage { padding: var(--sp-8) var(--sp-4); }
  }
</style>
