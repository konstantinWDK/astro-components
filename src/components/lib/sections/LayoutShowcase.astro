---
// LayoutShowcase.astro — Premium layout section with live preview
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Layout", subtitle = "Grids, containers, and structural sections." } = Astro.props;
---

<section class="layout-showcase">
  <div class="container">
    <div class="showcase-header">
      <span class="showcase-eyebrow">🏗️ Layout</span>
      <h2 class="showcase-title">{title}</h2>
      <p class="showcase-subtitle">{subtitle}</p>
    </div>

    <div class="preview-stage">
      <div class="preview-stage__inner">
        <div class="layout-mockups">
          <!-- Bento Grid -->
          <div class="mockup-label">Bento Grid</div>
          <div class="bento-grid">
            <div class="bento-item bento-item--wide">
              <span class="bento-item__label">Hero</span>
            </div>
            <div class="bento-item">
              <span class="bento-item__label">Card</span>
            </div>
            <div class="bento-item">
              <span class="bento-item__label">Card</span>
            </div>
            <div class="bento-item">
              <span class="bento-item__label">Card</span>
            </div>
            <div class="bento-item bento-item--tall">
              <span class="bento-item__label">Sidebar</span>
            </div>
          </div>

          <!-- Split Screen -->
          <div class="mockup-label">Split Screen</div>
          <div class="split-screen">
            <div class="split-screen__left">
              <span class="split-screen__label">Content</span>
            </div>
            <div class="split-screen__right">
              <span class="split-screen__label">Media</span>
            </div>
          </div>

          <!-- Footer -->
          <div class="mockup-label">Footer</div>
          <div class="footer-mockup">
            <div class="footer-mockup__top">
              <div class="footer-mockup__brand">
                <span class="footer-mockup__label">Brand</span>
              </div>
              <div class="footer-mockup__links">
                <div class="footer-mockup__col">
                  <span class="footer-mockup__label">Links</span>
                </div>
                <div class="footer-mockup__col">
                  <span class="footer-mockup__label">Links</span>
                </div>
                <div class="footer-mockup__col">
                  <span class="footer-mockup__label">Links</span>
                </div>
              </div>
            </div>
            <div class="footer-mockup__bottom">
              <span class="footer-mockup__label">Copyright</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="usage-code">
      <code set:html={`&lt;LayoutSection variant="bento"&gt;{content}&lt;/LayoutSection&gt;`}></code>
    </div>
  </div>
</section>

<style>
  .layout-showcase {
    padding: var(--sp-16) 0;
    position: relative;
  }
  .showcase-header {
    text-align: center;
    margin-bottom: var(--sp-10);
  }
  .showcase-eyebrow {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-primary-light);
    background: rgba(184,134,11,0.1);
    border: 1px solid rgba(184,134,11,0.25);
    border-radius: var(--r-full);
    margin-bottom: var(--sp-4);
  }
  .showcase-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--c-text-1);
    margin-bottom: var(--sp-3);
  }
  .showcase-subtitle {
    font-size: 1.05rem;
    color: var(--c-text-2);
    max-width: 500px;
    margin: 0 auto;
  }

  /* Preview Stage */
  .preview-stage {
    padding: var(--sp-12);
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-xl);
    margin-bottom: var(--sp-6);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  .preview-stage__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-8);
  }
  .layout-mockups {
    width: 100%;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .mockup-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-2);
    margin-bottom: var(--sp-2);
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: var(--sp-3);
  }
  .bento-item {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-md);
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .bento-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(184,134,11,0.05), transparent);
    pointer-events: none;
  }
  .bento-item--wide {
    grid-column: span 2;
    min-height: 100px;
  }
  .bento-item--tall {
    grid-row: span 2;
    min-height: 100%;
  }
  .bento-item__label {
    font-size: 0.75rem;
    color: var(--c-text-2);
    font-weight: 500;
    opacity: 0.6;
  }

  /* Split Screen */
  .split-screen {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    min-height: 140px;
  }
  .split-screen__left,
  .split-screen__right {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .split-screen__left::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(184,134,11,0.05), transparent);
    pointer-events: none;
  }
  .split-screen__right::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(100,100,255,0.05), transparent);
    pointer-events: none;
  }
  .split-screen__label {
    font-size: 0.75rem;
    color: var(--c-text-2);
    font-weight: 500;
    opacity: 0.6;
  }

  /* Footer Mockup */
  .footer-mockup {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .footer-mockup__top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--sp-4);
    padding: var(--sp-4);
  }
  .footer-mockup__brand {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: var(--r-sm);
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .footer-mockup__links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
  }
  .footer-mockup__col {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: var(--r-sm);
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .footer-mockup__bottom {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: var(--sp-3) var(--sp-4);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .footer-mockup__label {
    font-size: 0.7rem;
    color: var(--c-text-2);
    font-weight: 500;
    opacity: 0.5;
  }

  .usage-code {
    text-align: center;
    padding: var(--sp-4);
    background: rgba(255,255,255,0.02);
    border-radius: var(--r-md);
  }
  .usage-code code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-primary-light);
  }

  @media (max-width: 640px) {
    .preview-stage { padding: var(--sp-8) var(--sp-4); }
    .bento-grid {
      grid-template-columns: 1fr 1fr;
    }
    .bento-item--wide {
      grid-column: span 2;
    }
    .bento-item--tall {
      grid-row: span 1;
      min-height: 80px;
    }
    .split-screen {
      grid-template-columns: 1fr;
    }
    .footer-mockup__top {
      grid-template-columns: 1fr;
    }
    .footer-mockup__links {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
