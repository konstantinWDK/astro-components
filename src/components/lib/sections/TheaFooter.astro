---
/**
 * TheaFooter — Site footer closing with a call to action, link columns, a newsletter form
 * (demo confirmation unless an action is given) and an oversized outlined wordmark.
 *
 * @param {string} brand - Brand name used for the wordmark.
 * @param {{title:string,text:string,href:string,label:string}} cta - Closing call to action.
 * @param {Array} columns - Link columns ({ title, links: [{ label, href }] }).
 * @param {string} address - Theater address.
 * @param {string} newsletterAction - Backend endpoint for the form. Empty shows a demo confirmation.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: <footer> landmark, labelled email input, polite confirmation, the wordmark is
 * decorative (aria-hidden); "Allergens" notice is real text.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/theater/thea-theme.css';
import { theaBrand } from '../templates/theater/data';

interface OwnProps {
  brand?: string;
  cta?: { title: string; text: string; href: string; label: string };
  columns?: Array<{ title: string; links: Array<{ label: string; href: string }> }>;
  address?: string;
  newsletterAction?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'footer'>, keyof OwnProps | 'class'> & { class?: string };

const {
  brand = theaBrand.name,
  cta = { title: 'Esta noche hay función', text: 'Elige espectáculo, elige butaca y paga en diez minutos. La entrada te llega al móvil.', href: '/cartelera', label: 'Ver la cartelera' },
  columns = [
    { title: 'Telón', links: [{ label: 'Cartelera', href: '/cartelera' }, { label: 'Esta semana', href: '/espectaculo' }, { label: 'Mi carrito', href: '/carrito' }] },
    { title: 'Clientes', links: [{ label: 'Mis entradas', href: '/acceso' }] },
  ],
  address = theaBrand.address,
  newsletterAction = '',
  class: classAttr,
  ...rest
} = Astro.props;

const uid = `wfo-${Math.random().toString(36).slice(2, 8)}`;
---

<footer class:list={['thea-ui', 'thea-foot', classAttr]} {...rest}>
  <div class="thea-foot__inner">
    <div class="thea-foot__cta">
      <h2>{cta.title}</h2>
      <p>{cta.text}</p>
      <a class="th-btn" href={cta.href}>{cta.label}</a>
    </div>

    <div class="thea-foot__cols">
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <h3>{c.title}</h3>
          <ul>
            {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
      <div>
        <h3>Escríbenos</h3>
        <address>
          {address}<br />
          <a href={`tel:${theaBrand.phone.replace(/\s/g, '')}`}>{theaBrand.phone}</a><br />
          <a href={`mailto:${theaBrand.email}`}>{theaBrand.email}</a>
        </address>
      </div>
    </div>

    <form class="thea-foot__news" action={newsletterAction || undefined} method={newsletterAction ? 'post' : undefined} data-thea-news>
      <label for={`${uid}-mail`}>Una vez al mes, los estrenos</label>
      <div>
        <input id={`${uid}-mail`} type="email" name="email" required autocomplete="email" placeholder="tu@correo.com" />
        <button type="submit" class="th-btn">Suscribirme</button>
      </div>
      <p class="thea-foot__ok" role="status" aria-live="polite" data-thea-news-ok></p>
    </form>
  </div>

  <p class="thea-foot__mark" aria-hidden="true">{brand}</p>

  <p class="thea-foot__legal">
    <span>© {new Date().getFullYear()} {brand}. Venta autorizada · Entradas nominativas.</span>
    <span>Ribera del Duero</span>
  </p>
</footer>

<style>
  .thea-foot {
    position: relative;
    overflow: hidden;
    padding: var(--sp-16, 4rem) var(--sp-4, 1rem) var(--sp-6, 1.5rem);
    background: var(--th-bg-raised);
    color: var(--th-text);
    font-family: var(--th-font-body);
    border-top: 1px solid var(--th-border);
  }

  .thea-foot__inner {
    display: grid;
    gap: var(--sp-10, 2.5rem);
    max-width: 1240px;
    margin: 0 auto;
  }

  .thea-foot__cta h2 {
    max-width: 14ch;
    margin: 0 0 var(--sp-4, 1rem);
    font-family: var(--th-font-display);
    font-weight: 300;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .thea-foot__cta p {
    max-width: 42ch;
    margin: 0 0 var(--sp-5, 1.25rem);
    line-height: 1.6;
    color: var(--th-text-2);
  }

  .thea-foot__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6, 1.5rem);
  }

  .thea-foot h3 {
    margin: 0 0 var(--sp-3, 0.75rem);
    font: 600 0.72rem/1.2 var(--th-font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--th-accent);
  }

  .thea-foot ul {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thea-foot a:not(.th-btn) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--th-text-2);
    text-decoration: none;
  }

  .thea-foot a:not(.th-btn):hover {
    color: var(--th-brand);
    text-decoration: underline;
  }

  .thea-foot address {
    font-style: normal;
    line-height: 1.7;
    color: var(--th-text-2);
  }

  .thea-foot__news label {
    display: block;
    margin-bottom: var(--sp-2, 0.5rem);
    font-family: var(--th-font-display);
    font-size: 1.3rem;
  }

  .thea-foot__news div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2, 0.5rem);
  }

  .thea-foot__news input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--sp-3, 0.75rem);
    border: 1px solid var(--th-border-strong);
    border-radius: 2px;
    background: var(--th-bg);
    color: var(--th-text);
    font: 1rem var(--th-font-body);
  }

  .thea-foot__ok {
    min-height: 1.4em;
    margin: var(--sp-2, 0.5rem) 0 0;
    font-size: 0.9rem;
    color: var(--th-ok);
  }

  .thea-foot__mark {
    margin: var(--sp-10, 2.5rem) 0 0;
    font-family: var(--th-font-display);
    font-style: italic;
    font-weight: 700;
    font-weight: 300;
    font-size: clamp(6rem, 30vw, 22rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px var(--th-border-strong);
    user-select: none;
  }

  .thea-foot__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2, 0.5rem);
    max-width: 1240px;
    margin: var(--sp-6, 1.5rem) auto 0;
    padding-top: var(--sp-4, 1rem);
    border-top: 1px solid var(--th-border);
    font-size: 0.82rem;
    color: var(--th-text-3);
  }

  @media (min-width: 900px) {
    .thea-foot__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--sp-12, 3rem) var(--sp-16, 4rem);
    }

    .thea-foot__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .thea-foot__news {
      grid-column: 2;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-thea-news]').forEach((form) => {
    if (form.getAttribute('action')) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const ok = form.querySelector<HTMLElement>('[data-thea-news-ok]');
      const email = (form.elements.namedItem('email') as HTMLInputElement | null)?.value ?? '';
      if (ok) ok.textContent = `Hecho. Te escribiremos a ${email} (demostración).`;
      form.reset();
    });
  });
</script>
