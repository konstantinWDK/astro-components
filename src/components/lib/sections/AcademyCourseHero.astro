---
/**
 * AcademyCourseHero — Course detail header: breadcrumbs, title, rating, meta line, what you
 * will learn, and a sticky enrolment card (price, discount, CTA, what's included, guarantee).
 *
 * @param {AcademyCourse} course - Course to present.
 * @param {AcademyInstructor} instructor - Course teacher.
 * @param {AcademyCategory} category - Course category.
 * @param {string} enrollHref - Primary CTA link.
 * @param {string} coursesHref - Breadcrumb link to the catalog.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: one h1; breadcrumb nav with aria-current; the old price is announced as
 * "Antes"; the CTA is a link with a clear label; the cover is decorative.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/academy/academy-theme.css';
import { academyCourses, academyInstructors, academyCategories, formatAcademyPrice, type AcademyCourse, type AcademyInstructor, type AcademyCategory } from '../templates/academy/data';

interface OwnProps {
  course?: AcademyCourse;
  instructor?: AcademyInstructor;
  category?: AcademyCategory;
  enrollHref?: string;
  coursesHref?: string;
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const {
  course = academyCourses[0],
  instructor = academyInstructors.find((i) => i.id === (course?.instructorId ?? 'i1')) ?? academyInstructors[0],
  category = academyCategories.find((c) => c.id === (course?.categoryId ?? 'design')) ?? academyCategories[0],
  enrollHref = '/acceso',
  coursesHref = '/cursos',
  class: classAttr,
  ...rest
} = Astro.props;

const uid = `ach-${Math.random().toString(36).slice(2, 8)}`;
const discount = course.oldPrice ? Math.round((1 - course.price / course.oldPrice) * 100) : 0;
const includes = [
  `${course.hours} horas de vídeo bajo demanda`,
  `${course.lessons} clases, lecturas y ejercicios`,
  'Proyecto final con revisión',
  'Certificado verificable',
  'Acceso de por vida y en el móvil',
];
---

<section class:list={['academy-ui', 'academy-chero', classAttr]} aria-labelledby={`${uid}-title`} style={`--course-hue:${course.hue}`} {...rest}>
  <div class="academy-chero__inner">
    <div class="academy-chero__main">
      <nav class="academy-chero__crumbs" aria-label="Migas de pan">
        <a href={coursesHref}>Cursos</a><span aria-hidden="true">/</span>
        <a href={`${coursesHref}?cat=${category.id}`}>{category.name}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{course.title}</span>
      </nav>
      <h1 id={`${uid}-title`} class="academy-chero__title">{course.title}</h1>
      <p class="academy-chero__subtitle">{course.subtitle}</p>
      <p class="academy-chero__meta">
        {course.bestseller && <span class="academy-chero__flag">Más vendido</span>}
        <span><strong>★ {course.rating.toString().replace('.', ',')}</strong> ({course.reviews.toLocaleString('es-ES')} reseñas)</span>
        <span>{course.students.toLocaleString('es-ES')} alumnos</span>
        <span>Nivel {course.level.toLowerCase()}</span>
        <span>Actualizado en {course.updated}</span>
      </p>
      <p class="academy-chero__teacher">
        <span class="academy-chero__avatar" style={`--course-hue:${instructor.hue}`} aria-hidden="true">{instructor.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}</span>
        <span>Imparte <strong>{instructor.name}</strong> · {instructor.role}</span>
      </p>

      <div class="academy-chero__learn">
        <h2 class="academy-chero__learn-title">Lo que aprenderás</h2>
        <ul role="list">
          {course.learn.map((l) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              <span>{l}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="academy-chero__buy" aria-label="Matricularte en el curso">
      <div class="academy-chero__cover" aria-hidden="true">
        <svg viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="100" cy="60" r="16" /><circle cx="100" cy="60" r="32" opacity=".55" /><circle cx="100" cy="60" r="50" opacity=".28" /></svg>
        <span class="academy-chero__play">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
        </span>
      </div>
      <div class="academy-chero__buy-body">
        <p class="academy-chero__price">
          <strong>{formatAcademyPrice(course.price)}</strong>
          {course.oldPrice && <s><span class="ac-sr">Antes </span>{course.oldPrice} €</s>}
          {discount > 0 && <span class="academy-chero__off">-{discount} %</span>}
        </p>
        <a class="academy-chero__cta" href={enrollHref}>{course.price === 0 ? 'Empezar gratis' : 'Matricularme ahora'}</a>
        <a class="academy-chero__ghost" href={`${enrollHref}`}>Ver clase de muestra</a>
        <p class="academy-chero__guarantee">Garantía de devolución de 30 días</p>
        <h2 class="academy-chero__inc-title">Incluye</h2>
        <ul class="academy-chero__inc" role="list">
          {includes.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .academy-chero {
    padding: var(--sp-8, 2rem) var(--sp-4, 1rem) var(--sp-12, 3rem);
    background:
      radial-gradient(ellipse at 0% 0%, hsl(var(--course-hue) 70% 50% / 0.18), transparent 55%),
      var(--ac-bg);
    color: var(--ac-text);
    font-family: var(--ac-font-body);
  }

  .academy-chero__inner {
    display: grid;
    gap: var(--sp-8, 2rem);
    max-width: 1280px;
    margin: 0 auto;
  }

  .academy-chero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2, 0.5rem);
    margin-bottom: var(--sp-4, 1rem);
    color: var(--ac-text-3);
    font-size: 0.88rem;
  }

  .academy-chero__crumbs a {
    color: var(--ac-text-2);
    text-underline-offset: 3px;
  }

  .academy-chero__crumbs a:focus-visible,
  .academy-chero__cta:focus-visible,
  .academy-chero__ghost:focus-visible {
    outline: 2px solid var(--ac-brand);
    outline-offset: 2px;
  }

  .academy-chero__title {
    margin: 0;
    font-family: var(--ac-font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .academy-chero__subtitle {
    max-width: 640px;
    margin: var(--sp-3, 0.75rem) 0 var(--sp-4, 1rem);
    color: var(--ac-text-2);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .academy-chero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2, 0.5rem) var(--sp-4, 1rem);
    margin: 0 0 var(--sp-4, 1rem);
    color: var(--ac-text-2);
    font-size: 0.92rem;
  }

  .academy-chero__meta strong {
    color: var(--ac-brand);
  }

  .academy-chero__flag {
    padding: 0.2rem 0.65rem;
    border-radius: var(--r-full, 999px);
    background: var(--ac-brand);
    color: var(--ac-on-brand);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .academy-chero__teacher {
    display: flex;
    align-items: center;
    gap: var(--sp-3, 0.75rem);
    margin: 0 0 var(--sp-6, 1.5rem);
    color: var(--ac-text-2);
    font-size: 0.95rem;
  }

  .academy-chero__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(140deg, hsl(var(--course-hue) 62% 44%), hsl(calc(var(--course-hue) + 50) 55% 20%));
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .academy-chero__learn {
    padding: var(--sp-5, 1.25rem);
    border: 1px solid var(--ac-border);
    border-radius: var(--r-lg, 20px);
    background: var(--ac-bg-raised);
  }

  .academy-chero__learn-title,
  .academy-chero__inc-title {
    margin: 0 0 var(--sp-3, 0.75rem);
    font-family: var(--ac-font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .academy-chero__learn ul {
    display: grid;
    gap: var(--sp-3, 0.75rem) var(--sp-5, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .academy-chero__learn li {
    display: flex;
    gap: var(--sp-2, 0.5rem);
    color: var(--ac-text-2);
    line-height: 1.45;
  }

  .academy-chero__learn svg {
    flex: none;
    margin-top: 2px;
    color: var(--ac-ok);
  }

  .academy-chero__buy {
    align-self: start;
    overflow: hidden;
    border: 1px solid var(--ac-border-strong);
    border-radius: var(--r-xl, 24px);
    background: var(--ac-bg-raised);
    box-shadow: 0 24px 60px -28px rgba(0, 0, 0, 0.6);
  }

  .academy-chero__cover {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    color: rgba(255, 255, 255, 0.75);
    background: linear-gradient(140deg, hsl(var(--course-hue) 62% 42%), hsl(calc(var(--course-hue) + 50) 55% 16%));
  }

  .academy-chero__cover > svg {
    position: absolute;
    width: 60%;
  }

  .academy-chero__play {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--ac-brand);
    color: var(--ac-on-brand);
    box-shadow: 0 0 0 8px rgba(var(--ac-brand-rgb), 0.25);
  }

  .academy-chero__buy-body {
    padding: var(--sp-5, 1.25rem);
  }

  .academy-chero__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-3, 0.75rem);
    margin: 0 0 var(--sp-4, 1rem);
  }

  .academy-chero__price strong {
    font-family: var(--ac-font-display);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
  }

  .academy-chero__price s {
    color: var(--ac-text-3);
  }

  .academy-chero__off {
    color: var(--ac-ok);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .academy-chero__cta,
  .academy-chero__ghost {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: var(--r-md, 12px);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .academy-chero__cta {
    background: var(--ac-brand);
    color: var(--ac-on-brand);
  }

  .academy-chero__cta:hover {
    background: var(--ac-brand-hover);
  }

  .academy-chero__ghost {
    margin-top: var(--sp-2, 0.5rem);
    border: 1px solid var(--ac-border-strong);
    color: var(--ac-text);
  }

  .academy-chero__ghost:hover {
    border-color: var(--ac-brand);
  }

  .academy-chero__guarantee {
    margin: var(--sp-3, 0.75rem) 0 var(--sp-4, 1rem);
    color: var(--ac-text-3);
    font-size: 0.85rem;
    text-align: center;
  }

  .academy-chero__inc {
    display: grid;
    gap: var(--sp-2, 0.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ac-text-2);
    font-size: 0.92rem;
  }

  .academy-chero__inc li::before {
    content: '✓';
    margin-right: 0.6rem;
    color: var(--ac-brand);
    font-weight: 700;
  }

  @media (min-width: 720px) {
    .academy-chero__learn ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .academy-chero__inner {
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: var(--sp-12, 3rem);
    }

    .academy-chero__buy {
      position: sticky;
      top: 92px;
    }
  }
</style>
