---
/**
 * FoodRestaurantPartnerCta — B2B onboarding & partnership section for restaurants, ghost kitchens and culinary brands.
 * Promotes joining the delivery network and adopting the Kitchen OS / Backoffice software.
 *
 * @param {string} title - Section headline.
 * @param {string} subtitle - Section subheadline.
 * @param {string} partnerHref - URL for restaurant signup.
 * @param {string} demoHref - URL to test the live Backoffice & KDS dashboard.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  partnerHref?: string;
  demoHref?: string;
  className?: string;
}

const {
  title = 'Grow your restaurant revenue with BiteFlow & Kitchen OS',
  subtitle = 'Reach thousands of hungry local customers, streamline your kitchen prep with zero ticket errors, and manage delivery orders from a single intuitive tablet.',
  partnerHref = '/preview/food-delivery/partner',
  demoHref = '/preview/food-delivery/app',
  className = '',
} = Astro.props;

const benefits = [
  {
    icon: '⚡',
    title: 'Integrated Kitchen Display (KDS)',
    desc: 'Replace noisy thermal printers with live color-coded prep screens. Cut kitchen ticket turnaround times by 32%.',
  },
  {
    icon: '📈',
    title: 'Dynamic Menu CMS & 86’d Stock',
    desc: 'Run out of avocados or brioche buns? Disable items across all menus in 1 click right from the kitchen tablet.',
  },
  {
    icon: '🛵',
    title: 'Fleet Dispatch & Rider Live Tracking',
    desc: 'Automated rider assignment, accurate GPS geofencing, and frictionless customer handoffs with zero wait.',
  },
];
---

<section class={`food-partner-cta ${className}`}>
  <div class="partner-container">
    <div class="partner-card">
      <div class="partner-left">
        <span class="partner-badge">FOR RESTAURANTS &amp; GHOST KITCHENS</span>
        <h2 class="partner-title">{title}</h2>
        <p class="partner-subtitle">{subtitle}</p>

        <div class="benefits-list">
          {benefits.map((b) => (
            <div class="benefit-item">
              <span class="benefit-icon">{b.icon}</span>
              <div class="benefit-copy">
                <h3 class="benefit-title">{b.title}</h3>
                <p class="benefit-desc">{b.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="partner-actions">
          <a href={partnerHref} class="partner-btn-primary">
            <span>Register Your Kitchen</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href={demoHref} class="partner-btn-secondary">
            <span>Open Backoffice Demo</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="partner-right">
        <div class="kds-teaser-frame">
          <div class="kds-teaser-header">
            <span class="window-dot red"></span>
            <span class="window-dot yellow"></span>
            <span class="window-dot green"></span>
            <span class="kds-frame-title">Kitchen OS · Live Station View</span>
          </div>
          <div class="kds-teaser-screen">
            <div class="teaser-ticket urgent">
              <div class="ticket-header">
                <span class="ticket-ref">#BF-8921</span>
                <span class="ticket-timer timer-alert">14 min</span>
              </div>
              <p class="ticket-item">2x Truffle Smash Burger</p>
              <span class="ticket-mod">+ Extra Melted Cheddar</span>
              <span class="ticket-allergy">⚠️ NUT ALLERGY</span>
              <div class="ticket-status-bar">COOKING</div>
            </div>

            <div class="teaser-ticket normal">
              <div class="ticket-header">
                <span class="ticket-ref">#BF-8924</span>
                <span class="ticket-timer">3 min</span>
              </div>
              <p class="ticket-item">1x Diablo Pepperoni Pizza</p>
              <span class="ticket-mod">+ Hot Honey Drizzle</span>
              <div class="ticket-status-bar ready">READY</div>
            </div>
          </div>
          <div class="kds-teaser-footer">
            <span>KDS Station: Hot Line #01</span>
            <span class="kds-online-pill">Active</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .food-partner-cta {
    padding: 4.5rem 1.5rem;
    background: radial-gradient(circle at 80% 30%, rgba(234, 88, 12, 0.08) 0%, transparent 60%),
                var(--c-bg, #0b0f19);
  }

  .partner-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .partner-card {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
    padding: 3rem;
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.5), rgba(15, 23, 42, 0.9));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 960px) {
    .partner-card {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 2.5rem;
    }
  }

  .partner-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .partner-badge {
    align-self: flex-start;
    padding: 0.3rem 0.75rem;
    background: rgba(234, 88, 12, 0.15);
    border: 1px solid rgba(234, 88, 12, 0.4);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    color: #fb923c;
    letter-spacing: 0.06em;
  }

  .partner-title {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .partner-subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }

  .benefits-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .benefit-icon {
    font-size: 1.5rem;
    line-height: 1;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .benefit-copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .benefit-title {
    font-size: 1rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0;
  }

  .benefit-desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0;
  }

  .partner-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .partner-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    background: #ea580c;
    color: #ffffff;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(234, 88, 12, 0.4);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .partner-btn-primary:hover {
    background: #c2410c;
    transform: translateY(-1px);
  }

  .partner-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .partner-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Right frame KDS preview */
  .partner-right {
    display: flex;
    justify-content: center;
  }

  .kds-teaser-frame {
    width: 100%;
    max-width: 420px;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  .kds-teaser-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .window-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .window-dot.red { background: #ef4444; }
  .window-dot.yellow { background: #eab308; }
  .window-dot.green { background: #22c55e; }

  .kds-frame-title {
    margin-left: 0.5rem;
    font-size: 0.76rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .kds-teaser-screen {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .teaser-ticket {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .teaser-ticket.urgent {
    border-left: 4px solid #ef4444;
  }

  .ticket-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ticket-ref {
    font-family: monospace;
    font-size: 0.82rem;
    font-weight: 800;
    color: #ea580c;
  }

  .ticket-timer {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
  }

  .ticket-timer.timer-alert {
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
  }

  .ticket-item {
    font-size: 0.92rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .ticket-mod {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .ticket-allergy {
    font-size: 0.7rem;
    font-weight: 800;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.15);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    align-self: flex-start;
  }

  .ticket-status-bar {
    margin-top: 0.4rem;
    text-align: center;
    padding: 0.35rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 800;
    background: rgba(234, 88, 12, 0.2);
    color: #fb923c;
    letter-spacing: 0.05em;
  }

  .ticket-status-bar.ready {
    background: rgba(34, 197, 94, 0.2);
    color: #4ade80;
  }

  .kds-teaser-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background: rgba(0, 0, 0, 0.4);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.72rem;
    color: #64748b;
  }

  .kds-online-pill {
    padding: 0.1rem 0.45rem;
    background: rgba(34, 197, 94, 0.2);
    color: #4ade80;
    border-radius: 9999px;
    font-weight: 700;
  }
</style>
