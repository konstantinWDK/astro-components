---
/**
 * LawFees — Transparent fee models side by side (fixed fee, success fee, monthly retainer), each
 * with its price, explanation and the kind of matters it suits best. One option can be highlighted.
 *
 * @param {LawFeeOption[]} options - Fee models.
 * @param {string} consultHref - CTA link; the model is added as `?fee=<id>`.
 * @param {string} title - Section heading.
 * @param {string} subtitle - Supporting text.
 * @param {string} headingLevel - 'h1' | 'h2'. Default 'h2'.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: each option is an <article> named by its heading; the highlighted one also
 * says "Más elegida" in text; CTA links name the model.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/law-firm/law-theme.css';
import { lawFees, type LawFeeOption } from '../templates/law-firm/data';

interface OwnProps {
  options?: LawFeeOption[];
  consultHref?: string;
  title?: string;
  subtitle?: string;
  headingLevel?: 'h1' | 'h2';
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const {
  options = lawFees,
  consultHref = '/consulta',
  title = 'Honorarios claros desde el principio',
  subtitle = 'Antes de empezar recibes un presupuesto por escrito. Elegimos contigo el modelo que mejor te encaja.',
  headingLevel = 'h2',
  class: classAttr,
  ...rest
} = Astro.props;

const Heading = headingLevel;
const uid = `lf-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['law-ui', 'law-fees', classAttr]} aria-labelledby={`${uid}-title`} {...rest}>
  <div class="law-fees__inner">
    <header class="law-fees__head">
      <Heading id={`${uid}-title`} class="law-fees__title">{title}</Heading>
      <p class="law-fees__subtitle">{subtitle}</p>
    </header>
    <ul class="law-fees__grid" role="list">
      {options.map((o) => (
        <li>
          <article class:list={['law-fee', o.highlighted && 'is-featured']} aria-labelledby={`${uid}-${o.id}`}>
            {o.highlighted && <p class="law-fee__flag">Más elegida</p>}
            <h3 id={`${uid}-${o.id}`} class="law-fee__name">{o.name}</h3>
            <p class="law-fee__price">{o.price}</p>
            <p class="law-fee__text">{o.text}</p>
            <p class="law-fee__label">Ideal para</p>
            <ul class="law-fee__best" role="list">
              {o.best.map((b) => <li>{b}</li>)}
            </ul>
            <a class="law-fee__cta" href={`${consultHref}?fee=${o.id}`} aria-label={`Consultar sobre ${o.name.toLowerCase()}`}>Consultar este modelo</a>
          </article>
        </li>
      ))}
    </ul>
    <p class="law-fees__note">Los honorarios se calculan según los criterios orientativos del Colegio de Abogados. IVA no incluido.</p>
  </div>
</section>

<style>
  .law-fees {
    padding: var(--sp-12, 3rem) var(--sp-4, 1rem);
    background: var(--lw-bg);
    color: var(--lw-text);
    font-family: var(--lw-font-body);
  }

  .law-fees__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .law-fees__head {
    max-width: 640px;
    margin-bottom: var(--sp-8, 2rem);
  }

  .law-fees__title {
    margin: 0;
    font-family: var(--lw-font-display);
    font-weight: 600;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .law-fees__subtitle {
    margin: var(--sp-3, 0.75rem) 0 0;
    color: var(--lw-text-2);
    line-height: 1.6;
  }

  .law-fees__grid {
    display: grid;
    gap: var(--sp-4, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .law-fee {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--sp-6, 1.5rem);
    border: 1px solid var(--lw-border);
    border-radius: var(--r-xl, 24px);
    background: var(--lw-bg-raised);
    box-sizing: border-box;
  }

  .law-fee.is-featured {
    border-color: var(--lw-brand);
    background: linear-gradient(180deg, rgba(var(--lw-brand-rgb), 0.12), var(--lw-bg-raised) 60%);
    box-shadow: 0 0 0 1px var(--lw-brand);
  }

  .law-fee__flag {
    position: absolute;
    top: -13px;
    left: var(--sp-6, 1.5rem);
    margin: 0;
    padding: 0.2rem 0.8rem;
    border-radius: var(--r-full, 999px);
    background: var(--lw-brand);
    color: var(--lw-on-brand);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .law-fee__name {
    margin: 0;
    font-family: var(--lw-font-display);
    font-size: 1.9rem;
    font-weight: 600;
  }

  .law-fee__price {
    margin: var(--sp-1, 0.25rem) 0 var(--sp-3, 0.75rem);
    color: var(--lw-gold);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .law-fee__text {
    margin: 0 0 var(--sp-5, 1.25rem);
    color: var(--lw-text-2);
    line-height: 1.6;
  }

  .law-fee__label {
    margin: 0 0 var(--sp-2, 0.5rem);
    color: var(--lw-text-3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .law-fee__best {
    display: grid;
    gap: var(--sp-2, 0.5rem);
    margin: 0 0 var(--sp-6, 1.5rem);
    padding: 0;
    list-style: none;
    color: var(--lw-text-2);
  }

  .law-fee__best li::before {
    content: '§';
    margin-right: 0.6rem;
    color: var(--lw-brand);
    font-family: var(--lw-font-display);
    font-weight: 700;
  }

  .law-fee__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: auto;
    border: 1px solid var(--lw-border-strong);
    border-radius: var(--r-sm, 8px);
    color: var(--lw-text);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .law-fee__cta:hover {
    border-color: var(--lw-brand);
  }

  .law-fee.is-featured .law-fee__cta {
    border-color: var(--lw-brand);
    background: var(--lw-brand);
    color: var(--lw-on-brand);
  }

  .law-fee__cta:focus-visible {
    outline: 2px solid var(--lw-brand);
    outline-offset: 2px;
  }

  .law-fees__note {
    margin: var(--sp-5, 1.25rem) 0 0;
    color: var(--lw-text-3);
    font-size: 0.82rem;
  }

  @media (min-width: 860px) {
    .law-fees__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
