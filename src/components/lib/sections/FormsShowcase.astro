---
// FormsShowcase.astro — Premium forms section with live preview
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Forms", subtitle = "Form elements with clean animations and validation states." } = Astro.props;
---

<section class="forms-showcase">
  <div class="container">
    <div class="showcase-header">
      <span class="showcase-eyebrow">📝 Forms</span>
      <h2 class="showcase-title">{title}</h2>
      <p class="showcase-subtitle">{subtitle}</p>
    </div>

    <div class="preview-stage">
      <div class="preview-stage__inner">
        <div class="form-grid">
          <!-- Animated Input -->
          <div class="form-group">
            <div class="input-wrapper">
              <input type="text" class="input-animated" placeholder=" " readonly />
              <label class="input-label">Email address</label>
              <span class="input-border"></span>
            </div>
          </div>

          <!-- Glass Textarea -->
          <div class="form-group">
            <div class="textarea-glass">
              <span class="textarea-label">Message</span>
              <div class="textarea-mockup">
                <span class="textarea-line"></span>
                <span class="textarea-line short"></span>
                <span class="textarea-line"></span>
              </div>
            </div>
          </div>

          <!-- Custom Checkbox & Toggle -->
          <div class="form-group form-group--controls">
            <div class="checkbox-mockup">
              <div class="checkbox-box">
                <svg class="checkbox-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span class="checkbox-label">Accept terms</span>
            </div>
            <div class="toggle-mockup">
              <div class="toggle-track">
                <div class="toggle-thumb"></div>
              </div>
              <span class="toggle-label">Dark mode</span>
            </div>
          </div>

          <!-- Select Dropdown -->
          <div class="form-group">
            <div class="select-mockup">
              <span class="select-label">Category</span>
              <div class="select-display">
                <span class="select-value">Select option...</span>
                <svg class="select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="usage-code">
      <code>&lt;GlassInput type="email" label="Email" /&gt;</code>
    </div>
  </div>
</section>

<style>
  .forms-showcase {
    padding: var(--sp-16) 0;
    position: relative;
  }
  .showcase-header {
    text-align: center;
    margin-bottom: var(--sp-10);
  }
  .showcase-eyebrow {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-primary-light);
    background: rgba(184,134,11,0.1);
    border: 1px solid rgba(184,134,11,0.25);
    border-radius: var(--r-full);
    margin-bottom: var(--sp-4);
  }
  .showcase-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--c-text-1);
    margin-bottom: var(--sp-3);
  }
  .showcase-subtitle {
    font-size: 1.05rem;
    color: var(--c-text-2);
    max-width: 500px;
    margin: 0 auto;
  }

  /* Preview Stage */
  .preview-stage {
    padding: var(--sp-12);
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--r-xl);
    margin-bottom: var(--sp-6);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  .preview-stage__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6);
    width: 100%;
    max-width: 600px;
  }

  /* Animated Input */
  .input-wrapper {
    position: relative;
  }
  .input-animated {
    width: 100%;
    padding: 1rem 1rem 0.75rem;
    font-size: 0.9rem;
    font-family: var(--font-sans);
    color: var(--c-text-1);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--r-md);
    outline: none;
    transition: all 0.3s ease;
  }
  .input-label {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.9rem;
    color: var(--c-text-2);
    pointer-events: none;
    transition: all 0.25s ease;
    opacity: 0.6;
  }
  .input-animated:not(:placeholder-shown) ~ .input-label,
  .input-animated:focus ~ .input-label {
    top: 0.5rem;
    font-size: 0.7rem;
    color: var(--c-primary-light);
    opacity: 1;
  }
  .input-border {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--c-primary-light), var(--c-primary));
    border-radius: var(--r-md);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }
  .input-animated:focus ~ .input-border,
  .input-wrapper:hover .input-border {
    width: calc(100% - 2rem);
  }

  /* Glass Textarea */
  .textarea-glass {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .textarea-label {
    font-size: 0.85rem;
    color: var(--c-text-2);
    font-weight: 500;
  }
  .textarea-mockup {
    padding: 0.85rem 1rem;
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--r-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 80px;
  }
  .textarea-line {
    height: 8px;
    background: rgba(255,255,255,0.12);
    border-radius: var(--r-sm);
    width: 100%;
  }
  .textarea-line.short {
    width: 60%;
  }

  /* Checkbox & Toggle */
  .form-group--controls {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    justify-content: center;
  }
  .checkbox-mockup {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .checkbox-box {
    width: 22px;
    height: 22px;
    background: linear-gradient(135deg, var(--c-primary-light), var(--c-primary));
    border-radius: var(--r-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(184,134,11,0.3);
  }
  .checkbox-check {
    width: 14px;
    height: 14px;
    color: #0a0a0a;
  }
  .checkbox-label {
    font-size: 0.85rem;
    color: var(--c-text-2);
  }

  .toggle-mockup {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .toggle-track {
    width: 44px;
    height: 24px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--r-full);
    position: relative;
  }
  .toggle-thumb {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 18px;
    height: 18px;
    background: linear-gradient(135deg, var(--c-primary-light), var(--c-primary));
    border-radius: 50%;
    box-shadow: 0 2px 6px rgba(184,134,11,0.4);
    transition: all 0.25s ease;
  }
  .toggle-label {
    font-size: 0.85rem;
    color: var(--c-text-2);
  }

  /* Select Dropdown */
  .select-mockup {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .select-label {
    font-size: 0.85rem;
    color: var(--c-text-2);
    font-weight: 500;
  }
  .select-display {
    padding: 0.85rem 1rem;
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .select-display:hover {
    border-color: rgba(184,134,11,0.3);
    background: rgba(255,255,255,0.06);
  }
  .select-value {
    font-size: 0.9rem;
    color: var(--c-text-2);
  }
  .select-chevron {
    width: 18px;
    height: 18px;
    color: var(--c-text-2);
    opacity: 0.6;
  }

  .usage-code {
    text-align: center;
    padding: var(--sp-4);
    background: rgba(255,255,255,0.02);
    border-radius: var(--r-md);
  }
  .usage-code code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-primary-light);
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
    .preview-stage {
      padding: var(--sp-8) var(--sp-4);
    }
    .preview-stage__inner {
      min-height: auto;
    }
  }
</style>
