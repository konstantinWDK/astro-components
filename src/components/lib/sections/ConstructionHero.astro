---
/**
 * ConstructionHero — Above-the-fold landing hero for construction companies, real estate developers and general contractors.
 * Features architectural credential badges (+148.000 m² construidos, 35 años), active sites ticker,
 * project spotlight card, and direct links to ongoing developments and the budget estimator.
 *
 * @param {string} title - Main headline.
 * @param {string} subtitle - Subtitle copy.
 * @param {string} projectsHref - URL to developments catalog.
 * @param {string} estimatorHref - URL to technical budget estimator.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  projectsHref?: string;
  estimatorHref?: string;
  className?: string;
}

const {
  title = 'Construcción de Alta Precisión. Edificios Residenciales y Espacios Comerciales.',
  subtitle = 'Más de 35 años ejecutando obra nueva, promociones residenciales de lujo y sedes corporativas con máxima calificación energética y cumplimiento riguroso de plazos.',
  projectsHref = '/preview/construction/projects',
  estimatorHref = '/preview/construction/estimator',
  className = '',
} = Astro.props;
---

<section class={`construction-hero ${className}`}>
  <div class="hero-container">
    <!-- Active Site Notice Strip -->
    <div class="site-notice-strip">
      <div class="strip-left">
        <span class="live-crane-dot"></span>
        <span>6 Obras Activas en Madrid · 100% Certificaciones ISO 9001 / 14001 / 45001</span>
      </div>
      <a href={projectsHref} class="strip-link">Ver obras en ejecución →</a>
    </div>

    <div class="hero-grid">
      <!-- Left Column: Copy & CTAs -->
      <div class="hero-content">
        <div class="hero-tag">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="4" y="2" width="16" height="20" rx="2"/>
            <path d="M9 22v-4h6v4M8 6h.01M12 6h.01M16 6h.01M8 10h.01M12 10h.01M16 10h.01"/>
          </svg>
          <span>Constructora &amp; Desarrollos Inmobiliarios</span>
        </div>

        <h1 class="hero-title">{title}</h1>
        <p class="hero-subtitle">{subtitle}</p>

        <div class="hero-actions">
          <a href={projectsHref} class="btn-primary">
            <span>Explorar Proyectos y Locales</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href={estimatorHref} class="btn-secondary">
            <span>Calculadora de Presupuestos</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="2" width="16" height="20" rx="2"/>
              <line x1="8" y1="6" x2="16" y2="6"/>
              <line x1="16" y1="14" x2="16" y2="18"/>
            </svg>
          </a>
        </div>

        <!-- Metrics Row -->
        <div class="hero-metrics">
          <div class="metric-item">
            <span class="metric-num">+148.000</span>
            <span class="metric-lbl">m² construidos</span>
          </div>
          <div class="metric-div"></div>
          <div class="metric-item">
            <span class="metric-num">35 Años</span>
            <span class="metric-lbl">Solvencia técnica</span>
          </div>
          <div class="metric-div"></div>
          <div class="metric-item">
            <span class="metric-num">840+</span>
            <span class="metric-lbl">Viviendas entregadas</span>
          </div>
          <div class="metric-div"></div>
          <div class="metric-item">
            <span class="metric-num">Clase A</span>
            <span class="metric-lbl">Eficiencia Passivhaus</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Project Spotlight Card -->
      <div class="hero-spotlight">
        <div class="spotlight-card">
          <div class="spotlight-badge-row">
            <span class="badge-status">🔨 En Ejecución (70%)</span>
            <span class="badge-stage">Estructura &amp; Fachada</span>
          </div>

          <div class="spotlight-visual">
            <div class="visual-art">
              <span class="art-emoji">🏢</span>
              <div class="crane-arm"></div>
            </div>
            <div class="visual-meta">
              <span class="meta-tag">Chamberí, Madrid</span>
              <span class="meta-tag energy">Clase A BREEAM</span>
            </div>
          </div>

          <div class="spotlight-details">
            <div class="spotlight-header">
              <h3 class="spotlight-name">Residencial Caelum Chamberí</h3>
              <span class="spotlight-m2">5.400 m²</span>
            </div>
            <p class="spotlight-desc">24 Viviendas exclusivas de 2 a 4 dormitorios, piscina infinita en azotea y locales comerciales a pie de calle.</p>

            <div class="spotlight-progress-bar">
              <div class="bar-top">
                <span>Avance Certificado</span>
                <strong>70% completado</strong>
              </div>
              <div class="bar-track">
                <div class="bar-fill" style="width: 70%"></div>
              </div>
            </div>

            <div class="spotlight-actions">
              <a href={`${projectsHref}/caelum-chamberi`} class="btn-spotlight-view">Ver Ficha Técnica y Planos →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .construction-hero {
    position: relative;
    padding: 3rem 1.5rem 5rem;
    background: radial-gradient(circle at 10% 20%, rgba(245, 158, 11, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 90% 80%, rgba(30, 41, 59, 0.5) 0%, transparent 60%),
                var(--c-bg, #0b0f19);
    color: var(--c-text, #f8fafc);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .hero-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .site-notice-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.6rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    font-size: 0.82rem;
  }

  .strip-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #cbd5e1;
  }

  .live-crane-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 10px #f59e0b;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .strip-link {
    color: #f59e0b;
    font-weight: 700;
    text-decoration: none;
  }

  .strip-link:hover {
    text-decoration: underline;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-tag {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 9999px;
    color: #f59e0b;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.75rem;
    background: #f59e0b;
    color: #0f172a;
    border-radius: 10px;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(245, 158, 11, 0.4);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background: #d97706;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .hero-metrics {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .metric-num {
    font-size: 1.35rem;
    font-weight: 900;
    color: #ffffff;
  }

  .metric-lbl {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .metric-div {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Spotlight Card */
  .hero-spotlight {
    display: flex;
    justify-content: center;
  }

  .spotlight-card {
    width: 100%;
    max-width: 460px;
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .spotlight-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .badge-status {
    padding: 0.25rem 0.65rem;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #f59e0b;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .badge-stage {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .spotlight-visual {
    position: relative;
    height: 180px;
    background: radial-gradient(circle at center, rgba(245, 158, 11, 0.12) 0%, rgba(15, 23, 42, 0.9) 70%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .visual-art {
    font-size: 5rem;
    filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.5));
  }

  .visual-meta {
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: flex;
    gap: 0.4rem;
  }

  .meta-tag {
    padding: 0.2rem 0.5rem;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    font-size: 0.7rem;
    color: #cbd5e1;
  }

  .meta-tag.energy {
    background: rgba(22, 163, 74, 0.2);
    color: #4ade80;
    border: 1px solid rgba(22, 163, 74, 0.4);
  }

  .spotlight-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .spotlight-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .spotlight-m2 {
    font-size: 0.95rem;
    font-weight: 800;
    color: #f59e0b;
  }

  .spotlight-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0;
  }

  .spotlight-progress-bar {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bar-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #cbd5e1;
  }

  .bar-top strong {
    color: #f59e0b;
  }

  .bar-track {
    height: 7px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #f59e0b, #d97706);
    border-radius: 9999px;
  }

  .spotlight-actions {
    display: flex;
    padding-top: 0.5rem;
  }

  .btn-spotlight-view {
    font-size: 0.85rem;
    font-weight: 700;
    color: #f59e0b;
    text-decoration: none;
  }

  .btn-spotlight-view:hover {
    text-decoration: underline;
  }
</style>
