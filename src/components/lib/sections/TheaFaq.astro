---
/**
 * TheaFaq — Frequently asked questions as a native accordion with a contact line.
 *
 * @param {TheaFaq[]} faqs - Questions and answers.
 * @param {string} title - Section heading.
 * @param {string} contactText - Line under the list.
 * @param {string} contactHref - Link of the contact line.
 * @param {string} headingLevel - 'h1' | 'h2'. Default 'h2'.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: native <details>/<summary>; summary targets are 60px tall with a visible focus ring.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/theater/thea-theme.css';
import { theaFaqs, type TheaFaq } from '../templates/theater/data';

interface OwnProps {
  faqs?: TheaFaq[];
  title?: string;
  contactText?: string;
  contactHref?: string;
  headingLevel?: 'h1' | 'h2';
}

type Props = OwnProps & Omit<HTMLAttributes<'section'>, keyof OwnProps | 'class'> & { class?: string };

const {
  faqs = theaFaqs,
  title = 'Lo que suelen preguntarnos',
  contactText = '¿Otra duda? Escríbenos y te respondemos en el día.',
  contactHref = 'mailto:ayuda@telon.example',
  headingLevel = 'h2',
  class: classAttr,
  ...rest
} = Astro.props;

const Heading = headingLevel;
const uid = `wf-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['thea-ui', 'thea-faq', classAttr]} aria-labelledby={`${uid}-title`} {...rest}>
  <div class="thea-faq__inner">
    <Heading id={`${uid}-title`} class="thea-faq__title">{title}</Heading>
    <div class="thea-faq__list">
      {faqs.map((f) => (
        <details class="thea-faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="thea-faq__contact">{contactText} <a class="th-link" href={contactHref}>Escribir</a></p>
  </div>
</section>

<style>
  .thea-faq {
    padding: var(--sp-16, 4rem) var(--sp-4, 1rem);
    background: var(--th-bg);
    color: var(--th-text);
    font-family: var(--th-font-body);
  }

  .thea-faq__inner {
    max-width: 840px;
    margin: 0 auto;
  }

  .thea-faq__title {
    margin: 0 0 var(--sp-6, 1.5rem);
    font-family: var(--th-font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .thea-faq__list {
    border-top: 1px solid var(--th-border-strong);
  }

  .thea-faq__item {
    border-bottom: 1px solid var(--th-border);
  }

  .thea-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4, 1rem);
    min-height: 60px;
    padding: var(--sp-3, 0.75rem) 0;
    font-family: var(--th-font-display);
    font-size: 1.2rem;
    cursor: pointer;
    list-style: none;
  }

  .thea-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .thea-faq__item summary::after {
    content: '+';
    flex: none;
    font-family: var(--th-font-body);
    font-size: 1.5rem;
    color: var(--th-brand);
    transition: transform 0.25s ease;
  }

  .thea-faq__item[open] summary::after {
    transform: rotate(45deg);
  }

  .thea-faq__item p {
    margin: 0 0 var(--sp-5, 1.25rem);
    max-width: 60ch;
    line-height: 1.65;
    color: var(--th-text-2);
  }

  .thea-faq__contact {
    margin: var(--sp-6, 1.5rem) 0 0;
    color: var(--th-text-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .thea-faq__item summary::after {
      transition: none;
    }
  }
</style>
