---
/**
 * EstatePropertyMedia — Property photo with an illustrated fallback.
 * Renders the given image (lazy, with alt text), or draws an SVG scene tinted by
 * `hue` so listings look finished before real photos exist. Used by the Estate*
 * listing cards and the property gallery.
 *
 * @param {string} src - Photo URL. When omitted, the illustration is drawn.
 * @param {string} alt - Alt text for the photo or the illustration.
 * @param {string} type - Property type (flat | penthouse | house | studio | villa) — picks the facade.
 * @param {string} scene - facade | living | kitchen | bedroom | terrace. Default 'facade'.
 * @param {number} hue - Tint for the illustration (0–360). Default 18.
 * @param {string} loading - 'lazy' | 'eager'. Default 'lazy'.
 * @param {string} class - Extra class for the root.
 */
import type { HTMLAttributes } from 'astro/types';

type Scene = 'facade' | 'living' | 'kitchen' | 'bedroom' | 'terrace';

interface OwnProps {
  src?: string;
  alt: string;
  type?: 'flat' | 'penthouse' | 'house' | 'studio' | 'villa';
  scene?: Scene;
  hue?: number;
  loading?: 'lazy' | 'eager';
}

type Props = OwnProps & Omit<HTMLAttributes<'div'>, keyof OwnProps | 'class'> & { class?: string };

const { src, alt, type = 'flat', scene = 'facade', hue = 18, loading = 'lazy', class: classAttr, ...rest } = Astro.props;

const uid = `epm-${Math.random().toString(36).slice(2, 8)}`;
const sky = `hsl(${hue} 45% 62%)`;
const skyEnd = `hsl(${(hue + 30) % 360} 55% 82%)`;
const wall = `hsl(${hue} 28% 88%)`;
const wallShade = `hsl(${hue} 22% 76%)`;
const accent = `hsl(${hue} 52% 42%)`;
const glass = `hsl(${(hue + 190) % 360} 30% 32%)`;

const floors = type === 'house' ? 2 : type === 'villa' ? 2 : type === 'studio' ? 4 : 6;
const isTall = type === 'flat' || type === 'penthouse' || type === 'studio';
---

<div class:list={['estate-media', classAttr]} {...rest}>
  {src ? (
    <img class="estate-media__img" src={src} alt={alt} loading={loading} decoding="async" width="800" height="600" />
  ) : (
    <svg class="estate-media__svg" viewBox="0 0 400 300" role="img" aria-label={alt} preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color={sky} />
          <stop offset="1" stop-color={skyEnd} />
        </linearGradient>
      </defs>
      {scene === 'facade' && (
        <g>
          <rect width="400" height="300" fill={`url(#${uid}-sky)`} />
          <circle cx="320" cy="62" r="26" fill={skyEnd} opacity="0.9" />
          {isTall ? (
            <g>
              <rect x="110" y={300 - floors * 36 - 20} width="180" height={floors * 36 + 20} fill={wall} />
              <rect x="110" y={300 - floors * 36 - 20} width="22" height={floors * 36 + 20} fill={wallShade} />
              {Array.from({ length: floors }).map((_, f) => (
                <g>
                  {[0, 1, 2].map((c) => (
                    <rect x={148 + c * 46} y={300 - (f + 1) * 36} width="30" height="22" rx="2" fill={glass} />
                  ))}
                  <rect x="140" y={300 - (f + 1) * 36 + 22} width="140" height="4" fill={accent} opacity="0.55" />
                </g>
              ))}
              {type === 'penthouse' && (
                <g>
                  <rect x="140" y={300 - floors * 36 - 52} width="130" height="32" fill={wall} />
                  <rect x="152" y={300 - floors * 36 - 46} width="60" height="22" rx="2" fill={glass} />
                  <path d={`M120 ${300 - floors * 36 - 20} h170`} stroke={accent} stroke-width="5" />
                  <circle cx="240" cy={300 - floors * 36 - 40} r="9" fill={`hsl(${(hue + 100) % 360} 35% 45%)`} />
                </g>
              )}
            </g>
          ) : (
            <g>
              <rect x="0" y="250" width="400" height="50" fill={`hsl(${(hue + 100) % 360} 30% 42%)`} />
              <rect x="90" y="140" width="220" height="115" fill={wall} />
              <path d="M80 145 200 78l120 67z" fill={accent} />
              <rect x="180" y="190" width="40" height="65" rx="3" fill={wallShade} />
              <rect x="110" y="165" width="48" height="36" rx="2" fill={glass} />
              <rect x="242" y="165" width="48" height="36" rx="2" fill={glass} />
              {type === 'villa' && (
                <g>
                  <rect x="300" y="190" width="80" height="65" fill={wallShade} />
                  <rect x="20" y="262" width="120" height="22" rx="11" fill={`hsl(${(hue + 190) % 360} 55% 62%)`} />
                </g>
              )}
            </g>
          )}
          <rect x="0" y="292" width="400" height="8" fill={accent} opacity="0.4" />
        </g>
      )}
      {scene === 'living' && (
        <g>
          <rect width="400" height="300" fill={wall} />
          <rect x="0" y="220" width="400" height="80" fill={wallShade} />
          <rect x="230" y="40" width="130" height="150" rx="4" fill={`url(#${uid}-sky)`} />
          <path d="M295 40v150M230 115h130" stroke={wall} stroke-width="6" />
          <rect x="40" y="160" width="160" height="60" rx="14" fill={accent} />
          <rect x="52" y="140" width="136" height="34" rx="12" fill={accent} opacity="0.8" />
          <rect x="70" y="232" width="100" height="12" rx="6" fill={glass} opacity="0.6" />
          <circle cx="215" cy="150" r="20" fill={`hsl(${(hue + 100) % 360} 35% 45%)`} />
        </g>
      )}
      {scene === 'kitchen' && (
        <g>
          <rect width="400" height="300" fill={wall} />
          <rect x="30" y="60" width="340" height="60" rx="4" fill={wallShade} />
          <rect x="30" y="170" width="340" height="90" rx="4" fill={accent} opacity="0.85" />
          <rect x="30" y="160" width="340" height="14" fill={glass} />
          <rect x="120" y="215" width="160" height="70" rx="6" fill={wallShade} />
          <rect x="120" y="208" width="160" height="10" fill={glass} />
          <circle cx="160" cy="40" r="10" fill={skyEnd} />
          <circle cx="240" cy="40" r="10" fill={skyEnd} />
        </g>
      )}
      {scene === 'bedroom' && (
        <g>
          <rect width="400" height="300" fill={wall} />
          <rect x="0" y="230" width="400" height="70" fill={wallShade} />
          <rect x="40" y="50" width="100" height="120" rx="4" fill={`url(#${uid}-sky)`} />
          <rect x="170" y="120" width="190" height="40" rx="8" fill={accent} opacity="0.9" />
          <rect x="160" y="160" width="210" height="70" rx="10" fill={wallShade} />
          <rect x="160" y="160" width="210" height="34" rx="10" fill={skyEnd} />
          <rect x="190" y="140" width="60" height="26" rx="8" fill={wall} />
          <rect x="280" y="140" width="60" height="26" rx="8" fill={wall} />
        </g>
      )}
      {scene === 'terrace' && (
        <g>
          <rect width="400" height="300" fill={`url(#${uid}-sky)`} />
          <path d="M0 190 60 150l50 30 70-55 80 60 60-35 80 40v110H0z" fill={wallShade} opacity="0.7" />
          <rect x="0" y="210" width="400" height="90" fill={wall} />
          <path d="M0 210h400" stroke={accent} stroke-width="6" />
          {Array.from({ length: 11 }).map((_, i) => (
            <rect x={i * 38 + 6} y="170" width="4" height="40" fill={accent} />
          ))}
          <path d="M0 172h400" stroke={accent} stroke-width="4" />
          <circle cx="90" cy="250" r="22" fill={`hsl(${(hue + 100) % 360} 35% 45%)`} />
          <rect x="180" y="240" width="130" height="10" rx="5" fill={glass} />
        </g>
      )}
    </svg>
  )}
</div>

<style>
  .estate-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--estate-surface-2, #22272c);
  }

  .estate-media__img,
  .estate-media__svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
