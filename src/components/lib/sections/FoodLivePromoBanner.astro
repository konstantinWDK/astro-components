---
/**
 * FoodLivePromoBanner — High-converting promo ribbon & countdown banner for flash deals, free delivery codes, and happy hours.
 *
 * @param {string} title - Promotion headline.
 * @param {string} description - Promotion details.
 * @param {string} badgeText - Tag label (e.g. FLASH DEAL).
 * @param {string} couponCode - Coupon code to copy or apply.
 * @param {string} ctaText - Call to action button text.
 * @param {string} ctaHref - Link target for ordering.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  description?: string;
  badgeText?: string;
  couponCode?: string;
  ctaText?: string;
  ctaHref?: string;
  className?: string;
}

const {
  title = 'Night Bite Promo: 20% OFF All Smash Burgers & Artisan Pizza',
  description = 'Order between 20:00 and 23:00 tonight. Automatically applied at checkout or use code.',
  badgeText = '🔥 LIMITED TIME DEALS',
  couponCode = 'NIGHTBITE20',
  ctaText = 'Order Now & Save',
  ctaHref = '/preview/food-delivery/menu?cat=burgers',
  className = '',
} = Astro.props;
---

<section class={`food-promo-banner ${className}`}>
  <div class="promo-container">
    <div class="promo-card">
      <div class="promo-card__badge-row">
        <span class="promo-badge">{badgeText}</span>
        <div class="promo-timer">
          <span class="timer-dot"></span>
          <span>Deal active tonight until 23:59</span>
        </div>
      </div>

      <div class="promo-card__content">
        <div class="promo-copy">
          <h2 class="promo-title">{title}</h2>
          <p class="promo-desc">{description}</p>
        </div>

        <div class="promo-actions">
          <div class="coupon-box" title="Click to copy coupon code">
            <span class="coupon-label">PROMO CODE</span>
            <span class="coupon-value">{couponCode}</span>
          </div>

          <a href={ctaHref} class="promo-btn">
            <span>{ctaText}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .food-promo-banner {
    padding: 1.5rem 1.5rem 3rem;
    background: var(--c-bg, #0b0f19);
  }

  .promo-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .promo-card {
    position: relative;
    padding: 2rem 2.5rem;
    background: linear-gradient(135deg, rgba(234, 88, 12, 0.22) 0%, rgba(30, 41, 59, 0.8) 100%);
    border: 1px solid rgba(234, 88, 12, 0.35);
    border-radius: 20px;
    box-shadow: 0 15px 35px -5px rgba(234, 88, 12, 0.15);
    overflow: hidden;
  }

  .promo-card__badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .promo-badge {
    padding: 0.25rem 0.65rem;
    background: #ea580c;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }

  .promo-timer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #fdba74;
  }

  .timer-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f97316;
    animation: blink 1.5s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .promo-card__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .promo-copy {
    max-width: 650px;
  }

  .promo-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .promo-desc {
    font-size: 0.92rem;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.5;
  }

  .promo-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .coupon-box {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px dashed rgba(234, 88, 12, 0.6);
    border-radius: 10px;
  }

  .coupon-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.05em;
  }

  .coupon-value {
    font-family: monospace;
    font-size: 1.15rem;
    font-weight: 800;
    color: #fdba74;
    letter-spacing: 0.06em;
  }

  .promo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    background: #ffffff;
    color: #0b0f19;
    border-radius: 10px;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .promo-btn:hover {
    transform: translateY(-2px);
    background: #f8fafc;
  }
</style>
