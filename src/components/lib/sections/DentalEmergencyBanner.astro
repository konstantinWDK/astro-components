---
/**
 * DentalEmergencyBanner — Emergency dental triage and 24/7 acute toothache care banner.
 *
 * @param {string} phone - Hotline phone number.
 * @param {string} whatsapp - WhatsApp number.
 * @param {string} bookHref - Direct booking URL.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  phone?: string;
  whatsapp?: string;
  bookHref?: string;
  className?: string;
}

const {
  phone = '+34 600 911 200',
  whatsapp = '+34600911200',
  bookHref = '/preview/dental/book?treatment=root-canal',
  className = '',
} = Astro.props;
---

<section class={`dental-emergency-banner ${className}`}>
  <div class="banner-inner">
    <div class="emergency-badge-pulse">
      <span class="pulse-dot"></span>
      EMERGENCY DENTAL CARE · SAME-DAY RELIEF
    </div>

    <h2 class="emergency-title">Severe Toothache or Dental Trauma?</h2>
    <p class="emergency-desc">
      We keep open reserve slots every morning and afternoon specifically for dental emergencies, chipped teeth, and acute pain relief. Zero waiting time upon arrival.
    </p>

    <!-- Quick Triage Tips -->
    <div class="triage-tips-grid">
      <div class="triage-card">
        <strong>Knocked-Out Tooth?</strong>
        <span>Do not scrub root. Place in whole milk or saliva and reach our clinic within 60 minutes.</span>
      </div>
      <div class="triage-card">
        <strong>Acute Throbbing Pain?</strong>
        <span>Avoid extreme heat or cold. Take anti-inflammatory (ibuprofen) and call our dentist hotline.</span>
      </div>
      <div class="triage-card">
        <strong>Broken Crown or Filling?</strong>
        <span>Keep the fragment if possible. Avoid chewing on the affected quadrant until examined.</span>
      </div>
    </div>

    <div class="emergency-actions">
      <a href={`tel:${phone}`} class="btn-phone-emergency">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Call Emergency Hotline: {phone}
      </a>

      <a href={`https://wa.me/${whatsapp}?text=Hello%20Dentis,%20I%20have%20an%20urgent%20dental%20emergency`} target="_blank" rel="noopener" class="btn-wa-emergency">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        Direct WhatsApp Triage
      </a>

      <a href={bookHref} class="btn-book-emergency">
        Book Emergency Slot Online →
      </a>
    </div>
  </div>
</section>

<style>
  .dental-emergency-banner {
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.08) 0%, rgba(2, 132, 199, 0.06) 100%);
    border-top: 1px solid rgba(220, 38, 38, 0.2);
    border-bottom: 1px solid rgba(220, 38, 38, 0.2);
    padding: 4.5rem 1.5rem;
  }

  .banner-inner {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .emergency-badge-pulse {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(220, 38, 38, 0.15);
    border: 1px solid rgba(220, 38, 38, 0.3);
    color: #dc2626;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #dc2626;
    animation: p-red 1.4s infinite;
  }

  @keyframes p-red {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.8); opacity: 0.4; }
  }

  .emergency-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .emergency-desc {
    font-size: 1.05rem;
    color: var(--c-text-2);
    line-height: 1.6;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }

  .triage-tips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .triage-card {
    background: var(--c-card-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: 1.25rem;
    box-shadow: var(--dental-shadow-sm);
  }

  .triage-card strong {
    display: block;
    font-size: 0.95rem;
    color: var(--c-text-1);
    margin-bottom: 6px;
  }

  .triage-card span {
    font-size: 0.82rem;
    color: var(--c-text-3);
    line-height: 1.45;
  }

  .emergency-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .btn-phone-emergency {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #dc2626;
    color: #fff;
    padding: 12px 24px;
    border-radius: var(--r-md);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
    transition: all 0.2s;
  }

  .btn-phone-emergency:hover {
    background: #b91c1c;
    transform: translateY(-2px);
  }

  .btn-wa-emergency {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #25d366;
    color: #fff;
    padding: 12px 22px;
    border-radius: var(--r-md);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-wa-emergency:hover {
    background: #20ba5a;
    transform: translateY(-2px);
  }

  .btn-book-emergency {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--c-card-bg);
    color: var(--c-text-1);
    border: 1px solid var(--c-border);
    padding: 12px 20px;
    border-radius: var(--r-md);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-book-emergency:hover {
    background: var(--dental-surface-hover);
    border-color: var(--c-primary);
  }
</style>

