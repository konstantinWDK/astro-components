---
/**
 * ConstructionInquiryForm — Feasibility study and project consultation form for land owners, promoters and investors.
 * Collects plot location, building typology, estimated budget, surface area, and technical architectural requirements.
 *
 * @param {string} title - Section headline.
 * @param {string} subtitle - Subtitle copy.
 * @param {string} phone - Direct contractor contact number.
 * @param {string} email - Commercial email.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  phone?: string;
  email?: string;
  className?: string;
}

const {
  title = 'Inicie su Proyecto con Strukto',
  subtitle = 'Solicite un estudio de viabilidad técnica y económica sin compromiso. Nuestro equipo de ingenieros y jefes de obra le contactará en 24 horas.',
  phone = '+34 912 400 900',
  email = 'contacto@strukto-constructora.es',
  className = '',
} = Astro.props;
---

<section class={`construction-inquiry-section ${className}`} id="inquiry-form">
  <div class="inquiry-container">
    <div class="inquiry-grid">
      <!-- Left Column: Contact details & Guarantees -->
      <div class="inquiry-info">
        <span class="eyebrow">Atención a Promotores &amp; Clientes</span>
        <h2 class="info-title">{title}</h2>
        <p class="info-desc">{subtitle}</p>

        <div class="contact-channels">
          <a href={`tel:${phone.replace(/\s+/g, '')}`} class="channel-card">
            <span class="channel-icon">📞</span>
            <div class="channel-text">
              <span class="ch-lbl">Llamada Directa (Dpto. de Contratación)</span>
              <strong class="ch-val">{phone}</strong>
            </div>
          </a>

          <a href={`mailto:${email}`} class="channel-card">
            <span class="channel-icon">✉️</span>
            <div class="channel-text">
              <span class="ch-lbl">Envío de Proyectos &amp; Mediciones</span>
              <strong class="ch-val">{email}</strong>
            </div>
          </a>

          <div class="channel-card static">
            <span class="channel-icon">🏢</span>
            <div class="channel-text">
              <span class="ch-lbl">Oficinas Centrales &amp; Showroom</span>
              <strong class="ch-val">Calle Velázquez 110, Barrio de Salamanca, Madrid</strong>
            </div>
          </div>
        </div>

        <!-- Guarantee Stamps -->
        <div class="guarantees-list">
          <div class="guarantee-item">
            <span class="g-check">🛡️</span>
            <span>Seguro de Responsabilidad Civil de 10 M€ &amp; Garantía Decenal</span>
          </div>
          <div class="guarantee-item">
            <span class="g-check">📋</span>
            <span>Presupuesto Cerrado por Contrata con Penalización por Retraso</span>
          </div>
          <div class="guarantee-item">
            <span class="g-check">👷</span>
            <span>100% Personal Propio con Cualificación Acreditada TPC</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Consultation Form -->
      <div class="inquiry-form-card">
        <h3 class="form-card-title">Estudio Técnico de Viabilidad</h3>
        <p class="form-card-sub">Detalle los parámetros de su proyecto para asignar al jefe de obra especialista.</p>

        <form class="project-form">
          <div class="form-row-2">
            <div class="form-field">
              <label>Nombre y Apellidos</label>
              <input type="text" placeholder="e.g. Carlos Gómez" required />
            </div>
            <div class="form-field">
              <label>Empresa / Promotora (Opcional)</label>
              <input type="text" placeholder="e.g. Promociones Norte S.L." />
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-field">
              <label>Teléfono de Contacto</label>
              <input type="tel" placeholder="+34 600 000 000" required />
            </div>
            <div class="form-field">
              <label>Correo Electrónico</label>
              <input type="email" placeholder="carlos@empresa.com" required />
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-field">
              <label>Tipología de Obra</label>
              <select required>
                <option value="">Seleccione tipología...</option>
                <option value="residencial-colectiva">Edificio Residencial Colectivo</option>
                <option value="villas-lujo">Villas Unifamiliares / Passivhaus</option>
                <option value="comercial-oficinas">Edificio Terciario / Oficinas</option>
                <option value="locales">Acondicionamiento de Locales Comerciales</option>
                <option value="industrial">Nave Industrial o Logística</option>
                <option value="rehabilitacion">Rehabilitación Integral de Edificio</option>
              </select>
            </div>
            <div class="form-field">
              <label>Superficie Estimada (m²)</label>
              <input type="number" placeholder="e.g. 1.200" step="50" required />
            </div>
          </div>

          <div class="form-field">
            <label>Ubicación de la Parcela / Inmueble</label>
            <input type="text" placeholder="e.g. Calle Serrano 40, Madrid o Parcela en Pozuelo" required />
          </div>

          <div class="form-field">
            <label>Estado Actual del Proyecto</label>
            <div class="state-chips">
              <label class="state-pill">
                <input type="radio" name="state" value="solar" checked />
                <span>Dispongo de Terreno / Solar</span>
              </label>
              <label class="state-pill">
                <input type="radio" name="state" value="proyecto" />
                <span>Tengo Proyecto de Arquitectura</span>
              </label>
              <label class="state-pill">
                <input type="radio" name="state" value="licencia" />
                <span>Con Licencia Concedida</span>
              </label>
            </div>
          </div>

          <button type="submit" class="btn-submit-inquiry">
            <span>Enviar Consulta Técnica</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .construction-inquiry-section {
    padding: 5rem 1.5rem 6rem;
    background: radial-gradient(circle at 10% 20%, rgba(245, 158, 11, 0.08) 0%, transparent 50%),
                var(--c-bg, #0b0f19);
    color: var(--c-text, #f8fafc);
  }

  .inquiry-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .inquiry-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: flex-start;
  }

  @media (max-width: 960px) {
    .inquiry-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .inquiry-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #f59e0b;
  }

  .info-title {
    font-size: clamp(2rem, 3.2vw, 2.7rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.15;
  }

  .info-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 1.25rem;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .channel-card:not(.static):hover {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.4);
    transform: translateX(3px);
  }

  .channel-icon {
    font-size: 1.4rem;
  }

  .channel-text {
    display: flex;
    flex-direction: column;
  }

  .ch-lbl {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .ch-val {
    font-size: 0.92rem;
    color: #ffffff;
  }

  .guarantees-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: #cbd5e1;
  }

  /* Form Card */
  .inquiry-form-card {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-card-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .form-card-sub {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  .project-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-field label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .form-field input,
  .form-field select {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.85rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .form-field input:focus,
  .form-field select:focus {
    border-color: #f59e0b;
  }

  .state-chips {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .state-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    font-size: 0.78rem;
    color: #cbd5e1;
    cursor: pointer;
  }

  .state-pill input {
    accent-color: #f59e0b;
  }

  .btn-submit-inquiry {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem;
    background: #f59e0b;
    color: #0f172a;
    border: none;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
    margin-top: 0.5rem;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-submit-inquiry:hover {
    background: #d97706;
    transform: translateY(-1px);
  }
</style>
