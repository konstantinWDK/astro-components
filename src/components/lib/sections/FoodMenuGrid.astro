---
/**
 * FoodMenuGrid — Responsive grid displaying restaurant dishes, categories, dietary badges, and quick-add actions.
 * Perfect for delivery storefronts, digital menus, and online ordering catalogs.
 *
 * @param {Array} dishes - List of FoodDish objects.
 * @param {string} title - Section heading.
 * @param {string} subtitle - Section description.
 * @param {string} activeCategory - Optional active filter.
 * @param {string} className - Optional CSS class.
 */
import { foodDishes, type FoodDish } from '../templates/food-delivery/data';

interface Props {
  dishes?: FoodDish[];
  title?: string;
  subtitle?: string;
  activeCategory?: string;
  className?: string;
}

const {
  dishes = foodDishes,
  title = 'Our Signature Kitchen Creations',
  subtitle = 'Crafted with sustainably sourced, premium ingredients. Cooked fresh upon order.',
  activeCategory = 'all',
  className = '',
} = Astro.props;

const filteredDishes = activeCategory === 'all'
  ? dishes
  : dishes.filter(d => d.category === activeCategory);
---

<section class={`food-menu-grid ${className}`} id="menu-catalog">
  <div class="menu-container">
    <div class="menu-header">
      <div class="header-left">
        <span class="eyebrow">Direct From The Kitchen</span>
        <h2 class="menu-title">{title}</h2>
        <p class="menu-subtitle">{subtitle}</p>
      </div>
      <div class="header-badge">
        <span class="badge-icon">⚡</span>
        <span class="badge-text">Showing <strong>{filteredDishes.length}</strong> fresh dishes</span>
      </div>
    </div>

    <div class="dishes-grid">
      {filteredDishes.map((dish) => {
        const isSoldOut = dish.stockStatus === 'sold_out';
        const isLowStock = dish.stockStatus === 'low_stock';
        const hasModifiers = dish.modifiers && dish.modifiers.length > 0;

        return (
          <article class={`dish-card ${isSoldOut ? 'is-sold-out' : ''}`} id={dish.id}>
            <div class="dish-card__visual">
              <div class="dish-card__emoji">
                {dish.category === 'burgers' ? '🍔' :
                 dish.category === 'pizza' ? '🍕' :
                 dish.category === 'bowls' ? '🥗' :
                 dish.category === 'sides' ? '🍟' :
                 dish.category === 'drinks' ? '🥤' : '🍰'}
              </div>

              {dish.popular && (
                <span class="dish-ribbon">⭐ Bestseller</span>
              )}

              {isSoldOut ? (
                <div class="sold-out-overlay">
                  <span>Sold Out (86'd)</span>
                </div>
              ) : isLowStock ? (
                <span class="stock-tag low-stock">Only 4 left</span>
              ) : null}

              <div class="dish-card__prep">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span>{dish.prepTimeMin} min</span>
              </div>
            </div>

            <div class="dish-card__body">
              <div class="dish-card__meta">
                <span class="dish-category">{dish.category.toUpperCase()}</span>
                <span class="dish-calories">{dish.calories} kcal</span>
              </div>

              <h3 class="dish-name">{dish.name}</h3>
              <p class="dish-desc">{dish.description}</p>

              <!-- Dietary badges -->
              {dish.dietary && dish.dietary.length > 0 && (
                <div class="dish-dietary">
                  {dish.dietary.map((diet) => (
                    <span class={`diet-tag ${diet}`}>
                      {diet === 'vegan' ? '🌱 Vegan' :
                       diet === 'vegetarian' ? '🧀 Vegetarian' :
                       diet === 'gluten_free' ? '🌾 Gluten-Free' :
                       diet === 'spicy' ? '🌶️ Spicy' : '✨ Halal'}
                    </span>
                  ))}
                </div>
              )}

              <div class="dish-card__footer">
                <div class="dish-price-wrap">
                  <span class="price-val">{dish.price.toFixed(2)} €</span>
                </div>

                <div class="dish-action-wrap">
                  {isSoldOut ? (
                    <button type="button" class="btn-dish-action disabled" disabled>
                      Sold Out
                    </button>
                  ) : hasModifiers ? (
                    <a href={`/preview/food-delivery/menu#customizer`} class="btn-dish-action customize">
                      <span>Customize</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 5v14M5 12h14"/>
                      </svg>
                    </a>
                  ) : (
                    <button type="button" class="btn-dish-action add">
                      <span>Add</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 5v14M5 12h14"/>
                      </svg>
                    </button>
                  )}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .food-menu-grid {
    padding: 3.5rem 1.5rem 5rem;
    background: var(--c-bg, #0b0f19);
    color: var(--c-text, #f8fafc);
  }

  .menu-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .menu-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ea580c;
  }

  .menu-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .menu-subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
    margin: 0;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9999px;
    font-size: 0.82rem;
    color: #cbd5e1;
  }

  .dishes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .dish-card {
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .dish-card:hover {
    transform: translateY(-3px);
    border-color: rgba(234, 88, 12, 0.3);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .dish-card.is-sold-out {
    opacity: 0.65;
    filter: grayscale(0.5);
  }

  .dish-card__visual {
    position: relative;
    height: 160px;
    background: radial-gradient(circle at center, rgba(234, 88, 12, 0.1) 0%, rgba(15, 23, 42, 0.8) 80%);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .dish-card__emoji {
    font-size: 4rem;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.4));
  }

  .dish-ribbon {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 0.2rem 0.55rem;
    background: #ea580c;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 6px;
    letter-spacing: 0.02em;
  }

  .stock-tag.low-stock {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 0.2rem 0.55rem;
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 6px;
  }

  .sold-out-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ef4444;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .dish-card__prep {
    position: absolute;
    bottom: 8px;
    right: 10px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    border-radius: 9999px;
    font-size: 0.72rem;
    color: #cbd5e1;
  }

  .dish-card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.65rem;
  }

  .dish-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .dish-category {
    color: #ea580c;
    letter-spacing: 0.06em;
  }

  .dish-calories {
    color: #64748b;
  }

  .dish-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }

  .dish-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dish-dietary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.2rem;
  }

  .diet-tag {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
  }

  .diet-tag.vegan {
    background: rgba(22, 163, 74, 0.15);
    color: #4ade80;
  }

  .diet-tag.spicy {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
  }

  .dish-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .price-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
  }

  .btn-dish-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: background 0.15s ease, transform 0.1s ease;
  }

  .btn-dish-action.add {
    background: rgba(234, 88, 12, 0.15);
    border: 1px solid rgba(234, 88, 12, 0.4);
    color: #fb923c;
  }

  .btn-dish-action.add:hover {
    background: #ea580c;
    color: #ffffff;
  }

  .btn-dish-action.customize {
    background: #ea580c;
    color: #ffffff;
  }

  .btn-dish-action.customize:hover {
    background: #c2410c;
  }

  .btn-dish-action.disabled {
    background: rgba(255, 255, 255, 0.05);
    color: #64748b;
    cursor: not-allowed;
  }
</style>

