---
/**
 * ConstructionFooter — Footer drawn as the title block (cajetín) of a plan sheet: company and
 * registration cells, link columns, head office, certifications, a scale bar and a north arrow
 * that turns to face the pointer.
 *
 * @param {string} brand - Company name.
 * @param {Array<{title: string, links: Array<{label: string, href: string}>}>} columns - Link columns.
 * @param {{address: string, phone: string, email: string, hours: string, rea: string, iso: string[]}} company - Company data.
 * @param {string} copyright - Legal line.
 * @param {string} variant - 'sheet' (bordered title block) | 'plain'. Default 'sheet'.
 * @param {string} size - 'md' | 'lg' brand size. Default 'md'.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: <footer> landmark with labelled <nav> columns; contact links have text; the north
 * arrow and scale bar are decorative (aria-hidden) and stop moving with prefers-reduced-motion.
 */
import type { HTMLAttributes } from 'astro/types';
import '../templates/construction/construction-theme.css';
import { constructionCompany } from '../templates/construction/data';

interface Column { title: string; links: Array<{ label: string; href: string }> }

interface OwnProps {
  brand?: string;
  columns?: Column[];
  company?: { address: string; phone: string; email: string; hours: string; rea: string; iso: string[] };
  copyright?: string;
  variant?: 'sheet' | 'plain';
  size?: 'md' | 'lg';
}

type Props = OwnProps & Omit<HTMLAttributes<'footer'>, keyof OwnProps | 'class'> & { class?: string };

const {
  brand = 'Strukto',
  columns = [
    { title: 'Empresa', links: [{ label: 'Proyectos', href: '#proyectos' }, { label: 'Presupuesto', href: '#presupuesto' }] },
    { title: 'Clientes', links: [{ label: 'Contacto', href: '#contacto' }, { label: 'Site OS', href: '#acceso' }] },
  ],
  company = constructionCompany,
  copyright = `© ${new Date().getFullYear()} Strukto`,
  variant = 'sheet',
  size = 'md',
  class: classAttr,
  ...rest
} = Astro.props;

const uid = `sk-ft-${Math.random().toString(36).slice(2, 7)}`;
const telHref = `tel:${company.phone.replace(/\s+/g, '')}`;
---

<footer class:list={['sk-ui', 'sk-ft', 'sk-grid-bg', `sk-ft--${variant}`, `sk-ft--${size}`, classAttr]} data-sk-ft {...rest}>
  <div class="sk-ft__sheet">
    <div class="sk-ft__brand">
      <p class="sk-ft__name">{brand}</p>
      <p class="sk-ft__tag sk-mono">Construcción · Promoción · Rehabilitación</p>
      <div class="sk-ft__marks" aria-hidden="true">
        <svg class="sk-ft__north" viewBox="0 0 60 60" width="56" height="56" data-north>
          <circle cx="30" cy="30" r="26" />
          <path d="M30 8 38 38 30 32 22 38z" class="n-arrow" />
          <text x="30" y="56" text-anchor="middle">N</text>
        </svg>
        <svg class="sk-ft__scale" viewBox="0 0 160 30" width="160" height="30">
          <path d="M5 14h150M5 9v10M42.5 9v10M80 9v10M117.5 9v10M155 9v10" />
          <rect x="5" y="12" width="37.5" height="4" /><rect x="80" y="12" width="37.5" height="4" />
          <text x="5" y="28">0</text><text x="74" y="28">10</text><text x="145" y="28">20 m</text>
        </svg>
      </div>
    </div>

    {columns.map((c, i) => (
      <nav class="sk-ft__cell" aria-labelledby={`${uid}-${i}`}>
        <h2 id={`${uid}-${i}`} class="sk-ft__h sk-mono">{c.title}</h2>
        <ul role="list">
          {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    ))}

    <div class="sk-ft__cell">
      <h2 class="sk-ft__h sk-mono">Sede</h2>
      <address>
        <p>{company.address}</p>
        <p>{company.hours}</p>
        <p><a href={telHref}>{company.phone}</a></p>
        <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
      </address>
    </div>

    <dl class="sk-ft__legal sk-mono">
      <div><dt>Registro</dt><dd>{company.rea}</dd></div>
      <div><dt>Certificaciones</dt><dd>{company.iso.join(' · ')}</dd></div>
      <div><dt>Hoja</dt><dd>01 / 01</dd></div>
      <div><dt>Fecha</dt><dd>{new Date().getFullYear()}</dd></div>
    </dl>
  </div>
  <p class="sk-ft__copy sk-mono">{copyright}</p>
</footer>

<script>
  function initSkFt() {
    document.querySelectorAll<HTMLElement>('[data-sk-ft]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = 'true';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const north = root.querySelector<SVGSVGElement>('[data-north]');
      if (!north) return;
      let raf = 0;
      root.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = north.getBoundingClientRect();
          const a = (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI + 90;
          north.style.transform = `rotate(${a.toFixed(1)}deg)`;
        });
      });
      root.addEventListener('pointerleave', () => (north.style.transform = ''));
    });
  }
  initSkFt();
  document.addEventListener('astro:page-load', initSkFt);
</script>

<style>
  .sk-ft {
    position: relative;
    padding: clamp(2.5rem, 6vw, 4rem) var(--sp-4, 1rem) var(--sp-5, 1.25rem);
    color: var(--sk-ink);
    font-family: var(--sk-font-body);
    border-top: 1px solid var(--sk-line);
  }

  .sk-ft__sheet {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    background: var(--sk-glass);
  }

  .sk-ft--sheet .sk-ft__sheet {
    border: 1px solid var(--sk-line);
  }

  .sk-ft__brand,
  .sk-ft__cell {
    padding: 18px;
    border-right: 1px solid var(--sk-line-soft);
    border-bottom: 1px solid var(--sk-line-soft);
  }

  .sk-ft__brand {
    grid-column: span 2;
  }

  @media (max-width: 520px) {
    .sk-ft__brand {
      grid-column: auto;
    }
  }

  .sk-ft__name {
    margin: 0;
    font-family: var(--sk-font-display);
    font-stretch: 125%;
    font-size: clamp(2.4rem, 8vw, 3.6rem);
    font-weight: 800;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .sk-ft--lg .sk-ft__name {
    font-size: clamp(3rem, 12vw, 6rem);
  }

  .sk-ft__tag {
    margin: 8px 0 0;
    color: var(--sk-ink-3);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .sk-ft__marks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 18px;
  }

  .sk-ft__north {
    transition: transform 0.4s var(--sk-ease);
  }

  .sk-ft__north circle {
    fill: none;
    stroke: var(--sk-line);
  }

  .sk-ft__north .n-arrow {
    fill: var(--sk-accent);
  }

  .sk-ft__north text,
  .sk-ft__scale text {
    fill: var(--sk-ink-3);
    font-family: var(--sk-font-mono);
    font-size: 9px;
  }

  .sk-ft__scale path {
    fill: none;
    stroke: var(--sk-line);
  }

  .sk-ft__scale rect {
    fill: var(--sk-line);
  }

  .sk-ft__h {
    margin: 0 0 8px;
    color: var(--sk-accent);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .sk-ft ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sk-ft__cell a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--sk-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .sk-ft__cell a:hover {
    color: var(--sk-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .sk-ft a:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 2px;
  }

  .sk-ft address {
    font-style: normal;
    color: var(--sk-ink-2);
  }

  .sk-ft address p {
    margin: 0;
  }

  .sk-ft__legal {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    margin: 0;
    font-size: 0.72rem;
  }

  .sk-ft__legal div {
    padding: 10px 18px;
    border-right: 1px solid var(--sk-line-soft);
  }

  .sk-ft__legal dt {
    color: var(--sk-ink-3);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  .sk-ft__legal dd {
    margin: 2px 0 0;
  }

  .sk-ft__copy {
    max-width: 1280px;
    margin: 12px auto 0;
    color: var(--sk-ink-3);
    font-size: 0.72rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .sk-ft__north {
      transition: none;
    }
  }
</style>
