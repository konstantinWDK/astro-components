---
/**
 * ConstructionStageTimeline — 5-stage turnkey construction workflow and engineering methodology.
 * Explains each construction phase from licensing, foundation and structure to high-end finishes and occupancy handover.
 *
 * @param {string} title - Section headline.
 * @param {string} subtitle - Subtitle copy.
 * @param {string} ctaHref - Link target for consulting engineers.
 * @param {string} className - Optional CSS class.
 */
interface Props {
  title?: string;
  subtitle?: string;
  ctaHref?: string;
  className?: string;
}

const {
  title = 'Metodología Constructiva Llave en Mano',
  subtitle = 'Rigor técnico, control exhaustivo de costes y supervisión continua en cada hito de la edificación.',
  ctaHref = '/preview/construction/estimator',
  className = '',
} = Astro.props;

const phases = [
  {
    step: '01',
    title: 'Estudio de Viabilidad & Licencias',
    time: 'Meses 1 - 3',
    desc: 'Análisis urbanístico de la parcela, anteproyecto, redacción del Proyecto de Ejecución visado por colegio oficial y tramitación de licencias municipales de obra mayor.',
    highlights: ['Estudio geotécnico y topográfico', 'Modelado BIM 3D con detección de colisiones', 'Gestión integral de tasas e ICIO'],
    icon: '📐',
  },
  {
    step: '02',
    title: 'Cimentación & Estructura de Hormigón',
    time: 'Meses 4 - 8',
    desc: 'Movimiento de tierras, muros pantalla y ejecución de forjados de hormigón armado o postensado con control acreditado de probetas en laboratorio independiente.',
    highlights: ['Ensayos de compresión HA-30', 'Estructuras sismorresistentes CTE-SE', 'Tiempos de fraguado rigurosos'],
    icon: '🏗️',
  },
  {
    step: '03',
    title: 'Envolvente Térmica & Fachada Ventilada',
    time: 'Meses 9 - 13',
    desc: 'Cerramientos exteriores estancos, rotura de puente térmico en carpinterías, fachadas ventiladas de piedra natural y cubiertas planas invertidas impermeabilizadas.',
    highlights: ['Aislamiento térmico continuo 12-16 cm', 'Triple acristalamiento bajo emisivo', 'Blower Door test de estanqueidad al aire'],
    icon: '🧱',
  },
  {
    step: '04',
    title: 'Instalaciones MEP & Climatización Renovable',
    time: 'Meses 14 - 17',
    desc: 'Tendido de conductos, fontanería multicapa, suelo radiante/refrescante alimentado por aerotermia o geotermia y sistema de ventilación VMC con recuperación de calor.',
    highlights: ['Pruebas de presión a 6 bar', 'Instalación fotovoltaica autoconsumo', 'Domótica KNX para control energético'],
    icon: '⚡',
  },
  {
    step: '05',
    title: 'Acabados de Lujo, LPO & Entrega de Llaves',
    time: 'Meses 18 - 20',
    desc: 'Revestimientos porcelánicos de gran formato, carpintería interior lacada a medida, tramitación de Licencia de Primera Ocupación (LPO) y entrega con garantía decenal.',
    highlights: ['Auditoría de calidad punto por punto', 'Seguro decenal de daños suscrito', 'Libro del Edificio y manual de uso'],
    icon: '🔑',
  },
];
---

<section class={`construction-stage-timeline ${className}`}>
  <div class="timeline-container">
    <div class="timeline-head">
      <span class="eyebrow">Garantía de Ejecución &amp; Plazos</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-sub">{subtitle}</p>
    </div>

    <div class="stages-track">
      {phases.map((p) => (
        <div class="stage-card">
          <div class="stage-card__header">
            <div class="stage-num-box">
              <span class="stage-icon">{p.icon}</span>
              <span class="stage-num">FASE {p.step}</span>
            </div>
            <span class="stage-time">{p.time}</span>
          </div>

          <h3 class="stage-title">{p.title}</h3>
          <p class="stage-desc">{p.desc}</p>

          <ul class="stage-highlights">
            {p.highlights.map((h) => (
              <li>
                <span class="check-icon">✓</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Bar -->
    <div class="timeline-footer">
      <div class="footer-copy">
        <h4 class="footer-title">¿Tienes un solar o proyecto en mente?</h4>
        <p class="footer-desc">Calcula el presupuesto paramétrico o agenda una reunión técnica con nuestros jefes de obra.</p>
      </div>
      <a href={ctaHref} class="btn-footer-cta">
        <span>Calcular Presupuesto Online</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .construction-stage-timeline {
    padding: 5rem 1.5rem 6rem;
    background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.06) 0%, transparent 60%),
                #0f172a;
    color: #f8fafc;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .timeline-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .timeline-head {
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #f59e0b;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .section-sub {
    font-size: 1rem;
    color: #94a3b8;
    margin: 0;
  }

  /* Stages Grid */
  .stages-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .stage-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .stage-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.4);
    background: rgba(30, 41, 59, 0.75);
  }

  .stage-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stage-num-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stage-icon {
    font-size: 1.5rem;
  }

  .stage-num {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #f59e0b;
  }

  .stage-time {
    font-size: 0.75rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .stage-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }

  .stage-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: #94a3b8;
    margin: 0;
  }

  .stage-highlights {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 0.85rem;
  }

  .stage-highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #cbd5e1;
  }

  .check-icon {
    color: #10b981;
    font-weight: 800;
  }

  /* Footer bar */
  .timeline-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding: 2rem 2.5rem;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(30, 41, 59, 0.7) 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 20px;
    flex-wrap: wrap;
  }

  .footer-copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .footer-desc {
    font-size: 0.9rem;
    color: #cbd5e1;
    margin: 0;
  }

  .btn-footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    background: #f59e0b;
    color: #0f172a;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
    transition: background 0.15s ease;
  }

  .btn-footer-cta:hover {
    background: #d97706;
  }
</style>
