---
/**
 * AgencyContactBrief — "Start a project" brief: service chips, budget pills, timeline, contact
 * details and message, with validation and a success state; side column with direct contacts,
 * office and response time.
 *
 * @param {string} title - Heading. Default "Let's build something people remember".
 * @param {string} text - Intro text.
 * @param {string[]} services - Service chips (multi-select).
 * @param {string[]} budgets - Budget options (single-select).
 * @param {string[]} timelines - Timeline select options.
 * @param {string} action - Form action. With '#' the form validates and confirms locally. Default '#'.
 * @param {Array<{label: string, value: string, href: string}>} contacts - Direct channels.
 * @param {{city: string, address: string}} office - Office card (optional).
 * @param {string} responseTime - Reply promise. Default 'We reply within one business day.'
 * @param {string} id - Base id. Default 'brief'.
 * @param {string} className - Extra class.
 *
 * Accessibility: chips and pills are native checkboxes/radios inside fieldsets with legends;
 * required fields use autocomplete hints; errors are listed in an alert and focus moves to the
 * first invalid field; the success message receives focus.
 */
interface Props {
  title?: string;
  text?: string;
  services?: string[];
  budgets?: string[];
  timelines?: string[];
  action?: string;
  contacts?: Array<{ label: string; value: string; href: string }>;
  office?: { city: string; address: string };
  responseTime?: string;
  id?: string;
  className?: string;
}

const {
  title = "Let's build something people remember",
  text = 'Tell us a little about your project. A partner — not a salesperson — will reply with next steps.',
  services = ['Brand identity', 'Website', 'Growth marketing', 'Content & social', 'Not sure yet'],
  budgets = ['< €15k', '€15–30k', '€30–60k', '€60k+'],
  timelines = ['As soon as possible', 'In 1–3 months', 'In 3–6 months', 'Just exploring'],
  action = '#',
  contacts = [
    { label: 'New business', value: 'hello@volta.studio', href: 'mailto:hello@volta.studio' },
    { label: 'Call us', value: '+34 910 123 456', href: 'tel:+34910123456' },
  ],
  office = { city: 'Madrid', address: 'Calle de Fuencarral 45, 28004' },
  responseTime = 'We reply within one business day.',
  id = 'brief',
  className = '',
} = Astro.props;
---

<div class="cq-agency-brief">
<section class:list={['acb', className]} aria-labelledby={`${id}-title`}>
  <div class="acb__intro">
    <h2 class="acb__title" id={`${id}-title`}>{title}</h2>
    {text && <p class="acb__text">{text}</p>}
    <ul class="acb__contacts">
      {contacts.map((c) => <li><span>{c.label}</span><a href={c.href}>{c.value}</a></li>)}
    </ul>
    {office && <p class="acb__office"><span>Studio</span><strong>{office.city}</strong>{office.address}</p>}
    {responseTime && <p class="acb__reply"><i aria-hidden="true"></i>{responseTime}</p>}
  </div>

  <form class="acb__form" action={action} method="post" novalidate data-brief>
    <fieldset class="acb__group">
      <legend>What do you need?</legend>
      <div class="acb__chips">
        {services.map((s, i) => (
          <label class="acb__chip"><input type="checkbox" name="services" value={s} checked={i === 0} /><span>{s}</span></label>
        ))}
      </div>
    </fieldset>
    <fieldset class="acb__group">
      <legend>Budget</legend>
      <div class="acb__chips">
        {budgets.map((b, i) => (
          <label class="acb__chip"><input type="radio" name="budget" value={b} checked={i === 1} /><span>{b}</span></label>
        ))}
      </div>
    </fieldset>
    <div class="acb__row">
      <div class="acb__field">
        <label for={`${id}-name`}>Your name</label>
        <input id={`${id}-name`} name="name" required autocomplete="name" />
      </div>
      <div class="acb__field">
        <label for={`${id}-email`}>Work email</label>
        <input id={`${id}-email`} name="email" type="email" required autocomplete="email" />
      </div>
    </div>
    <div class="acb__row">
      <div class="acb__field">
        <label for={`${id}-company`}>Company</label>
        <input id={`${id}-company`} name="company" autocomplete="organization" />
      </div>
      <div class="acb__field">
        <label for={`${id}-when`}>Timeline</label>
        <select id={`${id}-when`} name="timeline">{timelines.map((t) => <option>{t}</option>)}</select>
      </div>
    </div>
    <div class="acb__field">
      <label for={`${id}-msg`}>Tell us about the project</label>
      <textarea id={`${id}-msg`} name="message" rows="4" required minlength="20" placeholder="Goals, audience, deadlines, links…"></textarea>
    </div>
    <p class="acb__error" role="alert" data-error></p>
    <button class="acb__submit" type="submit">Send brief <span aria-hidden="true">↗</span></button>
    <p class="acb__fine">By sending this form you agree to our privacy policy. No newsletters, promise.</p>
  </form>

  <div class="acb__done" hidden tabindex="-1" data-done>
    <span class="acb__done-badge" aria-hidden="true">✓</span>
    <h3>Brief received — thank you!</h3>
    <p>{responseTime} In the meantime, have a look at our recent work.</p>
  </div>
</section>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-brief]:not([data-bound])').forEach((form) => {
    form.dataset.bound = '';
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const done = form.parentElement!.querySelector<HTMLElement>('[data-done]')!;
    form.addEventListener('submit', (e) => {
      form.querySelectorAll('[aria-invalid]').forEach((n) => n.removeAttribute('aria-invalid'));
      const invalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]')).filter((n) => !n.checkValidity());
      const noService = !form.querySelector('input[name="services"]:checked');
      if (invalid.length || noService) {
        e.preventDefault();
        invalid.forEach((n) => n.setAttribute('aria-invalid', 'true'));
        const msgs = invalid.map((n) => form.querySelector(`label[for="${n.id}"]`)?.textContent).filter(Boolean);
        if (noService) msgs.unshift('at least one service');
        error.textContent = `Please complete: ${msgs.join(', ')}.`;
        (invalid[0] ?? form.querySelector<HTMLInputElement>('input[name="services"]'))?.focus();
        return;
      }
      if (form.getAttribute('action') === '#') {
        e.preventDefault();
        form.hidden = true;
        done.hidden = false;
        done.focus();
      }
    });
  });
</script>

<style>
  .cq-agency-brief { container-type: inline-size; }
  .acb { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6cqi, 5rem); color: var(--c-text-1, #fff); }
  .acb__title { margin: 0; font-size: clamp(2.4rem, 6.5cqi, 4.6rem); font-weight: 900; letter-spacing: -0.055em; line-height: 0.92; }
  .acb__text { margin: var(--sp-5, 1.25rem) 0 0; max-width: 28rem; font-size: 1.05rem; line-height: 1.6; color: var(--c-text-2, #a3a3a3); }
  .acb__contacts { display: grid; gap: var(--sp-4, 1rem); margin: var(--sp-8, 2rem) 0 0; padding: 0; list-style: none; }
  .acb__contacts li, .acb__office { display: grid; gap: 2px; margin: 0; }
  .acb__contacts span, .acb__office span { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-text-3, #737373); }
  .acb__contacts a { font-size: clamp(1.2rem, 2.6cqi, 1.6rem); font-weight: 800; letter-spacing: -0.02em; color: inherit; text-decoration: none; background: linear-gradient(var(--agency-accent, var(--c-primary-light, #d4a017)), var(--agency-accent, var(--c-primary-light, #d4a017))) 0 100% / 0 35% no-repeat; transition: background-size 0.3s ease; width: fit-content; }
  .acb__contacts a:hover { background-size: 100% 35%; }
  .acb__office { margin-top: var(--sp-6, 1.5rem); font-size: 0.92rem; color: var(--c-text-2, #a3a3a3); }
  .acb__office strong { font-size: 1.05rem; color: var(--c-text-1, #fff); }
  .acb__reply { display: flex; align-items: center; gap: 8px; margin: var(--sp-6, 1.5rem) 0 0; font-size: 0.88rem; font-weight: 600; }
  .acb__reply i { width: 10px; height: 10px; border-radius: 50%; background: var(--c-success, #34d399); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c-success, #34d399) 25%, transparent); }

  .acb__form, .acb__done { display: grid; gap: var(--sp-5, 1.25rem); padding: clamp(1.25rem, 3.5cqi, 2.25rem); border-radius: 28px; border: 1px solid var(--c-border, rgba(255, 255, 255, 0.12)); background: var(--c-bg-1, #0a0a0a); }
  .acb__form[hidden], .acb__done[hidden] { display: none; }
  .acb__group { margin: 0; padding: 0; border: 0; min-width: 0; }
  .acb__group legend { margin-bottom: var(--sp-3, 0.75rem); font-size: 0.95rem; font-weight: 800; }
  .acb__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .acb__chip { position: relative; cursor: pointer; }
  .acb__chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .acb__chip span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border-radius: 999px; border: 1.5px solid var(--c-border, rgba(255, 255, 255, 0.2)); font-size: 0.9rem; font-weight: 700; transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
  .acb__chip:hover span { border-color: currentColor; }
  .acb__chip input:checked + span { background: var(--agency-accent, var(--c-primary-light, #d4a017)); border-color: transparent; color: var(--c-on-primary, #050505); }
  .acb__chip input:focus-visible + span { outline: 2px solid var(--c-text-1, #fff); outline-offset: 2px; }
  .acb__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-4, 1rem); }
  .acb__field { display: grid; gap: 6px; }
  .acb__field label { font-size: 0.85rem; font-weight: 700; }
  .acb__field :is(input, select, textarea) { width: 100%; min-height: 50px; padding: 0.75rem 1rem; border-radius: 14px; border: 1.5px solid var(--c-border, rgba(255, 255, 255, 0.16)); background: var(--c-bg, #050505); color: var(--c-text-1, #fff); font: inherit; font-size: 0.95rem; }
  .acb__field textarea { resize: vertical; }
  .acb__field :is(input, select, textarea):focus { outline: none; border-color: var(--c-text-1, #fff); box-shadow: 0 0 0 4px color-mix(in srgb, var(--agency-accent, var(--c-primary-light, #d4a017)) 35%, transparent); }
  .acb__field [aria-invalid='true'] { border-color: var(--c-danger, #f87171); }
  .acb__error { margin: 0; font-size: 0.88rem; font-weight: 600; color: var(--c-danger, #f87171); }
  .acb__error:empty { display: none; }
  .acb__submit { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 58px; border: 0; border-radius: 999px; background: var(--c-text-1, #fff); color: var(--c-bg, #050505); font: inherit; font-size: 1.05rem; font-weight: 900; cursor: pointer; transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease; }
  .acb__submit:hover { background: var(--agency-accent, var(--c-primary-light, #d4a017)); color: var(--c-on-primary, #050505); transform: rotate(-1deg); }
  .acb__submit:focus-visible { outline: 2px solid var(--agency-accent, var(--c-primary-light, #d4a017)); outline-offset: 3px; }
  .acb__fine { margin: -6px 0 0; font-size: 0.78rem; color: var(--c-text-3, #737373); text-align: center; }
  .acb__done { place-content: center; justify-items: start; min-height: 420px; outline: none; }
  .acb__done-badge { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--agency-accent, var(--c-primary-light, #d4a017)); color: var(--c-on-primary, #050505); font-size: 1.8rem; font-weight: 900; transform: rotate(-8deg); }
  .acb__done h3 { margin: 0; font-size: 2rem; font-weight: 900; letter-spacing: -0.04em; }
  .acb__done p { margin: 0; color: var(--c-text-2, #a3a3a3); }
  @container (max-width: 820px) { .acb { grid-template-columns: 1fr; } }
  @container (max-width: 520px) { .acb__row { grid-template-columns: 1fr; } }
</style>
