---
/**
 * AreaChart — A premium, smooth area chart component.
 */
interface Props {
  title?: string;
  subtitle?: string;
  categories?: any[];
  series?: any[];
  height?: number | string;
  colors?: string[];
  showGrid?: boolean;
  className?: string;
}

const {
  title,
  subtitle,
  categories = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
  series = [{ name: 'Data', data: [31, 40, 28, 51, 42, 109, 100] }],
  height = 350,
  colors = ['var(--c-accent, #b8860b)', 'var(--c-primary, #1e40af)', '#3b82f6'],
  showGrid = true,
  className = '',
} = Astro.props;

const chartConfig = {
  categories,
  series,
  height,
  colors,
  showGrid,
};
---

<div class={`premium-chart-card ${className}`} data-chart-type="area" data-config={JSON.stringify(chartConfig)}>
  {(title || subtitle) && (
    <div class="premium-chart-card__header">
      {title && <h3 class="premium-chart-card__title">{title}</h3>}
      {subtitle && <p class="premium-chart-card__subtitle">{subtitle}</p>}
    </div>
  )}
  <div class="premium-chart-card__body">
    <div class="chart-container"></div>
    <div class="chart-fallback">Loading Chart...</div>
  </div>
</div>

<style>
  .premium-chart-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--r-xl, 24px);
    padding: var(--sp-6, 24px);
    overflow: hidden;
    width: 100%;
    min-width: 300px;
    color: white;
  }

  .premium-chart-card__header {
    margin-bottom: var(--sp-6, 24px);
  }

  .premium-chart-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--c-text-1, #ffffff);
    margin: 0;
  }

  .premium-chart-card__subtitle {
    font-size: 0.875rem;
    color: var(--c-text-2, #94a3b8);
    margin: var(--sp-1, 4px) 0 0;
  }

  .premium-chart-card__body {
    width: 100%;
    position: relative;
    min-height: 200px;
  }

  .chart-container {
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .chart-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--c-text-3, #64748b);
    z-index: 1;
  }

  :global(.apexcharts-tooltip) {
    background: rgba(15, 23, 42, 0.9) !important;
    backdrop-filter: blur(8px) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 12px !important;
    color: #fff !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3) !important;
  }
</style>

<script>
  async function initCharts() {
    const charts = document.querySelectorAll('.premium-chart-card[data-chart-type="area"]');
    if (charts.length === 0) return;

    // Dynamic import to handle SSR and bundling better in production
    let ApexChartsModule;
    try {
      ApexChartsModule = await import('apexcharts');
    } catch (e) {
      console.error('ApexCharts failed to load:', e);
      return;
    }
    
    const ApexCharts = ApexChartsModule.default || ApexChartsModule;
    
    charts.forEach(container => {
      if (container.getAttribute('data-initialized')) return;
      
      const configStr = container.getAttribute('data-config');
      if (!configStr) return;
      
      const config = JSON.parse(configStr);
      const target = container.querySelector('.chart-container');
      const fallback = container.querySelector('.chart-fallback');
      
      if (!target) return;

      const options = {
        series: config.series,
        chart: {
          type: 'area',
          height: config.height,
          toolbar: { show: false },
          zoom: { enabled: false },
          background: 'transparent',
          fontFamily: 'Inter, sans-serif',
          animations: {
            enabled: true,
            easing: 'easeinout',
            speed: 800,
          }
        },
        colors: config.colors,
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 3 },
        fill: {
          type: 'gradient',
          gradient: {
            shadeIntensity: 1,
            opacityFrom: 0.45,
            opacityTo: 0.05,
            stops: [20, 100],
          },
        },
        xaxis: {
          categories: config.categories,
          axisBorder: { show: false },
          axisTicks: { show: false },
          labels: { style: { colors: '#64748b', fontSize: '12px' } },
        },
        yaxis: {
          labels: { style: { colors: '#64748b', fontSize: '12px' } },
        },
        grid: {
          show: config.showGrid,
          borderColor: 'rgba(255, 255, 255, 0.05)',
          strokeDashArray: 4,
        },
        legend: {
          show: true,
          position: 'top',
          horizontalAlign: 'right',
          labels: { colors: '#94a3b8' },
        },
        tooltip: { theme: 'dark' },
        theme: { mode: 'dark' }
      };

      try {
        const chart = new ApexCharts(target, options);
        chart.render().then(() => {
          if (fallback) (fallback as HTMLElement).style.display = 'none';
        });
        container.setAttribute('data-initialized', 'true');
      } catch (err) {
        console.error('Failed to render chart:', err);
        if (fallback) fallback.textContent = 'Failed to load chart';
      }
    });
  }

  // Initial load
  initCharts();

  // Handle navigations
  document.addEventListener('astro:page-load', initCharts);
  document.addEventListener('astro:after-swap', initCharts);
</script>
