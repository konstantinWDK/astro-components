---
// src/components/lib/GlowButton.astro
interface Props {
  color?: string;
  href?: string;
}
const { color = '#6366f1', href } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class="glow-btn" style={`--glow-color: ${color}`}>
  <slot />
</Tag>

<style>
  .glow-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.6rem;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
    background: var(--glow-color);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    position: relative;
    transition: transform 0.2s ease;
    box-shadow: 0 0 20px color-mix(in srgb, var(--glow-color) 60%, transparent);
  }

  .glow-btn::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 13px;
    background: var(--glow-color);
    opacity: 0;
    filter: blur(16px);
    transition: opacity 0.3s ease;
    z-index: -1;
  }

  .glow-btn:hover { transform: translateY(-2px); }

  .glow-btn:hover::after {
    opacity: 0.5;
    animation: pulse-glow 1.5s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.8; }
  }
</style>
