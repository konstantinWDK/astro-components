<div class="radio-group">
  <label class="radio-item"><input type="radio" name="opt" checked /><span>Option A</span></label>
  <label class="radio-item"><input type="radio" name="opt" /><span>Option B</span></label>
</div>
<style>
  .radio-group { display: flex; flex-direction: column; gap: 0.8rem; }
  .radio-item { display: flex; align-items: center; gap: 0.75rem; cursor: pointer; color: #94a3b8; }
  .radio-item input { appearance: none; width: 20px; height: 20px; border: 2px solid #6366f1; border-radius: 50%; position: relative; cursor: pointer; }
  .radio-item input:checked::after { content: ''; position: absolute; inset: 4px; background: #6366f1; border-radius: 50%; }
  .radio-item input:checked + span { color: #fff; font-weight: 600; }
</style>
