<div class="pass-wrap">
  <input type="password" id="pass" placeholder="Password" />
  <button type="button" id="toggle-pass">👁️</button>
</div>
<style>
  .pass-wrap { position: relative; width: 100%; }
  .pass-wrap input { width: 100%; padding: 0.8rem 3rem 0.8rem 1rem; background: rgba(0,0,0,0.2); border: 1px solid var(--c-border); border-radius: 10px; color: #fff; outline: none; }
  #toggle-pass { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; opacity: 0.5; }
</style>
<script>
  const btn = document.getElementById('toggle-pass');
  const pass = document.getElementById('pass') as HTMLInputElement;
  btn?.addEventListener('click', () => {
    const isPass = pass.type === 'password';
    pass.type = isPass ? 'text' : 'password';
    btn.textContent = isPass ? '🙈' : '👁️';
  });
</script>
