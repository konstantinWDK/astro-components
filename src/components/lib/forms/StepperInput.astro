<div class="stepper">
  <button>-</button>
  <input type="number" value="1" />
  <button>+</button>
</div>
<style>
  .stepper { display: flex; align-items: center; gap: 2px; }
  .stepper button { width: 35px; height: 35px; background: #6366f1; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; transition: 0.2s; }
  .stepper button:hover { background: #4f46e5; }
  .stepper input { width: 50px; height: 35px; background: rgba(255,255,255,0.05); border: none; text-align: center; color: #fff; outline: none; -moz-appearance: textfield; }
  .stepper input::-webkit-inner-spin-button { display: none; }
</style>
