<label class="file-btn">
  <input type="file" />
  <span>Upload Logo</span>
</label>
<style>
  .file-btn { position: relative; overflow: hidden; display: inline-block; cursor: pointer; }
  .file-btn input { position: absolute; font-size: 100px; right: 0; top: 0; opacity: 0; cursor: pointer; }
  .file-btn span { background: #6366f1; color: #fff; padding: 0.7rem 1.5rem; border-radius: 8px; font-weight: 600; display: inline-block; }
</style>
