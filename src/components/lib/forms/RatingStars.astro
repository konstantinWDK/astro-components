<div class="rating">
  <input type="radio" name="star" id="star5" /><label for="star5"></label>
  <input type="radio" name="star" id="star4" /><label for="star4"></label>
  <input type="radio" name="star" id="star3" /><label for="star3"></label>
  <input type="radio" name="star" id="star2" /><label for="star2"></label>
  <input type="radio" name="star" id="star1" /><label for="star1"></label>
</div>
<style>
  .rating { display: flex; flex-direction: row-reverse; gap: 5px; }
  .rating input { display: none; }
  .rating label { width: 24px; height: 24px; background: #334155; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); cursor: pointer; transition: 0.2s; }
  .rating label:hover, .rating label:hover ~ label, .rating input:checked ~ label { background: #fbbf24; box-shadow: 0 0 10px #fbbf24; }
</style>
