<div class="form-group">
  <label>Company Name</label>
  <input type="text" placeholder="e.g. Acme Corp" />
  <p class="help-text">Visible on your public profile.</p>
</div>
<style>
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
  label { font-size: 0.82rem; font-weight: 700; color: #e2e8f0; text-transform: uppercase; letter-spacing: 0.05em; }
  input { background: #0f172a; border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 0.8rem; border-radius: 8px; outline: none; }
  input:focus { border-color: #6366f1; }
  .help-text { font-size: 0.75rem; color: #64748b; }
</style>
