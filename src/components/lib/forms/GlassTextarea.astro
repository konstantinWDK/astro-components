---
interface Props { label: string; id: string; rows?: number; }
const { label, id, rows = 4 } = Astro.props;
---
<div class="glass-textarea-wrap">
  <label for={id} class="glass-label">{label}</label>
  <textarea {id} {rows} class="glass-textarea" placeholder="Start typing..."></textarea>
</div>
<style>
  .glass-textarea-wrap { display: flex; flex-direction: column; gap: 0.5rem; width: 100%; }
  .glass-label { font-size: 0.85rem; font-weight: 600; color: #94a3b8; margin-left: 0.5rem; }
  .glass-textarea { width: 100%; padding: 1rem; background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; color: #fff; font-family: inherit; font-size: 0.9rem; outline: none; transition: 0.3s; resize: vertical; }
  .glass-textarea:focus { border-color: rgba(99, 102, 241, 0.4); background: rgba(255, 255, 255, 0.06); }
</style>
