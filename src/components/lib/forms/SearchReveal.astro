<div class="search-box">
  <input type="text" placeholder="Search..." />
  <button>🔍</button>
</div>
<style>
  .search-box { position: relative; width: 40px; height: 40px; transition: 0.4s; }
  .search-box:hover, .search-box:focus-within { width: 250px; }
  .search-box input { width: 100%; height: 100%; background: #1e293b; border: 1px solid rgba(255,255,255,0.1); border-radius: 100px; padding: 0 45px 0 20px; color: #fff; outline: none; opacity: 0; transition: 0.3s; }
  .search-box:hover input, .search-box:focus-within input { opacity: 1; }
  .search-box button { position: absolute; right: 0; width: 40px; height: 40px; background: #6366f1; border: none; border-radius: 50%; color: #fff; cursor: pointer; }
</style>
