<div class="color-picker-wrap">
  <input type="color" class="color-input" id="picker" value="#6366f1" />
  <label for="picker">Primary Accent</label>
</div>
<style>
  .color-picker-wrap { display: flex; align-items: center; gap: 1rem; }
  .color-input { -webkit-appearance: none; border: none; width: 34px; height: 34px; border-radius: 50%; cursor: pointer; background: transparent; }
  .color-input::-webkit-color-swatch-wrapper { padding: 0; }
  .color-input::-webkit-color-swatch { border: 2px solid rgba(255,255,255,0.2); border-radius: 50%; }
  label { font-size: 0.9rem; color: #e2e8f0; font-weight: 500; }
</style>
