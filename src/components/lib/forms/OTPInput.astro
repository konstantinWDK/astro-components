<div class="otp-wrap">
  <input type="text" maxlength="1" />
  <input type="text" maxlength="1" />
  <input type="text" maxlength="1" />
  <input type="text" maxlength="1" />
</div>
<style>
  .otp-wrap { display: flex; gap: 0.75rem; justify-content: center; }
  .otp-wrap input { width: 45px; height: 55px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; text-align: center; color: #fff; font-size: 1.5rem; font-weight: 700; outline: none; transition: 0.2s; }
  .otp-wrap input:focus { border-color: #6366f1; background: rgba(99, 102, 241, 0.1); box-shadow: 0 0 15px rgba(99, 102, 241, 0.3); }
</style>
<script>
  document.querySelectorAll('.otp-wrap input').forEach((input, idx, inputs) => {
    input.addEventListener('input', () => { 
      if ((input as HTMLInputElement).value && idx < inputs.length - 1) {
        (inputs[idx+1] as HTMLInputElement).focus(); 
      }
    });
  });
</script>
