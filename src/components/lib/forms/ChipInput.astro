<div class="chip-input">
  <span class="chip">Astro <button>×</button></span>
  <span class="chip">UI <button>×</button></span>
  <input type="text" placeholder="Add tag..." />
</div>
<style>
  .chip-input { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0.5rem; background: rgba(0,0,0,0.1); border: 1px solid var(--c-border); border-radius: 10px; }
  .chip { background: #6366f1; color: #fff; padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.8rem; display: flex; align-items: center; gap: 0.4rem; }
  .chip button { background: none; border: none; color: #fff; cursor: pointer; font-size: 1rem; }
  .chip-input input { background: none; border: none; outline: none; color: #fff; flex: 1; padding: 0.2rem; }
</style>
