<div class="segmented">
  <input type="radio" name="seg" id="seg1" checked /><label for="seg1">Daily</label>
  <input type="radio" name="seg" id="seg2" /><label for="seg2">Weekly</label>
  <input type="radio" name="seg" id="seg3" /><label for="seg3">Monthly</label>
</div>
<style>
  .segmented { display: flex; position: relative; background: rgba(255,255,255,0.05); padding: 4px; border-radius: 10px; width: fit-content; }
  .segmented label { padding: 0.4rem 1.2rem; cursor: pointer; z-index: 1; font-size: 0.85rem; transition: 0.3s; color: #94a3b8; }
  .segmented input { display: none; }
  .segmented input:checked + label { color: #fff; font-weight: 600; background: rgba(99, 102, 241, 0.2); border-radius: 6px; }
</style>
