---
/**
 * GlassCheckbox — Native checkbox restyled for dark UIs, with an optional description, an
 * indeterminate state (for "select all" parents) and the usual variants and sizes. It is a real
 * `<input type="checkbox">`, so forms, `:checked` and assistive technology keep working.
 *
 * @param {string} label - Visible label.
 * @param {string} description - Secondary text under the label.
 * @param {string} id - HTML ID of the input.
 * @param {string} name - Form name.
 * @param {string} value - Submitted value.
 * @param {boolean} checked - Initial checked state.
 * @param {boolean} indeterminate - Shows the mixed state until the user toggles it.
 * @param {string} variant - Accent color (primary|success|danger).
 * @param {string} size - Size (sm|md|lg).
 * @param {boolean} disabled - Disables the checkbox.
 * @param {string} class - Extra class for the root.
 *
 * Accessibility: the label wraps the input so the whole row is a 44px target; the description is
 * linked with aria-describedby; the mixed state is exposed through the native `indeterminate`
 * property; focus ring is a 2px outline; checked state is not conveyed by color alone (a check mark).
 */
import type { HTMLAttributes } from 'astro/types';

interface OwnProps {
  label?: string;
  description?: string;
  id?: string;
  name?: string;
  value?: string;
  checked?: boolean;
  indeterminate?: boolean;
  variant?: 'primary' | 'success' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
}

/** Own props plus any native <input> attribute (aria-*, data-*, required…), forwarded to the <input>. */
type Props = OwnProps & Omit<HTMLAttributes<'input'>, keyof OwnProps | 'class'> & {
  /** Extra classes merged onto the root element. */
  class?: string;
};

const {
  label = 'Receive product updates',
  description = '',
  id = `checkbox-${Math.random().toString(36).slice(2, 8)}`,
  name,
  value,
  checked = false,
  indeterminate = false,
  variant = 'primary',
  size = 'md',
  disabled = false,
  class: classAttr,
  ...rest
} = Astro.props;

const descId = description ? `${id}-desc` : undefined;
---

<label class:list={['glass-checkbox', `glass-checkbox--${variant}`, `glass-checkbox--${size}`, { 'glass-checkbox--disabled': disabled }, classAttr]} for={id}>
  <input
    {...rest}
    id={id}
    class="glass-checkbox__input"
    type="checkbox"
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    aria-describedby={descId}
    data-indeterminate={indeterminate ? 'true' : undefined}
  />
  <span class="glass-checkbox__box" aria-hidden="true">
    <svg class="glass-checkbox__check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7" /></svg>
    <span class="glass-checkbox__dash"></span>
  </span>
  <span class="glass-checkbox__text">
    <span class="glass-checkbox__label">{label}</span>
    {description && <span id={descId} class="glass-checkbox__desc">{description}</span>}
  </span>
</label>

<style>
  .glass-checkbox {
    --gc-size: 22px;
    --gc-accent: var(--c-primary, #6366f1);
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    gap: var(--sp-3, 0.75rem);
    min-height: 44px;
    padding: 10px 0;
    box-sizing: border-box;
    color: var(--c-text-1, #fff);
    cursor: pointer;
  }

  .glass-checkbox--sm { --gc-size: 18px; }
  .glass-checkbox--lg { --gc-size: 28px; }
  .glass-checkbox--success { --gc-accent: var(--c-success, #22c55e); }
  .glass-checkbox--danger { --gc-accent: var(--c-danger, #ef4444); }
  .glass-checkbox--disabled { opacity: 0.5; cursor: not-allowed; }

  .glass-checkbox__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
  }

  .glass-checkbox__box {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--gc-size);
    height: var(--gc-size);
    margin-top: 1px;
    border: 1.5px solid var(--c-border, rgba(255, 255, 255, 0.25));
    border-radius: var(--r-sm, 6px);
    background: var(--c-surface, rgba(255, 255, 255, 0.05));
    color: var(--c-on-primary, #fff);
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .glass-checkbox__check {
    width: 72%;
    height: 72%;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.15s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .glass-checkbox__dash {
    position: absolute;
    width: 52%;
    height: 2.5px;
    border-radius: 2px;
    background: currentColor;
    opacity: 0;
  }

  .glass-checkbox:hover .glass-checkbox__box { border-color: var(--gc-accent); }

  .glass-checkbox__input:checked ~ .glass-checkbox__box,
  .glass-checkbox__input:indeterminate ~ .glass-checkbox__box {
    background: var(--gc-accent);
    border-color: var(--gc-accent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--gc-accent) 45%, transparent);
  }

  .glass-checkbox__input:checked ~ .glass-checkbox__box .glass-checkbox__check { opacity: 1; transform: scale(1); }
  .glass-checkbox__input:indeterminate ~ .glass-checkbox__box .glass-checkbox__check { opacity: 0; }
  .glass-checkbox__input:indeterminate ~ .glass-checkbox__box .glass-checkbox__dash { opacity: 1; }

  .glass-checkbox__input:focus-visible ~ .glass-checkbox__box {
    outline: 2px solid var(--gc-accent);
    outline-offset: 2px;
  }

  .glass-checkbox__text { display: flex; flex-direction: column; gap: 2px; }
  .glass-checkbox__label { font-size: 0.95rem; line-height: 1.35; }
  .glass-checkbox--sm .glass-checkbox__label { font-size: 0.85rem; }
  .glass-checkbox--lg .glass-checkbox__label { font-size: 1.05rem; }
  .glass-checkbox__desc { font-size: 0.82rem; line-height: 1.4; color: var(--c-text-2, #94a3b8); }

  @media (prefers-reduced-motion: reduce) {
    .glass-checkbox__box,
    .glass-checkbox__check { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>('input[data-indeterminate="true"]').forEach((input) => {
    input.indeterminate = true;
    // The mixed state ends as soon as the user chooses a value.
    input.addEventListener('change', () => { input.indeterminate = false; });
  });
</script>
