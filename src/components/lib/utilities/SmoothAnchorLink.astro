---
interface Props { to: string; }
const { to } = Astro.props;
---
<a href={`#${to}`} class="smooth-s"><slot /></a>
<style>
  .smooth-s { color: #6366f1; font-weight: 800; text-decoration: none; cursor: pointer; transition: 0.2s; }
  .smooth-s:hover { color: #818cf8; text-decoration: underline; }
</style>
<script>
  // Ensuring smooth scroll behavior for modern browsers if not set in CSS
  document.querySelectorAll('.smooth-s').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('href').substring(1);
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
