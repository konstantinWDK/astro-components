<div class="scroll-lock-triggers">
  <div class="scroll-lock-trigger" onclick="document.body.style.overflow = 'hidden'">Lock Scroll</div>
  <div class="scroll-lock-trigger" onclick="document.body.style.overflow = 'auto'">Unlock Scroll</div>
</div>
<style>
  .scroll-lock-triggers { display: flex; gap: 1rem; }
  .scroll-lock-trigger { cursor: pointer; color: #6366f1; text-decoration: underline; font-weight: 700; font-size: 0.9rem; }
  .scroll-lock-trigger:hover { color: #818cf8; }
</style>
