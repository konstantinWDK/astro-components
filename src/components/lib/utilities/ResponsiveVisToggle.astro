---
interface Props { hideOn?: 'mobile' | 'desktop'; }
const { hideOn } = Astro.props;
---
<div class:list={['vis-toggle', hideOn ? `hide-${hideOn}` : '']}>
  <slot />
</div>
<style>
  @media (max-width: 768px) { .hide-mobile { display: none !important; } }
  @media (min-width: 769px) { .hide-desktop { display: none !important; } }
</style>
