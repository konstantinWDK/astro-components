---
interface Props { ratio?: string; }
const { ratio = '16 / 9' } = Astro.props;
---
<div class="aspect-box" style={`aspect-ratio: ${ratio}`}>
  <slot />
</div>
<style>
  .aspect-box { width: 100%; background: rgba(30, 41, 59, 0.5); overflow: hidden; display: flex; align-items: center; justify-content: center; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05); }
  .aspect-box :global(img, video, iframe) { width: 100%; height: 100%; object-fit: cover; }
</style>
