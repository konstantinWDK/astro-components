---
interface Props { size?: 'sm' | 'md' | 'lg' | 'xl'; }
const { size = 'md' } = Astro.props;
---
<div class:list={['spacer', `spacer--${size}`]}></div>
<style>
  .spacer--sm { height: 1rem; }
  .spacer--md { height: 2.5rem; }
  .spacer--lg { height: 5rem; }
  .spacer--xl { height: 10rem; }
  @media (max-width: 768px) {
    .spacer--lg { height: 2.5rem; }
    .spacer--xl { height: 4rem; }
  }
</style>
