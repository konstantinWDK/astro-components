---
interface Props { duration?: string; delay?: string; }
const { duration = '0.6s', delay = '0s' } = Astro.props;
---
<div class="fade-in" style={`--d: ${duration}; --l: ${delay}`}>
  <slot />
</div>
<style>
  .fade-in { opacity: 0; animation: fade-in-anim var(--d) cubic-bezier(0.16, 1, 0.3, 1) var(--l) forwards; }
  @keyframes fade-in-anim { to { opacity: 1; } }
</style>
