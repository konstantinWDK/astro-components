---
interface Props { layer?: 'base' | 'nav' | 'overlay' | 'toast'; }
const { layer = 'base' } = Astro.props;
---
<div class:list={['z-stack', `z-${layer}`]}><slot /></div>
<style>
  .z-stack { position: relative; }
  .z-base { z-index: 1; }
  .z-nav { z-index: 1000; }
  .z-overlay { z-index: 2000; }
  .z-toast { z-index: 3000; }
</style>
