---
// src/pages/install/index.astro
import InstallLayout from '../../layouts/InstallLayout.astro';
import CodeBlock from '../../components/docs/CodeBlock.astro';

const npmInstall = 'npm install astro-component-kit';
const yarnInstall = 'yarn add astro-component-kit';
const pnpmInstall = 'pnpm add astro-component-kit';

const importAll = `---
// Import all components
import { GlassButton, GlassCard, GlassNavbar, AnimatedInput } from 'astro-component-kit';
---

<GlassButton>Click me</GlassButton>
<GlassCard title="Welcome">Content</GlassCard>`;

const importCategory = `---
// Import by category (recommended for smaller bundles)
import { GlassButton, GlowButton } from 'astro-component-kit/buttons';
import { GlassCard, ProfileCard } from 'astro-component-kit/cards';
import { AnimatedInput, OTPInput } from 'astro-component-kit/forms';
import { GlassAlert, Badge } from 'astro-component-kit/feedback';
import { GlassNavbar } from 'astro-component-kit/navigation';
import { GlassModal } from 'astro-component-kit/overlays';
import { MasonryGrid } from 'astro-component-kit/layout';
import { GradientHeading } from 'astro-component-kit/typography';
---`;

const importGlobalCSS = `---
// Import global design tokens (optional but recommended)
import 'astro-component-kit/global.css';
---`;

const astroNewProject = `# 1. Create a new Astro project
npm create astro@latest my-project

# 2. Navigate into the project
cd my-project

# 3. Install the component library
npm install astro-component-kit

# 4. Start the dev server
npm run dev`;

const chartsInstall = `# Only if you need chart components
npm install apexcharts`;

const threeInstall = `# Only if you need D/3D components
npm install three`;
---

<InstallLayout
  title="Installation Guide"
  description="Step-by-step guide to install Astro Components Kit in any Astro project. Choose npm, yarn, or pnpm."
>
  <div class="install-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__sep">›</span>
      <span class="breadcrumb__current">Installation</span>
    </nav>

    <!-- Header -->
    <header class="install-header">
      <span class="install-header__badge">Getting Started</span>
      <h1 class="install-header__title">Installation Guide</h1>
      <p class="install-header__desc">
        Add 200+ premium, accessible UI components to your Astro project in under 2 minutes.
        Zero runtime dependencies. MIT licensed — free forever.
      </p>
    </header>

    <!-- Step 1: Prerequisites -->
    <section class="install-section anim-slide-up" id="step-1">
      <div class="step-badge">Step 1</div>
      <h2 class="step-title">Prerequisites</h2>
      <p class="step-desc">
        You need an existing Astro project (v5.0+). If you don't have one yet, create it:
      </p>

      <div class="code-block-wrap">
        <CodeBlock code={astroNewProject} lang="bash" id="prereq-new-project" />
      </div>

      <div class="info-box info-box--tip">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div>
          <strong>Node.js 22.12+ required.</strong> Check your version with <code>node --version</code>. If you need to upgrade, visit <a href="https://nodejs.org" target="_blank" rel="noopener">nodejs.org</a>.
        </div>
      </div>
    </section>

    <!-- Step 2: Install the package -->
    <section class="install-section anim-slide-up" id="step-2" style="animation-delay: 0.1s">
      <div class="step-badge">Step 2</div>
      <h2 class="step-title">Install the library</h2>
      <p class="step-desc">Choose your preferred package manager:</p>

      <!-- Tabbed install -->
      <div class="install-tabs">
        <div class="install-tabs__bar" role="tablist">
          <button class="install-tabs__tab active" role="tab" data-tab="npm" aria-selected="true">npm</button>
          <button class="install-tabs__tab" role="tab" data-tab="yarn" aria-selected="false">yarn</button>
          <button class="install-tabs__tab" role="tab" data-tab="pnpm" aria-selected="false">pnpm</button>
        </div>
        <div class="install-tabs__panels">
          <div class="install-tabs__panel active" data-panel="npm">
            <div class="code-block-wrap">
              <CodeBlock code={npmInstall} lang="bash" id="install-npm" />
            </div>
          </div>
          <div class="install-tabs__panel" data-panel="yarn">
            <div class="code-block-wrap">
              <CodeBlock code={yarnInstall} lang="bash" id="install-yarn" />
            </div>
          </div>
          <div class="install-tabs__panel" data-panel="pnpm">
            <div class="code-block-wrap">
              <CodeBlock code={pnpmInstall} lang="bash" id="install-pnpm" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Step 3: Optional peer dependencies -->
    <section class="install-section anim-slide-up" id="step-3" style="animation-delay: 0.2s">
      <div class="step-badge">Step 3 <span class="step-badge__optional">Optional</span></div>
      <h2 class="step-title">Install peer dependencies (if needed)</h2>
      <p class="step-desc">
        Most components work with zero extra dependencies. But if you plan to use charts or 3D components, install these:
      </p>

      <div class="dep-grid">
        <div class="dep-card">
          <div class="dep-card__header">
            <span class="dep-card__icon dep-card__icon--chart">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </span>
            <div>
              <h3 class="dep-card__name">Charts</h3>
              <p class="dep-card__desc">Required for AreaChart, BarChart, DonutChart</p>
            </div>
          </div>
          <div class="code-block-wrap code-block-wrap--small">
            <CodeBlock code={chartsInstall} lang="bash" id="install-charts" />
          </div>
        </div>

        <div class="dep-card">
          <div class="dep-card__header">
            <span class="dep-card__icon dep-card__icon--3d">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </span>
            <div>
              <h3 class="dep-card__name">3D / Galaxy</h3>
              <p class="dep-card__desc">Required for Galaxy3D, AnimatedGalaxy, Text3DLayer</p>
            </div>
          </div>
          <div class="code-block-wrap code-block-wrap--small">
            <CodeBlock code={threeInstall} lang="bash" id="install-three" />
          </div>
        </div>
      </div>
    </section>

    <!-- Step 4: Import and use -->
    <section class="install-section anim-slide-up" id="step-4" style="animation-delay: 0.3s">
      <div class="step-badge">Step 4</div>
      <h2 class="step-title">Import and use components</h2>
      <p class="step-desc">
        You have two import styles — import everything or import by category (recommended for better tree-shaking):
      </p>

      <h3 class="step-subtitle">Option A: Root import (simple)</h3>
      <div class="code-block-wrap">
        <CodeBlock code={importAll} lang="astro" id="usage-import-all" />
      </div>

      <h3 class="step-subtitle" style="margin-top: var(--sp-6)">Option B: Category imports (recommended)</h3>
      <div class="code-block-wrap">
        <CodeBlock code={importCategory} lang="astro" id="usage-import-category" />
      </div>

      <h3 class="step-subtitle" style="margin-top: var(--sp-6)">Import global design tokens</h3>
      <p class="step-desc step-desc--muted">
        This gives you access to the unified color palette, spacing scale, typography, and border radii that all components use.
      </p>
      <div class="code-block-wrap">
        <CodeBlock code={importGlobalCSS} lang="astro" id="usage-import-css" />
      </div>
    </section>

    <!-- Step 5: First component -->
    <section class="install-section anim-slide-up" id="step-5" style="animation-delay: 0.4s">
      <div class="step-badge">Step 5</div>
      <h2 class="step-title">Build your first page</h2>
      <p class="step-desc">
        Here's a complete example putting everything together — a simple page with a navbar and a hero card:
      </p>

      <div class="code-block-wrap">
        <CodeBlock code={`---
import { GlassNavbar } from 'astro-component-kit/navigation';
import { GlassButton } from 'astro-component-kit/buttons';
import { GlassCard } from 'astro-component-kit/cards';
import 'astro-component-kit/global.css';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Astro App</title>
</head>
<body>
  <GlassNavbar brand="MyApp" brandHref="/">
    <div slot="links">
      <a href="/features">Features</a>
      <a href="/pricing">Pricing</a>
    </div>
    <div slot="actions">
      <GlassButton size="sm">Get Started</GlassButton>
    </div>
  </GlassNavbar>

  <main style="max-width: 600px; margin: 4rem auto; padding: 0 1.5rem;">
    <GlassCard title="Welcome" subtitle="Your first component" padding="lg">
      <p>You just built your first page with Astro Components Kit!</p>
      <GlassButton variant="primary" style="margin-top: 1rem;">
        Explore More
      </GlassButton>
    </GlassCard>
  </main>
</body>
</html>`} lang="astro" id="first-page-example" />
      </div>
    </section>

    <!-- Summary table -->
    <section class="install-section anim-slide-up" id="quick-reference" style="animation-delay: 0.5s">
      <h2 class="step-title">Quick reference</h2>

      <div class="ref-table">
        <table>
          <thead>
            <tr>
              <th>Task</th>
              <th>Command / Import</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Install library</td>
              <td><code>npm install astro-component-kit</code></td>
            </tr>
            <tr>
              <td>Install charts support</td>
              <td><code>npm install apexcharts</code></td>
            </tr>
            <tr>
              <td>Install 3D support</td>
              <td><code>npm install three</code></td>
            </tr>
            <tr>
              <td>Import all components</td>
              <td><code>import &#123; ... &#125; from 'astro-component-kit'</code></td>
            </tr>
            <tr>
              <td>Import by category</td>
              <td><code>import &#123; ... &#125; from 'astro-component-kit/buttons'</code></td>
            </tr>
            <tr>
              <td>Import design tokens</td>
              <td><code>import 'astro-component-kit/global.css'</code></td>
            </tr>
            <tr>
              <td>Browse all components</td>
              <td><a href="/docs/glass-button">Component Docs →</a></td>
            </tr>
            <tr>
              <td>Browse sections</td>
              <td><a href="/sections">Sections Showcase →</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- CTA -->
    <div class="install-cta anim-slide-up">
      <h2>Ready to build?</h2>
      <p>Browse the full component library and start copying components into your project.</p>
      <div class="install-cta__actions">
        <a href="/docs/glass-button" class="cta-btn cta-btn--primary">
          Browse Components
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/sections" class="cta-btn cta-btn--secondary">
          View Sections
        </a>
      </div>
    </div>
  </div>
</InstallLayout>

<script>
  // Install tabs
  const tabBar = document.querySelector('.install-tabs__bar');
  if (tabBar) {
    tabBar.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement)?.closest('[data-tab]');
      if (!tab) return;

      const tabId = tab.getAttribute('data-tab')!;

      // Update tab buttons
      tabBar.querySelectorAll('.install-tabs__tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      // Update panels
      document.querySelectorAll('.install-tabs__panel').forEach(panel => {
        panel.classList.toggle('active', panel.getAttribute('data-panel') === tabId);
      });
    });
  }

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('copied');
        }, 2000);
      }
    });
  });
</script>

<style>
  .install-page {
    max-width: 780px;
    padding-bottom: var(--sp-16);
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap;
    font-size: 0.8rem; color: var(--c-text-3); margin-bottom: var(--sp-6);
  }
  .breadcrumb a { color: var(--c-text-3); } .breadcrumb a:hover { color: var(--c-text-2); }
  .breadcrumb__sep { color: var(--c-text-3); opacity: 0.5; }
  .breadcrumb__current { color: var(--c-text-2); font-weight: 500; }

  /* Header */
  .install-header {
    margin-bottom: var(--sp-12);
  }
  .install-header__badge {
    display: inline-block;
    padding: 0.25rem 0.75rem; border-radius: var(--r-full);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    background: rgba(16,185,129,0.12); color: #34d399; border: 1px solid rgba(16,185,129,0.25);
    margin-bottom: var(--sp-4);
  }
  .install-header__title {
    font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 900;
    color: var(--c-text-1); letter-spacing: -0.03em;
    margin: 0 0 var(--sp-3);
  }
  .install-header__desc {
    font-size: 1.05rem; color: var(--c-text-2); line-height: 1.7; max-width: 600px;
  }

  /* Install section */
  .install-section {
    margin-top: var(--sp-10);
  }

  .step-badge {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    font-size: 0.75rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--c-primary-light);
    margin-bottom: var(--sp-3);
  }
  .step-badge__optional {
    font-size: 0.65rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--c-text-3);
    background: rgba(255,255,255,0.06); padding: 0.15rem 0.5rem;
    border-radius: var(--r-full); border: 1px solid var(--c-border);
  }

  .step-title {
    font-size: 1.4rem; font-weight: 800; color: var(--c-text-1);
    margin: 0 0 var(--sp-3); letter-spacing: -0.02em;
  }

  .step-subtitle {
    font-size: 0.95rem; font-weight: 700; color: var(--c-text-2);
    margin: 0 0 var(--sp-3);
  }

  .step-desc {
    font-size: 0.95rem; color: var(--c-text-2); line-height: 1.7;
    margin: 0 0 var(--sp-4);
  }
  .step-desc--muted {
    color: var(--c-text-3); font-size: 0.85rem; margin-bottom: var(--sp-3);
  }

  /* Code blocks */
  .code-block-wrap {
    margin-top: var(--sp-3);
  }
  .code-block-wrap--small {
    margin: 0;
  }

  /* Info box */
  .info-box {
    display: flex; align-items: flex-start; gap: var(--sp-3);
    padding: var(--sp-4); border-radius: var(--r-md); margin-top: var(--sp-4);
    background: rgba(99,102,241,0.07); border: 1px solid rgba(99,102,241,0.2);
    color: var(--c-text-2); font-size: 0.875rem; line-height: 1.6;
  }
  .info-box svg { color: var(--c-primary-light); flex-shrink: 0; margin-top: 2px; }
  .info-box code {
    background: rgba(255,255,255,0.08); padding: 0.1rem 0.35rem;
    border-radius: 4px; font-size: 0.82em; color: var(--c-primary-light);
  }
  .info-box a { color: var(--c-primary-light); text-decoration: underline; }
  .info-box--tip {
    background: rgba(16,185,129,0.07); border-color: rgba(16,185,129,0.2);
  }
  .info-box--tip svg { color: #34d399; }

  /* Install tabs */
  .install-tabs {
    margin-top: var(--sp-4);
  }
  .install-tabs__bar {
    display: inline-flex; gap: 2px;
    padding: 4px; background: rgba(255,255,255,0.03);
    border: 1px solid var(--c-border); border-radius: var(--r-md);
  }
  .install-tabs__tab {
    padding: 0.4rem 1.2rem; font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600;
    color: var(--c-text-3); background: transparent; border: none;
    border-radius: calc(var(--r-md) - 4px); cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .install-tabs__tab:hover { color: var(--c-text-1); background: rgba(255,255,255,0.05); }
  .install-tabs__tab.active { color: var(--c-text-1); background: rgba(255,255,255,0.12); }

  .install-tabs__panel { display: none; margin-top: var(--sp-4); }
  .install-tabs__panel.active { display: block; }

  /* Dep grid */
  .dep-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-4);
  }
  .dep-card {
    padding: var(--sp-5);
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
  }
  .dep-card__header {
    display: flex; align-items: flex-start; gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .dep-card__icon {
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: var(--r-md);
    flex-shrink: 0;
  }
  .dep-card__icon--chart {
    background: rgba(59,130,246,0.12); color: #60a5fa;
  }
  .dep-card__icon--3d {
    background: rgba(168,85,247,0.12); color: #c084fc;
  }
  .dep-card__name {
    font-size: 0.95rem; font-weight: 700; color: var(--c-text-1);
    margin: 0;
  }
  .dep-card__desc {
    font-size: 0.8rem; color: var(--c-text-3); margin: 0.15rem 0 0;
  }

  /* Ref table */
  .ref-table {
    margin-top: var(--sp-4);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .ref-table table {
    width: 100%; border-collapse: collapse;
    font-size: 0.875rem;
  }
  .ref-table th {
    text-align: left; padding: var(--sp-3) var(--sp-4);
    font-weight: 700; color: var(--c-text-2);
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid var(--c-border);
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em;
  }
  .ref-table td {
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid rgba(255,255,255,0.04);
    color: var(--c-text-1);
  }
  .ref-table tr:last-child td { border-bottom: none; }
  .ref-table code {
    background: rgba(255,255,255,0.06); padding: 0.1rem 0.35rem;
    border-radius: 4px; font-size: 0.82em; color: var(--c-primary-light);
  }
  .ref-table a { color: var(--c-primary-light); text-decoration: none; }
  .ref-table a:hover { text-decoration: underline; }

  /* CTA */
  .install-cta {
    margin-top: var(--sp-12);
    padding: var(--sp-8);
    text-align: center;
    background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(99,102,241,0.03));
    border: 1px solid rgba(99,102,241,0.2);
    border-radius: var(--r-xl);
  }
  .install-cta h2 {
    font-size: 1.6rem; font-weight: 900; color: var(--c-text-1);
    margin: 0 0 var(--sp-3);
  }
  .install-cta p {
    font-size: 0.95rem; color: var(--c-text-2); margin: 0 0 var(--sp-6);
  }
  .install-cta__actions {
    display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap;
  }
  .cta-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.75rem 1.5rem; font-size: 0.9rem; font-weight: 700;
    border-radius: var(--r-md); text-decoration: none;
    transition: all 0.25s ease; cursor: pointer;
    font-family: var(--font-sans);
  }
  .cta-btn--primary {
    background: linear-gradient(135deg, rgba(184,134,11,0.7), rgba(212,160,23,0.7));
    color: #0a0a0a; border: 1px solid rgba(255,255,255,0.1);
  }
  .cta-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(184,134,11,0.3);
  }
  .cta-btn--secondary {
    background: rgba(255,255,255,0.06); color: var(--c-text-1);
    border: 1px solid var(--c-border);
  }
  .cta-btn--secondary:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.2);
  }

  /* Animations */
  .anim-slide-up {
    opacity: 0; transform: translateY(10px);
    animation: slide-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes slide-up { to { opacity: 1; transform: translateY(0); } }

  /* Responsive */
  @media (max-width: 640px) {
    .install-header__title { font-size: 1.8rem; }
    .dep-grid { grid-template-columns: 1fr; }
    .install-cta__actions { flex-direction: column; }
    .cta-btn { justify-content: center; }
    .ref-table { font-size: 0.8rem; }
    .ref-table th, .ref-table td { padding: var(--sp-2) var(--sp-3); }
  }
</style>
