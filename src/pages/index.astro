    color: var(--c-text-1); background: rgba(255,255,255,0.06);
  }
  .gh-link { display: flex !important; align-items: center; gap: 0.4rem; }
  .site-menu-toggle { display: none; }

  /* ============================================
     HERO
     ============================================ */
  .hero {
