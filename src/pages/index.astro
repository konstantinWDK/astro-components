    box-shadow: 0 8px 40px rgba(184,134,11,0.2), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .hero__install-icon {
    color: var(--c-primary-light);
    opacity: 0.7;
    flex-shrink: 0;
  }
  .hero__install-code {
    font-family: var(--font-mono); font-size: 0.9rem; font-weight: 500;
    color: var(--c-primary-light); letter-spacing: 0.02em;
  }
  .hero__copy-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.35rem; background: transparent;
    border: 1px solid rgba(255,255,255,0.1); border-radius: var(--r-sm);
    color: var(--c-text-3); cursor: pointer; transition: all 0.2s;
  }
  .hero__copy-btn:hover {
    background: rgba(184,134,11,0.15); border-color: rgba(184,134,11,0.4);
    color: var(--c-primary-light); transform: scale(1.05);
  }

  /* CTA Button - Browse Components */
  .hero__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: 0.85rem 1.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-sans);
    color: var(--c-bg);
    background: linear-gradient(135deg, var(--c-primary-light), var(--c-primary));
    border: none;
    border-radius: var(--r-md);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 4px 24px rgba(184,134,11,0.25);
    position: relative;
    overflow: hidden;
  }
  .hero__cta-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .hero__cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(184,134,11,0.35);
    color: var(--c-bg);
  }
  .hero__cta-btn:hover::before {
    opacity: 1;
  }
  .hero__cta-btn svg {
    transition: transform 0.25s ease;
  }
  .hero__cta-btn:hover svg {
    transform: translateX(3px);
  }

  /* Floating showcase cards */
  .showcase-card {
    position: absolute; text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.35s ease, opacity 0.35s ease;
    transform-style: preserve-3d; opacity: 0.75; z-index: 5; pointer-events: auto; cursor: pointer;
  }
  .showcase-card:hover {
    transform: translateY(-4px) scale(1.03) !important;
    opacity: 1 !important; z-index: 15 !important;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.6));
  }
  .showcase-card__inner {
    padding: var(--sp-4);
    background: rgba(10, 10, 10, 0.8); backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.06); border-radius: var(--r-lg);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    transition: border-color 0.4s ease, background 0.4s ease;
  }
  .showcase-card:hover .showcase-card__inner {
    border-color: rgba(255,255,255,0.12); background: rgba(17, 17, 17, 0.9);
  }
  .showcase-card--1 { top: -2%; left: 4%; animation: float-a 9s ease-in-out infinite; }
  .showcase-card--2 { top: 2%; right: 4%; animation: float-b 7.5s ease-in-out infinite 0.8s; }
  .showcase-card--3 { top: 15%; left: 0%; animation: float-c 8.5s ease-in-out infinite 1.2s; }
  .showcase-card--4 { top: 12%; right: 0%; animation: float-a 10s ease-in-out infinite 0.4s reverse; }
  .showcase-card--5 { top: 30%; left: 2%; animation: float-b 8s ease-in-out infinite 2s; }
  .showcase-card--6 { top: 28%; right: 2%; animation: float-c 9.5s ease-in-out infinite 1s reverse; }
  .showcase-card--7 { top: 4%; left: 22%; animation: float-a 7s ease-in-out infinite 1.6s; }
  .showcase-card--8 { top: 6%; right: 22%; animation: float-b 8.5s ease-in-out infinite 0.6s reverse; }
  .showcase-card--9 { top: 50%; left: 3%; animation: float-c 10s ease-in-out infinite 2.2s; }
  .showcase-card--10 { top: 55%; right: 3%; animation: float-a 9s ease-in-out infinite 1.4s reverse; }
  @keyframes float-a {
    0%,100% { transform: translateY(0) translateZ(10px) rotate(-1deg); }
    50% { transform: translateY(-18px) translateZ(30px) rotate(1deg); }
  }
  @keyframes float-b {
    0%,100% { transform: translateY(0) translateZ(20px) rotate(1.5deg); }
    50% { transform: translateY(-22px) translateZ(40px) rotate(-1.5deg); }
  }
  @keyframes float-c {
    0%,100% { transform: translateY(0) translateZ(15px) rotate(-0.5deg); }
    50% { transform: translateY(-15px) translateZ(35px) rotate(2deg); }
  }

  /* ============================================
     SECTION COMMON
     ============================================ */
  .section { position: relative; z-index: 1; padding: 5rem 0; }
  .section__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-primary-light);
    padding: 0.35rem 0.8rem;
    border: 1px solid rgba(184,134,11,0.3);
    border-radius: var(--r-sm);
    margin-bottom: var(--sp-4);
  }
  .section__title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900; color: var(--c-text-1);
    margin-bottom: var(--sp-3); letter-spacing: -0.03em;
  }
  .section__subtitle {
    font-size: 0.95rem; color: var(--c-text-3); margin-bottom: var(--sp-8); max-width: 560px;
  }
  .section__subtitle--wide { max-width: 680px; }

  /* ============================================
     WHY ACCORDION CAROUSEL
     ============================================ */
  .section__header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .why-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(212, 160, 23, 0.08);
    border: 1px solid rgba(212, 160, 23, 0.28);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fbbf24;
    box-shadow: 0 0 20px rgba(212, 160, 23, 0.12);
  }
  .why-badge-pill__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: why-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes why-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 7px rgba(34, 197, 94, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }

  .why-accordion-carousel {
    position: relative;
    margin-top: var(--sp-6);
  }
  .why-accordion-track {
    display: flex;
    gap: var(--sp-4);
    min-height: 480px;
    position: relative;
    perspective: 1200px;
  }

  /* Card base */
  .why-acc-card {
    position: relative;
    flex: 1;
    min-width: 72px;
    border-radius: var(--r-xl);
    background: rgba(18, 18, 22, 0.7);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    outline: none;
    transition: flex 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease,
                box-shadow 0.35s ease,
                background 0.35s ease;
  }
  .why-acc-card:focus-visible {
    box-shadow: 0 0 0 2px var(--c-primary-light), 0 0 25px rgba(212,160,23,0.3);
  }

  /* Subtle continuous floating movement for inactive cards */
  .why-acc-card[data-index="0"]:not(.is-active) { animation: acc-card-float 6s ease-in-out infinite 0s; }
  .why-acc-card[data-index="1"]:not(.is-active) { animation: acc-card-float 6s ease-in-out infinite 1s; }
  .why-acc-card[data-index="2"]:not(.is-active) { animation: acc-card-float 6s ease-in-out infinite 2s; }
  .why-acc-card[data-index="3"]:not(.is-active) { animation: acc-card-float 6s ease-in-out infinite 3s; }
  .why-acc-card[data-index="4"]:not(.is-active) { animation: acc-card-float 6s ease-in-out infinite 4s; }
  .why-acc-card[data-index="5"]:not(.is-active) { animation: acc-card-float 6s ease-in-out infinite 5s; }

  @keyframes acc-card-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .why-acc-card:hover:not(.is-active) {
    background: rgba(28, 28, 35, 0.85);
    border-color: rgba(212, 160, 23, 0.3);
    transform: translateY(-8px);
    box-shadow: 0 15px 35px -10px rgba(0,0,0,0.5), 0 0 20px rgba(212,160,23,0.1);
  }

  /* Active card state */
  .why-acc-card.is-active {
    flex: 3.8;
    cursor: default;
    background: linear-gradient(135deg, rgba(24, 24, 30, 0.95), rgba(15, 15, 18, 0.95));
    border-color: rgba(212, 160, 23, 0.45);
    transform: translateY(-4px);
    box-shadow: 0 30px 80px -15px rgba(0, 0, 0, 0.8),
                0 0 45px rgba(212, 160, 23, 0.18),
                inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  /* Card Backdrop effects */
  .why-acc-card__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .why-acc-card__glow {
    position: absolute;
    top: var(--mouse-y, 20%);
    left: var(--mouse-x, 30%);
    width: 320px;
    height: 320px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(212, 160, 23, 0.18) 0%, rgba(212, 160, 23, 0.04) 45%, transparent 70%);
    border-radius: 50%;
    filter: blur(28px);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .why-acc-card.is-active .why-acc-card__glow {
    opacity: 1;
    animation: acc-glow-pulse 4s ease-in-out infinite;
  }
  @keyframes acc-glow-pulse {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 0.9; transform: translate(-50%, -50%) scale(1.15); }
  }

  .why-acc-card__grid-pattern {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(circle at 50% 30%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, #000 30%, transparent 80%);
    opacity: 0.4;
  }

  /* Floating particles inside cards */
  .why-acc-card__particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .why-acc-particle {
    position: absolute;
    border-radius: 50%;
    background: #fbbf24;
    filter: blur(1px);
    opacity: 0;
  }
  .why-acc-card.is-active .why-acc-particle.p1 {
    width: 4px; height: 4px; left: 20%; bottom: 15%;
    animation: acc-particle-rise 4.5s infinite ease-in;
  }
  .why-acc-card.is-active .why-acc-particle.p2 {
    width: 6px; height: 6px; left: 75%; bottom: 25%;
    animation: acc-particle-rise 5.5s infinite ease-in 1.5s;
  }
  .why-acc-card.is-active .why-acc-particle.p3 {
    width: 3px; height: 3px; left: 45%; bottom: 10%;
    animation: acc-particle-rise 3.8s infinite ease-in 0.8s;
  }
  @keyframes acc-particle-rise {
    0% { transform: translateY(0) scale(0.6); opacity: 0; }
    30% { opacity: 0.8; }
    80% { opacity: 0.4; }
    100% { transform: translateY(-160px) scale(1.2); opacity: 0; }
  }

  /* Collapsed Rail (inactive view) */
  .why-acc-card__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: var(--sp-6) var(--sp-2);
    position: relative;
    z-index: 2;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .why-acc-card.is-active .why-acc-card__rail {
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: scale(0.85);
  }
  .why-acc-card__num {
    font-size: 0.75rem;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    color: var(--c-text-3);
    letter-spacing: 0.1em;
  }
  .why-acc-card__rail-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--r-md);
    background: rgba(212, 160, 23, 0.08);
    border: 1px solid rgba(212, 160, 23, 0.2);
    color: var(--c-primary-light);
    display: grid;
    place-items: center;
    transition: transform 0.3s ease, color 0.3s ease, background 0.3s ease;
  }
  .why-acc-card:hover .why-acc-card__rail-icon {
    transform: scale(1.1) rotate(5deg);
    background: rgba(212, 160, 23, 0.16);
    color: #fef08a;
  }
  .why-acc-card__rail-label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-2);
    white-space: nowrap;
    margin-top: auto;
  }
  .why-acc-card:hover .why-acc-card__rail-label {
    color: var(--c-text-1);
  }

  /* Expanded Content (active view) */
  .why-acc-card__content {
    opacity: 0;
    pointer-events: none;
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: var(--sp-8);
    transform: translateY(16px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .why-acc-card.is-active .why-acc-card__content {
    opacity: 1;
    pointer-events: auto;
    position: relative;
    z-index: 3;
    transform: translateY(0);
    transition: opacity 0.45s ease 0.12s, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
  }

  .why-acc-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
  }
  .why-acc-card__icon-badge {
    width: 52px;
    height: 52px;
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, rgba(212, 160, 23, 0.2), rgba(212, 160, 23, 0.05));
    border: 1px solid rgba(212, 160, 23, 0.35);
    color: #fbbf24;
    display: grid;
    place-items: center;
    box-shadow: 0 0 25px rgba(212, 160, 23, 0.2);
    animation: why-icon-float 4s ease-in-out infinite;
  }
  @keyframes why-icon-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(4deg); }
  }

  .why-acc-card__tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--c-primary-light);
  }

  .why-acc-card__title {
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 900;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: var(--sp-3);
  }
  .why-acc-card__desc {
    font-size: 0.95rem;
    color: var(--c-text-2);
    line-height: 1.65;
    margin-bottom: var(--sp-6);
    max-width: 540px;
  }

  /* Stats row inside active card */
  .why-acc-card__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
    margin-top: auto;
    margin-bottom: var(--sp-6);
  }
  .why-stat-pill {
    padding: var(--sp-3) var(--sp-4);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--r-md);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .why-stat-pill:hover {
    transform: translateY(-2px);
    background: rgba(212, 160, 23, 0.06);
    border-color: rgba(212, 160, 23, 0.25);
  }
  .why-stat-pill__value {
    font-size: 1.15rem;
    font-weight: 900;
    color: #fbbf24;
    font-family: var(--font-mono, monospace);
    letter-spacing: -0.01em;
  }
  .why-stat-pill__label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--c-text-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 2px;
  }

  /* Active card action button */
  .why-acc-card__action {
    display: flex;
    align-items: center;
  }
  .why-acc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.4rem;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, rgba(212, 160, 23, 0.2), rgba(212, 160, 23, 0.08));
    border: 1px solid rgba(212, 160, 23, 0.4);
    color: #fef08a;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
  }
  .why-acc-btn svg {
    transition: transform 0.25s ease;
  }
  .why-acc-btn:hover {
    background: linear-gradient(135deg, rgba(212, 160, 23, 0.35), rgba(212, 160, 23, 0.18));
    border-color: rgba(251, 191, 36, 0.7);
    color: #ffffff;
    box-shadow: 0 0 25px rgba(212, 160, 23, 0.35);
    transform: translateX(3px);
  }
  .why-acc-btn:hover svg {
    transform: translateX(3px);
  }

  /* Carousel bottom controls */
  .why-accordion-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    padding: var(--sp-3) var(--sp-4);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--r-lg);
  }
  .why-acc-nav-btns {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .why-acc-nav-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--c-text-2);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .why-acc-nav-btn:hover {
    background: rgba(212, 160, 23, 0.15);
    border-color: rgba(212, 160, 23, 0.4);
    color: #fbbf24;
    transform: scale(1.05);
  }

  /* Timeline Pills with progress animation */
  .why-acc-pills {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
    justify-content: center;
    flex: 1;
    margin: 0 var(--sp-2);
  }
  .why-acc-pill {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 0.35rem 0.65rem;
    border-radius: var(--r-sm);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    text-align: left;
  }
  .why-acc-pill__bar {
    width: 100%;
    min-width: 44px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
    position: relative;
  }
  .why-acc-pill__progress {
    position: absolute;
    top: 0; left: 0;
    height: 100%;
    width: 0%;
    background: #fbbf24;
    border-radius: 2px;
  }
  .why-acc-pill.is-active .why-acc-pill__progress {
    width: 100%;
    animation: acc-pill-progress 5s linear forwards;
  }
  .why-accordion-carousel:hover .why-acc-pill.is-active .why-acc-pill__progress {
    animation-play-state: paused;
  }
  @keyframes acc-pill-progress {
    0% { width: 0%; }
    100% { width: 100%; }
  }

  .why-acc-pill__label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--c-text-3);
    transition: color 0.25s ease;
    white-space: nowrap;
  }
  .why-acc-pill:hover .why-acc-pill__label,
  .why-acc-pill.is-active .why-acc-pill__label {
    color: var(--c-primary-light);
  }

  .why-acc-counter {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--c-text-2);
  }
  #whyCurrentIndex {
    color: #fbbf24;
    font-weight: 800;
  }
  .why-acc-counter__sep {
    color: var(--c-text-3);
    opacity: 0.6;
  }

  /* Responsive behavior for Accordion */
  @media (max-width: 992px) {
    .why-accordion-track {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: var(--sp-4);
      -webkit-overflow-scrolling: touch;
      min-height: auto;
    }
    .why-acc-card {
      min-width: 82vw;
      max-width: 440px;
      scroll-snap-align: center;
      flex: 0 0 82vw;
    }
    .why-acc-card.is-active {
      flex: 0 0 82vw;
    }
    .why-acc-card__rail {
      display: none !important;
    }
    .why-acc-card__content {
      opacity: 1 !important;
      position: relative !important;
      pointer-events: auto !important;
      transform: none !important;
      padding: var(--sp-6);
    }
    .why-acc-pills {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .why-acc-card {
      min-width: 90vw;
      flex: 0 0 90vw;
    }
    .why-acc-card.is-active {
      flex: 0 0 90vw;
    }
    .why-acc-card__stats {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
  }

  /* ============================================
     CAROUSEL
     ============================================ */
  .section--carousel { padding-top: 3rem; }
  .carousel-wrap {
    overflow: hidden;
    margin: var(--sp-8) calc(-1 * var(--sp-6));
    padding: var(--sp-4) 0;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .carousel-wrap--reverse .carousel-track {
    animation-direction: reverse;
  }
  .carousel-track {
    display: flex;
    gap: var(--sp-6);
    width: max-content;
    animation: carousel-scroll 30s linear infinite;
  }
  .carousel-track:hover { animation-play-state: paused; }
  @keyframes carousel-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .carousel-slide {
    display: flex; flex-direction: column; align-items: center; gap: var(--sp-3);
    flex-shrink: 0;
  }
  .carousel-card {
    padding: var(--sp-6);
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    display: flex; align-items: center; justify-content: center;
    min-width: 220px;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
    cursor: pointer;
  }
  .carousel-card:hover {
    border-color: rgba(184,134,11,0.3);
    box-shadow: 0 12px 40px rgba(184,134,11,0.1);
    transform: scale(1.05);
  }
  .carousel-card__label {
    font-size: 0.75rem; font-weight: 600; color: var(--c-text-3);
    letter-spacing: 0.04em; text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .carousel-card__label:hover {
    color: var(--c-primary-light);
    transform: translateY(-1px);
  }
  .carousel-cta {
    display: flex; justify-content: center; margin-top: var(--sp-10);
    padding-top: var(--sp-8); border-top: 1px solid var(--c-border);
  }

  /* ============================================
     SECTIONS FULL-WIDTH SHOWCASE CAROUSEL
     ============================================ */
  .section--sections-carousel {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: var(--sp-12) 0;
    overflow: hidden;
    background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(234, 179, 8, 0.08) 0%, transparent 60%),
                linear-gradient(180deg, rgba(10, 14, 26, 0.5) 0%, rgba(6, 8, 16, 0.95) 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .sections-carousel__header-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: var(--sp-8);
    flex-wrap: wrap;
  }

  .sections-carousel__header-left {
    max-width: 650px;
  }

  .sections-carousel__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(234, 179, 8, 0.12);
    border: 1px solid rgba(234, 179, 8, 0.3);
    border-radius: var(--r-full);
    color: #facc15;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
  }

  .badge-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #facc15;
    box-shadow: 0 0 8px #facc15;
    animation: pulse-glow 2s infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .sections-carousel__title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    margin: 0 0 var(--sp-3);
  }

  .sections-carousel__subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .sections-carousel__header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .sections-carousel__nav-btns {
    display: flex;
    gap: 0.5rem;
  }

  .carousel-nav-btn {
    width: 42px;
    height: 42px;
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .carousel-nav-btn:hover {
    background: rgba(234, 179, 8, 0.2);
    border-color: rgba(234, 179, 8, 0.4);
    color: #facc15;
    transform: translateY(-2px);
  }

  .sections-carousel__all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.2rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-full);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .sections-carousel__all-link:hover {
    background: rgba(234, 179, 8, 0.15);
    border-color: rgba(234, 179, 8, 0.4);
    color: #facc15;
  }

  .sections-carousel__track-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .sections-carousel__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 1rem max(1.5rem, calc((100vw - 1400px) / 2));
    scrollbar-width: none;
  }
  .sections-carousel__track::-webkit-scrollbar { display: none; }

  .sections-carousel__slide {
    scroll-snap-align: center;
    flex: 0 0 min(660px, 86vw);
    height: 480px;
    display: flex;
    flex-direction: column;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .sections-carousel__slide:hover {
    transform: translateY(-4px);
    border-color: rgba(234, 179, 8, 0.35);
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.8), 0 0 25px -10px rgba(234, 179, 8, 0.15);
  }

  .slide-card__header {
    padding: 1.2rem 1.5rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(10, 15, 30, 0.4);
    flex-shrink: 0;
  }

  .slide-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .slide-card__category-pill {
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #facc15;
    background: rgba(234, 179, 8, 0.12);
    border: 1px solid rgba(234, 179, 8, 0.25);
    padding: 0.12rem 0.5rem;
    border-radius: var(--r-full);
  }

  .slide-card__title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
  }

  .slide-card__summary {
    font-size: 0.8rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.4;
  }

  .slide-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-full);
    color: #cbd5e1;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .slide-card__action:hover {
    background: #facc15;
    color: #000;
    border-color: #facc15;
  }

  .slide-card__viewport {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: #060913;
  }

  .slide-card__preview-scaler {
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .slide-card__preview-scaler :global(section) {
    padding: 1.5rem 1rem !important;
    min-height: auto !important;
    background: transparent !important;
  }

  .slide-card__preview-scaler :global(.container) {
    max-width: 100% !important;
    padding: 0 1rem !important;
  }

  .slide-card__preview-scaler :global(.section-title),
  .slide-card__preview-scaler :global(.stats-title),
  .slide-card__preview-scaler :global(.cta-title) {
    font-size: 1.25rem !important;
    margin-bottom: 0.5rem !important;
  }

  .slide-card__preview-scaler :global(.section-subtitle),
  .slide-card__preview-scaler :global(.stats-subtitle),
  .slide-card__preview-scaler :global(.cta-subtitle) {
    font-size: 0.85rem !important;
    margin-bottom: 1rem !important;
  }

  .slide-card__preview-scaler :global(.section-badge),
  .slide-card__preview-scaler :global(.stats-badge),
  .slide-card__preview-scaler :global(.cta-badge) {
    display: none !important;
  }

  .slide-card__glass-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 75px;
    background: linear-gradient(to top, rgba(6, 9, 19, 0.98) 25%, rgba(6, 9, 19, 0.7) 65%, transparent 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 15px;
  }

  .slide-card__explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    background: rgba(234, 179, 8, 0.15);
    border: 1px solid rgba(234, 179, 8, 0.35);
    border-radius: var(--r-full);
    color: #facc15;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .slide-card__explore-btn:hover {
    background: #facc15;
    color: #000;
    box-shadow: 0 0 20px rgba(234, 179, 8, 0.4);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .sections-carousel__slide {
      flex: 0 0 90vw;
      height: 460px;
    }
    .slide-card__header {
      padding: 1rem;
    }
  }

  /* ============================================
     BRUTALIST MARQUEE
     ============================================ */
  .brutal-marquee {
    position: relative; z-index: 1;
    padding: var(--sp-8) 0;
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
    background: rgba(184,134,11,0.02);
    overflow: hidden;
  }
  .brutal-marquee__track {
    display: flex; align-items: center; gap: var(--sp-6);
    width: max-content;
    animation: marquee-scroll 20s linear infinite;
  }
  .brutal-marquee__track:hover { animation-play-state: paused; }
  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .brutal-marquee__item {
    font-size: 1.4rem; font-weight: 900;
    color: var(--c-text-1); letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .brutal-marquee__sep {
    font-size: 0.8rem; color: var(--c-primary-light);
    animation: sep-spin 2s linear infinite;
  }
  @keyframes sep-spin {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(180deg); }
  }

  /* ============================================
     ADVANTAGES
     ============================================ */
  .advantages-list {
    display: flex; flex-direction: column; gap: var(--sp-8);
    margin-top: var(--sp-10);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--c-border);
  }
  .advantage-item {
    display: flex; gap: var(--sp-6);
    padding: var(--sp-8);
    background: rgba(255,255,255,0.01);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    transition: border-color 0.3s, background 0.3s;
  }
  .advantage-item:hover {
    border-color: rgba(184,134,11,0.2);
    background: rgba(255,255,255,0.02);
  }
  .advantage-item__number {
    font-size: 2.5rem; font-weight: 900;
    background: linear-gradient(180deg, #e8b830, #a07818);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    line-height: 1; flex-shrink: 0;
    opacity: 0.5;
  }
  .advantage-item__content { flex: 1; }
  .advantage-item__content h3 {
    font-size: 1.2rem; font-weight: 800; color: var(--c-text-1);
    margin-bottom: var(--sp-3);
  }
  .advantage-item__content p {
    font-size: 0.9rem; color: var(--c-text-2); line-height: 1.7; max-width: 600px;
  }

  /* ============================================
     HOVER SHOWCASE
     ============================================ */
  .hover-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--sp-5);
    margin-top: var(--sp-8);
  }
  .hover-tile {
    display: block; text-decoration: none;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: rgba(255,255,255,0.02);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    cursor: pointer;
  }
  .hover-tile:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 24px 64px rgba(184,134,11,0.12);
    border-color: rgba(184,134,11,0.3);
  }
  .hover-tile__visual {
    padding: var(--sp-8) var(--sp-6);
    display: flex; align-items: center; justify-content: center;
    min-height: 120px;
    background: rgba(0,0,0,0.15);
    position: relative;
    overflow: hidden;
  }
  .hover-tile__visual::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(184,134,11,0.05), transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .hover-tile:hover .hover-tile__visual::after { opacity: 1; }
  .hover-tile__info {
    padding: var(--sp-4) var(--sp-6);
    display: flex; justify-content: space-between; align-items: center;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .hover-tile__name {
    font-size: 0.85rem; font-weight: 700; color: var(--c-text-1);
  }
  .hover-tile__effect {
    font-size: 0.7rem; font-weight: 500; color: var(--c-primary-light);
    padding: 0.2rem 0.5rem;
    background: rgba(184,134,11,0.1);
    border-radius: var(--r-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ============================================
     CATEGORY GRID
     ============================================ */
  .category-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--sp-4);
  }
  .category-card {
    padding: var(--sp-6); border-radius: var(--r-lg); text-decoration: none;
    background: rgba(255,255,255,0.03); border: 1px solid var(--c-border);
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .category-card:hover {
    transform: translateY(-4px); border-color: rgba(255,255,255,0.1);
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
  }
  .category-card__icon { font-size: 1.8rem; display: block; margin-bottom: var(--sp-3); }
  .category-card__name { font-size: 1rem; font-weight: 700; color: var(--c-text-1); margin-bottom: var(--sp-2); }
  .category-card__desc { font-size: 0.82rem; color: var(--c-text-2); line-height: 1.5; }

  /* ============================================
     INSTALL
     ============================================ */
  .section--install { padding: 5rem 0; }
  .install-inner {
    text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--sp-6);
  }
  .install-subtitle {
    font-size: 1rem; color: var(--c-text-2); max-width: 400px; margin-top: calc(-1 * var(--sp-2));
  }
  .install-code-block {
    display: inline-flex; align-items: center; gap: var(--sp-4);
    padding: 1rem 1.5rem;
    background: rgba(0, 0, 0, 0.4); border: 1px solid var(--c-border); border-radius: var(--r-lg);
    position: relative; transition: border-color 0.2s, box-shadow 0.2s;
  }
  .install-code-block:hover {
    border-color: rgba(184,134,11,0.25); box-shadow: 0 8px 32px rgba(184,134,11,0.08);
  }
  .install-code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 1.1rem; font-weight: 500; color: var(--c-primary-light); letter-spacing: 0.02em;
  }
  .install-copy-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.4rem; background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--r-sm);
    color: var(--c-text-2); transition: all 0.2s;
  }
  .install-copy-btn:hover {
    background: rgba(184,134,11,0.15); border-color: rgba(184,134,11,0.3);
    color: var(--c-primary-light);
  }
  .install-note { font-size: 0.875rem; color: var(--c-text-3); }

  /* ============================================
     CTA
     ============================================ */
  .cta-section { position: relative; z-index: 1; padding: 5rem 0; }
  .cta-inner {
    text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--sp-6);
    background: rgba(184,134,11,0.04); border: 1px solid rgba(184,134,11,0.1);
    border-radius: var(--r-xl); padding: var(--sp-12);
  }
  .cta-title { font-size: 2.2rem; font-weight: 900; color: var(--c-text-1); letter-spacing: -0.03em; }
  .cta-subtitle { font-size: 1rem; color: var(--c-text-2); max-width: 400px; }

  /* ============================================
     BUTTONS
     ============================================ */
  .btn-primary {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    padding: 0.85rem 2rem; font-size: 0.95rem; font-weight: 700;
    color: #0a0a0a;
    background: linear-gradient(135deg, #b8860b, #d4a017);
    border-radius: var(--r-md); text-decoration: none;
    box-shadow: 0 4px 24px rgba(184,134,11,0.2);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(184,134,11,0.3); color: #0a0a0a; }

  /* ============================================
     FOOTER
     ============================================ */
  .footer { position: relative; z-index: 1; border-top: 1px solid var(--c-border); padding: var(--sp-8) 0; }
  .footer__inner {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 0.83rem; color: var(--c-text-3); gap: var(--sp-4);
  }
  .footer a { color: var(--c-text-2); } .footer a:hover { color: var(--c-text-1); }
  .footer__license { font-size: 0.75rem; }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 1200px) {
    .hover-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  }

  @media (max-width: 640px) {
    /* Container override for tight mobile */
    .container { padding: 0 var(--sp-4); }

    /* Header - hamburger menu */
    .site-header { position: sticky; height: 80px; }
    .site-header__inner { gap: var(--sp-3); padding: 0 var(--sp-4); width: 100%; max-width: 100%; }
    .brand-logo { height: 60px; }
    .site-header__toggle { display: flex; }
    .site-header__nav {
      position: absolute;
      top: 100%;
      left: 0; right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0;
      background: rgba(5,5,5,0.97);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--c-border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, padding 0.35s ease;
      margin-left: 0;
      width: 100%;
      z-index: 99;
    }
    .site-header__nav.is-open {
      max-height: 200px;
      padding: var(--sp-3) 0;
    }
    .site-header__nav a {
      padding: var(--sp-3) var(--sp-5);
      font-size: 0.95rem;
      width: 100%;
      text-align: center;
    }

    /* Sections */
    .section { padding: 3rem 0; }
    .section__title { font-size: 1.4rem; }
    .section__subtitle { font-size: 0.875rem; margin-bottom: var(--sp-6); }
    .section__eyebrow { font-size: 0.7rem; }

    /* Brutalist accents - hide on mobile */
    .brutal-line, .brutal-block { display: none; }

    /* Hero */
    .hero { padding: 5rem 0 3rem; min-height: auto; }
    .hero__scene { min-height: auto; max-width: 100%; perspective: none; }
    .hero__content { padding: var(--sp-6) var(--sp-4); }
    .hero__title-main { font-size: clamp(2rem, 10vw, 3rem); }
    
    .hero__subtitle { 
      max-width: 320px; 
      font-size: 0.9rem;
      padding: 0.6rem 1rem;
      background: rgba(5, 5, 5, 0.75);
    }
    
    /* Hero actions mobile */
    .hero__actions { width: 100%; max-width: 320px; }
    .hero__install-wrap { width: 100%; }
    .hero__install { 
      padding: 0.75rem 1rem; 
      width: 100%;
      justify-content: center;
      background: rgba(10, 10, 10, 0.9);
    }
    .hero__install-code { font-size: 0.8rem; }
    .hero__cta-btn { 
      padding: 0.75rem 1.5rem; 
      font-size: 0.9rem;
      width: 100%;
      max-width: 280px;
    }

    /* Showcase cards - reduce to 4 visible, repositioned */
    .showcase-card--1 { top: 3%; left: -5px; transform: scale(0.7); }
    .showcase-card--2 { top: 3%; right: -5px; transform: scale(0.7); }
    .showcase-card--3 { bottom: 10px; left: -5px; transform: scale(0.7); }
    .showcase-card--4 { bottom: 10px; right: -5px; transform: scale(0.7); }
    .showcase-card--5, .showcase-card--6, .showcase-card--7,
    .showcase-card--8 { display: none; }
    .showcase-card:hover { transform: scale(0.8) !important; opacity: 0.7 !important; }
    .showcase-glow { display: none; }

    /* Carousel */
    .carousel-wrap { margin: var(--sp-6) calc(-1 * var(--sp-4)); }
    .carousel-card { min-width: 180px; padding: var(--sp-4); }

    /* Hover grid */
    .hover-grid { grid-template-columns: repeat(2, 1fr); gap: var(--sp-3); }
    .hover-tile__visual { padding: var(--sp-4) var(--sp-3); min-height: 80px; }
    .hover-tile__info { padding: var(--sp-3) var(--sp-3); }
    .hover-tile__name { font-size: 0.75rem; }
    .hover-tile__effect { font-size: 0.6rem; }

    /* Advantages */
    .advantage-item { flex-direction: column; gap: var(--sp-2); padding: var(--sp-5); }
    .advantage-item__number { font-size: 2rem; }

    /* Category grid */
    .category-grid { grid-template-columns: repeat(2, 1fr); gap: var(--sp-3); }
    .category-card { padding: var(--sp-4); }
    .category-card__icon { font-size: 1.4rem; }
    .category-card__name { font-size: 0.9rem; }
    .category-card__desc { font-size: 0.75rem; }

    /* Install */
    .install-code-block { padding: 0.8rem 1rem; }
    .install-code { font-size: 0.9rem; }

    /* CTA */
    .cta-inner { padding: var(--sp-8) var(--sp-5); }
    .cta-title { font-size: 1.5rem; }
    .cta-subtitle { font-size: 0.875rem; }

    /* Footer */
    .footer__inner { flex-direction: column; text-align: center; gap: var(--sp-2); }

    /* Brutalist marquee */
    .brutal-marquee__item { font-size: 1rem; }
  }

  @media (max-width: 768px) {
    .site-menu-toggle {
      display: flex; align-items: center; justify-content: center;
      background: transparent; border: none; color: var(--c-text-1); cursor: pointer;
      margin-left: auto;
    }
    .docs-header__nav {
      display: none;
      position: absolute; top: var(--header-h); left: 0; width: 100%;
      background: rgba(8, 11, 20, 0.98); backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--c-border);
      flex-direction: column; padding: var(--sp-6); gap: var(--sp-4);
      align-items: stretch;
    }
    .docs-header__nav.is-open { display: flex; }
    .docs-header__nav a { text-align: center; padding: 0.8rem; font-size: 1.1rem; }
  }

  @media (max-width: 400px) {
    .docs-header { height: 70px; }
    .brand-logo { height: 50px; }
    .hero__title-main { font-size: 1.8rem; }
    .hero__subtitle { max-width: 260px; }
    .hover-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track, .carousel-track--reverse { animation: none; overflow-x: auto; }
    .brutal-marquee__track { animation: none; overflow-x: auto; }
    .brutal-line, .brutal-block { animation: none; }
  }
</style>

<script>
  // Mobile hamburger toggle
  const navToggle = document.getElementById('site-menu-toggle') as HTMLButtonElement;
  const mainNav = document.getElementById('site-nav') as HTMLElement;
  if (navToggle && mainNav) {
    navToggle.addEventListener('click', () => {
      const isOpen = mainNav.classList.toggle('is-open');
      navToggle.setAttribute('aria-expanded', String(isOpen));
    });
    // Close menu when clicking a link
    mainNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mainNav.classList.remove('is-open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Copy install command
  const heroCopyBtn = document.getElementById('heroCopyBtn');
  if (heroCopyBtn) {
    heroCopyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('npm install astro-component-kit');
      
      // Visual feedback
      const originalHTML = heroCopyBtn.innerHTML;
      heroCopyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>`;
      heroCopyBtn.style.borderColor = 'rgba(34, 197, 94, 0.6)';
      heroCopyBtn.style.color = '#22c55e';
      
      setTimeout(() => {
        heroCopyBtn.innerHTML = originalHTML;
        heroCopyBtn.style.borderColor = '';
        heroCopyBtn.style.color = '';
      }, 2000);
    });
  }

  // Sections Showcase Carousel Navigation
  const sectionsTrack = document.getElementById('sectionsTrack');
  const sectionsPrev = document.getElementById('sectionsPrevBtn');
  const sectionsNext = document.getElementById('sectionsNextBtn');

  if (sectionsTrack && sectionsPrev && sectionsNext) {
    sectionsPrev.addEventListener('click', () => {
      const card = sectionsTrack.querySelector('.sections-carousel__slide') as HTMLElement | null;
      const step = card ? card.offsetWidth + 24 : 500;
      sectionsTrack.scrollBy({ left: -step, behavior: 'smooth' });
    });

    sectionsNext.addEventListener('click', () => {
      const card = sectionsTrack.querySelector('.sections-carousel__slide') as HTMLElement | null;
      const step = card ? card.offsetWidth + 24 : 500;
      sectionsTrack.scrollBy({ left: step, behavior: 'smooth' });
    });
  }

  // ============================================
  // WHY ACCORDION CAROUSEL INTERACTIVITY
  // ============================================
  (function initWhyAccordion() {
    const carousel = document.getElementById('whyAccordionCarousel');
    const track = document.getElementById('whyAccordionTrack');
    const prevBtn = document.getElementById('whyPrevBtn');
    const nextBtn = document.getElementById('whyNextBtn');
    const counter = document.getElementById('whyCurrentIndex');
    if (!carousel || !track) return;

    const cards = Array.from(track.querySelectorAll('.why-acc-card')) as HTMLElement[];
    const pills = Array.from(carousel.querySelectorAll('.why-acc-pill')) as HTMLElement[];
    const total = cards.length;
    let currentIndex = 0;
    let autoPlayTimer: any = null;
    let isHovered = false;

    function setActiveCard(index: number, smoothScroll = true) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      currentIndex = index;

      cards.forEach((card, idx) => {
        const isActive = idx === currentIndex;
        card.classList.toggle('is-active', isActive);
        card.setAttribute('aria-selected', String(isActive));

        if (!isActive) {
          card.style.transform = '';
          card.style.removeProperty('--mouse-x');
          card.style.removeProperty('--mouse-y');
        }
      });

      pills.forEach((pill, idx) => {
        const isActive = idx === currentIndex;
        pill.classList.toggle('is-active', isActive);
        pill.setAttribute('aria-selected', String(isActive));
      });

      if (counter) {
        counter.textContent = String(currentIndex + 1).padStart(2, '0');
      }

      if (window.innerWidth <= 992 && smoothScroll) {
        const targetCard = cards[currentIndex];
        if (targetCard) {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      }

      resetAutoPlay();
    }

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        if (currentIndex !== idx) {
          setActiveCard(idx);
        }
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setActiveCard(idx);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          setActiveCard(currentIndex + 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          setActiveCard(currentIndex - 1);
        }
      });

      card.addEventListener('mousemove', (e) => {
        if (!card.classList.contains('is-active') || window.innerWidth <= 992) return;
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -4;
        const rotateY = ((x - centerX) / centerX) * 4;

        card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-4px)`;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });

      card.addEventListener('mouseleave', () => {
        if (card.classList.contains('is-active')) {
          card.style.transform = 'translateY(-4px)';
        }
      });
    });

    pills.forEach((pill, idx) => {
      pill.addEventListener('click', () => {
        setActiveCard(idx);
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        setActiveCard(currentIndex - 1);
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        setActiveCard(currentIndex + 1);
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        if (!isHovered) {
          setActiveCard(currentIndex + 1, false);
        }
      }, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    function resetAutoPlay() {
      startAutoPlay();
    }

    carousel.addEventListener('mouseenter', () => {
      isHovered = true;
    });

    carousel.addEventListener('mouseleave', () => {
      isHovered = false;
    });

    startAutoPlay();
  })();

  // Three.js background scene
  (async function() {
    const THREE: any = await import('three');

    const canvas = document.getElementById('bg-3d-canvas');
    if (!canvas) return;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 50);
    camera.position.set(0, 0, 8);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    function resize() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener('resize', resize);

    // Color palette
    const goldColors = [
      new THREE.Color('#fef3c7'),
      new THREE.Color('#fbbf24'),
      new THREE.Color('#d4a017'),
      new THREE.Color('#ffffff'),
      new THREE.Color('#b8860b'),
      new THREE.Color('#fde68a'),
    ];

    // ========== FLOATING PARTICLES ==========
    const particleCount = 300;
    const particleGeometry = new THREE.BufferGeometry();
    const particlePositions = new Float32Array(particleCount * 3);
    const particleColors = new Float32Array(particleCount * 3);
    const particleSizes = new Float32Array(particleCount);
    const particleVelocities: { x: number; y: number; z: number }[] = [];

    for (let i = 0; i < particleCount; i++) {
      const i3 = i * 3;
      particlePositions[i3] = (Math.random() - 0.5) * 16;
      particlePositions[i3 + 1] = (Math.random() - 0.5) * 10;
      particlePositions[i3 + 2] = (Math.random() - 0.5) * 6 - 2;

      const color = goldColors[Math.floor(Math.random() * goldColors.length)];
      particleColors[i3] = color.r;
      particleColors[i3 + 1] = color.g;
      particleColors[i3 + 2] = color.b;

      particleSizes[i] = Math.random() * 0.04 + 0.01;

      particleVelocities.push({
        x: (Math.random() - 0.5) * 0.002,
        y: (Math.random() - 0.5) * 0.002,
        z: (Math.random() - 0.5) * 0.001,
      });
    }

    particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
    particleGeometry.setAttribute('color', new THREE.BufferAttribute(particleColors, 3));
    particleGeometry.setAttribute('size', new THREE.BufferAttribute(particleSizes, 1));

    const particleMaterial = new THREE.PointsMaterial({
      size: 0.03,
      sizeAttenuation: true,
      depthWrite: false,
      transparent: true,
      opacity: 0.6,
      vertexColors: true,
      blending: THREE.AdditiveBlending,
    });

    const particles = new THREE.Points(particleGeometry, particleMaterial);
    scene.add(particles);

    // ========== CONNECTION LINES ==========
    const lineMaterial = new THREE.LineBasicMaterial({
      color: new THREE.Color('#fbbf24'),
      transparent: true,
      opacity: 0.04,
      blending: THREE.AdditiveBlending,
    });

    // ========== BACKGROUND STARS ==========
    const starCount = 600;
    const starGeometry = new THREE.BufferGeometry();
    const starPositions = new Float32Array(starCount * 3);
    const starColors = new Float32Array(starCount * 3);

    for (let i = 0; i < starCount; i++) {
      const i3 = i * 3;
      starPositions[i3] = (Math.random() - 0.5) * 25;
      starPositions[i3 + 1] = (Math.random() - 0.5) * 25;
      starPositions[i3 + 2] = (Math.random() - 0.5) * 10 - 5;

      const color = goldColors[Math.floor(Math.random() * goldColors.length)];
      starColors[i3] = color.r;
      starColors[i3 + 1] = color.g;
      starColors[i3 + 2] = color.b;
    }

    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    starGeometry.setAttribute('color', new THREE.BufferAttribute(starColors, 3));

    const starMaterial = new THREE.PointsMaterial({
      size: 0.015,
      sizeAttenuation: true,
      depthWrite: false,
      transparent: true,
      opacity: 0.4,
      vertexColors: true,
      blending: THREE.AdditiveBlending,
    });

    const bgStars = new THREE.Points(starGeometry, starMaterial);
    scene.add(bgStars);

    // ========== SHOOTING STARS ==========
    const shootingStars: any[] = [];
    const shootingStarGeometry = new THREE.BufferGeometry();
    shootingStarGeometry.setAttribute('position', new THREE.BufferAttribute(new Float32Array(3), 3));

    for (let i = 0; i < 3; i++) {
      const shootingStarMaterial = new THREE.PointsMaterial({
        size: 0.05,
        color: new THREE.Color('#ffffff'),
        transparent: true,
        opacity: 0,
        blending: THREE.AdditiveBlending,
      });

      const shootingStar = new THREE.Points(shootingStarGeometry, shootingStarMaterial);
      shootingStar.visible = false;
      scene.add(shootingStar);
      shootingStars.push({
        mesh: shootingStar,
        active: false,
        velocity: new THREE.Vector3(),
        timer: Math.random() * 500 + 200,
      } as any);
    }

    // ========== MOUSE INTERACTION ==========
    const mouse = { x: 0, y: 0 };
    let targetMouseX = 0;
    let targetMouseY = 0;

    document.addEventListener('mousemove', (e) => {
      targetMouseX = (e.clientX / window.innerWidth) * 2 - 1;
      targetMouseY = -(e.clientY / window.innerHeight) * 2 + 1;
    });

    // ========== SCROLL EFFECT ==========
    let scrollY = 0;
    window.addEventListener('scroll', () => {
      scrollY = window.pageYOffset;
    }, { passive: true });

    // ========== ANIMATION ==========
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();
      const delta = clock.getDelta() || 0.016;

      // Smooth mouse
      mouse.x += (targetMouseX - mouse.x) * 0.03;
      mouse.y += (targetMouseY - mouse.y) * 0.03;

      // Update particles
      const positions = particleGeometry.attributes.position.array as Float32Array;
      for (let i = 0; i < particleCount; i++) {
        const i3 = i * 3;
        const vel = particleVelocities[i];

        positions[i3] += vel.x + Math.sin(elapsed + i) * 0.0003;
        positions[i3 + 1] += vel.y + Math.cos(elapsed * 0.8 + i) * 0.0003;
        positions[i3 + 2] += vel.z;

        // Wrap around
        if (positions[i3] > 8) positions[i3] = -8;
        if (positions[i3] < -8) positions[i3] = 8;
        if (positions[i3 + 1] > 5) positions[i3 + 1] = -5;
        if (positions[i3 + 1] < -5) positions[i3 + 1] = 5;
      }
      particleGeometry.attributes.position.needsUpdate = true;

      // Rotate stars
      bgStars.rotation.y = elapsed * 0.008;
      bgStars.rotation.x = elapsed * 0.004;

      // Camera follows mouse gently
      camera.position.x = mouse.x * 0.15;
      camera.position.y = mouse.y * 0.1;
      camera.lookAt(0, 0, 0);

      // Scroll effect on camera
      camera.position.z = 8 + scrollY * 0.003;

      renderer.render(scene, camera);
    }

    animate();
  })();
</script>
