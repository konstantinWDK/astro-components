---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, components, getFeaturedComponents } from '../data/registry/index';

// Import demo components
import GlassButton from '../components/lib/buttons/GlassButton.astro';
import CyberpunkButton from '../components/lib/buttons/CyberpunkButton.astro';
import GlowButton from '../components/lib/buttons/GlowButton.astro';
import ShimmerButton from '../components/lib/buttons/ShimmerButton.astro';
import PulseButton from '../components/lib/buttons/PulseButton.astro';
import ShinyButton from '../components/lib/buttons/ShinyButton.astro';
import NeumorphicButton from '../components/lib/buttons/NeumorphicButton.astro';
import GlassCard from '../components/lib/cards/GlassCard.astro';
import ProfileCard from '../components/lib/cards/ProfileCard.astro';
import PricingCard from '../components/lib/cards/PricingCard.astro';
import CyberFeatureCard from '../components/lib/cards/CyberFeatureCard.astro';
import StatCard from '../components/lib/cards/StatCard.astro';
import GlassAlert from '../components/lib/feedback/GlassAlert.astro';
import Badge from '../components/lib/feedback/Badge.astro';
import NeonSpinner from '../components/lib/feedback/NeonSpinner.astro';
import TypingIndicator from '../components/lib/feedback/TypingIndicator.astro';
import CyberGlitchAlert from '../components/lib/feedback/CyberGlitchAlert.astro';
import Spotlight from '../components/lib/feedback/Spotlight.astro';
import KanbanItemCard from '../components/lib/cards/KanbanItemCard.astro';
import InteractiveTiltCard from '../components/lib/cards/InteractiveTiltCard.astro';
import RatingPill from '../components/lib/feedback/RatingPill.astro';
import AnimatedInput from '../components/lib/forms/AnimatedInput.astro';
import RatingStars from '../components/lib/forms/RatingStars.astro';
import NeumorphicSwitch from '../components/lib/forms/NeumorphicSwitch.astro';
import GlassSlider from '../components/lib/forms/GlassSlider.astro';
import OTPInput from '../components/lib/forms/OTPInput.astro';
import NotificationCard from '../components/lib/cards/NotificationCard.astro';
import WeatherWidgetCard from '../components/lib/cards/WeatherWidgetCard.astro';
import StepProgress from '../components/lib/feedback/StepProgress.astro';
import PulseDot from '../components/lib/feedback/PulseDot.astro';
import Galaxy3D from '../components/lib/Galaxy3D.astro';

const featured = getFeaturedComponents();
---

<BaseLayout
  title="Astro Components Kit"
  description="Premium open-source Astro component library. 120+ beautiful, accessible, copy-paste ready UI components. Zero dependencies. Build faster with Astro Components Kit."
>
  <!-- Three.js background -->
  <div class="particle-wrap" aria-hidden="true">
    <canvas id="bg-3d-canvas"></canvas>
  </div>

  <!-- Brutalist accent lines -->
  <div class="brutal-line brutal-line--1" aria-hidden="true"></div>
  <div class="brutal-line brutal-line--2" aria-hidden="true"></div>
  <div class="brutal-block brutal-block--1" aria-hidden="true"></div>

  <!-- Sticky header -->
  <header class="docs-header">
    <div class="docs-header__inner">
      <a href="/" class="docs-header__brand">
        <img src="/logo-animated.svg" alt="Astro Kit Components" class="brand-logo" />
      </a>
      <button class="site-menu-toggle" id="site-menu-toggle" aria-label="Toggle site menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
      </button>
      <nav class="docs-header__nav" id="site-nav">
        <a href="/install" class:list={{ active: false }}>Installation</a>
        <a href="/docs/glass-button" class:list={{ active: false }}>Components</a>
        <a href="/sections" class:list={{ active: false }}>Sections</a>
        <a href="/blog" class:list={{ active: false }}>Blog</a>
        <a href="https://github.com/konstantinWDK/astro-components" target="_blank" rel="noopener" class="gh-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="GitHub">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ==================== HERO ==================== -->
    <section class="hero">
      <div class="hero__scene">
        <!-- Galaxy 3D background -->
        <div class="hero__galaxy-bg" aria-hidden="true">
          <Galaxy3D />
        </div>

        <!-- Floating component cards -->
        <a href="/docs/glass-button" class="showcase-card showcase-card--1">
          <div class="showcase-card__inner"><GlassButton variant="primary" size="md">Click</GlassButton></div>
        </a>
        <a href="/docs/glass-card" class="showcase-card showcase-card--2">
          <div class="showcase-card__inner"><GlassCard title="Stats" subtitle="Overview" padding="sm"><span style="font-size:1.2rem;font-weight:800;color:#d4a017">12.4K</span></GlassCard></div>
        </a>
        <a href="/docs/badge" class="showcase-card showcase-card--3">
          <div class="showcase-card__inner"><Badge variant="success" dot pulse>Live</Badge></div>
        </a>
        <a href="/docs/neon-spinner" class="showcase-card showcase-card--4">
          <div class="showcase-card__inner"><NeonSpinner /></div>
        </a>
        <a href="/docs/cyberpunk-button" class="showcase-card showcase-card--5">
          <div class="showcase-card__inner"><CyberpunkButton label="RUN" size="sm">RUN</CyberpunkButton></div>
        </a>
        <a href="/docs/animated-input" class="showcase-card showcase-card--6">
          <div class="showcase-card__inner"><AnimatedInput label="Search" id="hero-search" type="text" placeholder=" " /></div>
        </a>
        <a href="/docs/typing-indicator" class="showcase-card showcase-card--7">
          <div class="showcase-card__inner"><TypingIndicator /></div>
        </a>
        <a href="/docs/glass-slider" class="showcase-card showcase-card--8">
          <div class="showcase-card__inner"><Badge variant="warning" dot>Pro</Badge></div>
        </a>

        <!-- Center: Title overlay -->
        <div class="hero__content">
          <h1 class="hero__title">
            <span class="hero__title-row">
              <span class="hero__title-main" data-title-line="1">
                <span class="hero__l">A</span><span class="hero__l">S</span><span class="hero__l">T</span><span class="hero__l">R</span><span class="hero__l">O</span>&nbsp;<span class="hero__l">K</span><span class="hero__l">I</span><span class="hero__l">T</span>
              </span>
            </span>
            <span class="hero__title-row">
              <span class="hero__title-main" data-title-line="2">
                <span class="hero__l">C</span><span class="hero__l">O</span><span class="hero__l">M</span><span class="hero__l">P</span><span class="hero__l">O</span><span class="hero__l">N</span><span class="hero__l">E</span><span class="hero__l">N</span><span class="hero__l">T</span><span class="hero__l">S</span>
              </span>
            </span>
          </h1>

          <p class="hero__subtitle">
            Premium open-source UI components for Astro. Zero dependencies. Copy, paste, ship.
          </p>

          <div class="hero__install-wrap">
            <div class="hero__install">
              <svg class="hero__install-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <code class="hero__install-code">$ npm install astro-component-kit</code>
              <button class="hero__copy-btn" id="heroCopyBtn" aria-label="Copy install command" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
          </div>

          <div class="hero__actions">
            <a href="/docs/glass-button" class="hero__cta-btn">
              Browse All Components
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Background glow -->
        <div class="showcase-glow showcase-glow--1"></div>
        <div class="showcase-glow showcase-glow--2"></div>
      </div>
    </section>

    <!-- ==================== WHY ASTRO COMPONENTS KIT ==================== -->
    <section class="section section--why" id="why">
      <div class="container">
        <span class="section__eyebrow">Why Astro Components Kit</span>
        <h2 class="section__title">Build faster with premium Astro components</h2>
        <p class="section__subtitle section__subtitle--wide">
          Stop reinventing the wheel. Astro Components Kit gives you production-ready UI components
          designed for performance, accessibility, and beautiful design — out of the box.
        </p>

        <div class="why-grid">
          <article class="why-card why-card--brutal">
            <div class="why-card__accent" aria-hidden="true"></div>
            <div class="why-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <h3 class="why-card__title">Lightning-fast development</h3>
            <p class="why-card__desc">
              Copy-paste any component directly into your Astro project. No build step, no configuration.
              Ship features in minutes instead of hours.
            </p>
          </article>

          <article class="why-card why-card--brutal">
            <div class="why-card__accent" aria-hidden="true"></div>
            <div class="why-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="why-card__title">Zero dependencies</h3>
            <p class="why-card__desc">
              No heavy UI frameworks, no runtime overhead. Pure Astro components with minimal CSS
              and zero JavaScript unless you need interactivity.
            </p>
          </article>

          <article class="why-card why-card--brutal">
            <div class="why-card__accent" aria-hidden="true"></div>
            <div class="why-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
            </div>
            <h3 class="why-card__title">Accessible by default</h3>
            <p class="why-card__desc">
              WCAG 2.1 AA compliant components built in. Keyboard navigation, ARIA attributes,
              and screen reader support — no extra work needed.
            </p>
          </article>

          <article class="why-card why-card--brutal">
            <div class="why-card__accent" aria-hidden="true"></div>
            <div class="why-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <h3 class="why-card__title">Beautiful design systems</h3>
            <p class="why-card__desc">
              Glass morphism, neumorphism, cyberpunk, shimmer effects — all cohesive design styles
              ready to match your brand identity.
            </p>
          </article>

          <article class="why-card why-card--brutal">
            <div class="why-card__accent" aria-hidden="true"></div>
            <div class="why-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h3 class="why-card__title">Full customization</h3>
            <p class="why-card__desc">
              Every component exposes CSS custom properties and slots. Tweak colors, spacing,
              animations, and layout to make it yours.
            </p>
          </article>

          <article class="why-card why-card--brutal">
            <div class="why-card__accent" aria-hidden="true"></div>
            <div class="why-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </div>
            <h3 class="why-card__title">Always up to date</h3>
            <p class="why-card__desc">
              Active community, regular releases, and new components added monthly.
              MIT licensed — free forever for personal and commercial use.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ==================== COMPONENT CAROUSEL ==================== -->
    <section class="section section--carousel" id="components">
      <div class="container">
        <span class="section__eyebrow">Component Library</span>
        <h2 class="section__title">120+ production-ready Astro components</h2>
        <p class="section__subtitle section__subtitle--wide">
          From buttons and cards to modals and forms — every component is crafted with attention
          to detail, performance, and user experience.
        </p>

        <!-- Carousel -->
        <div class="carousel-wrap">
          <div class="carousel-track" id="carouselTrack">
            <div class="carousel-slide">
              <div class="carousel-card"><GlassButton variant="primary" size="lg">Primary Action</GlassButton></div>
              <span class="carousel-card__label">Glass Button</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><GlowButton color="#b8860b" size="lg">Glow Effect</GlowButton></div>
              <span class="carousel-card__label">Glow Button</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><CyberpunkButton label="CYBER" size="lg">CYBERPUNK</CyberpunkButton></div>
              <span class="carousel-card__label">Cyberpunk</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><ShimmerButton variant="primary" size="lg">Shimmer</ShimmerButton></div>
              <span class="carousel-card__label">Shimmer</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><PulseButton color="#b8860b" size="lg">Pulse</PulseButton></div>
              <span class="carousel-card__label">Pulse</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><ShinyButton variant="primary" size="lg">Shiny</ShinyButton></div>
              <span class="carousel-card__label">Shiny</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><NeumorphicButton baseColor="#1e293b" size="lg">Press</NeumorphicButton></div>
              <span class="carousel-card__label">Neumorphic</span>
            </div>
            <!-- Duplicate for seamless loop -->
            <div class="carousel-slide">
              <div class="carousel-card"><GlassButton variant="primary" size="lg">Primary Action</GlassButton></div>
              <span class="carousel-card__label">Glass Button</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><GlowButton color="#b8860b" size="lg">Glow Effect</GlowButton></div>
              <span class="carousel-card__label">Glow Button</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><CyberpunkButton label="CYBER" size="lg">CYBERPUNK</CyberpunkButton></div>
              <span class="carousel-card__label">Cyberpunk</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><ShimmerButton variant="primary" size="lg">Shimmer</ShimmerButton></div>
              <span class="carousel-card__label">Shimmer</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><PulseButton color="#b8860b" size="lg">Pulse</PulseButton></div>
              <span class="carousel-card__label">Pulse</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><ShinyButton variant="primary" size="lg">Shiny</ShinyButton></div>
              <span class="carousel-card__label">Shiny</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><NeumorphicButton baseColor="#1e293b" size="lg">Press</NeumorphicButton></div>
              <span class="carousel-card__label">Neumorphic</span>
            </div>
          </div>
        </div>

        <!-- Carousel 2 - Cards row -->
        <div class="carousel-wrap carousel-wrap--reverse">
          <div class="carousel-track carousel-track--reverse" id="carouselTrack2">
            <div class="carousel-slide">
              <div class="carousel-card"><GlassCard title="Analytics" subtitle="Dashboard" padding="md"><span style="font-size:1.4rem;font-weight:800;color:#d4a017">24.8K</span></GlassCard></div>
              <span class="carousel-card__label">Glass Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><ProfileCard name="Alex Rivera" role="Lead Developer" /></div>
              <span class="carousel-card__label">Profile Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><PricingCard plan="Pro" price="29" featured /></div>
              <span class="carousel-card__label">Pricing Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><CyberFeatureCard title="Neural Matrix" subtitle="Core Processing" /></div>
              <span class="carousel-card__label">Cyber Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><StatCard label="Total Revenue" value="$124.5K" icon="📈" /></div>
              <span class="carousel-card__label">Stat Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><KanbanItemCard title="Update SEO Metadata" priority="High" tag="SEO" /></div>
              <span class="carousel-card__label">Kanban Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><InteractiveTiltCard title="3D Depth Card" description="Move cursor to tilt in 3D space" /></div>
              <span class="carousel-card__label">Tilt Card</span>
            </div>
            <!-- Duplicate -->
            <div class="carousel-slide">
              <div class="carousel-card"><GlassCard title="Analytics" subtitle="Dashboard" padding="md"><span style="font-size:1.4rem;font-weight:800;color:#d4a017">24.8K</span></GlassCard></div>
              <span class="carousel-card__label">Glass Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><ProfileCard name="Alex Rivera" role="Lead Developer" /></div>
              <span class="carousel-card__label">Profile Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><PricingCard plan="Pro" price="29" featured /></div>
              <span class="carousel-card__label">Pricing Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><CyberFeatureCard title="Neural Matrix" subtitle="Core Processing" /></div>
              <span class="carousel-card__label">Cyber Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><StatCard label="Total Revenue" value="$124.5K" icon="📈" /></div>
              <span class="carousel-card__label">Stat Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><KanbanItemCard title="Update SEO Metadata" priority="High" tag="SEO" /></div>
              <span class="carousel-card__label">Kanban Card</span>
            </div>
            <div class="carousel-slide">
              <div class="carousel-card"><InteractiveTiltCard title="3D Depth Card" description="Move cursor to tilt in 3D space" /></div>
              <span class="carousel-card__label">Tilt Card</span>
            </div>
          </div>
        </div>

        <div class="carousel-cta">
          <a href="/docs/glass-button" class="btn-primary">
            Explore all components
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== ADVANTAGES / SEO CONTENT ==================== -->
    <section class="section section--advantages" id="advantages">
      <div class="container">
        <span class="section__eyebrow">Advantages</span>
        <h2 class="section__title">Why developers choose Astro Components Kit</h2>

        <div class="advantages-list">
          <div class="advantage-item">
            <div class="advantage-item__number">01</div>
            <div class="advantage-item__content">
              <h3>Performance-first architecture</h3>
              <p>
                Every Astro component ships with zero client-side JavaScript by default. Your pages
                load instantly because components render to static HTML at build time. No hydration,
                no waterfalls, no layout shift.
              </p>
            </div>
          </div>

          <div class="advantage-item">
            <div class="advantage-item__number">02</div>
            <div class="advantage-item__content">
              <h3>Copy-paste workflow</h3>
              <p>
                No package manager overhead. Just copy the component source into your project,
                import it, and use it. Every component is self-contained with its own styles
                and markup.
              </p>
            </div>
          </div>

          <div class="advantage-item">
            <div class="advantage-item__number">03</div>
            <div class="advantage-item__content">
              <h3>SEO-friendly out of the box</h3>
              <p>
                Since components render server-side, search engines can crawl and index your content
                immediately. No waiting for JavaScript bundles to load. Semantic HTML structure
                built into every component.
              </p>
            </div>
          </div>

          <div class="advantage-item">
            <div class="advantage-item__number">04</div>
            <div class="advantage-item__content">
              <h3>Design system ready</h3>
              <p>
                CSS custom properties, consistent spacing scale, typography system, and color
                palette — everything is pre-configured. Customize once, apply everywhere.
              </p>
            </div>
          </div>

          <div class="advantage-item">
            <div class="advantage-item__number">05</div>
            <div class="advantage-item__content">
              <h3>Open source &amp; MIT licensed</h3>
              <p>
                Free for personal and commercial use. Contribute components, report bugs, or fork
                the entire library. Built by developers, for developers.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== HOVER EFFECTS SHOWCASE ==================== -->
    <section class="section section--hover-showcase" id="interactions">
      <div class="container">
