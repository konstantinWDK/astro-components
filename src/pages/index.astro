---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, components } from '../data/registry/index';

// Hero demo components (untouched)
import GlassCard from '../components/lib/cards/GlassCard.astro';
import CyberFeatureCard from '../components/lib/cards/CyberFeatureCard.astro';
import StatCard from '../components/lib/cards/StatCard.astro';
import Badge from '../components/lib/feedback/Badge.astro';
import AnimatedInput from '../components/lib/forms/AnimatedInput.astro';
import RatingStars from '../components/lib/forms/RatingStars.astro';
import NeumorphicSwitch from '../components/lib/forms/NeumorphicSwitch.astro';
import OTPInput from '../components/lib/forms/OTPInput.astro';
import Galaxy3D from '../components/lib/Galaxy3D.astro';

// Carousel & Showcase demo components (distinct from hero)
import ShimmerButton from '../components/lib/buttons/ShimmerButton.astro';
import CyberpunkButton from '../components/lib/buttons/CyberpunkButton.astro';
import LiquidButton from '../components/lib/buttons/LiquidButton.astro';
import RetroArcadeButton from '../components/lib/buttons/RetroArcadeButton.astro';
import GlowButton from '../components/lib/buttons/GlowButton.astro';
import ThreeDPushButton from '../components/lib/buttons/ThreeDPushButton.astro';

import SearchReveal from '../components/lib/forms/SearchReveal.astro';
import StepperInput from '../components/lib/forms/StepperInput.astro';

import FloatingTabBar from '../components/lib/navigation/FloatingTabBar.astro';

import WeatherWidgetCard from '../components/lib/cards/WeatherWidgetCard.astro';
import MusicPlayerMini from '../components/lib/cards/MusicPlayerMini.astro';
import NotificationCard from '../components/lib/cards/NotificationCard.astro';
import KanbanItemCard from '../components/lib/cards/KanbanItemCard.astro';

import CircleProgress from '../components/lib/feedback/CircleProgress.astro';
import CyberGlitchAlert from '../components/lib/feedback/CyberGlitchAlert.astro';
import TypingIndicator from '../components/lib/feedback/TypingIndicator.astro';
import NeonSpinner from '../components/lib/feedback/NeonSpinner.astro';

import RatingBreakdownBar from '../components/lib/data/RatingBreakdownBar.astro';
import AvatarGroupStack from '../components/lib/data/AvatarGroupStack.astro';
import KeyValuePillGroup from '../components/lib/data/KeyValuePillGroup.astro';

// Section components for the new Full-Width Sections Carousel
import StatsMetricShowcase from '../components/lib/sections/StatsMetricShowcase.astro';
import LogoCloudSection from '../components/lib/sections/LogoCloudSection.astro';
import CtaGlowBanner from '../components/lib/sections/CtaGlowBanner.astro';
import TestimonialWallGlass from '../components/lib/sections/TestimonialWallGlass.astro';
import PricingTierCards from '../components/lib/sections/PricingTierCards.astro';
import TeamGridSection from '../components/lib/sections/TeamGridSection.astro';
---

<BaseLayout
  title="Astro Components Kit"
  description="Premium open-source Astro component library. 120+ beautiful, accessible, copy-paste ready UI components. Zero dependencies. Build faster with Astro Components Kit."
>
  <!-- Three.js background -->
  <div class="particle-wrap" aria-hidden="true">
    <canvas id="bg-3d-canvas"></canvas>
  </div>

  <!-- Brutalist accent lines -->
  <div class="brutal-line brutal-line--1" aria-hidden="true"></div>
  <div class="brutal-line brutal-line--2" aria-hidden="true"></div>
  <div class="brutal-block brutal-block--1" aria-hidden="true"></div>

  <!-- Sticky header -->
  <header class="docs-header">
    <div class="docs-header__inner">
      <a href="/" class="docs-header__brand">
        <img src="/logo-animated.svg" alt="Astro Kit Components" class="brand-logo" />
      </a>
      <button class="site-menu-toggle" id="site-menu-toggle" aria-label="Toggle site menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
      </button>
      <nav class="docs-header__nav" id="site-nav">
        <a href="/install" class:list={{ active: false }}>Installation</a>
        <a href="/docs/glass-button" class:list={{ active: false }}>Components</a>
        <a href="/sections" class:list={{ active: false }}>Sections</a>
        <a href="/blog" class:list={{ active: false }}>Blog</a>
        <a href="https://github.com/konstantinWDK/astro-components" target="_blank" rel="noopener" class="gh-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="GitHub">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ==================== HERO ==================== -->
    <section class="hero">
      <div class="hero__scene">
        <!-- Galaxy 3D background -->
        <div class="hero__galaxy-bg" aria-hidden="true">
          <Galaxy3D />
        </div>

        <!-- Floating component cards -->
        <a href="/docs/glass-card" class="showcase-card showcase-card--1">
          <div class="showcase-card__inner"><GlassCard title="Active Builds" subtitle="Production Ready" padding="sm"><span style="font-size:1.15rem;font-weight:800;color:#d4a017">192 Pages</span></GlassCard></div>
        </a>
        <a href="/docs/stat-card" class="showcase-card showcase-card--2">
          <div class="showcase-card__inner"><StatCard label="Components Kit" value="200+" icon="⚡" /></div>
        </a>
        <a href="/docs/badge" class="showcase-card showcase-card--3">
          <div class="showcase-card__inner"><Badge variant="success" dot pulse>WCAG AA Compliant</Badge></div>
        </a>
        <a href="/docs/rating-stars" class="showcase-card showcase-card--4">
          <div class="showcase-card__inner"><RatingStars initialValue={5} idPrefix="hero-star" /></div>
        </a>
        <a href="/docs/cyber-feature-card" class="showcase-card showcase-card--5">
          <div class="showcase-card__inner"><CyberFeatureCard title="Zero JS" subtitle="Pure Static SSR" /></div>
        </a>
        <a href="/docs/animated-input" class="showcase-card showcase-card--6">
          <div class="showcase-card__inner"><AnimatedInput label="Search Components..." id="hero-search" type="text" placeholder=" " /></div>
        </a>
        <a href="/docs/otp-input" class="showcase-card showcase-card--7">
          <div class="showcase-card__inner"><OTPInput length={4} id="hero-otp" /></div>
        </a>
        <a href="/docs/neumorphic-switch" class="showcase-card showcase-card--8">
          <div class="showcase-card__inner"><NeumorphicSwitch id="hero-switch" label="Dark Theme" checked /></div>
        </a>

        <!-- Center: Title overlay -->
        <div class="hero__content">
          <h1 class="hero__title">
            <span class="hero__title-row">
              <span class="hero__title-main" data-title-line="1">
                <span class="hero__l">A</span><span class="hero__l">S</span><span class="hero__l">T</span><span class="hero__l">R</span><span class="hero__l">O</span>&nbsp;<span class="hero__l">K</span><span class="hero__l">I</span><span class="hero__l">T</span>
              </span>
            </span>
            <span class="hero__title-row">
              <span class="hero__title-main" data-title-line="2">
                <span class="hero__l">C</span><span class="hero__l">O</span><span class="hero__l">M</span><span class="hero__l">P</span><span class="hero__l">O</span><span class="hero__l">N</span><span class="hero__l">E</span><span class="hero__l">N</span><span class="hero__l">T</span><span class="hero__l">S</span>
              </span>
            </span>
          </h1>

          <p class="hero__subtitle">
            Premium open-source UI components for Astro. Zero dependencies. Copy, paste, ship.
          </p>

          <div class="hero__install-wrap">
            <div class="hero__install">
              <svg class="hero__install-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <code class="hero__install-code">$ npm install astro-component-kit</code>
              <button class="hero__copy-btn" id="heroCopyBtn" aria-label="Copy install command" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
          </div>

          <div class="hero__actions">
            <a href="/docs/glass-button" class="hero__cta-btn">
              Browse All Components
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Background glow -->
        <div class="showcase-glow showcase-glow--1"></div>
        <div class="showcase-glow showcase-glow--2"></div>
      </div>
    </section>

    <!-- ==================== WHY ASTRO COMPONENTS KIT ==================== -->
    <section class="section section--why" id="why">
      <div class="container">
        <div class="section__header-row">
          <div>
            <span class="section__eyebrow">Why Astro Components Kit</span>
            <h2 class="section__title">Build faster with premium Astro components</h2>
            <p class="section__subtitle section__subtitle--wide">
              Stop reinventing the wheel. Production-ready UI building blocks designed for peak performance, WCAG AA accessibility, and aesthetic perfection — out of the box.
            </p>
          </div>
          <div class="why-badge-pill" aria-hidden="true">
            <span class="why-badge-pill__pulse"></span>
            <span class="why-badge-pill__text">Engineered for Astro 5</span>
          </div>
        </div>

        <!-- Dynamic Expanding Accordion Carousel -->
        <div class="why-accordion-carousel" id="whyAccordionCarousel" role="region" aria-label="Astro Components Kit Advantages">
          <div class="why-accordion-track" id="whyAccordionTrack">
            
            <!-- Card 0: Lightning Fast -->
            <article class="why-acc-card is-active" data-index="0" tabindex="0" role="tab" aria-selected="true" aria-controls="why-panel-0" id="why-tab-0">
              <div class="why-acc-card__backdrop" aria-hidden="true">
                <div class="why-acc-card__glow"></div>
                <div class="why-acc-card__grid-pattern"></div>
                <div class="why-acc-card__particles">
                  <span class="why-acc-particle p1"></span>
                  <span class="why-acc-particle p2"></span>
                  <span class="why-acc-particle p3"></span>
                </div>
              </div>
              
              <!-- Collapsed Rail -->
              <div class="why-acc-card__rail">
                <span class="why-acc-card__num">01</span>
                <div class="why-acc-card__rail-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <span class="why-acc-card__rail-label">Velocity</span>
              </div>

              <!-- Expanded Content -->
              <div class="why-acc-card__content" id="why-panel-0" role="tabpanel" aria-labelledby="why-tab-0">
                <div class="why-acc-card__top">
                  <div class="why-acc-card__icon-badge">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  </div>
                  <span class="why-acc-card__tag">Ship in Minutes</span>
                </div>
                
                <h3 class="why-acc-card__title">Lightning-fast development</h3>
                
                <p class="why-acc-card__desc">
                  Copy-paste any component directly into your Astro project. No tedious build configuration or endless node_modules bloat. Ship stunning client and landing pages in minutes instead of weeks.
                </p>

                <div class="why-acc-card__stats">
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">10x</span>
                    <span class="why-stat-pill__label">Ship Speed</span>
                  </div>
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">0 min</span>
                    <span class="why-stat-pill__label">Setup Time</span>
                  </div>
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">100%</span>
                    <span class="why-stat-pill__label">Astro 5 Ready</span>
                  </div>
                </div>

                <div class="why-acc-card__action">
                  <a href="/docs/buttons" class="why-acc-btn">
                    <span>Explore components</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </article>

            <!-- Card 1: Zero Dependencies -->
            <article class="why-acc-card" data-index="1" tabindex="0" role="tab" aria-selected="false" aria-controls="why-panel-1" id="why-tab-1">
              <div class="why-acc-card__backdrop" aria-hidden="true">
                <div class="why-acc-card__glow"></div>
                <div class="why-acc-card__grid-pattern"></div>
                <div class="why-acc-card__particles">
                  <span class="why-acc-particle p1"></span>
                  <span class="why-acc-particle p2"></span>
                  <span class="why-acc-particle p3"></span>
                </div>
              </div>
              <div class="why-acc-card__rail">
                <span class="why-acc-card__num">02</span>
                <div class="why-acc-card__rail-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <span class="why-acc-card__rail-label">Pure Engine</span>
              </div>
              <div class="why-acc-card__content" id="why-panel-1" role="tabpanel" aria-labelledby="why-tab-1">
                <div class="why-acc-card__top">
                  <div class="why-acc-card__icon-badge">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  </div>
                  <span class="why-acc-card__tag">Zero Bloat</span>
                </div>
                <h3 class="why-acc-card__title">Zero runtime dependencies</h3>
                <p class="why-acc-card__desc">
                  No heavy external UI runtimes, no virtual DOM overhead. Pure native Astro components powered by ultra-efficient scoped Vanilla CSS and 0kB JavaScript on initial load.
                </p>
                <div class="why-acc-card__stats">
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">0 kB</span>
                    <span class="why-stat-pill__label">Runtime JS</span>
                  </div>
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">100/100</span>
                    <span class="why-stat-pill__label">Lighthouse</span>
                  </div>
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">~0 ms</span>
                    <span class="why-stat-pill__label">Total Blocking</span>
                  </div>
                </div>
                <div class="why-acc-card__action">
                  <a href="/docs/installation" class="why-acc-btn">
                    <span>Check architecture</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </article>

            <!-- Card 2: Accessible by Default -->
            <article class="why-acc-card" data-index="2" tabindex="0" role="tab" aria-selected="false" aria-controls="why-panel-2" id="why-tab-2">
              <div class="why-acc-card__backdrop" aria-hidden="true">
                <div class="why-acc-card__glow"></div>
                <div class="why-acc-card__grid-pattern"></div>
                <div class="why-acc-card__particles">
                  <span class="why-acc-particle p1"></span>
                  <span class="why-acc-particle p2"></span>
                  <span class="why-acc-particle p3"></span>
                </div>
              </div>
              <div class="why-acc-card__rail">
                <span class="why-acc-card__num">03</span>
                <div class="why-acc-card__rail-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </div>
                <span class="why-acc-card__rail-label">A11y First</span>
              </div>
              <div class="why-acc-card__content" id="why-panel-2" role="tabpanel" aria-labelledby="why-tab-2">
                <div class="why-acc-card__top">
                  <div class="why-acc-card__icon-badge">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                  </div>
                  <span class="why-acc-card__tag">WCAG 2.1 AA</span>
                </div>
                <h3 class="why-acc-card__title">Accessible by default</h3>
                <p class="why-acc-card__desc">
                  Meticulously designed for universal inclusion. Full keyboard navigation support (Tab, Enter, Escape, Arrow keys), visible 2px+ focus rings, automated ARIA roles, and high contrast compliant color ratios.
                </p>
                <div class="why-acc-card__stats">
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">≥4.5:1</span>
                    <span class="why-stat-pill__label">Contrast Ratio</span>
                  </div>
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">100%</span>
                    <span class="why-stat-pill__label">Keyboard Nav</span>
                  </div>
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">44px+</span>
                    <span class="why-stat-pill__label">Touch Targets</span>
                  </div>
                </div>
                <div class="why-acc-card__action">
                  <a href="/docs/forms" class="why-acc-btn">
                    <span>View accessible forms</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </article>

            <!-- Card 3: Design Systems -->
            <article class="why-acc-card" data-index="3" tabindex="0" role="tab" aria-selected="false" aria-controls="why-panel-3" id="why-tab-3">
              <div class="why-acc-card__backdrop" aria-hidden="true">
                <div class="why-acc-card__glow"></div>
                <div class="why-acc-card__grid-pattern"></div>
                <div class="why-acc-card__particles">
                  <span class="why-acc-particle p1"></span>
                  <span class="why-acc-particle p2"></span>
                  <span class="why-acc-particle p3"></span>
                </div>
              </div>
              <div class="why-acc-card__rail">
                <span class="why-acc-card__num">04</span>
                <div class="why-acc-card__rail-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <span class="why-acc-card__rail-label">Aesthetics</span>
              </div>
              <div class="why-acc-card__content" id="why-panel-3" role="tabpanel" aria-labelledby="why-tab-3">
                <div class="why-acc-card__top">
                  <div class="why-acc-card__icon-badge">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                  </div>
                  <span class="why-acc-card__tag">Curated Styles</span>
                </div>
                <h3 class="why-acc-card__title">Next-gen design systems</h3>
                <p class="why-acc-card__desc">
                  Glassmorphism, Cyberpunk neons, Neumorphism, and Dark Luxury Gold themes. Every component is handcrafted to deliver that immediate "wow" factor with fluid hover states and micro-interactions.
                </p>
                <div class="why-acc-card__stats">
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">6+</span>
                    <span class="why-stat-pill__label">Aesthetic Styles</span>
                  </div>
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">60fps</span>
                    <span class="why-stat-pill__label">Micro-animations</span>
                  </div>
                  <div class="why-stat-pill">
                    <span class="why-stat-pill__value">Dark</span>
                    <span class="why-stat-pill__label">Mode First</span>
                  </div>
                </div>
                <div class="why-acc-card__action">
                  <a href="/docs/cards" class="why-acc-btn">
                    <span>Inspect card variants</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </article>

            <!-- Card 4: Full Customization -->
            <article class="why-acc-card" data-index="4" tabindex="0" role="tab" aria-selected="false" aria-controls="why-panel-4" id="why-tab-4">
              <div class="why-acc-card__backdrop" aria-hidden="true">
                <div class="why-acc-card__glow"></div>
                <div class="why-acc-card__grid-pattern"></div>
                <div class="why-acc-card__particles">
                  <span class="why-acc-particle p1"></span>
                  <span class="why-acc-particle p2"></span>
                  <span class="why-acc-particle p3"></span>
