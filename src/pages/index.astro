    position: relative;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    min-height: 600px;
    perspective: 1200px;
  }
  .hero__galaxy-bg {
    position: absolute;
    top: -30%;
    left: -10%;
    width: 120%;
    height: 160%;
