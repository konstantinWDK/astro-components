  }
  .hero__copy-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.35rem; background: transparent;
    border: 1px solid rgba(255,255,255,0.1); border-radius: var(--r-sm);
    color: var(--c-text-3); cursor: pointer; transition: all 0.2s;
  }
  .hero__copy-btn:hover {
    background: rgba(184,134,11,0.15); border-color: rgba(184,134,11,0.4);
    color: var(--c-primary-light); transform: scale(1.05);
  }

  /* CTA Button - Browse Components */
  .hero__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: 0.85rem 1.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-sans);
    color: var(--c-bg);
    background: linear-gradient(135deg, var(--c-primary-light), var(--c-primary));
    border: none;
    border-radius: var(--r-md);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 4px 24px rgba(184,134,11,0.25);
    position: relative;
    overflow: hidden;
  }
  .hero__cta-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .hero__cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(184,134,11,0.35);
    color: var(--c-bg);
  }
  .hero__cta-btn:hover::before {
    opacity: 1;
  }
  .hero__cta-btn svg {
    transition: transform 0.25s ease;
  }
  .hero__cta-btn:hover svg {
    transform: translateX(3px);
  }

  /* Floating showcase cards */
  .showcase-card {
    position: absolute; text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.5s ease, opacity 0.4s ease;
    transform-style: preserve-3d; opacity: 0.6; z-index: 5; pointer-events: auto; cursor: pointer;
  }
  .showcase-card:hover {
    transform: translateZ(50px) scale(1.15) !important;
    opacity: 1 !important; z-index: 15 !important;
    filter: drop-shadow(0 0 24px rgba(255,255,255,0.06));
  }
  .showcase-card__inner {
    padding: var(--sp-5);
    background: rgba(10, 10, 10, 0.8); backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.06); border-radius: var(--r-lg);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    transition: border-color 0.4s ease, background 0.4s ease;
  }
  .showcase-card:hover .showcase-card__inner {
    border-color: rgba(255,255,255,0.12); background: rgba(17, 17, 17, 0.9);
  }
  .showcase-card--1 { top: -2%; left: 4%; animation: float-a 9s ease-in-out infinite; }
  .showcase-card--2 { top: 2%; right: 4%; animation: float-b 7.5s ease-in-out infinite 0.8s; }
  .showcase-card--3 { top: 15%; left: 0%; animation: float-c 8.5s ease-in-out infinite 1.2s; }
  .showcase-card--4 { top: 12%; right: 0%; animation: float-a 10s ease-in-out infinite 0.4s reverse; }
  .showcase-card--5 { top: 30%; left: 2%; animation: float-b 8s ease-in-out infinite 2s; }
  .showcase-card--6 { top: 28%; right: 2%; animation: float-c 9.5s ease-in-out infinite 1s reverse; }
  .showcase-card--7 { top: 4%; left: 22%; animation: float-a 7s ease-in-out infinite 1.6s; }
  .showcase-card--8 { top: 6%; right: 22%; animation: float-b 8.5s ease-in-out infinite 0.6s reverse; }
  .showcase-card--9 { top: 50%; left: 3%; animation: float-c 10s ease-in-out infinite 2.2s; }
  .showcase-card--10 { top: 55%; right: 3%; animation: float-a 9s ease-in-out infinite 1.4s reverse; }
  @keyframes float-a {
    0%,100% { transform: translateY(0) translateZ(10px) rotate(-1deg); }
    50% { transform: translateY(-18px) translateZ(30px) rotate(1deg); }
  }
  @keyframes float-b {
    0%,100% { transform: translateY(0) translateZ(20px) rotate(1.5deg); }
    50% { transform: translateY(-22px) translateZ(40px) rotate(-1.5deg); }
  }
  @keyframes float-c {
    0%,100% { transform: translateY(0) translateZ(15px) rotate(-0.5deg); }
    50% { transform: translateY(-15px) translateZ(35px) rotate(2deg); }
  }

  /* ============================================
     SECTION COMMON
     ============================================ */
  .section { position: relative; z-index: 1; padding: 5rem 0; }
  .section__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
