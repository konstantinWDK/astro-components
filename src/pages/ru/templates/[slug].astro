---
import TemplateDetailPage from '../../../components/docs/TemplateDetailPage.astro';
import { templates } from '../../../data/registry/templates';

export function getStaticPaths() {
  return templates.map((tpl) => ({ params: { slug: tpl.slug } }));
}

const { slug = '' } = Astro.params;
---

<TemplateDetailPage slug={slug} lang="ru" />
