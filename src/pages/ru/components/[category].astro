---
// pages/ru/components/[category].astro
import ComponentsCatalogPage from '../../../components/docs/ComponentsCatalogPage.astro';
import { categories, components } from '../../../data/registry/index';

export function getStaticPaths() {
  return categories
    .filter((c) => c.id !== 'sections' && components.some((comp) => comp.category === c.id))
    .map((c) => ({ params: { category: c.id } }));
}

const { category = '' } = Astro.params;
---

<ComponentsCatalogPage lang="ru" category={category} />
