---
// src/pages/ru/notes/[slug].astro
import BlogPostPage from '../../../components/blog/BlogPostPage.astro';
import { getNoteSlugs } from '../../../components/blog/notes';

export async function getStaticPaths() {
  const slugs = await getNoteSlugs();
  const paths = slugs.map((slug) => ({ params: { slug } }));
  paths.push({ params: { slug: 'v0-5-0-mcp-server-and-ai-integrations' } });
  return paths;
}

const { slug } = Astro.params;
const targetSlug = slug === 'v0-5-0-mcp-server-and-ai-integrations'
  ? 'v0-5-1-mcp-server-and-ai-integrations'
  : slug!;
---

<BlogPostPage slug={targetSlug} lang="ru" />
