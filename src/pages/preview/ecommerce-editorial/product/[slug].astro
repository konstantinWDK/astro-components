---
import { EditorialProductPage, formaStore } from '../../../../components/lib/templates/ecommerce-editorial';
import { previewRoutes } from '../_routes';

export function getStaticPaths() {
  return formaStore.products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---

<EditorialProductPage slug={slug} routes={previewRoutes} seedCart noindex />
