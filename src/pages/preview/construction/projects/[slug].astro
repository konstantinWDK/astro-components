---
import ConstructionProjectDetailPage from '../../../../components/lib/templates/construction/ConstructionProjectDetailPage.astro';
import { constructionProjects } from '../../../../components/lib/templates/construction/data';
import { previewConstructionRoutes } from '../_routes';

export function getStaticPaths() {
  return constructionProjects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---

<ConstructionProjectDetailPage slug={slug} routes={previewConstructionRoutes} />
