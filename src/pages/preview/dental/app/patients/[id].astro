---
import { DentalPatientPage, dentalData } from '../../../../../components/lib/templates/dental';
import { previewRoutes } from '../../_routes';

export function getStaticPaths() {
  return dentalData.patients.map((p) => ({ params: { id: p.id } }));
}
---

<DentalPatientPage patientId={Astro.params.id!} routes={previewRoutes} noindex />

