---
import { ToyCharacterPage, kapowStore } from '../../../../components/lib/templates/toy-store';
import { previewRoutes } from '../_routes';

export function getStaticPaths() {
  return kapowStore.characters.map((c) => ({ params: { id: c.id } }));
}
---

<ToyCharacterPage id={Astro.params.id!} routes={previewRoutes} seedCart noindex />
