---
import { ToyProductPage, kapowStore } from '../../../../components/lib/templates/toy-store';
import { previewRoutes } from '../_routes';

export function getStaticPaths() {
  return kapowStore.products.map((p) => ({ params: { slug: p.slug } }));
}
---

<ToyProductPage slug={Astro.params.slug!} routes={previewRoutes} seedCart noindex />
