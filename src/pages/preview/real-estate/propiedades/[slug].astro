---
import EstatePropertyPage from '../../../../components/lib/templates/real-estate/EstatePropertyPage.astro';
import { estateProperties } from '../../../../components/lib/templates/real-estate/data';
import { previewEstateRoutes } from '../_routes';

export function getStaticPaths() {
  return estateProperties.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---

<EstatePropertyPage slug={slug} routes={previewEstateRoutes} />
