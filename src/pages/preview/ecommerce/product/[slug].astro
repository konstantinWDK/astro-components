---
import { StoreProductPage, demoStore } from '../../../../components/lib/templates/ecommerce';
import { previewRoutes } from '../_routes';

export function getStaticPaths() {
  return demoStore.products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---

<StoreProductPage slug={slug} routes={previewRoutes} seedCart noindex />
