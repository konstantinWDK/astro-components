---
import { AgencyCaseStudyPage, voltaAgency } from '../../../../components/lib/templates/agency';
import { previewRoutes } from '../_routes';

export function getStaticPaths() {
  return voltaAgency.cases.map((c) => ({ params: { slug: c.slug } }));
}
---

<AgencyCaseStudyPage slug={Astro.params.slug!} routes={previewRoutes} noindex />
