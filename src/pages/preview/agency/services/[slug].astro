---
import { AgencyServicePage, voltaAgency } from '../../../../components/lib/templates/agency';
import { previewRoutes } from '../_routes';

export function getStaticPaths() {
  return voltaAgency.services.map((s) => ({ params: { slug: s.slug } }));
}
---

<AgencyServicePage slug={Astro.params.slug!} routes={previewRoutes} noindex />
