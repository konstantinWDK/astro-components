---
import MovingOrderDetailPage from '../../../../../components/lib/templates/moving/MovingOrderDetailPage.astro';
import { movingData } from '../../../../../components/lib/templates/moving/data';
import { previewMovingRoutes } from '../../_routes';

export function getStaticPaths() {
  return movingData.orders.map((o) => ({ params: { id: o.id } }));
}

const { id } = Astro.params;
---

<MovingOrderDetailPage orderId={id} routes={previewMovingRoutes} noindex={true} />

