---
import { PortfolioPostPage, keycapPortfolio } from '../../../../components/lib/templates/portfolio';
import { previewRoutes } from '../_routes';

export function getStaticPaths() {
  return keycapPortfolio.posts.map((p) => ({ params: { slug: p.slug } }));
}
---

<PortfolioPostPage slug={Astro.params.slug!} routes={previewRoutes} noindex />
