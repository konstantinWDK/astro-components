---
import { PortfolioProjectPage, keycapPortfolio } from '../../../../components/lib/templates/portfolio';
import { previewRoutes } from '../_routes';

export function getStaticPaths() {
  return keycapPortfolio.projects.map((p) => ({ params: { slug: p.slug } }));
}
---

<PortfolioProjectPage slug={Astro.params.slug!} routes={previewRoutes} noindex />
