---
import AcademyCoursePage from '../../../../components/lib/templates/academy/AcademyCoursePage.astro';
import { academyCourses } from '../../../../components/lib/templates/academy/data';
import { previewAcademyRoutes } from '../_routes';

export function getStaticPaths() {
  return academyCourses.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
---

<AcademyCoursePage slug={slug} routes={previewAcademyRoutes} />
