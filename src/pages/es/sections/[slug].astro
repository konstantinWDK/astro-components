---
// src/pages/es/sections/[slug].astro
import SectionSlugPage from '../../../components/docs/SectionSlugPage.astro';
import { sections } from '../../../data/registry/sections';

export function getStaticPaths() {
  return sections.map((section) => ({ params: { slug: section.slug } }));
}

const { slug = '' } = Astro.params;
---

<SectionSlugPage slug={slug} lang="es" />
