---
// src/pages/sections/index.astro
import DocsLayout from '../../layouts/DocsLayout.astro';
import { sections } from '../../data/registry/sections';

const allSections = sections;
const sectionCategories = [...new Set(allSections.map(s => s.category))];
---

<DocsLayout title="Sections" description="Complete page sections: heroes, features, pricing, CTAs, and more.">
  <div class="doc-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__sep">›</span>
      <span class="breadcrumb__current">Sections</span>
    </nav>

    <!-- Header -->
    <header class="sections-header">
      <span class="sections-header__badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        {allSections.length} Sections
      </span>
      <h1 class="sections-header__title">Section Templates</h1>
      <p class="sections-header__desc">
        Complete, production-ready page sections — heroes, features, pricing, CTAs, and more.
        Copy and paste into your Astro project.
      </p>
    </header>

    <!-- Sections grid -->
    <div class="sections-grid">
      {allSections.map((section) => (
        <a href={`/sections/${section.slug}`} class="section-card">
          <div class="section-card__preview">
            <div class="section-card__preview-inner">
              {section.category === 'heroes' && (
                <div class="preview-hero">
                  <div class="preview-hero__badge">Hero</div>
                  <div class="preview-hero__lines">
                    <div class="preview-hero__line preview-hero__line--title"></div>
                    <div class="preview-hero__line preview-hero__line--subtitle"></div>
                    <div class="preview-hero__btns">
                      <div class="preview-hero__btn"></div>
                      <div class="preview-hero__btn preview-hero__btn--secondary"></div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
          <div class="section-card__content">
            <h3 class="section-card__name">{section.name}</h3>
            <p class="section-card__desc">{section.description}</p>
            <div class="section-card__tags">
              {section.tags.slice(0, 3).map((tag) => (
                <span class="section-card__tag">{tag}</span>
              ))}
            </div>
          </div>
          <div class="section-card__arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</DocsLayout>

<style>
  .doc-page {
    max-width: 1100px;
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap;
    font-size: 0.8rem; color: var(--c-text-3); margin-bottom: var(--sp-6);
  }
  .breadcrumb a { color: var(--c-text-3); } .breadcrumb a:hover { color: var(--c-text-2); }
  .breadcrumb__sep { color: var(--c-text-3); opacity: 0.5; }
  .breadcrumb__current { color: var(--c-text-2); font-weight: 500; }

  /* Header */
  .sections-header {
    margin-bottom: var(--sp-10);
  }
  .sections-header__badge {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    padding: 0.3rem 0.8rem; border-radius: var(--r-full);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    background: rgba(99,102,241,0.12); color: var(--c-primary-light); border: 1px solid rgba(99,102,241,0.25);
    margin-bottom: var(--sp-4);
  }
  .sections-header__title {
    font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 900;
    color: var(--c-text-1); letter-spacing: -0.03em; margin: 0 0 var(--sp-3);
  }
  .sections-header__desc {
    font-size: 1rem; color: var(--c-text-2); line-height: 1.7; max-width: 650px; margin: 0;
  }

  /* Grid */
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--sp-4);
  }

  /* Section card */
  .section-card {
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    text-decoration: none;
    transition: all 0.25s ease;
    overflow: hidden;
  }
  .section-card:hover {
    border-color: rgba(184,134,11,0.3);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.3);
  }

  .section-card__preview {
    height: 160px;
    background: rgba(0,0,0,0.3);
    border-bottom: 1px solid var(--c-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .section-card__preview-inner {
    width: 90%;
    height: 85%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Preview hero */
  .preview-hero {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(184,134,11,0.05));
    border-radius: var(--r-md);
    padding: var(--sp-3);
  }
  .preview-hero__badge {
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.6rem;
    background: rgba(184,134,11,0.2);
    color: var(--c-primary-light);
    border-radius: var(--r-full);
  }
  .preview-hero__lines {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: 80%;
  }
  .preview-hero__line {
    height: 4px;
    border-radius: 2px;
    background: rgba(255,255,255,0.15);
  }
  .preview-hero__line--title { width: 70%; }
  .preview-hero__line--subtitle { width: 50%; height: 3px; }
  .preview-hero__btns {
    display: flex; gap: 0.4rem; margin-top: 0.3rem;
  }
  .preview-hero__btn {
    width: 40px; height: 10px; border-radius: 2px;
    background: var(--c-primary-light);
    opacity: 0.5;
  }
  .preview-hero__btn--secondary {
    background: rgba(255,255,255,0.15);
    opacity: 0.3;
  }

  .section-card__content {
    padding: var(--sp-4);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .section-card__name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--c-text-1);
    margin: 0;
  }
  .section-card__desc {
    font-size: 0.8rem;
    color: var(--c-text-3);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }
  .section-card__tags {
    display: flex; gap: var(--sp-1); flex-wrap: wrap; margin-top: var(--sp-1);
  }
  .section-card__tag {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem;
    background: rgba(255,255,255,0.04);
    color: var(--c-text-3);
    border-radius: var(--r-full);
    border: 1px solid rgba(255,255,255,0.06);
  }

  .section-card__arrow {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--c-border);
    color: var(--c-text-3);
    transition: all 0.2s ease;
  }
  .section-card:hover .section-card__arrow {
    color: var(--c-primary-light);
  }
  .section-card:hover .section-card__arrow svg {
    transform: translateX(3px);
    transition: transform 0.2s ease;
  }

  @media (max-width: 768px) {
    .sections-grid { grid-template-columns: 1fr; }
  }
</style>