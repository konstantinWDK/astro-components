---
// src/pages/sections/[slug].astro
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/docs/CodeBlock.astro';
import { sections, getSectionBySlug } from '../../data/registry/sections';
import { categories } from '../../data/registry/index';

// Import all section components
import HeroGradient from '../../components/lib/sections/HeroGradient.astro';
import HeroSplit from '../../components/lib/sections/HeroSplit.astro';
import HeroGlass from '../../components/lib/sections/HeroGlass.astro';
import FeatureBentoGrid from '../../components/lib/sections/FeatureBentoGrid.astro';
import FeatureTimelineFlow from '../../components/lib/sections/FeatureTimelineFlow.astro';
import PricingComparisonMatrix from '../../components/lib/sections/PricingComparisonMatrix.astro';
import PricingTierCards from '../../components/lib/sections/PricingTierCards.astro';
import TestimonialWallGlass from '../../components/lib/sections/TestimonialWallGlass.astro';
import CtaGlowBanner from '../../components/lib/sections/CtaGlowBanner.astro';
import CtaAppDownload from '../../components/lib/sections/CtaAppDownload.astro';
import FaqAccordionSection from '../../components/lib/sections/FaqAccordionSection.astro';
import StatsMetricShowcase from '../../components/lib/sections/StatsMetricShowcase.astro';
import TeamGridSection from '../../components/lib/sections/TeamGridSection.astro';
import ContactGlassForm from '../../components/lib/sections/ContactGlassForm.astro';

export function getStaticPaths() {
  return sections.map((section) => ({ params: { slug: section.slug } }));
}

const { slug = '' } = Astro.params;
const section = getSectionBySlug(slug);

if (!section) {
  return Astro.redirect('/sections');
}

const category = categories.find((c) => c.id === section.category);
const currentPath = `/sections/${slug}`;

const componentMap: Record<string, any> = {
  'hero-gradient': HeroGradient,
  'hero-split': HeroSplit,
  'hero-glass': HeroGlass,
  'feature-bento-grid': FeatureBentoGrid,
  'feature-timeline-flow': FeatureTimelineFlow,
  'pricing-comparison-matrix': PricingComparisonMatrix,
  'pricing-tier-cards': PricingTierCards,
  'testimonial-wall-glass': TestimonialWallGlass,
  'cta-glow-banner': CtaGlowBanner,
  'cta-app-download': CtaAppDownload,
  'faq-accordion-section': FaqAccordionSection,
  'stats-metric-showcase': StatsMetricShowcase,
  'team-grid-section': TeamGridSection,
  'contact-glass-form': ContactGlassForm,
};

const Component = componentMap[section.slug] || null;

// Find prev/next for navigation
const currentIndex = sections.findIndex((s) => s.slug === slug);
const prevSection = currentIndex > 0 ? sections[currentIndex - 1] : null;
const nextSection = currentIndex < sections.length - 1 ? sections[currentIndex + 1] : null;

// Ensure usage has imports
let displayUsage = section.usage || '';
if (displayUsage && !displayUsage.includes('import')) {
  const componentName = section.name.replace(/\s/g, '');
  displayUsage = `---
import { ${componentName} } from 'astro-component-kit';
---

${displayUsage}`;
}
---

<DocsLayout title={section.name} description={section.description}>
  <div class="doc-page">
    <!-- Prev/Next subtle navigation at top -->
    <nav class="doc-nav" aria-label="Section navigation">
      {prevSection ? (
        <a href={`/sections/${prevSection.slug}`} class="doc-nav-link doc-nav-link--prev">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>{prevSection.name}</span>
        </a>
      ) : <span></span>}
      {nextSection ? (
        <a href={`/sections/${nextSection.slug}`} class="doc-nav-link doc-nav-link--next">
          <span>{nextSection.name}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      ) : <span></span>}
    </nav>

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__sep">›</span>
      <a href="/sections">Sections</a>
      <span class="breadcrumb__sep">›</span>
      <span class="breadcrumb__current">{section.name}</span>
    </nav>

    <!-- Section header -->
    <header class="section-header">
      <span class="section-header__badge">{category?.name}</span>
      <h1 class="section-header__title">{section.name}</h1>
      <p class="section-header__desc">{section.description}</p>
      <div class="section-header__tags">
        {section.tags.map((tag) => <span class="section-header__tag">{tag}</span>)}
      </div>
    </header>

    <!-- 1. Live Preview -->
    <section class="doc-section anim-slide-up" id="section-preview">
      {Component ? (
        <div class="section-preview-full">
          <div class="section-preview-full__label">Live Preview</div>
          <Component />
        </div>
      ) : (
        <div class="preview-placeholder">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
          <p>Preview coming soon</p>
        </div>
      )}
    </section>

    <!-- 2. Usage Section -->
    <section class="doc-section anim-slide-up" id="section-usage" style="animation-delay: 0.1s">
      <h2 class="doc-section__title">Usage</h2>
      <p class="doc-section__subtitle">Copy and paste this code into your Astro page:</p>
      <CodeBlock code={displayUsage} lang="astro" id={`usage-${section.slug}`} />
    </section>

    <!-- 3. Manual Installation -->
    <section class="doc-section anim-slide-up" id="section-code" style="animation-delay: 0.2s">
      <h2 class="doc-section__title">Manual Installation</h2>
      <div class="manual-box">
        <p>If you are not using the npm package, create a new file <code>src/components/sections/{section.name.replace(/\s/g, '')}.astro</code> and paste the following code:</p>
      </div>
      <div style="margin-top: var(--sp-4)">
        <CodeBlock code={section.code} lang="astro" id={`code-${section.slug}`} />
      </div>
    </section>
  </div>
</DocsLayout>


<style>
  .section-header {
    display: flex; flex-direction: column; gap: var(--sp-3);
    margin-bottom: var(--sp-8);
  }
  .section-header__badge {
    display: inline-flex; align-items: center; gap: var(--sp-2); width: fit-content;
    padding: 0.3rem 0.8rem; font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--c-primary-light);
    background: rgba(184,134,11,0.1); border: 1px solid rgba(184,134,11,0.25);
    border-radius: var(--r-full);
  }
  .section-header__title {
    font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 900;
    color: var(--c-text-1); letter-spacing: -0.03em; margin: 0;
  }
  .section-header__desc {
    font-size: 1rem; color: var(--c-text-2); max-width: 600px; margin: 0;
  }
  .section-header__tags { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .section-header__tag {
    padding: 0.15rem 0.5rem; font-size: 0.75rem; font-weight: 600;
    color: var(--c-text-3); background: rgba(255,255,255,0.04);
    border: 1px solid var(--c-border); border-radius: var(--r-full);
  }

  .section-preview-full {
    margin-bottom: var(--sp-8);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    background: #050505;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  .section-preview-full__label {
    font-size: 0.8rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--c-primary-light);
    margin: 0;
    padding: var(--sp-4) var(--sp-6);
    border-bottom: 1px solid var(--c-border);
    background: rgba(255,255,255,0.02);
  }

  .preview-placeholder {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--sp-3); padding: var(--sp-12);
    background: rgba(255,255,255,0.02);
    border: 1px dashed var(--c-border);
    border-radius: var(--r-lg);
    color: var(--c-text-3);
  }
  .preview-placeholder svg { opacity: 0.4; }
  .preview-placeholder p { margin: 0; font-size: 0.9rem; }

  .doc-page { max-width: 1140px; }
  .doc-section { margin-top: var(--sp-8); }
  .doc-section__title {
    font-size: 1.1rem; font-weight: 700; color: var(--c-text-1);
    margin-bottom: var(--sp-4); padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--c-border);
  }
  .doc-section__subtitle {
    font-size: 0.9rem; color: var(--c-text-3); margin-bottom: var(--sp-4); margin-top: calc(var(--sp-4) * -1);
  }

  .manual-box { display: flex; flex-direction: column; gap: var(--sp-2); }
  .manual-box p { font-size: 0.95rem; color: var(--c-text-2); line-height: 1.6; margin: 0; }
  .manual-box code { color: var(--c-primary-light); background: rgba(255,255,255,0.05); padding: 0.1rem 0.3rem; border-radius: 4px; }

  /* Prev/Next nav */
  .doc-nav {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: var(--sp-4); padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--c-border);
  }
  .doc-nav-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.78rem; color: var(--c-text-3); text-decoration: none;
    padding: 0.3rem 0.6rem; border-radius: var(--r-sm);
    transition: color 0.15s, background 0.15s;
  }
  .doc-nav-link:hover { color: var(--c-primary-light); background: rgba(255,255,255,0.04); }
  .doc-nav-link svg { flex-shrink: 0; opacity: 0.5; transition: opacity 0.15s; }
  .doc-nav-link:hover svg { opacity: 1; }

  /* Breadcrumb */
  .breadcrumb {
    display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap;
    font-size: 0.8rem; color: var(--c-text-3); margin-bottom: var(--sp-6);
  }
  .breadcrumb a { color: var(--c-text-3); text-decoration: none; } .breadcrumb a:hover { color: var(--c-text-2); }
  .breadcrumb__sep { color: var(--c-text-3); opacity: 0.5; }
  .breadcrumb__current { color: var(--c-text-2); font-weight: 500; }
</style>