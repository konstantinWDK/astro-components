---
// src/pages/docs/[slug].astro
import DocSlugPage from '../../components/docs/DocSlugPage.astro';
import { components } from '../../data/registry/index';

export function getStaticPaths() {
  return (components || []).filter(c => c).map((comp) => ({ params: { slug: comp.slug } }));
}

const { slug = '' } = Astro.params;
---

<DocSlugPage slug={slug} lang="en" />
