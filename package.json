{
  "name": "astro-component-kit",
  "version": "0.6.1",
  "description": "A free, open-source accessible UI component library for Astro",
  "type": "module",
  "main": "./src/components/index.ts",
  "module": "./src/components/index.ts",
  "types": "./src/components/types.d.ts",
  "bin": {
    "astro-component-kit": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/components/index.ts",
    "./buttons": "./src/components/lib/buttons/index.ts",
    "./cards": "./src/components/lib/cards/index.ts",
    "./data": "./src/components/lib/data/index.ts",
    "./feedback": "./src/components/lib/feedback/index.ts",
    "./forms": "./src/components/lib/forms/index.ts",
    "./layout": "./src/components/lib/layout/index.ts",
    "./navigation": "./src/components/lib/navigation/index.ts",
    "./overlays": "./src/components/lib/overlays/index.ts",
    "./typography": "./src/components/lib/typography/index.ts",
    "./sections": "./src/components/lib/sections/index.ts",
    "./charts": "./src/components/lib/charts/index.ts",
    "./ecommerce": "./src/components/lib/ecommerce/index.ts",
    "./app": "./src/components/lib/app/index.ts",
    "./templates/ecommerce": "./src/components/lib/templates/ecommerce/index.ts",
    "./templates/ecommerce-editorial": "./src/components/lib/templates/ecommerce-editorial/index.ts",
    "./templates/saas-hotel": "./src/components/lib/templates/saas-hotel/index.ts",
    "./templates/agency": "./src/components/lib/templates/agency/index.ts",
    "./templates/portfolio": "./src/components/lib/templates/portfolio/index.ts",
    "./templates/toy-store": "./src/components/lib/templates/toy-store/index.ts",
    "./templates/saas-clinic": "./src/components/lib/templates/saas-clinic/index.ts",
    "./templates/cyberpunk": "./src/components/lib/templates/cyberpunk/index.ts",
    "./templates/dental": "./src/components/lib/templates/dental/index.ts",
    "./templates/moving": "./src/components/lib/templates/moving/index.ts",
    "./global.css": "./src/styles/global.css"
  },
  "files": [
    "bin/",
    "src/components/lib/",
    "src/components/index.ts",
    "src/components/types.d.ts",
    "src/styles/global.css",
    "src/mcp/",
    "src/data/registry/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "registry:generate": "node scripts/generate-registry.mjs",
    "prepublishOnly": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "indexnow:dry": "node scripts/indexnow.mjs --dry-run",
    "mcp:start": "tsx src/mcp/index.ts",
    "mcp:dev": "tsx watch src/mcp/index.ts",
    "mcp:stdio": "tsx src/mcp/index.ts --stdio"
  },
  "keywords": [
    "astro",
    "astro-component",
    "ui",
    "components",
    "accessible",
    "a11y",
    "glassmorphism",
    "frontend",
    "web",
    "ecommerce",
    "shop",
    "cart",
    "templates",
    "dashboard",
    "saas",
    "admin"
  ],
  "author": "konstantinwdk <entiplay@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konstantinWDK/astro-components.git"
  },
  "bugs": {
    "url": "https://github.com/konstantinwdk/astro-components/issues"
  },
  "homepage": "https://astrocomponents.dev",
  "peerDependencies": {
    "apexcharts": ">=3.0.0",
    "astro": ">=5.0.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "apexcharts": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/three": "^0.184.0",
    "apexcharts": "^3.45.1",
    "astro": ">=5.0.0",
    "fs-extra": "^11.3.4",
    "playwright": "^1.62.1",
    "three": "^0.184.0",
    "typescript": "^5.9.3"
  }
}
