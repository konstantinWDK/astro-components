{
  "name": "astro-component-kit",
  "version": "0.0.2",
  "description": "A premium, open-source accessible UI component library for Astro",
  "type": "module",
  "main": "./src/components/index.ts",
  "module": "./src/components/index.ts",
  "types": "./src/components/types.d.ts",
  "exports": {
    ".": "./src/components/index.ts",
    "./buttons": "./src/components/lib/buttons/index.ts",
    "./cards": "./src/components/lib/cards/index.ts",
    "./data": "./src/components/lib/data/index.ts",
    "./feedback": "./src/components/lib/feedback/index.ts",
    "./forms": "./src/components/lib/forms/index.ts",
    "./layout": "./src/components/lib/layout/index.ts",
    "./navigation": "./src/components/lib/navigation/index.ts",
    "./overlays": "./src/components/lib/overlays/index.ts",
    "./typography": "./src/components/lib/typography/index.ts",
    "./utilities": "./src/components/lib/utilities/index.ts",
    "./global.css": "./src/styles/global.css"
  },
  "files": [
    "src/components/lib/",
    "src/components/index.ts",
    "src/components/types.d.ts",
    "src/styles/global.css",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:lib": "node scripts/build-lib.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:lib",
    "deploy:ftp": "node scripts/deploy-ftp.mjs"
  },
  "keywords": [
    "astro",
    "astro-component",
    "ui",
    "components",
    "accessible",
    "a11y",
    "glassmorphism",
    "frontend",
    "web"
  ],
  "author": "konstantinwdk <entiplay@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/konstantinwdk/astro-components"
  },
  "bugs": {
    "url": "https://github.com/konstantinwdk/astro-components/issues"
  },
  "homepage": "https://astrocomponents.dev",
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": ">=5.0.0"
  },
  "devDependencies": {
    "basic-ftp": "^5.3.0",
    "fs-extra": "^11.3.4"
  }
}
