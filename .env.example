# ==============================================================================
# Google Services & SEO Configuration
# ==============================================================================

# Google Tag Manager (GTM) Container ID (Format: GTM-XXXXXXX)
# If provided, GTM scripts will be automatically injected into <head> and <body>
PUBLIC_GTM_ID=

# Google Analytics 4 (GA4) Measurement ID (Format: G-XXXXXXXXXX)
# If provided, gtag.js script will be automatically loaded
PUBLIC_GA_ID=

# Google Search Console Verification Meta Tag Content
# Found in Search Console -> Settings -> Ownership Verification -> HTML tag
# e.g., google-site-verification=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PUBLIC_GSC_VERIFICATION=
